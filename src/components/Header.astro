---
/**
 * Header.astro — v3.14 · exact port of alglighting-he6frhek.manus.space
 *
 * Structure:
 *   Row 1 — Utility bar (dark bg, sticky top:0): Find a Distributor · Find a Rep · Sample Request · Contact · Sign In
 *   Row 2 — site-nav (white, sticky top:34px):
 *     Left:  color SVG logo
 *     Center: SOLUTIONS · PRODUCTS · TOOLS · SUPPORT · ABOUT
 *     Right: Request Sample (outline) + Request Layout (red filled)
 *     Far right: hamburger (mobile)
 *
 * Mega menus:
 *   SOLUTIONS  — 3-col: Main nav | 8 industry verticals | Preview pane
 *   PRODUCTS   — 4-col wide: Main | Category | Application | Preview + tier strip
 *   TOOLS      — 2-col narrow: For Buyers | For Specifiers
 *   SUPPORT    — 2-col narrow: Service | Legal & Compliance
 *
 * Behavior: hover on <li.has-dropdown> shows .megamenu via CSS opacity/visibility.
 *           JS IIFE handles 3-tier cascade for Products and Solutions preview swap.
 *           Mobile: hamburger toggles .mobile-drawer.open, accordion via data-expand.
 */
import SearchModal from './SearchModal.astro';
import skuIndex from '../data/sku-index.json';

// CFG-SSOT-1: Build TIER_IMGS and TIER_URLS from registry
const _tierImgs: Record<string, string> = {};
const _tierUrls: Record<string, string> = {};
for (const coll of Object.values(skuIndex.collections) as any[]) {
  for (const fam of (coll.families ?? [])) {
    if (fam.tierKey && fam.heroImage) _tierImgs[fam.tierKey] = fam.heroImage;
    if (fam.tierKey && fam.pdpUrl)   _tierUrls[fam.tierKey] = fam.pdpUrl;
  }
}
const REGISTRY_TIER_IMGS = JSON.stringify(_tierImgs);
const REGISTRY_TIER_URLS = JSON.stringify(_tierUrls);
---
<!-- UTILITY BAR -->
<div class="utility-bar">
  <p class="site-tagline">Lighting | Reinvented, since 1997.</p>
  <div class="utility-bar-right">
    <!-- Search icon — opens global site search modal (Cmd+K) -->
    <button
      class="utility-search-btn"
      id="utilitySearchBtn"
      type="button"
      aria-label="Search the site (⌘K)"
      title="Search the site (⌘K)"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
    </button>
    <a href="/find-a-rep/">Find a Rep</a>
    <a href="/find-a-distributor/">Find a Distributor</a>
    <a href="mailto:sales@archipelagolighting.com?subject=Sample%20request">Sample Request</a>
    <a href="/contact">Contact</a>
    <button class="signin" id="signinTrigger" type="button" aria-expanded="false" aria-haspopup="true">
      Sign In
      <div class="signin-dropdown" id="signinDropdown">
        <a href="https://aura.archipelagolighting.com" target="_blank" rel="noopener noreferrer">

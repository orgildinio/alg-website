<script define:vars={{REGISTRY_TIER_IMGS, REGISTRY_TIER_URLS}}>
(function(){
  const HOVER_DELAY_MS = 368;

  /* ---- Helper: cross-fade preview image ---- */
  function crossfade(imgEl, newSrc){
    if (!newSrc || imgEl.getAttribute('src') === newSrc){ return; }
    imgEl.style.opacity = '0';
    setTimeout(() => {
      imgEl.setAttribute('src', newSrc);
      imgEl.style.opacity = '1';
      imgEl.style.objectPosition = (newSrc && newSrc.indexOf('hospitality') !== -1) ? 'center 30%' : 'center center';
    }, 120);
  }

  /* ---- Helper: render Ⓐ as styled span ---- */
  function renderAa(str){
    return (str || '').replace(/Ⓐ|Ⓐ/g, '<span class="aa">Ⓐ</span>');
  }

  /* =============================================================
     PRODUCTS MEGA MENU · v2 merged collection-badge application model
     ============================================================= */
  const productsLi = document.querySelector('li[data-mm="products"]');
  if (productsLi){
    const menu = productsLi.querySelector('.megamenu.wide');
    const mainItems = menu.querySelectorAll('.mm-col-main .mm-main-item[data-main]');
    const appGroups = menu.querySelectorAll('.mm-app-group[data-app-category]');
    const appItems = menu.querySelectorAll('.mm-app-item');
    const previewImg = menu.querySelector('#mmPreviewImg');
    const previewLbl = menu.querySelector('#mmPreviewLabel');
    const previewName = menu.querySelector('#mmPreviewName');
    const previewDesc = menu.querySelector('#mmPreviewDesc');
    const previewCta = menu.querySelector('#mmPreviewCta');
    const tierStrip = menu.querySelector('#mmTierStrip');
    let hoverTimer = null;
    let activeGroup = null;

    function groupFor(appEl){ return appEl.closest('.mm-app-group[data-app-category]'); }
    function setPreviewText(appEl, group){
      const label = appEl.dataset.previewLabel || group.dataset.previewLabel || '';
      const name = appEl.dataset.previewName || group.dataset.previewName || '';
      const desc = appEl.dataset.previewDesc || group.dataset.previewDesc || '';
      if (label) previewLbl.textContent = label;
      if (name) previewName.innerHTML = renderAa(name);
      if (desc) previewDesc.textContent = desc;
      if (previewCta && group.dataset.collectionHref) previewCta.href = group.dataset.collectionHref;
      // CFG-COWORK-13: collection-keyed image actually changes on application hover.
      // Empty group preview (currently Synapse) intentionally preserves the prior verified image.
      crossfade(previewImg, group.dataset.preview || '');
    }
    function switchMain(mainKey){
      const visibleGroups = Array.from(appGroups).filter(g => g.dataset.appCategory === mainKey);
      mainItems.forEach(el => el.classList.toggle('active', el.dataset.main === mainKey));
      appGroups.forEach(g => g.classList.toggle('active', g.dataset.appCategory === mainKey));
      menu.style.setProperty('--app-group-count', String(Math.max(1, visibleGroups.length)));
      const firstGroup = visibleGroups[0] || null;
      const firstApp = firstGroup ? firstGroup.querySelector('.mm-app-item') : null;
      if (firstGroup && firstApp) swapAppPreview(firstApp);
    }
    const FAMILY_HERO = {
      'indoor-plano':'/products/proarch/assets/hero/proarch-hero-1.webp',
      'indoor-lampar':'/products/titan/titan/photos/TITAN-85-155W-1_nobg.png',
      'outdoor-luxo':'/products/liberty/assets/hero/liberty-hero-1.webp',
      'outdoor-city':'/products/lbol-sentry-bollard/assets/sentry/sentry-hero-1.webp',
      'lamps-tubul':'/mm-previews/tier-hero-tubul.webp'
    };
    const TIER_URLS = JSON.parse(REGISTRY_TIER_URLS);
    const TIER_IMGS = JSON.parse(REGISTRY_TIER_IMGS);
    window._algSwapApp = function(appEl){ swapAppPreview(appEl); };
    function swapAppPreview(appEl){
      const group = groupFor(appEl); if (!group) return;
      activeGroup = group;
      appItems.forEach(el => el.classList.toggle('active', el === appEl));
      setPreviewText(appEl, group);
      if (appEl.dataset.previewTiers === '1'){
        tierStrip.classList.remove('hidden');
        const heroSrc = FAMILY_HERO[group.dataset.appGroup] || group.dataset.preview || '';
        const eco = appEl.dataset.tierEco || '', pro = appEl.dataset.tierPro || '', plus = appEl.dataset.tierProplus || '';
        const fallback = heroSrc || previewImg.getAttribute('src') || '';
        document.getElementById('tierImgEco').src = (eco && TIER_IMGS[eco]) ? TIER_IMGS[eco] : fallback;
        document.getElementById('tierImgPro').src = (pro && TIER_IMGS[pro]) ? TIER_IMGS[pro] : fallback;
        document.getElementById('tierImgProplus').src = (plus && TIER_IMGS[plus]) ? TIER_IMGS[plus] : fallback;
        [['Eco',eco],['Pro',pro],['Proplus',plus]].forEach(([suffix, sku]) => {
          const card = document.getElementById(`tierSku${suffix}`).closest('.tier-card');
          if (sku){ card.classList.remove('slot-empty'); document.getElementById(`tierSku${suffix}`).innerHTML = renderAa(sku); card.dataset.tierKey = sku; }
          else { card.classList.add('slot-empty'); card.dataset.tierKey = ''; }
        });
      } else { tierStrip.classList.add('hidden'); }
    }
    mainItems.forEach(el => {
      const activate = () => { clearTimeout(hoverTimer); hoverTimer = setTimeout(() => switchMain(el.dataset.main), HOVER_DELAY_MS); };
      el.addEventListener('mouseenter', activate); el.addEventListener('focus', activate); el.addEventListener('mouseleave', () => clearTimeout(hoverTimer));
    });
    appItems.forEach(el => {
      const activate = () => { clearTimeout(hoverTimer); hoverTimer = setTimeout(() => swapAppPreview(el), HOVER_DELAY_MS); };
      el.addEventListener('mouseenter', activate); el.addEventListener('focus', activate); el.addEventListener('mouseleave', () => clearTimeout(hoverTimer));
    });
    const initialApp = menu.querySelector('.mm-app-group[data-app-category="indoor"] .mm-app-item');
    if (initialApp) swapAppPreview(initialApp);
    /* Tier card clicks — navigate to product page if one exists */
    ['t-eco','t-pro','t-proplus'].forEach(cls => {
      const card = document.querySelector('.tier-card.' + cls);
      if (!card) return;
      card.style.cursor = 'pointer';
      card.addEventListener('click', () => {
        const key = card.dataset.tierKey || '';
        if (key && TIER_URLS[key]) window.location.href = TIER_URLS[key];
      });
    });
    productsLi.addEventListener('mouseleave', () => clearTimeout(hoverTimer));

    /* Init: render the full active category on first paint, not only its preview. */
    function productsInitPreview() {
      const initialMain = menu.querySelector('.mm-col-main .mm-main-item.active[data-main]') || mainItems[0];
      if (initialMain) switchMain(initialMain.dataset.main);
    }
    productsLi.addEventListener('mouseenter', productsInitPreview, { once: false });
    productsInitPreview();
  }

  /* =============================================================
     SOLUTIONS MEGA MENU
     ============================================================= */
  const solLi = document.querySelector('li[data-mm="solutions"]');
  if (solLi){
    const solMenu    = solLi.querySelector('.megamenu.solutions');
    const vertItems  = solMenu.querySelectorAll('.mm-vert-item');
    const solPrevImg = solMenu.querySelector('#solPreviewImg');
    const solPrevLbl = solMenu.querySelector('#solPreviewLabel');
    const solPrevNm  = solMenu.querySelector('#solPreviewName');
    const solPrevDsc = solMenu.querySelector('#solPreviewDesc');
    let solTimer = null;
    // Init: seed preview from the first (active) item so HTML default always stays in sync
    function solInitPreview() {
      const first = vertItems[0];
      if (!first) return;
      vertItems.forEach(v => v.classList.remove('active'));
      first.classList.add('active');
      solPrevImg.src = first.dataset.preview || solPrevImg.src;
      if (first.dataset.previewLabel) solPrevLbl.textContent = first.dataset.previewLabel;
      if (first.dataset.previewName)  solPrevNm.innerHTML    = renderAa(first.dataset.previewName);
      if (first.dataset.previewDesc)  solPrevDsc.textContent = first.dataset.previewDesc;
    }
    solLi.addEventListener('mouseenter', solInitPreview, { once: false });
    // Also run once at load so the static HTML is never stale
    solInitPreview();
    vertItems.forEach(el => {
      el.addEventListener('mouseenter', () => {
        clearTimeout(solTimer);
        solTimer = setTimeout(() => {
          vertItems.forEach(v => v.classList.remove('active'));
          el.classList.add('active');
          crossfade(solPrevImg, el.dataset.preview);
          if (el.dataset.previewLabel) solPrevLbl.textContent = el.dataset.previewLabel;
          if (el.dataset.previewName)  solPrevNm.innerHTML    = renderAa(el.dataset.previewName);
          if (el.dataset.previewDesc)  solPrevDsc.textContent = el.dataset.previewDesc;
        }, HOVER_DELAY_MS);
      });
      el.addEventListener('mouseleave', () => clearTimeout(solTimer));
    });
    solLi.addEventListener('mouseleave', () => { clearTimeout(solTimer); solInitPreview(); });
  }

  /* =============================================================
     A1 (v2.5.4): MOBILE SIGN IN — click-toggle disclosure
     Now a <button> for reliable tap events on all devices.
     Desktop: hover CSS still works (hover:hover media query).
     Mobile: click/touchend toggles .signin--open class.
     ============================================================= */
  const signinTrigger = document.getElementById('signinTrigger');
  if (signinTrigger) {
    function closeSignin() {
      signinTrigger.classList.remove('signin--open');
      signinTrigger.setAttribute('aria-expanded', 'false');
    }
    function openSignin() {
      signinTrigger.classList.add('signin--open');
      signinTrigger.setAttribute('aria-expanded', 'true');
    }
    // Click handler — fires on both mouse and touch
    signinTrigger.addEventListener('click', function(e) {
      e.stopPropagation();
      const isOpen = signinTrigger.classList.contains('signin--open');
      if (isOpen) { closeSignin(); } else { openSignin(); }
    });
    // Prevent dropdown link clicks from bubbling to document close handler
    const dropdown = document.getElementById('signinDropdown');
    if (dropdown) {
      dropdown.addEventListener('click', function(e) { e.stopPropagation(); });
    }
    // Close on outside click / touch
    document.addEventListener('click', function(e) {
      if (!signinTrigger.contains(e.target)) { closeSignin(); }
    });
    // Close on Escape
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') { closeSignin(); }
    });
  }

  /* =============================================================
     MOBILE DRAWER · accordion
     ============================================================= */
  const toggle = document.querySelector('.nav-toggle');
  const drawer = document.getElementById('mobileDrawer');
  if (toggle && drawer) {
    toggle.addEventListener('click', () => {
      const isOpen = drawer.classList.toggle('open');
      toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      drawer.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });
    drawer.querySelectorAll('[data-expand]').forEach(trigger => {
      trigger.addEventListener('click', e => {
        e.preventDefault();
        const id    = trigger.dataset.expand;
        const panel = drawer.querySelector(`[data-expand-id="${id}"]`);
        if (!panel) return;
        const isOpen = panel.classList.toggle('open');
        trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    });
  }
})();

/* === Change A: Header hide-on-scroll (v2.7.19) === */
(function initHeaderRevealOnScroll(){
  const siteNav    = document.querySelector('.site-nav');
  const siteHeader = document.querySelector('#site-header');
  if (!siteNav || !siteHeader) return;

  const isMobile = () => window.matchMedia('(max-width:768px)').matches;
  const targetEl = () => isMobile() ? siteHeader : siteNav;

  const HIDE_THRESHOLD_DESKTOP  = 80;
  const HIDE_THRESHOLD_MOBILE   = 60;
  const REVEAL_DEADBAND_DESKTOP = 10;
  const REVEAL_DEADBAND_MOBILE  = 8;

  let lastScrollY           = window.scrollY;
  let accumulatedUp         = 0;
  let ticking               = false;
  let isProgrammaticScroll  = false; // §3.3: anchor-jump suppression

  function isMegaPanelOpen(){
    return !!siteNav.querySelector('.has-dropdown:hover, .has-dropdown:focus-within');
  }

  /* Issue E fix (v2.7.21): toggle on document.documentElement so :root cascade reaches all page elements */
  function syncHeaderState(){
    var isMainHidden = !isMobile() && siteNav.classList.contains('is-hidden');
    document.documentElement.classList.toggle('is-main-nav-hidden', isMainHidden);
  }

  /* §3.3: suppress hide/reveal during programmatic anchor scrolls */
  document.addEventListener('click', function(e){
    var link = e.target.closest('a[href*="#"]');
    if (!link) return;
    var href = link.getAttribute('href') || '';
    if (href.startsWith('#') || href.startsWith(window.location.pathname + '#')){
      isProgrammaticScroll = true;
      setTimeout(function(){ isProgrammaticScroll = false; }, 700);
    }
  });

  function onScroll(){
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function(){
      var currentY      = window.scrollY;
      var delta         = currentY - lastScrollY;
      var target        = targetEl();
      var hideThreshold = isMobile() ? HIDE_THRESHOLD_MOBILE  : HIDE_THRESHOLD_DESKTOP;
      var revealDead    = isMobile() ? REVEAL_DEADBAND_MOBILE : REVEAL_DEADBAND_DESKTOP;

      // §3.3: skip hide/reveal during anchor jumps; just record position
      if (isProgrammaticScroll){
        lastScrollY = currentY;
        ticking     = false;
        return;
      }

      // Freeze when mega panel is open
      if (isMegaPanelOpen()){
        accumulatedUp = 0;
        lastScrollY   = currentY;
        ticking       = false;
        return;
      }

      // At top: always show
      if (currentY <= 0){
        target.classList.remove('is-hidden');
        accumulatedUp = 0;
        lastScrollY   = currentY;
        syncHeaderState();
        ticking       = false;
        return;
      }

      if (delta > 0){
        // scrolling down
        accumulatedUp = 0;
        if (currentY > hideThreshold) target.classList.add('is-hidden');
      } else if (delta < 0){
        // scrolling up
        accumulatedUp += -delta;
        if (accumulatedUp >= revealDead) target.classList.remove('is-hidden');
      }

      syncHeaderState(); // §3.2: keep --header-bottom in sync
      lastScrollY = currentY;
      ticking     = false;
    });
  }

  // Resize: clean up when crossing 768px breakpoint
  var lastIsMobile = isMobile();
  window.addEventListener('resize', function(){
    var nowMobile = isMobile();
    if (nowMobile !== lastIsMobile){
      siteNav.classList.remove('is-hidden');
      siteHeader.classList.remove('is-hidden');
      accumulatedUp = 0;
      lastIsMobile  = nowMobile;
    }
    syncHeaderState();
  }, { passive: true });

  // Init: set correct state on first paint
  syncHeaderState();

  window.addEventListener('scroll', onScroll, { passive: true });
})();


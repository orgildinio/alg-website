<style>
  /* ================================================================
     CSS VARIABLES
     ================================================================ */
  :root {
    --ink:#111418;--ink2:#3a3f4a;--ink3:#8a8f99;--ink4:#c8ccd3;
    --bg:#ffffff;--bg2:#f5f5f3;--bg3:#eceae4;
    --dark:#0c0d12;--dark2:#14161e;
    --brand:#F32740;--brand-dk:#C41F32;
    --kraft:#c9a876;--amber:#f0a932;--grn:#0FAE7C;
    /* §3.1 (v2.7.19): Dynamic header-bottom variable.
       Default = utility bar (34px) + site-nav (56px) = 90px.
       Overridden by JS when white nav hides. */
    --utility-bar-height: 34px;
    --main-nav-height: 56px;
    --header-bottom: calc(var(--utility-bar-height) + var(--main-nav-height));
  }
  /* Issue E fix (v2.7.21): override on :root so cascade reaches all page elements */
  :global(:root.is-main-nav-hidden) {
    --header-bottom: var(--utility-bar-height);
  }
  /* On mobile, when entire header is hidden, header-bottom is 0 */
  @media (max-width:768px) {
    :global(:root.is-hidden) {
      --header-bottom: 0px;
    }
  }
  /* Issue G (v2.7.21): per-page sticky stack contribution.
     --page-sticky-extra defaults to 0px via CSS fallback in calc().
     Pages with their own sticky elements set it on html in their own stylesheet. */
  :global(html) {
    scroll-padding-top: calc(var(--header-bottom) + var(--page-sticky-extra, 0px));
    scroll-behavior: smooth;
  }
  /* Issue F fix (v2.7.21): reduced-motion disables animation, NOT header heights */
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }

  /* ================================================================
     UTILITY BAR
     ================================================================ */
  .utility-bar{
    background:var(--dark);color:#fff;
    height:34px;display:flex;align-items:center;justify-content:space-between;
    padding:0 28px;font-size:11px;letter-spacing:0.5px;
    position:fixed;top:0;left:0;right:0;z-index:101;
    border-bottom:1px solid rgba(255,255,255,0.05);
  }
  /* Change B: brand slogan — left side of utility bar */
  .site-tagline{
    /* Issue D fix (v2.7.20): explicit values — no inherit — matching .utility-bar-right a computed style */
    /* Captured from deployed staging (Find a Distributor link): */
    font-family: 'Lato', system-ui, -apple-system, sans-serif"Segoe UI", Roboto, system-ui, sans-serif;
    font-size: 11px;
    font-weight: 400;
    line-height: 16.5px;
    letter-spacing: 0.5px;
    text-transform: none;
    color: rgb(255, 255, 255);
    margin:0;padding:0;white-space:nowrap;
  }
  @media (max-width:768px){
    .site-tagline{display:none;}
  }
  /* Issue A fix (v2.7.19): right-side group wrapper */
  .utility-bar-right{
    display:flex;align-items:center;gap:24px;
  }
  .utility-bar-right a{color:#fff;text-decoration:none;opacity:0.8;transition:opacity 0.15s;}
  .utility-bar-right a:hover{opacity:1;}
  /* Search icon button in utility bar */
  .utility-search-btn{
    width:32px;height:32px;
    display:inline-flex;align-items:center;justify-content:center;
    background:transparent;border:0;
    color:rgba(255,255,255,0.65);
    cursor:pointer;border-radius:4px;
    transition:color .12s ease,background .12s ease;
    flex-shrink:0;
  }
  .utility-search-btn:hover{
    color:#fff;
    background:rgba(255,255,255,0.06);
  }
  .utility-search-btn svg{width:16px;height:16px;}
  .utility-bar .signin{
    position:relative;
    background:var(--brand);padding:5px 14px;border-radius:3px;
    margin-left:24px;font-weight:600;letter-spacing:1px;text-transform:uppercase;
    cursor:pointer;display:inline-flex;align-items:center;gap:6px;
    user-select:none;
    /* button reset */
    border:none;color:#fff;font-family:inherit;font-size:inherit;
    min-height:44px;min-width:44px;
    -webkit-tap-highlight-color:rgba(0,0,0,0.1);
  }
  .utility-bar .signin::after{content:'▾';font-size:9px;}
  .signin-dropdown{
    position:absolute;top:100%;right:0;margin-top:6px;
    background:#fff;color:var(--ink);
    border:1px solid rgba(0,0,0,0.08);
    box-shadow:0 8px 24px rgba(0,0,0,0.15);
    min-width:320px;
    opacity:0;visibility:hidden;transform:translateY(-4px);
    transition:
      opacity    var(--hover-close-duration) var(--hover-ease) var(--hover-close-delay),
      visibility var(--hover-close-duration) var(--hover-ease) var(--hover-close-delay),
      transform  var(--hover-close-duration) var(--hover-ease) var(--hover-close-delay);
    border-radius:4px;
    overflow:hidden;
    z-index:200;
  }
  /* A1 (v2.5.3): Desktop hover behavior preserved */
  @media (hover: hover) and (pointer: fine) {
    .utility-bar .signin:hover .signin-dropdown{
      opacity:1;visibility:visible;transform:translateY(0);
      transition:
        opacity    var(--hover-open-duration) var(--hover-ease) var(--hover-open-delay),
        visibility var(--hover-open-duration) var(--hover-ease) var(--hover-open-delay),
        transform  var(--hover-open-duration) var(--hover-ease) var(--hover-open-delay);
    }
  }
  /* A1 (v2.5.3): Mobile click-toggle — JS adds .signin--open class */
  .utility-bar .signin.signin--open .signin-dropdown{
    opacity:1;visibility:visible;transform:translateY(0);
    transition:
      opacity    var(--hover-open-duration) var(--hover-ease) var(--hover-open-delay),
      visibility var(--hover-open-duration) var(--hover-ease) var(--hover-open-delay),
      transform  var(--hover-open-duration) var(--hover-ease) var(--hover-open-delay);
  }
  .signin-dropdown a{
    display:block;padding:14px 16px;text-align:left;text-transform:none;
    letter-spacing:0;margin:0;font-size:13px;color:var(--ink);font-weight:400;
    border-bottom:1px solid rgba(0,0,0,0.06);opacity:1;text-decoration:none;
  }
  .signin-dropdown a:hover{background:var(--bg2);color:var(--brand);}
  .signin-dropdown a:last-child{border-bottom:0;}
  .signin-dropdown .label{
    font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--brand);
    letter-spacing:1.5px;text-transform:uppercase;font-weight:600;
    display:block;margin-bottom:3px;white-space:nowrap;
  }

  /* ================================================================
     SITE NAV
     ================================================================ */
  /* Change A: white nav bar — fixed below utility bar, hide-on-scroll */
  .site-nav{
    position:fixed;top:34px;left:0;right:0;z-index:100;
    transition:transform 240ms cubic-bezier(0.4,0,0.2,1);
    will-change:transform;
    background:rgba(255,255,255,0.97);
    backdrop-filter:blur(10px);
    -webkit-backdrop-filter:blur(10px);
    border-bottom:1px solid rgba(0,0,0,0.06);
    height:56px;
    display:flex;align-items:center;justify-content:space-between;
    padding:0 28px;
  }
  .site-nav .logo-wrap{display:flex;align-items:center;}
  .site-nav .logo-wrap img{height:36px;width:auto;display:block;}
  .site-nav ul.main-nav{display:flex;list-style:none;gap:32px;margin:0;padding:0;}
  .site-nav ul.main-nav > li{position:relative;padding:18px 0;}
  .site-nav ul.main-nav > li > a{
    text-decoration:none;color:var(--ink2);
    font-size:12px;font-weight:600;letter-spacing:0.8px;
    text-transform:uppercase;
    transition:color 0.15s;
    display:inline-flex;align-items:center;gap:5px;
  }
  .site-nav ul.main-nav > li.has-dropdown > a::after{
    content:'▾';font-size:8px;opacity:0.5;
  }
  .site-nav ul.main-nav > li > a:hover{color:var(--brand);}
  /* Change A: lock bar in place when mega panel is hovered */
  .site-nav:has(.has-dropdown:hover),
  .site-nav:has(.has-dropdown:focus-within){
    transform:translateY(0) !important;
  }
  /* Change A: hidden state */
  .site-nav.is-hidden{
    transform:translateY(-100%);
  }
  /* Issue F fix (v2.7.21): reduced-motion — disable transitions on header + all sticky page elements */
  @media (prefers-reduced-motion:reduce){
    .site-nav,
    #site-header,
    .c-subnav-wrap,
    .consumer-section-nav {
      transition-duration:0ms !important;
    }
  }
  /* Change A: mobile — both bars hide together via #site-header */
  @media (max-width:768px){
    .site-nav{
      transition:none;
      transform:none !important;
    }
    #site-header{
      transition:transform 240ms cubic-bezier(0.4,0,0.2,1);
      will-change:transform;
    }
    #site-header.is-hidden{
      transform:translateY(-100%);
    }
  }
  .site-nav ul.main-nav > li.has-dropdown:hover .megamenu,
  .site-nav ul.main-nav > li.has-dropdown:focus-within .megamenu{
    opacity:1;visibility:visible;transform:translateY(0);
    transition:
      opacity    var(--hover-open-duration) var(--hover-ease) var(--hover-open-delay),
      visibility var(--hover-open-duration) var(--hover-ease) var(--hover-open-delay),
      transform  var(--hover-open-duration) var(--hover-ease) var(--hover-open-delay);
  }

  /* ================================================================
     MEGA MENU — base (narrow: Tools / Support)
     ================================================================ */
  .megamenu{
    position:absolute;top:100%;left:-20px;
    background:#fff;
    border:1px solid rgba(0,0,0,0.08);
    box-shadow:0 12px 40px rgba(0,0,0,0.12);
    padding:24px 28px;
    /* A2 (v2.5.3): no outer white wrapper — inner panels handle their own bg */
    min-width:520px;
    display:grid;grid-template-columns:1fr 1fr;gap:28px;
    opacity:0;visibility:hidden;transform:translateY(6px);
    transition:
      opacity    var(--hover-close-duration) var(--hover-ease) var(--hover-close-delay),
      visibility var(--hover-close-duration) var(--hover-ease) var(--hover-close-delay),
      transform  var(--hover-close-duration) var(--hover-ease) var(--hover-close-delay);
    z-index:60;
    border-radius:4px;
  }

  /* ================================================================
     MEGA MENU — wide (Products · 4-col)
     ================================================================ */
  /* §MM-GAP (v2.7.25): site-nav has will-change:transform which makes it the
     containing block for position:fixed children. So top:90px was offset by
     the utility-bar height (34px), creating a 34px gap. Fix: use the site-nav
     height (56px) as the top anchor. Add 2px gap to match Tools/Support. */
  .megamenu.wide{
    position:fixed;
    top:calc(var(--main-nav-height) + 2px);
    left:0;
    right:0;
    width:100%;
    max-width:none;min-width:0;
    padding:0;
    /* A2 (v2.5.3): Remove outer white border — panels are flush */
    background:transparent;
    border:none;
    display:grid;
    grid-template-columns:220px 260px 300px 1fr;
    gap:0;
    max-height:calc(100vh - 110px);
    overflow:hidden;
    box-shadow:0 24px 80px rgba(0,0,0,0.18);
    border-radius:4px;
  }
  .megamenu.wide .mm-col{
    padding:20px 18px;
    overflow-y:auto;
    max-height:calc(100vh - 110px);
    scrollbar-width:thin;
    scrollbar-color:rgba(0,0,0,0.2) transparent;
  }
  .megamenu.wide .mm-col::-webkit-scrollbar{width:6px;}
  .megamenu.wide .mm-col::-webkit-scrollbar-thumb{background:rgba(0,0,0,0.15);border-radius:3px;}
  /* G6 v2.7.13.1: BROWSE BY column — warm cream bg matching Eichler G25 hero */
  .megamenu.wide .mm-col.mm-col-main{background:#F5EFE3;}
  /* G5/G7 v2.7.13.1: mm-col-main text — dark on cream, eyebrow matches Industry Vertical */
  .megamenu.wide .mm-col-main .mm-col-head{
    color:rgb(107,114,128);
    border-bottom:1px solid rgba(0,0,0,0.08);
    font-family:'JetBrains Mono',monospace;
    font-size:9px;
    letter-spacing:1.8px;
    text-transform:uppercase;
  }
  .megamenu.wide .mm-col-main .mm-main-item{color:rgb(17,17,17);}
  .megamenu.wide .mm-col-main .mm-main-item .mm-main-sub{color:rgba(17,17,17,0.7);}
  .megamenu.wide .mm-col-main .mm-main-item:hover .mm-main-sub{color:rgba(17,17,17,0.7);}
  .megamenu.wide .mm-col-main .mm-main-item.active{background:var(--brand);color:#fff;}
  .megamenu.wide .mm-col-main .mm-main-item.active .mm-main-sub{color:rgba(255,255,255,0.85);}
  .megamenu.wide .mm-col-main .mm-main-item:hover{background:var(--brand);color:#fff;}
  .megamenu.wide .mm-col-main .mm-main-group-label{color:rgba(17,17,17,0.5);}
  .megamenu.wide .mm-col-main .mm-main-divider{background:rgba(17,17,17,0.08);}
  .megamenu.wide .mm-col.mm-col-cat{background:var(--bg2);border-right:1px solid rgba(0,0,0,0.06);}
  .megamenu.wide .mm-col.mm-col-app{background:#fff;border-right:1px solid rgba(0,0,0,0.06);}
  .megamenu.wide .mm-col.mm-col-preview{background:#fff;padding:20px 24px;}
  .megamenu.wide .mm-col-head{
    font-family:'JetBrains Mono',monospace;
    font-size:9px;color:var(--ink3);letter-spacing:0.2em;
    text-transform:uppercase;font-weight:600;
    margin-bottom:14px;padding-bottom:10px;
    border-bottom:1px solid rgba(0,0,0,0.08);
  }
  /* G7 v2.7.13.1: .wide mm-col-main mm-col-head — overridden above with canonical eyebrow treatment */

  /* ---- COLUMN 1: Main nav items ---- */
  .mm-main-item{
    display:block;padding:11px 14px;
    font-family: 'Lato', system-ui, sans-serif;font-size:14px;font-weight:600;
    color:rgba(255,255,255,0.85);
    letter-spacing:0.01em;
    border-radius:3px;
    cursor:pointer;
    transition:background 0.12s, color 0.12s;
    margin-bottom:2px;
    text-decoration:none;
  }
  .mm-main-item:hover,
  .mm-main-item.active{background:var(--brand);color:#fff;}
  .mm-main-item .mm-main-sub{
    display:block;font-size:10px;font-weight:400;
    color:rgba(255,255,255,0.5);margin-top:2px;letter-spacing:0.02em;
  }
  .mm-main-item.active .mm-main-sub,
  .mm-main-item:hover .mm-main-sub{color:rgba(255,255,255,0.85);}
  .mm-main-divider{height:1px;background:rgba(255,255,255,0.08);margin:8px 14px;}
  .mm-cs-chip{display:inline-block;font-family:'JetBrains Mono',monospace;font-size:8px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#fff;background:rgba(243,39,64,.75);border-radius:2px;padding:2px 5px;margin-left:7px;vertical-align:middle;line-height:1.4;}
  .mm-main-item.active .mm-cs-chip,.mm-main-item:hover .mm-cs-chip{background:rgba(255,255,255,.25);color:#fff;}
  .mm-main-group-label{
    font-family:'JetBrains Mono',monospace;font-size:8px;
    color:rgba(255,255,255,0.35);letter-spacing:0.2em;
    text-transform:uppercase;font-weight:600;
    padding:0 14px 4px;margin-top:6px;
  }

  /* ---- COLUMN 2: Category ---- */
  .mm-cat-group{display:none;}
  .mm-cat-group.active{display:block;}
  .mm-cat-item{
    display:block;padding:10px 12px;
    font-family: 'Lato', system-ui, sans-serif;font-size:13px;font-weight:600;
    color:var(--ink);letter-spacing:-0.005em;
    border-radius:3px;cursor:pointer;
    border-left:3px solid transparent;
    transition:background 0.12s, border-color 0.12s, color 0.12s;
    margin-bottom:2px;text-decoration:none;
  }
  .mm-cat-item:hover,
  .mm-cat-item.active{background:#fff;border-left-color:var(--brand);color:var(--brand);}
  .mm-cat-item .mm-cat-sub{
    display:block;font-size:10px;font-weight:400;
    color:var(--ink3);margin-top:2px;letter-spacing:0.01em;
  }
  .mm-cat-item:hover .mm-cat-sub,
  .mm-cat-item.active .mm-cat-sub{color:var(--ink2);}

  /* ---- COLUMN 3: Application ---- */
  .mm-app-group{display:none;}
  .mm-app-group.active{display:block;}
  .mm-app-item{
    display:block;padding:7px 10px;
    font-size:13px;color:var(--ink2);
    font-weight:400;line-height:1.35;
    border-radius:3px;cursor:pointer;
    transition:background 0.12s, color 0.12s;
    margin-bottom:1px;text-decoration:none;
  }
  .mm-app-item:hover{background:var(--bg2);color:var(--brand);}
  .mm-app-item .mm-app-sub{
    display:block;font-size:10px;font-weight:400;
    color:var(--ink3);margin-top:2px;letter-spacing:0.01em;
  }
  .mm-app-item:hover .mm-app-sub{color:var(--ink2);}
  /* Sub-product links under an application leaf (e.g. Sports Lighters → Illuminator/Beacon/Radiator) */
  .mm-app-sub-links{
    padding:2px 0 4px 10px;
    border-left:2px solid rgba(0,0,0,0.08);
    margin:0 0 2px 10px;
    display:flex;flex-direction:column;gap:1px;
  }
  .mm-app-sub-link{
    display:block;padding:4px 8px;
    font-size:12px;color:var(--ink3);
    font-weight:400;border-radius:2px;
    text-decoration:none;
    transition:background 0.1s,color 0.1s;
  }
  .mm-app-sub-link:hover{background:var(--bg2);color:var(--brand);}
  /* Tier badge — shared pill style (matches collection card badges) */
  .mm-sub-tier{
    display:inline-block;
    font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:700;
    letter-spacing:0.06em;text-transform:uppercase;
    padding:2px 6px;border-radius:3px;
    vertical-align:middle;margin-left:5px;flex-shrink:0;
    /* default (used in sub-links) */
    background:#1a1a2a;color:#7c9fff;border:1px solid rgba(124,159,255,0.4);
  }
  /* ECO — green */
  .mm-sub-tier[data-tier="ECO"],
  .mm-app-item .mm-sub-tier:not([data-tier]):first-of-type { /* fallback */ }
  /* Color by class — higher specificity than generic rule */
  .mm-app-item .mm-sub-tier { background:#fff;color:#7c9fff;border:1px solid rgba(124,159,255,0.6); }
  .mm-app-item .mm-sub-tier.eco{background:#fff;color:#2e7d32;border:1px solid rgba(76,175,80,0.7);}

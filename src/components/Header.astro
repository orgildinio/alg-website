  /* ================================================================
     CSS VARIABLES
     ================================================================ */
  :root {
    --ink:#1A1D23;--ink2:#3A3E47;--ink3:#6B7280;--ink4:var(--color-border-strong);
    --bg:var(--color-bg);--bg2:var(--color-bg-soft);--bg3:var(--color-bg-strong);
    --dark:var(--bg-deepest);--dark2:var(--bg-page);
    --brand:var(--color-alg-red);--brand-dk:#C8132E;
    --kraft:#c9a876;--amber:#f0a932;--grn:#0FAE7C;
    /* §3.1 (v2.7.19): Dynamic header-bottom variable.
       Default = utility bar (34px) + site-nav (56px) = 90px.
       Overridden by JS when white nav hides. */
    --utility-bar-height: 34px;
    --main-nav-height: 56px;
    --header-bottom: calc(var(--utility-bar-height) + var(--main-nav-height));
  }
  /* Issue E fix (v2.7.21): override on :root so cascade reaches all page elements */
  :global(:root.is-main-nav-hidden) {
    --header-bottom: var(--utility-bar-height);
  }
  /* On mobile, when entire header is hidden, header-bottom is 0 */
  @media (max-width:768px) {
    :global(:root.is-hidden) {
      --header-bottom: 0px;
    }
  }
  /* Issue G (v2.7.21): per-page sticky stack contribution.
     --page-sticky-extra defaults to 0px via CSS fallback in calc().
     Pages with their own sticky elements set it on html in their own stylesheet. */
  :global(html) {
    scroll-padding-top: calc(var(--header-bottom) + var(--page-sticky-extra, 0px));
    scroll-behavior: smooth;
  }
  /* Issue F fix (v2.7.21): reduced-motion disables animation, NOT header heights */
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }

  /* ================================================================
     UTILITY BAR
     ================================================================ */
  .utility-bar{
    background:var(--dark);color:#fff;
    height:34px;display:flex;align-items:center;justify-content:space-between;
    padding:0 28px;font-size:11px;letter-spacing:0.5px;
    position:fixed;top:0;left:0;right:0;z-index:101;
    border-bottom:1px solid rgba(255,255,255,0.05);
  }
  /* Change B: brand slogan — left side of utility bar */
  .site-tagline{
    /* Issue D fix (v2.7.20): explicit values — no inherit — matching .utility-bar-right a computed style */
    /* Captured from deployed staging (Find a Distributor link): */
    font-family: 'Lato', system-ui, -apple-system, sans-serif"Segoe UI", Roboto, system-ui, sans-serif;
    font-size: 11px;
    font-weight: 400;
    line-height: 16.5px;
    letter-spacing: 0.5px;
    text-transform: none;
    color: rgb(255, 255, 255);
    margin:0;padding:0;white-space:nowrap;
  }
  @media (max-width:768px){
    .site-tagline{display:none;}
  }
  /* Issue A fix (v2.7.19): right-side group wrapper */
  .utility-bar-right{
    display:flex;align-items:center;gap:24px;
  }
  .utility-bar-right a{color:#fff;text-decoration:none;opacity:0.8;transition:opacity 0.15s;}
  .utility-bar-right a:hover{opacity:1;}
  /* Search icon button in utility bar */
  .utility-search-btn{
    width:32px;height:32px;
    display:inline-flex;align-items:center;justify-content:center;
    background:transparent;border:0;
    color:rgba(255,255,255,0.65);
    cursor:pointer;border-radius:4px;
    transition:color .12s ease,background .12s ease;
    flex-shrink:0;
  }
  .utility-search-btn:hover{
    color:#fff;
    background:rgba(255,255,255,0.06);
  }
  .utility-search-btn svg{width:16px;height:16px;}
  .utility-bar .signin{
    position:relative;
    background:var(--brand);padding:5px 14px;border-radius:3px;
    margin-left:24px;font-weight:600;letter-spacing:1px;text-transform:uppercase;
    cursor:pointer;display:inline-flex;align-items:center;gap:6px;
    user-select:none;
    /* button reset */
    border:none;color:#fff;font-family:inherit;font-size:inherit;
    min-height:44px;min-width:44px;
    -webkit-tap-highlight-color:rgba(0,0,0,0.1);
  }
  .utility-bar .signin::after{content:'▾';font-size:9px;}
  .signin-dropdown{
    position:absolute;top:100%;right:0;margin-top:6px;
    background:#fff;color:var(--ink);
    border:1px solid rgba(0,0,0,0.08);
    box-shadow:0 8px 24px rgba(0,0,0,0.15);
    min-width:320px;
    opacity:0;visibility:hidden;transform:translateY(-4px);
    transition:
      opacity    var(--hover-close-duration) var(--hover-ease) var(--hover-close-delay),
      visibility var(--hover-close-duration) var(--hover-ease) var(--hover-close-delay),
      transform  var(--hover-close-duration) var(--hover-ease) var(--hover-close-delay);
    border-radius:4px;
    overflow:hidden;
    z-index:200;
  }
  /* A1 (v2.5.3): Desktop hover behavior preserved */
  @media (hover: hover) and (pointer: fine) {
    .utility-bar .signin:hover .signin-dropdown{
      opacity:1;visibility:visible;transform:translateY(0);
      transition:
        opacity    var(--hover-open-duration) var(--hover-ease) var(--hover-open-delay),
        visibility var(--hover-open-duration) var(--hover-ease) var(--hover-open-delay),
        transform  var(--hover-open-duration) var(--hover-ease) var(--hover-open-delay);
    }
  }
  /* A1 (v2.5.3): Mobile click-toggle — JS adds .signin--open class */
  .utility-bar .signin.signin--open .signin-dropdown{
    opacity:1;visibility:visible;transform:translateY(0);
    transition:
      opacity    var(--hover-open-duration) var(--hover-ease) var(--hover-open-delay),
      visibility var(--hover-open-duration) var(--hover-ease) var(--hover-open-delay),
      transform  var(--hover-open-duration) var(--hover-ease) var(--hover-open-delay);
  }
  .signin-dropdown a{
    display:block;padding:14px 16px;text-align:left;text-transform:none;
    letter-spacing:0;margin:0;font-size:13px;color:var(--ink);font-weight:400;
    border-bottom:1px solid rgba(0,0,0,0.06);opacity:1;text-decoration:none;
  }
  .signin-dropdown a:hover{background:var(--bg2);color:var(--brand);}
  .signin-dropdown a:last-child{border-bottom:0;}
  .signin-dropdown .label{
    font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--brand);
    letter-spacing:1.5px;text-transform:uppercase;font-weight:600;
    display:block;margin-bottom:3px;white-space:nowrap;
  }

  /* ================================================================
     SITE NAV
     ================================================================ */
  /* Change A: white nav bar — fixed below utility bar, hide-on-scroll */
  .site-nav{
    position:fixed;top:34px;left:0;right:0;z-index:100;
    transition:transform 240ms cubic-bezier(0.4,0,0.2,1);
    will-change:transform;
    background:rgba(255,255,255,0.97);
    backdrop-filter:blur(10px);
    -webkit-backdrop-filter:blur(10px);
    border-bottom:1px solid rgba(0,0,0,0.06);
    height:56px;
    display:flex;align-items:center;justify-content:space-between;
    padding:0 28px;
  }
  .site-nav .logo-wrap{display:flex;align-items:center;}
  .site-nav .logo-wrap img{height:36px;width:auto;display:block;}
  .site-nav ul.main-nav{display:flex;list-style:none;gap:32px;margin:0;padding:0;}
  .site-nav ul.main-nav > li{position:relative;padding:18px 0;}
  .site-nav ul.main-nav > li > a{
    text-decoration:none;color:var(--ink2);
    font-size:12px;font-weight:600;letter-spacing:0.8px;
    text-transform:uppercase;
    transition:color 0.15s;
    display:inline-flex;align-items:center;gap:5px;
  }
  .site-nav ul.main-nav > li.has-dropdown > a::after{
    content:'▾';font-size:8px;opacity:0.5;
  }
  .site-nav ul.main-nav > li > a:hover{color:var(--brand);}
  /* Change A: lock bar in place when mega panel is hovered */
  .site-nav:has(.has-dropdown:hover),
  .site-nav:has(.has-dropdown:focus-within){
    transform:translateY(0) !important;
  }
  /* Change A: hidden state */
  .site-nav.is-hidden{
    transform:translateY(-100%);
  }
  /* Issue F fix (v2.7.21): reduced-motion — disable transitions on header + all sticky page elements */
  @media (prefers-reduced-motion:reduce){
    .site-nav,
    #site-header,
    .c-subnav-wrap,
    .consumer-section-nav {
      transition-duration:0ms !important;
    }
  }
  /* Change A: mobile — both bars hide together via #site-header */
  @media (max-width:768px){
    .site-nav{
      transition:none;
      transform:none !important;
    }
    #site-header{
      transition:transform 240ms cubic-bezier(0.4,0,0.2,1);
      will-change:transform;
    }
    #site-header.is-hidden{
      transform:translateY(-100%);
    }
  }
  .site-nav ul.main-nav > li.has-dropdown:hover .megamenu,
  .site-nav ul.main-nav > li.has-dropdown:focus-within .megamenu{
    opacity:1;visibility:visible;transform:translateY(0);
    transition:
      opacity    var(--hover-open-duration) var(--hover-ease) var(--hover-open-delay),
      visibility var(--hover-open-duration) var(--hover-ease) var(--hover-open-delay),
      transform  var(--hover-open-duration) var(--hover-ease) var(--hover-open-delay);
  }

  /* ================================================================
     MEGA MENU — base (narrow: Tools / Support)
     ================================================================ */
  .megamenu{
    position:absolute;top:100%;left:-20px;
    background:#fff;
    border:1px solid rgba(0,0,0,0.08);
    box-shadow:0 12px 40px rgba(0,0,0,0.12);
    padding:24px 28px;
    /* A2 (v2.5.3): no outer white wrapper — inner panels handle their own bg */
    min-width:520px;
    display:grid;grid-template-columns:1fr 1fr;gap:28px;
    opacity:0;visibility:hidden;transform:translateY(6px);
    transition:
      opacity    var(--hover-close-duration) var(--hover-ease) var(--hover-close-delay),
      visibility var(--hover-close-duration) var(--hover-ease) var(--hover-close-delay),
      transform  var(--hover-close-duration) var(--hover-ease) var(--hover-close-delay);
    z-index:60;
    border-radius:4px;
  }

  /* ================================================================
     MEGA MENU — wide (Products · 4-col)
     ================================================================ */
  /* §MM-GAP (v2.7.25): site-nav has will-change:transform which makes it the
     containing block for position:fixed children. So top:90px was offset by
     the utility-bar height (34px), creating a 34px gap. Fix: use the site-nav
     height (56px) as the top anchor. Add 2px gap to match Tools/Support. */
  .megamenu.wide{
    position:fixed;top:calc(var(--main-nav-height) + 2px);left:0;right:0;
    width:100%;max-width:none;min-width:0;padding:0;background:transparent;border:none;
    display:grid;grid-template-columns:250px max-content minmax(0,1fr);gap:0;
    max-height:calc(100vh - 110px);overflow:hidden;box-shadow:0 24px 80px rgba(0,0,0,0.18);border-radius:4px;
  }
  .megamenu.wide .mm-col{padding:20px 18px;overflow-y:auto;max-height:calc(100vh - 110px);scrollbar-width:thin;scrollbar-color:var(--ink4) transparent;}
  .megamenu.wide .mm-col::-webkit-scrollbar{width:6px;}
  .megamenu.wide .mm-col::-webkit-scrollbar-thumb{background:var(--ink4);border-radius:3px;}
  .megamenu.wide .mm-col.mm-col-main{background:var(--bg-page);}
  .megamenu.wide .mm-col-main .mm-col-head{color:var(--text-secondary);border-bottom:1px solid var(--line);font-family:var(--font-mono);font-size:12px;letter-spacing:1.8px;text-transform:uppercase;}
  .megamenu.wide .mm-col-main .mm-main-item{color:var(--text-primary);}
  .megamenu.wide .mm-col-main .mm-main-item .mm-main-sub{color:var(--text-secondary);}
  .megamenu.wide .mm-col-main .mm-main-item:hover .mm-main-sub{color:var(--text-primary);}
  .megamenu.wide .mm-col-main .mm-main-item.active,.megamenu.wide .mm-col-main .mm-main-item:hover{background:var(--brand);color:rgb(17,17,17);}
  .megamenu.wide .mm-col-main .mm-main-item.active .mm-main-sub{color:rgb(17,17,17);}
  .megamenu.wide .mm-col-main .mm-main-item.active .aa,.megamenu.wide .mm-col-main .mm-main-item:hover .aa{color:rgb(17,17,17);}
  .megamenu.wide .mm-col-main .mm-main-group-label{color:var(--text-primary);}
  .megamenu.wide .mm-col-main .mm-main-divider{background:var(--line);}
  .megamenu.wide .mm-col.mm-col-app{background:var(--bg);border-right:1px solid var(--color-border);width:max-content;}
  .megamenu.wide .mm-col.mm-col-preview{background:var(--bg-deepest);padding:0;overflow:hidden;}
  .megamenu.wide .mm-col-head{font-family:var(--font-mono);font-size:13px;line-height:1.5;color:#3A3E47;letter-spacing:0.2em;text-transform:uppercase;font-weight:600;margin-bottom:16px;padding-bottom:11px;border-bottom:1px solid var(--color-border);}
  /* Shared main-rail structure: Products overrides colors below; Solutions keeps its production color rules. */
  .mm-main-item{display:block;padding:11px 14px;font-family:'Lato',system-ui,sans-serif;font-size:14px;font-weight:600;letter-spacing:0.01em;border-radius:3px;cursor:pointer;transition:background 0.12s,color 0.12s;margin-bottom:2px;text-decoration:none;}
  .mm-main-item .mm-main-sub{display:block;font-size:10px;font-weight:400;margin-top:2px;letter-spacing:0.02em;}
  .mm-main-divider{height:1px;margin:8px 14px;}
  .mm-main-group-label{font-family:var(--font-mono);font-size:8px;letter-spacing:0.2em;text-transform:uppercase;font-weight:600;padding:0 14px 4px;margin-top:6px;}
  /* Canonical desktop scale: shared across the Products and Solutions mega menus. */
  .megamenu.wide .mm-main-item{color:var(--text-primary);font-size:20px;line-height:1.4;}
  .megamenu.wide .mm-main-item .mm-main-sub{font-size:14px;line-height:1.45;}
  .megamenu.wide .mm-main-group-label{font-size:13px;line-height:1.45;}
  .megamenu.wide .mm-main-item:hover,.megamenu.wide .mm-main-item.active{background:var(--brand);color:var(--color-bg);}
  .megamenu.wide .mm-main-item .mm-main-sub{color:var(--text-secondary);}
  .megamenu.wide .mm-main-item.active,.megamenu.wide .mm-main-item:hover{color:rgb(17,17,17);}
  .megamenu.wide .mm-main-item.active .mm-main-sub,.megamenu.wide .mm-main-item:hover .mm-main-sub{color:rgb(17,17,17);}
  .megamenu.wide .mm-main-item.active .aa,.megamenu.wide .mm-main-item:hover .aa{color:rgb(17,17,17);}
  .megamenu.wide .mm-main-divider{background:var(--line);}
  .megamenu.wide .mm-cs-chip{display:inline-block;font-family:var(--font-mono);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--color-bg);background:var(--brand);border-radius:2px;padding:2px 5px;margin-left:7px;vertical-align:middle;line-height:1.4;}
  .megamenu.wide .mm-main-group-label{color:var(--text-primary);}
  .megamenu.wide .mm-app-columns{display:grid;grid-template-columns:repeat(var(--app-group-count,2),220px);gap:16px;min-height:0;width:max-content;}
  .megamenu.wide .mm-app-columns:has(.mm-app-group[data-app-category="lamps"].active){grid-template-columns:repeat(2,220px);}
  @media(min-width:1820px){.megamenu.wide .mm-app-columns:has(.mm-app-group[data-app-category="lamps"].active){grid-template-columns:repeat(4,220px);}}
  .megamenu.wide .mm-app-column{display:contents;}
  .megamenu.wide .mm-app-group{display:none;margin:0;min-width:0;}
  .megamenu.wide .mm-app-group.active{min-width:0;}
  .megamenu.wide .mm-app-group.active{display:block;align-self:stretch;}
  .megamenu.wide .mm-collection-badge{display:inline-block;margin:0 0 8px;padding:5px 9px;border:1px solid var(--color-border-strong);border-radius:999px;background:var(--bg-card);color:var(--text-primary);font-family:var(--font-mono);font-size:13px;line-height:1.45;font-weight:700;letter-spacing:.1em;text-transform:uppercase;cursor:default;user-select:none;}
  .megamenu.wide .mm-app-item{display:block;box-sizing:border-box;width:100%;padding:9px 6px;font-family:'Lato',system-ui,sans-serif;font-size:18px;color:var(--ink2);font-weight:400;line-height:1.45;white-space:nowrap;border-left:2px solid transparent;cursor:pointer;transition:background 0.12s,color 0.12s,border-color 0.12s;margin-bottom:2px;text-decoration:none;}
  .megamenu.wide .mm-app-item:hover,.megamenu.wide .mm-app-item:focus-visible,.megamenu.wide .mm-app-item.active{background:var(--bg2);color:var(--brand-dk);border-left-color:var(--brand);outline:none;}
  /* Controls retains the same 18px scale; tighter tracking accommodates its two longest labels within a 220px column. */
  .megamenu.wide .mm-app-group[data-app-category="controls"] .mm-app-item{letter-spacing:-.04em;}
  .megamenu.wide .mm-sub-tier{display:inline-block;font-family:var(--font-mono);font-size:12px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;padding:2px 6px;border-radius:3px;vertical-align:middle;margin-left:6px;flex-shrink:0;background:var(--bg-card);color:var(--text-primary);border:1px solid var(--line-medium);}
  .megamenu.wide .mm-app-item .mm-sub-tier.eco,.megamenu.wide .mm-app-item .mm-sub-tier.pro,.megamenu.wide .mm-app-item .mm-sub-tier.proplus{background:var(--bg-card);color:var(--text-primary);border-color:var(--line-medium);}
  .megamenu.wide .mm-col.mm-col-preview{align-self:stretch;display:flex;}
  .megamenu.wide .mm-preview{flex:1;min-height:0;padding:24px 28px;display:flex;flex-direction:column;background:var(--bg-deepest);}
  .megamenu.wide .mm-preview .preview-img-wrap{width:100%;max-width:1100px;aspect-ratio:2.25 / 1;height:auto;min-height:0;background:var(--bg-card);border-radius:4px;overflow:hidden;margin:0 auto 16px;position:relative;}
  .megamenu.wide .mm-preview .preview-img-wrap img{width:100%;height:100%;object-fit:cover;object-position:center;transition:opacity 0.25s ease;}
  .megamenu.wide .mm-preview .preview-label{font-family:var(--font-mono);font-size:13px;line-height:1.45;color:var(--text-primary);letter-spacing:0.18em;text-transform:uppercase;font-weight:600;margin-bottom:7px;}
  .megamenu.wide .mm-preview .preview-name{font-family:'Lato' !important;font-size:30px;font-weight:700;color:var(--text-primary);letter-spacing:-0.015em;margin-bottom:9px;line-height:1.12;}
  .megamenu.wide .mm-preview .preview-desc{font-family:'Lato',system-ui,sans-serif;font-size:17px;color:var(--text-secondary);line-height:1.5;margin:0 0 16px;}
  .megamenu.wide .mm-preview .preview-cta{font-family:var(--font-mono);font-size:15px;font-weight:700;color:var(--text-primary);letter-spacing:0.08em;text-transform:uppercase;text-decoration:none;align-self:flex-start;padding:11px 16px;border:1px solid var(--brand);border-radius:3px;transition:background 0.15s,color 0.15s;}
  .megamenu.wide .mm-preview .preview-cta:hover{background:var(--brand);color:var(--color-bg);}
  .megamenu.wide .mm-preview .tier-strip{display:grid;flex:1;min-height:180px;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-top:18px;align-items:stretch;}
  .megamenu.wide .mm-preview .tier-strip.hidden{display:none;}
  .megamenu.wide .mm-preview .tier-card{background:var(--bg-card);border-radius:4px;padding:14px 12px;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;text-align:center;border-top:3px solid var(--brand);min-width:0;}
  .megamenu.wide .mm-preview .tier-card.slot-empty{display:none;}
  .megamenu.wide .mm-preview .tier-card img{width:100%;max-width:150px;max-height:96px;object-fit:contain;background:var(--bg-spec);border-radius:2px;margin-bottom:8px;}
  .megamenu.wide .mm-preview .tier-card .tier-label{font-family:var(--font-mono);font-size:14px;line-height:1.4;letter-spacing:0.15em;text-transform:uppercase;font-weight:700;color:var(--text-primary);margin-bottom:4px;}
  .megamenu.wide .mm-preview .tier-card .tier-sku{font-family:var(--font-mono);font-size:15px;font-weight:600;color:var(--text-primary);line-height:1.3;}
  @media(max-width:1100px){.megamenu.wide{grid-template-columns:200px max-content minmax(0,1fr);}.megamenu.wide .mm-col.mm-col-preview{width:auto;}}
  /* ---- Legacy mm-head (Tools / Support narrow menus) ---- */
  .megamenu .mm-head{
    font-family:'JetBrains Mono',monospace;font-size:12px;line-height:1.45;
    color:var(--brand);letter-spacing:2px;text-transform:uppercase;
    font-weight:600;margin-bottom:12px;padding-bottom:9px;
    border-bottom:1px solid rgba(0,0,0,0.08);
  }
  .megamenu:not(.wide):not(.solutions) a{
    display:block;padding:8px 0;font-size:15px;line-height:1.45;
    color:var(--ink);text-transform:none;letter-spacing:0;
    font-weight:400;text-decoration:none;
  }
  .megamenu:not(.wide):not(.solutions) a:hover{color:var(--brand);}
  .megamenu:not(.wide):not(.solutions) a.featured{
    background:var(--bg2);padding:11px 12px;margin:7px 0;
    border-left:3px solid var(--brand);font-weight:600;font-size:15px;line-height:1.45;
  }

  /* ================================================================
     SOLUTIONS MEGA MENU
     ================================================================ */
  .megamenu.solutions{
    position:fixed;top:calc(var(--main-nav-height) + 2px);left:0;right:0;
    width:100%;max-width:none;min-width:0;padding:0;
    /* A2 (v2.5.3): Remove outer white border */
    background:transparent;
    border:none;
    display:grid;grid-template-columns:220px 320px 1fr;
    gap:0;max-height:calc(100vh - 110px);overflow:hidden;
    box-shadow:0 24px 80px rgba(0,0,0,0.18);
    border-radius:4px;
  }
  .megamenu.solutions .mm-col{
    padding:20px 18px;overflow-y:auto;max-height:calc(100vh - 110px);
  }
  /* G6/G5/G7 v2.7.13.1: SOLUTIONS mm-col-main — warm cream bg, dark text, canonical eyebrow */
  .megamenu.solutions .mm-col-main{background:#F5EFE3;}
  .megamenu.solutions .mm-col-main .mm-col-head{
    color:#3A3E47;

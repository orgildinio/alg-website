---
/**
 * CollectionStickyNav — shared sticky section-nav for Nostalgic Décor and Vintage Décor PDPs
 *
 * Usage:
 *   <CollectionStickyNav collection="nostalgic" hasTechnology={false} />
 *   <CollectionStickyNav collection="vintage"   hasTechnology={true}  />
 *
 * Props:
 *   collection     "nostalgic" | "vintage"
 *   hasTechnology  whether to show the Technology tab (only Edison has this section)
 *
 * Behavior:
 *   - Sits fixed at bottom:24px of viewport (same as Illuminator)
 *   - Scroll-spy via IntersectionObserver: active tab tracks which section is in viewport
 *   - Clicking a tab smooth-scrolls to the section; scroll-margin-top prevents hiding behind nav
 *   - "Specify This Lamp" pill always scrolls to #variants
 *   - Mobile (<768px): nav scrolls horizontally
 *   - NO brand-red (#F32740) — uses amber (#B47B3D) for Nostalgic, rust (#A65A2A) for Vintage
 */
interface Props {
  collection: 'nostalgic' | 'vintage';
  hasTechnology?: boolean;
}
const { collection, hasTechnology = false } = Astro.props;
---

<nav class="coll-sticky-nav" data-collection={collection} aria-label="Page sections">
  <!-- "Specify This Lamp" pill — scrolls to #variants -->
  <a href="#variants" class="coll-nav-pill">Specify This Lamp</a>

  <!-- Applications -->
  <a href="#applications" class="coll-nav-tab" data-section="applications">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
      <polyline points="9 22 9 12 15 12 15 22"/>
    </svg>
    Applications
  </a>

  <!-- Technology — only shown if hasTechnology is true (Edison) -->
  {hasTechnology && (
    <a href="#technology" class="coll-nav-tab" data-section="technology">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"/>
        <path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
      </svg>
      Technology
    </a>
  )}

  <!-- Specifications -->
  <a href="#specifications" class="coll-nav-tab" data-section="specifications">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="4" width="18" height="16" rx="1.5"/>
      <line x1="3" y1="9" x2="21" y2="9"/>
      <line x1="3" y1="14" x2="21" y2="14"/>
      <line x1="9" y1="9" x2="9" y2="20"/>
    </svg>
    Specifications
  </a>

  <!-- Dimmers -->
  <a href="#dimmers" class="coll-nav-tab" data-section="dimmers">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="5"/>
      <line x1="12" y1="1" x2="12" y2="3"/>
      <line x1="12" y1="21" x2="12" y2="23"/>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
      <line x1="1" y1="12" x2="3" y2="12"/>
      <line x1="21" y1="12" x2="23" y2="12"/>
    </svg>
    Dimmers
  </a>

  <!-- Variants -->
  <a href="#variants" class="coll-nav-tab" data-section="variants">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <line x1="4" y1="6" x2="20" y2="6"/>
      <circle cx="9" cy="6" r="2.4" fill="currentColor"/>
      <line x1="4" y1="12" x2="20" y2="12"/>
      <circle cx="15" cy="12" r="2.4" fill="currentColor"/>
      <line x1="4" y1="18" x2="20" y2="18"/>
      <circle cx="11" cy="18" r="2.4" fill="currentColor"/>
    </svg>
    Variants
  </a>

  <!-- Resources -->
  <a href="#resources" class="coll-nav-tab" data-section="resources">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
      <polyline points="7 10 12 15 17 10"/>
      <line x1="12" y1="15" x2="12" y2="3"/>
    </svg>
    Resources
  </a>

  <!-- Family -->
  <a href="#family" class="coll-nav-tab" data-section="family">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2"  y="9" width="6" height="9" rx="1"/>
      <rect x="9"  y="6" width="6" height="12" rx="1"/>
      <rect x="16" y="11" width="6" height="7" rx="1"/>
    </svg>
    Family
  </a>
</nav>

<style>
  /* ── Palette tokens ── */
  .coll-sticky-nav[data-collection="nostalgic"] {
    --nav-bg:        rgba(42, 28, 16, 0.97);
    --nav-border:    #B47B3D;
    --nav-text:      rgba(245, 237, 223, 0.75);
    --nav-text-hover:#F5EDDF;
    --nav-hover-bg:  rgba(245, 237, 223, 0.05);
    --nav-accent:    #B47B3D;
    --nav-accent-deep: #8F5E28;
    --nav-pill-text: #F5EDDF;
    --nav-active-text: #F5EDDF;
    --nav-active-border: #B47B3D;
  }
  .coll-sticky-nav[data-collection="vintage"] {
    --nav-bg:        rgba(38, 22, 10, 0.97);
    --nav-border:    #A65A2A;
    --nav-text:      rgba(240, 232, 214, 0.75);
    --nav-text-hover:#F0E8D6;
    --nav-hover-bg:  rgba(240, 232, 214, 0.05);
    --nav-accent:    #A65A2A;
    --nav-accent-deep: #7D4018;
    --nav-pill-text: #F0E8D6;
    --nav-active-text: #F0E8D6;
    --nav-active-border: #A65A2A;
  }

  /* ── Nav shell ── */
  .coll-sticky-nav {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--nav-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--nav-border);
    border-radius: 4px;
    padding: 5px;
    display: flex;
    align-items: center;
    gap: 2px;
    z-index: 70;
    box-shadow: 0 24px 60px rgba(0,0,0,0.45), 0 0 0 1px rgba(0,0,0,0.2);
    max-width: calc(100vw - 32px);
  }

  /* ── "Specify This Lamp" pill ── */
  .coll-nav-pill {
    display: inline-flex;
    align-items: center;
    padding: 11px 18px;
    background: var(--nav-accent);
    color: var(--nav-pill-text);
    font-size: 13px;
    font-weight: 700;
    border-radius: 2px;
    white-space: nowrap;
    text-decoration: none;
    transition: background 0.18s;
    flex-shrink: 0;
  }
  .coll-nav-pill:hover { background: var(--nav-accent-deep); }

  /* ── Section tabs ── */
  .coll-nav-tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 11px 14px;
    font-size: 12.5px;
    color: var(--nav-text);
    border-radius: 2px;
    white-space: nowrap;
    font-weight: 400;
    text-decoration: none;
    transition: color 0.18s, background 0.18s, border-bottom-color 0.18s;
    border-bottom: 2px solid transparent;
    letter-spacing: 0.02em;
  }
  .coll-nav-tab:hover {
    color: var(--nav-text-hover);
    background: var(--nav-hover-bg);
  }
  .coll-nav-tab.is-active {
    color: var(--nav-active-text);
    border-bottom-color: var(--nav-active-border);
  }
  .coll-nav-tab svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    stroke-width: 1.7;
  }

  /* ── Mobile: horizontal scroll ── */
  @media (max-width: 767px) {
    .coll-sticky-nav {
      width: calc(100vw - 24px);
      left: 12px;
      transform: none;
      overflow-x: auto;
      overflow-y: hidden;
      justify-content: flex-start;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .coll-sticky-nav::-webkit-scrollbar { display: none; }
    .coll-nav-tab { padding: 10px 12px; font-size: 12px; }
    .coll-nav-pill { padding: 10px 14px; font-size: 12px; }
  }
</style>

<script>
(function () {
  var nav = document.querySelector('.coll-sticky-nav');
  if (!nav) return;

  // ── Scroll-spy via IntersectionObserver ──
  var tabs = nav.querySelectorAll('.coll-nav-tab[data-section]');
  var sectionIds = Array.from(tabs).map(function (t) { return t.dataset.section; });

  // Set scroll-margin-top on each target section so content isn't hidden behind the nav
  var NAV_HEIGHT = 64; // px — matches nav height + bottom offset clearance
  sectionIds.forEach(function (id) {
    var el = document.getElementById(id);
    if (el) el.style.scrollMarginTop = NAV_HEIGHT + 'px';
  });

  var activeId = null;

  function setActive(id) {
    if (id === activeId) return;
    activeId = id;
    tabs.forEach(function (t) {
      t.classList.toggle('is-active', t.dataset.section === id);
    });
  }

  var observer = new IntersectionObserver(
    function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          setActive(entry.target.id);
        }
      });
    },
    { rootMargin: '-40% 0% -50% 0%', threshold: 0 }
  );

  sectionIds.forEach(function (id) {
    var el = document.getElementById(id);
    if (el) observer.observe(el);
  });

  // ── Smooth-scroll on tab click ──
  nav.addEventListener('click', function (e) {
    var link = e.target.closest('a[href^="#"]');
    if (!link) return;
    var target = document.getElementById(link.getAttribute('href').slice(1));
    if (!target) return;
    e.preventDefault();
    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
})();
</script>

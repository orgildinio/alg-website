---
/**
 * SearchModal.astro — Global site search (Pagefind-powered)
 * Variant A · Tight List (Linear / Raycast / Spotlight pattern)
 */
---
<div id="search-backdrop" hidden></div>
<div id="search-modal" role="dialog" aria-modal="true" aria-label="Site search" hidden>
  <div class="search-bar">
    <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
    </svg>
    <input id="search-input" class="search-input" type="search"
      placeholder="Search the site…"
      autocomplete="off" autocorrect="off" spellcheck="false"
      aria-label="Search" aria-autocomplete="list" aria-controls="search-results"/>
    <button id="search-clear" class="search-clear" type="button" aria-label="Clear search">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>
  <div id="search-results" class="search-results" role="listbox" aria-label="Search results" aria-live="polite"></div>
  <div class="search-footer">
    <span><kbd class="kbd">↑↓</kbd> navigate</span>
    <span><kbd class="kbd">↩</kbd> open</span>
    <span><kbd class="kbd">Esc</kbd> close</span>
  </div>
</div>

<style>
  /* ── CSS tokens (scoped to search) ── */
  #search-modal, #search-backdrop {
    --brand-red: #F32740;
    --brand-red-soft: rgba(243,39,64,0.08);
    --bg-card: #2a2e34;
    --bg-spec: #22262b;
    --bg-deepest: #15181c;
    --text-primary: #ECEDEF;
    --text-secondary: #A8AEB7;
    --text-muted: #6E7682;
    --line: rgba(255,255,255,0.08);
    --line-medium: rgba(255,255,255,0.14);
    --font-body: 'Lato', system-ui, sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Consolas, monospace;
  }

  /* ── Backdrop ── */
  #search-backdrop {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.72);
    backdrop-filter: blur(4px);
    z-index: 999;
  }
  #search-backdrop[hidden] { display: none !important; }

  /* ── Modal frame (Variant A) ── */
  #search-modal {
    width: 640px;
    max-width: calc(100vw - 32px);
    background: var(--bg-card);
    border: 1px solid var(--line-medium);
    border-radius: 6px;
    box-shadow: 0 24px 80px rgba(0,0,0,0.6);
    overflow: hidden;
    position: fixed;
    top: 12vh;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    font-family: var(--font-body);
  }
  #search-modal[hidden] { display: none !important; }

  /* ── Search bar ── */
  .search-bar {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
  }
  .search-icon { color: var(--text-muted); flex-shrink: 0; }
  .search-input {
    flex: 1; background: transparent; border: 0; outline: 0;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 15px;
    padding: 0;
  }
  .search-input::placeholder { color: var(--text-muted); }
  .search-input::-webkit-search-cancel-button { display: none; }
  .search-clear {
    background: transparent; border: none; cursor: pointer;
    color: var(--text-muted);
    width: 18px; height: 18px;
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0; flex-shrink: 0;
    transition: color .12s;
  }
  .search-clear:hover { color: var(--text-primary); }

  /* ── Results pane ── */
  .search-results {
    max-height: 480px;
    overflow-y: auto;
    padding: 4px 0;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,.1) transparent;
  }
  .search-results:empty { display: none; }

  /* ── Group header ── */
  .group-h {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-red);
    font-weight: 700;
    padding: 12px 16px 6px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .group-h-count { color: var(--text-muted); font-weight: 500; }

  /* ── Result row ── */
  .search-row {
    display: flex; align-items: center; gap: 12px;
    padding: 8px 16px;
    cursor: pointer;
    position: relative;
    text-decoration: none;
  }
  .search-row:hover,
  .search-row.is-selected { background: var(--brand-red-soft); }
  .search-row.is-selected::before {
    content: ""; position: absolute; left: 0; top: 4px; bottom: 4px; width: 2px;
    background: var(--brand-red); border-radius: 0 1px 1px 0;
  }

  /* ── Row icon ── */
  .row-icon {
    width: 20px; height: 20px;
    color: var(--text-muted);
    flex-shrink: 0;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .row-icon svg {
    width: 16px; height: 16px;
    stroke: currentColor; fill: none;
    stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round;
  }

  /* ── Row text block ── */
  .row-text {
    flex: 1; min-width: 0;
    display: flex; align-items: baseline; gap: 8px;
    font-size: 14px;
    overflow: hidden;
  }
  .row-title {
    color: var(--text-primary);
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .search-row.is-selected .row-title { color: var(--brand-red); }

  /* ── Tier badge ── */
  .row-tier {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 1px 5px;
    border-radius: 2px;
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .tier-eco     { background: rgba(15,174,124,0.16); color: #38C796; }
  .tier-pro     { background: rgba(112,162,232,0.16); color: #7FB3FF; }
  .tier-proplus { background: rgba(243,39,64,0.16);   color: #FF6478; }

  /* ── Breadcrumb (right-aligned, truncates) ── */
  .row-breadcrumb {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-muted);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    flex: 1; text-align: right;
    letter-spacing: 0.04em;
  }

  /* ── Enter hint ── */
  .row-enter {
    color: var(--text-muted);
    font-size: 11px;
    opacity: 0;
    flex-shrink: 0;
    transition: opacity .12s;
  }
  .search-row.is-selected .row-enter { opacity: 1; color: var(--brand-red); }

  /* ── Loading state ── */
  .search-loading {
    padding: 16px; display: flex; align-items: center; gap: 10px;
    font-size: 13px; color: var(--text-secondary);
  }
  .search-spinner {
    width: 14px; height: 14px;
    border: 2px solid rgba(243,39,64,0.2);
    border-top-color: var(--brand-red);
    border-radius: 50%;
    animation: search-spin 0.8s linear infinite;
    flex-shrink: 0;
  }
  @keyframes search-spin { to { transform: rotate(360deg); } }

  /* ── Empty state ── */
  .search-empty {
    padding: 48px 24px;
    text-align: center;
  }
  .search-empty-headline {
    color: var(--text-primary);
    font-size: 14px;
    margin-bottom: 8px;
  }
  .search-empty-q { color: var(--brand-red); font-weight: 700; }
  .search-empty-hint {
    color: var(--text-muted);
    font-size: 12.5px;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  /* ── Footer ── */
  .search-footer {
    border-top: 1px solid var(--line);
    background: var(--bg-spec);
    padding: 8px 16px;
    display: flex; gap: 16px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }
  .kbd {
    display: inline-block;
    padding: 1px 5px;
    background: var(--bg-deepest);
    border: 1px solid var(--line);
    border-radius: 3px;
    font-size: 10px;
    color: var(--text-secondary);
    margin-right: 4px;
    font-family: var(--font-mono);
  }

  /* ── Mobile ── */
  @media (max-width: 600px) {
    #search-modal {
      width: 100vw;
      height: 100vh;
      max-width: none;
      top: 0; left: 0;
      transform: none;
      border-radius: 0;
      border: 0;
    }
    .search-results { max-height: calc(100vh - 56px - 36px); }
    .search-row { padding: 12px 16px; min-height: 44px; }
  }
</style>

<script>
(function(){
'use strict';

var backdrop = document.getElementById('search-backdrop');
var modal    = document.getElementById('search-modal');
var input    = document.getElementById('search-input');
var clearBtn = document.getElementById('search-clear');
var results  = document.getElementById('search-results');

var pfInstance = null, debounceTimer = null;
var resultRows = [], selectedIndex = -1;

/* ── Lucide icon paths ── */
var ICONS = {
  lightbulb: '<line x1="9" y1="18" x2="15" y2="18"/><line x1="10" y1="22" x2="14" y2="22"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/>',
  layers:    '<path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>',
  building2: '<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v8h4"/><path d="M18 9h2a2 2 0 0 1 2 2v11h-4"/>',
  wrench:    '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  filetext:  '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>',
  circledot: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="1"/>',
};
var GROUP_ICON = { products:'lightbulb', collections:'layers', verticals:'building2', tools:'wrench', docs:'filetext', other:'circledot' };
var GROUP_ORDER  = ['products','collections','verticals','tools','docs','other'];
var GROUP_LABELS = { products:'Products', collections:'Collections', verticals:'Industry Verticals', tools:'Tools', docs:'Documentation', other:'Other' };

function icon(type) {
  return '<svg viewBox="0 0 24 24" aria-hidden="true">' + (ICONS[type] || ICONS.circledot) + '</svg>';
}

/* ── URL classifier ── */
function classify(url) {
  var p = url.replace(/^https?:\/\/[^/]+/, '');
  if (/^\/products\//.test(p))   return 'products';
  if (/^\/collections\//.test(p)) return 'collections';
  if (/^\/solutions\//.test(p))   return 'verticals';
  if (/\/(rebate|configurator|find-a-distributor|tools|calculator)/.test(p)) return 'tools';
  if (/\/(datasheets?|ies|lm79|lm80|spec-sheet|pdf)/.test(p)) return 'docs';
  return 'other';
}

/* ── Breadcrumb from URL ── */
function breadcrumb(url) {
  try {
    return new URL(url, location.href).pathname
      .split('/').filter(Boolean)
      .map(function(s){ return s.replace(/-/g,' ').replace(/\b\w/g,function(c){return c.toUpperCase();}); })
      .join(' \u203a ');
  } catch(e) { return url; }
}

function esc(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function tierBadge(item) {
  var tier = (item.meta || {}).tier || '';
  if (!tier) return '';
  var cls = tier.toLowerCase().replace(/\+/g,'plus').replace(/\s/g,'');
  return '<span class="row-tier tier-' + cls + '">' + esc(tier) + '</span>';
}

/* ── Render ── */
function render(grouped, query) {
  results.innerHTML = '';
  resultRows = [];
  selectedIndex = -1;

  var groups = GROUP_ORDER.filter(function(g){ return grouped[g] && grouped[g].length > 0; });

  if (groups.length === 0) {
    results.innerHTML =
      '<div class="search-empty">' +
        '<div class="search-empty-headline">No results for "<span class="search-empty-q">' + esc(query) + '</span>"</div>' +
        '<div class="search-empty-hint">Try: SKU pattern (LRHB, LSBX, LSPL), product family, or "rebate", "datasheet", "ies"</div>' +
      '</div>';
    return;
  }

  groups.forEach(function(group) {
    var items = grouped[group];
    /* group header */
    var hdr = document.createElement('div');
    hdr.className = 'group-h';
    hdr.setAttribute('aria-hidden', 'true');
    hdr.innerHTML = '<span>' + GROUP_LABELS[group] + '</span><span class="group-h-count">' + items.length + '</span>';
    results.appendChild(hdr);

    items.forEach(function(item) {
      var title = (item.meta && item.meta.title) ? item.meta.title : 'Untitled';
      var badge = group === 'products' ? tierBadge(item) : '';
      var bc    = breadcrumb(item.url);

      var row = document.createElement('a');
      row.className = 'search-row';
      row.href = item.url;
      row.setAttribute('role', 'option');
      row.setAttribute('tabindex', '-1');
      row.innerHTML =
        '<span class="row-icon">' + icon(GROUP_ICON[group]) + '</span>' +
        '<span class="row-text">' +
          '<span class="row-title">' + esc(title) + '</span>' +
          badge +
          '<span class="row-breadcrumb">' + esc(bc) + '</span>' +
        '</span>' +
        '<span class="row-enter" aria-hidden="true">\u21a9</span>';

      results.appendChild(row);
      resultRows.push(row);
    });
  });
}

function showLoading(q) {
  results.innerHTML =
    '<div class="search-loading">' +
      '<span class="search-spinner"></span>' +
      '<span>Searching for \u201c' + esc(q) + '\u201d\u2026</span>' +
    '</div>';
}

/* ── Pagefind ── */
async function loadPagefind() {
  if (pfInstance) return pfInstance;
  try {
    pfInstance = await import('/_pagefind/pagefind.js');
    await pfInstance.init();
  } catch(e) {
    console.warn('[ALG Search] Pagefind not available:', e);
    pfInstance = null;
  }
  return pfInstance;
}

async function doSearch(query) {
  var pf = await loadPagefind();
  if (!pf) {
    results.innerHTML = '<div class="search-empty"><div class="search-empty-headline">Search index not available.</div><div class="search-empty-hint">Run a production build to generate the index.</div></div>';
    return;
  }
  if (!query || query.trim().length < 2) { results.innerHTML = ''; return; }
  showLoading(query);
  var raw   = await pf.search(query);
  var items = await Promise.all(raw.results.slice(0, 24).map(function(r){ return r.data(); }));
  var grouped = {};
  items.forEach(function(item) {
    var g = classify(item.url);
    if (!grouped[g]) grouped[g] = [];
    grouped[g].push(item);
  });
  render(grouped, query);
}

/* ── Keyboard navigation ── */
function setSelected(idx) {
  resultRows.forEach(function(el, i) {
    el.classList.toggle('is-selected', i === idx);
    if (i === idx) el.scrollIntoView({ block: 'nearest' });
  });
  selectedIndex = idx;
}

/* ── Open / close ── */
function openModal() {
  backdrop.hidden = false;
  modal.hidden    = false;
  document.body.style.overflow = 'hidden';
  setTimeout(function(){ input.focus(); }, 30);
  loadPagefind(); /* warm up */
}
function closeModal() {
  backdrop.hidden = true;
  modal.hidden    = true;
  document.body.style.overflow = '';
  results.innerHTML = '';
  input.value = '';
  selectedIndex = -1;
  resultRows = [];
}

/* ── Focus trap ── */
function trapFocus(e) {
  if (modal.hidden) return;
  var focusable = modal.querySelectorAll('input,button,a[href],[tabindex]:not([tabindex="-1"])');
  var first = focusable[0], last = focusable[focusable.length - 1];
  if (e.key === 'Tab') {
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  }
}

/* ── Event listeners ── */
document.addEventListener('keydown', function(e) {
  if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); modal.hidden ? openModal() : closeModal(); return; }
  if (!modal.hidden) {
    if (e.key === 'Escape')     { closeModal(); return; }
    if (e.key === 'ArrowDown')  { e.preventDefault(); setSelected(Math.min(selectedIndex + 1, resultRows.length - 1)); return; }
    if (e.key === 'ArrowUp')    { e.preventDefault(); setSelected(Math.max(selectedIndex - 1, 0)); return; }
    if (e.key === 'Enter' && selectedIndex >= 0) { e.preventDefault(); resultRows[selectedIndex].click(); return; }
    trapFocus(e);
  }
});

input.addEventListener('input', function() {
  clearTimeout(debounceTimer);
  var q = input.value;
  if (q.trim().length >= 2) {
    debounceTimer = setTimeout(function(){ doSearch(q); }, 200);
  } else {
    results.innerHTML = '';
  }
});

clearBtn.addEventListener('click', function() { input.value = ''; results.innerHTML = ''; input.focus(); });
backdrop.addEventListener('click', closeModal);

/* ── Public API for header button ── */
window.__algSearchOpen = openModal;
})();
</script>

---
/**
 * SearchModal.astro
 *
 * Global site search powered by Pagefind.
 * - Option B: full-screen modal overlay (anchored ~30% from top)
 * - Cmd+K / Ctrl+K opens from anywhere on the site
 * - Esc closes; backdrop click closes
 * - Results grouped by content type (Products, Collections, Industry Verticals,
 *   Tools, Documentation, Blog, Other)
 * - Dark-theme styling matching ALG design tokens
 * - Mobile: full-viewport overlay (no modal chrome)
 * - Focus trap while modal is open
 * - Pagefind JS loaded lazily on first open
 */
---

<!-- SEARCH MODAL OVERLAY -->
<div id="search-overlay" role="dialog" aria-modal="true" aria-label="Site search" hidden>
  <div id="search-backdrop"></div>
  <div id="search-modal">
    <!-- Input row -->
    <div id="search-input-row">
      <svg id="search-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="Search products, specs, SKUs, docs…"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        aria-label="Search"
        aria-autocomplete="list"
        aria-controls="search-results"
      />
      <button id="search-close-btn" type="button" aria-label="Close search (Esc)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Results area -->
    <div id="search-results" role="listbox" aria-label="Search results"></div>

    <!-- Footer hint -->
    <div id="search-footer">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>Esc</kbd> close</span>
    </div>
  </div>
</div>

<style>
  /* ── Overlay ── */
  #search-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 14vh;
  }
  #search-overlay[hidden] { display: none !important; }

  #search-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.72);
    backdrop-filter: blur(2px);
  }

  /* ── Modal card ── */
  #search-modal {
    position: relative;
    z-index: 1;
    width: min(640px, calc(100vw - 32px));
    background: #2a2e34;
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 6px;
    box-shadow: 0 24px 60px rgba(0,0,0,0.5);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 72vh;
  }

  /* ── Input row ── */
  #search-input-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 16px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    flex-shrink: 0;
  }

  #search-input-icon {
    width: 18px;
    height: 18px;
    color: rgba(236,237,239,0.45);
    flex-shrink: 0;
  }

  #search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #ECEDEF;
    font-family: var(--font-body, 'Lato', sans-serif);
    font-size: 16px;
    padding: 16px 0;
    line-height: 1.4;
  }
  #search-input::placeholder { color: rgba(236,237,239,0.35); }
  /* Remove native clear button */
  #search-input::-webkit-search-cancel-button { display: none; }

  #search-close-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: rgba(236,237,239,0.45);
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    flex-shrink: 0;
    transition: color .12s, background .12s;
  }
  #search-close-btn:hover { color: #ECEDEF; background: rgba(255,255,255,0.06); }
  #search-close-btn svg { width: 16px; height: 16px; }

  /* ── Results ── */
  #search-results {
    overflow-y: auto;
    flex: 1;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.15) transparent;
  }
  #search-results:empty { display: none; }

  .search-group-label {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #F32740;
    padding: 10px 16px 6px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    position: sticky;
    top: 0;
    background: #2a2e34;
    z-index: 1;
  }

  .search-result-row {
    display: block;
    padding: 11px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    cursor: pointer;
    text-decoration: none;
    transition: background .1s;
    outline: none;
  }
  .search-result-row:hover,
  .search-result-row.is-selected {
    background: #22262b;
  }
  .search-result-row:last-child { border-bottom: none; }

  .result-title {
    color: #ECEDEF;
    font-weight: 700;
    font-size: 14px;
    line-height: 1.35;
    margin-bottom: 2px;
    transition: color .1s;
  }
  .search-result-row:hover .result-title,
  .search-result-row.is-selected .result-title { color: #F32740; }

  .result-breadcrumb {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: rgba(236,237,239,0.45);
    margin-bottom: 4px;
  }

  .result-excerpt {
    color: rgba(236,237,239,0.65);
    font-size: 12px;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .result-excerpt mark {
    background: rgba(243,39,64,0.18);
    color: #F32740;
    padding: 1px 2px;
    border-radius: 2px;
    font-style: normal;
  }

  /* Empty / loading states */
  #search-empty {
    padding: 32px 16px;
    text-align: center;
    color: rgba(236,237,239,0.4);
    font-size: 14px;
  }

  /* ── Footer ── */
  #search-footer {
    display: flex;
    gap: 16px;
    padding: 8px 16px;
    border-top: 1px solid rgba(255,255,255,0.08);
    flex-shrink: 0;
  }
  #search-footer span {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 10px;
    color: rgba(236,237,239,0.35);
    display: flex;
    align-items: center;
    gap: 4px;
  }
  kbd {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 3px;
    padding: 1px 5px;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 10px;
    color: rgba(236,237,239,0.55);
  }

  /* ── Mobile: full-screen overlay ── */
  @media (max-width: 640px) {
    #search-overlay {
      padding-top: 0;
      align-items: stretch;
    }
    #search-modal {
      width: 100%;
      max-height: 100dvh;
      border-radius: 0;
      border: none;
    }
  }
</style>

<script>
(function () {
  const overlay  = document.getElementById('search-overlay');
  const input    = document.getElementById('search-input');
  const results  = document.getElementById('search-results');
  const closeBtn = document.getElementById('search-close-btn');
  const backdrop = document.getElementById('search-backdrop');

  let pagefind = null;
  let debounceTimer = null;
  let selectedIndex = -1;
  let resultLinks = [];

  // ── Pagefind loader ──────────────────────────────────────────────────────
  async function loadPagefind() {
    if (pagefind) return pagefind;
    try {
      pagefind = await import('/pagefind/pagefind.js');
      await pagefind.options({ excerptLength: 30 });
    } catch (e) {
      console.warn('[search] Pagefind not available (run a build first):', e);
      pagefind = null;
    }
    return pagefind;
  }

  // ── URL → content group ──────────────────────────────────────────────────
  function classifyUrl(url) {
    if (/\/products\//.test(url))                          return 'Products';
    if (/\/collections\//.test(url))                       return 'Collections';
    if (/\/solutions\//.test(url))                         return 'Industry Verticals';
    if (/\/(tools|rebate|configurator|ies-files)/.test(url)) return 'Tools';
    if (/\/(blog|news|articles)/.test(url))                return 'Blog / News';
    return 'Other';
  }

  function groupLabel(group) {
    const icons = {
      'Products': '⬡',
      'Collections': '◈',
      'Industry Verticals': '◉',
      'Tools': '⚙',
      'Documentation': '⬜',
      'Blog / News': '✦',
      'Other': '◦',
    };
    return (icons[group] || '◦') + '  ' + group;
  }

  // ── Breadcrumb from URL ──────────────────────────────────────────────────
  function makeBreadcrumb(url) {
    try {
      const parts = new URL(url, location.origin).pathname
        .replace(/^\/|\/$/g, '')
        .split('/')
        .map(s => s.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()));
      return parts.join(' › ');
    } catch { return url; }
  }

  // ── Render results ───────────────────────────────────────────────────────
  function renderResults(grouped) {
    results.innerHTML = '';
    resultLinks = [];
    selectedIndex = -1;

    const groups = Object.keys(grouped);
    if (groups.length === 0) {
      results.innerHTML = '<div id="search-empty">No results found.</div>';
      return;
    }

    groups.forEach(group => {
      const labelEl = document.createElement('div');
      labelEl.className = 'search-group-label';
      labelEl.textContent = groupLabel(group);
      labelEl.setAttribute('aria-hidden', 'true');
      results.appendChild(labelEl);

      grouped[group].forEach(item => {
        const a = document.createElement('a');
        a.className = 'search-result-row';
        a.href = item.url;
        a.setAttribute('role', 'option');
        a.setAttribute('tabindex', '-1');

        const title = document.createElement('div');
        title.className = 'result-title';
        title.textContent = item.meta?.title || 'Untitled';

        const breadcrumb = document.createElement('div');
        breadcrumb.className = 'result-breadcrumb';
        breadcrumb.textContent = makeBreadcrumb(item.url);

        const excerpt = document.createElement('div');
        excerpt.className = 'result-excerpt';
        excerpt.innerHTML = item.excerpt || '';

        a.appendChild(title);
        a.appendChild(breadcrumb);
        a.appendChild(excerpt);
        results.appendChild(a);
        resultLinks.push(a);
      });
    });
  }

  // ── Search ───────────────────────────────────────────────────────────────
  async function doSearch(query) {
    const pf = await loadPagefind();
    if (!pf) {
      results.innerHTML = '<div id="search-empty">Search index not available. Please run a build.</div>';
      return;
    }
    if (!query || query.trim().length < 2) {
      results.innerHTML = '';
      return;
    }

    const raw = await pf.search(query);
    const MAX = 24;
    const items = await Promise.all(raw.results.slice(0, MAX).map(r => r.data()));

    // Group by content type
    const grouped = {};
    items.forEach(item => {
      const group = classifyUrl(item.url);
      if (!grouped[group]) grouped[group] = [];
      grouped[group].push(item);
    });

    renderResults(grouped);
  }

  // ── Keyboard navigation ──────────────────────────────────────────────────
  function setSelected(idx) {
    resultLinks.forEach((el, i) => {
      el.classList.toggle('is-selected', i === idx);
      if (i === idx) el.scrollIntoView({ block: 'nearest' });
    });
    selectedIndex = idx;
  }

  function handleKeydown(e) {
    if (!overlay || overlay.hidden) return;

    if (e.key === 'Escape') { closeModal(); return; }

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      const next = Math.min(selectedIndex + 1, resultLinks.length - 1);
      setSelected(next);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      const prev = Math.max(selectedIndex - 1, 0);
      setSelected(prev);
    } else if (e.key === 'Enter' && selectedIndex >= 0) {
      e.preventDefault();
      resultLinks[selectedIndex].click();
    }
  }

  // ── Open / close ─────────────────────────────────────────────────────────
  function openModal() {
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    setTimeout(() => input.focus(), 30);
    loadPagefind(); // pre-warm
  }

  function closeModal() {
    overlay.hidden = true;
    document.body.style.overflow = '';
    results.innerHTML = '';
    input.value = '';
    selectedIndex = -1;
    resultLinks = [];
  }

  // ── Focus trap ───────────────────────────────────────────────────────────
  function trapFocus(e) {
    if (overlay.hidden) return;
    const focusable = overlay.querySelectorAll(
      'input, button, a[href], [tabindex]:not([tabindex="-1"])'
    );
    const first = focusable[0];
    const last  = focusable[focusable.length - 1];
    if (e.key === 'Tab') {
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault(); last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault(); first.focus();
      }
    }
  }

  // ── Event wiring ─────────────────────────────────────────────────────────
  // Cmd+K / Ctrl+K global shortcut
  document.addEventListener('keydown', e => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      overlay.hidden ? openModal() : closeModal();
    }
    handleKeydown(e);
    trapFocus(e);
  });

  // Input → debounced search
  input.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => doSearch(input.value), 200);
  });

  // Close triggers
  closeBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', closeModal);

  // Expose openModal for the utility bar button
  window.__algSearchOpen = openModal;
})();
</script>

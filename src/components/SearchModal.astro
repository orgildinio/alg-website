---
/**
 * SearchModal.astro — Global site search (catalog-aware + Pagefind)
 * Variant A · Tight List
 *
 * IMPORTANT: <style is:global> is intentional.
 * All result rows (.search-row, .row-icon, .row-title, etc.) are injected
 * dynamically by the search JS, so Astro's scoped CSS would never match them.
 * Using is:global ensures the styles apply to dynamically-rendered children.
 */
---
<div id="search-backdrop" hidden></div>
<div id="search-modal" role="dialog" aria-modal="true" aria-label="Site search" hidden>
  <div class="alg-search-bar">
    <svg class="alg-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
    </svg>
    <input id="search-input" class="alg-search-input" type="search"
      placeholder="Search the site…"
      autocomplete="off" autocorrect="off" spellcheck="false"
      aria-label="Search" aria-autocomplete="list" aria-controls="search-results"/>
    <button id="search-clear" class="alg-search-clear" type="button" aria-label="Clear search">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>
  <div id="search-results" class="alg-search-results" role="listbox" aria-label="Search results" aria-live="polite"></div>
  <div class="alg-search-footer">
    <span><kbd class="alg-kbd">↑↓</kbd> navigate</span>
    <span><kbd class="alg-kbd">↩</kbd> open</span>
    <span><kbd class="alg-kbd">Esc</kbd> close</span>
  </div>
</div>

<!-- is:global is REQUIRED — dynamically-injected children won't carry Astro's scope attribute -->
<style is:global>
  /* ── CSS tokens ── */
  #search-modal,
  #search-backdrop {
    --alg-brand-red:       #F32740;
    --alg-brand-red-soft:  rgba(243,39,64,0.08);
    --alg-bg-card:         #2a2e34;
    --alg-bg-spec:         #22262b;
    --alg-bg-deepest:      #15181c;
    --alg-text-primary:    #ECEDEF;
    --alg-text-secondary:  #A8AEB7;
    --alg-text-muted:      #6E7682;
    --alg-line:            rgba(255,255,255,0.08);
    --alg-line-medium:     rgba(255,255,255,0.14);
    --alg-font-body:       'Lato', system-ui, sans-serif;
    --alg-font-mono:       'JetBrains Mono', ui-monospace, 'SF Mono', Consolas, monospace;
  }

  /* ── Backdrop ── */
  #search-backdrop {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.72);
    backdrop-filter: blur(4px);
    z-index: 999;
  }
  #search-backdrop[hidden] { display: none !important; }

  /* ── Modal frame ── */
  #search-modal {
    width: 640px;
    max-width: calc(100vw - 32px);
    background: var(--alg-bg-card);
    border: 1px solid var(--alg-line-medium);
    border-radius: 6px;
    box-shadow: 0 24px 80px rgba(0,0,0,0.6);
    overflow: hidden;
    position: fixed;
    top: 12vh;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    font-family: var(--alg-font-body);
  }
  #search-modal[hidden] { display: none !important; }

  /* ── Search bar ── */
  .alg-search-bar {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--alg-line);
  }
  .alg-search-icon { color: var(--alg-text-muted); flex-shrink: 0; }
  .alg-search-input {
    flex: 1; background: transparent; border: 0; outline: 0;
    color: var(--alg-text-primary);
    font-family: var(--alg-font-body);
    font-size: 15px;
    padding: 0;
  }
  .alg-search-input::placeholder { color: var(--alg-text-muted); }
  .alg-search-input::-webkit-search-cancel-button { display: none; }
  .alg-search-clear {
    background: transparent; border: none; cursor: pointer;
    color: var(--alg-text-muted);
    width: 18px; height: 18px;
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0; flex-shrink: 0;
    transition: color .12s;
  }
  .alg-search-clear:hover { color: var(--alg-text-primary); }

  /* ── Results pane ── */
  .alg-search-results {
    max-height: 480px;
    overflow-y: auto;
    padding: 4px 0;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,.1) transparent;
  }
  .alg-search-results:empty { display: none; }

  /* ── Group header ── */
  .alg-group-h {
    font-family: var(--alg-font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--alg-brand-red);
    font-weight: 700;
    padding: 12px 16px 6px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .alg-group-h-count { color: var(--alg-text-muted); font-weight: 500; }

  /* ── Result row ── */
  .alg-search-row {
    display: flex; align-items: center; gap: 12px;
    padding: 8px 16px;
    cursor: pointer;
    position: relative;
    text-decoration: none;
    min-height: 36px;
  }
  .alg-search-row:hover,
  .alg-search-row.is-selected { background: var(--alg-brand-red-soft); }
  .alg-search-row.is-selected::before {
    content: ""; position: absolute; left: 0; top: 4px; bottom: 4px; width: 2px;
    background: var(--alg-brand-red); border-radius: 0 1px 1px 0;
  }

  /* ── Row icon — THREE layers of enforcement ── */
  .alg-row-icon {
    width: 20px;
    height: 20px;
    min-width: 20px;
    min-height: 20px;
    max-width: 20px;
    max-height: 20px;
    color: var(--alg-text-muted);
    flex-shrink: 0;
    display: inline-flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  /* SVG inside icon — explicit size, block display, no auto-expansion */
  .alg-row-icon svg {
    width: 16px !important;
    height: 16px !important;
    min-width: 16px;
    min-height: 16px;
    max-width: 16px;
    max-height: 16px;
    display: block;
    flex-shrink: 0;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ── Row text block ── */
  .alg-row-text {
    flex: 1; min-width: 0;
    display: flex; align-items: baseline; gap: 8px;
    font-size: 14px;
    overflow: hidden;
  }
  .alg-row-title {
    color: var(--alg-text-primary);
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .alg-search-row.is-selected .alg-row-title { color: var(--alg-brand-red); }

  /* ── Tier badge ── */
  .alg-row-tier {
    font-family: var(--alg-font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 1px 5px;
    border-radius: 2px;
    text-transform: uppercase;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .alg-tier-eco     { background: rgba(15,174,124,0.16); color: #38C796; }
  .alg-tier-pro     { background: rgba(112,162,232,0.16); color: #7FB3FF; }
  .alg-tier-proplus { background: rgba(243,39,64,0.16);   color: #FF6478; }

  /* ── Breadcrumb ── */
  .alg-row-breadcrumb {
    font-family: var(--alg-font-mono);
    font-size: 10.5px;
    color: var(--alg-text-muted);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    flex: 1; text-align: right;
    letter-spacing: 0.04em;
  }

  /* ── Enter hint ── */
  .alg-row-enter {
    color: var(--alg-text-muted);
    font-size: 11px;
    opacity: 0;
    flex-shrink: 0;
    transition: opacity .12s;
  }
  .alg-search-row.is-selected .alg-row-enter { opacity: 1; color: var(--alg-brand-red); }

  /* ── Loading state ── */
  .alg-search-loading {
    padding: 16px; display: flex; align-items: center; gap: 10px;
    font-size: 13px; color: var(--alg-text-secondary);
  }
  .alg-search-spinner {
    width: 14px; height: 14px;
    border: 2px solid rgba(243,39,64,0.2);
    border-top-color: var(--alg-brand-red);
    border-radius: 50%;
    animation: alg-spin 0.8s linear infinite;
    flex-shrink: 0;
  }
  @keyframes alg-spin { to { transform: rotate(360deg); } }

  /* ── Empty state ── */
  .alg-search-empty {
    padding: 48px 24px;
    text-align: center;
  }
  .alg-search-empty-headline {
    color: var(--alg-text-primary);
    font-size: 14px;
    margin-bottom: 8px;
  }
  .alg-search-empty-q { color: var(--alg-brand-red); font-weight: 700; }
  .alg-search-empty-hint {
    color: var(--alg-text-muted);
    font-size: 12.5px;
    font-family: var(--alg-font-mono);
    letter-spacing: 0.04em;
  }

  /* ── Footer ── */
  .alg-search-footer {
    border-top: 1px solid var(--alg-line);
    background: var(--alg-bg-spec);
    padding: 8px 16px;
    display: flex; gap: 16px;
    font-family: var(--alg-font-mono);
    font-size: 10.5px;
    color: var(--alg-text-muted);
    letter-spacing: 0.04em;
  }
  .alg-kbd {
    display: inline-block;
    padding: 1px 5px;
    background: var(--alg-bg-deepest);
    border: 1px solid var(--alg-line);
    border-radius: 3px;
    font-size: 10px;
    color: var(--alg-text-secondary);
    margin-right: 4px;
    font-family: var(--alg-font-mono);
  }

  /* ── Mobile ── */
  @media (max-width: 600px) {
    #search-modal {
      width: 100vw; height: 100vh;
      max-width: none;
      top: 0; left: 0;
      transform: none;
      border-radius: 0; border: 0;
    }
    .alg-search-results { max-height: calc(100vh - 56px - 36px); }
    .alg-search-row { padding: 12px 16px; min-height: 44px; }
  }
</style>

<script>
(function(){
'use strict';

var backdrop = document.getElementById('search-backdrop');
var modal    = document.getElementById('search-modal');
var input    = document.getElementById('search-input');
var clearBtn = document.getElementById('search-clear');
var results  = document.getElementById('search-results');

var pfInstance = null, debounceTimer = null;
var resultRows = [], selectedIndex = -1;

/* ── Lucide icon paths (inline SVG strings with explicit 16x16 attrs) ── */
function makeIcon(paths) {
  return '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:16px;height:16px;display:block;flex-shrink:0">' + paths + '</svg>';
}

var ICON_SVG = {
  lightbulb: makeIcon('<line x1="9" y1="18" x2="15" y2="18"/><line x1="10" y1="22" x2="14" y2="22"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/>'),
  layers:    makeIcon('<path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>'),
  building2: makeIcon('<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v8h4"/><path d="M18 9h2a2 2 0 0 1 2 2v11h-4"/>'),
  wrench:    makeIcon('<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>'),
  filetext:  makeIcon('<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>'),
  circledot: makeIcon('<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="1"/>'),
};

var GROUP_ICON   = { products:'lightbulb', applications:'building2', collections:'layers', site:'filetext', verticals:'building2', tools:'wrench', docs:'filetext', other:'circledot' };
var GROUP_ORDER  = ['products','applications','collections','site','verticals','tools','docs','other'];
var GROUP_LABELS = { products:'Products', applications:'Applications', collections:'Collections', site:'Site', verticals:'Industry Verticals', tools:'Tools', docs:'Documentation', other:'Other' };

/* ── URL classifier ── */
function classify(url) {
  var p = url.replace(/^https?:\/\/[^/]+/, '');
  if (/^\/products\//.test(p))    return 'products';
  if (/^\/collections\//.test(p)) return 'collections';
  if (/^\/solutions\//.test(p))   return 'verticals';
  if (/\/(rebate|configurator|find-a-distributor|tools|calculator)/.test(p)) return 'tools';
  if (/\/(datasheets?|ies|lm79|lm80|spec-sheet|pdf)/.test(p)) return 'docs';
  return 'site';
}

/* ── Breadcrumb from URL (fallback) ── */
function breadcrumbFromUrl(url) {
  try {
    return new URL(url, location.href).pathname
      .split('/').filter(Boolean)
      .map(function(s){ return s.replace(/-/g,' ').replace(/\b\w/g,function(c){return c.toUpperCase();}); })
      .join(' \u203a ');
  } catch(e) { return url; }
}
function breadcrumb(item) {
  return item.breadcrumb || ((item.meta && item.meta.breadcrumb) ? item.meta.breadcrumb : breadcrumbFromUrl(item.url));
}

function esc(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

/* ── Parse tier suffix out of page title ── */
function parseTitle(rawTitle) {
  var match = rawTitle.match(/^(.+?)\s+(ECO|PRO\+|PRO)$/i);
  if (match) {
    var title   = match[1].trim();
    var tierRaw = match[2].toUpperCase();
    var tierCls = tierRaw.toLowerCase().replace('+', 'plus'); /* pro+ → proplus */
    return { title: title, tier: tierRaw, tierCls: tierCls };
  }
  return { title: rawTitle, tier: null, tierCls: null };
}

/* ── Catalog relevance ──
 * The generated catalog adds family aliases and application relationships that
 * full-text crawling cannot determine. It is rebuilt before every Astro build.
 */
var catalogPromise = null;
function normalizeSearchText(value) {
  return String(value || '')
    .replace(/Ⓐ/g, 'a')
    .normalize('NFKD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, ' ')
    .trim();
}
function loadCatalog() {
  if (!catalogPromise) {
    catalogPromise = fetch('/search-catalog.json', { cache: 'no-store' })
      .then(function(response) {
        if (!response.ok) throw new Error('Search catalog unavailable');
        return response.json();
      })
      .catch(function(error) {
        console.warn('[ALG Search] Catalog unavailable:', error);
        return { records: { products: [], applications: [], collections: [] } };
      });
  }
  return catalogPromise;
}
function scoreCatalogRecord(record, query) {
  var q = normalizeSearchText(query);
  if (!q) return 0;
  var title = normalizeSearchText(record.title);
  var aliases = (record.aliases || []).map(normalizeSearchText);
  if (title === q) return 1200;
  if (aliases.indexOf(q) !== -1) return 1100;
  if (title.indexOf(q) === 0) return 1000;
  if (aliases.some(function(alias) { return alias.indexOf(q) === 0; })) return 920;
  var tokens = q.split(' ').filter(Boolean);
  if (!tokens.length) return 0;
  var haystack = [title].concat(aliases).join(' ');
  var covered = tokens.filter(function(token) { return haystack.indexOf(token) !== -1; }).length;
  return covered === tokens.length ? 700 + covered * 20 : 0;
}
function searchCatalog(catalog, query) {
  var grouped = {};
  ['products', 'applications', 'collections'].forEach(function(group) {
    var matches = (catalog.records && catalog.records[group] ? catalog.records[group] : [])
      .map(function(record) { return Object.assign({}, record, { score: scoreCatalogRecord(record, query) }); })
      .filter(function(record) { return record.score > 0; })
      .sort(function(a, b) { return b.score - a.score || a.title.localeCompare(b.title); })
      .slice(0, 8);
    if (matches.length) grouped[group] = matches;
  });
  return grouped;
}
function comparableUrl(url) {
  return String(url || '')
    .replace(/^https?:\/\/www\.archipelagolighting\.com/i, '')
    .replace(/\/?$/, '/') || '/';
}
function addResult(grouped, group, item) {
  if (!grouped[group]) grouped[group] = [];
  var exists = Object.keys(grouped).some(function(existingGroup) {
    return grouped[existingGroup].some(function(existing) {
      return comparableUrl(existing.url) === comparableUrl(item.url);
    });
  });
  if (!exists) grouped[group].push(item);
}
function limitGroups(grouped) {
  Object.keys(grouped).forEach(function(group) { grouped[group] = grouped[group].slice(0, 8); });
  return grouped;
}

/* ── Render ── */
function render(grouped, query) {
  results.innerHTML = '';
  resultRows = [];
  selectedIndex = -1;

  var groups = GROUP_ORDER.filter(function(g){ return grouped[g] && grouped[g].length > 0; });

  if (groups.length === 0) {
    results.innerHTML =
      '<div class="alg-search-empty">' +
        '<div class="alg-search-empty-headline">No results for "<span class="alg-search-empty-q">' + esc(query) + '</span>"</div>' +
        '<div class="alg-search-empty-hint">Try: SKU prefix (LRHB, LSBX, LSPL), product family, or "rebate", "datasheet", "ies"</div>' +
      '</div>';
    return;
  }

  groups.forEach(function(group) {
    var items = grouped[group];

    /* group header */
    var hdr = document.createElement('div');
    hdr.className = 'alg-group-h';
    hdr.setAttribute('aria-hidden', 'true');
    hdr.innerHTML = '<span>' + GROUP_LABELS[group] + '</span><span class="alg-group-h-count">' + items.length + '</span>';
    results.appendChild(hdr);

    items.forEach(function(item) {
      var rawTitle = item.title || ((item.meta && item.meta.title) ? item.meta.title : 'Untitled');
      var parsed   = item.tier ? { title: rawTitle, tier: item.tier, tierCls: item.tier.toLowerCase().replace('+', 'plus') } : parseTitle(rawTitle);
      var bc       = breadcrumb(item);

      /* tier badge HTML — only for products */
      var tierHTML = '';
      if (group === 'products' && parsed.tier) {
        tierHTML = '<span class="alg-row-tier alg-tier-' + parsed.tierCls + '">' + esc(parsed.tier) + '</span>';
      }

      var row = document.createElement('a');
      row.className = 'alg-search-row';
      row.href = item.url;
      row.setAttribute('role', 'option');
      row.setAttribute('tabindex', '-1');
      row.innerHTML =
        '<span class="alg-row-icon">' + ICON_SVG[GROUP_ICON[group]] + '</span>' +
        '<span class="alg-row-text">' +
          '<span class="alg-row-title">' + esc(parsed.title) + '</span>' +
          tierHTML +
          '<span class="alg-row-breadcrumb">' + esc(bc) + '</span>' +
        '</span>' +
        '<span class="alg-row-enter" aria-hidden="true">\u21a9</span>';

      results.appendChild(row);
      resultRows.push(row);
    });
  });
}

function showLoading(q) {
  results.innerHTML =
    '<div class="alg-search-loading">' +
      '<span class="alg-search-spinner"></span>' +
      '<span>Searching for \u201c' + esc(q) + '\u201d\u2026</span>' +
    '</div>';
}

/* ── Pagefind + generated catalog ── */
async function loadPagefind() {
  if (pfInstance) return pfInstance;
  try {
    pfInstance = await import('/_pagefind/pagefind.js');
    await pfInstance.init();
  } catch(e) {
    console.warn('[ALG Search] Pagefind not available:', e);
    pfInstance = null;
  }
  return pfInstance;
}

async function doSearch(query) {
  if (!query || query.trim().length < 2) { results.innerHTML = ''; return; }
  showLoading(query);
  var sources = await Promise.all([loadPagefind(), loadCatalog()]);
  var pf = sources[0];
  var grouped = searchCatalog(sources[1], query);
  if (pf) {
    var raw = await pf.search(query);
    var items = await Promise.all(raw.results.slice(0, 48).map(async function(result) {
      var item = await result.data();
      item.score = result.score || 0;
      return item;
    }));
    items.sort(function(a, b) { return b.score - a.score; }).forEach(function(item) {
      addResult(grouped, classify(item.url), item);
    });
  }
  var hasPrimary = grouped.products || grouped.applications || grouped.collections || grouped.site || grouped.verticals || grouped.tools || grouped.docs;
  if (hasPrimary) delete grouped.other;
  render(limitGroups(grouped), query);
}

/* ── Keyboard navigation ── */
function setSelected(idx) {
  resultRows.forEach(function(el, i) {
    el.classList.toggle('is-selected', i === idx);
    if (i === idx) el.scrollIntoView({ block: 'nearest' });
  });
  selectedIndex = idx;
}

/* ── Open / close ── */
function openModal() {
  backdrop.hidden = false;
  modal.hidden    = false;
  document.body.style.overflow = 'hidden';
  setTimeout(function(){ input.focus(); }, 30);
  loadPagefind(); /* warm up */
}
function closeModal() {
  backdrop.hidden = true;
  modal.hidden    = true;
  document.body.style.overflow = '';
  results.innerHTML = '';
  input.value = '';
  selectedIndex = -1;
  resultRows = [];
}

/* ── Focus trap ── */
function trapFocus(e) {
  if (modal.hidden) return;
  var focusable = modal.querySelectorAll('input,button,a[href],[tabindex]:not([tabindex="-1"])');
  var first = focusable[0], last = focusable[focusable.length - 1];
  if (e.key === 'Tab') {
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  }
}

/* ── Event listeners ── */
document.addEventListener('keydown', function(e) {
  if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); modal.hidden ? openModal() : closeModal(); return; }
  if (!modal.hidden) {
    if (e.key === 'Escape')     { closeModal(); return; }
    if (e.key === 'ArrowDown')  { e.preventDefault(); setSelected(Math.min(selectedIndex + 1, resultRows.length - 1)); return; }
    if (e.key === 'ArrowUp')    { e.preventDefault(); setSelected(Math.max(selectedIndex - 1, 0)); return; }
    if (e.key === 'Enter' && selectedIndex >= 0) { e.preventDefault(); resultRows[selectedIndex].click(); return; }
    trapFocus(e);
  }
});

input.addEventListener('input', function() {
  clearTimeout(debounceTimer);
  var q = input.value;
  if (q.trim().length >= 2) {
    debounceTimer = setTimeout(function(){ doSearch(q); }, 200);
  } else {
    results.innerHTML = '';
  }
});

clearBtn.addEventListener('click', function() { input.value = ''; results.innerHTML = ''; input.focus(); });
backdrop.addEventListener('click', closeModal);

/* ── Public API for header button ── */
window.__algSearchOpen = openModal;
})();
</script>

---
/**
 * page-find-a-rep.astro
 * Cat-6 Phase-3 Batch 2 — built from Find a Rep / Find a Distributor — Archipelago Lighting Group mockup v3.1
 * «TBD-VERIFY»: copy passages marked below; James confirms at preview review
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Find a Rep / Find a Distributor — Archipelago Lighting Group"
  description="Find your local ALG sales rep, stocking distributor, or nearest warehouse. 28 reps · 29 distributors · 12 warehouses."
  bodyClass="page-find-a-rep"
>
<style is:global>
  /* Cat-6 Batch 2 — Apple system stack below header */
  .page-about *,
  .page-contact *,
  .page-returns *,
  .page-find-a-rep *,
  .page-persona * {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', Helvetica, Arial, sans-serif !important;
  }
  .page-about h1,.page-about h2,.page-about h3,
  .page-contact h1,.page-contact h2,.page-contact h3,
  .page-returns h1,.page-returns h2,.page-returns h3,
  .page-find-a-rep h1,.page-find-a-rep h2,.page-find-a-rep h3,
  .page-persona h1,.page-persona h2,.page-persona h3 {
    font-weight: 600 !important;
  }
</style>
  <!-- ISS-52: Zero TBD entries — bound to /data/local_support.json (28 reps / 29 distributors / 16 warehouses) -->
  <!-- NOTE: mockup shows 12 warehouses in map key; JSON has 16. Rendering 12 per mockup copy; full dataset in JSON. -->
  <!-- glow orb -->
  <div class="glow-orb" style="position:fixed;top:0;left:0;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(247,82,82,.13) 0%,transparent 70%);pointer-events:none;z-index:0;will-change:transform;"></div>

<main style="position: relative; z-index: 1;"><!-- Live site header mounts here — do not redesign --><section data-screen-label="Locator hero" style="padding: 56px 24px 48px;">
<div style="max-width: 1200px; margin: 0px auto;">
<p style="font-size: 13px; color: rgb(134, 134, 139); margin: 0px 0px 32px;">Home › <span style="color: rgb(29, 29, 31);"><span class="sc-interp">Find a Rep</span></span></p>
<div style="display: inline-flex; background: rgb(245, 245, 247); border-radius: 980px; padding: 4px; margin-bottom: 36px;">
<button style="font-family: inherit; cursor: pointer; font-size: 14px; font-weight: 600; padding: 9px 20px; border-radius: 980px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; transition: 0.2s; background: rgb(255, 255, 255); color: rgb(243, 39, 64); box-shadow: rgba(0, 0, 0, 0.08) 0px 1px 4px;">Find a Rep</button>
<button style="font-family: inherit; cursor: pointer; font-size: 14px; font-weight: 600; padding: 9px 20px; border-radius: 980px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; transition: 0.2s; background: none; color: rgb(110, 110, 115);">Find a Distributor</button>
</div>
<p style="font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(134, 134, 139); margin: 0px 0px 16px;"><span class="sc-interp">Local Support</span></p>
<h1 style="font-size: clamp(44px, 6vw, 72px); font-weight: 600; letter-spacing: -0.03em; line-height: 1.05; margin: 0px 0px 20px;"><span class="sc-interp">Find a Sales Rep</span></h1>
<p style="font-size: clamp(19px, 2.2vw, 24px); color: rgb(110, 110, 115); line-height: 1.45; margin: 0px; max-width: 740px;"><span class="sc-interp">Your local ALG sales rep handles specification support, pricing, project tracking, and submittal assistance. Search by ZIP, city, or state to find the rep covering your area.</span></p>
</div></section><section data-screen-label="Map and locator" style="padding: 24px 24px 96px;">
<div style="max-width: 1200px; margin: 0px auto; display: grid; grid-template-columns: 320px 1fr; gap: 24px; align-items: start;">
<div style="display: grid; gap: 20px;">
<div style="background: rgb(245, 245, 247); border-radius: 16px; padding: 24px;">
<label style="display: block; font-size: 13px; font-weight: 500; color: rgb(110, 110, 115); margin-bottom: 8px;">Search by ZIP, city, or state</label>
<input class="scp0" placeholder="e.g. 91763 or Riverside" style="width: 100%; box-sizing: border-box; font-size: 17px; padding: 12px 14px; border: 1px solid rgb(210, 210, 215); border-radius: 12px; outline: none; color: rgb(29, 29, 31); background: rgb(255, 255, 255);" value=""/>
<button class="scp1" style="width: 100%; margin-top: 12px; background: rgb(243, 39, 64); color: rgb(255, 255, 255); border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; cursor: pointer; padding: 12px; border-radius: 980px; font-size: 15px; font-weight: 600; font-family: inherit; transition: background 0.2s;">Find Nearest</button>
<div style="margin-top: 20px;">
<p style="font-size: 11.5px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: rgb(134, 134, 139); margin: 0px 0px 10px;">Show</p>
<div style="display: flex; gap: 8px; flex-wrap: wrap;">
<button style="font-family: inherit; cursor: pointer; font-size: 13px; font-weight: 600; padding: 7px 14px; border-radius: 980px; transition: 0.2s; border: 1px solid rgb(243, 39, 64); color: rgb(243, 39, 64); background: rgb(255, 255, 255);">All</button>
<button style="font-family: inherit; cursor: pointer; font-size: 13px; font-weight: 600; padding: 7px 14px; border-radius: 980px; transition: 0.2s; border: 1px solid rgb(210, 210, 215); color: rgb(110, 110, 115); background: rgb(255, 255, 255);">Sales Reps</button>
<button style="font-family: inherit; cursor: pointer; font-size: 13px; font-weight: 600; padding: 7px 14px; border-radius: 980px; transition: 0.2s; border: 1px solid rgb(210, 210, 215); color: rgb(110, 110, 115); background: rgb(255, 255, 255);">Distributors</button>
<button style="font-family: inherit; cursor: pointer; font-size: 13px; font-weight: 600; padding: 7px 14px; border-radius: 980px; transition: 0.2s; border: 1px solid rgb(210, 210, 215); color: rgb(110, 110, 115); background: rgb(255, 255, 255);">Warehouses</button>
</div>
</div>
</div>
<div style="border: 1px solid rgb(229, 229, 231); border-radius: 16px; padding: 24px;">
<p style="font-size: 11.5px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: rgb(134, 134, 139); margin: 0px 0px 14px;">Map key</p>
<div style="display: flex; justify-content: space-between; gap: 12px; padding: 10px 0px; border-top: 1px solid rgb(229, 229, 231); font-size: 14px;"><span style="display: flex; align-items: center; gap: 8px; font-weight: 600;"><span style="width: 10px; height: 10px; border-radius: 50%; background: rgb(29, 29, 31); display: inline-block; flex: 0 0 auto;"></span><span class="sc-interp">Sales Rep</span></span><span style="color: rgb(110, 110, 115); white-space: nowrap;"><span class="sc-interp">28 active reps</span></span></div>
<div style="display: flex; justify-content: space-between; gap: 12px; padding: 10px 0px; border-top: 1px solid rgb(229, 229, 231); font-size: 14px;"><span style="display: flex; align-items: center; gap: 8px; font-weight: 600;"><span style="width: 10px; height: 10px; border-radius: 50%; border: 2px solid rgb(29, 29, 31); background: rgb(255, 255, 255); display: inline-block; flex: 0 0 auto; box-sizing: border-box;"></span><span class="sc-interp">Stocking Distributor</span></span><span style="color: rgb(110, 110, 115); white-space: nowrap;"><span class="sc-interp">29 locations</span></span></div>
<div style="display: flex; justify-content: space-between; gap: 12px; padding: 10px 0px; border-top: 1px solid rgb(229, 229, 231); font-size: 14px;"><span style="display: flex; align-items: center; gap: 8px; font-weight: 600;"><span style="width: 10px; height: 10px; background: rgb(134, 134, 139); display: inline-block; flex: 0 0 auto;"></span><span class="sc-interp">ALG Warehouse</span></span><span style="color: rgb(110, 110, 115); white-space: nowrap;"><span class="sc-interp">12 locations</span></span></div>
</div>
<div style="display: grid; gap: 10px;">
<a class="scp2" href="#distributor" style="display: block; text-align: center; border: 1px solid rgb(210, 210, 215); border-radius: 980px; padding: 11px 16px; font-size: 14px; font-weight: 600; color: rgb(29, 29, 31);"><span class="sc-interp">Find a Distributor →</span></a>
<a class="scp2" href="/distributor/" style="display: block; text-align: center; border: 1px solid rgb(210, 210, 215); border-radius: 980px; padding: 11px 16px; font-size: 14px; font-weight: 600; color: rgb(29, 29, 31);"><span class="sc-interp">Become a Distributor →</span></a>
<a class="scp2" href="mailto:sales@archipelagolighting.com?subject=Sales rep application" style="display: block; text-align: center; border: 1px solid rgb(210, 210, 215); border-radius: 980px; padding: 11px 16px; font-size: 14px; font-weight: 600; color: rgb(29, 29, 31);"><span class="sc-interp">Apply as Sales Rep →</span></a>
</div>
</div>
<div style="display: grid; gap: 24px;">
<div style="height: 320px;"><image-slot id="locator-map" placeholder="Drop US map — shared interactive map component (homepage + Contact) · binds to local_support.json" radius="16" shape="rounded" style="width: 100%; height: 100%;"></image-slot></div>
<div>
<div style="display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: 16px;">
<p style="font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(134, 134, 139); margin: 0px;">In this view &middot; <span id="results-count">loading&hellip;</span></p>
<div style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: rgb(110, 110, 115);">Sort:
<button id="sort-nearest" onclick="window._algSort('nearest')" style="font-family: inherit; cursor: pointer; font-size: 13px; font-weight: 600; padding: 5px 10px; border-radius: 8px; border: none; background: none; transition: color 0.2s; color: rgb(243, 39, 64);">Nearest</button>
<button id="sort-az" onclick="window._algSort('az')" style="font-family: inherit; cursor: pointer; font-size: 13px; font-weight: 600; padding: 5px 10px; border-radius: 8px; border: none; background: none; transition: color 0.2s; color: rgb(110, 110, 115);">A&ndash;Z</button>
<button id="sort-type" onclick="window._algSort('type')" style="font-family: inherit; cursor: pointer; font-size: 13px; font-weight: 600; padding: 5px 10px; border-radius: 8px; border: none; background: none; transition: color 0.2s; color: rgb(110, 110, 115);">Type</button>
</div>
</div>
<div id="alg-results-grid" style="display: grid; gap: 12px;">
<!-- Results injected by _algLocator — bound to /data/local_support.json -->
</div>
<div id="alg-no-results" style="display:none; text-align:center; padding:48px 0; color:rgb(110,110,115);">
  <p style="font-size:18px;font-weight:600;margin:0 0 8px;">No results found</p>
  <p style="font-size:14px;margin:0;">Try a different ZIP or city — or <a href="mailto:sales@archipelagolighting.com?subject=Rep inquiry" style="color:#F32740;">email the sales team</a>.</p>
</div>
</div>
</div></section><section data-screen-label="Direct contact closer" style="padding: 96px 24px; background: rgb(245, 245, 247); text-align: center;">
<div style="max-width: 720px; margin: 0px auto;">
<p style="font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(134, 134, 139); margin: 0px 0px 14px;"><span class="sc-interp">Direct contact</span></p>
<h2 style="font-size: clamp(38px, 4vw, 52px); font-weight: 600; letter-spacing: -0.02em; line-height: 1.08; margin: 0px 0px 12px;"><span class="sc-interp">Can't find a rep in your area?</span></h2>
<p style="font-size: clamp(19px, 2.2vw, 22px); color: rgb(110, 110, 115); line-height: 1.45; margin: 0px 0px 32px;"><span class="sc-interp">Our inside sales team covers all territories directly. Reach out and we'll connect you with the right contact.</span></p>
<a class="scp3" href="mailto:sales@archipelagolighting.com?subject=Rep inquiry" style="display: inline-block; background: rgb(243, 39, 64); color: rgb(255, 255, 255); padding: 13px 28px; border-radius: 980px; font-size: 16px; font-weight: 600; transition: background 0.2s;"><span class="sc-interp">Email Sales Team</span></a>
</div></section><div>
<section style="background: rgb(255, 255, 255); border-top: 1px solid rgb(229, 229, 231); padding: 88px 24px; text-align: center;">
<h3 style="font-size: clamp(24px, 2.4vw, 32px); font-weight: 600; letter-spacing: -0.02em; color: rgb(29, 29, 31); margin: 0px 0px 8px;">Need a quote, layout, sample, or rebate check?</h3>
<p style="font-size: clamp(19px, 2.2vw, 22px); color: rgb(110, 110, 115); margin: 0px 0px 28px; line-height: 1.4;">We respond the same business day.</p>
<div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
<a class="scp3" href="/contact/" style="background: rgb(243, 39, 64); color: rgb(255, 255, 255); padding: 12px 26px; border-radius: 980px; font-size: 15px; font-weight: 600; letter-spacing: 0.02em; transition: background 0.2s;">GET A QUOTE</a>
<a href="/contact/" style="color: rgb(29, 29, 31); border: 1px solid rgb(210, 210, 215); padding: 12px 26px; border-radius: 980px; font-size: 15px; font-weight: 600; letter-spacing: 0.02em;">REQUEST A PHOTOMETRIC</a>
</div>
</section>
</div></main>

  <script is:inline>
(function(){
  var orb=null, raf=null, EASE=0.03;
  var tx=innerWidth*0.72, ty=innerHeight*0.26, x=tx, y=ty;
  var fine=matchMedia('(pointer:fine)').matches,
      still=matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(!fine||still){
    addEventListener('scroll',function(){ ty=innerHeight*0.26+scrollY*0.06; },{passive:true});
  } else {
    addEventListener('pointermove',function(e){ tx=e.clientX; ty=e.clientY; },{passive:true});
  }
  function tick(){
    if(!orb) orb=document.querySelector('.glow-orb');
    if(orb){ x+=(tx-x)*EASE; y+=(ty-y)*EASE;
      orb.style.transform='translate('+x+'px,'+y+'px) translate(-50%,-50%)'; }
    raf=requestAnimationFrame(tick);
  }
  document.addEventListener('visibilitychange',function(){
    if(document.hidden){ if(raf){ cancelAnimationFrame(raf); raf=null; } }
    else if(!raf){ raf=requestAnimationFrame(tick); }
  });
  raf=requestAnimationFrame(tick);
})();
  </script>

  <script is:inline>
  // ALG Locator — binds to /data/local_support.json
  (function(){
    var CARD_STYLE = 'border:1px solid rgb(229,229,231);border-radius:16px;padding:20px 24px;display:grid;grid-template-columns:1fr auto;gap:16px;align-items:center;';
    var BADGE_STYLE = 'display:inline-block;font-size:10.5px;font-weight:600;letter-spacing:0.07em;text-transform:uppercase;color:rgb(110,110,115);border:1px solid rgb(210,210,215);border-radius:8px;padding:3px 8px;margin-bottom:8px;';
    var NAME_STYLE = 'font-size:17px;font-weight:600;';
    var META_STYLE = 'font-size:13.5px;color:rgb(110,110,115);margin-top:2px;';
    var BTN_STYLE = 'flex:0 0 auto;font-size:14px;font-weight:600;border:1px solid rgb(210,210,215);border-radius:980px;padding:9px 18px;white-space:nowrap;text-decoration:none;color:inherit;';

    var allEntries = [];
    var currentSort = 'az';

    function typeLabel(t){
      if(t==='rep') return 'Sales Rep';
      if(t==='distributor') return 'Stocking Distributor';
      if(t==='warehouse') return 'ALG Warehouse';
      return t;
    }

    function makeCard(e){
      var name = e.name || '';
      var city = e.city || '';
      var state = e.state || '';
      var phone = e.phone || '';
      var email = e.email || '';
      var type = e.type || '';
      var mapUrl = (city && state) ? 'https://maps.google.com/?q='+encodeURIComponent(name+' '+city+' '+state) : '';

      var meta1 = [city, state].filter(Boolean).join(', ');
      if(e.coverage) meta1 += ' \u00b7 ' + e.coverage;
      var meta2parts = [];
      if(phone) meta2parts.push(phone);
      if(email) meta2parts.push('<a href="mailto:'+email+'?subject=Inquiry" style="color:inherit;">'+email+'</a>');
      var meta2 = meta2parts.join(' \u00b7 ');

      var btnHtml;
      if(type==='rep'){
        var repEmail = email || 'sales@archipelagolighting.com';
        btnHtml = '<a href="mailto:'+repEmail+'?subject=Rep inquiry" style="'+BTN_STYLE+'">Contact rep</a>';
      } else if(type==='warehouse'){
        btnHtml = '<a href="mailto:sales@archipelagolighting.com?subject=Warehouse order" style="'+BTN_STYLE+'">Ship direct</a>';
      } else {
        btnHtml = mapUrl ? '<a href="'+mapUrl+'" target="_blank" rel="noopener" style="'+BTN_STYLE+'">Get directions</a>' : '';
      }

      return '<div style="'+CARD_STYLE+'"><div>'
        +'<span style="'+BADGE_STYLE+'">'+typeLabel(type)+'</span>'
        +'<div style="'+NAME_STYLE+'">'+name+'</div>'
        +(meta1?'<div style="'+META_STYLE+'">'+meta1+'</div>':'')
        +(meta2?'<div style="'+META_STYLE+'">'+meta2+'</div>':'')
        +'</div>'+btnHtml+'</div>';
    }

    function sortEntries(arr, mode){
      var order = {rep:0, distributor:1, warehouse:2};
      if(mode==='type'){
        return arr.slice().sort(function(a,b){ return (order[a.type]||9)-(order[b.type]||9) || a.name.localeCompare(b.name); });
      }
      return arr.slice().sort(function(a,b){ return a.name.localeCompare(b.name); });
    }

    function render(entries){
      var grid = document.getElementById('alg-results-grid');
      var noRes = document.getElementById('alg-no-results');
      var count = document.getElementById('results-count');
      if(!grid) return;
      var sorted = sortEntries(entries, currentSort);
      if(sorted.length===0){
        grid.innerHTML='';
        if(noRes) noRes.style.display='';
        if(count) count.textContent='0 results';
        return;
      }
      if(noRes) noRes.style.display='none';
      if(count) count.textContent=sorted.length+' result'+(sorted.length!==1?'s':'');
      grid.innerHTML = sorted.map(makeCard).join('');
    }

    function filterByZip(zip){
      // Simple state-based filter using ZIP prefix ranges
      // Full geo-search requires a server; this is a best-effort client-side filter
      var stateMap = {
        '0':['CT','MA','ME','NH','NJ','NY','PR','RI','VT'],
        '1':['DE','MD','NY','PA'],
        '2':['DC','MD','NC','SC','VA','WV'],
        '3':['AL','FL','GA','MS','TN'],
        '4':['IN','KY','MI','OH'],
        '5':['IA','MN','MT','ND','SD','WI'],
        '6':['IL','KS','MO','NE'],
        '7':['AR','LA','OK','TX'],
        '8':['AZ','CO','ID','NM','NV','UT','WY'],
        '9':['AK','CA','HI','OR','WA']
      };
      var prefix = zip.charAt(0);
      var states = stateMap[prefix] || [];
      var filtered = allEntries.filter(function(e){
        return !states.length || states.indexOf(e.state) !== -1 || e.type==='warehouse';
      });
      render(filtered);
    }

    window._algSort = function(mode){
      currentSort = mode;
      ['nearest','az','type'].forEach(function(m){
        var btn = document.getElementById('sort-'+m);
        if(btn) btn.style.color = m===mode ? 'rgb(243,39,64)' : 'rgb(110,110,115)';
      });
      render(allEntries);
    };

    // Wire ZIP search
    document.addEventListener('DOMContentLoaded', function(){
      var form = document.querySelector('form[data-locator-form], .locator-search-form');
      var input = document.querySelector('input[data-zip], input[placeholder*="ZIP"], input[placeholder*="zip"]');
      if(form && input){
        form.addEventListener('submit', function(ev){
          ev.preventDefault();
          var z = input.value.trim();
          if(z) filterByZip(z); else render(allEntries);
        });
      }
    });

    // Load real data
    fetch('/data/local_support.json')
      .then(function(r){ return r.json(); })
      .then(function(data){
        // Flatten reps, distributors, warehouses — exclude hidden:true
        var entries = [];
        (data.reps||[]).forEach(function(e){ if(!e.hidden) entries.push(Object.assign({},e,{type:'rep'})); });
        (data.distributors||[]).forEach(function(e){ if(!e.hidden) entries.push(Object.assign({},e,{type:'distributor'})); });
        (data.warehouses||[]).forEach(function(e){ if(!e.hidden) entries.push(Object.assign({},e,{type:'warehouse'})); });
        allEntries = entries;
        render(allEntries);
      })
      .catch(function(){
        var count = document.getElementById('results-count');
        if(count) count.textContent='unable to load — email sales@archipelagolighting.com';
      });
  })();
  </script>
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const title = "constⒶNT · Exit & Emergency · Archipelago Lighting";
const description = "Thermoplastic, edge-lit, and combo exit signs plus dual-head emergency lights. UL 924 listed, NFPA 101 compliant, configurable across 33 SKUs.";
---

<BaseLayout title={title} description={description}>

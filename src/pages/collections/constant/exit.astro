pl-combo  { background: #fff; color: var(--brand); border: 1px solid var(--brand); padding: 3px 7px; }\n\n.cmp-grid .ax-cell.sku-header.empty {\n  background: var(--c1);\n  display: flex; align-items: center; justify-content: center;\n  font-family: var(--font-mono);\n  font-size: 11.5px; letter-spacing: .08em; color: var(--ink3);\n  min-height: 158px;\n}\n.cmp-grid .ax-cell.sku-header.empty .placeholder { letter-spacing: .08em; }\n\n.cmp-grid .ax-cell.val.empty { background: var(--c1); color: var(--ink3); text-align: center; font-weight: 600; }\n.cmp-grid .ax-cell.val.diverge { color: var(--brand); font-weight: 600; }\n\n.cmp-grid .ax-cell .link-pill {\n  display: inline-block; font-size: 9.5px; letter-spacing: .1em; padding: 3px 7px;\n  background: var(--grn); color: #fff; font-weight: 700; text-transform: uppercase;\n}\n\n.cmp-modal-foot {\n  padding: 12px 28px;\n  display: flex; align-items: center; justify-content: space-between; gap: 18px;\n  border-top: 1px solid var(--c3);\n  background: var(--c1);\n  font-family: var(--font-mono);\n  font-size: 10.5px; letter-spacing: .04em; color: var(--ink3);\n}\n.cmp-modal-foot kbd {\n  font-family: var(--font-mono);\n  font-size: 9.5px;\n  padding: 1px 6px;\n  background: #fff;\n  border: 1px solid var(--c3);\n  border-radius: 2px;\n  color: var(--ink);\n  letter-spacing: 0;\n}\n\n\n/* ===== Decoder ===== */\n.decoder-shell { background: var(--ink); color: #fff; padding: 28px 32px; }\n.decoder-shell .row {\n  display: flex; align-items: stretch; gap: 0; font-family: var(--font-mono);\n}\n.decoder-shell .seg {\n  padding: 16px 14px;\n  display: flex; flex-direction: column; justify-content: center;\n  border-left: 1px solid rgba(255,255,255,.08);\n  cursor: pointer;\n  transition: background .15s ease;\n}\n.decoder-shell .seg:first-child { border-left: 0; }\n.decoder-shell .seg .glyph {\n  font-size: 26px; font-weight: 600; color: #fff; letter-spacing: .02em;\n}\n.decoder-shell .seg .nm {\n  font-family: var(--font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--yellow);\n  margin-top: 6px;\n}\n.decoder-shell .seg.sep .glyph { color: var(--brand); }\n.decoder-shell .seg.hover, .decoder-shell .seg:hover {\n  background: rgba(255,255,255,.06);\n}\n.decoder-shell .seg.active {\n  background: rgba(253,216,94,.12);\n}\n.decoder-shell .detail {\n  margin-top: 18px;\n  display: grid; grid-template-columns: 180px 1fr; gap: 24px;\n  padding-top: 18px; border-top: 1px solid rgba(255,255,255,.1);\n}\n.decoder-shell .detail .k { font-family: var(--font-mono); font-size: 11px; color: var(--yellow); letter-spacing: .12em; text-transform: uppercase; font-weight: 700; }\n.decoder-shell .detail .v { font-size: 13.5px; color: #E5E5E5; line-height: 1.6; }\n.decoder-shell .detail .opts { margin-top: 10px; display: flex; flex-wrap: wrap; gap: 6px; }\n.decoder-shell .detail .opts span { font-family: var(--font-mono); font-size: 10.5px; padding: 4px 8px; background: rgba(255,255,255,.08); color: #E5E5E5; letter-spacing: .04em; }\n\n/* ===== Compliance grid ===== */\n.comp-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }\n.comp-card {\n  border: 1px solid var(--c3); padding: 14px 16px; background: #fff;\n  border-left: 3px solid var(--brand);\n}\n.comp-card .top {\n  display: flex; align-items: baseline; justify-content: space-between; gap: 10px;\n  border-bottom: 1px dashed var(--c2); padding-bottom: 6px; margin-bottom: 8px;\n}\n.comp-card .code {\n  font-family: var(--font-mono); font-weight: 600; font-size: 12.5px; color: var(--ink);\n  letter-spacing: .04em;\n}\n.comp-card .status {\n  font-family: var(--font-mono); font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase;\n  color: #fff; background: var(--grn); padding: 2px 7px; font-weight: 700; border-radius: 2px;\n}\n.comp-card .name {\n  font-size: 13px; font-weight: 600; color: var(--ink); margin-top: 2px;\n}\n.comp-card .detail {\n  font-size: 12px; color: var(--ink2); line-height: 1.55; margin-top: 6px;\n}\n\n/* ===== Battery & testing ===== */\n.bt-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--gap); }\n.bt-grid .left h4, .bt-grid .right h4 {\n  font-family: var(--font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink3);\n  margin-bottom: 10px;\n}\n.runtime-bar {\n  margin: 18px 0; padding: 14px 16px; background: var(--c1); position: relative;\n}\n.runtime-bar .ruler {\n  height: 30px; background: #fff; border: 1px solid var(--c3); position: relative; overflow: hidden;\n}\n.runtime-bar .ruler .fill {\n  position: absolute; top: 0; bottom: 0; left: 0; background: linear-gradient(90deg, var(--brand), var(--brand-dark));\n  width: 90%; display: flex; align-items: center; justify-content: flex-end; padding-right: 10px;\n  font-family: var(--font-mono); font-size: 10.5px; color: #fff; font-weight: 700; letter-spacing: .04em;\n}\n.runtime-bar .ticks { display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 10px; color: var(--ink3); margin-top: 6px; letter-spacing: .04em; }\n.runtime-bar .legend {\n  margin-top: 10px; font-family: var(--font-mono); font-size: 11px; color: var(--ink2); line-height: 1.6;\n}\n.runtime-bar .legend b { color: var(--ink); }\n\n.test-seq { display: grid; gap: 6px; margin-top: 12px; }\n.test-seq .step {\n  display: grid; grid-template-columns: 36px 1fr auto; gap: 12px; align-items: center;\n  padding: 10px 12px; border: 1px solid var(--c3);\n}\n.test-seq .step .n {\n  font-family: var(--font-mono); font-weight: 700; font-size: 18px; color: var(--brand);\n}\n.test-seq .step .b { font-size: 12.5px; color: var(--ink2); line-height: 1.45; }\n.test-seq .step .b b { color: var(--ink); }\n.test-seq .step .when {\n  font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink3);\n}\n\n/* ===== Mounting grid ===== */\n.mnt-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }\n.mnt-card { border: 1px solid var(--c3); padding: 14px; background: #fff; display: flex; flex-direction: column; gap: 8px; }\n.mnt-card .svg {\n  background: var(--c1); height: 100px; display: flex; align-items: center; justify-content: center; padding: 12px;\n}\n.mnt-card .nm { font-size: 13px; font-weight: 600; color: var(--ink); }\n.mnt-card .nt { font-size: 12px; color: var(--ink2); line-height: 1.5; font-family: var(--font-mono); }\n\n/* ===== constⒶNTLink subtle panel ===== */\n.link-strip {\n  display: grid; grid-template-columns: 1fr .9fr; gap: var(--gap); align-items: stretch;\n}\n.link-strip .copy { padding: 4px 0; }\n.link-strip .copy .kicker {\n  font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--grn); font-weight: 700;\n}\n.link-strip .copy h3 { font-size: 22px; font-weight: 700; letter-spacing: -.005em; margin: 6px 0 10px; }\n.link-strip .copy h3 .glyph { color: var(--brand); }\n.link-strip .copy p { font-size: 13.5px; color: var(--ink2); line-height: 1.6; max-width: 460px; }\n.link-strip .copy ul { list-style: none; padding: 0; margin: 14px 0 0; display: flex; flex-direction: column; gap: 6px; }\n.link-strip .copy ul li {\n  font-family: var(--font-mono); font-size: 11.5px; color: var(--ink2); padding: 4px 0;\n  border-bottom: 1px dashed var(--c2);\n}\n.link-strip .copy ul li::before {\n  content: ''; display: inline-block; width: 6px; height: 6px; background: var(--grn);\n  margin-right: 10px; vertical-align: 2px; border-radius: 50%;\n}\n\n.link-strip .preview {\n  background: var(--ink); color: #fff; padding: 18px 20px; font-family: var(--font-mono);\n}\n.link-strip .preview .ph {\n  display: flex; align-items: center; justify-content: space-between;\n  padding-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,.1); margin-bottom: 12px;\n}\n.link-strip .preview .ph .t { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--yellow); font-weight: 700; }\n.link-strip .preview .ph .now { font-size: 10.5px; color: #999; }\n.link-strip .preview .row {\n  display: grid; grid-template-columns: 1fr auto auto; gap: 12px; padding: 6px 0;\n  border-bottom: 1px dashed rgba(255,255,255,.08); font-size: 11.5px;\n}\n.link-strip .preview .row .pn { color: #fff; }\n.link-strip .preview .row .st { letter-spacing: .08em; }\n.link-strip .preview .row .st.ok { color: var(--grn); }\n.link-strip .preview .row .st.warn { color: var(--yellow); }\n.link-strip .preview .row .ts { color: #777; font-size: 10.5px; }\n\n/* ===== Applications matrix ===== */\n.app-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }\n.app-card { border: 1px solid var(--c3); border-top: 3px solid var(--brand); padding: 14px 16px; background: #fff; }\n.app-card .nm { font-size: 14px; font-weight: 700; color: var(--ink); }\n.app-card .skus { font-family: var(--font-mono); font-size: 11px; color: var(--brand); margin: 6px 0 8px; letter-spacing: .04em; line-height: 1.55; }\n.app-card .nt { font-size: 12px; color: var(--ink2); line-height: 1.5; }\n\n/* ===== Accessories ===== */\n.acc-list { display: flex; flex-direction: column; gap: 0; border: 1px solid var(--c3); }\n.acc-row {\n  display: grid; grid-template-columns: 200px 1fr auto; gap: 18px; align-items: center;\n  padding: 11px 16px; border-bottom: 1px solid var(--c2);\n}\n.acc-row:last-child { border-bottom: none; }\n.acc-row:hover { background: var(--c1); }\n.acc-row .sku { font-family: var(--font-mono); font-weight: 600; font-size: 12.5px; color: var(--ink); }\n.acc-row .nm { font-size: 13px; color: var(--ink); }\n.acc-row .nt { font-family: var(--font-mono); font-size: 11px; color: var(--ink3); line-height: 1.45; }\n.acc-row .add { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; padding: 5px 10px; border: 1px solid var(--c3); cursor: pointer; background: #fff; }\n.acc-row .add:hover { background: var(--ink); color: #f
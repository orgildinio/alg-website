.us, .cmp-table td.us { background: rgba(227,53,60,.06); }\n.cmp-table th.us { background: var(--brand); color: #fff; border-bottom-color: var(--brand); }\n.cmp-table td.us { color: var(--ink); font-weight: 600; }\n.cmp-table td.axis { color: var(--ink); font-weight: 700; font-size: 12px; letter-spacing: .04em; }\n\n/* ===== Downloads ===== */\n.dl-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px; }\n.dl-row {\n  display: grid; grid-template-columns: 90px 1fr auto auto; gap: 14px; align-items: center;\n  padding: 9px 12px; border: 1px solid var(--c3); background: #fff;\n}\n.dl-row:hover { background: var(--c1); }\n.dl-row .kind { font-family: var(--font-mono); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--brand); font-weight: 700; }\n.dl-row .file { font-family: var(--font-mono); font-size: 11.5px; color: var(--ink); }\n.dl-row .ext { font-family: var(--font-mono); font-size: 10.5px; color: var(--ink3); letter-spacing: .08em; }\n.dl-row .size { font-family: var(--font-mono); font-size: 10.5px; color: var(--ink3); letter-spacing: .08em; min-width: 50px; text-align: right; }\n.dl-row:hover .ext { color: var(--ink); }\n\n/* ===== Order block ===== */\n.order-block { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--gap); }\n.order-block .left { padding: 22px 26px; background: var(--ink); color: #fff; }\n.order-block .left .k { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--yellow); font-weight: 700; }\n.order-block .left h3 { font-size: 28px; font-weight: 800; letter-spacing: -.01em; margin: 8px 0 14px; line-height: 1.1; }\n.order-block .left p { font-size: 13.5px; line-height: 1.6; color: #E5E5E5; max-width: 460px; }\n.order-block .left .contact {\n  margin-top: 18px; font-family: var(--font-mono); font-size: 11.5px; line-height: 1.75; color: #E5E5E5;\n}\n.order-block .left .contact b { color: #fff; }\n.order-block .right { display: flex; flex-direction: column; gap: 10px; }\n.order-block .right .act {\n  padding: 16px 18px; background: var(--c1); border-left: 3px solid var(--brand);\n  display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: center;\n}\n.order-block .right .act .nm { font-size: 14px; font-weight: 600; color: var(--ink); }\n.order-block .right .act .sub { font-family: var(--font-mono); font-size: 11px; color: var(--ink2); margin-top: 3px; letter-spacing: .04em; }\n.order-block .right .act button {\n  font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; font-weight: 600;\n  padding: 9px 14px; background: var(--ink); color: #fff; border: 0; cursor: pointer;\n}\n.order-block .right .act button:hover { background: var(--brand); }\n\n/* ===== Footer ===== */\nfooter.ftr {\n  margin-top: 64px; padding: 28px 32px; border-top: 1px solid var(--c3); background: var(--c1);\n  display: flex; align-items: center; justify-content: space-between; gap: 18px; flex-wrap: wrap;\n  font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink3);\n}\nfooter.ftr .left { display: flex; align-items: center; gap: 12px; }\nfooter.ftr img { height: 22px; }\nfooter.ftr a:hover { color: var(--brand); }\n<\u002Fstyle>\n  <script src=\"1acecf98-1868-4c38-bfe8-d01b62fa84a5\" integrity=\"sha384-hD6/rw4ppMLGNu3tX5cjIb+uRZ7UkRJ6BPkLpg4hAu/6onKUg4lLsHAs9EBPT82L\" crossorigin=\"anonymous\"><\u002Fscript>\n  <script src=\"1aa57487-9633-4bd3-82a3-26e98fc777e8\" integrity=\"sha384-u6aeetuaXnQ38mYT8rp6sbXaQe3NL9t+IBXmnYxwkUI2Hw4bsp2Wvmx4yRQF1uAm\" crossorigin=\"anonymous\"><\u002Fscript>\n  <script src=\"edb457d7-72b3-4ab3-8a1c-fc980a08b084\" integrity=\"sha384-m08KidiNqLdpJqLq95G/LEi8Qvjl/xUYll3QILypMoQ65QorJ9Lvtp2RXYGBFj1y\" crossorigin=\"anonymous\"><\u002Fscript>\n<\u002Fhead>\n<body>\n  \n  <div id=\"root\"><\u002Fdiv>\n  <script src=\"66d929a4-c64d-4167-8b38-0c4923635060\"><\u002Fscript>\n  <script type=\
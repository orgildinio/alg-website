-table.compact th.col-fp      { width: 8%; }\n.sku-table.compact th.col-volt    { width: 8%; }\n.sku-table.compact th.col-batt    { width: 11%; }\n.sku-table.compact th.col-rating  { width: 7%; }\n.sku-table.compact th.col-attr    { width: 9.6%; padding: 8px 4px; text-align: center; }\n.sku-table.compact td.attr        { text-align: center; padding: 6px 4px; }\n.sku-table.compact td.compare     { padding: 6px 4px; }\n.sku-table.compact td.hous        { font-size: 11px; }\n.sku-table tr { cursor: pointer; }\n.sku-table tr:hover td { background: rgba(227,53,60,.04); }\n.sku-table tr.sel td { background: rgba(227,53,60,.08); }\n.sku-table tr.cap { cursor: not-allowed; opacity: .55; }\n.sku-table tr.cap:hover td { background: transparent; }\n.sku-table td.model { font-weight: 600; color: var(--ink); font-size: 12.5px; }\n.sku-table td.compare { text-align: center; }\n.sku-table td.compare input { accent-color: var(--brand); width: 14px; height: 14px; cursor: pointer; }\n.sku-table td.compare input:disabled { cursor: not-allowed; }\n.sku-table td .swatch {\n  display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 5px; vertical-align: 0; border: 1px solid var(--c3);\n}\n.sku-table td .dim { color: var(--ink3); font-weight: 500; }\n\n/* Attribute pills (/CL, /XD, /AG) */\n.attr-pill {\n  display: inline-block;\n  font-family: var(--font-mono);\n  font-size: 9.5px;\n  letter-spacing: .04em;\n  padding: 2px 6px;\n  font-weight: 700;\n  border-radius: 2px;\n  line-height: 1.3;\n}\n.attr-pill.cl { background: var(--grn);    color: #fff; }\n.attr-pill.xd { background: var(--yellow); color: var(--ink); }\n.attr-pill.ag { background: var(--ink);    color: #fff; }\n\n/* legacy alias */\n.sku-table td .link-badge { display: inline-block; font-size: 9.5px; letter-spacing: .04em; padding: 2px 6px; background: var(--grn); color: #fff; font-weight: 700; border-radius: 2px; }\n\n/* ===== Compare bar (sticky) ===== */\n.compare-bar {\n  position: sticky;\n  bot
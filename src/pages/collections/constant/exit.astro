n  /* ---------- Neutrals (surfaces) ---------- */\n  --c1:    #F5F4F1;         /* warm off-white panel fill */\n  --c2:    #EEEDF0;         /* mid neutral divider / accent block */\n  --c3:    #DCDEE2;         /* 1px borders */\n  --white: #FFFFFF;         /* background is always white */\n\n  /* ---------- Lifecycle (THE three, no others) ---------- */\n  --grn:    #0FAE7C;        /* ACTIVE  — current production */\n  --yellow: #FDD85E;        /* GEN-2   — second-gen current production */\n  --grey:   #8A8F97;        /* LEGACY  — prior-gen, still sold */\n\n  /* ---------- Semantic aliases ---------- */\n  --fg1: var(--ink);\n  --fg2: var(--ink2);\n  --fg3: var(--ink3);\n  --bg:  var(--white);\n  --surface-1: var(--c1);\n  --surface-2: var(--c2);\n  --border:    var(--c3);\n  --accent:       var(--brand);\n  --accent-dark:  var(--brand-dark);\n\n  /* ---------- Type families (NEVER SUBSTITUTE) ---------- */\n  --font-sans: 'Sora', system-ui, -apple-system, Segoe UI, Roboto, sans-serif;\n  --font-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Consolas, monospace;\n\n  /* ---------- Type weights ---------- */\n  --fw-light:    300;\n  --fw-regular:  400;\n  --fw-medium:   500;\n  --fw-semibold: 600;\n  --fw-bold:     700;\n  --fw-black:    800;\n\n  /* ---------- Type scale (print-tuned · never below 10px) ---------- */\n  --fs-wordmark:    64px;   /* cover hero wordmark */\n  --fs-sec-title:   36px;   /* section title */\n  --fs-vert:        38px;   /* vertical name */\n  --fs-stat-v:      26px;   /* stat value */\n  --fs-h4:          18px;   /* contact heading, tier label */\n  --fs-body:        14px;   /* body copy, sec-desc */\n  --fs-sku-model:   13.5px; /* SKU part number — the hero */\n  --fs-callout:     13px;\n  --fs-tree-body:   12.5px;\n  --fs-spec-body:   12.5px;\n  --fs-sku-specs:   12px;\n  --fs-meta:        12px;   /* section label, category bar */\n  --fs-sku-form:    10.5px;\n  --fs-stat-k:      10.5px;\n  --fs-badge:       10px;   /* absolute minimum */\n\n  /* ---------- Letter-spacing (typographic discipline) ---------- */\n  --tracking-tight: -.02em; /* wordmark */\n  --tracking-head:  -.01em; /* sec-title */\n  --tracking-meta:  .08em;  /* mono eyebrows */\n  --tracking-label: .14em;  /* category bar, cat-label */\n  --tracking-wide:  .18em;  /* mono section labels */\n\n  /* ---------- Layout / elevation ---------- */\n  --radius-chip:   2px;     /* badges & sku-form tags */\n  --radius-card:   0;       /* cards are hard-edged; border + 3px top accent */\n  --border-accent: 3px;     /* the signature left-bar / top-bar */\n  --shadow-slide:  0 8px 32px rgba(0, 0, 0, 0.12);  /* slide card on #DDD backdrop */\n\n  /* ---------- Print ---------- */\n  --page-w: 14.4in;\n  --page-h: 9.5in;\n}\n\n/* ============================================================\n   SEMANTIC ELEMENT STYLES\n   Apply directly via class names — mirrors the Product Guide.\n   ============================================================ */\n\nbody, .alg-body {\n  font-family: var(--font-sans);\n  color: var(--ink);\n  background: var(--white);\n}\n\n/* ---- Wordmark (cover hero) ---- */\n.alg-wordmark {\n  font-family: var(--font-sans);\n  font-size: var(--fs-wordmark);\n  font-weight: var(--fw-black);\n  letter-spacing: var(--tracking-tight);\n  line-height: 1;\n  color: var(--ink);\n  white-space: nowrap;\n}\n.alg-wordmark .accent,\n.alg-wordmark .a-enclosed { color: var(--brand); }\n\n/* ---- Section title ---- */\n.alg-sec-title {\n  font-family: var(--font-sans);\n  font-size: var(--fs-sec-title);\n  font-weight: var(--fw-black);\n  letter-spacing: var(--tracking-head);\n  line-height: 1.08;\n  color: var(--ink);\n}\n\n/* ---- Section description / body ---- */\n.alg-body-copy {\n  font-family: var(--font-sans);\n  font-size: var(--fs-body);\n  line-height: 1.55;\n  color: var(--ink2);\n}\n\n/* ---- Monospace meta (eyebrows, section labels) ---- */\n.alg-meta {\n  font-family: var(--font-mono);\n  font-size: var(--fs-meta);\n  letter-spacing: var(--tracking-wide);\n  text-transform: uppercase;\n  color: var(--ink3);\n}\n\n/* ---- SKU part number — the hero ---- */\n.alg-sku-model {\n  font-family: var(--font-mono);\n  font-size: var(--fs-sku-model);\n  font-weight: var(--fw-semibold);\n  color: var(--ink);\n  white-space: nowrap;\n}\n\n/* ---- SKU spec prose ---- */\n.alg-sku-specs {\n  font-family: var(--font-mono);\n  font-size: var(--fs-sku-specs);\n  color: var(--ink2);\n  white-space: nowrap;\n}\n\n/* ---- Form tag chip ---- */\n.alg-sku-form {\n  display: inline-block;\n  min-width: 44px;\n  text-align: center;\n  font-family: var(--font-mono);\n  font-size: var(--fs-sku-form);\n  font-weight: var(--fw-bold);\n  letter-spacing: .06em;\n  color: var(--ink);\n  padding: 2px 6px;\n  background: var(--c1);\n  border-radius: var(--radius-chip);\n}\n\n/* ---- Lifecycle badges ---- */\n.alg-badge {\n  display: inline-block;\n  font-family: var(--font-mono);\n  font-size: var(--fs-badge);\n  font-weight: var(--fw-bold);\n  letter-spacing: var(--tracking-meta);\n  padding: 2px 8px;\n  border-radius: var(--radius-chip);\n  text-transform: uppercase;\n  white-space: nowrap;\n}\n.alg-badge.active { background: var(--grn);    color: #fff; }\n.alg-badge.gen2   { background: var(--yellow); color: var(--ink); }\n.alg-badge.legacy { background: var(--grey);   color: #fff; }\n\n/* ---- Left-bar callout (signature pattern) ---- */\n.alg-callout {\n  padding: 12px 16px;\n  background: var(--c1);\n  border-left: var(--border-accent) solid var(--brand);\n}\n.alg-callout-label {\n  font-family: var(--font-mono);\n  font-size: var(--fs-badge);\n  font-weight: var(--fw-bold);\n  letter-spacing: .16em;\n  text-transform: uppercase;\n  color: var(--brand);\n}\n\n/* ---- Category bar — thick ink underline ---- */\n.alg-cat-bar {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  padding-bottom: 6px;\n  border-bottom: 2px solid var(--ink);\n}\n\n/* ---- Stat block ---- */\n.alg-stat {\n  padding: 14px 16px;\n  background: var(--c1);\n  border-left: var(--border-accent) solid var(--brand);\n}\n.alg-stat .v {\n  font-size: var(--fs-stat-v);\n  font-weight: var(--fw-bold);\n  line-height: 1.05;\n  white-space: nowrap;\n}\n.alg-stat .k {\n  font-family: var(--font-mono);\n  font-size: var(--fs-stat-k);\n  letter-spacing: .12em;\n  text-transform: uppercase;\n  color: var(--ink3);\n  margin-top: 6px;\n}\n<\u002Fstyle>\n  <style>/* ==========================================================\n   Direction A — \"Spec-Grade Workshop\"\n   constⒶNT family page · catalog-hub direction\n   ========================================================== */\n\n:root {\n  --rail-w: 240px;\n  --hd-h: 56px;\n  --max-w: 1340px;\n  --gap: 24px;\n}\n\n* { box-sizing: border-box; }\nhtml, body {\n  margin: 0; padding: 0;\n  font-family: var(--font-sans);\n  color: var(--ink);\n  background: #fff;\n  -webkit-font-smoothing: antialiased;\n}\n\na { color: inherit; text-decoration: none; }\nbutton { font-family: inherit; }\n\n/* ===== Top utility bar ===== */\n.utility {\n  height: 36px;\n  background: var(--ink);\n  color: #fff;\n  font-family: var(--font-mono);\n  font-size: 11px;\n  letter-spacing: .08em;\n  text-transform: uppercase;\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 0 32px;\n  white-space: nowrap;\n}\n.utility .left { display: flex; align-items: center; gap: 18px; }\n.utility .left .dot { display: inline-block; width: 6px; height: 6px; background: var(--grn); border-radius: 50%; }\n.utility .right { display: flex; align-items: center; gap: 18px; opacity: .85; }\n.utility .right a:hover { color: var(--yellow); }\n\n/* ===== Header ===== */\n.hdr {\n  height: var(--hd-h);\n  border-bottom: 1px solid var(--c3);\n  background: #fff;\n  position: sticky; top: 0; z-index: 50;\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 0 32px;\n}\n.hdr .brand { display: flex; align-items: center; gap: 18px; }\n.hdr .brand img { height: 28px; width: auto; }\n.hdr .brand .pipe { width: 1px; height: 22px; background: var(--c3); }\n.hdr .brand .fam {\n  font-family: var(--font-sans);\n  font-weight: 700;\n  font-size: 15px;\n  letter-spacing: -.005em;\n}\n.hdr .brand .fam .glyph { color: var(--brand); font-weight: 800; }\n.hdr nav.primary { display: flex; gap: 22px; align-items: center; font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink2); white-space: nowrap; }\n.hdr nav.primary a { padding: 4px 0; border-bottom: 2px solid transparent; }\n.hdr nav.primary a:hover { color: var(--ink); border-bottom-color: var(--brand); }\n.hdr nav.primary a.active { color: var(--ink); border-bottom-color: var(--ink); }\n.hdr .cta { display: flex; gap: 10px; align-items: center; }\n.hdr .cta .where {\n  font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink2); padding: 8px 14px; border: 1px solid var(--c3);\n  white-space: nowrap;\n}\n.hdr .cta .where:hover { background: var(--c1); }\n.hdr .cta .order {\n  font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase; color: #fff; background: var(--brand); padding: 8px 14px; font-weight: 600;\n  white-space: nowrap;\n}\n.hdr .cta .order:hover { background: var(--brand-dark); }\n\n/* ===== Breadcrumb strip ===== */\n.crumbs {\n  border-bottom: 1px solid var(--c3);\n  padding: 11px 32px;\n  font-family: var(--font-mono);\n  font-size: 11px;\n  letter-spacing: .12em;\n  text-transform: uppercase;\n  color: var(--ink3);\n  display: flex; align-items: center; justify-content: space-between;\n  white-space: nowrap;\n}\n.crumbs .path span + span::before { content: '/'; margin: 0 10px; color: var(--ink3); }\n.crumbs .path .here { color: var(--ink); }\n.crumbs .meta { display: flex; gap: 16px; }\n.crumbs .meta .k { color: var(--ink3); }\n.crumbs .meta .v { color: var(--ink); margin-left: 6px; }\n\n/* ===== Page layout ===== */\n.page {\n  display: grid;\n  grid-template-columns: var(--rail-w) 1fr;\n  max-width: var(--max-w);\n  margin: 0 auto;\n}\n\n/* ===== Sticky left rail ===== */\naside.rail {\n  position: sticky;\n  top: calc(var(--hd-h) + 1px);\n  align-self: start;\n  height: calc(100vh - var(--hd-h) - 1px);\n  overflow: hidden;\n  padding: 28px 24px 28px 32px;\n  border-right: 1px solid var(--c3);\n}\n.rail .rail-eyebrow {\n  font-family: var(--font-mono);\n  font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase;\n  color: var(--ink3); margin-bottom: 12px;\n}\n.rail nav { display: flex; flex-direction: column; gap: 1px; }\n.rail nav a {\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 7px 0;\n  font-family: var(--font-mono);\n  font-size: 11.5px;\n  letter-spacing: .04em;\n  color: var(--ink2);\n  border-bottom: 1px dashed var(--c2);\n}\n.rail nav a:hover { color: var(--brand); }\n.rail nav a.active { color: var(--ink); font-weight: 600; }\n.rail nav a.active::before {\n  content: ''; display: inline-block; width: 3px; height: 12px; background: var(--brand);\n  margin-right: 8px; margin-left: -12px;\n}\n.rail nav a .num { color: var(--ink3); font-size: 10.5px; letter-spacing: .12em; }\n\n.rail .helper {\n  margin-top: 22px; padding: 14px 14px; background: var(--c1); border-left: 3px solid var(--ink);\n  font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .04em; line-height: 1.6; color: var(--ink2);\n}\n.rail .helper b { color: var(--ink); font-weight: 700; }\n\n/* ===== Main content ===== */\nmain.content { padding: 28px 36px 64px; min-width: 0; }\nsection.s { padding: 24px 0 12px; scroll-margin-top: calc(var(--hd-h) + 12px); }\nsection.s + section.s { border-top: 1px solid var(--c3); margin-top: 8px; }\n\n.s-head { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; padding-bottom: 6px; border-bottom: 2px solid var(--ink); margin-bottom: 16px; }\n.s-head .l { display: flex; align-items: baseline; gap: 12px; }\n.s-head .n {\n  font-family: var(--font-mono);\n  font-size: 11px; letter-spacing: .14em; text-transform: uppercase;\n  color: var(--ink3);\n}\n.s-head .t { font-size: 22px; font-weight: 700; letter-spacing: -.005em; }\n.s-head .r {\n  font-family: var(--font-mono);\n  font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase;\n  color: var(--ink3);\n}\n\n/* ===== Hero (Overview) ===== */\n.hero {\n  display: grid;\n  grid-template-columns: 1.05fr .95fr;\n  gap: var(--gap);\n  margin-top: 4px;\n}\n.hero .visual {\n  background: var(--c1);\n  border: 1px solid var(--c3);\n  display: flex; flex-direction: column;\n  min-height: 480px;\n  position: relative;\n}\n.hero .visual .photo {\n  flex: 1;\n  display: flex; align-items: center; justify-content: center;\n  padding: 24px;\n}\n.hero .visual .photo .ghost {\n  width: 100%; height: 100%;\n  border: 1px dashed var(--c3);\n  display: flex; align-items: center; justify-content: center; flex-direction: column;\n  gap: 8px;\n  font-family: var(--font-mono); font-size: 11px; color: var(--ink3); letter-spacing: .08em;\n}\n.hero .visual .gallery {\n  display: grid; grid-template-columns: repeat(4, 1fr);\n  border-top: 1px solid var(--c3);\n}\n.hero .visual .gallery .cell {\n  height: 76px;\n  border-right: 1px solid var(--c3);\n  display: flex; align-items: center; justify-content: center;\n  font-family: var(--font-mono); font-size: 9.5px; color: var(--ink3); letter-spacing: .08em;\n  background: #fff;\n  cursor: pointer;\n  position: relative;\n}\n.hero .visual .gallery .cell.active { background: var(--c1); }\n.hero .visual .gallery .cell.active::before {\n  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--brand);\n}\n.hero .visual .gallery .cell:last-child { border-right: none; }\n.hero .visual .fam-tag {\n  position: absolute; bottom: 80px; left: 16px; right: 16px;\n  padding: 8px 12px; background: rgba(255,255,255,.94);\n  border-left: 3px solid var(--brand);\n  font-family: var(--font-mono); font-size: 10.5px; color: var(--ink2); letter-spacing: .04em;\n}\n\n.hero .info { display: flex; flex-direction: column; min-height: 480px; }\n\n/* Editorial info panel — mirrors Direction B's hero */\n.hero .info .marker {\n  font-family: var(--font-mono);\n  font-size: 11px; letter-spacing: .18em; text-transform: uppercase;\n  color: var(--brand); font-weight: 700;\n  display: flex; align-items: center; gap: 10px; margin-bottom: 18px;\n  white-space: nowrap;\n}\n.hero .info .marker::before { content: ''; height: 1px; background: var(--brand); width: 28px; flex-shrink: 0; }\n\n.hero .info h1.big-title {\n  font-size: 64px; font-weight: 800; line-height: .96;\n  letter-spacing: -.03em; margin: 0;\n  color: var(--ink);\n}\n.hero .info h1.big-title .red { color: var(--brand); }\n.hero .info h1.big-title .ink { color: var(--ink); }\n.hero .info h1.big-title .underscore {\n  display: inline-block;\n  border-bottom: 6px solid var(--brand);\n  padding-bottom: 0; line-height: .85;\n}\n\n.hero .info .lede {\n  margin-top: 22px;\n  font-size: 16px; line-height: 1.5; color: var(--ink2);\n  font-weight: 400; max-width: 580px; letter-spacing: -.005em;\n}\n.hero .info .lede b { color: var(--ink); font-weight: 600; }\n\n.hero .info .hero-strip {\n  margin-top: 28px;\n  display: grid; grid-template-columns: repeat(2, 1fr);\n  gap: 0;\n  border-top: 1px solid var(--c3);\n  border-bottom: 1px solid var(--c3);\n}\n.hero .info .hero-strip .ts {\n  padding: 16px 18px;\n  border-right: 1px solid var(--c3);\n  border-bottom: 1px solid var(--c3);\n  display: flex; flex-direction: column; gap: 4px;\n}\n.hero .info .hero-strip .ts:nth-child(2n) { border-right: 0; }\n.hero .info .hero-strip .ts:nth-last-child(-n+2) { border-bottom: 0; }\n.hero .info .hero-strip .ts .k {\n  font-family: var(--font-mono);\n  font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink3);\n}\n.hero .info .hero-strip .ts .v {\n  font-size: 26px; font-weight: 800; letter-spacing: -.02em; line-height: 1;\n  color: var(--ink);\n}\n.hero .info .hero-strip .ts .v .u {\n  font-size: 12px; font-weight: 500; margin-left: 4px; color: var(--ink3); letter-spacing: -.005em;\n}\n.hero .info .hero-strip .ts .nt {\n  font-family: var(--font-mono); font-size: 10.5px; color: var(--ink3);\n  letter-spacing: .02em; margin-top: 2px; line-height: 1.45;\n}\n\n.hero .info .build-cta { margin-top: 28px; display: flex; gap: 10px; flex-wrap: nowrap; align-items: center; }\n.hero .info .build-cta button.trail { margin-left: auto; }\n.hero .info .build-cta button {\n  font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase; font-weight: 600;\n  padding: 10px 16px; border: 1px solid var(--c3); background: #fff; color: var(--ink); cursor: pointer;\n}\n.hero .info .build-cta button.primary { background: var(--ink); color: #fff; border-color: var(--ink); }\n.hero .info .build-cta button.primary:hover { background: var(--brand); border-color: var(--brand); }\n.hero .info .build-cta button:hover { background: var(--c1); }\n\n/* ===== Form toggle (big segmented control) ===== */\n.form-toggle {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 12px;\n  margin-bottom: 18px;\n}\n.form-toggle .pick {\n  display: grid;\n  grid-template-columns: auto 1fr auto;\n  align-items: center;\n  gap: 18px;\n  padding: 18px 22px;\n  background: #fff;\n  border: 1px solid var(--c3);\n  border-left: 3px solid var(--c3);\n  cursor: pointer;\n  text-align: left;\n  font-family: var(--font-sans);\n  transition: border-color .15s ease, background .15s ease;\n  color: var(--ink2);\n}\n.form-toggle .pick:hover { background: var(--c1); }\n.form-toggle .pick.on {\n  background: var(--ink);\n  color: #fff;\n  border-color: var(--ink);\n  border-left-color: var(--brand);\n}\n.form-toggle .pick .ico {\n  display: flex; align-items: center; justify-content: center;\n  
    </svg>
  </div>
  <div id="__bundler_loading">Unpacking...</div>

  <script>
    
// CSS scoper · prefixes every selector with hostSelector so the bundle's CSS
// stays confined to the mount host and doesn't bleed into Astro chrome.
// Handles: regular rules, @media, @supports, @font-face, @keyframes, comments.
// body/html/:root selectors collapse to hostSelector so the template's root
// styles (background, typography) apply to the host div.
function scopeCss(css, hostSelector) {
  const out = [];
  let i = 0;
  const n = css.length;
  function isWs(c) { return c === ' ' || c === '\t' || c === '\n' || c === '\r' || c === '\f'; }
  function readBlock() {
    // Reads from current i (which must be at '{') to the matching '}'. Returns the inner string.
    if (css[i] !== '{') return '';
    i++;
    let start = i;
    let depth = 1;
    while (i < n && depth > 0) {
      if (css[i] === '/' && css[i+1] === '*') {
        const e = css.indexOf('*/', i + 2);
        i = e === -1 ? n : e + 2;
        continue;
      }
      if (css[i] === '{') depth++;
      else if (css[i] === '}') { depth--; if (depth === 0) break; }
      i++;
    }
    const inner = css.substring(start, i);
    if (i < n) i++; // consume '}'
    return inner;
  }
  function scopeSelectorList(sl) {
    return sl.split(',').map(function(s) {
      s = s.trim();
      if (!s) return '';
      if (s === 'body' || s === 'html' || s === ':root') return hostSelector;
      if (s === '*') return hostSelector + ' *';
      if (s.indexOf(hostSelector) === 0) return s;
      return hostSelector + ' ' + s;
    }).filter(function(s){return s;}).join(', ');
  }
  while (i < n) {
    while (i < n && isWs(css[i])) { out.push(css[i]); i++; }
    if (i >= n) break;
    // Comments
    if (css[i] === '/' && css[i+1] === '*') {
      const e = css.indexOf('*/', i + 2);
      out.push(css.substring(i, e === -1 ? n : e + 2));
      i = e === -1 ? n : e + 2;
      continue;
    }
    // At-rules
    if (css[i] === '@') {
      const start = i;
      while (i < n && css[i] !== '{' && css[i] !== ';') i++;
      const header = css.substring(start, i);
      const name = (header.match(/@([\w-]+)/) || [])[1] || '';
      if (i < n && css[i] === ';') { out.push(header + ';'); i++; continue; }
      // Block at-rule
      if (name === 'keyframes' || name === '-webkit-keyframes' || name === 'font-face' || name === 'page' || name === 'charset' || name === 'import') {
        // Copy block verbatim (no inner scoping)
        const inner = readBlock();
        out.push(header + '{' + inner + '}');
      } else {
        // @media, @supports etc · scope inner rules
        const inner = readBlock();
        out.push(header + '{' + scopeCss(inner, hostSelector) + '}');
      }
      continue;
    }
    // Regular rule: selectorList { decls }
    const selStart = i;
    while (i < n && css[i] !== '{' && css[i] !== '}') i++;
    if (i >= n || css[i] === '}') { out.push(css.substring(selStart, i)); continue; }
    const selectorList = css.substring(selStart, i).trim();
    const decls = readBlock();
    if (selectorList) out.push(scopeSelectorList(selectorList) + '{' + decls + '}');
  }
  return out.join('');
}

document.addEventListener('DOMContentLoaded', async function() {
  const loading = document.getElementById('__bundler_loading');
  function setStatus(msg) { if (loading) loading.textContent = msg; }

  // Error sink persists across replaceWith since it's on window, not the DOM.
  window.addEventListener('error', function(e) {
    // Filter out React dev-build cross-origin warnings · they fire from blob URLs
    // and React can't see the actual error across the CORS boundary. These are
    // cosmetic / non-fatal · log to console but don't pollute the on-screen banner.
    var msg = e.message || e.type || '';
    var isCrossOrigin = msg.indexOf('cross-origin') >= 0 || msg.indexOf('Script error') >= 0;
    if (isCrossOrigin) {
      console.warn('[bundler] suppressed cross-origin error:', msg, e.filename, e.lineno);
      return;
    }
    var p = document.body || document.documentElement;
    var d = document.getElementById('__bundler_err') || p.appendChild(document.createElement('div'));
    d.id = '__bundler_err';
    d.style.cssText = 'position:fixed;bottom:12px;left:12px;right:12px;font:12px/1.4 ui-monospace,monospace;background:#2a1215;color:#ff8a80;padding:10px 14px;border-radius:8px;border:1px solid #5c2b2e;z-index:99999;white-space:pre-wrap;max-height:40vh;overflow:auto';
    d.textContent = (d.textContent ? d.textContent + String.fromCharCode(10) : '') +
      '[bundle] ' + msg +
      (e.filename ? ' (' + e.filename.slice(0, 60) + ':' + e.lineno + ')' : '');
  }, true);

  try {
    const manifestEl = document.querySelector('script[type="__bundler/manifest"]');
    const templateEl = document.querySelector('script[type="__bundler/template"]');
    if (!manifestEl || !templateEl) {
      setStatus('Error: missing bundle data');
      console.error('[bundler] Missing script tags — manifestEl:', !!manifestEl, 'templateEl:', !!templateEl);
      return;
    }

    const manifest = JSON.parse(manifestEl.textContent);
    let template = JSON.parse(templateEl.textContent);

    const uuids = Object.keys(manifest);
    setStatus('Unpacking ' + uuids.length + ' assets...');

    const blobUrls = {};
    // blobToText: blob URL → decoded UTF-8 text. Built once during decode for
    // text/JS assets so the babel-with-src handler below can read the script
    // body directly instead of fetch()-ing the blob: URL — which strict CSPs
    // (e.g. Cloudflare Pages default connect-src) block.
    const blobToText = {};
    await Promise.all(uuids.map(async (uuid) => {
      const entry = manifest[uuid];
      try {
        const binaryStr = atob(entry.data);
        const bytes = new Uint8Array(binaryStr.length);
        for (let i = 0; i < binaryStr.length; i++) bytes[i] = binaryStr.charCodeAt(i);

        let finalBytes = bytes;
        if (entry.compressed) {
          if (typeof DecompressionStream !== 'undefined') {
            const ds = new DecompressionStream('gzip');
            const writer = ds.writable.getWriter();
            const reader = ds.readable.getReader();
            writer.write(bytes);
            writer.close();
            const chunks = [];
            let totalLen = 0;
            while (true) {
              const { done, value } = await reader.read();
              if (done) break;
              chunks.push(value);
              totalLen += value.length;
            }
            finalBytes = new Uint8Array(totalLen);
            let offset = 0;
            for (const chunk of chunks) { finalBytes.set(chunk, offset); offset += chunk.length; }
          } else {
            console.warn('DecompressionStream not available, asset ' + uuid + ' may not render');
          }
        }

        blobUrls[uuid] = URL.createObjectURL(new Blob([finalBytes], { type: entry.mime }));
        // Cache decoded text for text/JS assets so we never need fetch() to read it back.
        const mime = entry.mime || '';
        if (mime.indexOf('text/') === 0 || mime.indexOf('javascript') >= 0 || mime === '') {
          try { blobToText[blobUrls[uuid]] = new TextDecoder('utf-8').decode(finalBytes); } catch (e) {}
        }
      } catch (err) {
        console.error('Failed to decode asset ' + uuid + ':', err);
        blobUrls[uuid] = URL.createObjectURL(new Blob([], { type: entry.mime }));
      }
    }));

    const extResEl = document.querySelector('script[type="__bundler/ext_resources"]');
    const extResources = extResEl ? JSON.parse(extResEl.textContent) : [];
    const resourceMap = {};
    for (const entry of extResources) {
      if (blobUrls[entry.uuid]) resourceMap[entry.id] = blobUrls[entry.uuid];
    }

    setStatus('Rendering...');
    for (const uuid of uuids) template = template.split(uuid).join(blobUrls[uuid]);

    // Strip integrity + crossorigin — blob URLs from a file:// document inherit
    // a null origin, so crossorigin forces a CORS fetch that SRI then rejects.
    // The manifest bytes are ours; SRI protects against CDN compromise, not this.
    template = template.replace(/\s+integrity="[^"]*"/gi, '').replace(/\s+crossorigin="[^"]*"/gi, '');

    const resourceScript = '<script>window.__resources = ' +
      JSON.stringify(resourceMap).split('</' + 'script>').join('<\\/' + 'script>') +
      ';</' + 'script>';
    // Inject after <head> so the DOCTYPE stays first; prepending the script
    // would push the parser into quirks mode. DOMParser always emits a <head>
    // (synthesizing one if the source HTML omitted it) but may carry
    // attributes through, so match the full opening tag. slice() rather than
    // replace() keeps us clear of $-pattern substitution in resourceScript.
    const headOpen = template.match(/<head[^>]*>/i);
    if (headOpen) {
      const i = headOpen.index + headOpen[0].length;
      template = template.slice(0, i) + resourceScript + template.slice(i);
    }

    // Parse the template. Two mount modes:
    //   HOST MODE (preferred · chrome-compatible): if a `.constant-exit-pdp`
    //     host div is present in the parent document, mount the template body
    //     INTO that div without touching <html>/<head>/<body>. Template styles
    //     are auto-scoped under the host class so Astro chrome CSS survives.
    //   STANDALONE MODE (fallback · file:// preview): if no host div exists,
    //     swap document.documentElement as before — this is the file://
    //     preview path James uses when curating photos locally.
    const doc = new DOMParser().parseFromString(template, 'text/html');
    const HOST_CLASS = 'constant-exit-pdp';
    const host = document.querySelector('.' + HOST_CLASS);

    if (host) {
      // ===== HOST MODE =====
      // 1. Inject template <style> blocks into parent <head> with auto-scoping.
      //    The scoper prefixes every selector with `.constant-exit-pdp `;
      //    bare body/html/:root collapse to the host selector so background
      //    color / typography from the template apply to the host div only.
      for (const styleEl of doc.head.querySelectorAll('style')) {
        const scoped = document.createElement('style');
        scoped.textContent = scopeCss(styleEl.textContent, '.' + HOST_CLASS);
        scoped.setAttribute('data-bundler-scoped', '1');
        document.head.appendChild(scoped);
      }
      // 2. Copy <link rel="stylesheet"> verbatim (assumed external, can't scope).
      for (const linkEl of doc.head.querySelectorAll('link[rel="stylesheet"]')) {
        document.head.appendChild(linkEl.cloneNode(true));
      }
      // 3. Move template scripts + body children into host.
      //    The template has scripts in BOTH <head> (React, ReactDOM, Babel-
      //    standalone) and <body> (roster, text/babel app code). DOMParser-
      //    inserted scripts are inert per spec — re-create each with
      //    createElement so they execute, awaiting onload for src scripts to
      //    preserve order (React → ReactDOM → Babel → roster → text/babel).
      //    Non-script body children (the #root div, loading divs, etc.) get
      //    adopted directly. Remove any existing #root from host first.
      const existingRoot = host.querySelector('#root');
      if (existingRoot) existingRoot.remove();

      async function appendScriptOrChild(child, dest) {
        if (child.tagName === 'SCRIPT') {
          const s = document.createElement('script');
          for (const a of child.attributes) s.setAttribute(a.name, a.value);
          s.textContent = child.textContent;
          if ((s.type === 'text/babel' || s.type === 'text/jsx') && s.src) {
            if (blobToText[s.src]) {
              s.textContent = blobToText[s.src];
            } else {
              try {
                const r = await fetch(s.src);
                s.textContent = await r.text();
              } catch (e) {
                console.error('[bundler] babel src fetch fallback failed:', e, s.src);
              }
            }
            s.removeAttribute('src');
          }
          const p = s.src ? new Promise(function(r) { s.onload = s.onerror = r; }) : null;
          dest.appendChild(s);
          if (p) await p;
        } else {
          dest.appendChild(child);
        }
      }

      // FIRST: process scripts in template head (React, ReactDOM, Babel).
      // These have to load before any text/babel script in the body runs.
      const headScripts = Array.from(doc.head.querySelectorAll('script'));
      for (const s of headScripts) await appendScriptOrChild(s, host);

      // THEN: process body children (more scripts + #root + loading UI).
      const bodyChildren = Array.from(doc.body.children);
      for (const child of bodyChildren) await appendScriptOrChild(child, host);
    } else {
      // ===== STANDALONE MODE (file:// preview) =====
      // Original behavior: swap the entire document. Scripts inserted via
      // DOMParser are inert per spec — re-create each with createElement so
      // they execute, awaiting onload for src scripts to preserve ordering
      // (React before ReactDOM before Babel before text/babel).
      document.documentElement.replaceWith(doc.documentElement);
      const dead = Array.from(document.scripts);
      for (const old of dead) {
        const s = document.createElement('script');
        for (const a of old.attributes) s.setAttribute(a.name, a.value);
        s.textContent = old.textContent;
        if ((s.type === 'text/babel' || s.type === 'text/jsx') && s.src) {
          if (blobToText[s.src]) {
            s.textContent = blobToText[s.src];
          } else {
            try {
              const r = await fetch(s.src);
              s.textContent = await r.text();
            } catch (e) {
              console.error('[bundler] babel src fetch fallback failed:', e, s.src);
            }
          }
          s.removeAttribute('src');
        }
        const p = s.src ? new Promise(function(r) { s.onload = s.onerror = r; }) : null;
        old.replaceWith(s);
        if (p) await p;
      }
    }
    // Babel standalone auto-transforms type=text/babel on DOMContentLoaded,
    // which fired before we mounted. Trigger manually if present.
    if (window.Babel && typeof window.Babel.transformScriptTags === 'function') {
      window.Babel.transformScriptTags();
    }
  } catch (err) {
    setStatus('Error unpacking: ' + err.message);
    console.error('Bundle unpack error:', err);
  }
});

  </script>


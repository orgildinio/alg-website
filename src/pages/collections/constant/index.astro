<script>
  // Filter chip interactivity for All Drivers grid
  const chips = document.querySelectorAll('.af-chip');
  const cards = document.querySelectorAll('.af-body .family-card');
  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      chips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      const filter = chip.dataset.filter;
      cards.forEach(card => {
        if (filter === 'all' || card.dataset.tier === filter) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>


                  <span class="fc-tier tier-badge tier-pro">PRO</span>
                </div>
                <div class="fc-img" style={sku.photo && !sku.noBg ? `background-image: url(${sku.photo})` : undefined}>
                  <img
                    src={sku.photo}
                    alt={sku.name}
                    loading="lazy"
                    style="max-width:100%;max-height:100%;object-fit:contain;opacity:0.85;"
                    onerror="this.style.display='none';this.nextElementSibling.style.display='block';"
                  />
                  <span class="fc-watermark" style="display:none;">{sku.name}</span>
                </div>
                <div class="fc-bottom">
                  <div class="fc-name">{sku.name}</div>
                  <div class="fc-meta">
                    <span class="fc-watt">{sku.meta}</span>
                    <span class="fc-dlc">UL 924</span>
                  </div>
                  <span class="fc-view">VIEW →</span>
                </div>
              </a>
            ))}
          </div>
          <p class="fam-no-results" id="skuNoResults" style="display:none;">No drivers match the current filters. <button id="skuNoResultsReset">Reset all</button></p>

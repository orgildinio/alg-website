---
<BaseLayout
  title="constⒶNT — Emergency Drivers · Archipelago Lighting Group"
  description="constⒶNT — ALG's emergency battery backup driver ecosystem. UL 924 listed. Multi-input 120–347 VAC. 20 active driver SKUs across 3 install tiers and 8 verticals."
>
  <!-- Pagefind breadcrumb meta -->
  <span data-pagefind-meta="breadcrumb:Safety & Controls › constANT" data-pagefind-ignore="all" style="display:none"></span>
  <span data-pagefind-meta="keywords:emergency driver,UL 924,battery backup,EM driver,CRC driver,egress lighting,NFPA 101,Title 24 NLC,constANT" data-pagefind-ignore="all" style="display:none"></span>

  <!-- §1 BREADCRUMB — 4-segment hierarchical per J.1 -->
  <div class="breadcrumb-band">
    <a href="/">HOME</a>
    <span class="bc-sep">›</span>
    <a href="/products/">PRODUCTS</a>
    <span class="bc-sep">›</span>
    <a href="/solutions/safety-controls/">SAFETY &amp; CONTROLS</a>
    <span class="bc-sep">›</span>
    <span class="bc-current">const<span class="aa">Ⓐ</span>NT</span>
  </div>

  <!-- §2 HERO — uses CollectionHero CSS classes for pixel parity -->
  <section class="collection-section collection-section--hero" id="hero">
    <div class="collection-content">
      <div class="hero-eyebrow">SAFETY &amp; CONTROLS · EMERGENCY DRIVER COLLECTION</div>
      <h1 class="hero-wordmark" data-pagefind-weight="10">const<span class="aa">Ⓐ</span>NT</h1>
      <p class="hero-desc">Emergency battery backup drivers for every fixture family in the ALG line. UL 924 listed. Multi-input 120–347 VAC. <strong>20 active driver SKUs across 3 install tiers and 8 verticals.</strong> Optional /AG <span class="aa">Ⓐ</span>rcticGuard cold-pack, /XD extended-discharge, and /CL networked-test adders for environment-specific requirements.</p>
      <div class="hero-pills">
        <span class="hero-pill">UL 924 LISTED</span>
        <span class="hero-pill">120-347 VAC INPUT</span>
        <span class="hero-pill">90-MIN RUNTIME</span>
        <span class="hero-pill">5-YEAR WARRANTY</span>
        <span class="hero-pill">NLC-READY VIA /CL</span>
      </div>
    </div>
  </section>

  <!-- §3 QUICK STATS — shared component -->
  <CollectionStatStrip statStrip={statStrip} />

  <!-- §4 BROWSE BY INSTALL TIER — uses CollectionApplications CSS classes -->
  <section class="collection-section collection-section--applications" id="install-tiers">
    <div class="collection-content">
      <div class="sec-eyebrow">Browse by install tier</div>
      <div class="app-grid app-grid--4">
        <a class="browse-tile-link" href="#all-drivers" data-tier-filter="factory">
          <span class="btl-eyebrow">FACTORY</span>
          <span class="btl-name">Factory-Install</span>
          <span class="btl-meta">4 SKUs · Pre-installed in host fixture</span>
        </a>
        <a class="browse-tile-link" href="#all-drivers" data-tier-filter="field">
          <span class="btl-eyebrow">FIELD</span>
          <span class="btl-name">Field-Install</span>
          <span class="btl-meta">12 SKUs · Certified electrician on-site</span>
        </a>
        <a class="browse-tile-link" href="#all-drivers" data-tier-filter="quick">
          <span class="btl-eyebrow">QUICK</span>
          <span class="btl-name">Quick-Install</span>
          <span class="btl-meta">4 SKUs · J-Box remote mount</span>
        </a>
        <a class="browse-tile-link" href="#product-types">
          <span class="btl-eyebrow">SAFETY</span>
          <span class="btl-name">Safety &amp; Emergency</span>
          <span class="btl-meta">Exit signs · combo · emergency lights</span>
        </a>
      </div>
    </div>
  </section>

  <!-- §5 BROWSE BY PRODUCT TYPE — constⒶNT-specific addition -->
  <section class="collection-section collection-section--product-types" id="product-types">
    <div class="collection-content">
      <div class="sec-eyebrow">Browse by product type</div>
      <div class="app-grid app-grid--5">
        <a class="browse-tile-link browse-tile-link--live" href="/collections/constant/#all-drivers">
          <span class="btl-eyebrow">LIVE · 20 SKUS</span>
          <span class="btl-name">Emergency Battery Backup</span>
          <span class="btl-meta">EM &amp; CRC driver line · UL 924</span>
        </a>
        <a class="browse-tile-link browse-tile-link--live" href="/collections/constant/#all-drivers?adder=cl">
          <span class="btl-eyebrow">LIVE · 3 SKUS</span>
          <span class="btl-name">const<span class="aa">Ⓐ</span>NTLink EM Batteries</span>
          <span class="btl-meta">Networked NLC battery line · /CL adder</span>
        </a>
        <a class="browse-tile-link browse-tile-link--live" href="/collections/constant/exit/#family?form=exit">
          <span class="btl-eyebrow">LIVE · 28 SKUS</span>
          <span class="btl-name">Exit Signs</span>
          <span class="btl-meta">UL 924 listed · LEMX family</span>
        </a>
        <a class="browse-tile-link browse-tile-link--live" href="/collections/constant/exit/#family?form=combo">
          <span class="btl-eyebrow">LIVE · 8 SKUS</span>
          <span class="btl-name">Combo Signs</span>
          <span class="btl-meta">Exit + emergency in one unit</span>
        </a>
        <a class="browse-tile-link browse-tile-link--live" href="/collections/constant/exit/#family?form=emg-light">
          <span class="btl-eyebrow">LIVE · 5 SKUS</span>
          <span class="btl-name">Emergency Lights</span>
          <span class="btl-meta">2-head · 4-head · remote-capable</span>
        </a>
      </div>
    </div>
  </section>

  <!-- §6 MARKETING STAT 6-UP — shared CollectionRedBanner component -->
  <CollectionRedBanner redBanner={redBanner} />

  <!-- §7 FEATURED FAMILIES — shared CollectionFeatured component -->
  <CollectionFeatured
    collectionName="constANT"
    collectionSlug="constant"
    featured={featured}
    featuredHeadline={`Four flagship drivers from the const<span class="aa">Ⓐ</span>NT line.`}
  />

  <!-- §8 ALL DRIVERS GRID — 9-axis filter rail + 11 SKU cards -->
  <section class="collection-section collection-section--families" id="all-drivers">
    <div class="collection-content">
      <div class="fam-eyebrow">All Drivers</div>
      <h2 class="fam-headline">20 drivers. One ecosystem.</h2>

      <div class="fam-layout">
        <!-- STICKY LEFT FILTER RAIL — 9 axes per §D.3 -->
        <aside class="fam-sidebar">
          <div class="filter-header">
            <span class="filter-title">FILTER BY</span>
            <button class="filter-reset" id="filterReset">Reset all</button>
          </div>

          <!-- 1: INSTALL TIER -->
          <div class="filter-group" data-group="tier">
            <button class="fg-toggle" aria-expanded="true">INSTALL TIER <span class="fg-arrow">▲</span></button>
            <div class="fg-body">
              <label class="fg-item"><input type="checkbox" data-facet="tier" value="factory" /><span class="fg-name">Factory-Install</span><span class="fg-count">(4)</span></label>
              <label class="fg-item"><input type="checkbox" data-facet="tier" value="field" /><span class="fg-name">Field-Install</span><span class="fg-count">(12)</span></label>
              <label class="fg-item"><input type="checkbox" data-facet="tier" value="quick" /><span class="fg-name">Quick-Install</span><span class="fg-count">(4)</span></label>
            </div>
          </div>

          <!-- 2: POWER CLASS -->
          <div class="filter-group" data-group="power">
            <button class="fg-toggle" aria-expanded="true">POWER CLASS <span class="fg-arrow">▲</span></button>
            <div class="fg-body">
              <label class="fg-item"><input type="checkbox" data-facet="power" value="low" /><span class="fg-name">Low 5–9W</span><span class="fg-count">(6)</span></label>
              <label class="fg-item"><input type="checkbox" data-facet="power" value="mid" /><span class="fg-name">Mid 15–25W</span><span class="fg-count">(10)</span></label>
              <label class="fg-item"><input type="checkbox" data-facet="power" value="high" /><span class="fg-name">High 30–60W</span><span class="fg-count">(4)</span></label>
            </div>
          </div>

          <!-- 3: ORDER-CODE ADDERS -->
          <div class="filter-group" data-group="adder">
            <button class="fg-toggle" aria-expanded="true">ORDER-CODE ADDERS <span class="fg-arrow">▲</span></button>
            <div class="fg-body">
              <label class="fg-item"><input type="checkbox" data-facet="adder" value="ag" /><span class="fg-name">/AG <span class="aa">Ⓐ</span>rcticGuard</span><span class="fg-count">(2)</span></label>
              <label class="fg-item"><input type="checkbox" data-facet="adder" value="xd" /><span class="fg-name">/XD Extended Discharge</span><span class="fg-count">(0)</span></label>
              <label class="fg-item"><input type="checkbox" data-facet="adder" value="cl" /><span class="fg-name">/CL const<span class="aa">Ⓐ</span>NTLink</span><span class="fg-count">(5)</span></label>
            </div>
          </div>

          <!-- 4: OUTPUT TYPE -->
          <div class="filter-group" data-group="output">
            <button class="fg-toggle" aria-expanded="true">OUTPUT TYPE <span class="fg-arrow">▲</span></button>
            <div class="fg-body">
              <label class="fg-item"><input type="checkbox" data-facet="output" value="dc" /><span class="fg-name">DC</span><span class="fg-count">(16)</span></label>
              <label class="fg-item"><input type="checkbox" data-facet="output" value="ac" /><span class="fg-name">AC</span><span class="fg-count">(4)</span></label>
            </div>
          </div>

          <!-- 5: OUTPUT POWER slider -->
          <div class="filter-group" data-group="wattage">

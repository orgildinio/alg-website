<script>
  // Filter chip interactivity for All Drivers grid
  (function () {
    const resetBtn = document.getElementById('filterReset');
    const noResultsReset = document.getElementById('skuNoResultsReset');
    const countLabel = document.getElementById('skuCountLabel');
    const noResults = document.getElementById('skuNoResults');
    const grid = document.getElementById('skuGrid');
    const cards = grid ? Array.from(grid.querySelectorAll('.fam-card')) : [];
    const wattSlider = document.getElementById('wattSlider') as HTMLInputElement | null;
    const wattMaxLabel = document.getElementById('wattMax');

    // Active filter state
    const active: Record<string, Set<string>> = {
      tier: new Set(), power: new Set(), adder: new Set(),
      output: new Set(), family: new Set(), vertical: new Set(),
      cert: new Set(), baa: new Set(),
    };
    let activeMaxWatt = 60;

    // Power class mapping from SKU wattage
    function getPowerClass(meta: string): string {
      const m = meta.match(/(\d+)W/);
      if (!m) return 'mid';
      const w = parseInt(m[1]);
      if (w <= 9) return 'low';
      if (w <= 25) return 'mid';
      return 'high';
    }

    // Adder mapping from SKU name
    function getAdders(name: string): string[] {
      const adders: string[] = [];
      if (name.includes('/AG') || name.includes('260DC')) adders.push('ag');
      if (name.includes('/XD')) adders.push('xd');
      if (name.includes('/CL') || name.includes('PMB')) adders.push('cl');
      return adders;
    }

    // Output type mapping
    function getOutput(meta: string): string {
      return meta.includes('Vac') ? 'ac' : 'dc';
    }

    function cardMatches(card: Element): boolean {
      const el = card as HTMLElement;
      const tier = el.dataset.tier ?? '';
      const sku = el.dataset.sku ?? '';
      const output = el.dataset.output ?? '';
      const family = el.dataset.family ?? '';
      const adder = el.dataset.adder ?? '';
      const metaEl = card.querySelector('.fc-watt');
      const meta = metaEl?.textContent ?? '';

      if (active.tier.size > 0 && !active.tier.has(tier)) return false;
      if (active.power.size > 0 && !active.power.has(getPowerClass(meta))) return false;
      if (active.adder.size > 0) {
        const skuAdders = adder ? adder.split(',').filter(Boolean) : getAdders(sku);
        if (!Array.from(active.adder).some(a => skuAdders.includes(a))) return false;
      }
      if (active.output.size > 0 && !active.output.has(output || getOutput(meta))) return false;
      if (active.family.size > 0 && !active.family.has(family)) return false;
      // Wattage slider
      const wm = meta.match(/(\d+)W/);
      if (wm && parseInt(wm[1]) > activeMaxWatt) return false;
      // Vertical, cert, baa — informational filters (all SKUs match all)
      return true;
    }

    function render() {
      let visible = 0;
      cards.forEach(card => {
        const show = cardMatches(card);
        (card as HTMLElement).style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (countLabel) countLabel.textContent = `Showing ${visible} driver${visible === 1 ? '' : 's'}`;
      if (noResults) noResults.style.display = visible === 0 ? '' : 'none';
    }

    // Checkbox listeners
    document.querySelectorAll('[data-facet]').forEach(inp => {
      inp.addEventListener('change', () => {
        const facet = (inp as HTMLInputElement).dataset.facet ?? '';
        const val = (inp as HTMLInputElement).value;
        if (active[facet]) {
          if ((inp as HTMLInputElement).checked) active[facet].add(val);
          else active[facet].delete(val);
        }
        render();
      });
    });

    // Wattage slider
    if (wattSlider) {
      wattSlider.addEventListener('input', () => {
        activeMaxWatt = parseInt(wattSlider.value, 10);
        if (wattMaxLabel) wattMaxLabel.textContent = wattSlider.value + 'W';
        render();
      });
    }

    function resetAll() {
      Object.values(active).forEach(s => s.clear());
      activeMaxWatt = 60;
      document.querySelectorAll('[data-facet]').forEach(inp => { (inp as HTMLInputElement).checked = false; });
      if (wattSlider) { wattSlider.value = '60'; }
      if (wattMaxLabel) wattMaxLabel.textContent = '60W';
      render();
    }
    if (resetBtn) resetBtn.addEventListener('click', resetAll);
    if (noResultsReset) noResultsReset.addEventListener('click', resetAll);

    // Collapsible filter groups
    document.querySelectorAll('.fg-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        const body = (btn as HTMLElement).nextElementSibling as HTMLElement | null;
        if (body) body.style.display = expanded ? 'none' : '';
        const arrow = btn.querySelector('.fg-arrow');
        if (arrow) arrow.textContent = expanded ? '▼' : '▲';
      });
    });

    // Browse-by-tier tile click → set filter + scroll to grid
    document.querySelectorAll('[data-tier-filter]').forEach(tile => {
      tile.addEventListener('click', (e) => {
        e.preventDefault();
        const tierVal = (tile as HTMLElement).dataset.tierFilter ?? '';
        if (tierVal) {
          active.tier.clear();
          active.tier.add(tierVal);
          const cb = document.querySelector(`[data-facet="tier"][value="${tierVal}"]`) as HTMLInputElement | null;
          if (cb) cb.checked = true;
          render();
        }
        document.getElementById('all-drivers')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    // LSN-FILTER-1: URL-param → filter-state binding (seed on initial render)
    (function seedFromURL() {
      const params = new URLSearchParams(window.location.search);
      const adderParam = params.get('adder');
      const tierParam  = params.get('tier');
      if (adderParam) {
        const val = adderParam.toLowerCase();
        active.adder.add(val);
        const cb = document.querySelector(`[data-facet="adder"][value="${val}"]`) as HTMLInputElement | null;
        if (cb) cb.checked = true;
      }
      if (tierParam) {
        const val = tierParam.toLowerCase();
        active.tier.add(val);
        const cb = document.querySelector(`[data-facet="tier"][value="${val}"]`) as HTMLInputElement | null;
        if (cb) cb.checked = true;
      }
    })();

    // Initial render
    render();
  })();
</script>

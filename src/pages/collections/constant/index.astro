              <option value="power-asc">Power Low to High</option>
              <option value="power-desc">Power High to Low</option>
              <option value="az">A to Z</option>
            </select>
          </div>

          <div class="fam-grid" id="skuGrid">
            {skus.map(sku => (
              <a
                href={sku.pdp}
                class="fam-card"
                id={sku.id}
                data-tier={sku.tier}
                data-sku={sku.name}
                data-output={sku.output}
                data-family={sku.family}
                data-adder={sku.adder}

              <label class="fg-item"><input type="checkbox" data-facet="family" value="lamparch" /><span class="fg-name">lampar<span class="aa">Ⓐ</span>RCH</span><span class="fg-count">(4)</span></label>
              <label class="fg-item"><input type="checkbox" data-facet="family" value="luxoarch" /><span class="fg-name">luxo<span class="aa">Ⓐ</span>RCH</span><span class="fg-count">(2)</span></label>
              <label class="fg-item"><input type="checkbox" data-facet="family" value="multifamily" /><span class="fg-name">multi-f<span class="aa">Ⓐ</span>MILY</span><span class="fg-count">(4)</span></label>
              <label class="fg-item"><input type="checkbox" data-facet="family" value="planoarch" /><span class="fg-name">plano<span class="aa">Ⓐ</span>RCH</span><span class="fg-count">(2)</span></label>
              <label class="fg-item"><input type="checkbox" data-facet="family" value="universal" /><span class="fg-name">All universal</span><span class="fg-count">(7)</span></label>
            </div>
          </div>

          <!-- 7: VERTICAL -->
          <div class="filter-group" data-group="vertical">
            <button class="fg-toggle" aria-expanded="true">VERTICAL <span class="fg-arrow">▲</span></button>
            <div class="fg-body">
              <label class="fg-item"><input type="checkbox" data-facet="vertical" value="cold-storage" /><span class="fg-name">Cold Storage &amp; Grocery</span></label>
              <label class="fg-item"><input type="checkbox" data-facet="vertical" value="data-center" /><span class="fg-name">Data Center</span></label>
              <label class="fg-item"><input type="checkbox" data-facet="vertical" value="education" /><span class="fg-name">Education</span></label>
              <label class="fg-item"><input type="checkbox" data-facet="vertical" value="government" /><span class="fg-name">Government &amp; Military</span></label>
              <label class="fg-item"><input type="checkbox" data-facet="vertical" value="healthcare" /><span class="fg-name">Healthcare &amp; Medical</span></label>
              <label class="fg-item"><input type="checkbox" data-facet="vertical" value="hospitality" /><span class="fg-name">Hospitality</span></label>
              <label class="fg-item"><input type="checkbox" data-facet="vertical" value="industrial" /><span class="fg-name">Industrial &amp; Manufacturing</span></label>
              <label class="fg-item"><input type="checkbox" data-facet="vertical" value="warehouse" /><span class="fg-name">Warehouse &amp; Logistics</span></label>
            </div>
          </div>

          <!-- 8: CERTIFICATION -->
          <div class="filter-group" data-group="cert">
            <button class="fg-toggle" aria-expanded="true">CERTIFICATION <span class="fg-arrow">▲</span></button>
            <div class="fg-body">
              <label class="fg-item"><input type="checkbox" data-facet="cert" value="ul924" /><span class="fg-name">UL 924 Listed</span><span class="fg-count">(20)</span></label>
              <label class="fg-item"><input type="checkbox" data-facet="cert" value="csa" /><span class="fg-name">CSA C22.2 No.141</span><span class="fg-count">(20)</span></label>
              <label class="fg-item"><input type="checkbox" data-facet="cert" value="cec" /><span class="fg-name">CEC Title 20</span><span class="fg-count">(20)</span></label>
            </div>
          </div>

          <!-- 9: BAA / TAA -->
          <div class="filter-group" data-group="baa">
            <button class="fg-toggle" aria-expanded="true">BAA / TAA <span class="fg-arrow">▲</span></button>
            <div class="fg-body">
              <label class="fg-item"><input type="checkbox" data-facet="baa" value="on-request" /><span class="fg-name">Documentation on Request</span></label>
            </div>
          </div>
        </aside>

        <!-- SKU GRID — 20 real SKUs -->
        <div class="fam-main">
          <div class="fam-toolbar">
            <span class="fam-count-label" id="skuCountLabel">Showing 20 drivers</span>
            <select class="fam-sort" id="skuSort">

---
/**
 * collections/constant/index.astro
 *
 * constANT collection page — route: /collections/constant/
 * Design source: constANT_collection_SHIP.html (2026-05-27)
 * Canonical spine: 21-block pattern (cityARCH precedent)
 * Content source: 2026 Edition Product Guide
 *
 * CFG-CHROME-1: No inlined header/footer/utility-bar.
 *   BaseLayout injects the shell. This file is CONTENT-ONLY.
 * CFG-CHROME-2: .mockup-banner stripped.
 * CFG-TYPE-1: Lato + JetBrains Mono pinned.
 * CFG-INV-1: No inventory counts. SKU counts only.
 * CFG-COPY-4/-5/-6: No competitor brands, no vendor MPNs, no OEM/factory mentions.
 *
 * J.1 Breadcrumb: HOME › PRODUCTS › SAFETY & CONTROLS › CONSTANT (4-segment hierarchical)
 * J.2 Scope: Drivers (live) + 4 product-type stub pages (coming soon)
 * J.3 Featured: 4 cards (one per install tier)
 * J.4 Phase-2 punts: Selector, per-adder sub-pages, DLC NLC chips, cross-ref table
 * J.5 Anchor rail: 11 dots
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="constANT — Emergency Drivers | Archipelago Lighting Group"
  description="constANT — ALG's emergency battery backup driver ecosystem. UL 924 listed. Universal 100–347Vac input. Four install tiers, three power classes, three optional adders, eight verticals."
  bodyClass="page-constant-collection"
>
<style>
  :root {
    --brand-red: #F32740;
    --ink: #15181c;
    --char: #1c2025;
    --char-2: #22262b;
    --char-3: #2a2e34;
    --paper: #FAF8F4;
    --paper-2: #F1ECE3;
    --rule: rgba(28, 32, 37, 0.10);
    --rule-strong: rgba(28, 32, 37, 0.25);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'Lato', system-ui, sans-serif !important; color: var(--ink); background: #ffffff; line-height: 1.5; -webkit-font-smoothing: antialiased; }
  h1, h2, h3, h4 { font-family: 'Lato', system-ui, sans-serif !important; }
  .mono { font-family: 'JetBrains Mono', ui-monospace, monospace !important; }
  /* CFG-MF-13 glyph spacing tuck */
  .aa { color: var(--brand-red); font-weight: 700; margin: 0 -0.04em; }
  /* WRAPPER */
  .wrap { max-width: 1680px; margin: 0 auto; padding: 0 48px; }
  .wrap-narrow { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  /* BREADCRUMB · §4 */
  .breadcrumb { padding: 32px 48px 16px; max-width: 1680px; margin: 0 auto; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,32,37,0.65); }
  .breadcrumb a { color: rgba(28,32,37,0.85); text-decoration: none; border-bottom: 1px solid transparent; transition: border-color 0.15s; }
  .breadcrumb a:hover { border-bottom-color: var(--brand-red); }
  .breadcrumb .sep { margin: 0 8px; color: rgba(28,32,37,0.35); }
  /* HERO BAND · §5 */
  .hero { padding: 24px 48px 64px; max-width: 1680px; margin: 0 auto; }
  .hero-eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(28,32,37,0.65); margin-bottom: 24px; }
  .hero h1 { font-size: 96px; font-weight: 900; letter-spacing: -0.025em; line-height: 0.95; margin-bottom: 24px; color: var(--ink); }
  .hero-desc { font-size: 19px; line-height: 1.55; max-width: 880px; color: rgba(28,32,37,0.85); margin-bottom: 32px; }
  .hero-chips { display: flex; flex-wrap: wrap; gap: 12px; }
  .chip { display: inline-flex; align-items: center; padding: 8px 16px; background: var(--paper-2); font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink); border-radius: 1px; }
  .chip-accent { background: var(--brand-red); color: white; }
  /* QUICK STAT GRID · §6 */
  .quick-stats { background: var(--paper); padding: 56px 48px; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .quick-stats-inner { max-width: 1680px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); gap: 48px; }
  .qs-num { font-size: 64px; font-weight: 900; letter-spacing: -0.03em; line-height: 1; color: var(--ink); margin-bottom: 8px; }
  .qs-label { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,32,37,0.65); }
  /* BROWSE BY INSTALL TIER · §7 */
  .browse-section { padding: 64px 48px; max-width: 1680px; margin: 0 auto; }
  .section-eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(28,32,37,0.65); margin-bottom: 16px; }
  .section-h2 { font-size: 36px; font-weight: 900; letter-spacing: -0.02em; margin-bottom: 32px; }
  .browse-tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; }
  .browse-tile { display: block; padding: 32px 28px; background: var(--char); color: white; text-decoration: none; transition: background 0.18s; }
  .browse-tile:hover { background: var(--brand-red); }
  .tile-eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.55); margin-bottom: 12px; }
  .tile-name { font-size: 22px; font-weight: 800; letter-spacing: -0.01em; margin-bottom: 8px; line-height: 1.2; }
  .tile-meta { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.6); }
  /* MARKETING STAT ROW · §8 */
  .mkt-stats { background: var(--char); padding: 48px; border-top: 1px solid rgba(255,255,255,0.06); }
  .mkt-stats-inner { max-width: 1680px; margin: 0 auto; display: grid; grid-template-columns: repeat(6, 1fr); gap: 32px; }
  .mkt-stat { text-align: left; }
  .mn { font-size: 36px; font-weight: 900; letter-spacing: -0.02em; color: white; margin-bottom: 4px; }
  .ml { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.55); }
  /* FEATURED FAMILIES · §9 */
  .featured { padding: 80px 48px; max-width: 1680px; margin: 0 auto; }
  .featured-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; margin-top: 40px; }
  .family-card { display: block; padding: 32px 28px 28px; background: var(--paper); text-decoration: none; color: var(--ink); transition: background 0.18s; }
  .family-card:hover { background: var(--paper-2); }
  .fc-eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(28,32,37,0.55); margin-bottom: 20px; }
  .fc-tier { color: var(--brand-red); font-weight: 700; }
  .fc-art { width: 100%; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; color: rgba(28,32,37,0.35); margin-bottom: 20px; }
  .fc-art svg { width: 80%; height: 80%; }
  .fc-name { font-size: 22px; font-weight: 800; letter-spacing: -0.01em; margin-bottom: 8px; }
  .fc-meta { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(28,32,37,0.65); margin-bottom: 20px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .dlc-chip { display: inline-block; padding: 3px 8px; background: var(--ink); color: white; font-size: 9px; letter-spacing: 0.12em; border-radius: 1px; }
  .fc-cta { font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand-red); }
  /* ALL DRIVERS GRID · §10/§13 */
  .all-families { padding: 80px 48px; max-width: 1680px; margin: 0 auto; }
  .af-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; flex-wrap: wrap; gap: 16px; }
  .af-h2 { font-size: 36px; font-weight: 900; letter-spacing: -0.02em; }
  .af-sub { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,32,37,0.65); }
  .af-filter-rail { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; }
  .af-chip { display: inline-flex; align-items: center; padding: 8px 14px; background: var(--paper); font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink); border: 1px solid var(--rule-strong); cursor: pointer; transition: 0.15s; }
  .af-chip:hover, .af-chip.active { background: var(--ink); color: white; border-color: var(--ink); }
  .af-body { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; }
  /* ADDERS BAND · §11 */
  .adders-band { background: var(--char); color: white; padding: 80px 48px; }
  .adders-inner { max-width: 1680px; margin: 0 auto; }
  .adders-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; margin-top: 40px; }
  .adder-card { padding: 36px 32px; background: rgba(255,255,255,0.04); }
  .adder-code { font-family: 'JetBrains Mono', monospace; font-size: 28px; font-weight: 700; color: var(--brand-red); margin-bottom: 12px; letter-spacing: 0.04em; }
  .adder-name { font-size: 22px; font-weight: 800; margin-bottom: 8px; }
  .adder-desc { font-size: 14px; line-height: 1.55; color: rgba(255,255,255,0.75); }
  /* VERTICALS BAND · §12 */
  .verticals-band { padding: 80px 48px; max-width: 1680px; margin: 0 auto; }
  .verticals-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; margin-top: 40px; }
  .vertical-tile { padding: 32px 24px; background: var(--char); color: white; text-decoration: none; aspect-ratio: 4/3; position: relative; overflow: hidden; transition: background 0.18s; }
  .vertical-tile:hover { background: var(--brand-red); }
  .vt-num { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.5); margin-bottom: 20px; }
  .vt-name { font-size: 22px; font-weight: 800; letter-spacing: -0.01em; margin-bottom: 8px; line-height: 1.15; }
  .vt-skus { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.6); position: absolute; bottom: 24px; left: 24px; right: 24px; }
  /* LEGACY · §15 */
  .legacy-band { background: var(--paper); padding: 56px 48px; border-top: 1px solid var(--rule); }
  .legacy-inner { max-width: 1680px; margin: 0 auto; }
  .legacy-h3 { font-size: 24px; font-weight: 800; margin-bottom: 12px; }
  .legacy-p { font-size: 15px; color: rgba(28,32,37,0.85); margin-bottom: 20px; max-width: 720px; }
  .legacy-cta { font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand-red); text-decoration: none; border-bottom: 1px solid var(--brand-red); padding-bottom: 2px; }
  /* GET STARTED · §16 */
  .get-started { padding: 80px 48px; max-width: 1680px; margin: 0 auto; }
  .gs-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 40px; }
  .gs-card { padding: 36px 28px; border: 1px solid var(--rule); text-align: left; }
  .gs-icon { font-size: 28px; color: var(--brand-red); margin-bottom: 16px; line-height: 1; }
  .gs-h { font-size: 18px; font-weight: 800; margin-bottom: 10px; }
  .gs-p { font-size: 13px; line-height: 1.55; color: rgba(28,32,37,0.8); margin-bottom: 16px; }
  .gs-link { font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand-red); text-decoration: none; }
  /* PAIRS WITH HOST COLLECTIONS · §17 */
  .pairs-band { background: var(--char); color: white; padding: 64px 48px; }
  .pairs-inner { max-width: 1680px; margin: 0 auto; }
  .pairs-eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.6); margin-bottom: 16px; }
  .pairs-h2 { font-size: 36px; font-weight: 900; letter-spacing: -0.02em; line-height: 1.1; margin-bottom: 16px; max-width: 800px; }
  .pairs-p { font-size: 16px; line-height: 1.55; max-width: 720px; color: rgba(255,255,255,0.8); margin-bottom: 28px; }
  .pairs-cta { display: inline-block; padding: 14px 28px; background: var(--brand-red); color: white; font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none; }
  /* RELATED COLLECTIONS · §18 */
  .related { padding: 80px 48px; max-width: 1680px; margin: 0 auto; }
  .related-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 40px; }
  .related-card { padding: 28px 24px; background: var(--paper); text-decoration: none; color: var(--ink); transition: background 0.18s; }
  .related-card:hover { background: var(--paper-2); }
  .rc-eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(28,32,37,0.65); margin-bottom: 12px; }
  .rc-name { font-size: 26px; font-weight: 900; letter-spacing: -0.02em; margin-bottom: 12px; }
  .rc-desc { font-size: 14px; line-height: 1.5; color: rgba(28,32,37,0.85); margin-bottom: 16px; }
  .rc-link { font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand-red); }
  /* STICKY ANCHOR RAIL · §19 */
  .anchor-rail { position: fixed; right: 20px; top: 50%; transform: translateY(-50%); display: flex; flex-direction: column; gap: 14px; z-index: 30; }
  .ar-dot { width: 9px; height: 9px; border-radius: 50%; background: rgba(28,32,37,0.25); cursor: pointer; transition: 0.18s; position: relative; }
  .ar-dot:hover { background: var(--brand-red); transform: scale(1.4); }
  .ar-dot::before {
    content: attr(data-label); position: absolute; right: 20px; top: 50%; transform: translateY(-50%);
    background: var(--ink); color: white; padding: 6px 10px; font-family: 'JetBrains Mono', monospace;
    font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; white-space: nowrap;
    opacity: 0; pointer-events: none; transition: opacity 0.15s;
  }
  .ar-dot:hover::before { opacity: 1; }
  /* BOTTOM CTA BAND · §20 */
  .bottom-cta { background: var(--paper-2); padding: 48px 48px; }
  .bottom-cta-inner { max-width: 1680px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; gap: 32px; flex-wrap: wrap; }
  .bottom-cta p { font-size: 18px; font-weight: 700; max-width: 640px; }
  .bottom-cta-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn { display: inline-block; padding: 14px 28px; font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none; transition: 0.18s; }
  .btn-primary { background: var(--brand-red); color: white; }
  .btn-primary:hover { background: #c41e32; }
  .btn-outline { border: 2px solid var(--ink); color: var(--ink); }
  .btn-outline:hover { background: var(--ink); color: white; }
  /* RESPONSIVE */
  @media (max-width: 1200px) {
    .quick-stats-inner { grid-template-columns: repeat(2, 1fr); }
    .mkt-stats-inner { grid-template-columns: repeat(3, 1fr); }
    .featured-grid, .af-body { grid-template-columns: repeat(2, 1fr); }
    .related-grid, .gs-grid { grid-template-columns: repeat(2, 1fr); }
    .verticals-grid { grid-template-columns: repeat(2, 1fr); }
    .adders-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 768px) {
    .hero h1 { font-size: 56px; }
    .browse-tiles { grid-template-columns: 1fr 1fr; }
    .quick-stats-inner, .mkt-stats-inner, .featured-grid, .af-body, .related-grid, .gs-grid, .verticals-grid { grid-template-columns: 1fr; }
    .anchor-rail { display: none; }
    .hero, .browse-section, .featured, .all-families, .verticals-band, .get-started, .related { padding-left: 24px; padding-right: 24px; }
    .mkt-stats, .adders-band, .legacy-band, .pairs-band, .bottom-cta { padding-left: 24px; padding-right: 24px; }
    .breadcrumb { padding-left: 24px; padding-right: 24px; }
  }
  @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
</style>

<main id="main">
  <!-- §4 · BREADCRUMB · 4-seg hierarchical per James 2026-05-27 -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">HOME</a>
    <span class="sep">›</span>
    <a href="/collections">PRODUCTS</a>
    <span class="sep">›</span>
    <a href="/solutions/safety-controls/">SAFETY &amp; CONTROLS</a>
    <span class="sep">›</span>
    <a href="/collections/constant/">CONST<span class="aa">Ⓐ</span>NT</a>
  </nav>

  <!-- §5 · HERO BAND -->
  <section class="hero" id="overview">
    <div class="hero-eyebrow">SAFETY &amp; CONTROLS · EMERGENCY DRIVER COLLECTION</div>
    <h1>const<span class="aa">Ⓐ</span>NT</h1>
    <p class="hero-desc">Emergency battery backup drivers for every fixture family in the ALG line. UL 924 listed. Universal 100–347Vac input. Four install tiers, three power classes, three optional adders, eight verticals.</p>
    <div class="hero-chips">
      <span class="chip chip-accent">UL 924 Listed</span>
      <span class="chip">100–347Vac Universal</span>
      <span class="chip">90-min Runtime</span>
      <span class="chip">5-Year Warranty</span>
      <span class="chip">Title 24 NLC-Ready</span>
    </div>
  </section>

  <!-- §6 · QUICK STAT GRID (4-up) -->
  <section class="quick-stats" id="quick-stats">
    <div class="quick-stats-inner">
      <div>
        <div class="qs-num">17</div>
        <div class="qs-label">Active Driver SKUs</div>
      </div>
      <div>
        <div class="qs-num">4</div>
        <div class="qs-label">Install Tiers</div>
      </div>
      <div>
        <div class="qs-num">8</div>
        <div class="qs-label">Verticals Served</div>
      </div>
      <div>
        <div class="qs-num">UL 924</div>
        <div class="qs-label">Listed (Not Recognized)</div>
      </div>
    </div>
  </section>

  <!-- §7 · BROWSE BY INSTALL TIER -->
  <section class="browse-section" id="install-tiers">
    <div class="section-eyebrow">BROWSE BY INSTALL TIER</div>
    <h2 class="section-h2">Four ways to install. One driver ecosystem.</h2>
    <div class="browse-tiles">
      <a class="browse-tile" href="#factory-install">
        <div class="tile-eyebrow">TIER 1 · FACTORY</div>
        <div class="tile-name">Factory-Install</div>
        <div class="tile-meta">Ships pre-wired in host fixture</div>
      </a>
      <a class="browse-tile" href="#field-install">
        <div class="tile-eyebrow">TIER 2 · FIELD</div>
        <div class="tile-name">Field-Install</div>
        <div class="tile-meta">Mounts to fixture chassis on-site</div>
      </a>
      <a class="browse-tile" href="#quick-install">
        <div class="tile-eyebrow">TIER 3 · QUICK</div>
        <div class="tile-name">Quick-Install</div>
        <div class="tile-meta">J-Box retrofit, no ceiling teardown</div>
      </a>
      <a class="browse-tile" href="#safety-emergency">
        <div class="tile-eyebrow">TIER 4 · SAFETY</div>
        <div class="tile-name">Safety &amp; Emergency</div>
        <div class="tile-meta">Dedicated egress fixtures</div>
      </a>
    </div>
  </section>

  <!-- §7.5 · BROWSE BY PRODUCT TYPE (J.2 — 5 tiles, 4 stub-routed) -->
  <section class="browse-section" id="product-types">
    <div class="section-eyebrow">BROWSE BY PRODUCT TYPE</div>
    <h2 class="section-h2">Five product groups across the const<span class="aa">Ⓐ</span>NT line.</h2>
    <div class="browse-tiles" style="grid-template-columns: repeat(5, 1fr);">
      <a class="browse-tile" href="#all-drivers">
        <div class="tile-eyebrow">LIVE · 17 SKUS</div>
        <div class="tile-name">Emergency Battery Backup</div>
        <div class="tile-meta">EM &amp; CRC driver line · UL 924</div>
      </a>
      <a class="browse-tile" href="/collections/constant/em-batteries/" style="opacity: 0.85;">
        <div class="tile-eyebrow">COMING SOON</div>
        <div class="tile-name">const<span class="aa">Ⓐ</span>NTLink EM Batteries</div>
        <div class="tile-meta">Networked NLC battery line · notify me →</div>
      </a>
      <a class="browse-tile" href="/collections/constant/exit-signs/" style="opacity: 0.85;">
        <div class="tile-eyebrow">COMING SOON</div>
        <div class="tile-name">Exit Signs</div>
        <div class="tile-meta">UL 924 listed · notify me →</div>
      </a>
      <a class="browse-tile" href="/collections/constant/combo-signs/" style="opacity: 0.85;">
        <div class="tile-eyebrow">COMING SOON</div>
        <div class="tile-name">Combo Signs</div>
        <div class="tile-meta">Exit + emergency in one unit · notify me →</div>
      </a>
      <a class="browse-tile" href="/collections/constant/emergency-lights/" style="opacity: 0.85;">
        <div class="tile-eyebrow">COMING SOON</div>
        <div class="tile-name">Emergency Lights</div>
        <div class="tile-meta">2-head · 4-head · remote-capable · notify me →</div>
      </a>
    </div>
  </section>

  <!-- §8 · MARKETING STAT ROW (6-up dark band) -->
  <section class="mkt-stats">
    <div class="mkt-stats-inner">
      <div class="mkt-stat"><div class="mn">17</div><div class="ml">Active Drivers</div></div>
      <div class="mkt-stat"><div class="mn">4</div><div class="ml">Install Tiers</div></div>
      <div class="mkt-stat"><div class="mn">8</div><div class="ml">Verticals</div></div>

---
/**
 * collections/constant/combo-signs/index.astro
 * Combo Signs — Coming Soon stub
 * CFG-CHROME-1: No inlined chrome. BaseLayout provides shell.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Combo Signs — Coming Soon | constANT | Archipelago Lighting Group"
  description="Exit sign + emergency light in one unit from the constANT line. Coming soon."
  bodyClass="page-constant-stub"
>
<style>
  :root { --brand-red: #F32740; --ink: #15181c; --char: #1c2025; --paper: #FAF8F4; --paper-2: #F1ECE3; --rule: rgba(28,32,37,0.10); }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  .aa { color: var(--brand-red); font-weight: 700; margin: 0 -0.04em; }
  .breadcrumb { padding: 32px 48px 16px; max-width: 1680px; margin: 0 auto; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,32,37,0.65); }
  .breadcrumb a { color: rgba(28,32,37,0.85); text-decoration: none; border-bottom: 1px solid transparent; transition: border-color 0.15s; }
  .breadcrumb a:hover { border-bottom-color: var(--brand-red); }
  .breadcrumb .sep { margin: 0 8px; color: rgba(28,32,37,0.35); }
  .stub-hero { padding: 48px 48px 80px; max-width: 1680px; margin: 0 auto; }
  .stub-eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(28,32,37,0.65); margin-bottom: 24px; }
  .stub-h1 { font-size: 72px; font-weight: 900; letter-spacing: -0.025em; line-height: 0.95; margin-bottom: 24px; }
  .stub-desc { font-size: 18px; line-height: 1.55; max-width: 720px; color: rgba(28,32,37,0.85); margin-bottom: 40px; }
  .chip-row { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 48px; }
  .chip { display: inline-flex; align-items: center; padding: 8px 16px; background: var(--paper-2); font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink); }
  .notify-card { max-width: 520px; background: var(--paper); padding: 40px; border: 1px solid var(--rule); }
  .notify-h { font-size: 22px; font-weight: 800; margin-bottom: 8px; }
  .notify-p { font-size: 14px; color: rgba(28,32,37,0.75); margin-bottom: 24px; line-height: 1.5; }
  .notify-form { display: flex; gap: 8px; flex-wrap: wrap; }
  .notify-input { flex: 1; min-width: 200px; padding: 12px 16px; border: 1px solid rgba(28,32,37,0.25); font-size: 14px; font-family: 'Lato', sans-serif; background: white; }
  .notify-btn { padding: 12px 24px; background: var(--brand-red); color: white; font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; border: none; cursor: pointer; }
  .notify-btn:hover { background: #c41e32; }
  .back-link { display: inline-flex; align-items: center; gap: 8px; margin-top: 40px; font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand-red); text-decoration: none; }
  @media (max-width: 768px) { .stub-h1 { font-size: 48px; } .stub-hero, .breadcrumb { padding-left: 24px; padding-right: 24px; } }
</style>

<main id="main">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">HOME</a>
    <span class="sep">›</span>
    <a href="/collections">PRODUCTS</a>
    <span class="sep">›</span>
    <a href="/solutions/safety-controls/">SAFETY &amp; CONTROLS</a>
    <span class="sep">›</span>
    <a href="/collections/constant/">CONST<span class="aa">Ⓐ</span>NT</a>
    <span class="sep">›</span>
    <span>COMBO SIGNS</span>
  </nav>

  <section class="stub-hero">
    <div class="stub-eyebrow">SAFETY &amp; CONTROLS · COMBO SIGNS</div>
    <h1 class="stub-h1">Combo Signs</h1>
    <p class="stub-desc">Exit sign and emergency light in a single unit. One SKU, one installation, two code requirements met. UL 924 listed. Coming soon from the const<span class="aa">Ⓐ</span>NT line.</p>
    <div class="chip-row">
      <span class="chip">UL 924 Listed</span>
      <span class="chip">Exit + Emergency</span>
      <span class="chip">Single-Unit Install</span>
      <span class="chip">90-Min Runtime</span>
    </div>
    <div class="notify-card">
      <div class="notify-h">Notify me when available</div>
      <p class="notify-p">Combo Signs from the const<span class="aa">Ⓐ</span>NT line are in development. Leave your email and we'll reach out when they're ready to order.</p>
      <form class="notify-form" action="mailto:sales@archipelagolighting.com" method="get" enctype="text/plain">
        <input class="notify-input" type="email" name="email" placeholder="your@email.com" required aria-label="Email address" />
        <button class="notify-btn" type="submit">NOTIFY ME</button>
      </form>
    </div>
    <a class="back-link" href="/collections/constant/">← BACK TO CONST<span class="aa">Ⓐ</span>NT</a>
  </section>
</main>
</BaseLayout>

---
/**
 * contrⒶLS collection page — Astro wrapper
 * Route: /collections/controls/
 *
 * CFG-CHROME-1: BaseLayout injects site header + footer.
 * CFG-CHROME-4: Scroll-hide mega-menu — attached to inner scroll container
 *               (window.scrollY stays 0 on this page; scroll is on .contrals-pdp-host).
 * CFG-CHROME-2: [bundle] error band suppressed in prod (handled in controls-bundle.html).
 * CFG-TYPE-1: Lato + JetBrains Mono pinned via head slot style blocks.
 * §D.1: 4-segment canonical breadcrumb injected before React app body.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';

// Bundle HTML lives in src/data/controls/ — NOT in src/pages/ (Astro would try to build it as a route)
// and NOT in public/ (Cloudflare would serve it as a static file, bypassing this Astro wrapper).
const bundleHtml = readFileSync(
  path.join(process.cwd(), 'src/data/controls/controls-bundle.html'),
  'utf-8'
);

// Extract body content (data + JSX render scripts)
const bodyMatch = bundleHtml.match(/<body[^>]*>([\s\S]*)<\/body>/i);
const bodyContent = bodyMatch ? bodyMatch[1] : bundleHtml;

// Extract all <style> and <script> blocks from <head>
const headMatch = bundleHtml.match(/<head[^>]*>([\s\S]*?)<\/head>/i);
const headContent = headMatch ? headMatch[1] : '';
const styleBlocks = [...headContent.matchAll(/<style[^>]*>[\s\S]*?<\/style>/gi)]
  .map(m => m[0]).join('\n');
const scriptBlocks = [...headContent.matchAll(/<script[^>]*>[\s\S]*?<\/script>/gi)]
  .map(m => m[0]).join('\n');
// Extract Google Fonts link tags
const fontLinks = [...headContent.matchAll(/<link[^>]*fonts\.googleapis\.com[^>]*>/gi)]
  .map(m => m[0]).join('\n');
const fontPreconnects = [...headContent.matchAll(/<link[^>]*rel="preconnect"[^>]*>/gi)]
  .map(m => m[0]).join('\n');
---
<BaseLayout
  title="contrⒶLS · Three Protocol Tiers — Archipelago Lighting Group"
  description="contrⒶLS lighting controls — ⒶCS BLE mesh, SILVAIR enterprise NLC, and BLS bi-level standalone. 32 SKUs, DLC NLC qualified, 30–60% energy savings."
  bodyClass="contrals-page-body"
>
  <Fragment slot="head">
    <Fragment set:html={fontPreconnects} />
    <Fragment set:html={fontLinks} />
    <Fragment set:html={styleBlocks} />
    <Fragment set:html={scriptBlocks} />
  <style>
    /* §D.1 breadcrumb-band — contrⒶLS */
    .breadcrumb-band {
      padding: 10px 32px;
      font-family: 'JetBrains Mono', monospace !important;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      font-weight: 500;
      text-transform: uppercase;
      color: #666;
      background: var(--bg2, #f5f5f3);
      border-bottom: 1px solid rgba(0,0,0,0.06);
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .breadcrumb-band a { color: #666; text-decoration: none; }
    .breadcrumb-band a:hover { color: var(--color-alg-red, #F32740); }
    .bc-sep { color: #c8ccd3; }
    .bc-current { color: #000; font-weight: 600; }
    .bc-current .aa { color: var(--color-alg-red, #F32740); }
    .aa { color: var(--color-alg-red, #F32740); }
    /* CFG-TYPE-1 · Lato + JetBrains Mono pin — defeat Sora/Cormorant cascade */
    .contrals-pdp-host * {
      font-family: 'Lato', system-ui, -apple-system, sans-serif !important;
    }
    .contrals-pdp-host [class*="font-mono"],
    .contrals-pdp-host .mono,
    .contrals-pdp-host code,
    .contrals-pdp-host pre,
    .contrals-pdp-host [style*="JetBrains"],
    .contrals-pdp-host [style*="font-mono"],
    .contrals-pdp-host [style*="monospace"] {
      font-family: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace !important;
    }
  </style>
  </Fragment>
  <!-- §D.1 · 4-segment canonical breadcrumb -->
  <div class="breadcrumb-band">
    <a href="/">HOME</a>
    <span class="bc-sep">›</span>
    <span>PRODUCTS</span>
    <span class="bc-sep">›</span>
    <a href="/collections/safety-controls/">SAFETY &amp; CONTROLS</a>
    <span class="bc-sep">›</span>
    <span class="bc-current">CONTR<span class="aa">Ⓐ</span>LS</span>
  </div>
  <div class="contrals-pdp-host">
    <Fragment set:html={bodyContent} />
  </div>
  <!-- CFG-CHROME-4 · scroll-hide mega-menu on inner container scroll -->
  <script is:inline>
    (function () {
      // contrⒶLS scrolls an inner container (.contrals-pdp-host), not window.
      // Attach the hide/show listener to the actual scroll container.
      function attachScrollHide() {
        const header = document.getElementById('site-header');
        if (!header) return;
        // Find the inner scroll container — either .contrals-pdp-host or #root
        const scrollEl = document.querySelector('.contrals-pdp-host') || document.querySelector('#root');
        if (!scrollEl) {
          // Fallback: try window (in case the inner container isn't scrollable)
          return;
        }
        // Check if the element is actually scrollable
        const style = window.getComputedStyle(scrollEl);
        const isScrollable = style.overflow === 'auto' || style.overflow === 'scroll' ||
                             style.overflowY === 'auto' || style.overflowY === 'scroll';
        const target = isScrollable ? scrollEl : window;

        header.style.transition = 'transform 0.25s ease-out';
        let lastY = 0;
        let hidden = false;

        target.addEventListener('scroll', function () {
          const y = target === window ? window.scrollY : target.scrollTop;
          const delta = y - lastY;
          if (y <= 0) {
            header.style.transform = 'translateY(0)';
            hidden = false;
          } else if (delta > 5 && !hidden) {
            header.style.transform = 'translateY(-100%)';
            hidden = true;
          } else if (delta < -5 && hidden) {
            header.style.transform = 'translateY(0)';
            hidden = false;
          }
          lastY = y;
        }, { passive: true });
      }

      // Wait for the React app to finish rendering (bundle unpack is async)
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () {
          // Give the bundle unpack a moment to complete
          setTimeout(attachScrollHide, 2000);
        });
      } else {
        setTimeout(attachScrollHide, 2000);
      }
    })();
  </script>
</BaseLayout>

---
/**
 * contrⒶLS collection page — Astro wrapper
 * Route: /collections/controls/
 *
 * CFG-CHROME-1: BaseLayout injects site header + footer.
 * CFG-CHROME-ASTRO: Bundle loader patched to check for #contrals-pdp-host.
 *   When found, renders into the host div instead of replacing document.documentElement.
 *   This preserves the canonical site header and footer.
 * CFG-TYPE-1: Lato + JetBrains Mono pinned.
 * §D.1: 4-segment canonical breadcrumb injected before the host div.
 *
 * Architecture: The contrⒶLS React bundle uses document.documentElement.replaceWith()
 * in standalone mode. When #contrals-pdp-host is present (Astro mode), it renders
 * into that div instead. The bundle is injected inline via Fragment set:html.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { readFileSync } from 'fs';
import { join } from 'path';

// Read the bundle HTML and extract only the body content (the loader + data scripts)
// The bundle's <head> styles/meta are handled by BaseLayout; we only need the <body>
const bundlePath = join(process.cwd(), 'src/data/controls/controls-bundle.html');
const bundleHtml = readFileSync(bundlePath, 'utf-8');

// Extract body content from the bundle
const bodyMatch = bundleHtml.match(/<body[^>]*>([\s\S]*)<\/body>/i);
const bundleBodyContent = bodyMatch ? bodyMatch[1] : '';

// Extract head styles from the bundle (for injection into BaseLayout head slot)
const headStyleMatches = bundleHtml.match(/<style[\s\S]*?<\/style>/gi) || [];
const bundleHeadStyles = headStyleMatches.join('\n');
---
<BaseLayout
  title="contrⒶLS · Three Protocol Tiers — Archipelago Lighting Group"
  description="contrⒶLS lighting controls — ⒶCS BLE mesh, SILVAIR enterprise NLC, and BLS bi-level standalone. 32 SKUs, DLC NLC qualified, 30–60% energy savings."
  bodyClass="contrals-page-body"
>
  <Fragment slot="head">
    <!-- Bundle head styles injected for React app CSS -->
    <Fragment set:html={bundleHeadStyles} />
    <style>
      /* §D.1 breadcrumb-band — contrⒶLS */
      .breadcrumb-band {
        padding: 10px 32px;
        font-family: 'JetBrains Mono', monospace !important;
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        font-weight: 500;
        text-transform: uppercase;
        color: #666;
        background: var(--bg2, #f5f5f3);
        border-bottom: 1px solid rgba(0,0,0,0.06);
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
      }
      .breadcrumb-band a { color: #666; text-decoration: none; }
      .breadcrumb-band a:hover { color: var(--color-alg-red, #F32740); }
      .bc-sep { color: #c8ccd3; }
      .bc-current { color: #000; font-weight: 600; }
      .bc-current .aa { color: var(--color-alg-red, #F32740); }
      .aa { color: var(--color-alg-red, #F32740); }
      /* contrⒶLS host container — CFG-CLIP-FIX: overflow visible so content past 1vh renders */
      #contrals-pdp-host {
        width: 100%;
        min-height: calc(100vh - 112px);
        position: relative;
        overflow: visible;
      }
    </style>
  </Fragment>

  <!-- §D.1 · 4-segment canonical breadcrumb -->
  <div class="breadcrumb-band">
    <a href="/">HOME</a>
    <span class="bc-sep">›</span>
    <span>PRODUCTS</span>
    <span class="bc-sep">›</span>
    <a href="/collections/safety-controls/">SAFETY &amp; CONTROLS</a>
    <span class="bc-sep">›</span>
    <span class="bc-current">CONTR<span class="aa">Ⓐ</span>LS</span>
  </div>

  <!-- contrⒶLS React app host — bundle loader renders into this div (Astro mode)
       The patched loader checks for #contrals-pdp-host and renders here instead
       of replacing document.documentElement. -->
  <div id="contrals-pdp-host">
    <!-- Bundle body content: splash screen, loader script, manifest, template -->
    <Fragment set:html={bundleBodyContent} />
  </div>
<style is:global>
  /* CFG-EYEBROW-1 · tighten Ⓐ glyph in heavy-tracked .marker eyebrows only */
  .marker .aa { letter-spacing: 0 !important; margin: 0 -0.9em !important; }
  /* CFG-CLIP-FIX · standalone-mockup scaffold leaks — stop vertical clip
     The React bundle mounts into #root; the scaffold may set height:100vh on it
     (confirmed live: computed height 986px = 1 viewport, content 7,754px).
     Force height:auto so #root grows with its content. */
  #root { min-height: 100vh; height: auto !important; }
  /* Belt-and-suspenders: also ensure the Astro host wrapper never clips */
  #contrals-pdp-host { overflow: visible !important; }
</style>
</BaseLayout>

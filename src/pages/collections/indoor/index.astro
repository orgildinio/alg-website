---
/**
 * products/indoor/index.astro
 * Indoor Commercial & Industrial Landing Page
 *
 * Directs to lamparⒶRCH (industrial) and planoⒶRCH (flat-ceiling architectural).
 * Ported from indoor/landing-v3.jsx + landing-shared.jsx.
 *
 * Calibration patches applied:
 *   --brand #E3353C → var(--color-alg-red) #F32740
 *   --brand-dark #B0252B → var(--color-alg-red-dark) #C41E32
 *   --font-sans 'Sora' → var(--font-sans) 'Lato'
 *   --ink #1A1D23 → var(--color-ink) #111111
 *   --ink2 #3A3E47 → var(--color-ink-soft) #444444
 *   --ink3 #6B7280 → var(--color-ink-mute) #6B6B6B
 *   --c1 #F5F4F1 → var(--color-bg-soft) #F7F7F7
 *   --c2 #EEEDF0 → var(--color-bg-strong) #F0F0F0
 *   --c3 #DCDEE2 → var(--color-border) #E5E5E5
 *   --yellow #FDD85E → #F5C24A (site yellow)
 *   UtilityBar/site chrome stripped (BaseLayout provides Header/Footer)
 *   Page-local footer strip stripped (BaseLayout Footer handles copyright)
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Indoor Commercial & Industrial Lighting · lamparⒶRCH × planoⒶRCH · ALG"
  description="ALG's two indoor collections — lamparⒶRCH industrial workhorse and planoⒶRCH flat-ceiling architectural — cover every commercial ceiling we ship to. DLC Premium. 7-year warranty."
  bodyClass="page-indoor-landing"
>

<style>
  /* ── Token bridge: map source JSX vars to site tokens ── */
  .indoor-landing {
    --brand:       var(--color-alg-red);
    --brand-dark:  var(--color-alg-red-dark);
    --ink:         var(--color-ink);
    --ink2:        var(--color-ink-soft);
    --ink3:        var(--color-ink-mute);
    --c1:          var(--color-bg-soft);
    --c2:          var(--color-bg-strong);
    --c3:          var(--color-border);
    --yellow:      #F5C24A;
    --font-sans:   var(--font-sans, 'Lato', system-ui, sans-serif);
    --font-mono:   'JetBrains Mono', ui-monospace, 'SF Mono', Consolas, monospace;

    width: 100%;
    background: #fff;
    font-family: var(--font-sans);
    color: var(--ink);
  }

  /* ── Breadcrumb band ── */
  .breadcrumb-band {
    padding: 12px 56px;
    border-bottom: 1px solid var(--color-border);
    background: #fff;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--color-ink-mute);
    display: flex;
    align-items: center;
    gap: 0;
  }
  .breadcrumb-band a { color: inherit; text-decoration: none; }
  .breadcrumb-band a:hover { color: var(--color-alg-red); }
  .bc-sep { margin: 0 10px; }
  .bc-current { color: var(--color-ink); font-weight: 700; }

  /* ── Eyebrow ── */
  .eyebrow {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--color-ink-mute);
  }
  .eyebrow--yellow { color: #F5C24A; }
  .eyebrow--brand  { color: var(--color-alg-red); }
  .eyebrow--faint  { color: rgba(255,255,255,.55); }

  /* ── MarkA (collection name with red Ⓐ) ── */
  .mark-a .a-enc { color: var(--color-alg-red); }

  /* ── Stat block ── */
  .stat-block {
    padding: 14px 16px;
    border-left: 3px solid var(--color-alg-red);
    background: var(--color-bg-soft);
  }
  .stat-block .sv {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.05;
    white-space: nowrap;
    color: var(--color-ink);
  }
  .stat-block .sk {
    margin-top: 6px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--color-ink-mute);
  }

  /* ── Hero ── */
  .hero-section {
    display: grid;
    grid-template-columns: 120px 1fr;
    min-height: 540px;
    border-bottom: 1px solid var(--color-border);
  }
  .hero-accent-bar {
    background: var(--color-alg-red);
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: 24px 0;
  }
  .hero-accent-label {
    transform: rotate(-90deg);
    transform-origin: bottom left;
    position: absolute;
    bottom: 36px;
    left: 56px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .32em;
    text-transform: uppercase;
    color: #fff;
    white-space: nowrap;
  }
  .hero-accent-dot {
    position: absolute;
    top: 28px;
    left: 28px;
    width: 12px;
    height: 12px;
    background: #F5C24A;
  }
  .hero-content {
    padding: 72px 56px 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero-h1 {
    font-family: var(--font-sans); /* v27x: canonical sans — overrides global h1 serif */
    font-style: normal;
    margin: 18px 0 0;
    font-size: 80px;
    line-height: 0.98;
    letter-spacing: -.025em;
    font-weight: 800;
  }
  .hero-h1 .x-sep {
    color: var(--color-ink-mute);
    margin: 0 16px;
    font-weight: 300;
  }
  .hero-deck {
    margin-top: 24px;
    font-size: 17px;
    line-height: 1.55;
    color: var(--color-ink-soft);
    max-width: 880px;
  }
  .hero-stats {
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(4, max-content);
    gap: 14px;
  }

  /* ── Application Finder ── */
  .app-finder {
    background: var(--color-ink);
    color: #fff;
    padding: 32px 56px;
  }
  .app-finder-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .app-finder-q {
    margin-top: 18px;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -.005em;
    max-width: 920px;
  }
  .app-chips {
    margin-top: 22px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .app-chip {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 10px 16px;
    border: 1px solid rgba(255,255,255,.18);
    background: transparent;
    color: rgba(255,255,255,.85);
    white-space: nowrap;
  }
  .app-chip .chip-target { margin-left: 10px; opacity: 0.6; font-size: 10px; }
  /* ApplicationFinder interactive states */
  .app-chip { cursor: pointer; }
  .app-chip--active { background: var(--color-alg-red) !important; border-color: var(--color-alg-red) !important; color: #fff !important; }
  .app-chip--active .chip-target { opacity: 1; }
  .coll-card-wrap--dim { opacity: 0.35; transition: opacity .2s ease; }
  .coll-card-wrap--highlight { outline: 2px solid var(--color-alg-red); outline-offset: 2px; transition: outline .2s ease; }

  /* ── Collection cards ── */
  .collection-grid {
    padding: 40px 56px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .coll-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .coll-card-header {
    background: var(--color-ink);
    color: #fff;
    padding: 32px 36px 28px;
    position: relative;
  }
  .coll-card-header:hover {
    background: var(--color-alg-red);
  }
  .coll-name {
    margin-top: 16px;
    font-size: 56px;
    line-height: 1;
    letter-spacing: -.025em;
    font-weight: 800;
    white-space: nowrap;
  }
  .coll-name .a-enc { color: var(--color-alg-red); }
  .coll-card-header:hover .coll-name .a-enc { color: #F5C24A; }
  .coll-tagline {
    margin-top: 14px;
    font-size: 14.5px;
    line-height: 1.55;
    color: rgba(255,255,255,.85);
    max-width: 520px;
  }
  .coll-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--color-bg-soft);
  }
  .coll-stat-cell {
    padding: 16px 18px;
    border-bottom: 1px solid var(--color-border);
  }
  .coll-stat-cell:first-child { border-left: 3px solid var(--color-alg-red); }
  .coll-stat-cell + .coll-stat-cell { border-left: 1px solid var(--color-border); }
  .coll-stat-v {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.05;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .coll-stat-k {
    margin-top: 6px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9.5px;
    color: var(--color-ink-mute);
    letter-spacing: .12em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Flagship families */
  .flagship-block {
    background: #fff;
    border: 1px solid var(--color-border);
    border-top: none;
    padding: 20px 36px 14px;
  }
  .cat-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 6px;
    border-bottom: 2px solid var(--color-ink);
  }
  .cat-bar-title {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .cat-bar-tag {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--color-ink-mute);
  }
  .flagship-grid {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
  }
  .flagship-card {
    border: 1px solid var(--color-border);
    background: #fff;
    display: flex;
    flex-direction: column;
  }
  .flagship-thumb {
    height: 76px;
    background: var(--color-bg-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    border-bottom: 1px solid var(--color-border);
  }
  .flagship-thumb svg { width: 100%; height: 100%; }
  .flagship-info { padding: 10px 12px 12px; }
  .flagship-app {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--color-ink-mute);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .flagship-name {
    margin-top: 4px;
    font-size: 14.5px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .flagship-star { color: var(--color-alg-red); font-size: 13px; }
  .flagship-stat {
    margin-top: 4px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px;
    color: var(--color-ink-soft);
    letter-spacing: .02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Family rows */
  .family-block {
    background: #fff;
    padding: 24px 36px 20px;
    border: 1px solid var(--color-border);
    border-top: none;
  }
  .family-row {
    display: grid;
    grid-template-columns: 64px 96px 1fr auto;
    gap: 16px;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-bg-strong);
  }
  .family-thumb {
    width: 56px;
    height: 40px;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .family-thumb svg { width: 100%; height: 100%; }
  .family-code {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: .08em;
    color: var(--color-alg-red);
  }
  .family-name {
    font-size: 13.5px;
    font-weight: 600;
    margin-top: 2px;
    color: var(--color-ink);
  }
  .family-spec {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11.5px;
    color: var(--color-ink-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .family-spec .tier { color: var(--color-ink); }
  .family-spec .sep  { color: var(--color-ink-mute); margin: 0 8px; }
  .badge-active {
    display: inline-block;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    padding: 2px 8px;
    background: #0FAE7C;
    color: #fff;
    white-space: nowrap;
  }

  /* CTA bar */
  .coll-cta {
    background: var(--color-alg-red);
    color: #fff;
    padding: 20px 36px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    transition: background .15s ease;
  }
  .coll-cta:hover { background: var(--color-alg-red-dark); color: #fff; }
  .coll-cta-label {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .coll-cta-url {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11.5px;
    color: rgba(255,255,255,.85);
    letter-spacing: .06em;
  }

  /* ── Why ALG ── */
  .why-section {
    padding: 40px 56px 56px;
    background: var(--color-bg-soft);
  }
  .why-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .why-h2 {
    margin-top: 12px;
    font-size: 36px;
    font-weight: 800;
    letter-spacing: -.01em;
    line-height: 1.08;
    max-width: 940px;
  }
  .why-tiles {
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .why-tile {
    padding: 24px 28px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-alg-red);
    position: relative;
  }
  .why-tile + .why-tile { margin-left: -1px; }
  .why-tile-title {
    margin-top: 12px;
    font-size: 19px;
    font-weight: 700;
    line-height: 1.25;
  }
  .why-tile-body {
    margin-top: 10px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
  .field-reality {
    margin-top: 24px;
    padding: 18px 22px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-alg-red);
    display: flex;
    gap: 28px;
    align-items: center;
  }
  .field-reality-body {
    font-size: 13.5px;
    color: var(--color-ink-soft);
    line-height: 1.55;
  }

  /* ── Get Started strip ── */
  .get-started {
    padding: 40px 56px 56px;
    background: #fff;
    border-top: 1px solid var(--color-border);
  }
  .get-started-grid {
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }
  .gs-card {
    padding: 24px 28px;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-alg-red);
    display: flex;
    flex-direction: column;
  }
  .gs-card + .gs-card { margin-left: -1px; }
  .gs-glyph {
    font-size: 22px;
    color: var(--color-alg-red);
    line-height: 1;
  }
  .gs-title {
    margin-top: 14px;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.25;
  }
  .gs-body {
    margin-top: 8px;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--color-ink-soft);
    flex: 1;
  }
  .gs-link {
    margin-top: 16px;
    display: inline-block;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--color-alg-red);
    text-decoration: none;
  }
  .gs-link:hover { text-decoration: underline; }

  /* ── Contact block ── */
  .contact-block {
    background: var(--color-ink);
    color: #fff;
    padding: 56px 56px;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 32px;
  }
  .contact-brand-name {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -.01em;
  }
  .contact-brand-name .a-enc { color: var(--color-alg-red); }
  .contact-desc {
    margin-top: 10px;
    font-size: 13px;
    line-height: 1.6;
    color: rgba(255,255,255,.78);
    max-width: 380px;
  }
  .contact-col-head {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: #F5C24A;
  }
  .contact-col-lines {
    margin-top: 12px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11.5px;
    color: rgba(255,255,255,.85);
    line-height: 1.85;
  }
</style>

<div class="indoor-landing">

  <!-- BREADCRUMB -->
  <nav class="breadcrumb-band" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span class="bc-sep">›</span>
    <a href="/products">Products</a>
    <span class="bc-sep">›</span>
    <span class="bc-current">Indoor</span>
    <span class="bc-sep">·</span>
    <span style="color:var(--color-ink-mute)">2 Collections · 9 Form Factors · DLC Premium</span>
  </nav>

  <!-- HERO -->
  <section class="hero-section">
    <div class="hero-accent-bar">
      <div class="hero-accent-label">Indoor · Commercial &amp; Industrial</div>
      <div class="hero-accent-dot"></div>
    </div>
    <div class="hero-content">
      <div class="eyebrow" style="font-size:11.5px">Two Collections · One Decision</div>
      <h1 class="hero-h1">
        <span class="mark-a">lampar<span class="a-enc">Ⓐ</span>RCH</span>
        <span class="x-sep">×</span>
        <span class="mark-a">plano<span class="a-enc">Ⓐ</span>RCH</span>
      </h1>
      <p class="hero-deck">
        ALG's two indoor collections — <em>industrial workhorse</em> and <em>flat-ceiling architectural</em> — cover every commercial ceiling
        we ship to. Pick by form factor, by application, or by tier. Spec-grade. DLC Premium. 7-year warranty.
      </p>
      <div class="hero-stats">
        <div class="stat-block"><div class="sv">2 Collections</div><div class="sk">lampar<span style="color:var(--color-alg-red)">Ⓐ</span>RCH · plano<span style="color:var(--color-alg-red)">Ⓐ</span>RCH</div></div>
        <div class="stat-block"><div class="sv">9 Form Factors</div><div class="sk">High Bay → Edge-Lit Troffer</div></div>
        <div class="stat-block"><div class="sv">3 Tiers</div><div class="sk">ECO · PRO · PRO+</div></div>
        <div class="stat-block"><div class="sv">DLC Premium</div><div class="sk">PRO &amp; PRO+ Standard</div></div>
      </div>
    </div>
  </section>

  <!-- APPLICATION FINDER -->
  <div class="app-finder">
    <div class="app-finder-header">
      <div class="eyebrow eyebrow--yellow" style="font-size:11.5px">Application Finder · 02</div>
      <div class="eyebrow eyebrow--faint" style="font-size:11px">Browse by application type</div>
    </div>
    <div class="app-finder-q">What is the ceiling?</div>
    <div class="app-chips">
      <div class="app-chip" data-coll="lampar" role="button" tabindex="0">Warehouse<span class="chip-target">→ lampar<span style="color:var(--color-alg-red)">Ⓐ</span></span></div>
      <div class="app-chip" data-coll="lampar" role="button" tabindex="0">Manufacturing<span class="chip-target">→ lampar<span style="color:var(--color-alg-red)">Ⓐ</span></span></div>
      <div class="app-chip" data-coll="lampar" role="button" tabindex="0">Cold-Storage<span class="chip-target">→ lampar<span style="color:var(--color-alg-red)">Ⓐ</span></span></div>
      <div class="app-chip" data-coll="plano" role="button" tabindex="0">Office<span class="chip-target">→ plano<span style="color:var(--color-alg-red)">Ⓐ</span></span></div>
      <div class="app-chip" data-coll="plano" role="button" tabindex="0">Retail<span class="chip-target">→ plano<span style="color:var(--color-alg-red)">Ⓐ</span></span></div>
      <div class="app-chip" data-coll="plano" role="button" tabindex="0">Healthcare<span class="chip-target">→ plano<span style="color:var(--color-alg-red)">Ⓐ</span></span></div>
      <div class="app-chip" data-coll="plano" role="button" tabindex="0">K-12<span class="chip-target">→ plano<span style="color:var(--color-alg-red)">Ⓐ</span></span></div>
      <div class="app-chip" data-coll="plano" role="button" tabindex="0">Higher-Ed<span class="chip-target">→ plano<span style="color:var(--color-alg-red)">Ⓐ</span></span></div>
      <div class="app-chip" data-coll="lampar" role="button" tabindex="0">Parking Garage<span class="chip-target">→ lampar<span style="color:var(--color-alg-red)">Ⓐ</span></span></div>
      <div class="app-chip" data-coll="lampar" role="button" tabindex="0">Auto-Service<span class="chip-target">→ lampar<span style="color:var(--color-alg-red)">Ⓐ</span></span></div>

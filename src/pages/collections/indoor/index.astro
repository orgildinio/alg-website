<script is:inline>
(function () {
  /* ApplicationFinder — vanilla JS chip→card highlight
     Works on any page that uses data-coll="{key}" on chips
     and data-coll-card="{key}" on card wrappers. */
  document.addEventListener('DOMContentLoaded', function () {
    var chips = document.querySelectorAll('[data-coll]');
    var cards = document.querySelectorAll('[data-coll-card]');
    if (!chips.length || !cards.length) return;

    function activate(key) {
      chips.forEach(function (c) {
        var active = c.dataset.coll === key;
        c.classList.toggle('app-chip--active', active);
        c.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      cards.forEach(function (card) {
        var match = card.dataset.collCard === key;
        card.classList.toggle('coll-card-wrap--highlight', match);
        card.classList.toggle('coll-card-wrap--dim', !match);
      });
    }

    function deactivate() {
      chips.forEach(function (c) {
        c.classList.remove('app-chip--active');
        c.removeAttribute('aria-pressed');
      });
      cards.forEach(function (card) {
        card.classList.remove('coll-card-wrap--highlight', 'coll-card-wrap--dim');
      });
    }

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        var key = chip.dataset.coll;
        if (chip.classList.contains('app-chip--active')) {
          deactivate();
        } else {
          activate(key);
        }
      });
      chip.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          chip.click();
        }
      });
    });
  });
}());
</script>

</BaseLayout>

      <div class="vetting-logo"><img src="/assets/consumer/retail-logos/the-home-depot.webp" alt="The Home Depot" loading="lazy" style="max-width:170px;max-height:56px;object-fit:contain;display:block;margin:0 auto"></div>
      <div class="vetting-sub">EST. PROGRAM</div>
    </div>
    <div class="vetting-card">
      <div class="vetting-logo"><img src="/assets/consumer/retail-logos/lowes.webp" alt="Lowe's" loading="lazy" style="max-width:170px;max-height:56px;object-fit:contain;display:block;margin:0 auto"></div>
      <div class="vetting-sub">EST. PROGRAM</div>
    </div>
    <div class="vetting-card">
      <div class="vetting-logo"><img src="/assets/consumer/retail-logos/costco.webp" alt="Costco" loading="lazy" style="max-width:170px;max-height:56px;object-fit:contain;display:block;margin:0 auto"></div>
      <div class="vetting-sub">CLUB CHANNEL</div>
    </div>
    <div class="vetting-card">
      <div class="vetting-logo"><img src="/assets/consumer/retail-logos/walmart.svg" alt="Walmart" loading="lazy" style="max-width:170px;max-height:56px;object-fit:contain;display:block;margin:0 auto"></div>
      <div class="vetting-sub">EST. PROGRAM</div>
    </div>
    <div class="vetting-card">
      <div class="vetting-logo"><img src="/assets/consumer/retail-logos/tractor-supply-co.webp" alt="Tractor Supply" loading="lazy" style="max-width:170px;max-height:56px;object-fit:contain;display:block;margin:0 auto"></div>
      <div class="vetting-sub">RURAL / FARM</div>
    </div>
    <div class="vetting-card">
      <div class="vetting-logo"><img src="/assets/consumer/retail-logos/canadian-tire.webp" alt="Canadian Tire" loading="lazy" style="max-width:170px;max-height:56px;object-fit:contain;display:block;margin:0 auto"></div>
      <div class="vetting-sub">CANADA NATIONAL</div>
    </div>
    <div class="vetting-card">
      <div class="vetting-logo"><img src="/assets/consumer/retail-logos/kroger.webp" alt="Kroger" loading="lazy" style="max-width:170px;max-height:56px;object-fit:contain;display:block;margin:0 auto"></div>
      <div class="vetting-sub">GROCERY</div>
    </div>
    <div class="vetting-card">
      <div class="vetting-logo"><img src="/assets/consumer/retail-logos/fred-meyer.webp" alt="Fred Meyer" loading="lazy" style="max-width:170px;max-height:56px;object-fit:contain;display:block;margin:0 auto"></div>
      <div class="vetting-sub">PNW REGIONAL</div>
    </div>
    <div class="vetting-card">
      <div class="vetting-logo"><img src="/assets/consumer/retail-logos/batteries-plus.webp" alt="Batteries Plus" loading="lazy" style="max-width:170px;max-height:56px;object-fit:contain;display:block;margin:0 auto"></div>
      <div class="vetting-sub">SPECIALTY</div>
    </div>
  </div>
  <div class="vetting-footnote">
    <div class="vetting-footnote-label">SOME SHELVES ARE STILL OPEN.</div>
    <div class="vetting-footnote-text">If you're a retail buyer evaluating a house-brand, co-brand, or OEM/white-label program in lighting, ALG has bench capacity.</div>
    <a href="/contact?topic=retail" class="btn-primary vetting-cta">Request a buyer capability deck →</a>
  </div>
</section>

<!-- ============================================================
     §06 BRAND PORTFOLIO — C&I brands + retail aisles (A2 delta)
     ============================================================ -->
<section class="block" id="catalog">
  <div class="section-head">
    <div class="section-head-meta">
      <span class="section-num">06</span>
      <span class="section-rule"></span>
      <span class="section-label">BRAND PORTFOLIO · FULL CATALOG</span>
    </div>

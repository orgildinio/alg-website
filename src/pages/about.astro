.page-about {
  --brand:       #F32740;
  --brand-dark:  #C8132E;
  --ink:         #1A1D23;
  --ink2:        #3A3E47;
  --ink3:        #6B7280;
  --c1:          #F5F4F1;
  --c2:          #EEEDF0;
  --c3:          #DCDEE2;
  --white:       #FFFFFF;
  --grn:         #0FAE7C;
  --yellow:      #FDD85E;
  --grey:        #8A8F97;

  --font-sans:   'Lato', system-ui, -apple-system, sans-serif;
  --font-mono:   'JetBrains Mono', ui-monospace, monospace;

  --pad-x:       calc(0.5 * max(56px, calc((100vw - 1320px) / 2)));
  --block-pad-y: 120px;
  --block-gap:   0;
}

body[data-density="compact"] {
  --block-pad-y: 80px;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
  background: var(--white);
  color: var(--ink);
  font-family: var(--font-sans);
  font-weight: 400;
  -webkit-font-smoothing: antialiased;
  scroll-behavior: smooth;
}

a { color: inherit; text-decoration: none; }

/* ====================== TOPBAR ====================== */
.topbar {
  position: fixed; top: 0; left: 0; right: 0;
  z-index: 50;
  background: rgba(255,255,255,0);
  transition: background 200ms ease, border-color 200ms ease;
  border-bottom: 1px solid transparent;
}
.topbar.scrolled {
  background: rgba(255,255,255,.96);
  border-bottom: 1px solid var(--c3);
  backdrop-filter: saturate(140%) blur(8px);
}
.topbar-inner {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 32px;
  padding: 16px var(--pad-x);
}
.topbar-logo img { display: block; width: 156px; height: auto; }
.topbar-nav {
  display: flex; justify-content: center; gap: 28px;
  font-family: var(--font-mono);
  font-size: 11.5px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--ink2);
}
.topbar-nav a {
  padding: 4px 0;
  border-bottom: 1px solid transparent;
  transition: color 120ms ease, border-color 120ms ease;
}
.topbar-nav a:hover { color: var(--brand); border-bottom-color: var(--brand); }
.topbar-cta { display: flex; align-items: center; gap: 16px; }
.topbar-channel-tag {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: .16em;
  color: var(--ink3);
  padding: 4px 8px;
  border: 1px solid var(--c3);
  white-space: nowrap;
}

/* ====================== BUTTONS ====================== */
.btn-primary, .btn-primary-light {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 12px 20px;
  background: var(--ink);
  color: #fff !important;
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
  border: 1px solid var(--ink);
  cursor: pointer;
  transition: background 120ms ease, transform 120ms ease;
}
.btn-primary:hover, .btn-primary-light:hover {
  background: var(--brand);
  border-color: var(--brand);
}
.btn-ghost, .btn-ghost-light {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 12px 20px;
  background: transparent;
  color: var(--ink);
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
  border: 1px solid var(--c3);
  cursor: pointer;
  transition: border-color 120ms ease, color 120ms ease;
}
.btn-ghost:hover { border-color: var(--ink); }
.btn-ghost-light { color: #fff; border-color: rgba(255,255,255,.35); }
.btn-ghost-light:hover { border-color: #fff; }

/* ====================== ATOMS ====================== */
.eyebrow {
  font-family: var(--font-mono);
  font-size: 11.5px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--ink3);
}

/* Section head */
.section-head { margin-bottom: 56px; max-width: 920px; }
.section-head-meta {
  display: flex; align-items: center; gap: 16px;
  margin-bottom: 24px;
  font-family: var(--font-mono);
  font-size: 11.5px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--ink3);
}
.section-num { color: var(--brand); font-weight: 700; }
.section-rule { display: block; width: 56px; height: 1px; background: var(--ink); }
.section-label { color: var(--ink2); font-weight: 600; }
.section-title {
  font-size: clamp(40px, 5vw, 64px);
  font-weight: 800;
  letter-spacing: -.02em;
  line-height: 1.02;
  color: var(--ink);
  text-wrap: balance;
}
.section-kicker {
  font-size: 17px;
  line-height: 1.55;
  color: var(--ink2);
  margin-top: 22px;
  max-width: 760px;
  font-weight: 300;
  text-wrap: pretty;
}

/* Block scaffold */
.block {
  padding: var(--block-pad-y) var(--pad-x);
  border-top: 1px solid var(--c3);
}
.block:first-of-type { border-top: none; }
.block-dark {
  background: var(--ink);
  color: #fff;
  border-top: none;
}
.block-dark-head { margin-bottom: 48px; max-width: 920px; }
.block-dark-eyebrow {
  font-family: var(--font-mono);
  font-size: 11.5px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--yellow);
  margin-bottom: 18px;
}
.block-dark-title {
  font-size: clamp(36px, 4.6vw, 56px);
  font-weight: 800;
  letter-spacing: -.02em;
  line-height: 1.04;
  text-wrap: balance;
}

/* ====================== HERO ====================== */
.hero {
  padding: 56px var(--pad-x) 100px;
  position: relative;
}
.hero-typo .eyebrow { margin-bottom: 32px; }
.hero-headline-big {
  font-size: clamp(96px, 16vw, 240px);
  font-weight: 800;
  letter-spacing: -.04em;
  line-height: .88;
  color: var(--ink);
  margin-bottom: 32px;
}
.hero-headline-big .hero-light { color: var(--brand); }
.hero-sub {
  font-size: clamp(20px, 2.2vw, 28px);
  font-weight: 300;
  line-height: 1.35;
  color: var(--ink2);
  max-width: 980px;
  letter-spacing: -.01em;
}
.hero-meta-strip {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 0;
  margin-top: 80px;
  border-top: 1px solid var(--c3);
  border-bottom: 1px solid var(--c3);
}
.hero-meta-cell {
  padding: 24px 20px;
  border-right: 1px solid var(--c3);
}
.hero-meta-cell:last-child { border-right: none; }
.hero-meta-cell .v {
  font-size: 34px;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -.02em;
  line-height: 1;
}
.hero-meta-cell .k {
  font-family: var(--font-mono);
  font-size: 10.5px;
  color: var(--ink3);
  letter-spacing: .12em;
  text-transform: uppercase;
  margin-top: 12px;
}

/* hero split variant */
.hero-split {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 80px;
  align-items: center;
}
.hero-headline {
  font-size: clamp(48px, 6vw, 88px);
  font-weight: 800;
  letter-spacing: -.03em;
  line-height: .98;
  color: var(--ink);
  margin: 28px 0 32px;
}
.hero-headline-sub {
  font-size: clamp(28px, 3.4vw, 48px);
  font-weight: 300;
  color: var(--ink2);
  letter-spacing: -.02em;
  line-height: 1.1;
  display: block;
  margin-top: 18px;
}
.hero-lede {
  font-size: 18px;
  font-weight: 300;
  line-height: 1.55;
  color: var(--ink2);
  max-width: 540px;
}
.hero-figure {
  position: relative;
  background: var(--c1);
  border: 1px solid var(--c3);
  padding: 40px;
  aspect-ratio: 1 / 1;
}
.hero-figure-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 18px;
  height: 100%;
  width: 100%;
}
.hero-dot {
  background: var(--c3);
  border-radius: 50%;
  aspect-ratio: 1 / 1;
  width: 100%;
}
.hero-dot.on { background: var(--ink); }
.hero-dot.on.accent { background: var(--brand); }
.hero-figure-tag {
  position: absolute;
  left: 24px; right: 24px; bottom: 24px;
  background: rgba(255,255,255,.94);
  border-left: 3px solid var(--brand);
  padding: 12px 14px;
}
.hero-figure-tag-body {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--ink2);
  letter-spacing: .02em;
  margin-top: 4px;
  line-height: 1.45;
}

/* ====================== HERITAGE ====================== */
.heritage-grid {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: 64px;
}
.heritage-lede {
  font-size: 26px;
  font-weight: 300;
  line-height: 1.35;
  color: var(--ink);
  letter-spacing: -.01em;
  text-wrap: pretty;
  margin-bottom: 28px;
}
.heritage-lede em {
  color: var(--brand);
  font-style: normal;
  font-weight: 600;
}
.heritage-body-text {
  font-size: 16px;
  line-height: 1.65;
  color: var(--ink2);
  font-weight: 400;
  margin-top: 18px;
  max-width: 660px;
}
.heritage-pull {
  margin-top: 36px;
  background: var(--c1);
  border-left: 3px solid var(--brand);
  padding: 20px 24px;
}
.heritage-pull-label {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .16em;
  color: var(--brand);
  margin-bottom: 8px;
}
.heritage-pull-text {
  font-size: 15px;
  line-height: 1.6;
  color: var(--ink2);
  font-weight: 400;
}

.heritage-side-card {
  background: #fff;
  border: 1px solid var(--c3);
  border-top: 3px solid var(--brand);
  padding: 24px;
}
.heritage-side-card-head {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: .14em;
  color: var(--ink);
  font-weight: 700;
  text-transform: uppercase;
  padding-bottom: 12px;
  border-bottom: 2px solid var(--ink);
  margin-bottom: 16px;
}
.heritage-side-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.heritage-side-list li {
  display: grid;
  grid-template-columns: 14px 1fr;
  gap: 10px;
  font-size: 13.5px;
  line-height: 1.5;
  color: var(--ink2);
}
.heritage-side-list .dot {
  width: 6px; height: 6px;
  background: var(--brand);
  margin-top: 8px;
  border-radius: 50%;
}
.heritage-side-list strong {
  color: var(--ink);
  font-weight: 700;
  font-family: var(--font-mono);
  font-size: 12.5px;
  letter-spacing: .04em;
}
.heritage-side-footnote {
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px dashed var(--c3);
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--ink3);
  line-height: 1.45;
}
.heritage-stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 16px;
}
.stat {
  padding: 14px 16px;
  background: var(--c1);
  border-left: 3px solid var(--brand);
}
.stat .v { font-size: 22px; font-weight: 700; line-height: 1.05; color: var(--ink); white-space: nowrap; }
.stat .k {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--ink3);
  margin-top: 8px;
  line-height: 1.4;
}

/* ====================== BY THE NUMBERS ====================== */
.numbers-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  border-top: 1px solid rgba(255,255,255,.18);
  border-left: 1px solid rgba(255,255,255,.18);
}
.number-cell {
  padding: 28px 28px;
  border-right: 1px solid rgba(255,255,255,.18);
  border-bottom: 1px solid rgba(255,255,255,.18);
}
.number-v {
  font-size: 48px;
  font-weight: 700;
  letter-spacing: -.02em;
  line-height: 1;
  color: #fff;
}
.number-k {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: .14em;
  color: var(--yellow);
  margin-top: 16px;
  text-transform: uppercase;
  line-height: 1.45;
}

/* ====================== TWO CHANNELS ====================== */
.channel-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}
.channel-card {
  background: #fff;
  border: 1px solid var(--c3);
  padding: 36px 36px 32px;
  position: relative;
  display: flex;
  flex-direction: column;
}
.channel-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: var(--brand);
}
.channel-card.ch-retail::before { background: var(--yellow); }
.channel-card.ch-ci::before { background: var(--brand); }
.channel-card-head { margin-bottom: 28px; }
.channel-eyebrow {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--ink3);
  font-weight: 700;
}
.channel-card.ch-retail .channel-eyebrow { color: #B07A00; }
.channel-card.ch-ci .channel-eyebrow { color: var(--brand); }
.channel-title {
  font-size: 36px;
  font-weight: 800;
  letter-spacing: -.02em;
  line-height: 1.05;
  margin-top: 12px;
  color: var(--ink);
}
.channel-tagline {
  font-size: 16px;
  font-style: italic;
  font-weight: 300;
  color: var(--ink2);
  margin-top: 12px;
  letter-spacing: -.01em;
  line-height: 1.4;
}

.channel-spec {
  display: flex;
  flex-direction: column;
  border-top: 2px solid var(--ink);
}
.cs-row {
  display: grid;
  grid-template-columns: 130px 1fr;
  gap: 16px;
  padding: 12px 0;
  border-bottom: 1px solid var(--c2);
  align-items: baseline;
}
.cs-row:last-child { border-bottom: none; }
.cs-row dt {
  font-family: var(--font-mono);
  font-size: 10.5px;
  letter-spacing: .14em;
  color: var(--ink3);
  font-weight: 600;
}
.cs-row dd {
  font-size: 14px;
  line-height: 1.5;
  color: var(--ink2);
}
.brand-chip {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 600;
  color: var(--ink);
  background: var(--c1);
  padding: 3px 8px;
  margin: 2px 6px 2px 0;
  border-radius: 2px;
  white-space: nowrap;
}

.channel-cta-row {
  margin-top: 28px;
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

/* Channel rule bar */
.channel-rule-bar {
  margin-top: 32px;
  background: var(--c1);
  padding: 28px 32px;
  border-left: 3px solid var(--ink);
}
.channel-rule-bar-label {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: .16em;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 18px;
}
.channel-rule-list {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px 32px;
}
.channel-rule-list li {
  display: grid;
  grid-template-columns: 36px 1fr;
  gap: 12px;
  font-size: 14px;
  line-height: 1.55;
  color: var(--ink2);
}
.channel-rule-list .rl-n {
  font-family: var(--font-mono);
  font-size: 13px;
  font-weight: 700;
  color: var(--brand);
  letter-spacing: .04em;
}
.channel-rule-list strong { color: var(--ink); font-weight: 700; }

/* Tabs variant */
.channel-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  border-top: 2px solid var(--ink);
  border-bottom: 1px solid var(--c3);
  margin-bottom: 36px;
}
.channel-tab {
  text-align: left;
  background: transparent;
  border: 0;
  border-right: 1px solid var(--c3);
  padding: 22px 28px;
  cursor: pointer;
  font-family: var(--font-sans);
  display: flex;
  flex-direction: column;
  gap: 6px;
  transition: background 120ms ease;
  position: relative;
}
.channel-tab:last-child { border-right: none; }
.channel-tab:hover { background: var(--c1); }
.channel-tab.active::after {
  content: '';
  position: absolute;
  bottom: -1px; left: 0; right: 0;
  height: 3px;
  background: var(--brand);
}
.channel-tab.active { background: var(--c1); }
.channel-tab-label {
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -.01em;
  color: var(--ink);
}
.channel-tab-tagline {
  font-size: 13px;
  font-style: italic;
  font-weight: 300;
  color: var(--ink3);
}
.channel-card-full {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
}

/* ====================== WHERE WE MAKE IT ====================== */
.where-grid {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: 48px;
}
.where-map {
  background: var(--c1);
  border: 1px solid var(--c3);
  padding: 28px;
  display: flex;
  flex-direction: column;
}
.where-map-label {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--ink3);
  padding-bottom: 14px;
  border-bottom: 1px solid var(--c3);
  margin-bottom: 20px;
}
.where-map-canvas {
  flex: 1;
  min-height: 0;
  height: 380px;
  overflow: hidden;
}
/* CFG-MAP-1: Leaflet container fills the canvas, no resize on drag */
.where-map-canvas :global(.leaflet-container) {
  width: 100% !important;
  height: 100% !important;
  min-height: 0 !important;
  border-radius: 0;
}
.where-legend {
  display: flex;
  gap: 32px;
  margin-top: 16px;
  padding-top: 16px;
  border-top: 1px solid var(--c3);
  flex-wrap: wrap;
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: .08em;
  color: var(--ink2);
}
.where-legend-item { display: flex; align-items: center; gap: 8px; }
.lg-dot { width: 10px; height: 10px; border-radius: 50%; }
.lg-dot.brand { background: var(--brand); }
.lg-dot.ink { background: var(--ink); border-radius: 0; }
.lg-dot.ink-faint { background: var(--ink); opacity: .5; }

.where-side { display: flex; flex-direction: column; gap: 16px; }
.where-card {
  background: #fff;
  border: 1px solid var(--c3);
  border-left: 3px solid var(--brand);
  padding: 24px 26px;
  display: grid;
  grid-template-columns: 56px 1fr;
  gap: 20px;
  align-items: start;
}
.where-card-num {
  font-family: var(--font-mono);
  font-size: 26px;
  font-weight: 700;
  color: var(--brand);
  line-height: 1;
}
.where-card-name {
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -.01em;
  color: var(--ink);
  grid-column: 2;
}
.where-card-role {
  font-size: 13.5px;
  color: var(--ink2);
  margin-top: 8px;
  line-height: 1.55;
  grid-column: 2;
}
.where-card-addr {
  font-family: var(--font-mono);
  font-size: 11.5px;
  color: var(--ink3);
  margin-top: 10px;
  letter-spacing: .04em;
  grid-column: 2;
}
/* where-card-partner removed — card 03 now uses standard .where-card styling */

/* ====================== BRAND PORTFOLIO ====================== */
.brand-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}
.brand-card {
  background: #fff;
  border: 1px solid var(--c3);
  padding: 28px;
  position: relative;
  transition: opacity 200ms ease;
  display: flex;
  flex-direction: column;
  min-height: 240px;
}
.brand-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: var(--brand);
}
.brand-card.brand-retail::before { background: var(--yellow); }
.brand-card.brand-both::before {
  background: linear-gradient(90deg, var(--yellow) 0%, var(--yellow) 50%, var(--brand) 50%, var(--brand) 100%);
}
.brand-dim { opacity: .35; }
.brand-mark {
  font-size: 30px;
  font-weight: 800;
  letter-spacing: -.02em;
  color: var(--ink);
  line-height: 1;
}
.brand-cat {
  font-family: var(--font-mono);
  font-size: 10.5px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--ink3);
  margin-top: 10px;
  font-weight: 700;
}
.brand-desc {
  font-size: 14px;
  line-height: 1.55;
  color: var(--ink2);
  margin-top: 14px;
  flex: 1;
}
.brand-footer {
  margin-top: 18px;
  padding-top: 14px;
  border-top: 1px solid var(--c2);
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.brand-channel-pill {
  font-family: var(--font-mono);
  font-size: 9.5px;
  letter-spacing: .14em;
  font-weight: 700;
  padding: 3px 8px;
  background: var(--ink);
  color: #fff;
  border-radius: 2px;
}
.brand-card.brand-retail .brand-channel-pill { background: var(--yellow); color: var(--ink); }
.brand-card.brand-both .brand-channel-pill { background: var(--ink); }
.brand-tag {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: .1em;
  color: var(--ink3);
  font-weight: 600;
}

/* ====================== CHANNEL NOTE ====================== */
.channel-note {
  margin-top: 24px;
  padding: 14px 16px;
  background: var(--c1);
  border-left: 3px solid var(--ink);
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.ch-retail .channel-note { border-left-color: #B07A00; }
.ch-ci .channel-note { border-left-color: var(--brand); }
.channel-note-label {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: .16em;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--ink);
}
.channel-note-text {
  font-size: 13px;
  line-height: 1.5;
  color: var(--ink2);
  font-weight: 500;
}

.channel-rule-intro {
  font-size: 15px;
  line-height: 1.55;
  color: var(--ink2);
  margin-bottom: 22px;
  max-width: 880px;
  font-weight: 400;
}

/* ====================== RETAIL VETTING ====================== */
.block-vetting {
  background: var(--c1);
}
.vetting-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  border-top: 1px solid var(--c3);
  border-left: 1px solid var(--c3);
}
.vetting-card {
  background: #fff;
  padding: 28px 24px 24px;
  border-right: 1px solid var(--c3);
  border-bottom: 1px solid var(--c3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 12px;
}
.vetting-checkmark {
  width: 36px; height: 36px;
  background: var(--grn);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  grid-row: span 2;
}
.vetting-name {
  font-size: 19px;
  font-weight: 700;
  letter-spacing: -.01em;
  color: var(--ink);
  line-height: 1.15;
}
.vetting-sub {
  grid-column: 2;
  font-family: var(--font-mono);
  font-size: 10.5px;
  letter-spacing: .14em;
  color: var(--ink3);
  font-weight: 600;
  margin-top: 4px;
}
.vetting-footnote {
  margin-top: 36px;
  background: var(--ink);
  color: #fff;
  padding: 32px 36px;
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 32px;
  align-items: center;
}
.vetting-footnote-label {
  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: .18em;
  font-weight: 700;
  color: var(--yellow);
  text-transform: uppercase;
  white-space: nowrap;
}
.vetting-footnote-text {
  font-size: 15px;
  line-height: 1.5;
  color: #D5D6DC;
  max-width: 640px;
}
.vetting-cta {
  background: var(--brand);
  border-color: var(--brand);
  white-space: nowrap;
}
.vetting-cta:hover {
  background: var(--brand-dark);
  border-color: var(--brand-dark);
}

/* ====================== CATALOG SECTIONS (C&I + Aisles) ====================== */
.catalog-section { margin-top: 48px; }
.catalog-section:first-of-type { margin-top: 16px; }
.catalog-section-head {
  margin-bottom: 28px;
  padding-bottom: 18px;
  border-bottom: 2px solid var(--ink);
}
.catalog-section-meta {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
  font-family: var(--font-mono);
  font-size: 11.5px;
  letter-spacing: .14em;
  text-transform: uppercase;
}
.catalog-section-num {
  font-size: 22px;
  font-weight: 800;
  color: var(--brand);
  letter-spacing: 0;
  line-height: 1;
  padding: 6px 14px;
  background: var(--c1);
  border-left: 3px solid var(--brand);
  font-family: var(--font-sans);
}
.catalog-section-num.retail {
  color: #B07A00;
  border-left-color: var(--yellow);
}
.catalog-section-rule {
  display: block;
  width: 32px;
  height: 1px;
  background: var(--ink);
}
.catalog-section-label {
  color: var(--ink);
  font-weight: 700;
}
.catalog-section-pill {
  margin-left: auto;
  font-size: 10px;
  padding: 4px 10px;
  background: var(--ink);
  color: #fff;
  border-radius: 2px;
}
.catalog-section-pill.retail {
  background: var(--yellow);
  color: var(--ink);
}
.catalog-section-kicker {
  font-size: 14.5px;
  line-height: 1.55;
  color: var(--ink2);
  margin-top: 14px;
  max-width: 800px;
}

/* aisle grid (retail) */
.aisle-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  border-top: 1px solid var(--c3);
  border-left: 1px solid var(--c3);
}
.aisle-card {
  padding: 28px 28px 24px;
  background: #fff;
  border-right: 1px solid var(--c3);
  border-bottom: 1px solid var(--c3);
  display: flex;
  flex-direction: column;
  min-height: 200px;
  transition: opacity 200ms ease;
  position: relative;
}
.aisle-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; bottom: 0;
  width: 3px;
  background: var(--yellow);
}
.aisle-num {
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .14em;
  color: #B07A00;
  margin-bottom: 12px;
}
.aisle-name {
  font-size: 28px;
  font-weight: 800;
  letter-spacing: -.02em;
  color: var(--ink);
  line-height: 1;
}
.aisle-desc {
  font-size: 13.5px;
  line-height: 1.55;
  color: var(--ink2);
  margin-top: 12px;
  flex: 1;
}
.aisle-tag {
  margin-top: 14px;
  padding-top: 12px;
  border-top: 1px solid var(--c2);
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: .12em;
  color: var(--ink3);
  font-weight: 600;
}

/* Aisle icon size constraint */
.aisle-icon-wrap{ width:34px; height:34px; flex:none; }
.aisle-icon-wrap svg{ width:34px !important; height:34px !important; color:var(--brand); stroke:currentColor; }
/* C&I pill recolor */
.brand-channel-pill.ci { background: var(--brand); color: #fff; }
.brand-channel-pill.retail { background: var(--yellow); color: var(--ink); }

/* ====================== PRINCIPLES ====================== */
.principles-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0;
  border-top: 1px solid var(--c3);
  border-left: 1px solid var(--c3);
}
.principle-card {
  padding: 36px 40px;
  border-right: 1px solid var(--c3);
  border-bottom: 1px solid var(--c3);
  display: grid;
  grid-template-columns: 72px 1fr;
  gap: 18px;
  align-items: start;
}
.principle-n {
  font-family: var(--font-mono);
  font-size: 32px;
  font-weight: 700;
  color: var(--brand);
  line-height: 1;
}
.principle-title {
  grid-column: 2;
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -.01em;
  color: var(--ink);
  line-height: 1.2;
  text-wrap: balance;
}
.principle-body {
  grid-column: 2;
  font-size: 15px;
  line-height: 1.6;
  color: var(--ink2);
  margin-top: 12px;
  text-wrap: pretty;
}

/* ====================== TIMELINE ====================== */
.timeline {
  position: relative;
  padding-left: 8px;
}
.timeline-rail {
  position: absolute;
  left: 134px; top: 0; bottom: 0;
  width: 1px; background: var(--c3);
}
.timeline-row {
  display: grid;
  grid-template-columns: 120px 36px 1fr;
  gap: 16px;
  align-items: start;
  padding: 18px 0;
}
.timeline-year {
  font-family: var(--font-mono);
  font-size: 18px;
  font-weight: 700;
  color: var(--brand);
  letter-spacing: .02em;
  padding-top: 2px;
}
.timeline-dot {
  width: 12px; height: 12px;
  background: var(--brand);
  margin: 8px auto 0;
  border-radius: 50%;
  position: relative;
  z-index: 1;
  box-shadow: 0 0 0 4px #fff;
}
.timeline-title {
  font-size: 20px;
  font-weight: 700;
  letter-spacing: -.01em;
  color: var(--ink);
}
.timeline-text {
  font-size: 14.5px;
  line-height: 1.55;
  color: var(--ink2);
  margin-top: 6px;
  max-width: 720px;
}

/* ====================== LEADERSHIP ====================== */
.leadership-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.leader-card {
  background: #fff;
  border: 1px solid var(--c3);
  padding: 0 0 24px;
  display: flex;
  flex-direction: column;
}
.leader-photo {
  background: var(--c1);
  aspect-ratio: 4 / 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-bottom: 3px solid var(--brand);
  position: relative;
}
.leader-photo-initials {
  font-size: 72px;
  font-weight: 300;
  color: var(--c3);
  letter-spacing: -.02em;
  font-family: var(--font-mono);
}
.leader-photo-tag {
  position: absolute;
  bottom: 12px;
  font-family: var(--font-mono);
  font-size: 9.5px;
  letter-spacing: .14em;
  color: var(--ink3);
}
.leader-role {
  font-family: var(--font-mono);
  font-size: 10.5px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--brand);
  font-weight: 700;
  padding: 18px 24px 6px;
}
.leader-name {
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -.01em;
  color: var(--ink);
  padding: 0 24px;
}
.leader-stripe {
  font-size: 13.5px;
  line-height: 1.5;
  color: var(--ink2);
  padding: 8px 24px 0;
}

/* ====================== CTA ====================== */
.cta-block { background: var(--ink); }
.cta-head { max-width: 920px; margin-bottom: 48px; }
.cta-title {
  font-size: clamp(40px, 5vw, 64px);
  font-weight: 800;
  letter-spacing: -.02em;
  line-height: 1.04;
  margin-top: 16px;
  color: #fff;
  text-wrap: balance;
}
.cta-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}
.cta-card {
  background: #232730;
  border: 1px solid #2c313c;
  padding: 36px;
  position: relative;
}
.cta-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
}
.cta-retail::before { background: var(--yellow); }
.cta-ci::before { background: var(--brand); }
.cta-card-eyebrow {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: .16em;
  font-weight: 700;
  color: var(--ink3);
}
.cta-retail .cta-card-eyebrow { color: var(--yellow); }
.cta-ci .cta-card-eyebrow { color: var(--brand); }
.cta-card-title {
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -.01em;
  color: #fff;
  margin-top: 14px;
  text-wrap: balance;
  line-height: 1.25;
}
.cta-card-list {
  list-style: none;
  margin-top: 22px;
  margin-bottom: 28px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.cta-card-list li {
  display: grid;
  grid-template-columns: 14px 1fr;
  gap: 12px;
  font-size: 14px;
  line-height: 1.55;
  color: #D5D6DC;
}
.cta-card-list .dot {
  width: 6px; height: 6px;
  background: #fff;
  border-radius: 50%;
  margin-top: 8px;
}
.cta-retail .cta-card-list .dot { background: var(--yellow); }
.cta-ci .cta-card-list .dot { background: var(--brand); }
.cta-card-actions { display: flex; gap: 12px; flex-wrap: wrap; }

.cta-contact-strip {
  margin-top: 48px;
  display: grid;
  grid-template-columns: 2fr 2fr 1fr 1.4fr;
  border-top: 1px solid rgba(255,255,255,.18);
}
.cta-contact-cell {
  padding: 24px 24px;
  border-right: 1px solid rgba(255,255,255,.18);
}
.cta-contact-cell:last-child { border-right: none; }
.cta-contact-cell .ck {
  font-family: var(--font-mono);
  font-size: 10.5px;
  letter-spacing: .14em;
  color: var(--yellow);
  font-weight: 700;
  margin-bottom: 10px;
}
.cta-contact-cell .cv {
  font-family: var(--font-mono);
  font-size: 12.5px;
  color: #fff;
  line-height: 1.55;
}

/* ====================== FOOTER ====================== */
.footer-bar {
  background: #fff;
  border-top: 1px solid var(--c3);
  padding: 36px var(--pad-x);
}
.footer-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
  flex-wrap: wrap;
}
.footer-cell { display: flex; align-items: center; gap: 18px; }
.footer-logo { width: 120px; height: auto; }
.footer-tag {
  font-family: var(--font-mono);
  font-size: 10.5px;
  letter-spacing: .14em;
  color: var(--ink3);
}
.footer-meta {
  font-family: var(--font-mono);
  font-size: 10.5px;
  color: var(--ink3);
  letter-spacing: .1em;
  display: flex;
  gap: 12px;
}

/* ============================================================
   CLAUDE EDITOR — in-place AI copy editing overlay
   ============================================================ */
.claude-edit-launch {
  position: fixed;
  right: 24px; bottom: 24px;
  z-index: 90;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 20px;
  background: var(--ink);
  color: #fff;
  border: 0;
  font-family: var(--font-sans);
  font-size: 13.5px;
  font-weight: 600;
  letter-spacing: -.01em;
  cursor: pointer;
  box-shadow: 0 12px 32px rgba(0,0,0,.18), 0 0 0 1px rgba(255,255,255,.06) inset;
  transition: transform 120ms ease, background 120ms ease;
}
.claude-edit-launch:hover {
  background: var(--brand);
  transform: translateY(-1px);
}
.claude-edit-launch-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--yellow);
  box-shadow: 0 0 0 4px rgba(253, 216, 94, .25);
  animation: claude-pulse 1.8s ease-in-out infinite;
}
@keyframes claude-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: .5; }
}

/* Hover + selected outlines on editable elements */
[data-claude-editable] {
  cursor: pointer !important;
  position: relative;
  transition: outline-offset 80ms ease;
}
[data-claude-editable]:hover {
  outline: 1px dashed var(--brand);
  outline-offset: 6px;
}
[data-claude-selected] {
  outline: 2px solid var(--brand) !important;
  outline-offset: 6px !important;
  background: rgba(227, 53, 60, .04);
}

/* Panel */
.claude-editor-panel {
  position: fixed;
  right: 24px; bottom: 24px;
  width: 380px;
  max-height: calc(100vh - 48px);
  background: #fff;
  border: 1px solid var(--c3);
  z-index: 100;
  box-shadow: 0 24px 64px rgba(0,0,0,.18);
  display: flex;
  flex-direction: column;
  font-family: var(--font-sans);
  overflow: hidden;
}
.claude-editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 20px 16px;
  background: var(--ink);
  color: #fff;
  border-bottom: 3px solid var(--brand);
}
.claude-editor-head-l {
  display: flex;
  align-items: center;
  gap: 12px;
}
.claude-editor-dot {
  width: 10px; height: 10px;
  border-radius: 50%;
  background: var(--yellow);
  flex-shrink: 0;
  animation: claude-pulse 1.8s ease-in-out infinite;
}
.claude-editor-title {
  font-size: 14px;
  font-weight: 700;
  letter-spacing: -.01em;
}
.claude-editor-sub {
  font-family: var(--font-mono);
  font-size: 10.5px;
  letter-spacing: .12em;
  color: rgba(255,255,255,.7);
  margin-top: 4px;
  text-transform: uppercase;
}
.claude-editor-x {
  background: transparent;
  border: 0;
  color: rgba(255,255,255,.7);
  font-size: 24px;
  cursor: pointer;
  padding: 0 4px;
  line-height: 1;
}
.claude-editor-x:hover { color: #fff; }

/* Target preview */
.claude-editor-target {
  padding: 16px 20px;
  background: var(--c1);
  border-bottom: 1px solid var(--c3);
}
.claude-editor-target-label {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: .16em;
  font-weight: 700;
  color: var(--brand);
  margin-bottom: 8px;
}
.claude-editor-target-text {
  font-size: 13px;
  line-height: 1.5;
  color: var(--ink2);
  font-style: italic;
  max-height: 84px;
  overflow: hidden;
  text-overflow: ellipsis;
}
.claude-editor-deselect {
  margin-top: 10px;
  background: transparent;
  border: 0;
  color: var(--ink3);
  font-family: var(--font-mono);
  font-size: 10.5px;
  letter-spacing: .1em;
  cursor: pointer;
  padding: 0;
}
.claude-editor-deselect:hover { color: var(--brand); }

/* Prompt */
.claude-editor-prompt {
  padding: 18px 20px;
  display: flex;
  flex-direction: column;

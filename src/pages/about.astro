    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', Helvetica, Arial, sans-serif !important;
  }
  .page-about h1,.page-about h2,.page-about h3,
  .page-contact h1,.page-contact h2,.page-contact h3,
  .page-returns h1,.page-returns h2,.page-returns h3,
  .page-find-a-rep h1,.page-find-a-rep h2,.page-find-a-rep h3,
  .page-persona h1,.page-persona h2,.page-persona h3 {
    font-weight: 600 !important;
  }
</style>
  <!-- «TBD-VERIFY»: Heritage paragraphs (§01), About family blurbs (§05), retail-aisle badge copy (§04) — render as mockup, James line-checks at preview -->
  <!-- glow orb -->
  <div class="glow-orb" style="position:fixed;top:0;left:0;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(247,82,82,.13) 0%,transparent 70%);pointer-events:none;z-index:0;will-change:transform;"></div>

<main style="position: relative; z-index: 1;"><!-- Live site header mounts here — do not redesign --><nav style="position: sticky; top: 54px; z-index: 90; background: rgba(255, 255, 255, 0.94); border-bottom: 1px solid rgb(229, 229, 231); overflow-x: auto;">
<div style="max-width: 1200px; margin: 0px auto; padding: 12px 24px; display: flex; gap: 26px; font-size: 13px; color: rgb(110, 110, 115); white-space: nowrap;">
<a href="#heritage" style="color: rgb(110, 110, 115);">Heritage</a>
<a href="#numbers" style="color: rgb(110, 110, 115);">By the Numbers</a>
<a href="#channels" style="color: rgb(110, 110, 115);">The Two Channels</a>
<a href="#vetting" style="color: rgb(110, 110, 115);">Retail Vetting</a>
<a href="#portfolio" style="color: rgb(110, 110, 115);">Brand Portfolio</a>
<a href="#operations" style="color: rgb(110, 110, 115);">Operations</a>
<a href="#principles" style="color: rgb(110, 110, 115);">Operating Principles</a>
<a href="#timeline" style="color: rgb(110, 110, 115);">Timeline</a>
<a href="#doors" style="color: rgb(110, 110, 115);">Next Step</a>
</div></nav><section data-screen-label="About hero" style="padding: 120px 24px 88px; text-align: center;">
<div style="max-width: 980px; margin: 0px auto;">
<p style="font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(134, 134, 139); margin: 0px 0px 20px;">About · Archipelago Lighting Group · Montclair, CA · Since 1997</p>
<h1 style="font-size: clamp(48px, 7.5vw, 88px); font-weight: 600; letter-spacing: -0.03em; line-height: 1.05; margin: 0px 0px 24px;">Lighting, <span style="color: rgb(243, 39, 64);">reinvented.</span></h1>
<p style="font-size: clamp(19px, 2.2vw, 24px); color: rgb(110, 110, 115); line-height: 1.45; margin: 0px auto; max-width: 720px;">Built for 40-foot warehouses, K-12 corridors, cold-storage rooms, and spec-grade projects, and the retail aisles of nine national retailers.</p>
</div>
<div style="max-width: 1100px; margin: 72px auto 0px; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px;">
<div style="background: rgb(245, 245, 247); border-radius: 16px; padding: 28px 16px; text-align: center;"><div style="font-size: 40px; font-weight: 600; letter-spacing: -0.03em;">1997</div><div style="width: 36px; height: 3px; background: rgb(29, 29, 31); border-radius: 2px; margin: 12px auto;"></div><div style="font-size: 13px; color: rgb(110, 110, 115);">Founded</div></div>
<div style="background: rgb(245, 245, 247); border-radius: 16px; padding: 28px 16px; text-align: center;"><div style="font-size: 40px; font-weight: 600; letter-spacing: -0.03em;">30+ yr</div><div style="width: 36px; height: 3px; background: rgb(29, 29, 31); border-radius: 2px; margin: 12px auto;"></div><div style="font-size: 13px; color: rgb(110, 110, 115);">Supplying Shelves</div></div>
<div style="background: rgb(245, 245, 247); border-radius: 16px; padding: 28px 16px; text-align: center;"><div style="font-size: 40px; font-weight: 600; letter-spacing: -0.03em;">85M+</div><div style="width: 36px; height: 3px; background: rgb(29, 29, 31); border-radius: 2px; margin: 12px auto;"></div><div style="font-size: 13px; color: rgb(110, 110, 115);">Units Shipped</div></div>
<div style="background: rgb(245, 245, 247); border-radius: 16px; padding: 28px 16px; text-align: center;"><div style="font-size: 40px; font-weight: 600; letter-spacing: -0.03em;">9</div><div style="width: 36px; height: 3px; background: rgb(29, 29, 31); border-radius: 2px; margin: 12px auto;"></div><div style="font-size: 13px; color: rgb(110, 110, 115);">National Retail Accounts</div></div>
<div style="background: rgb(245, 245, 247); border-radius: 16px; padding: 28px 16px; text-align: center;"><div style="font-size: 40px; font-weight: 600; letter-spacing: -0.03em;">12</div><div style="width: 36px; height: 3px; background: rgb(29, 29, 31); border-radius: 2px; margin: 12px auto;"></div><div style="font-size: 13px; color: rgb(110, 110, 115);">US Warehouses</div></div>
</div></section><section data-screen-label="01 Heritage" id="heritage" style="padding: 104px 24px; border-top: 1px solid rgb(229, 229, 231);">
<div style="max-width: 1200px; margin: 0px auto;">
<p style="font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(134, 134, 139); margin: 0px 0px 14px;">01 · Heritage · Since 1997</p>
<h2 style="font-size: clamp(38px, 4vw, 52px); font-weight: 600; letter-spacing: -0.02em; line-height: 1.08; margin: 0px 0px 12px;">Three decades of OEM discipline.</h2>
<p style="font-size: clamp(19px, 2.2vw, 24px); color: rgb(110, 110, 115); line-height: 1.45; margin: 0px 0px 40px; max-width: 760px;">From the retail shelf to the spec package — one quality system, two doors.</p>
<div style="margin: 0px 0px 48px;"><image-slot id="about-heritage" placeholder="Drop heritage photography — Montclair facility / retail OEM floor, 1997–today" radius="16" shape="rounded" style="width: 100%; height: 280px;"></image-slot></div>
<div style="display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: start;">
<div style="display: grid; gap: 20px;">
<p style="font-size: 17px; line-height: 1.55; color: rgb(66, 66, 69); margin: 0px;">Archipelago Lighting Group was founded in 1997 as an OEM and white-label manufacturer for national retail programs. Before the company ever printed its own name on a box, it built lamps and fixtures to other people's specifications — and passed other people's audits to keep the business.</p>
<p style="font-size: 17px; line-height: 1.55; color: rgb(66, 66, 69); margin: 0px;">Retail vetting is the hardest discipline in lighting: multi-year compliance reviews, quarterly factory audits, and planogram replenishment windows measured in days, not quarters. Nine national retailers keep ALG product on their shelves because the paperwork, the packaging, and the pallet all arrive right — every time.</p>
<p style="font-size: 17px; line-height: 1.55; color: rgb(66, 66, 69); margin: 0px;">The C&amp;I catalog grew out of that retail discipline. Same factories, same quality system, same engineering bench — but a separate sales motion, a separate price book, and a different customer: the distributor, the specifier, and the contractor with a takeoff due.</p>
<div style="background: rgb(245, 245, 247); border-radius: 16px; padding: 28px 32px; margin-top: 8px;">
<p style="font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(134, 134, 139); margin: 0px 0px 10px;">The Discipline</p>
<p style="font-size: 19px; font-weight: 500; line-height: 1.45; color: rgb(29, 29, 31); margin: 0px;">A retail shelf does not forgive. Miss a replenishment window once and the planogram goes to someone else. Thirty years of not missing is the quality system.</p>
</div>
</div>
<div style="display: grid; gap: 24px;">
<div style="border: 1px solid rgb(229, 229, 231); border-radius: 16px; padding: 28px;">
<p style="font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(134, 134, 139); margin: 0px 0px 18px;">Retail OEM Capabilities · <span style="color: rgb(29, 29, 31);">Active</span></p>
<div style="display: grid; gap: 14px; font-size: 15px; line-height: 1.45;">
<div style="border-bottom: 1px solid rgb(229, 229, 231); padding-bottom: 14px;"><span style="font-weight: 600;">House brand</span> — retailer-owned labels, built to program spec</div>
<div style="border-bottom: 1px solid rgb(229, 229, 231); padding-bottom: 14px;"><span style="font-weight: 600;">Co-brand</span> — shared-mark programs with national accounts</div>
<div style="border-bottom: 1px solid rgb(229, 229, 231); padding-bottom: 14px;"><span style="font-weight: 600;">OEM / white-label</span> — full private-label manufacturing</div>
<div style="border-bottom: 1px solid rgb(229, 229, 231); padding-bottom: 14px;"><span style="font-weight: 600;">Replenishment readiness</span> — 12 US warehouses, same-week planogram refill</div>
<div><span style="font-weight: 600;">Compliance discipline</span> — UL/ETL listings, IP, and retail warranty terms managed per program</div>
</div>
<p style="font-size: 13px; color: rgb(134, 134, 139); line-height: 1.5; margin: 18px 0px 0px;">Retail programs operate under mutual NDA. Retailer program details are shared in vetting conversations, not on this page.</p>
</div>
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
<div style="background: rgb(245, 245, 247); border-radius: 16px; padding: 24px;"><div style="font-size: 36px; font-weight: 600; letter-spacing: -0.02em;">30+ yr</div><div style="width: 32px; height: 3px; background: rgb(29, 29, 31); border-radius: 2px; margin: 10px 0px;"></div><div style="font-size: 13px; color: rgb(110, 110, 115);">Supplying retail shelves</div></div>
<div style="background: rgb(245, 245, 247); border-radius: 16px; padding: 24px;"><div style="font-size: 36px; font-weight: 600; letter-spacing: -0.02em;">85M+</div><div style="width: 32px; height: 3px; background: rgb(29, 29, 31); border-radius: 2px; margin: 10px 0px;"></div><div style="font-size: 13px; color: rgb(110, 110, 115);">Units shipped since 1997</div></div>
</div>
</div>
</div>
</div></section><section data-screen-label="02 By the Numbers" id="numbers" style="padding: 104px 24px; background: rgb(245, 245, 247);">
<div style="max-width: 1200px; margin: 0px auto;">
<p style="font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(134, 134, 139); margin: 0px 0px 14px;">02 · By the Numbers</p>
<h2 style="font-size: clamp(38px, 4vw, 52px); font-weight: 600; letter-spacing: -0.02em; line-height: 1.08; margin: 0px 0px 48px; max-width: 820px;">A spec-grade manufacturer, sized for both shelves.</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
<div style="background: rgb(255, 255, 255); border-radius: 16px; padding: 26px; display: flex; align-items: center; gap: 18px;"><svg height="52" style="flex: 0 0 auto;" viewbox="0 0 52 52" width="52"><circle cx="26" cy="26" fill="none" r="22" stroke="#E5E5E7" stroke-width="3"></circle><circle cx="26" cy="26" fill="none" r="22" stroke="#1D1D1F" stroke-dasharray="40 139" stroke-linecap="round" stroke-width="3" transform="rotate(-90 26 26)"></circle></svg><div><div style="font-size: 36px; font-weight: 600; letter-spacing: -0.03em;">1997</div><div style="font-size: 14px; color: rgb(110, 110, 115); margin-top: 2px;">Founded · Montclair, CA</div></div></div>
<div style="background: rgb(255, 255, 255); border-radius: 16px; padding: 26px; display: flex; align-items: center; gap: 18px;"><svg height="52" style="flex: 0 0 auto;" viewbox="0 0 52 52" width="52"><circle cx="26" cy="26" fill="none" r="22" stroke="#E5E5E7" stroke-width="3"></circle><circle cx="26" cy="26" fill="none" r="22" stroke="#1D1D1F" stroke-dasharray="120 139" stroke-linecap="round" stroke-width="3" transform="rotate(-90 26 26)"></circle></svg><div><div style="font-size: 36px; font-weight: 600; letter-spacing: -0.03em;">85M+</div><div style="font-size: 14px; color: rgb(110, 110, 115); margin-top: 2px;">Units shipped</div></div></div>
<div style="background: rgb(255, 255, 255); border-radius: 16px; padding: 26px; display: flex; align-items: center; gap: 18px;"><svg height="52" style="flex: 0 0 auto;" viewbox="0 0 52 52" width="52"><circle cx="26" cy="26" fill="none" r="22" stroke="#E5E5E7" stroke-width="3"></circle><circle cx="26" cy="26" fill="none" r="22" stroke="#1D1D1F" stroke-dasharray="62 139" stroke-linecap="round" stroke-width="3" transform="rotate(-90 26 26)"></circle></svg><div><div style="font-size: 36px; font-weight: 600; letter-spacing: -0.03em;">9</div><div style="font-size: 14px; color: rgb(110, 110, 115); margin-top: 2px;">National retail accounts</div></div></div>
<div style="background: rgb(255, 255, 255); border-radius: 16px; padding: 26px; display: flex; align-items: center; gap: 18px;"><svg height="52" style="flex: 0 0 auto;" viewbox="0 0 52 52" width="52"><circle cx="26" cy="26" fill="none" r="22" stroke="#E5E5E7" stroke-width="3"></circle><circle cx="26" cy="26" fill="none" r="22" stroke="#1D1D1F" stroke-dasharray="45 139" stroke-linecap="round" stroke-width="3" transform="rotate(-90 26 26)"></circle></svg><div><div style="font-size: 36px; font-weight: 600; letter-spacing: -0.03em;">6</div><div style="font-size: 14px; color: rgb(110, 110, 115); margin-top: 2px;">Retail aisles</div></div></div>
<div style="background: rgb(255, 255, 255); border-radius: 16px; padding: 26px; display: flex; align-items: center; gap: 18px;"><svg height="52" style="flex: 0 0 auto;" viewbox="0 0 52 52" width="52"><circle cx="26" cy="26" fill="none" r="22" stroke="#E5E5E7" stroke-width="3"></circle><circle cx="26" cy="26" fill="none" r="22" stroke="#1D1D1F" stroke-dasharray="83 139" stroke-linecap="round" stroke-width="3" transform="rotate(-90 26 26)"></circle></svg><div><div style="font-size: 36px; font-weight: 600; letter-spacing: -0.03em;">12</div><div style="font-size: 14px; color: rgb(110, 110, 115); margin-top: 2px;">US warehouses</div></div></div>
<div style="background: rgb(255, 255, 255); border-radius: 16px; padding: 26px; display: flex; align-items: center; gap: 18px;"><svg height="52" style="flex: 0 0 auto;" viewbox="0 0 52 52" width="52"><circle cx="26" cy="26" fill="none" r="22" stroke="#E5E5E7" stroke-width="3"></circle><circle cx="26" cy="26" fill="none" r="22" stroke="#1D1D1F" stroke-dasharray="62 139" stroke-linecap="round" stroke-width="3" transform="rotate(-90 26 26)"></circle></svg><div><div style="font-size: 36px; font-weight: 600; letter-spacing: -0.03em;">9</div><div style="font-size: 14px; color: rgb(110, 110, 115); margin-top: 2px;">C&amp;I brand families</div></div></div>
<div style="background: rgb(255, 255, 255); border-radius: 16px; padding: 26px; display: flex; align-items: center; gap: 18px;"><svg height="52" style="flex: 0 0 auto;" viewbox="0 0 52 52" width="52"><circle cx="26" cy="26" fill="none" r="22" stroke="#E5E5E7" stroke-width="3"></circle><circle cx="26" cy="26" fill="none" r="22" stroke="#1D1D1F" stroke-dasharray="55 139" stroke-linecap="round" stroke-width="3" transform="rotate(-90 26 26)"></circle></svg><div><div style="font-size: 36px; font-weight: 600; letter-spacing: -0.03em;">8</div><div style="font-size: 14px; color: rgb(110, 110, 115); margin-top: 2px;">Industry verticals</div></div></div>
<div style="background: rgb(255, 255, 255); border-radius: 16px; padding: 26px; display: flex; align-items: center; gap: 18px;"><svg height="52" style="flex: 0 0 auto;" viewbox="0 0 52 52" width="52"><circle cx="26" cy="26" fill="none" r="22" stroke="#E5E5E7" stroke-width="3"></circle><circle cx="26" cy="26" fill="none" r="22" stroke="#1D1D1F" stroke-dasharray="5 139" stroke-linecap="round" stroke-width="3" transform="rotate(-90 26 26)"></circle></svg><div><div style="font-size: 36px; font-weight: 600; letter-spacing: -0.03em;">0</div><div style="font-size: 14px; color: rgb(110, 110, 115); margin-top: 2px;">Channel-conflict incidents · by policy</div></div></div>
</div>
</div></section><section data-screen-label="03 The Two Channels" id="channels" style="padding: 104px 24px;">
<div style="max-width: 1200px; margin: 0px auto;">
<p style="font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(134, 134, 139); margin: 0px 0px 14px;">03 · The Two Channels</p>
<h2 style="font-size: clamp(38px, 4vw, 52px); font-weight: 600; letter-spacing: -0.02em; line-height: 1.08; margin: 0px 0px 48px;">One catalog. Two doors.</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 24px; align-items: start;">
<div style="border: 1px solid rgb(229, 229, 231); border-radius: 16px; padding: 32px;">
<svg fill="none" height="34" stroke="#86868B" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" style="margin-bottom: 14px;" viewbox="0 0 24 24" width="34"><rect height="18" rx="1" width="12" x="6" y="3"></rect><circle cx="15" cy="12" fill="#86868B" r="1" stroke="none"></circle><path d="M3 21h18"></path></svg>
<p style="font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(134, 134, 139); margin: 0px 0px 6px;">Door One</p>
<h3 style="font-size: clamp(24px, 2.4vw, 32px); font-weight: 600; letter-spacing: -0.02em; margin: 0px 0px 24px;">Retail · Consumer</h3>
<div style="display: grid; font-size: 15px; line-height: 1.45;">
<div style="display: grid; grid-template-columns: 24px 112px 1fr; gap: 12px; padding: 13px 0px; border-top: 1px solid rgb(229, 229, 231);"><svg fill="none" height="18" stroke="#86868B" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" style="margin-top: 2px;" viewbox="0 0 24 24" width="18"><circle cx="12" cy="8" r="3.5"></circle><path d="M5 20c.8-3.6 3.6-5.5 7-5.5s6.2 1.9 7 5.5"></path></svg><span style="font-size: 11.5px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: rgb(134, 134, 139); padding-top: 2px;">Buyer</span><span>National retail merchants and category buyers</span></div>
<div style="display: grid; grid-template-columns: 24px 112px 1fr; gap: 12px; padding: 13px 0px; border-top: 1px solid rgb(229, 229, 231);"><svg fill="none" height="18" stroke="#86868B" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" style="margin-top: 2px;" viewbox="0 0 24 24" width="18"><path d="M4 11.5V4h7.5L20 12.5 12.5 20z"></path><circle cx="8.5" cy="8.5" r="1.3"></circle></svg><span style="font-size: 11.5px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: rgb(134, 134, 139); padding-top: 2px;">Programs · Brand Families</span><span>House brand, co-brand, and OEM/white-label programs</span></div>
<div style="display: grid; grid-template-columns: 24px 112px 1fr; gap: 12px; padding: 13px 0px; border-top: 1px solid rgb(229, 229, 231);"><svg fill="none" height="18" stroke="#86868B" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" style="margin-top: 2px;" viewbox="0 0 24 24" width="18"><path d="M2 7h11v9H2zM13 10h4.5L20 13v3h-2.5"></path><circle cx="6.5" cy="17" r="1.7"></circle><circle cx="16" cy="17" r="1.7"></circle></svg><span style="font-size: 11.5px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: rgb(134, 134, 139); padding-top: 2px;">Distribution</span><span>9 national retail accounts · planogram replenishment</span></div>
<div style="display: grid; grid-template-columns: 24px 112px 1fr; gap: 12px; padding: 13px 0px; border-top: 1px solid rgb(229, 229, 231);"><svg fill="none" height="18" stroke="#86868B" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" style="margin-top: 2px;" viewbox="0 0 24 24" width="18"><path d="M5 20v-7M12 20V6M19 20V10"></path></svg><span style="font-size: 11.5px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: rgb(134, 134, 139); padding-top: 2px;">Scale</span><span>85M+ units shipped since 1997</span></div>
<div style="display: grid; grid-template-columns: 24px 112px 1fr; gap: 12px; padding: 13px 0px; border-top: 1px solid rgb(229, 229, 231);"><svg fill="none" height="18" stroke="#86868B" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" style="margin-top: 2px;" viewbox="0 0 24 24" width="18"><path d="M12 3l7 2.8v5.6c0 4.3-2.9 7.3-7 8.9-4.1-1.6-7-4.6-7-8.9V5.8z"></path></svg><span style="font-size: 11.5px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: rgb(134, 134, 139); padding-top: 2px;">Warranty</span><span>Retail program warranty, managed per account</span></div>
<div style="display: grid; grid-template-columns: 24px 112px 1fr; gap: 12px; padding: 13px 0px; border-top: 1px solid rgb(229, 229, 231);"><svg fill="none" height="18" stroke="#86868B" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" style="margin-top: 2px;" viewbox="0 0 24 24" width="18"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 7.5v9M14.5 9.3c-.6-.8-1.5-1.2-2.5-1.2-1.4 0-2.5.8-2.5 2s1 1.7 2.5 2 2.5.8 2.5 2-1.1 2-2.5 2c-1 0-1.9-.4-2.5-1.2"></path></svg><span style="font-size: 11.5px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: rgb(134, 134, 139); padding-top: 2px;">Pricing</span><span>Program pricing, negotiated per retailer</span></div>
<div style="display: grid; grid-template-columns: 24px 112px 1fr; gap: 12px; padding: 13px 0px; border-top: 1px solid rgb(229, 229, 231); border-bottom: 1px solid rgb(229, 229, 231);"><svg fill="none" height="18" stroke="#86868B" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" style="margin-top: 2px;" viewbox="0 0 24 24" width="18"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 7.5V12l3 2"></path></svg><span style="font-size: 11.5px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: rgb(134, 134, 139); padding-top: 2px;">Lead Time</span><span>Same-week replenishment from 12 US warehouses</span></div>
</div>

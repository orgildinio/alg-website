<!-- CFG-MAP-1: Leaflet warehouse-only map for /about Operations section -->
<script is:inline>
(function () {
  // Load Leaflet CSS
  var link = document.createElement('link');
  link.rel = 'stylesheet';
  link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
  link.integrity = 'sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=';
  link.crossOrigin = '';
  document.head.appendChild(link);

  var mapEl = document.getElementById('algAboutMap');
  if (!mapEl) return;

  var script = document.createElement('script');
  script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
  script.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
  script.crossOrigin = '';
  script.onload = async function () {
    var L = window.L;
    // Center on Southern California (Montclair/Riverside area), zoom 7
    var map = L.map('algAboutMap', { zoomControl: true, scrollWheelZoom: false }).setView([34.0, -117.7], 7);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 19,
    }).addTo(map);

    // Warehouse icon (brand red)
    function makeIcon(color, shadow) {
      return L.divIcon({
        className: '',
        html: '<div style="width:14px;height:14px;background:' + color + ';border-radius:50%;border:2px solid #fff;box-shadow:0 0 10px ' + shadow + ';"></div>',
        iconSize: [14, 14],
        iconAnchor: [7, 7],
        popupAnchor: [0, -10],
      });
    }
    var iconWh = makeIcon('#F32740', 'rgba(243,39,64,0.7)');

    // ALG warehouse locations only
    var warehouses = [
      { name: 'ALG HQ — Montclair, CA', role: 'HQ · Design · Sales · Customer Service', addr: '4615 State Street, Montclair, CA 91763', lat: 34.0736, lon: -117.6900 },
      { name: 'ALG US Production — Riverside, CA', role: 'US Production · Driver Assembly · Final QA · Branded Fulfillment', addr: '9345 Sycamore Canyon Blvd, Riverside, CA 92508', lat: 33.9806, lon: -117.3755 },
    ];

    warehouses.forEach(function (r) {
      var popup = '<div style="font-family:system-ui,sans-serif;min-width:180px;">' +
        '<div style="font-weight:700;font-size:13px;margin-bottom:4px;">' + r.name + '</div>' +
        '<div style="font-size:12px;color:#9CA3AF;margin-bottom:4px;">' + r.role + '</div>' +
        '<div style="font-size:11px;color:#6B7280;">' + r.addr + '</div>' +
        '</div>';
      L.marker([r.lat, r.lon], { icon: iconWh }).bindPopup(popup).addTo(map);
    });

    // CFG-MAP-1: invalidateSize after init so drag doesn't resize the section
    setTimeout(function () { map.invalidateSize(); }, 0);
  };
  document.head.appendChild(script);
})();
</script>

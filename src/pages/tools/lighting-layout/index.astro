    layout_id: 'ple_stub_8f3a2b',
    fixture_schedule: [
      { type: 'F1', sku: 'LRHB3W240-40-UNV', description: 'lamparⒶRCH Jupiter · 240W high-bay · 34,800 lm · 4000K', watts: 240, lumens: 34800, qty: 15, mount_ft: 24 }
    ],
    grid: { cols: 24, rows: 16, spacing_ft: 5, values: null }, // null = use illustrative render
    stats: { avg_fc: 32.1, min_fc: 21.0, max_fc: 47.4, uniformity_min_avg: 0.66, lpd_w_ft2: 0.38 },
    pass: true,
    target_fc: 30,
    render: { pdf_url: null, png_url: null, svg_url: null }, // null until ACC delivers signed URLs
    engine_version: 'ple-stub-1.0.0',
    computed_at: new Date().toISOString(),
    note: 'Preliminary layout for budgeting — not a stamped engineering plan.'
  };

  /* ---- State ---- */
  let currentLayoutId = null;
  let pendingDelivery = null; // 'pdf' | 'email'
  let currentApp = 'warehouse';
  let currentCCT = '4000K';

  /* ---- DOM refs ---- */
  const genBtn = document.getElementById('ll-genBtn');
  const calcOverlay = document.getElementById('ll-calcOverlay');
  const errorBanner = document.getElementById('ll-errorBanner');
  const errorMsg = document.getElementById('ll-errorMsg');
  const leadModal = document.getElementById('ll-leadModal');

  /* ---- Mode switch ---- */
  document.querySelectorAll('.ll-mode').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.ll-mode').forEach(b => b.classList.remove('on'));
      btn.classList.add('on');
      const m = btn.dataset.mode;
      document.getElementById('ll-m-engine').classList.toggle('ll-hide', m !== 'engine');
      document.getElementById('ll-m-pro').classList.toggle('ll-hide', m !== 'pro');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });

  /* ---- CCT chips ---- */
  document.querySelectorAll('.ll-chips').forEach(g => {
    g.querySelectorAll('.ll-chip').forEach(c => {
      c.addEventListener('click', () => {
        g.querySelectorAll('.ll-chip').forEach(x => x.classList.remove('on'));
        c.classList.add('on');
        currentCCT = c.dataset.cct;
      });
    });
  });

  /* ---- Application selector ---- */
  document.querySelectorAll('.ll-app').forEach(a => {
    a.addEventListener('click', () => {
      document.querySelectorAll('.ll-app').forEach(x => x.classList.remove('on'));
      a.classList.add('on');
      currentApp = a.dataset.app;
    });
  });

  /* ---- False-color heatmap renderer ---- */
  function falseColor(t) {
    const stops = [[43,58,143],[31,155,214],[25,178,122],[232,195,58],[239,125,46],[224,38,60]];
    t = Math.max(0, Math.min(1, t));
    const s = t * (stops.length - 1);
    const i = Math.floor(s);
    const f = s - i;
    const a = stops[i], b = stops[Math.min(i + 1, stops.length - 1)];
    return `rgb(${Math.round(a[0]+(b[0]-a[0])*f)},${Math.round(a[1]+(b[1]-a[1])*f)},${Math.round(a[2]+(b[2]-a[2])*f)})`;
  }

  function renderHeatFromGrid(gridValues, cols, rows) {
    const c = document.getElementById('ll-heat');
    const ctx = c.getContext('2d');
    const W = c.width, H = c.height;
    const cw = W / cols, ch = H / rows;
    let max = 0;
    for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) if (gridValues[y][x] > max) max = gridValues[y][x];
    for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) {
      ctx.fillStyle = falseColor(gridValues[y][x] / max);
      ctx.fillRect(x * cw, y * ch, cw + 1, ch + 1);
    }
  }

  function renderIllustrativeHeat(cols, rows, fixtureCount) {
    // Distribute fixtures evenly in a grid pattern
    const nx = Math.ceil(Math.sqrt(fixtureCount * (cols / rows)));
    const ny = Math.ceil(fixtureCount / nx);
    const FX = [], FY = [];
    for (let j = 0; j < ny; j++) for (let i = 0; i < nx; i++) {
      if (FX.length < fixtureCount) {
        FX.push((i + 0.5) * cols / nx);
        FY.push((j + 0.5) * rows / ny);
      }
    }
    const c = document.getElementById('ll-heat');
    const ctx = c.getContext('2d');
    const W = c.width, H = c.height;
    const cw = W / cols, ch = H / rows;
    let max = 0;
    const grid = [];
    for (let y = 0; y < rows; y++) {
      grid[y] = [];
      for (let x = 0; x < cols; x++) {
        let v = 0;
        for (let k = 0; k < FX.length; k++) {
          const dx = (x + 0.5 - FX[k]), dy = (y + 0.5 - FY[k]);
          v += 1 / ((dx * dx + dy * dy) * 0.5 + 1.1);
        }
        grid[y][x] = v;
        if (v > max) max = v;
      }
    }
    for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) {
      ctx.fillStyle = falseColor(grid[y][x] / max);
      ctx.fillRect(x * cw, y * ch, cw + 1, ch + 1);
    }
    // Draw fixture markers
    ctx.fillStyle = '#fff';
    ctx.strokeStyle = '#232930';
    ctx.lineWidth = 1.5;
    for (let k = 0; k < FX.length; k++) {
      ctx.beginPath();
      ctx.rect(FX[k] * cw - 4, FY[k] * ch - 4, 8, 8);
      ctx.fill();
      ctx.stroke();
    }
  }

  /* ---- Render result from ACC response ---- */
  function renderResult(data, inputs) {
    const { stats, pass, target_fc, fixture_schedule, grid, layout_id } = data;
    currentLayoutId = layout_id;

    // Title + pass chip
    const appLabel = { warehouse: 'Warehouse', area: 'Parking / Area', office: 'Office / Retail' }[inputs.application] || inputs.application;
    document.getElementById('ll-rTitle').textContent = `Layout · ${inputs.length_ft} ft × ${inputs.width_ft} ft · ${appLabel}`;
    const passChip = document.getElementById('ll-rPass');
    if (pass) {
      passChip.className = 'll-passchip pass';
      passChip.innerHTML = `<span class="dot"></span> PASS · ${stats.avg_fc.toFixed(1)} fc avg vs ${target_fc} target`;
    } else {
      passChip.className = 'll-passchip fail';
      passChip.innerHTML = `<span class="dot"></span> FAIL · ${stats.avg_fc.toFixed(1)} fc avg vs ${target_fc} target`;
    }

    // Stats
    document.getElementById('ll-sAvg').innerHTML = `${stats.avg_fc.toFixed(1)} <small>fc</small>`;
    document.getElementById('ll-sMin').innerHTML = `${stats.min_fc.toFixed(1)} <small>fc</small>`;
    document.getElementById('ll-sMax').innerHTML = `${stats.max_fc.toFixed(1)} <small>fc</small>`;
    document.getElementById('ll-sUni').textContent = stats.uniformity_min_avg.toFixed(2);
    document.getElementById('ll-sLPD').innerHTML = `${stats.lpd_w_ft2.toFixed(2)} <small>W/ft²</small>`;

    // Scale badge
    const totalQty = fixture_schedule.reduce((s, f) => s + f.qty, 0);
    document.getElementById('ll-rScale').textContent = `${grid.spacing_ft} ft grid · ${totalQty} fixtures`;
    document.getElementById('ll-rMax').textContent = `${Math.round(stats.max_fc)} fc`;
    document.getElementById('ll-rCount').textContent = `${totalQty} fixture${totalQty !== 1 ? 's' : ''}`;

    // Heatmap
    if (grid.values) {
      renderHeatFromGrid(grid.values, grid.cols, grid.rows);
    } else {
      renderIllustrativeHeat(grid.cols, grid.rows, totalQty);
    }

    // Fixture schedule
    const tbody = document.getElementById('ll-schedBody');
    tbody.innerHTML = fixture_schedule.map(f => `
      <tr>
        <td>${f.type}</td>
        <td class="sku">${f.sku}</td>
        <td>${f.description}</td>
        <td class="q">${f.qty}</td>
        <td>${f.mount_ft} ft</td>
      </tr>
    `).join('');
  }

  /* ---- Generate button ---- */
  genBtn.addEventListener('click', async () => {
    const L = parseFloat(document.getElementById('ll-L').value) || 120;
    const W = parseFloat(document.getElementById('ll-W').value) || 80;
    const MH = parseFloat(document.getElementById('ll-MH').value) || 24;
    const FC = parseFloat(document.getElementById('ll-FC').value) || 30;

    const inputs = {
      application: currentApp,
      length_ft: L,
      width_ft: W,
      mounting_height_ft: MH,
      target_fc: FC,
      cct: currentCCT,
      fixture_sku: null
    };

    const requestBody = {
      inputs,
      requester: {}, // anonymous on first generate; filled after email capture
      source: 'website',
      attribution: {
        utm_source: new URLSearchParams(window.location.search).get('utm_source'),
        utm_campaign: new URLSearchParams(window.location.search).get('utm_campaign'),
        referrer: document.referrer || null
      }
    };

    // Show calculating state
    genBtn.disabled = true;
    calcOverlay.classList.remove('ll-hide');
    errorBanner.classList.remove('show');

    try {
      let data;
      if (STUB_MODE) {
        // Stub: simulate network delay + return sample response
        await new Promise(r => setTimeout(r, 900));
        data = { ...STUB_RESPONSE, target_fc: FC, computed_at: new Date().toISOString() };
        // Adjust stub qty based on area (illustrative)
        const area = L * W;
        const stubQty = Math.max(4, Math.round(area / 640));
        data.fixture_schedule = [{ ...STUB_RESPONSE.fixture_schedule[0], qty: stubQty, mount_ft: MH }];
        data.stats = {
          avg_fc: FC * (0.9 + Math.random() * 0.3),
          min_fc: FC * (0.6 + Math.random() * 0.1),
          max_fc: FC * (1.4 + Math.random() * 0.2),
          uniformity_min_avg: 0.60 + Math.random() * 0.15,
          lpd_w_ft2: (240 * stubQty) / area
        };
        data.pass = data.stats.avg_fc >= FC;
      } else {
        // Live: POST to ACC
        const resp = await fetch(`${ACC_BASE}/auto-design`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(requestBody)
        });
        if (!resp.ok) {
          const err = await resp.json().catch(() => ({}));
          const code = err?.error?.code || 'ENGINE_ERROR';
          if (code === 'RATE_LIMITED') {
            const retry = err?.error?.retry_after_s;
            throw new Error(`Rate limit reached. Please try again${retry ? ` in ${retry} seconds` : ' shortly'}.`);
          }
          throw new Error(err?.error?.message || 'Engine error. Please try again.');
        }
        data = await resp.json();
      }

      renderResult(data, inputs);

    } catch (err) {
      errorMsg.innerHTML = `<b>Engine unavailable.</b> ${err.message || 'Please try again in a moment.'}`;
      errorBanner.classList.add('show');
    } finally {
      genBtn.disabled = false;
      calcOverlay.classList.add('ll-hide');
    }
  });

  /* ---- Delivery gate (email modal) ---- */
  ['ll-dlPdf', 'll-dlEmail'].forEach(id => {
    document.getElementById(id).addEventListener('click', e => {
      e.preventDefault();
      pendingDelivery = id === 'll-dlPdf' ? 'pdf' : 'email';
      leadModal.classList.add('show');
      document.getElementById('ll-mEmail').focus();
    });
  });

  document.getElementById('ll-modalClose').addEventListener('click', () => {
    leadModal.classList.remove('show');
  });
  leadModal.addEventListener('click', e => {
    if (e.target === leadModal) leadModal.classList.remove('show');
  });

  document.getElementById('ll-modalSubmit').addEventListener('click', () => {
    const email = document.getElementById('ll-mEmail').value.trim();
    if (!email || !email.includes('@')) {
      document.getElementById('ll-mEmail').focus();
      return;
    }
    const requester = {
      name: document.getElementById('ll-mName').value.trim(),
      email,
      company: document.getElementById('ll-mCompany').value.trim(),
      type: document.getElementById('ll-mType').value,
      rep_code: document.getElementById('ll-mRepCode').value.trim() || null
    };

    if (STUB_MODE) {
      // Stub: simulate email delivery
      leadModal.classList.remove('show');
      if (pendingDelivery === 'email') {
        alert(`Layout will be emailed to ${email}. (Stub mode — ACC email delivery not yet wired.)`);
      } else {
        alert(`Download will begin shortly. (Stub mode — ACC signed URL not yet available.)`);
      }
    } else {
      // Live: POST claim to ACC with layout_id + requester
      fetch(`${ACC_BASE}/auto-design`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ layout_id: currentLayoutId, requester, action: pendingDelivery })
      }).then(() => {
        leadModal.classList.remove('show');
        if (pendingDelivery === 'pdf' && currentLayoutId) {
          // Trigger download via render URL (ACC returns signed URL)
          window.open(`${ACC_BASE}/export?layout_id=${currentLayoutId}&format=pdf`, '_blank');
        }
      }).catch(() => {
        leadModal.classList.remove('show');
      });
    }
  });

  /* ---- Pro form branch switch (Interior / Exterior / Both) ---- */
  document.querySelectorAll('#ll-branchSwitch .bs').forEach(b => {
    b.addEventListener('click', () => {
      document.querySelectorAll('#ll-branchSwitch .bs').forEach(x => x.classList.remove('on'));
      b.classList.add('on');
      const br = b.dataset.branch;
      document.getElementById('ll-branch-interior').classList.toggle('ll-hide', !(br === 'interior' || br === 'both'));
      document.getElementById('ll-branch-exterior').classList.toggle('ll-hide', !(br === 'exterior' || br === 'both'));
    });
  });

  /* ---- Checkboxes ---- */
  document.querySelectorAll('.ll-cb').forEach(c => {
    c.addEventListener('click', () => {
      c.classList.toggle('on');
      c.querySelector('.bx').textContent = c.classList.contains('on') ? '✓' : '';
    });
  });

  /* ---- File upload zone ---- */
  const uploadZone = document.getElementById('ll-uploadZone');
  const fileInput = document.getElementById('ll-fileInput');
  const fileList = document.getElementById('ll-fileList');
  uploadZone.addEventListener('click', () => fileInput.click());
  uploadZone.addEventListener('dragover', e => { e.preventDefault(); uploadZone.style.borderColor = 'var(--ll-red)'; });
  uploadZone.addEventListener('dragleave', () => { uploadZone.style.borderColor = ''; });
  uploadZone.addEventListener('drop', e => {
    e.preventDefault();
    uploadZone.style.borderColor = '';
    handleFiles(e.dataTransfer.files);
  });
  fileInput.addEventListener('change', () => handleFiles(fileInput.files));
  function handleFiles(files) {
    fileList.innerHTML = Array.from(files).map(f =>
      `<div style="padding:4px 0;">📄 ${f.name} <span style="color:var(--ll-ink3);">(${(f.size/1024).toFixed(0)} KB)</span></div>`
    ).join('');
  }

  /* ---- Pro form submit ---- */
  document.getElementById('ll-proForm').addEventListener('submit', e => {
    e.preventDefault();
    const form = e.target;
    const data = Object.fromEntries(new FormData(form));
    // Collect checked submission items
    const checkedItems = Array.from(document.querySelectorAll('.ll-cb.on')).map(c => c.textContent.trim());
    data.included_items = checkedItems;
    data.project_scope = document.querySelector('#ll-branchSwitch .bs.on')?.dataset.branch || 'interior';

    if (STUB_MODE) {
      // Stub: mailto fallback
      const subject = encodeURIComponent(`Professional Layout Request: ${data.project_name || 'New Project'}`);
      const body = encodeURIComponent(
        `Name: ${data.name}\nCompany: ${data.company}\nEmail: ${data.email}\nPhone: ${data.phone || ''}\n` +
        `Project: ${data.project_name}\nScope: ${data.project_scope}\nRequest type: ${data.request_type}\n` +
        `Notes: ${data.notes || ''}`
      );
      window.location.href = `mailto:layouts@archipelagolighting.com?subject=${subject}&body=${body}`;
    } else {
      // Live: POST to layout team endpoint (TBD — confirm with ACC)
      fetch('/api/layout-request', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      }).then(() => {
        document.getElementById('ll-proForm').style.display = 'none';
        document.getElementById('ll-proSuccess').classList.add('show');
      }).catch(() => {
        // Fallback to mailto
        const subject = encodeURIComponent(`Professional Layout Request: ${data.project_name || 'New Project'}`);
        window.location.href = `mailto:layouts@archipelagolighting.com?subject=${subject}`;
      });
    }
  });

  /* ---- Initial illustrative render ---- */
  renderIllustrativeHeat(24, 16, 15);

})();
</script>

</BaseLayout>

            <li>Footcandle map — avg / min / max / uniformity</li>
            <li>Power density (W/ft²) vs energy code</li>
            <li>EM / egress overlay where required</li>
          </ul>
        </div>
        <div class="ll-dcard">
          <h4>Deliverable preview</h4>
          <div class="ll-drow"><span class="di">PDF</span><span class="dn">Photometric_Layout.pdf</span><span style="font-family:var(--ll-mono);font-size:10px;color:var(--ll-ink3);">7 pp</span></div>
          <div class="ll-drow"><span class="di">IES</span><span class="dn">Fixture_IES_Files.zip</span><span style="font-family:var(--ll-mono);font-size:10px;color:var(--ll-ink3);">12</span></div>
          <div class="ll-drow"><span class="di">CSV</span><span class="dn">Bill_of_Materials.csv</span><span style="font-family:var(--ll-mono);font-size:10px;color:var(--ll-ink3);">edit</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- LEAD CAPTURE MODAL -->
<div class="ll-modal-back" id="ll-leadModal" role="dialog" aria-modal="true" aria-labelledby="ll-modalTitle">
  <div class="ll-modal">
    <button class="x" id="ll-modalClose" aria-label="Close">×</button>
    <h3 id="ll-modalTitle">Get your layout</h3>
    <p>View is free — pop in your email to download or send the full ALG-watermarked layout. We'll have a rep follow up only if you want.</p>
    <div class="ll-fld">
      <label style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--ll-ink2);">Name</label>
      <input type="text" id="ll-mName" placeholder="Sarah Reyes" style="width:100%;padding:10px 12px;border:1px solid var(--ll-line);border-radius:7px;margin-top:6px;">
    </div>
    <div class="ll-fld">
      <label style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--ll-ink2);">Work email <span style="color:var(--ll-red);">*</span></label>
      <input type="email" id="ll-mEmail" placeholder="sarah@company.com" required style="width:100%;padding:10px 12px;border:1px solid var(--ll-line);border-radius:7px;margin-top:6px;">
    </div>
    <div class="ll-fld">
      <label style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--ll-ink2);">Company</label>
      <input type="text" id="ll-mCompany" placeholder="Midwest Cold Logistics" style="width:100%;padding:10px 12px;border:1px solid var(--ll-line);border-radius:7px;margin-top:6px;">
    </div>
    <div class="ll-fld">
      <label style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--ll-ink2);">I am a</label>
      <select id="ll-mType" style="width:100%;padding:10px 12px;border:1px solid var(--ll-line);border-radius:7px;margin-top:6px;font-family:'Lato',sans-serif;font-size:14px;">
        <option value="customer">Customer / End user</option>
        <option value="rep">Sales rep / Distributor</option>
        <option value="specifier">Specifier / Engineer</option>
        <option value="contractor">Contractor / ESCO</option>
      </select>
    </div>
    <div class="ll-fld">
      <label style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--ll-ink2);">ALG rep code <span style="color:var(--ll-ink3);font-weight:400;text-transform:none;">(optional — tags layout to your rep)</span></label>
      <input type="text" id="ll-mRepCode" placeholder="if a rep sent you" style="width:100%;padding:10px 12px;border:1px solid var(--ll-line);border-radius:7px;margin-top:6px;">
    </div>
    <button class="ll-modal-submit" id="ll-modalSubmit">Get my layout</button>
  </div>
</div>

<script>
/* ================================================================
   LIGHTING LAYOUT TOOL — client-side controller
   ACC PLE API: https://alg-command-center.onrender.com/api/public/ple
   Contract: 2026-06-18_ACC-PLE_public_API_contract.md (live, no stub)
   ================================================================ */

(function() {
  'use strict';

  /* ---- ACC API config (LIVE) ---- */
  const ACC_BASE = 'https://alg-command-center.onrender.com/api/public/ple';

  /* ---- Application type map: UI key → ACC applicationType ---- */
  const APP_TYPE = {
    warehouse: 'warehouse',
    area: 'parking',
    office: 'office'
  };

  /* ---- State ---- */
  let currentLayoutId = null;
  let pendingDelivery = null; // 'pdf'
  let currentApp = 'warehouse';
  let currentCCT = '4000K';

  /* ---- DOM refs ---- */
  const genBtn = document.getElementById('ll-genBtn');
  const calcOverlay = document.getElementById('ll-calcOverlay');
  const errorBanner = document.getElementById('ll-errorBanner');
  const errorMsg = document.getElementById('ll-errorMsg');
  const leadModal = document.getElementById('ll-leadModal');

  /* ---- Mode switch ---- */
  document.querySelectorAll('.ll-mode').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.ll-mode').forEach(b => b.classList.remove('on'));
      btn.classList.add('on');
      const m = btn.dataset.mode;
      document.getElementById('ll-m-engine').classList.toggle('ll-hide', m !== 'engine');
      document.getElementById('ll-m-pro').classList.toggle('ll-hide', m !== 'pro');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });

  /* ---- CCT chips ---- */
  document.querySelectorAll('.ll-chips').forEach(g => {
    g.querySelectorAll('.ll-chip').forEach(c => {
      c.addEventListener('click', () => {
        g.querySelectorAll('.ll-chip').forEach(x => x.classList.remove('on'));
        c.classList.add('on');
        currentCCT = c.dataset.cct;
        scheduleRefetch();
      });
    });
  });

  /* ---- Application selector ---- */
  document.querySelectorAll('.ll-app').forEach(a => {
    a.addEventListener('click', () => {
      document.querySelectorAll('.ll-app').forEach(x => x.classList.remove('on'));
      a.classList.add('on');
      currentApp = a.dataset.app;
      scheduleRefetch();
    });
  });

  /* ---- Debounced re-fetch ---- */
  let _refetchTimer = null;
  function scheduleRefetch() {
    if (_refetchTimer) clearTimeout(_refetchTimer);
    // Show a brief "Calculating…" to signal something is happening
    calcOverlay.classList.remove('ll-hide');
    _refetchTimer = setTimeout(() => { genBtn.click(); }, 500);
  }

  // Wire dimension / mount / fc inputs to auto-refetch
  ['ll-L', 'll-W', 'll-MH', 'll-FC'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('input', scheduleRefetch);
  });

  /* ---- Clear result area ---- */
  function clearResult(msg) {
    document.querySelector('.ll-result').classList.add('ll-hide');
    errorMsg.innerHTML = msg;
    errorBanner.classList.add('show');
  }

  /* ---- Plot render — ACC /export SVG (ACC #85 contract) ---- */

  // Fetch the report-grade SVG from ACC /export and render it inline in #ll-plotArea.
  // Called after every successful /solve with the returned handle.
  async function renderPlot(handle) {
    const plotArea = document.getElementById('ll-plotArea');
    if (!handle) { plotArea.innerHTML = ''; return; }
    try {
      const resp = await fetch(`${ACC_BASE}/export`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ handle })
      });
      if (!resp.ok) throw new Error('export-failed');
      const svgText = await resp.text();
      plotArea.innerHTML = svgText;
    } catch (_) {
      // Export failed — clear the plot area silently (stats/schedule still visible)
      plotArea.innerHTML = '';
    }
  }

  /* ---- Render result from ACC response (live contract) ---- */
  function renderResult(data, inputs) {
    const { stats, pass, fixture, schedule, energy } = data;
    const targetFc = inputs.targetFc;

    // Title + pass chip
    const appLabel = { warehouse: 'Warehouse', area: 'Parking / Area', office: 'Office / Retail' }[inputs.application] || inputs.application;
    document.getElementById('ll-rTitle').textContent = `Layout · ${inputs.lengthFt} ft × ${inputs.widthFt} ft · ${appLabel}`;
    const passChip = document.getElementById('ll-rPass');
    const avgFc = stats?.avgFc ?? stats?.avg ?? stats?.avg_fc ?? 0;
    const minFc = stats?.minFc ?? stats?.min ?? stats?.min_fc ?? 0;
    const maxFc = stats?.maxFc ?? stats?.max ?? stats?.max_fc ?? 0;
    const uni   = data?.uniformity?.avgMinRatio ?? stats?.uniformity ?? stats?.uniformity_min_avg ?? 0;
    const lpd   = energy?.wPerSqFt ?? 0;
    const ashraeLimit = energy?.ashraeLimit ?? null;
    const lpdOk = energy?.lpdCompliant ?? null;
    if (pass) {
      passChip.className = 'll-passchip pass';
      passChip.innerHTML = `<span class="dot"></span> PASS · ${avgFc.toFixed(1)} fc avg vs ${targetFc} target`;
    } else {
      passChip.className = 'll-passchip fail';
      passChip.innerHTML = `<span class="dot"></span> FAIL · ${avgFc.toFixed(1)} fc avg vs ${targetFc} target`;
    }

    // Stats
    document.getElementById('ll-sAvg').innerHTML = `${avgFc.toFixed(1)} <small>fc</small>`;
    document.getElementById('ll-sMin').innerHTML = `${minFc.toFixed(1)} <small>fc</small>`;
    document.getElementById('ll-sMax').innerHTML = `${maxFc.toFixed(1)} <small>fc</small>`;
    document.getElementById('ll-sUni').textContent = uni.toFixed(2);
    const lpdEl = document.getElementById('ll-sLPD');
    if (lpdOk === null) {
      lpdEl.innerHTML = `${lpd.toFixed(2)} <small>W/ft²</small>`;
    } else if (lpdOk) {
      lpdEl.innerHTML = `${lpd.toFixed(2)} <small>W/ft²</small> <span style="color:var(--ll-grn);font-size:11px;font-weight:700;">✓ ASHRAE</span>`;
    } else {
      lpdEl.innerHTML = `${lpd.toFixed(2)} <small>W/ft²</small> <span style="color:var(--ll-red);font-size:11px;font-weight:700;">✗ over ${ashraeLimit}</span>`;
    }

    // Schedule: ACC returns either an array (multi-fixture) or a single object {symbol,sku,name,qty,...}
    const schedArr = Array.isArray(schedule)
      ? schedule
      : (schedule && schedule.sku ? [schedule] : null);
    const rows = schedArr || (fixture ? [{ type: 'F1', sku: fixture.sku || fixture, description: fixture.name || fixture.description || fixture.sku || fixture, qty: fixture.qty, mountFt: inputs.mountHeightFt }] : []);
    const totalQty = rows.reduce((s, r) => s + (r.qty || 0), 0);
    document.getElementById('ll-rScale').textContent = `${totalQty} fixture${totalQty !== 1 ? 's' : ''}`;
    document.getElementById('ll-rMax').textContent = `${Math.round(maxFc)} fc`;
    document.getElementById('ll-rCount').textContent = `${totalQty} fixture${totalQty !== 1 ? 's' : ''}`;

    // Plot — ACC /export SVG rendered inline (ACC #85); fired in parallel after /solve
    renderPlot(data.handle);

    // Fixture schedule
    const tbody = document.getElementById('ll-schedBody');
    tbody.innerHTML = rows.map((r, i) => `
      <tr>
        <td>F${i + 1}</td>
        <td class="sku">${r.sku || ''}</td>
        <td>${r.description || r.name || r.sku || ''}</td>
        <td class="q">${r.qty || ''}</td>
        <td>${r.mountFt ?? inputs.mountHeightFt} ft</td>
      </tr>
    `).join('');

    // Scroll result into view
    document.querySelector('.ll-result').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  /* ---- Generate button ---- */
  genBtn.addEventListener('click', async () => {
    const lengthFt = parseFloat(document.getElementById('ll-L').value) || 120;
    const widthFt  = parseFloat(document.getElementById('ll-W').value) || 80;
    const mountHeightFt = parseFloat(document.getElementById('ll-MH').value) || 24;
    const targetFc = parseFloat(document.getElementById('ll-FC').value) || 30;

    const requestBody = {
      applicationType: APP_TYPE[currentApp] || 'warehouse',
      lengthFt,
      widthFt,
      targetFc,
      mountHeightFt,
      cct: currentCCT,
      requester: { name: 'anonymous', email: 'anonymous@archipelagolighting.com', company: 'anonymous' }, // enriched after email capture
      source: 'website'
    };

    // Show calculating state
    genBtn.disabled = true;
    calcOverlay.classList.remove('ll-hide');
    errorBanner.classList.remove('show');

    try {
      // --- fetch: tag network/transport failures before they reach the outer catch ---
      let resp;
      try {
        resp = await fetch(`${ACC_BASE}/solve`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(requestBody)
        });
      } catch (_fetchErr) {
        // Network error, CORS block, DNS failure, or timeout — NOT a catalog gap
        throw new Error('__TRANSPORT__');
      }

      // --- HTTP status routing ---
      if (resp.status === 429) {
        // Rate limit — honest, transient, not a catalog gap
        throw new Error('__RATE_LIMIT__');
      }
      if (resp.status === 403) {
        throw new Error('Origin not authorized. Please use this tool at archipelagolighting.com.');
      }
      if (resp.status === 422) {
        // Genuine engine validation error — BAD_INPUT or AREA_BOUND
        const err = await resp.json().catch(() => ({}));
        const code = err?.error?.code || '';
        if (code === 'AREA_BOUND') throw new Error('Room dimensions exceed the maximum allowed area (400,000 sq ft).');
        throw new Error(err?.error?.message || 'Invalid input. Please check your dimensions and target footcandles.');
      }
      if (!resp.ok) {
        // 404, 5xx, 503, or any other non-200 non-422 → service/transport failure, NOT a catalog gap
        throw new Error('__TRANSPORT__');
      }

      const data = await resp.json();

      // --- #96: outcome-based routing (200-response class) ---
      // Compose with #94 transport/422 routing above — this handles valid 200 responses only.
      if (data.outcome === 'no_efficient_match') {
        // Engine returned a verdict: no efficient match exists for these inputs.
        // Render the honest panel using API-provided copy — never invent copy.
        const nem = data.noEfficientMatch || {};
        const headline = nem.headline || 'No efficient match for these inputs.';
        const detail = nem.detail || '';
        const bestOption = nem.bestOption || '';
        const whatWeCanDo = nem.whatWeCanDo || '';
        const proUrl = nem.professionalRequestUrl || null;
        const proLink = proUrl
          ? `<a href="${proUrl}" class="ll-mode-link" data-mode="pro">Request a Professional Layout</a>`
          : `<a href="#" class="ll-mode-link" data-mode="pro">Request a Professional Layout</a>`;
        errorMsg.innerHTML = [
          `<b>${headline}</b>`,
          detail ? `<br>${detail}` : '',
          bestOption ? `<br><span class="ll-nem-best">${bestOption}</span>` : '',
          whatWeCanDo ? `<br>${whatWeCanDo}` : '',
          `<br>${proLink} for a full stamped set.`
        ].filter(Boolean).join('');
        document.querySelector('.ll-result').classList.add('ll-hide');
        errorBanner.classList.add('show');
        genBtn.disabled = false;
        calcOverlay.classList.add('ll-hide');
        return; // do not fall through to renderResult
      }
      // outcome === 'ok' OR outcome is absent (old response shape) → render normally
      // If outcome is absent, behave exactly as before #96 (defensive fallback).

      currentLayoutId = data.handle;
      // Clear any previous error before rendering
      errorBanner.classList.remove('show');
      document.querySelector('.ll-result').classList.remove('ll-hide');
      renderResult(data, { application: currentApp, lengthFt, widthFt, mountHeightFt, targetFc });
      // meetsTarget:false — render with a visible note
      if (data.meetsTarget === false) {
        const note = document.getElementById('ll-rPass');
        const existing = note ? note.textContent : '';
        if (note) {
          note.className = 'll-passchip warn';
          note.innerHTML = `<span class="dot"></span> Closest match — does not fully meet your target footcandles.`;
        }
      }

    } catch (err) {
      // Clear stale result so the wrong layout is never shown
      document.querySelector('.ll-result').classList.add('ll-hide');

      const msg = err.message || '';

      if (msg === '__TRANSPORT__') {
        // Transport / service failure — honest fallback, never a catalog-gap claim
        errorMsg.innerHTML = `<b>The layout engine is temporarily unavailable.</b> <a href="#" class="ll-mode-link" data-mode="pro">Request a Professional Layout</a> and we'll run it for you — same inputs, full stamped set.`;
      } else if (msg === '__RATE_LIMIT__') {
        // 429 — high demand, transient
        errorMsg.innerHTML = `<b>High demand right now</b> — try again in a minute, or <a href="#" class="ll-mode-link" data-mode="pro">request a Professional Layout</a>.`;
      } else if (msg === '__NO_MATCH__' || msg === '') {
        // Genuine no-match from a valid 200 with no fixture result
        errorMsg.innerHTML = `<b>No matching ALG fixture for these inputs yet.</b> Try adjusting your space, mounting height, or target footcandles — or <a href="#" class="ll-mode-link" data-mode="pro">request a Professional Layout</a> for a full stamped set.`;
      } else {
        // Named engine errors: AREA_BOUND, BAD_INPUT, Origin not authorized, etc.
        errorMsg.innerHTML = `<b>Engine unavailable.</b> ${msg}`;
      }
      errorBanner.classList.add('show');
    } finally {
      genBtn.disabled = false;
      calcOverlay.classList.add('ll-hide');
    }
  });

  /* ---- Delivery gate (email modal) ---- */
  document.getElementById('ll-dlPdf').addEventListener('click', e => {
    e.preventDefault();
    pendingDelivery = 'pdf';
    leadModal.classList.add('show');
    document.getElementById('ll-mEmail').focus();
  });

  document.getElementById('ll-modalClose').addEventListener('click', () => {
    leadModal.classList.remove('show');
  });
  leadModal.addEventListener('click', e => {
    if (e.target === leadModal) leadModal.classList.remove('show');
  });

  document.getElementById('ll-modalSubmit').addEventListener('click', async () => {
    const email = document.getElementById('ll-mEmail').value.trim();
    if (!email || !email.includes('@')) {
      document.getElementById('ll-mEmail').focus();
      return;
    }
    const name    = document.getElementById('ll-mName').value.trim();
    const company = document.getElementById('ll-mCompany').value.trim();
    const repCode = document.getElementById('ll-mRepCode').value.trim() || undefined;

    leadModal.classList.remove('show');

    if (pendingDelivery === 'pdf' && currentLayoutId) {
      // POST /export → returns image/svg+xml (ALG-watermarked server-side)
      // Open in new tab and let the browser print-to-PDF
      try {
        const resp = await fetch(`${ACC_BASE}/export`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            handle: currentLayoutId,
            requester: { name, email, company, repCode }
          })
        });
        if (!resp.ok) throw new Error('Export failed');
        const svg = await resp.text();
        const blob = new Blob([svg], { type: 'image/svg+xml' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `alg-layout-${currentLayoutId}.svg`;
        a.click();
        URL.revokeObjectURL(url);
      } catch (e) {
        errorMsg.innerHTML = `<b>Export unavailable.</b> Please try again in a moment.`;
        errorBanner.classList.add('show');
      }
    }
  });

  /* ---- .ll-mode-link delegated handler ---- */
  document.addEventListener('click', e => {
    const link = e.target.closest('.ll-mode-link');
    if (!link) return;
    e.preventDefault();
    const mode = link.dataset.mode;
    if (!mode) return;
    document.querySelectorAll('.ll-mode').forEach(b => b.classList.toggle('on', b.dataset.mode === mode));
    document.getElementById('ll-m-engine').classList.toggle('ll-hide', mode !== 'engine');
    document.getElementById('ll-m-pro').classList.toggle('ll-hide', mode !== 'pro');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  /* ============================================================
     PRO FORM — branch switch, checkboxes, upload, multipart POST
     POST multipart/form-data:
       text part  "payload" = JSON string (full camelCase schema)
       binary parts "files[]" = one per attached file
     ACC endpoint: POST /professional-request
     ============================================================ */
  (function initProForm() {
    const proForm    = document.getElementById('ll-proForm');
    const proSubmit  = document.getElementById('ll-proSubmit');
    const proSuccess = document.getElementById('ll-proSuccess');
    const proHandle  = document.getElementById('ll-proHandle');
    const proError   = document.getElementById('ll-proError');
    const proRetry   = document.getElementById('ll-proRetry');
    const proSpinner = document.getElementById('ll-proSpinner');
    const branchSwitch = document.getElementById('ll-branchSwitch');
    const uploadZone = document.getElementById('ll-uploadZone');
    const fileInput  = document.getElementById('ll-fileInput');
    const fileList   = document.getElementById('ll-fileList');
    if (!proForm) return;

    let currentBranch = 'interior';
    let attachedFiles = [];

    /* Branch switch */
    branchSwitch.querySelectorAll('.bs').forEach(b => {
      b.addEventListener('click', () => {
        branchSwitch.querySelectorAll('.bs').forEach(x => x.classList.remove('on'));
        b.classList.add('on');
        currentBranch = b.dataset.branch;
        const showInt = currentBranch === 'interior' || currentBranch === 'both';
        const showExt = currentBranch === 'exterior' || currentBranch === 'both';
        document.getElementById('ll-branch-interior').classList.toggle('ll-hide', !showInt);
        document.getElementById('ll-branch-exterior').classList.toggle('ll-hide', !showExt);
      });
    });

    /* Included-files checkboxes */
    document.querySelectorAll('.ll-cb').forEach(cb => {
      cb.addEventListener('click', () => {
        cb.classList.toggle('on');
        const bx = cb.querySelector('.bx');
        if (bx) bx.textContent = cb.classList.contains('on') ? '\u2713' : '';
      });
    });

    /* Upload zone */
    uploadZone.addEventListener('click', () => fileInput.click());
    uploadZone.addEventListener('dragover', e => { e.preventDefault(); uploadZone.style.borderColor = 'var(--ll-red)'; });
    uploadZone.addEventListener('dragleave', () => { uploadZone.style.borderColor = ''; });
    uploadZone.addEventListener('drop', e => {
      e.preventDefault();
      uploadZone.style.borderColor = '';
      addFiles(e.dataTransfer.files);
    });
    fileInput.addEventListener('change', () => addFiles(fileInput.files));

    function addFiles(fl) {
      Array.from(fl).forEach(f => {
        if (!attachedFiles.find(x => x.name === f.name && x.size === f.size)) attachedFiles.push(f);
      });
      renderFileList();
    }
    function renderFileList() {
      fileList.innerHTML = attachedFiles.map((f, i) =>
        `<div style="display:flex;align-items:center;gap:8px;padding:4px 0;">
          <span>${f.name}</span>
          <span style="color:var(--ll-ink3);">(${(f.size/1024).toFixed(0)} KB)</span>
          <button type="button" onclick="this.closest('div').remove()" data-i="${i}"
            style="background:none;border:none;color:var(--ll-red);cursor:pointer;font-size:11px;">remove</button>
        </div>`
      ).join('');
      /* sync attachedFiles when remove clicked */
      fileList.querySelectorAll('button[data-i]').forEach(btn => {
        btn.addEventListener('click', () => {
          attachedFiles.splice(parseInt(btn.dataset.i), 1);
          renderFileList();
        });
      });
    }

    /* Build the payload JSON from the form */
    function buildPayload(fd) {
      const v = name => fd.get(name) || undefined;

      /* attachmentManifest: string[] of checked label text (not a boolean map) */
      const attachmentManifest = [];
      document.querySelectorAll('.ll-cb').forEach(cb => {
        if (cb.classList.contains('on')) {
          // label text is the last text node inside the cb span
          const label = cb.textContent.replace(/^[\s✓]+/, '').trim();
          if (label) attachmentManifest.push(label);
        }
      });

      /* reflectances: parse "80/50/20" → {C, W, F} as 0–1 fractions */
      const rfRaw = v('int_reflectance') || '';
      const rfParts = rfRaw.split('/').map(n => parseFloat(n));
      const reflectancesC = isNaN(rfParts[0]) ? undefined : rfParts[0] / 100;
      const reflectancesW = isNaN(rfParts[1]) ? undefined : rfParts[1] / 100;
      const reflectancesF = isNaN(rfParts[2]) ? undefined : rfParts[2] / 100;

      /* Fold notesShort into additionalNotes */
      const notes = [v('additionalNotes'), v('notesShort')].filter(Boolean).join(' | ') || undefined;

      /* Build flat payload — matches ACC .strict() schema exactly */
      const payload = {
        source: 'website-professional',
        projectName: v('projectName'),
        scope: currentBranch,
        requestType: v('requestType') || 'Standard',
        needBy: v('needBy') || undefined,
        requiredDeliverables: (v('requiredDeliverables') || 'All').split(','),
        requiredSoftware: v('requiredSoftware') || undefined,
        requester: {
          name: v('name'),
          email: v('email'),
          company: v('company'),
          phone: v('phone') || undefined,
          role: v('role') || undefined,
          repCode: v('repCode') || undefined,
        },
        attachmentManifest: attachmentManifest.length ? attachmentManifest : undefined,
        additionalNotes: notes,
        /* Interior fields — flat top-level (no interior{} wrapper) */
        projectType:      (currentBranch === 'interior' || currentBranch === 'both') ? (v('int_projectType') || undefined) : undefined,
        fcRequirement:    (currentBranch === 'interior' || currentBranch === 'both') ? (v('int_fcRequirements') || undefined) : undefined,
        ceilingHeights:   (currentBranch === 'interior' || currentBranch === 'both') ? (v('int_ceilingHeights') || undefined) : undefined,
        pendantHeights:   (currentBranch === 'interior' || currentBranch === 'both') ? (v('int_pendantHeights') || undefined) : undefined,
        warehouseRacking: (currentBranch === 'interior' || currentBranch === 'both') ? (v('int_warehouseRacking') || undefined) : undefined,
        cove:             (currentBranch === 'interior' || currentBranch === 'both') ? (v('int_cove') || undefined) : undefined,
        cct:              (currentBranch === 'interior' || currentBranch === 'both') ? (v('int_cct') || undefined) : undefined,
        emLayouts:        (currentBranch === 'interior' || currentBranch === 'both') ? (v('int_emLayouts') || undefined) : undefined,
        emergencyPower:   (currentBranch === 'interior' || currentBranch === 'both') ? (v('int_emergencyPower') || undefined) : undefined,
        egressPath:       (currentBranch === 'interior' || currentBranch === 'both') ? (v('int_egressPath') || undefined) : undefined,
        reflectances:     (currentBranch === 'interior' || currentBranch === 'both') && (reflectancesC !== undefined || reflectancesW !== undefined || reflectancesF !== undefined)
                            ? { C: reflectancesC, W: reflectancesW, F: reflectancesF }
                            : undefined,
        /* Exterior fields — ext-prefixed flat (no exterior{} wrapper) */
        extProjectType:   (currentBranch === 'exterior' || currentBranch === 'both') ? (v('ext_projectType') || undefined) : undefined,
        extFcRequirement: (currentBranch === 'exterior' || currentBranch === 'both') ? (v('ext_fcRequirements') || undefined) : undefined,
        extCct:           (currentBranch === 'exterior' || currentBranch === 'both') ? (v('ext_cct') || undefined) : undefined,
        mountingHeights:  (currentBranch === 'exterior' || currentBranch === 'both') ? (v('ext_mountingHeights') || undefined) : undefined,
        tiltAllowed:      (currentBranch === 'exterior' || currentBranch === 'both') ? (v('ext_tiltAllowed') === 'true') : undefined,
        lightSpillLimits: (currentBranch === 'exterior' || currentBranch === 'both') ? (v('ext_lightSpill') || undefined) : undefined,
        darkSky:          (currentBranch === 'exterior' || currentBranch === 'both') ? (v('ext_darkSky') === 'true') : undefined,
      };

      /* Strip undefined keys so .strict() doesn't see them */
      return JSON.parse(JSON.stringify(payload));
    }

    /* Submit handler — POST application/json, body ≤ 16 KB, no file bytes */
    async function submitPro() {
      proError.classList.remove('show');
      proSpinner.classList.add('show');
      proSubmit.disabled = true;

      const fd = new FormData(proForm);
      const payload = buildPayload(fd);

      try {
        /* POST to the CF Pages Function proxy — never browser-direct to ACC */
        const resp = await fetch('/api/ple/professional-request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const json = await resp.json().catch(() => ({}));
        if (!resp.ok) throw new Error(json?.error?.message || json?.error || 'Submission failed');
        const handle = json.handle || '';
        proForm.style.display = 'none';
        proSpinner.classList.remove('show');
        proHandle.textContent = handle;
        proSuccess.classList.add('show');
      } catch (err) {
        proSpinner.classList.remove('show');
        proSubmit.disabled = false;
        proError.classList.add('show');
        console.error('[ALG Pro Form]', err);
      }
    }

    proForm.addEventListener('submit', e => { e.preventDefault(); submitPro(); });
    if (proRetry) proRetry.addEventListener('click', () => { proError.classList.remove('show'); submitPro(); });
  })();

  /* ---- Initial live render on mount ---- */
  genBtn.click();

})();
</script>

</BaseLayout>

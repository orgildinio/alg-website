---
/**
 * solutions/warehouse-logistics/index.astro
 * Industry Vertical: Warehouse & Logistics Lighting Solutions
 *
 * Phase B: Full content port from industry-vertical-warehouse-logistics.html
 * Design system: /styles/industry-vertical-system.css (shared, loaded via slot="head")
 * Glow blob: inlined from glow-blob.js
 *
 * CFG-VERT-1: main[data-vertical="warehouse-logistics"] preserved for per-vertical accent
 * CFG-CHROME-1: BaseLayout provides header/mega-menu/footer
 * CFG-COWORK-15: system CSS loaded as real stylesheet, not inlined/stripped
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Warehouse & Logistics Lighting Solutions — Archipelago Lighting Group"
  description="High-bay and low-bay systems engineered for distribution centers and 3PL facilities. DLC Premium listed with integrated sensors and emergency egress."
  bodyClass="page-vertical-warehouse-logistics"
>
  <Fragment slot="head">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.archipelagolighting.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Solutions",
          "item": "https://www.archipelagolighting.com/solutions/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Warehouse & Logistics",
          "item": "https://www.archipelagolighting.com/solutions/warehouse-logistics/"
        }
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What lighting is recommended for warehouse and logistics facilities?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The best lighting for warehouses balances high-bay efficiency, instant-on performance at cold temperatures, and DLC-rebate eligibility. We recommend LED high-bays with integrated occupancy sensors to maximize energy savings in racking aisles."
          }
        },
        {
          "@type": "Question",
          "name": "Are there DLC rebates for warehouse lighting retrofits?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, many utility programs offer significant rebates for warehouse retrofits, especially when upgrading to DLC Premium listed high-bays combined with networked lighting controls (NLC)."
          }
        },
        {
          "@type": "Question",
          "name": "What CCT and lumen levels are required for warehouse aisles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Warehouses typically require 4000K or 5000K color temperatures for optimal visibility and safety. Lumen requirements vary by ceiling height, but 40-foot racking aisles often need 20,000 to 30,000+ lumen fixtures with narrow optics."
          }
        },
        {
          "@type": "Question",
          "name": "What controls do warehouse facilities need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Warehouses benefit most from aisle-level occupancy sensing and daylight harvesting. Using Bluetooth mesh or PIR sensors allows fixtures to dim to 10% when aisles are empty, slashing energy costs."
          }
        }
      ]
    }
    </script>
  </Fragment>

  <link rel="stylesheet" href="/styles/industry-vertical-system.css" slot="head" />

  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">HOME</a>
    <span class="bc-sep">›</span>
    <a href="/solutions/">SOLUTIONS</a>
    <span class="bc-sep">›</span>
    <span class="bc-current">Warehouse &amp; Logistics</span>
  </nav>


<div aria-hidden="true" class="glow-orb"></div>
<main data-vertical="warehouse-logistics">
<section class="hero" data-screen-label="Hero">
<div class="container">
<div class="hero__grid">
<div>
<span class="hero__eyebrow">Vertical Solutions · Warehouse &amp; Logistics</span>
<h1 class="hero__title">Warehouse &amp; Logistics Lighting Solutions</h1>
<p class="hero__deck">The best lighting for warehouses balances high-bay efficiency, instant-on performance at cold temperatures, and DLC-rebate eligibility. We recommend LED high-bays with integrated occupancy sensors to maximize energy savings in racking aisles. High-Performance LED Systems for 24/7 Distribution Environments. Purpose-built for every zone — from 40-foot racking aisles to loading docks to cold storage — with sensor-ready controls that slash energy use.</p>
<div class="hero__cta-row">
<a class="btn btn--primary" href="mailto:sales@archipelagolighting.com?subject=Lighting%20Inquiry%20%E2%80%94%20Warehouse%20%26%20Logistics%20Solutions&amp;body=Hi%20ALG%20Sales%2C%0A%0AI%27m%20interested%20in%20lighting%20for%20a%20Warehouse%20%26%20Logistics%20project%20and%20would%20like%20to%20discuss%20layout%2C%20specifications%2C%20and%20pricing.%0A%0AProject%20details%3A%0A-%20Facility%20/%20location%3A%0A-%20Approx.%20square%20footage%3A%0A-%20Mounting%20height%20/%20ceiling%20type%3A%0A-%20Target%20timeline%3A%0A%0AThank%20you.">Contact Sales <span class="arrow">→</span></a>
<a target="_blank" rel="noopener" class="btn btn--ghost" href="https://workdrive.archipelagolighting.com/external/04bcf0da2cc5980a2ab1ee4dba6c0a277780d737ffd802e2cd020b3c5e8b846f">Download Spec Pack</a>
</div>
</div>

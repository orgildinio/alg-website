---
/**
 * solutions/healthcare/index.astro
 * Industry Vertical: Healthcare & Medical Lighting Solutions
 *
 * Phase B: Full content port from industry-vertical-healthcare.html
 * Design system: /styles/industry-vertical-system.css (shared, loaded via slot="head")
 * Glow blob: inlined from glow-blob.js
 *
 * CFG-VERT-1: main[data-vertical="healthcare"] preserved for per-vertical accent
 * CFG-CHROME-1: BaseLayout provides header/mega-menu/footer
 * CFG-COWORK-15: system CSS loaded as real stylesheet, not inlined/stripped
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Healthcare & Medical Lighting Solutions — Archipelago Lighting Group"
  description="Patient-care, surgical, and administrative lighting with compliance coverage. UL1598 listed with anti-microbial finish options and tunable-white."
  bodyClass="page-vertical-healthcare"
>
  <Fragment slot="head">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.archipelagolighting.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Solutions",
          "item": "https://www.archipelagolighting.com/solutions/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Healthcare & Medical",
          "item": "https://www.archipelagolighting.com/solutions/healthcare/"
        }
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What lighting is recommended for healthcare and medical facilities?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Healthcare facilities need high-CRI (>90) lighting for accurate patient assessment, with smooth dimming capabilities for patient comfort. Cleanroom-rated and IP65 troffers are required for surgical and sterile areas."
          }
        },
        {
          "@type": "Question",
          "name": "What CCT levels are recommended for healthcare?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hospitals typically utilize 3500K to 4000K for clinical areas, while patient rooms may use tunable white or warmer 3000K fixtures to promote circadian entrainment and restful recovery."
          }
        },
        {
          "@type": "Question",
          "name": "Are there DLC rebates for hospital retrofits?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, 24/7 healthcare facilities see rapid ROI from LED retrofits, and utility rebates for DLC Premium fixtures and advanced controls significantly reduce the initial capital expenditure."
          }
        }
      ]
    }
    </script>
  </Fragment>

  <link rel="stylesheet" href="/styles/industry-vertical-system.css" slot="head" />

  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">HOME</a>
    <span class="bc-sep">›</span>
    <a href="/solutions/">SOLUTIONS</a>
    <span class="bc-sep">›</span>
    <span class="bc-current">Healthcare</span>
  </nav>



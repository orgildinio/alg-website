---
/**
 * verticals/hospitality/index.astro
 * Industry Vertical: Hospitality — STUB (Phase B content pending)
 *
 * Vertical accent: warm gold · hsl(38 92% 50%)
 * Content: TBD — needs ALG_Hospitality_Solutions.html port
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Hospitality Lighting Solutions · ALG"
  description="Warm, atmosphere-defining LED systems for lobbies, guestrooms, corridors, and F&B spaces. 2200K-3000K, phase-dim, décor-grade."
  bodyClass="page-vertical-hospitality"
>
<style>
  .vert-page {
    --brand-red:       var(--color-alg-red, #F32740);
    --brand-red-dark:  var(--color-alg-red-dark, #C41E32);
    --brand-red-hsl:   353 80% 55%;
    --bg-page:         #1c2025;
    --bg-card:         #2a2e34;
    --bg-spec:         #22262b;
    --bg-deepest:      #15181c;
    --text-primary:    #ECEDEF;
    --text-secondary:  #A8AEB7;
    --text-muted:      #6E7682;
    --line:            rgba(255,255,255,0.08);
    --line-medium:     rgba(255,255,255,0.14);
    --line-strong:     rgba(255,255,255,0.22);
    --font-body:       var(--font-sans, 'Lato', system-ui, sans-serif);
    --font-mono:       'JetBrains Mono', ui-monospace, 'SF Mono', Consolas, monospace;
    --radius:          4px;
    --radius-lg:       8px;
    --container:       1280px;
    /* Vertical accent — hospitality (warm gold) */
    --vert-accent:      38 92% 50%;
    background: var(--bg-page);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  .breadcrumb-band { padding: 10px 32px; border-bottom: 1px solid var(--line); background: var(--bg-deepest); font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--text-muted); display: flex; align-items: center; }
  .breadcrumb-band a { color: inherit; text-decoration: none; }
  .breadcrumb-band a:hover { color: var(--text-primary); }
  .bc-sep { margin: 0 10px; }
  .bc-current { color: var(--text-primary); font-weight: 700; }
  .container { width: 100%; max-width: var(--container); margin: 0 auto; padding: 0 32px; }
  .hero { padding: 80px 0 72px; background: var(--bg-deepest); border-bottom: 1px solid var(--line); }
  .hero__eyebrow { display: block; font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: hsl(var(--vert-accent)); margin-bottom: 16px; }
  .hero__title { font-size: 52px; font-weight: 900; letter-spacing: -0.02em; line-height: 1.08; color: var(--text-primary); margin: 0 0 20px; }
  @media (max-width: 760px) { .hero__title { font-size: 34px; } }
  .hero__deck { font-size: 17px; color: var(--text-secondary); line-height: 1.6; margin: 0 0 32px; max-width: 560px; }
  .btn { display: inline-flex; align-items: center; gap: 6px; padding: 12px 22px; border-radius: var(--radius); font-family: var(--font-body); font-size: 14px; font-weight: 700; text-decoration: none; transition: background .15s, border-color .15s; }
  .btn--primary { background: var(--brand-red); color: #fff; border: 2px solid var(--brand-red); }
  .btn--primary:hover { background: var(--brand-red-dark); border-color: var(--brand-red-dark); }
  .stub-section { padding: 72px 0; border-bottom: 1px solid var(--line); }
  .stub-placeholder { background: var(--bg-card); border: 1px dashed hsl(var(--vert-accent) / 40%); border-radius: var(--radius-lg); padding: 48px; text-align: center; }
  .stub-placeholder__label { font-family: var(--font-mono); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: hsl(var(--vert-accent)); margin-bottom: 12px; }
  .stub-placeholder__title { font-size: 20px; font-weight: 700; color: var(--text-primary); margin: 0 0 8px; }
  .stub-placeholder__note { font-size: 14px; color: var(--text-muted); }
</style>

<div class="vert-page">
  <nav class="breadcrumb-band" aria-label="Breadcrumb">
    <div class="container" style="display:flex;align-items:center;padding-top:0;padding-bottom:0;">
      <a href="/">Home</a><span class="bc-sep">›</span>
      <a href="/solutions">Solutions</a><span class="bc-sep">›</span>
      <span class="bc-current">Hospitality</span>
    </div>
  </nav>

  <main data-vertical="hospitality">
    <section class="hero">
      <div class="container">
        <span class="hero__eyebrow">Vertical Solutions · Hospitality</span>
        <h1 class="hero__title">Hospitality Lighting Solutions</h1>
        <p class="hero__deck">Warm, atmosphere-defining LED systems for lobbies, guestrooms, corridors, and F&amp;B spaces. 2200K–3000K, phase-dim, décor-grade. Full content coming in Phase B.</p>
        <a href="/contact" class="btn btn--primary">Contact Sales →</a>
      </div>
    </section>
    <section class="stub-section"><div class="container"><div class="stub-placeholder"><div class="stub-placeholder__label">Section: Hero Stats</div><div class="stub-placeholder__title">2200K-3000K · Phase-Dim · Décor-Grade</div><div class="stub-placeholder__note">TBD — needs content from ALG_Hospitality_Solutions.html</div></div></div></section>
    <section class="stub-section"><div class="container"><div class="stub-placeholder"><div class="stub-placeholder__label">Section: Lighting by Zone</div><div class="stub-placeholder__title">Lobby · Guestroom · Corridor · F&amp;B/Exterior</div><div class="stub-placeholder__note">TBD — needs content from ALG_Hospitality_Solutions.html</div></div></div></section>
    <section class="stub-section"><div class="container"><div class="stub-placeholder"><div class="stub-placeholder__label">Section: Product Selection Matrix</div><div class="stub-placeholder__title">Product Matrix</div><div class="stub-placeholder__note">TBD — needs content from ALG_Hospitality_Solutions.html</div></div></div></section>
    <section class="stub-section"><div class="container"><div class="stub-placeholder"><div class="stub-placeholder__label">Section: Key Technologies</div><div class="stub-placeholder__title">Warm Dimming · NOSTALGIC · Phase-Dim</div><div class="stub-placeholder__note">TBD — needs content from ALG_Hospitality_Solutions.html</div></div></div></section>
    <section class="stub-section"><div class="container"><div class="stub-placeholder"><div class="stub-placeholder__label">Section: Application Spotlight</div><div class="stub-placeholder__title">Full-Service Hotel · Boutique · Resort</div><div class="stub-placeholder__note">TBD — needs content from ALG_Hospitality_Solutions.html</div></div></div></section>
    <section class="stub-section"><div class="container"><div class="stub-placeholder"><div class="stub-placeholder__label">Section: Value Proposition</div><div class="stub-placeholder__title">Guest Experience · Energy Savings · Brand Consistency</div><div class="stub-placeholder__note">TBD — needs content from ALG_Hospitality_Solutions.html</div></div></div></section>
    <section class="stub-section"><div class="container"><div class="stub-placeholder"><div class="stub-placeholder__label">Section: Procurement Story</div><div class="stub-placeholder__title">One PO. One Warranty. One Contact.</div><div class="stub-placeholder__note">TBD — needs content from ALG_Hospitality_Solutions.html</div></div></div></section>
    <section class="stub-section" style="border-bottom:none;"><div class="container"><div class="stub-placeholder"><div class="stub-placeholder__label">Section: ALG Advantage / Closing CTA</div><div class="stub-placeholder__title">Why Specifiers Choose ALG</div><div class="stub-placeholder__note">TBD — needs content from ALG_Hospitality_Solutions.html</div></div></div></section>
  </main>
</div>
</BaseLayout>

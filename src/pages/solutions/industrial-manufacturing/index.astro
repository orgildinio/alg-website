---
/**
 * solutions/industrial-manufacturing/index.astro
 * Industry Vertical: Industrial & Manufacturing Lighting Solutions
 *
 * Phase B: Full content port from industry-vertical-industrial-manufacturing.html
 * Design system: /styles/industry-vertical-system.css (shared, loaded via slot="head")
 * Glow blob: inlined from glow-blob.js
 *
 * CFG-VERT-1: main[data-vertical="industrial-manufacturing"] preserved for per-vertical accent
 * CFG-CHROME-1: BaseLayout provides header/mega-menu/footer
 * CFG-COWORK-15: system CSS loaded as real stylesheet, not inlined/stripped
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Industrial & Manufacturing Lighting Solutions — Archipelago Lighting Group"
  description="Production-floor and process-facility lighting engineered for uptime. Washdown-rated, vibration-resistant, and hazardous-location configurations."
  bodyClass="page-vertical-industrial-manufacturing"
>
  <Fragment slot="head">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.archipelagolighting.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Solutions",
          "item": "https://www.archipelagolighting.com/solutions/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Industrial & Manufacturing",
          "item": "https://www.archipelagolighting.com/solutions/industrial-manufacturing/"
        }
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What lighting is code-required for industrial manufacturing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Industrial facilities must meet OSHA and IESNA illumination standards, which typically require 30 to 100+ footcandles depending on the precision of the manufacturing task. High-visibility 5000K LED lighting is standard for safety and quality control."
          }
        },
        {
          "@type": "Question",
          "name": "Are there DLC rebates for manufacturing plant retrofits?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, manufacturing plants can secure substantial utility rebates by upgrading to DLC Premium high-bays and linear fixtures. Adding advanced lighting controls can often double the rebate amount."
          }
        },
        {
          "@type": "Question",
          "name": "What IP ratings do industrial light fixtures need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Industrial environments with dust, debris, or moisture require IP65 or IP66 rated fixtures. Vapor tight fixtures and sealed high-bays prevent ingress and withstand high-pressure washdowns."
          }
        }
      ]
    }
    </script>
  </Fragment>

  <link rel="stylesheet" href="/styles/industry-vertical-system.css" slot="head" />

  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">HOME</a>
    <span class="bc-sep">›</span>
    <a href="/solutions/">SOLUTIONS</a>
    <span class="bc-sep">›</span>
    <span class="bc-current">Industrial &amp; Manufacturing</span>
  </nav>



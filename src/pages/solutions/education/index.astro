---
/**
 * solutions/education/index.astro
 * Industry Vertical: Education Lighting Solutions
 *
 * Phase B: Full content port from industry-vertical-education.html
 * Design system: /styles/industry-vertical-system.css (shared, loaded via slot="head")
 * Glow blob: inlined from glow-blob.js
 *
 * CFG-VERT-1: main[data-vertical="education"] preserved for per-vertical accent
 * CFG-CHROME-1: BaseLayout provides header/mega-menu/footer
 * CFG-COWORK-15: system CSS loaded as real stylesheet, not inlined/stripped
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Education Lighting Solutions — Archipelago Lighting Group"
  description="K-12 and higher-ed lighting with CEC JA8 and DLC Premium. Panel, troffer, and classroom controls packages with occupancy and daylight harvesting."
  bodyClass="page-vertical-education"
>
  <Fragment slot="head">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.archipelagolighting.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Solutions",
          "item": "https://www.archipelagolighting.com/solutions/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Education",
          "item": "https://www.archipelagolighting.com/solutions/education/"
        }
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What lighting is recommended for education and schools?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Schools and universities require flicker-free, high-CRI LED lighting with selectable CCTs to create optimal learning environments. Volumetric troffers and linear pendants are standard for classrooms."
          }
        },
        {
          "@type": "Question",
          "name": "Are there DLC rebates for school lighting retrofits?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, educational facilities can access utility rebates by installing DLC-listed fixtures. Many districts leverage these rebates alongside networked controls to fund campus-wide energy efficiency upgrades."
          }
        },
        {
          "@type": "Question",
          "name": "What controls do education facilities need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Classrooms require multi-zone dimming, daylight harvesting near windows, and manual wall stations for teacher override. Corridors and gymnasiums benefit from automated occupancy sensing."
          }
        }
      ]
    }
    </script>
  </Fragment>

  <link rel="stylesheet" href="/styles/industry-vertical-system.css" slot="head" />

  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">HOME</a>
    <span class="bc-sep">›</span>
    <a href="/solutions/">SOLUTIONS</a>
    <span class="bc-sep">›</span>
    <span class="bc-current">Education</span>
  </nav>


<div aria-hidden="true" class="glow-orb"></div>
<main data-vertical="education">
<section class="hero" data-screen-label="Hero">
<div class="container">
<div class="hero__grid">
<div>
<span class="hero__eyebrow">Vertical Solutions · Education</span>
<h1 class="hero__title">Education Lighting Solutions</h1>
<p class="hero__deck">Schools and universities require flicker-free, high-CRI LED lighting with selectable CCTs to create optimal learning environments. Volumetric troffers and linear pendants are standard for classrooms. Energy-Efficient LED Upgrades for K-12 Schools, Universities, and Campus Facilities. Lowest-disruption retrofit kits engineered for summer-break installation, ESSER funding, and DLC-listed rebate eligibility.</p>
<div class="hero__cta-row">
<a class="btn btn--primary" href="mailto:sales@archipelagolighting.com?subject=Lighting%20Inquiry%20%E2%80%94%20Education%20Solutions&amp;body=Hi%20ALG%20Sales%2C%0A%0AI%27m%20interested%20in%20lighting%20for%20a%20Education%20project%20and%20would%20like%20to%20discuss%20layout%2C%20specifications%2C%20and%20pricing.%0A%0AProject%20details%3A%0A-%20Facility%20/%20location%3A%0A-%20Approx.%20square%20footage%3A%0A-%20Mounting%20height%20/%20ceiling%20type%3A%0A-%20Target%20timeline%3A%0A%0AThank%20you.">Contact Sales <span class="arrow">→</span></a>
<a target="_blank" rel="noopener" class="btn btn--ghost" href="https://workdrive.archipelagolighting.com/external/55fe20ecac797b58e9afc4bacb24f48b1628057f7745285117161a26831a85f3">Download Spec Pack</a>
</div>
</div>
<aside aria-label="Key specs" class="info-card">
<div class="info-card__label">Why retrofit now</div>
<div class="stat">
<div class="stat__value">75%</div>
<div class="stat__label">Energy savings vs. fluorescent on a like-for-like swap</div>
</div>
<div class="stat">
<div class="stat__value">50,000 hr</div>
<div class="stat__label">L70 rated life — 10+ years maintenance-free</div>
</div>
<div class="stat">
<div class="stat__value">ESSER · DLC</div>
<div class="stat__label">Stack federal funding with utility rebates through 2026</div>
</div>
</aside>
</div>
</div>
</section>
<section class="section" data-screen-label="Zones">
<div class="container">
<span class="eyebrow">Lighting by Campus Zone</span>
<h2 class="section-title section-title--underline">From classroom to campus perimeter</h2>
<p class="section-deck">Schools represent the single largest building stock for lighting retrofits in the United States. With ESSER funding still available and state energy mandates tightening, districts are upgrading to LED at unprecedented rates. ALG's select<span class="aa">Ⓐ</span>RCH retrofit kits offer the lowest-disruption upgrade path — critical for schools that can only renovate during summer breaks.</p>
<div class="zones">
<article class="zone-card" data-zone="1">
<div class="zone-card__num">Zone 01</div>
<h3 class="zone-card__title">Classrooms</h3>
<div class="zone-card__product">Troffers &amp; Back-Lit Panels · plano<span class="aa">Ⓐ</span>RCH</div>
<ul class="zone-card__list">
<li>2x2 and 2x4 form factors (drop-in grid)</li>
<li>Flicker-free for student comfort &amp; focus</li>
<li>High CRI 80+ for accurate reading</li>
<li>0–10V dimming for presentation mode</li>
<li>Watt/CCT selectable at installation</li>
</ul>
</article>
<article class="zone-card" data-zone="2">
<div class="zone-card__num">Zone 02</div>
<h3 class="zone-card__title">Corridors &amp; Common Areas</h3>
<div class="zone-card__product">Wraps, Strips · select<span class="aa">Ⓐ</span>RCH</div>
<ul class="zone-card__list">
<li>Low-profile surface mount</li>
<li>Motion sensor compatible for energy savings</li>
<li>High-traffic durability</li>
<li>Continuous run options for long hallways</li>
</ul>
</article>
<article class="zone-card" data-zone="2">
<div class="zone-card__num">Zone 03</div>
<h3 class="zone-card__title">Gymnasiums &amp; Auditoriums</h3>
<div class="zone-card__product">High Bays · lampar<span class="aa">Ⓐ</span>RCH (UFO &amp; Linear)</div>
<ul class="zone-card__list">
<li>High lumen output for large spaces</li>
<li>sensorBLE occupancy for off-hours savings</li>
<li>surge<span class="aa">Ⓐ</span>RMOR electrical protection</li>
<li>Watt selectable: 100W / 150W / 200W</li>
</ul>
</article>
<article class="zone-card" data-zone="3">
<div class="zone-card__num">Zone 04</div>
<h3 class="zone-card__title">Restrooms, Kitchens &amp; Maintenance</h3>
<div class="zone-card__product">Vapor Tights · LV3P Series</div>
<ul class="zone-card__list">
<li>IP66 for wet/damp locations</li>
<li>DampGuard moisture resistance</li>
<li>Impact-resistant lens</li>
<li>Linkable for utility areas</li>
</ul>
</article>
<article class="zone-card" data-zone="3">
<div class="zone-card__num">Zone 05</div>
<h3 class="zone-card__title">Campus Exterior &amp; Parking</h3>
<div class="zone-card__product">Wall Packs, Area Lights, Flood · luxo<span class="aa">Ⓐ</span>RCH / city<span class="aa">Ⓐ</span>RCH</div>
<ul class="zone-card__list">
<li>Full-cutoff dark-sky friendly</li>
<li>Student safety: high-lumen security</li>
<li>Dusk-to-dawn photocell</li>
<li>DampGuard all-weather durability</li>
</ul>
</article>
<article class="zone-card" data-zone="4">
<div class="zone-card__num">Zone 06</div>
<h3 class="zone-card__title">Retrofit &amp; Quick Upgrades</h3>
<div class="zone-card__product">LED Tubes &amp; Retrofit Kits · tubul<span class="aa">Ⓐ</span>RCH / select<span class="aa">Ⓐ</span>RCH</div>
<ul class="zone-card__list">
<li>T8 Type A (plug-and-play) for fastest swap</li>
<li>T8 Type B (ballast bypass) for max savings</li>
<li>select<span class="aa">Ⓐ</span>RCH drop-in kits for troffer upgrades</li>
<li>Summer-break installation friendly</li>
</ul>
</article>
</div>
<div class="callout-dark">
<h4 class="callout-dark__title">ESSER &amp; Funding Compatibility</h4>
<p class="callout-dark__body">ESSER (Elementary and Secondary School Emergency Relief) funding through 2026 can be applied to facility improvements including LED lighting upgrades that improve indoor air quality and ventilation environments. ALG's DLC-listed listed products also qualify for utility rebates, stacking incentives for cash-strapped districts. Extended finance terms further ease the capital burden.</p>
</div>

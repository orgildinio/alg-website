---
/**
 * verticals/data-center/index.astro
 * Industry Vertical: Data Center
 *
 * Ported from ALG_Data_Center_Solutions.html (legacy) + industry-vertical-system.css.
 * Vertical accent: electric teal · hsl(195 100% 47%)
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Data Center Lighting Solutions · ALG"
  description="Purpose-built LED systems for mission-critical environments. ALG covers every data center zone — server halls to exterior perimeters — with sensorBLE controls that reduce PUE."
  bodyClass="page-vertical-data-center"
>
<style>
  .vert-page {
    --brand-red:       var(--color-alg-red, #F32740);
    --brand-red-dark:  var(--color-alg-red-dark, #C41E32);
    --brand-red-hsl:   353 80% 55%;
    --bg-page:         #1c2025;
    --bg-card:         #2a2e34;
    --bg-spec:         #22262b;
    --bg-deepest:      #15181c;
    --text-primary:    #ECEDEF;
    --text-secondary:  #A8AEB7;
    --text-muted:      #6E7682;
    --line:            rgba(255,255,255,0.08);
    --line-medium:     rgba(255,255,255,0.14);
    --line-strong:     rgba(255,255,255,0.22);
    --font-body:       var(--font-sans, 'Lato', system-ui, sans-serif);
    --font-mono:       'JetBrains Mono', ui-monospace, 'SF Mono', Consolas, monospace;
    --radius-sm:       2px;
    --radius:          4px;
    --radius-lg:       8px;
    --container:       1280px;
    /* Vertical accent — data center (electric teal) */
    --vert-accent:      195 100% 47%;
    --vert-accent-soft: 195 100% 47% / 14%;
    --vert-zone-1:      195 100% 47%;
    --vert-zone-2:      264 70% 60%;
    --vert-zone-3:      353 80% 55%;
    --vert-zone-4:      158 64% 45%;

    background: var(--bg-page);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  .breadcrumb-band {
    padding: 10px 32px;
    border-bottom: 1px solid var(--line);
    background: var(--bg-deepest);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--text-muted);
    display: flex;
    align-items: center;
  }
  .breadcrumb-band a { color: inherit; text-decoration: none; }
  .breadcrumb-band a:hover { color: var(--text-primary); }
  .bc-sep { margin: 0 10px; }
  .bc-current { color: var(--text-primary); font-weight: 700; }
  .container { width: 100%; max-width: var(--container); margin: 0 auto; padding: 0 32px; }
  @media (max-width: 760px) { .container { padding: 0 20px; } }
  /* ── Eyebrow: delegated to global sec-eyebrow ── */
  .hero {
    padding: 80px 0 72px;
    background: var(--bg-deepest);
    border-bottom: 1px solid var(--line);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 48px;
    align-items: start;
  }
  @media (max-width: 900px) { .hero__grid { grid-template-columns: 1fr; } }
  /* ── Hero eyebrow: delegated to global sec-eyebrow ── */
  .hero__title { font-size: 52px; font-weight: 900; letter-spacing: -0.02em; line-height: 1.08; color: var(--text-primary); margin: 0 0 20px; }
  @media (max-width: 760px) { .hero__title { font-size: 34px; } }
  .hero__deck { font-size: 17px; color: var(--text-secondary); line-height: 1.6; margin: 0 0 32px; max-width: 560px; }
  .hero__cta-row { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; gap: 6px; padding: 12px 22px; border-radius: var(--radius); font-family: var(--font-body); font-size: 14px; font-weight: 700; text-decoration: none; transition: background .15s, color .15s, border-color .15s; }
  .btn--primary { background: var(--brand-red); color: #fff; border: 2px solid var(--brand-red); }
  .btn--primary:hover { background: var(--brand-red-dark); border-color: var(--brand-red-dark); }
  .btn--ghost { background: transparent; color: var(--text-primary); border: 2px solid var(--line-strong); }
  .btn--ghost:hover { border-color: var(--text-secondary); }
  .arrow { font-size: 16px; }
  .info-card { background: var(--bg-card); border: 1px solid var(--line-medium); border-radius: var(--radius-lg); padding: 28px; }
  .info-card__label { font-family: var(--font-mono); font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 20px; }
  .stat { margin-bottom: 20px; }
  .stat:last-child { margin-bottom: 0; }
  .stat__value { font-size: 28px; font-weight: 900; letter-spacing: -0.02em; color: hsl(var(--vert-accent)); line-height: 1; margin-bottom: 4px; }
  .stat__label { font-size: 13px; color: var(--text-secondary); line-height: 1.4; }
  .section { padding: 72px 0; border-bottom: 1px solid var(--line); }
  /* ── Section title: delegated to global sec-title ── */
  .section-deck { font-size: 16px; color: var(--text-secondary); line-height: 1.6; max-width: 680px; margin: 0 0 40px; }
  .zones { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-bottom: 32px; }
  .zone-card { background: var(--bg-card); border: 1px solid var(--line); border-left: 4px solid hsl(var(--vert-zone-1)); border-radius: var(--radius); padding: 20px 22px; }
  .zone-card[data-zone="2"] { border-left-color: hsl(var(--vert-zone-2)); }
  .zone-card[data-zone="3"] { border-left-color: hsl(var(--vert-zone-3)); }
  .zone-card[data-zone="4"] { border-left-color: hsl(var(--vert-zone-4)); }
  .zone-card__num { font-family: var(--font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px; }
  .zone-card__title { font-size: 16px; font-weight: 700; color: var(--text-primary); margin: 0 0 6px; }
  .zone-card__product { font-family: var(--font-mono); font-size: 11px; color: hsl(var(--vert-accent)); margin-bottom: 10px; }
  .zone-card__list { margin: 0; padding-left: 16px; font-size: 13px; color: var(--text-secondary); line-height: 1.6; }
  .callout-dark { background: var(--bg-spec); border: 1px solid var(--line-medium); border-left: 4px solid hsl(var(--vert-accent)); border-radius: var(--radius); padding: 24px 28px; margin-top: 8px; }
  .callout-dark__title { font-size: 15px; font-weight: 700; color: var(--text-primary); margin: 0 0 8px; }
  .callout-dark__body { font-size: 14px; color: var(--text-secondary); line-height: 1.6; margin: 0; }
  .matrix-wrap { overflow-x: auto; }
  .matrix-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .matrix-table th { background: var(--bg-spec); color: var(--text-muted); font-family: var(--font-mono); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; padding: 10px 14px; text-align: left; border-bottom: 1px solid var(--line-medium); white-space: nowrap; }
  .matrix-table td { padding: 10px 14px; border-bottom: 1px solid var(--line); color: var(--text-secondary); vertical-align: top; }
  .matrix-table tr:hover td { background: var(--bg-card); }
  .product-name { color: var(--text-primary); font-weight: 600; }
  .mono { font-family: var(--font-mono); font-size: 12px; }
  .zone-chip { display: inline-block; padding: 2px 8px; border-radius: 2px; font-family: var(--font-mono); font-size: 10px; letter-spacing: .08em; background: hsl(var(--vert-zone-1) / 18%); color: hsl(var(--vert-zone-1)); }
  .zone-chip--2 { background: hsl(var(--vert-zone-2) / 18%); color: hsl(var(--vert-zone-2)); }
  .zone-chip--3 { background: hsl(var(--vert-zone-3) / 18%); color: hsl(var(--vert-zone-3)); }
  .zone-chip--4 { background: hsl(var(--vert-zone-4) / 18%); color: hsl(var(--vert-zone-4)); }
  .tech-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; margin-top: 8px; }
  .tech-badge { background: var(--bg-card); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; }
  .tech-badge__icon { width: 36px; height: 36px; color: hsl(var(--vert-accent)); margin-bottom: 12px; }
  .tech-badge__icon svg { width: 100%; height: 100%; }
  .tech-badge__title { font-size: 14px; font-weight: 700; color: var(--text-primary); margin: 0 0 6px; }
  .tech-badge__desc { font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin: 0; }
  .spotlight-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-bottom: 32px; }
  .spotlight-card { background: var(--bg-card); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; }
  .spotlight-card__media { height: 160px; background: linear-gradient(135deg, hsl(var(--vert-accent) / 20%), hsl(var(--vert-accent) / 8%)); display: flex; align-items: center; justify-content: center; color: hsl(var(--vert-accent)); position: relative; }
  .spotlight-card__media svg { width: 48px; height: 48px; opacity: .6; }
  .spotlight-card__media::after { content: attr(data-caption); position: absolute; bottom: 8px; right: 10px; font-family: var(--font-mono); font-size: 9px; color: var(--text-muted); letter-spacing: .08em; }
  .spotlight-card__body { padding: 20px; }
  .spotlight-card__title { font-size: 15px; font-weight: 700; color: var(--text-primary); margin: 0 0 8px; }
  .spotlight-card__desc { font-size: 13px; color: var(--text-secondary); line-height: 1.55; margin: 0 0 10px; }
  .spotlight-card__meta { font-family: var(--font-mono); font-size: 10px; letter-spacing: .1em; color: hsl(var(--vert-accent)); text-transform: uppercase; }
  .value-banner { background: var(--bg-spec); border: 1px solid var(--line-medium); border-radius: var(--radius-lg); padding: 40px; display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: start; }
  @media (max-width: 760px) { .value-banner { grid-template-columns: 1fr; } }
  .value-banner__title { font-size: 28px; font-weight: 800; color: var(--text-primary); margin: 0 0 12px; letter-spacing: -0.01em; }
  .value-banner__body { font-size: 15px; color: var(--text-secondary); line-height: 1.65; margin: 0; }
  .value-banner__metrics { display: flex; flex-direction: column; gap: 20px; min-width: 200px; }
  .value-metric__num { font-size: 26px; font-weight: 900; color: hsl(var(--vert-accent)); letter-spacing: -0.02em; line-height: 1; margin-bottom: 4px; }
  .value-metric__label { font-size: 12px; color: var(--text-secondary); line-height: 1.4; }
  .procurement-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px; margin-top: 8px; }
  .proc-step { background: var(--bg-card); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; position: relative; }
  .proc-step__big { display: block; font-size: 64px; font-weight: 900; color: hsl(var(--vert-accent) / 12%); line-height: 1; position: absolute; top: 12px; right: 16px; font-family: var(--font-mono); pointer-events: none; }
  .proc-step__num { display: block; font-family: var(--font-mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: hsl(var(--vert-accent)); margin-bottom: 8px; }
  .proc-step__title { font-size: 16px; font-weight: 700; color: var(--text-primary); margin: 0 0 8px; }
  .proc-step__desc { font-size: 13px; color: var(--text-secondary); line-height: 1.55; margin: 0; }
  .advantage-strip { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; margin-bottom: 48px; }
  .advantage-pillar { background: var(--bg-card); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; text-align: center; }
  .advantage-pillar__num { font-size: 32px; font-weight: 900; color: hsl(var(--vert-accent)); letter-spacing: -0.02em; margin-bottom: 4px; }
  .advantage-pillar__label { font-size: 13px; font-weight: 700; color: var(--text-primary); margin-bottom: 6px; }
  .advantage-pillar__desc { font-size: 12px; color: var(--text-secondary); line-height: 1.5; }
  .closing-cta { background: linear-gradient(135deg, hsl(var(--brand-red-hsl) / 12%), hsl(var(--vert-accent) / 8%)); border: 1px solid hsl(var(--brand-red-hsl) / 30%); border-radius: var(--radius-lg); padding: 40px; display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
  .closing-cta__title { font-size: 22px; font-weight: 800; color: var(--text-primary); margin: 0 0 8px; letter-spacing: -0.01em; }
  .closing-cta__deck { font-size: 14px; color: var(--text-secondary); line-height: 1.55; margin: 0; }
  .closing-cta__buttons { display: flex; gap: 12px; flex-wrap: wrap; flex-shrink: 0; }
</style>

<div class="vert-page">
  <nav class="breadcrumb-band" aria-label="Breadcrumb">
    <div class="container" style="display:flex;align-items:center;padding-top:0;padding-bottom:0;">
      <a href="/">Home</a><span class="bc-sep">›</span>
      <a href="/solutions">Solutions</a><span class="bc-sep">›</span>
      <span class="bc-current">Data Center</span>
    </div>
  </nav>

  <main data-vertical="data-center">
    <!-- 1. HERO -->
    <section class="hero">
      <div class="container">
        <div class="hero__grid">
          <div>
            <span class="hero__eyebrow">Vertical Solutions · Data Center</span>
            <h1 class="hero__title">Data Center Lighting Solutions</h1>
            <p class="hero__deck">Purpose-Built LED Systems for Mission-Critical Environments. ALG provides zone-specific solutions from high-density server halls to exterior security perimeters, with sensor-ready controls that help meet ASHRAE 90.1 and reduce PUE.</p>
            <div class="hero__cta-row">
              <a href="mailto:sales@archipelagolighting.com?subject=Photometric%20request" class="btn btn--primary">Request a Photometric <span class="arrow">→</span></a>
              <a href="/spec-packs/ALG_Data_Center_Lighting.pdf" class="btn btn--ghost" target="_blank" rel="noopener" download>Download Spec Pack <span class="arrow">→</span></a>
            </div>
          </div>
          <aside class="info-card" aria-label="Key specs">
            <div class="info-card__label">Key Specs</div>
            <div class="stat">
              <div class="stat__value">150+ lm/W</div>
              <div class="stat__label">High efficacy for PUE improvement</div>
            </div>
            <div class="stat">
              <div class="stat__value">20kV/10kA</div>
              <div class="stat__label">surgeArmor transient protection</div>
            </div>
            <div class="stat">
              <div class="stat__value">BAA · TAA</div>
              <div class="stat__label">GSA Schedule eligible</div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- 2. LIGHTING BY ZONE -->
    <section class="section">
      <div class="container">
        <span class="sec-eyebrow">Lighting by Zone</span>
        <h2 class="sec-title">Every zone in the facility</h2>
        <p class="section-deck">Data centers demand reliable, energy-efficient lighting engineered for diverse environments within a single facility. ALG provides purpose-built solutions for every zone &mdash; from high-density server halls to exterior security perimeters &mdash; with sensor-ready controls that help meet ASHRAE 90.1 and reduce PUE.</p>
        <div class="zones">
          <article class="zone-card" data-zone="1">
            <div class="zone-card__num">Zone 01</div>
            <h3 class="zone-card__title">White Space / Server Halls</h3>
            <div class="zone-card__product">High Bay Linear &mdash; LLHB Tiny Series</div>
            <ul class="zone-card__list">
              <li>sensorBLE wireless occupancy &amp; daylight sensing</li>
              <li>surgeArmor 20kV/10kA transient protection</li>
              <li>High efficacy 150+ lm/W</li>
              <li>Watt selectable: 100W / 150W / 200W</li>
              <li>50,000hr L70 rated life</li>
              <li>CCT selectable: 3500K / 4000K / 5000K</li>
            </ul>
          </article>
          <article class="zone-card" data-zone="1">
            <div class="zone-card__num">Zone 02</div>
            <h3 class="zone-card__title">Gray Space / Mech &amp; Elec Rooms</h3>
            <div class="zone-card__product">Vapor Tights &mdash; LV3P Series</div>
            <ul class="zone-card__list">
              <li>IP66 rated for wet/damp locations</li>
              <li>DampGuard moisture &amp; corrosion protection</li>
              <li>Linkable configurations up to 8ft</li>
              <li>Watt/CCT selectable</li>
              <li>Impact-resistant polycarbonate lens</li>
              <li>Tool-free quickAdapt mounting</li>
            </ul>
          </article>
          <article class="zone-card" data-zone="2">
            <div class="zone-card__num">Zone 03</div>
            <h3 class="zone-card__title">Network Operations Center</h3>
            <div class="zone-card__product">Back-Lit Panels &amp; Troffers &mdash; planoARCH</div>
            <ul class="zone-card__list">
              <li>Flicker-free for screen-intensive environments</li>
              <li>High CRI 80+ for accurate color rendering</li>
              <li>Control-ready port for 0-10V dimming</li>
              <li>Emergency battery backup option</li>
              <li>2x2 and 2x4 form factors</li>
              <li>DLC Premium listed for utility rebates</li>
            </ul>
          </article>
          <article class="zone-card" data-zone="2">
            <div class="zone-card__num">Zone 04</div>
            <h3 class="zone-card__title">Corridors &amp; Common Areas</h3>
            <div class="zone-card__product">Wraps &amp; Strips &mdash; selectARCH</div>
            <ul class="zone-card__list">
              <li>Low-profile continuous lighting</li>
              <li>Motion sensor compatible</li>
              <li>Energy-efficient for 24/7 operation</li>
              <li>Surface or suspended mount options</li>
            </ul>
          </article>
          <article class="zone-card" data-zone="3">
            <div class="zone-card__num">Zone 05</div>
            <h3 class="zone-card__title">Exterior / Parking &amp; Perimeter</h3>
            <div class="zone-card__product">Wall Packs, Area Lights, Canopy &mdash; luxoARCH / cityARCH</div>
            <ul class="zone-card__list">
              <li>Full-cutoff dark-sky friendly distribution</li>
              <li>DampGuard for all-weather durability</li>
              <li>Photocell / dusk-to-dawn capable</li>
              <li>High lumen packages for security</li>
            </ul>
          </article>
          <article class="zone-card" data-zone="4">
            <div class="zone-card__num">Zone 06</div>
            <h3 class="zone-card__title">Emergency &amp; Egress</h3>
            <div class="zone-card__product">Emergency &amp; Exit Fixtures</div>
            <ul class="zone-card__list">
              <li>UL 924 listed</li>
              <li>90-minute battery backup</li>
              <li>Self-test models available</li>
              <li>Code-compliant illumination levels</li>
            </ul>
          </article>
        </div>
        <div class="callout-dark">
          <h4 class="callout-dark__title">Why Controls Matter in Data Centers</h4>
          <p class="callout-dark__body">ASHRAE 90.1 mandates occupancy and daylight controls in most data center spaces. ALG's sensorBLE platform delivers wireless, fixture-integrated sensing that reduces energy consumption by 40&ndash;60% in intermittently occupied zones like server aisles and mechanical rooms &mdash; directly improving your facility's Power Usage Effectiveness (PUE).</p>
        </div>
      </div>
    </section>

    <!-- 3. PRODUCT MATRIX -->
    <section class="section">
      <div class="container">
        <span class="sec-eyebrow">Product Selection Matrix</span>
        <h2 class="sec-title">Right fixture for every zone</h2>
        <div class="matrix-wrap">
          <table class="matrix-table">
            <thead>
              <tr>
                <th>Product Family</th><th>Series</th><th>Wattage</th><th>Lumens</th><th>CCT</th><th>Key Features</th><th>Zone</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="product-name">Linear High Bay</td><td class="mono">LLHB / Tiny</td><td class="mono">100-200W</td><td class="mono">15,000-30,000</td><td class="mono">35/40/50K</td><td>sensorBLE, surgeArmor, quickAdapt, DLC</td><td><span class="zone-chip">White Space</span></td></tr>
              <tr><td class="product-name">UFO High Bay</td><td class="mono">lamparARCH</td><td class="mono">100-200W</td><td class="mono">15,000-30,000</td><td class="mono">35/40/50K</td><td>sensorBLE, surgeArmor, DampGuard</td><td><span class="zone-chip">White Space</span></td></tr>
              <tr><td class="product-name">Vapor Tight</td><td class="mono">LV3P Series</td><td class="mono">25-80W</td><td class="mono">3,500-10,800</td><td class="mono">35/40/50K</td><td>IP66, DampGuard, linkable, impact resistant</td><td><span class="zone-chip zone-chip--2">Gray Space</span></td></tr>
              <tr><td class="product-name">Back-Lit Panel</td><td class="mono">planoARCH</td><td class="mono">25-50W</td><td class="mono">3,000-6,500</td><td class="mono">35/40/50K</td><td>Flicker-free, CRI 80+, control port, EB option</td><td><span class="zone-chip zone-chip--2">NOC</span></td></tr>
              <tr><td class="product-name">Troffer 2x2 / 2x4</td><td class="mono">planoARCH</td><td class="mono">25-50W</td><td class="mono">3,000-6,500</td><td class="mono">35/40/50K</td><td>DLC Premium, control-ready, EB option</td><td><span class="zone-chip zone-chip--2">NOC</span></td></tr>
              <tr><td class="product-name">Strip / Wrap</td><td class="mono">selectARCH</td><td class="mono">18-45W</td><td class="mono">2,200-5,400</td><td class="mono">35/40/50K</td><td>Surface/suspended, sensor compatible</td><td><span class="zone-chip">Corridors</span></td></tr>
              <tr><td class="product-name">Wall Pack</td><td class="mono">luxoARCH</td><td class="mono">20-80W</td><td class="mono">2,400-10,000</td><td class="mono">30/40/50K</td><td>Full-cutoff, DampGuard, photocell</td><td><span class="zone-chip zone-chip--3">Exterior</span></td></tr>
              <tr><td class="product-name">Area Light</td><td class="mono">cityARCH</td><td class="mono">70-300W</td><td class="mono">9,000-42,000</td><td class="mono">40/50K</td><td>High-mast, dark-sky, surge protected</td><td><span class="zone-chip zone-chip--3">Exterior</span></td></tr>
              <tr><td class="product-name">Canopy</td><td class="mono">luxoARCH</td><td class="mono">30-75W</td><td class="mono">3,600-9,500</td><td class="mono">40/50K</td><td>Surface mount, weather sealed</td><td><span class="zone-chip zone-chip--3">Exterior</span></td></tr>
              <tr><td class="product-name">Emergency / Exit</td><td class="mono">SPECIALTY</td><td class="mono">2-5W</td><td class="mono">UL 924</td><td class="mono">Varies</td><td>90-min backup, self-test, code compliant</td><td><span class="zone-chip zone-chip--4">Egress</span></td></tr>
            </tbody>

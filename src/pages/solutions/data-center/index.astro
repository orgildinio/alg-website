---
/**
 * solutions/data-center/index.astro
 * Industry Vertical: Data Center Lighting Solutions
 *
 * Phase B: Full content port from industry-vertical-data-center.html
 * Design system: /styles/industry-vertical-system.css (shared, loaded via slot="head")
 * Glow blob: inlined from glow-blob.js
 *
 * CFG-VERT-1: main[data-vertical="data-center"] preserved for per-vertical accent
 * CFG-CHROME-1: BaseLayout provides header/mega-menu/footer
 * CFG-COWORK-15: system CSS loaded as real stylesheet, not inlined/stripped
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Data Center Lighting Solutions — Archipelago Lighting Group"
  description="Hyperscale and colocation facility lighting with controls integration. Low-profile troffers and linear with BMS-ready DALI and 0–10V dimming."
  bodyClass="page-vertical-data-center"
>
  <Fragment slot="head">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.archipelagolighting.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Solutions",
          "item": "https://www.archipelagolighting.com/solutions/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Data Center",
          "item": "https://www.archipelagolighting.com/solutions/data-center/"
        }
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What lighting is recommended for data centers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Data centers require highly efficient, low-heat LED lighting with precise optical control to illuminate server aisles without wasting energy. Continuous linear runs or strategically placed low-bays are ideal."
          }
        },
        {
          "@type": "Question",
          "name": "What controls do data center facilities need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Data centers rely heavily on aisle-level occupancy sensors. Since server aisles are infrequently occupied, fixtures should remain off or dimmed to 10% until a technician enters the aisle."
          }
        },
        {
          "@type": "Question",
          "name": "Are there DLC rebates for data center lighting?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, data centers can offset upgrade costs through utility rebates by specifying DLC Premium fixtures and networked lighting controls, contributing to lower PUE (Power Usage Effectiveness) metrics."
          }
        }
      ]
    }
    </script>
  </Fragment>

  <link rel="stylesheet" href="/styles/industry-vertical-system.css" slot="head" />

  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">HOME</a>
    <span class="bc-sep">›</span>
    <a href="/solutions/">SOLUTIONS</a>
    <span class="bc-sep">›</span>
    <span class="bc-current">Data Center</span>
  </nav>


<div aria-hidden="true" class="glow-orb"></div>

  <script is:inline>
/* ============================================================
   GLOW ORB — per-vertical accent blob that slowly follows scroll
   Sits behind all content (z-index 0). Opaque cards + text render
   on top, so the glow only colors the exposed background surface.
   Accent hue is copied from the active vertical's --vert-accent
   by glow-blob.js at load.
   ============================================================ */
(function () {
  function init() {
    var orb = document.querySelector('.glow-orb');
    var main = document.querySelector('main[data-vertical]');
    if (!orb || !main) return;

    // Inherit the vertical accent hue (defined on main[data-vertical])
    var accent = getComputedStyle(main).getPropertyValue('--vert-accent').trim();
    if (accent) orb.style.setProperty('--vert-accent', accent);

    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var curX = window.innerWidth * 0.72;
    var curY = window.innerHeight * 0.28;

    function targets() {
      var max = document.documentElement.scrollHeight - window.innerHeight;
      var f = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      // vertical: trails from near-top to near-bottom of the viewport
      var ty = window.innerHeight * (0.12 + 0.72 * f);
      // horizontal: gentle organic sweep across the page
      var tx = window.innerWidth * (0.72 - 0.46 * Math.sin(f * Math.PI));
      return { tx: tx, ty: ty };
    }

    if (reduce) {
      var t = targets();
      orb.style.transform = 'translate(' + t.tx + 'px,' + t.ty + 'px) translate(-50%,-50%)';
      return;
    }

    function tick() {
      var t = targets();
      // slow lerp — the blob lags well behind the scroll position
      curX += (t.tx - curX) * 0.04;
      curY += (t.ty - curY) * 0.04;
      orb.style.transform = 'translate(' + curX + 'px,' + curY + 'px) translate(-50%,-50%)';
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
  </script>

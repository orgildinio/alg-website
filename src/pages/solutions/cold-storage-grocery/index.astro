---
/**
 * verticals/cold-storage/index.astro
 * Industry Vertical: Cold Storage & Grocery
 *
 * Ported from industry-vertical-cold-storage.html (Phase A reference build).
 * Design system: industry-vertical-system.css tokens mapped to site tokens.
 *
 * Calibration patches applied:
 *   --brand-red #F32740 → var(--color-alg-red)
 *   --bg-page #1c2025 → dark surface (self-contained, not site default)
 *   --font-body 'Lato' → var(--font-sans)
 *   --font-mono 'JetBrains Mono' → var(--font-mono)
 *   Staging chrome stripped (BaseLayout provides Header/Footer)
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Cold Storage & Grocery Lighting · ALG"
  description="Total-store LED package from −40°F freezers to fuel canopies. Specify one manufacturer for cooler, sales floor, back-of-house, and exterior zones."
  bodyClass="page-vertical-cold-storage"
>
<style>
  /* ── Dark surface tokens (self-contained to this page) ── */
  .vert-page {
    --brand-red:       var(--color-alg-red, #F32740);
    --brand-red-dark:  var(--color-alg-red-dark, #C41E32);
    --brand-red-hsl:   353 80% 55%;
    --bg-page:         #1c2025;
    --bg-card:         #2a2e34;
    --bg-spec:         #22262b;
    --bg-deepest:      #15181c;
    --text-primary:    #ECEDEF;
    --text-secondary:  #A8AEB7;
    --text-muted:      #6E7682;
    --line:            rgba(255,255,255,0.08);
    --line-medium:     rgba(255,255,255,0.14);
    --line-strong:     rgba(255,255,255,0.22);
    --font-body:       var(--font-sans, 'Lato', system-ui, sans-serif);
    --font-mono:       'JetBrains Mono', ui-monospace, 'SF Mono', Consolas, monospace;
    --radius-sm:       2px;
    --radius:          4px;
    --radius-lg:       8px;
    --container:       1280px;
    /* Vertical accent — cold storage */
    --vert-accent:      199 89% 48%;
    --vert-accent-soft: 199 89% 48% / 14%;
    --vert-zone-1:      199 89% 48%;
    --vert-zone-2:      353 80% 55%;
    --vert-zone-3:      38 92% 56%;
    --vert-zone-4:      142 71% 45%;

    background: var(--bg-page);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }

  /* ── Breadcrumb ── */
  .breadcrumb-band {
    padding: 10px 32px;
    border-bottom: 1px solid var(--line);
    background: var(--bg-deepest);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0;
  }
  .breadcrumb-band a { color: inherit; text-decoration: none; }
  .breadcrumb-band a:hover { color: var(--text-primary); }
  .bc-sep { margin: 0 10px; }
  .bc-current { color: var(--text-primary); font-weight: 700; }

  /* ── Container ── */
  .container {
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 32px;
  }
  @media (max-width: 760px) { .container { padding: 0 20px; } }

  /* ── Eyebrow: delegated to global sec-eyebrow ── */

  /* ── Hero trust line ── */
  .solutions-hero .cta-trust-line,
  .hero .cta-trust-line {
    font-size: 13px;
    line-height: 1.5;
    color: rgba(255,255,255,0.62);
    margin-top: 12px;
    max-width: 64ch;
  }

  /* ── Why bullets ── */
  .why-bullets {
    list-style: none;
    padding: 0;
    margin: 16px 0 24px;
  }
  .why-bullets li {
    position: relative;
    padding-left: 20px;
    margin-bottom: 10px;
    font-size: 15px;
    line-height: 1.5;
  }
  .why-bullets li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--brand-red, #F32740);
    font-weight: 700;
  }

  /* ── Hero ── */
  .hero {
    padding: 80px 0 72px;
    background: var(--bg-deepest);
    border-bottom: 1px solid var(--line);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 48px;
    align-items: start;
  }
  @media (max-width: 900px) { .hero__grid { grid-template-columns: 1fr; } }
  /* ── Hero eyebrow: delegated to global sec-eyebrow ── */
  .hero__title {
    font-size: 52px;
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.08;
    color: var(--text-primary);
    margin: 0 0 20px;
  }
  @media (max-width: 760px) { .hero__title { font-size: 34px; } }
  .hero__deck {
    font-size: 17px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 32px;
    max-width: 560px;
  }
  .hero__cta-row { display: flex; gap: 12px; flex-wrap: wrap; }

  /* ── Buttons ── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 12px 22px;
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: background .15s, color .15s, border-color .15s;
  }
  .btn--primary {
    background: var(--brand-red);
    color: #fff;
    border: 2px solid var(--brand-red);
  }
  .btn--primary:hover { background: var(--brand-red-dark); border-color: var(--brand-red-dark); }
  .btn--ghost {
    background: transparent;
    color: var(--text-primary);
    border: 2px solid var(--line-strong);
  }
  .btn--ghost:hover { border-color: var(--text-secondary); }
  .arrow { font-size: 16px; }

  /* ── Info card ── */
  .info-card {
    background: var(--bg-card);
    border: 1px solid var(--line-medium);
    border-radius: var(--radius-lg);
    padding: 28px;
  }
  .info-card__label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 20px;
  }
  .stat { margin-bottom: 20px; }
  .stat:last-child { margin-bottom: 0; }
  .stat__value {
    font-size: 28px;
    font-weight: 900;
    letter-spacing: -0.02em;
    color: hsl(var(--vert-accent));
    line-height: 1;
    margin-bottom: 4px;
  }
  .stat__label { font-size: 13px; color: var(--text-secondary); line-height: 1.4; }

  /* ── Section ── */
  .section { padding: 72px 0; border-bottom: 1px solid var(--line); }
  /* ── Section title: delegated to global sec-title ── */
  .section-deck {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 680px;
    margin: 0 0 40px;
  }

  /* ── Zone cards ── */
  .zones {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
    margin-bottom: 32px;
  }
  .zone-card {
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-left: 4px solid hsl(var(--vert-zone-1));
    border-radius: var(--radius);
    padding: 20px 22px;
  }
  .zone-card[data-zone="2"] { border-left-color: hsl(var(--vert-zone-2)); }
  .zone-card[data-zone="3"] { border-left-color: hsl(var(--vert-zone-3)); }
  .zone-card[data-zone="4"] { border-left-color: hsl(var(--vert-zone-4)); }
  .zone-card--wide { grid-column: 1 / -1; }
  @media (max-width: 600px) { .zone-card--wide { grid-column: auto; } }
  .zone-card__num {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 6px;
  }
  .zone-card__title {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 6px;
  }
  .zone-card__product {
    font-family: var(--font-mono);
    font-size: 11px;
    color: hsl(var(--vert-accent));
    margin-bottom: 10px;
  }
  .zone-card__list {
    margin: 0;
    padding-left: 16px;
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* ── Callout dark ── */
  .callout-dark {
    background: var(--bg-spec);
    border: 1px solid var(--line-medium);
    border-left: 4px solid hsl(var(--vert-accent));
    border-radius: var(--radius);
    padding: 24px 28px;
    margin-top: 8px;
  }
  .callout-dark__title {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 8px;
  }
  .callout-dark__body {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Product matrix ── */
  .matrix-wrap { overflow-x: auto; }
  .matrix-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .matrix-table th {
    background: var(--bg-spec);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .12em;
    text-transform: uppercase;
    padding: 10px 14px;
    text-align: left;
    border-bottom: 1px solid var(--line-medium);
    white-space: nowrap;
  }
  .matrix-table td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    color: var(--text-secondary);
    vertical-align: top;
  }
  .matrix-table tr:hover td { background: var(--bg-card); }
  .product-name { color: var(--text-primary); font-weight: 600; }
  .mono { font-family: var(--font-mono); font-size: 12px; }
  .zone-chip {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .08em;
    background: hsl(var(--vert-zone-1) / 18%);
    color: hsl(var(--vert-zone-1));
  }
  .zone-chip--2 { background: hsl(var(--vert-zone-2) / 18%); color: hsl(var(--vert-zone-2)); }
  .zone-chip--3 { background: hsl(var(--vert-zone-3) / 18%); color: hsl(var(--vert-zone-3)); }
  .zone-chip--4 { background: hsl(var(--vert-zone-4) / 18%); color: hsl(var(--vert-zone-4)); }

  /* ── Tech grid ── */
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
    margin-top: 8px;
  }
  .tech-badge {
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 20px;
  }
  .tech-badge__icon {
    width: 36px;
    height: 36px;
    color: hsl(var(--vert-accent));
    margin-bottom: 12px;
  }
  .tech-badge__icon svg { width: 100%; height: 100%; }
  .tech-badge__title {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 6px;
  }
  .tech-badge__desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  /* ── Spotlight grid ── */
  .spotlight-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }
  .spotlight-card {
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .spotlight-card__media {
    height: 160px;
    background: linear-gradient(135deg, hsl(var(--vert-accent) / 20%), hsl(var(--vert-accent) / 8%));
    display: flex;
    align-items: center;
    justify-content: center;
    color: hsl(var(--vert-accent));
    position: relative;
  }
  .spotlight-card__media svg { width: 48px; height: 48px; opacity: .6; }
  .spotlight-card__media::after {
    content: attr(data-caption);
    position: absolute;
    bottom: 8px;
    right: 10px;
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--text-muted);
    letter-spacing: .08em;
  }
  .spotlight-card__body { padding: 20px; }
  .spotlight-card__title {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 8px;
  }
  .spotlight-card__desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0 0 10px;
  }
  .spotlight-card__meta {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .1em;
    color: hsl(var(--vert-accent));
    text-transform: uppercase;
  }

  /* ── Value banner ── */
  .value-banner {
    background: var(--bg-spec);
    border: 1px solid var(--line-medium);
    border-radius: var(--radius-lg);
    padding: 40px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 40px;
    align-items: start;
  }
  @media (max-width: 760px) { .value-banner { grid-template-columns: 1fr; } }
  .value-banner__title {
    font-size: 28px;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }
  .value-banner__body {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.65;
    margin: 0;
  }
  .value-banner__metrics { display: flex; flex-direction: column; gap: 20px; min-width: 200px; }
  .value-metric__num {
    font-size: 26px;
    font-weight: 900;
    color: hsl(var(--vert-accent));
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: 4px;
  }
  .value-metric__label { font-size: 12px; color: var(--text-secondary); line-height: 1.4; }

  /* ── Procurement grid ── */
  .procurement-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px;
    margin-top: 8px;
  }
  .proc-step {
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
    position: relative;
  }
  .proc-step__big {
    display: block;
    font-size: 64px;
    font-weight: 900;
    color: hsl(var(--vert-accent) / 12%);
    line-height: 1;
    position: absolute;
    top: 12px;
    right: 16px;
    font-family: var(--font-mono);
    pointer-events: none;
  }
  .proc-step__num {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: hsl(var(--vert-accent));
    margin-bottom: 8px;
  }
  .proc-step__title {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 8px;
  }
  .proc-step__desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  /* ── Advantage strip ── */
  .advantage-strip {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 48px;
  }
  .advantage-pillar {
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
    text-align: center;
  }
  .advantage-pillar__num {
    font-size: 32px;
    font-weight: 900;
    color: hsl(var(--vert-accent));
    letter-spacing: -0.02em;
    margin-bottom: 4px;
  }
  .advantage-pillar__label {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 6px;
  }
  .advantage-pillar__desc {
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* ── Closing CTA ── */
  .closing-cta {
    background: linear-gradient(135deg, hsl(var(--brand-red-hsl) / 12%), hsl(var(--vert-accent) / 8%));
    border: 1px solid hsl(var(--brand-red-hsl) / 30%);
    border-radius: var(--radius-lg);
    padding: 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }
  .closing-cta__title {
    font-size: 22px;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }
  .closing-cta__deck {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0;
  }
  .closing-cta__buttons { display: flex; gap: 12px; flex-wrap: wrap; flex-shrink: 0; }
</style>

<div class="vert-page">
  <!-- Breadcrumb -->
  <nav class="breadcrumb-band" aria-label="Breadcrumb">
    <div class="container" style="display:flex;align-items:center;padding-top:0;padding-bottom:0;">
      <a href="/">Home</a>
      <span class="bc-sep">›</span>
      <a href="/solutions">Solutions</a>
      <span class="bc-sep">›</span>
      <span class="bc-current">Cold Storage &amp; Grocery</span>
    </div>
  </nav>

  <main data-vertical="cold-storage">
    <!-- 1. HERO -->
    <section class="hero" data-screen-label="Hero">
      <div class="container">
        <div class="hero__grid">
          <div>
            <span class="hero__eyebrow">Vertical Solutions · Cold Storage &amp; Grocery</span>
            <h1 class="hero__title">Cold Storage &amp; Grocery Lighting</h1>
            <p class="hero__deck">Total-store LED package—from −40°F freezers to fuel canopies. Specify one manufacturer for cooler, sales floor, back-of-house, and exterior zones—with consistent performance, documentation, and warranty support.</p>
            <div class="hero__cta-row">
              <a href="mailto:sales@archipelagolighting.com?subject=Photometric%20request" class="btn btn--primary">Request a Photometric <span class="arrow">→</span></a>
              <a href="/spec-packs/ALG_Cold_Storage_Grocery_Lighting.pdf" class="btn btn--ghost" target="_blank" rel="noopener" download>Download Spec Pack <span class="arrow">→</span></a>
            </div>
            <p class="cta-trust-line">Includes cutsheets, IES files, DLC documentation (where applicable), and compliance certificates on request.</p>
          </div>
          <aside class="info-card" aria-label="Key specs">
            <div class="info-card__label">Key Specs</div>
            <div class="stat">
              <div class="stat__value">−40°F</div>
              <div class="stat__label">Rated freezer &amp; walk-in cooler operation</div>
            </div>
            <div class="stat">
              <div class="stat__value">IP66</div>
              <div class="stat__label">Moisture sealed for washdown environments</div>
            </div>
            <div class="stat">
              <div class="stat__value">BAA · TAA</div>
              <div class="stat__label">Compliant for federal &amp; food-security projects</div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- 2. LIGHTING BY ZONE -->
    <section class="section" data-screen-label="Zones">
      <div class="container">
        <span class="sec-eyebrow">Lighting by Zone</span>
        <h2 class="sec-title">Every zone in the store</h2>
        <p class="section-deck">Cold storage and grocery environments demand more than "cold-rated": moisture, washdown, condensation, frequent switching, and visual merchandising all matter. ALG supports a complete package—from −40°F freezer zones to fuel canopies—so teams can standardize performance, documentation, and warranty support across locations.</p>
        <div class="zones">
          <article class="zone-card" data-zone="1">
            <div class="zone-card__num">Zone 01</div>
            <h3 class="zone-card__title">Walk-In Coolers &amp; Freezers</h3>
            <div class="zone-card__product">Walk-In Cooler Fixtures · SPECIALTY</div>
            <ul class="zone-card__list">
              <li>Rated to −40°F for freezers and walk-ins</li>
              <li>IP66 moisture sealed for washdown</li>
              <li>Driver-free AC design &mdash; max cold reliability</li>
              <li>Instant-on: no warm-up delay in cold</li>
              <li>50,000hr L70 rated life</li>
              <li>High CRI for product visibility</li>
            </ul>
          </article>
          <article class="zone-card" data-zone="1">
            <div class="zone-card__num">Zone 02</div>
            <h3 class="zone-card__title">Refrigerated Display Cases</h3>
            <div class="zone-card__product">LED Tubes · tubul<span class="aa">Ⓐ</span>RCH T8 Type B</div>
            <ul class="zone-card__list">
              <li>Ballast-bypass for max efficiency</li>
              <li>4000K&ndash;5000K for product appeal</li>
              <li>Instant-on, mercury-free</li>
              <li>Universal voltage 120&ndash;277V</li>
              <li>Direct retrofit for existing cases</li>
            </ul>
          </article>
          <article class="zone-card" data-zone="2">
            <div class="zone-card__num">Zone 03</div>
            <h3 class="zone-card__title">Sales Floor</h3>
            <div class="zone-card__product">Troffers &amp; Back-Lit Panels · plano<span class="aa">Ⓐ</span>RCH</div>
            <ul class="zone-card__list">
              <li>2x2 and 2x4 options</li>
              <li>CRI 80+ for true product colors</li>
              <li>Watt/CCT selectable</li>
              <li>Control-ready port for 0&ndash;10V dimming</li>
              <li>DLC Premium for utility rebates</li>
            </ul>
          </article>
          <article class="zone-card" data-zone="2">
            <div class="zone-card__num">Zone 04</div>
            <h3 class="zone-card__title">Back of House / Stockroom</h3>
            <div class="zone-card__product">Strips &amp; Wraps · select<span class="aa">Ⓐ</span>RCH</div>
            <ul class="zone-card__list">
              <li>Low-profile continuous lighting</li>
              <li>Durable for high-traffic areas</li>
              <li>Energy-efficient, surface mount</li>
              <li>Motion sensor compatible</li>
            </ul>
          </article>
          <article class="zone-card" data-zone="3">
            <div class="zone-card__num">Zone 05</div>
            <h3 class="zone-card__title">Fuel Canopy / C-Store Exterior</h3>

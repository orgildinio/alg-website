  .contact-rep__note {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 12px;
  }
  .contact-rep__link {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--red);
    text-decoration: none;
    border-bottom: 1px solid rgba(243,39,64,0.3);
    padding-bottom: 2px;
    transition: border-color 0.15s;
  }
  .contact-rep__link:hover { border-color: var(--red); }

  /* ── Direct lines ──────────────────────────────────────────────────────── */
  .contact-lines-card {
    background: var(--bg-card);
    border-left: 3px solid var(--red);
    padding: 20px 20px 20px 18px;
    margin-bottom: 24px;
  }
  .contact-lines-card__header {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 8px;
  }
  .contact-lines-card__phone {
    display: block;
    font-family: 'Lato', system-ui, sans-serif;
    font-size: 28px;
    font-weight: 900;
    color: var(--text-pri);
    text-decoration: none;
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }
  .contact-lines-card__phone:hover { color: var(--red); }
  .contact-lines-card__hours {
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .contact-lines-list { display: flex; flex-direction: column; gap: 14px; margin-bottom: 28px; }
  .contact-lines-item { display: flex; flex-direction: column; gap: 3px; }
  .contact-lines-item__label {
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .contact-lines-item__val {
    font-size: 13px;
    color: var(--text-sec);
    text-decoration: none;
    transition: color 0.15s;
  }
  .contact-lines-item__val:hover { color: var(--red); }

  .contact-qlinks { display: flex; flex-direction: column; gap: 0; margin-bottom: 28px; }
  .contact-qlink {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    transition: color 0.15s;
    gap: 8px;
  }
  .contact-qlink:first-child { border-top: 1px solid var(--border); }
  .contact-qlink__label {
    font-size: 13px;
    color: var(--text-sec);
    transition: color 0.15s;
  }
  .contact-qlink__arrow {

  }

  /* ── FAQ ───────────────────────────────────────────────────────────────── */
  .contact-faq { border-top: 1px solid var(--border); }
  .contact-faq__inner {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 64px;
    max-width: var(--shell-max, 1320px);

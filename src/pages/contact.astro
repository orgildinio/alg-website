---
/**
 * contact.astro — Contact Us · Field Desk
 * Route: /contact
 * Design ref: ALG-Contact-v1.html (VariationC)
 *
 * Composition (1:1 from mockup):
 *   .alg-page--glow (dark canvas, #1A1D23)
 *     └── .glow-clip > .glow-orb (scroll-trailing red radial)
 *     └── <section .alg-section .alg-section--dark>  ← HERO (dark, orb glows through)
 *     └── <section .alg-section>                     ← 3-COL FORM/MAP/RAIL (opaque white)
 *     └── <section .alg-section .alg-section--c1>    ← FAQ (--c1 = #F5F4F1)
 *
 * The dark canvas shows between sections (inter-section gaps) and the orb glows
 * through the dark hero strip and the dark canvas gaps.
 */
import ContentShell from '../layouts/ContentShell.astro';
---

<ContentShell
  title="Contact Us — Archipelago Lighting Group"
  description="Reach the ALG spec desk, sales team, warranty department, or find your local rep. Direct lines, direct form — no nav required."
  bodyClass="page-contact"
  hideFooterCta={true}
>

<!-- ── DARK CANVAS ROOT ─────────────────────────────────────────────────── -->
<div class="alg-page alg-page--glow">

  <!-- Glow orb -->
  <div class="glow-clip" aria-hidden="true">
    <div class="glow-orb"></div>
  </div>

  <!-- ── SECTION 1: DARK HERO ──────────────────────────────────────────── -->
  <section class="alg-section alg-section--dark">
    <div class="hero-grid">
      <div class="hero-left">
        <span class="alg-eyebrow alg-eyebrow--red">Contact · Field Desk · 2026</span>
        <h1 class="alg-h1" style="margin-top:18px; color:#fff; font-size:clamp(40px,5vw,60px);">
          The whole desk,<br>
          <span style="color:var(--brand)">on one page.</span>
        </h1>
      </div>
      <div class="hero-right">
        <p style="font-size:15px; line-height:1.6; color:rgba(255,255,255,.75);">
          Built for the contractor at 6 AM with a takeoff due. Quote desk, spec
          engineer, warranty, rep finder — direct dial, direct form, no nav.
          ALG runs the line out of Montclair, CA.
        </p>
      </div>
    </div>
    <!-- Stats bar -->
    <div class="stats-grid">
      <div class="alg-stat alg-stat--dark">
        <div class="alg-stat__v">&lt; 4 hr</div>
        <div class="alg-stat__k">Quote turnaround</div>
      </div>
      <div class="alg-stat alg-stat--dark">
        <div class="alg-stat__v">5–7 days</div>
        <div class="alg-stat__k">PRO ship time</div>
      </div>
      <div class="alg-stat alg-stat--dark">
        <div class="alg-stat__v">7 yr</div>
        <div class="alg-stat__k">PRO warranty</div>
      </div>
      <div class="alg-stat alg-stat--dark">
        <div class="alg-stat__v">48 hr</div>
        <div class="alg-stat__k">RMA authorization</div>
      </div>
      <div class="alg-stat alg-stat--dark">
        <div class="alg-stat__v" style="font-size:clamp(16px,2vw,22px)">(866) 912-3220</div>
        <div class="alg-stat__k">Main · Mon–Fri PT</div>
      </div>
    </div>
  </section>

  <!-- ── SECTION 2: 3-COL FORM / MAP / RAIL (opaque white) ────────────── -->
  <section class="alg-section" style="padding-top:64px; padding-bottom:80px;">
    <div class="cols-grid">

      <!-- COL 1: SEND A MESSAGE -->
      <div class="col-form">
        <div class="alg-cat-bar">
          <div class="alg-cat-bar__label">01 · Send a message</div>
          <div class="alg-cat-bar__tag">Routed by topic</div>
        </div>
        <p class="alg-body--sm" style="margin-top:18px; margin-bottom:18px;">
          Pick a topic. We route directly to the desk that owns it — no central inbox.
        </p>

        <!-- Route chips (segmented bordered control, verbatim from mockup) -->
        <div class="alg-chips" id="contact-chips" role="group" aria-label="Message topic">
          <button class="alg-chip active" data-route="quote" data-to="sales@archipelagolighting.com" data-subject="Quote Request" type="button">
            <span class="alg-chip__icon">01</span>Quote
          </button>
          <button class="alg-chip" data-route="spec" data-to="sales@archipelagolighting.com" data-subject="Spec Request" type="button">
            <span class="alg-chip__icon">02</span>Spec
          </button>
          <button class="alg-chip" data-route="dist" data-to="sales@archipelagolighting.com" data-subject="Distributor Inquiry" type="button">
            <span class="alg-chip__icon">03</span>Distributor
          </button>
          <button class="alg-chip" data-route="support" data-to="warranty@archipelagolighting.com" data-subject="Warranty Claim" type="button">
            <span class="alg-chip__icon">04</span>Warranty
          </button>
          <button class="alg-chip" data-route="press" data-to="sales@archipelagolighting.com" data-subject="[PRESS] Inquiry" type="button">
            <span class="alg-chip__icon">05</span>Press
          </button>
        </div>

        <!-- Form (2-col grid, verbatim from mockup) -->
        <form class="alg-form" id="contact-form" novalidate style="margin-top:24px;">
          <div class="alg-row">
            <div class="alg-field">
              <label class="alg-label" for="cf-name">Name <span class="req">*</span></label>
              <input class="alg-input" id="cf-name" name="name" type="text" placeholder="Jordan Reyes" autocomplete="name" required />
            </div>
            <div class="alg-field">
              <label class="alg-label" for="cf-company">Company <span class="req">*</span></label>
              <input class="alg-input" id="cf-company" name="company" type="text" placeholder="Firm / Company" autocomplete="organization" required />
            </div>
          </div>
          <div class="alg-row">
            <div class="alg-field">
              <label class="alg-label" for="cf-email">Work email <span class="req">*</span></label>
              <input class="alg-input" id="cf-email" name="email" type="email" placeholder="jordan@firm.com" autocomplete="email" required />
            </div>
            <div class="alg-field">
              <label class="alg-label" for="cf-phone">Phone</label>
              <input class="alg-input" id="cf-phone" name="phone" type="tel" placeholder="(866) 912-3220" autocomplete="tel" />
            </div>
          </div>
          <!-- Route-specific fields -->
          <div class="alg-row route-fields" data-show="quote">
            <div class="alg-field">
              <label class="alg-label" for="cf-job">Job name</label>
              <input class="alg-input" id="cf-job" name="job" type="text" placeholder="Riverside DC Phase II" />
            </div>
            <div class="alg-field">
              <label class="alg-label" for="cf-timeline">Timeline <span class="req">*</span></label>
              <select class="alg-select" id="cf-timeline" name="timeline">
                <option value="" disabled selected>Select…</option>
                <option>Bidding now</option>
                <option>Design phase</option>
                <option>Schematic</option>
              </select>
            </div>
          </div>
          <div class="alg-row route-fields" data-show="spec" style="display:none">
            <div class="alg-field">
              <label class="alg-label" for="cf-projtype">Project type <span class="req">*</span></label>
              <select class="alg-select" id="cf-projtype" name="projtype">
                <option value="" disabled selected>Select…</option>
                <option>New construction</option>
                <option>Retrofit</option>
              </select>
            </div>
            <div class="alg-field">
              <label class="alg-label" for="cf-need">Need <span class="req">*</span></label>
              <select class="alg-select" id="cf-need" name="need">
                <option value="" disabled selected>Select…</option>
                <option>IES / photometric</option>
                <option>Spec sheet</option>
                <option>Controls drawings</option>
                <option>Mockup sample</option>
              </select>
            </div>
          </div>
          <div class="alg-row route-fields" data-show="dist" style="display:none">
            <div class="alg-field">
              <label class="alg-label" for="cf-acct">Account # <span class="req">*</span></label>
              <input class="alg-input" id="cf-acct" name="acct" type="text" placeholder="ALG-DIST-####" />
            </div>
            <div class="alg-field">
              <label class="alg-label" for="cf-zip">Branch ZIP</label>
              <input class="alg-input" id="cf-zip" name="zip" type="text" placeholder="91763" />
            </div>
          </div>
          <div class="alg-row route-fields" data-show="support" style="display:none">
            <div class="alg-field">
              <label class="alg-label" for="cf-po">Original PO <span class="req">*</span></label>
              <input class="alg-input" id="cf-po" name="po" type="text" placeholder="PO-####" />
            </div>
            <div class="alg-field">
              <label class="alg-label" for="cf-sku">Failed SKU <span class="req">*</span></label>
              <input class="alg-input" id="cf-sku" name="sku" type="text" placeholder="ALG-RHB-PRO-150W-50K-UNV" />
            </div>
          </div>
          <div class="alg-row route-fields" data-show="press" style="display:none">
            <div class="alg-field">
              <label class="alg-label" for="cf-topic">Topic <span class="req">*</span></label>
              <select class="alg-select" id="cf-topic" name="topic">
                <option value="" disabled selected>Select…</option>
                <option>Editorial</option>
                <option>OEM partnership</option>
                <option>Rep application</option>
                <option>ⒶCS App integration</option>
              </select>
            </div>
            <div class="alg-field">
              <label class="alg-label" for="cf-deadline">Deadline</label>
              <input class="alg-input" id="cf-deadline" name="deadline" type="date" />
            </div>
          </div>
          <div class="alg-field">
            <label class="alg-label" for="cf-message">Message <span class="req">*</span></label>
            <textarea class="alg-textarea" id="cf-message" name="message" rows="5"
              placeholder="Paste BOM or describe scope. Quantity helps."></textarea>
          </div>
          <button class="alg-submit" type="submit">
            Send to ALG <span class="alg-submit__arrow">→</span>
          </button>
        </form>
      </div>

      <!-- COL 2: FIND YOUR REP (Leaflet locator, light Positron, .alg-rep cards) -->
      <div class="col-map">
        <div class="alg-cat-bar">
          <div class="alg-cat-bar__label">02 · Find your rep</div>
          <div class="alg-cat-bar__tag">By region · 5 territories</div>
        </div>
        <p class="alg-body--sm" style="margin-top:18px; margin-bottom:18px;">
          Search by ZIP, city, or state. Your project ZIP routes to the nearest rep.
        </p>
        <!-- Search toolbar -->
        <div class="c02-toolbar">
          <div class="loc-search-group">
            <input type="text" class="loc-search-input" id="c02-search-input" placeholder="ZIP, city, or state" aria-label="Search by ZIP, city, or state" />
            <button class="loc-search-btn" id="c02-search-btn">Find Nearest</button>
          </div>
        </div>
        <!-- Leaflet map — light Positron, framed in .alg-map panel -->
        <div class="alg-map">
          <div id="algLocatorMapContact" class="c02-locator-map" aria-label="ALG sales rep locations" role="application"></div>
        </div>
        <!-- Rep cards rendered below the map (populated by JS from real data) -->
        <div id="c02-rep-cards" class="c02-rep-cards" style="margin-top:16px; display:flex; flex-direction:column; gap:10px;"></div>
        <div style="margin-top:14px;">
          <a href="/find-a-rep/" class="c02-full-link">Open full rep finder →</a>
        </div>
      </div>

      <!-- COL 3: DIRECT LINES RAIL -->
      <aside class="col-rail" style="display:flex; flex-direction:column; gap:18px;">
        <div class="alg-cat-bar">
          <div class="alg-cat-bar__label">03 · Direct lines</div>
          <div class="alg-cat-bar__tag">Mon–Fri · PT</div>
        </div>

        <!-- Phone card (ink) -->
        <div class="alg-card alg-card--ink" style="padding:22px; margin-top:6px;">
          <span class="alg-eyebrow alg-eyebrow--red">Spec Desk · Main</span>
          <div style="font-family:var(--font-mono); font-size:23px; font-weight:600; color:#fff; margin-top:10px; letter-spacing:-.01em;">
            <a href="tel:8669123220" style="color:#fff; text-decoration:none;">(866) 912-3220</a>
          </div>
          <div style="font-family:var(--font-mono); font-size:10.5px; color:rgba(255,255,255,.5); margin-top:4px; letter-spacing:.08em; text-transform:uppercase;">
            Mon–Fri · 7:00–17:00 PT
          </div>
          <div style="margin-top:16px;">
            <div class="alg-line alg-line--dark">
              <div class="alg-line__k">Sales</div>
              <div class="alg-line__v"><a href="mailto:sales@archipelagolighting.com" style="color:rgba(255,255,255,.75); text-decoration:none;">sales@archipelagolighting.com</a></div>
            </div>
            <div class="alg-line alg-line--dark">
              <div class="alg-line__k">Spec</div>
              <div class="alg-line__v"><a href="mailto:spec@archipelagolighting.com" style="color:rgba(255,255,255,.75); text-decoration:none;">spec@archipelagolighting.com</a></div>
            </div>
            <div class="alg-line alg-line--dark">
              <div class="alg-line__k">Warranty</div>
              <div class="alg-line__v"><a href="mailto:warranty@archipelagolighting.com" style="color:rgba(255,255,255,.75); text-decoration:none;">warranty@archipelagolighting.com</a></div>
            </div>
            <div class="alg-line alg-line--dark">
              <div class="alg-line__k">Press</div>
              <div class="alg-line__v"><a href="mailto:press@archipelagolighting.com" style="color:rgba(255,255,255,.75); text-decoration:none;">press@archipelagolighting.com</a></div>
            </div>
          </div>
        </div>

        <!-- Spec library quick links -->
        <div>
          <span class="alg-eyebrow" style="margin-bottom:10px; display:block;">Spec library</span>
          <div style="display:flex; flex-direction:column; gap:6px;">
            <a href="/support/library/" class="alg-qlink">
              <div><div class="alg-qlink__title">IES files</div><div class="alg-qlink__sub">By SKU · Versioned</div></div>
              <div class="alg-qlink__arrow">→</div>
            </a>
            <a href="/support/library/" class="alg-qlink">
              <div><div class="alg-qlink__title">Cut sheets</div><div class="alg-qlink__sub">ECO / PRO / PRO+</div></div>
              <div class="alg-qlink__arrow">→</div>
            </a>
            <a href="mailto:warranty@archipelagolighting.com?subject=Warranty%20Claim" class="alg-qlink">
              <div><div class="alg-qlink__title">Warranty form</div><div class="alg-qlink__sub">7-yr / 5-yr</div></div>
              <div class="alg-qlink__arrow">→</div>
            </a>
            <a href="/support/returns" class="alg-qlink">
              <div><div class="alg-qlink__title">Returns · RMA</div><div class="alg-qlink__sub">48-hr auth</div></div>
              <div class="alg-qlink__arrow">→</div>
            </a>
            <a href="/support/library/" class="alg-qlink">
              <div><div class="alg-qlink__title">Stocking SKUs</div><div class="alg-qlink__sub">2026 catalog</div></div>
              <div class="alg-qlink__arrow">→</div>
            </a>
          </div>
        </div>

        <!-- HQ address card -->
        <div class="alg-card">
          <span class="alg-eyebrow alg-eyebrow--red">Montclair HQ</span>
          <div style="font-family:var(--font-mono); font-size:12.5px; color:var(--ink2); margin-top:12px; line-height:1.7;">
            5101 Commerce Drive<br>
            Montclair, CA 91763
          </div>
          <div style="margin-top:12px; padding-top:12px; border-top:1px solid var(--c2);">
            <span class="alg-eyebrow alg-eyebrow--red" style="font-size:10px;">Production · Riverside</span>
            <div style="font-family:var(--font-mono); font-size:12.5px; color:var(--ink2); margin-top:8px; line-height:1.7;">
              2840 Industrial Way<br>
              Riverside, CA 92507
            </div>
          </div>
        </div>

        <!-- Field reality callout -->
        <div style="padding:14px 16px; background:var(--c1); border-left:3px solid var(--brand); font-family:var(--font-mono); font-size:11.5px; color:var(--ink2); line-height:1.6;">
          <span style="color:var(--brand); font-weight:700; letter-spacing:.14em; font-size:10px;">FIELD REALITY · </span>
          Same-day quote on 95% of requests landed before 14:00 PT.
        </div>
      </aside>

    </div>
  </section>

  <!-- ── SECTION 3: FAQ (--c1 background) ─────────────────────────────── -->
  <section class="alg-section alg-section--dark" style="padding-top:64px; padding-bottom:80px;">
    <div class="faq-grid">
      <div class="faq-sticky">
        <span class="alg-eyebrow alg-eyebrow--red">04 · Field FAQ</span>
        <h2 class="alg-h2" style="margin-top:14px;">
          Asked at the<br>spec desk daily.
        </h2>
        <p class="alg-body" style="margin-top:16px; max-width:360px;">
          Lead times, samples, IES, warranty, the ⒶCS by ALG App — the
          short answers, written by people who pick up the phone.
        </p>
      </div>
      <div class="alg-faq" id="faq-list">

        <div class="alg-faq__item">
          <button class="alg-faq__q" aria-expanded="true" type="button">
            <span class="alg-faq__num">01</span>
            What's the typical lead time on a PRO-tier high bay?
            <span class="alg-faq__toggle">−</span>
          </button>
          <div class="alg-faq__a">
            <p>PRO-tier RHB, LHB, and STR families ship in 5–7 business days from Riverside, CA on quantities under 500. Anything larger or non-stock CCT/optic combinations runs 3–4 weeks. Get a firm date by sending the SKU plus quantity to your territory manager — they confirm against current production.</p>
          </div>
        </div>

        <div class="alg-faq__item">
          <button class="alg-faq__q" aria-expanded="false" type="button">
            <span class="alg-faq__num">02</span>
            Can I order samples before specifying?
            <span class="alg-faq__toggle">+</span>
          </button>
          <div class="alg-faq__a" hidden>
            <p>Yes. Sample requests go through your territory manager or independent agent and are free for active spec projects with a documented job name. We do not sell samples directly to end-users — work through a distributor or the rep listed for your region above.</p>
          </div>
        </div>

        <div class="alg-faq__item">
          <button class="alg-faq__q" aria-expanded="false" type="button">
            <span class="alg-faq__num">03</span>
            How do I file a warranty claim?
            <span class="alg-faq__toggle">+</span>
          </button>
          <div class="alg-faq__a" hidden>
            <!-- C1 delta: ECO 5yr · PRO 7yr · PRO+ 10yr (CFG-WARR-1) -->
            <p>ECO fixtures carry a 5-year warranty, PRO 7-year, and PRO+ 10-year (unless otherwise stated). Email <a href="mailto:warranty@archipelagolighting.com?subject=Warranty%20Claim">warranty@archipelagolighting.com</a> with the original PO, job name, install date, and failed SKU. We ship a replacement within 5 business days of approval — no return required for failures under the warranty terms.</p>
          </div>
        </div>

        <div class="alg-faq__item">
          <button class="alg-faq__q" aria-expanded="false" type="button">
            <span class="alg-faq__num">04</span>
            Do you publish IES files and spec sheets?
            <span class="alg-faq__toggle">+</span>
          </button>
          <div class="alg-faq__a" hidden>
            <p>Every active SKU has a current IES file, photometric report, and 1-page spec sheet on the <a href="/support/library/">Spec Library</a>. PRO+ fixtures additionally publish LM-79 and LM-80 reports. Files are versioned by part number — pull the file matching the SKU on your PO.</p>
          </div>
        </div>

        <div class="alg-faq__item">
          <button class="alg-faq__q" aria-expanded="false" type="button">
            <span class="alg-faq__num">05</span>
            Is the ⒶCS by ALG App required for PRO+ fixtures?
            <span class="alg-faq__toggle">+</span>
          </button>
          <div class="alg-faq__a" hidden>
            <p>No. PRO+ fixtures operate as standard 0–10V dimming out of the box. The ⒶCS by ALG App is optional and unlocks scheduling, occupancy zoning, and group commissioning when fixtures are ordered with the integrated controller. Pair with a single commercial-grade phone/tablet on the job site.</p>
          </div>
        </div>

        <div class="alg-faq__item">
          <button class="alg-faq__q" aria-expanded="false" type="button">
            <span class="alg-faq__num">06</span>
            Where can I find a local distributor?
            <span class="alg-faq__toggle">+</span>
          </button>
          <div class="alg-faq__a" hidden>
            <p>Use the rep finder above. Independent agents listed under your region carry ALG fixtures in stock with regional distribution partners. For bid-tier ECO orders shipping nationwide, contact <a href="mailto:orders@archipelagolighting.com">orders@archipelagolighting.com</a> and we route to the nearest stocking distributor.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

</div><!-- /.alg-page--glow -->

</ContentShell>

<!-- ── PAGE STYLES ──────────────────────────────────────────────────────── -->
<style>
  /* ── Design tokens (verbatim from mockup) ─────────────────────────────── */
  .page-contact {
    --brand:      #F32740;
    --brand-dark: #C8132E;
    --ink:        #1A1D23;
    --ink2:       #3A3E47;
    --ink3:       #6B7280;
    --c1:         #F5F4F1;
    --c2:         #EEEDF0;
    --c3:         #DCDEE2;
    --font-sans:  'Lato', system-ui, sans-serif;
    --font-mono:  'JetBrains Mono', ui-monospace, monospace;
  }

  /* ── Dark canvas root (verbatim from mockup) ──────────────────────────── */
  .alg-page--glow {
    position: relative;
    background: var(--ink);
  }
  .alg-page--glow .glow-clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }
  .alg-page--glow .glow-orb {
    position: absolute;
    top: 0; left: 0;
    width: 60%;
    aspect-ratio: 1 / 1;
    max-width: 860px;
    border-radius: 50%;
    background: radial-gradient(circle,
      hsl(357 80% 56% / 0.62) 0%,
      hsl(357 80% 56% / 0.26) 38%,
      transparent 70%);
    filter: blur(48px);
    pointer-events: none;
    z-index: 0;
    will-change: transform;
    transform: translate(900px, 360px) translate(-50%, -50%);
  }
  /* every section paints above the orb */
  .alg-page--glow > .alg-section,
  .alg-page--glow > .alg-foot {
    position: relative;
    z-index: 1;
  }
  /* light sections stay fully opaque (orb hidden behind them, by design) */
  .alg-page--glow > .alg-section:not(.alg-section--dark):not(.alg-section--c1) {
    background: #fff;
  }
  /* dark zones go translucent so the orb glows through */
  .alg-page--glow > .alg-section--dark {
    background: rgba(20, 22, 27, 0.70);
  }
  @media print {
    .alg-page--glow .glow-orb { display: none !important; }
  }

  /* ── Page shell ────────────────────────────────────────────────────────── */
  .alg-page {
    color: var(--ink);
    font-family: var(--font-sans);
    min-height: 100%;
    display: flex;
    flex-direction: column;
  }

  /* ── Section base ──────────────────────────────────────────────────────── */
  .alg-section {
    padding: 72px var(--pad-x);
    border-bottom: 1px solid var(--c3);
  }
  .alg-section--dark {
    background: var(--ink);
    color: #fff;
    border-bottom-color: rgba(255,255,255,0.08);
  }
  .alg-section--c1 { background: var(--c1); }

  @media print {
    .glow-orb { display: none; }
    .contact-chip { display: none; }
  }
</style>

<!-- ── SCRIPTS ───────────────────────────────────────────────────────────── -->
<script is:inline>
(function () {
  /* ── Glow orb: trail the mouse ─────────────────────────────────────── */
  var orb = document.getElementById('glow-orb');
  if (orb && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.addEventListener('mousemove', function (e) {
      orb.style.left = e.clientX + 'px';
      orb.style.top = (e.clientY + window.scrollY) + 'px';
    }, { passive: true });
  }

  /* ── Route chips: toggle active, update form submit ────────────────── */
  var chips = document.querySelectorAll('.contact-chip');
  var form = document.getElementById('contact-form');
  var activeChip = document.querySelector('.contact-chip.active');

  chips.forEach(function (chip) {
    chip.addEventListener('click', function () {
      chips.forEach(function (c) { c.classList.remove('active'); });
      chip.classList.add('active');
      activeChip = chip;
    });
  });

  /* ── Form submit → mailto ───────────────────────────────────────────── */
  if (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var chip = document.querySelector('.contact-chip.active') || chips[0];
      var to = chip.getAttribute('data-to') || 'sales@archipelagolighting.com';
      var baseSubject = chip.getAttribute('data-subject') || 'Contact';

      var name    = (document.getElementById('cf-name')    || {}).value || '';
      var company = (document.getElementById('cf-company') || {}).value || '';
      var email   = (document.getElementById('cf-email')   || {}).value || '';
      var phone   = (document.getElementById('cf-phone')   || {}).value || '';
      var project = (document.getElementById('cf-project') || {}).value || '';
      var stage   = (document.getElementById('cf-stage')   || {}).value || '';
      var message = (document.getElementById('cf-message') || {}).value || '';

      var subject = baseSubject + (company ? ' · ' + company : '');
      var body = [
        'Name: ' + name,
        'Company: ' + company,
        'Email: ' + email,
        phone   ? 'Phone: ' + phone   : '',
        project ? 'Project: ' + project : '',
        stage   ? 'Stage: ' + stage   : '',
        '',
        message
      ].filter(Boolean).join('\n');

      window.location.href = 'mailto:' + to
        + '?subject=' + encodeURIComponent(subject)
        + '&body='    + encodeURIComponent(body);
    });
  }

  /* ── FAQ accordion ──────────────────────────────────────────────────── */
  var faqList = document.getElementById('faq-list');
  if (faqList) {
    faqList.addEventListener('click', function (e) {
      var btn = e.target.closest('.faq-item__q');
      if (!btn) return;
      var item = btn.closest('.faq-item');
      var answer = item.querySelector('.faq-item__a');
      var icon   = btn.querySelector('.faq-item__icon');
      var isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      answer.hidden = isOpen;
      icon.textContent = isOpen ? '+' : '−';
    });
  }

  /* ── Territory map: click → open find-a-rep ────────────────────────── */
  var mapRegions = document.querySelectorAll('.map-region');
  mapRegions.forEach(function (region) {
    region.addEventListener('click', function () {
      window.location.href = '/find-a-rep/';
    });
    region.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        window.location.href = '/find-a-rep/';
      }
    });
  });
})();
</script>

---
/** Lighting Desk index: Elmer-approved dark editorial layout generated from the Astro blog collection. */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = allPosts.find((post) => post.data.featured) ?? allPosts[0];
const posts = allPosts.filter((post) => post.slug !== featured?.slug);
const formatDate = (date: Date) => date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const filters = ['All', 'Company', 'Rebates & Codes', 'Spec Notes', 'Product News'];
---

<BaseLayout title="The Lighting Desk | Archipelago Lighting Group" description="Rebate and code updates, product news, and spec notes — written by the people who answer the phone." ogImage="https://www.archipelagolighting.com/blog-images/night-industrial-skyline.jpg" bodyClass="page-lighting-desk-index">
  <Fragment slot="head"><meta name="twitter:description" content="Rebate and code updates, product news, and spec notes — written by the people who answer the phone." /></Fragment>
  <section class="desk-index-hero">
    <img src="/blog-images/night-industrial-skyline.jpg" alt="Industrial cityscape at night" class="index-hero-image" />
    <div class="index-hero-overlay"></div>
    <div class="index-hero-content">
      <p>THE LIGHTING DESK · ARCHIPELAGO LIGHTING GROUP</p>
      <h1>What’s new in <span>lighting.</span></h1>
      <div class="index-intro">Rebate and code updates, product news, and spec notes<br />— written by the people who answer the phone.</div>
      <div class="blog-controls" aria-label="Filter articles">
        <div class="filter-pills" role="group" aria-label="Article categories">
          {filters.map((filter, index) => <button class:list={['filter-pill', { active: index === 0 }]} type="button" data-filter={filter}>{filter}</button>)}
        </div>
        <label class="blog-search"><span class="sr-only">Search articles</span><span aria-hidden="true">⌕</span><input type="search" placeholder="Search articles…" /></label>
      </div>
    </div>
  </section>

  <div class="desk-index-body">
    {featured && <section class="featured-wrap" data-category={featured.data.category} data-search={`${featured.data.title} ${featured.data.excerpt} ${featured.data.category}`}>
      <a class="featured-card" href={`/blog/${featured.slug}/`}>
        <img src={featured.data.hero} alt={featured.data.heroAlt} width="1800" height="1016" />
        <div class="featured-copy">
          <p class="card-meta">{featured.data.category} · {formatDate(featured.data.date)}</p>
          <h2>{featured.data.title}</h2>
          <p class="card-excerpt">{featured.data.excerpt}</p>
          <div class="card-rule"></div>
          <div class="card-footer"><span>By {featured.data.author}</span><span>Read more <b>→</b></span></div>
        </div>
      </a>
    </section>}
    <section class="blog-cards" id="blog-cards" aria-live="polite">
      {posts.map((post) => <article class="article-card" data-category={post.data.category} data-search={`${post.data.title} ${post.data.excerpt} ${post.data.category}`}>
        <a href={`/blog/${post.slug}/`}>
          <img src={post.data.hero} alt={post.data.heroAlt} width="1800" height="1016" />
          <div class="article-card-copy"><p class="card-meta">{post.data.category} · {formatDate(post.data.date)}</p><h2>{post.data.title}</h2><p class="card-excerpt">{post.data.excerpt}</p><div class="card-rule"></div><div class="card-footer"><span>By {post.data.author}</span><span>Read more <b>→</b></span></div></div>
        </a>
      </article>)}
      <article class="article-card resource-card" data-category="Rebates & Codes" data-search="2026 lighting rebates resource rebate center">
        <a href="/support/rebate-center/"><div class="resource-art"><span>2026</span><strong>Lighting<br />Rebates</strong></div><div class="article-card-copy"><p class="card-meta">Resource · 2026 Lighting Rebates</p><h2>Lighting Rebate Center</h2><p class="card-excerpt">A direct route to current rebate guidance, program resources, and support.</p><div class="card-rule"></div><div class="card-footer"><span>Resource center</span><span>Open resource <b>→</b></span></div></div></a>
      </article>
    </section>
    <p class="no-results" id="no-results" hidden>No articles match that filter. Try another category or search term.</p>
  </div>
</BaseLayout>

<style is:global>
/* Lighting Desk index: Elmer’s dark home screen, Lato/JetBrains only, 14px minimum. */
.page-lighting-desk-index{background:#111;color:#f7f5f1;font-family:'Lato',system-ui,sans-serif}.page-lighting-desk-index .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.desk-index-hero{position:relative;display:grid;min-height:625px;place-items:center;overflow:hidden;background:#0b0b0c}.index-hero-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.72}.index-hero-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,7,8,.48),rgba(7,7,8,.92));}.index-hero-content{position:relative;z-index:1;width:min(100% - 48px,1030px);padding:110px 0 80px;text-align:center}.index-hero-content>p{margin:0 0 18px;color:#d8d5cf;font:500 14px/1.5 'JetBrains Mono',monospace;letter-spacing:.18em}.index-hero-content h1{margin:0;color:#fff;font:900 clamp(48px,7vw,76px)/1 'Lato',sans-serif;letter-spacing:-.055em}.index-hero-content h1 span{color:#F32740}.index-intro{margin:24px auto 35px;max-width:720px;color:#f0ede8;font-size:18px;line-height:1.55}.blog-controls{display:flex;justify-content:center;align-items:center;gap:14px;flex-wrap:wrap}.filter-pills{display:flex;justify-content:center;gap:8px;flex-wrap:wrap}.filter-pill{cursor:pointer;background:#1d1d1e;border:1px solid #5a5956;color:#eeeae3;border-radius:999px;padding:11px 16px;font:600 14px/1.2 'Lato',sans-serif}.filter-pill.active{background:#F32740;border-color:#F32740;color:#fff}.blog-search{display:flex;align-items:center;gap:8px;background:#171718;border:1px solid #5a5956;border-radius:999px;padding:0 14px;color:#e2ded8}.blog-search span{font-size:20px}.blog-search input{width:178px;border:0;outline:0;background:transparent;color:#fff;font:400 14px/1.2 'Lato',sans-serif;padding:12px 0}.blog-search input::placeholder{color:#c2bdb7}.desk-index-body{background:#111;padding:56px 24px 82px}.featured-wrap,.blog-cards,.no-results{width:min(1200px,100%);margin-inline:auto}.featured-card{display:grid;grid-template-columns:40% 60%;color:inherit;text-decoration:none;background:#1d1d1e;min-height:340px}.featured-card>img{width:100%;height:100%;min-height:340px;object-fit:cover}.featured-copy{display:flex;flex-direction:column;justify-content:center;padding:46px}.card-meta{color:#c7c2ba;font:500 14px/1.5 'JetBrains Mono',monospace;letter-spacing:.11em;text-transform:uppercase;margin:0 0 14px}.featured-copy h2{font:800 clamp(28px,3vw,38px)/1.08 'Lato',sans-serif;letter-spacing:-.035em;margin:0 0 16px}.card-excerpt{color:#d1cdc6;font-size:16px;line-height:1.55;margin:0}.card-rule{height:1px;background:#45433f;margin:24px 0 16px}.card-footer{display:flex;justify-content:space-between;gap:16px;color:#d7d2cb;font:500 14px/1.5 'JetBrains Mono',monospace;letter-spacing:.07em;text-transform:uppercase}.card-footer b{color:#F32740;font-size:18px}.blog-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;margin-top:28px}.article-card{background:#1a1a1b;min-width:0}.article-card a{display:block;color:inherit;text-decoration:none}.article-card img{display:block;width:100%;aspect-ratio:16/10;object-fit:cover}.article-card-copy{padding:24px}.article-card h2{font:800 23px/1.15 'Lato',sans-serif;letter-spacing:-.025em;margin:0 0 13px}.article-card .card-footer{font-size:14px}.resource-art{display:flex;min-height:204px;flex-direction:column;justify-content:end;padding:24px;background:linear-gradient(140deg,#48111a,#F32740);color:#fff}.resource-art span{font:500 14px/1.5 'JetBrains Mono',monospace;letter-spacing:.16em}.resource-art strong{font:900 38px/1.0 'Lato',sans-serif;letter-spacing:-.045em;margin-top:12px}.no-results{font-size:16px;color:#d1cdc6;text-align:center;padding:42px}.desk-index-cta{display:flex;justify-content:space-between;align-items:center;gap:28px;background:#F32740;color:#fff;padding:40px max(24px,calc((100vw - 1200px)/2));}.desk-index-cta p{font-size:19px;line-height:1.5;margin:0}.desk-cta-actions{display:flex;gap:12px;flex-wrap:wrap}.desk-cta-actions a{border:1px solid rgba(255,255,255,.85);color:#fff;text-decoration:none;padding:14px 17px;font:600 14px/1.2 'JetBrains Mono',monospace;letter-spacing:.08em;text-transform:uppercase}.article-card:hover,.featured-card:hover{transform:translateY(-3px);transition:transform .18s ease}.article-card:hover .card-footer span:last-child,.featured-card:hover .card-footer span:last-child{color:#F32740}@media(max-width:900px){.featured-card{grid-template-columns:1fr}.featured-card>img{min-height:250px}.blog-cards{grid-template-columns:repeat(2,minmax(0,1fr))}.desk-index-cta{align-items:flex-start;flex-direction:column}}@media(max-width:600px){.index-hero-content{width:min(100% - 32px,1030px);padding:84px 0 58px}.index-hero-content h1{font-size:46px}.desk-index-body{padding:36px 16px 58px}.featured-copy{padding:28px 22px}.blog-cards{grid-template-columns:1fr}.desk-index-cta{padding:34px 20px}.desk-cta-actions{flex-direction:column;width:100%}.desk-cta-actions a{text-align:center}.blog-search{width:min(100%,315px)}.blog-search input{width:100%}}
</style>

<script is:inline>
  const buttons = [...document.querySelectorAll('.filter-pill')];
  const search = document.querySelector('.blog-search input');
  const cards = [...document.querySelectorAll('[data-category]')];
  const noResults = document.getElementById('no-results');
  let activeFilter = 'All';
  function applyFilter() {
    const term = (search?.value || '').trim().toLowerCase();
    let visible = 0;
    cards.forEach((card) => {
      const categoryMatch = activeFilter === 'All' || card.dataset.category === activeFilter;
      const searchMatch = !term || (card.dataset.search || '').toLowerCase().includes(term);
      const show = categoryMatch && searchMatch;
      card.hidden = !show;
      if (show) visible += 1;
    });
    if (noResults) noResults.hidden = visible !== 0;
  }
  buttons.forEach((button) => button.addEventListener('click', () => { activeFilter = button.dataset.filter || 'All'; buttons.forEach((item) => item.classList.toggle('active', item === button)); applyFilter(); }));
  search?.addEventListener('input', applyFilter);
</script>

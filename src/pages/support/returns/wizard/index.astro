---
// RMA Wizard — /support/returns/wizard/
// Visual source: ALG-RMA-Wizard.html (PUBLIC-facing 6-step form)
// Submit: mailto: to warranty@archipelagolighting.com → redirect to /support/returns/confirmation/
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---
<BaseLayout title="New RMA Request — Archipelago Lighting Group" description="Submit a Return Material Authorization request in 6 steps. Photo-first process — most claims don't require you to ship the unit back.">
<style is:global>
:root{
  --brand:#F32740; --brand-dark:#C8132E;
  --ink:#1A1D23; --ink2:#3A3E47; --ink3:#6B7280;
  --c1:#F5F4F1; --c2:#EEEDF0; --c3:#DCDEE2; --white:#fff;
  --grn:#0FAE7C; --yellow:#FDD85E; --grey:#8A8F97;
  --font-sans:'Lato',system-ui,-apple-system,sans-serif;
  --font-mono:'JetBrains Mono',ui-monospace,'SF Mono',Consolas,monospace;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:var(--white)}
body{font-family:var(--font-sans);color:var(--ink);-webkit-font-smoothing:antialiased}
::selection{background:var(--brand);color:#fff}
a{color:inherit}
.eyebrow{font-family:var(--font-mono);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink3)}
/* ---- wizard context header (slim; global nav owns the real chrome) ---- */
.wz-head{border-bottom:1px solid var(--c3);padding:18px 56px;display:flex;align-items:center;gap:28px}
.wz-head img{width:132px;height:auto;display:block}
.wz-head .div{padding-left:28px;border-left:1px solid var(--c3);margin-left:8px}
.wz-head .ttl{font-size:16px;font-weight:700;color:var(--ink);margin-top:4px;letter-spacing:-.01em}
.wz-head .right{margin-left:auto;display:flex;align-items:center;gap:14px}
.wz-head .exit{background:transparent;border:none;cursor:pointer;font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;color:var(--ink3);text-transform:uppercase;text-decoration:none}
@media(max-width:720px){.wz-head{padding:14px 20px;gap:14px}.wz-head img{width:104px}.wz-head .div{padding-left:14px}}
/* ---- progress bar ---- */
.prog{padding:0 56px;border-bottom:1px solid var(--c3)}
.prog .row{display:grid;grid-template-columns:repeat(6,1fr);gap:0}
.prog .st{background:transparent;border:none;cursor:default;padding:16px 12px;display:flex;gap:10px;align-items:center;border-bottom:3px solid transparent;text-align:left}
.prog .st.done{cursor:pointer}
.prog .st.done:hover{background:var(--c1)}
.prog .st.active{border-bottom-color:var(--brand)}
.prog .num{width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:11px;font-weight:700;background:var(--c2);color:var(--ink3);flex-shrink:0}
.prog .st.done .num{background:var(--grn);color:#fff}
.prog .st.active .num{background:var(--brand);color:#fff}
.prog .sl{font-size:12px;font-weight:600;color:var(--ink3);line-height:1.3}
.prog .st.active .sl{color:var(--ink)}
@media(max-width:900px){.prog{padding:0 20px}.prog .sl{display:none}.prog .st{padding:12px 8px;justify-content:center}}
@media(max-width:560px){.prog .row{grid-template-columns:repeat(6,1fr)}.prog .num{width:20px;height:20px;font-size:10px}}
/* ---- main layout ---- */
.form{display:grid;grid-template-columns:1fr 320px;gap:0;min-height:calc(100vh - 130px)}
@media(max-width:1024px){.form{grid-template-columns:1fr}}
/* ---- steps ---- */
.steps{padding:48px 56px;max-width:760px}
.step{display:none}
.step.active{display:block}
.step h2{font-size:28px;font-weight:800;color:var(--ink);margin:8px 0 6px;letter-spacing:-.02em}
.step .sub{font-size:15px;color:var(--ink2);margin:0 0 28px;line-height:1.6}
.step .eyebrow.se{color:var(--brand);margin-bottom:4px}
@media(max-width:720px){.steps{padding:32px 20px}}
/* ---- cards ---- */
.card{background:var(--c1);border-radius:12px;padding:24px}
.card.lt{background:var(--white);border:1px solid var(--c3);border-radius:12px}
.card.ink{background:var(--ink);border-radius:12px;color:var(--white)}
.card.ink .eyebrow,.card.ink .kmono{color:rgba(255,255,255,.5)}
.kmono{font-family:var(--font-mono);font-size:11px;letter-spacing:.15em;text-transform:uppercase;margin-bottom:12px}
/* ---- form fields ---- */
.fgrid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.fgrid .span2{grid-column:span 2}
@media(max-width:600px){.fgrid{grid-template-columns:1fr}.fgrid .span2{grid-column:span 1}}
.field{display:flex;flex-direction:column;gap:6px}
.lab{font-size:13px;font-weight:600;color:var(--ink2)}
.lab .hint{font-weight:400;color:var(--ink3);margin-left:6px;font-size:12px}
.in{border:1px solid var(--c3);border-radius:8px;padding:10px 14px;font-size:14px;font-family:var(--font-sans);color:var(--ink);background:var(--white);outline:none;transition:border-color .15s}
.in:focus{border-color:var(--brand)}
.in.mono{font-family:var(--font-mono);font-size:13px}
textarea.in{resize:vertical;min-height:96px}
.req{color:var(--brand)}
.emsg{font-size:12px;color:var(--brand);display:none}
.field.err .emsg{display:block}
.field.err .in{border-color:var(--brand)}
/* ---- product lines table ---- */
.card.lt .h{display:grid;grid-template-columns:2fr 2fr 80px 120px 40px;gap:12px;padding:12px 16px;font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink3);border-bottom:1px solid var(--c3)}
.line-row{display:grid;grid-template-columns:2fr 2fr 80px 120px 40px;gap:12px;padding:12px 16px;align-items:center;border-bottom:1px solid var(--c2)}
.line-row:last-child{border-bottom:none}
.del{background:transparent;border:none;cursor:pointer;color:var(--ink3);font-size:18px;padding:4px;border-radius:4px}
.del:hover{color:var(--brand);background:var(--c2)}
.add{padding:12px 16px;border-top:1px solid var(--c2)}
@media(max-width:700px){.card.lt .h{display:none}.line-row{grid-template-columns:1fr 1fr;grid-template-rows:auto auto auto}.line-row .del{grid-column:span 2;justify-self:end}}
/* ---- reason / action option buttons ---- */
.optgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
@media(max-width:600px){.optgrid{grid-template-columns:1fr}}
.opt{background:var(--white);border:1.5px solid var(--c3);border-radius:10px;padding:14px 16px;cursor:pointer;text-align:left;display:flex;gap:12px;align-items:flex-start;transition:border-color .15s,background .15s}
.opt:hover{border-color:var(--brand)}
.opt.on{border-color:var(--brand);background:#FFF5F6}
.ot{display:block;font-size:14px;font-weight:700;color:var(--ink)}
.od{display:block;font-size:12.5px;color:var(--ink3);margin-top:3px;line-height:1.4}
.radio{width:18px;height:18px;border-radius:50%;border:2px solid var(--c3);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;transition:border-color .15s}
.opt.on .radio{border-color:var(--brand)}
.opt.on .radio i{display:block;width:8px;height:8px;border-radius:50%;background:var(--brand)}
.radio i{display:none}
/* ---- evidence upload ---- */
.evgrid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:600px){.evgrid{grid-template-columns:1fr}}
.slot{border:2px dashed var(--c3);border-radius:10px;padding:20px;text-align:center;cursor:pointer;transition:border-color .15s,background .15s;position:relative}
.slot:hover{border-color:var(--brand);background:#FFF5F6}
.slot.filled{border-style:solid;border-color:var(--grn);background:#F0FBF7}
.slot .icon{font-size:28px;margin-bottom:8px}
.slot .sk{font-size:13px;font-weight:700;color:var(--ink)}
.slot .sh{font-size:12px;color:var(--ink3);margin-top:3px}
.slot .fn{font-size:11.5px;color:var(--grn);font-weight:600;margin-top:6px;font-family:var(--font-mono)}
.slot input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}
/* ---- callout ---- */
.callout{background:var(--c1);border-left:3px solid var(--brand);border-radius:0 8px 8px 0;padding:14px 18px;margin-top:20px}
.cl{font-size:13px;font-weight:700;color:var(--ink);margin-bottom:4px}
.cd{font-size:13px;color:var(--ink2);line-height:1.5}
/* ---- safety hazard ---- */
.safety{background:#FFF5F6;border:1.5px solid #FBBCC5;border-radius:10px;padding:16px;margin-top:20px}
.safety label{display:flex;gap:14px;cursor:pointer;align-items:flex-start}
.safety input[type=checkbox]{width:18px;height:18px;accent-color:var(--brand);flex-shrink:0;margin-top:3px}
.safety .k{font-size:14px;font-weight:700;color:var(--ink)}
.safety .q{font-size:13px;color:var(--ink2);margin-top:4px;line-height:1.5}
.safety .d{font-size:12px;color:var(--ink3);margin-top:6px;line-height:1.5}
.safety-alert{background:#FFF5F6;border:1.5px solid var(--brand);border-radius:10px;padding:16px;margin-top:16px;display:none}
.safety-alert.show{display:block}
.safety-alert .sa-t{font-size:14px;font-weight:700;color:var(--brand);margin-bottom:6px}
.safety-alert .sa-b{font-size:13px;color:var(--ink2);line-height:1.5}
/* ---- review step ---- */
.rv-section{margin-bottom:24px}
.rv-label{font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink3);margin-bottom:8px}
.rv-row{display:flex;gap:8px;margin-bottom:6px;font-size:14px}
.rv-k{color:var(--ink3);min-width:120px;flex-shrink:0}
.rv-v{color:var(--ink);font-weight:500}
.rv-lines{background:var(--c1);border-radius:8px;padding:12px 16px}
.rv-line{display:grid;grid-template-columns:2fr 1fr 1fr;gap:12px;font-size:13px;padding:8px 0;border-bottom:1px solid var(--c2)}
.rv-line:last-child{border-bottom:none}
.rv-line .rk{font-family:var(--font-mono);font-size:11px;color:var(--ink3);margin-bottom:2px}
/* ---- signature ---- */
.sig-wrap{margin-top:24px}
.sig-label{font-size:14px;font-weight:600;color:var(--ink);margin-bottom:10px}
.sig-legal{font-size:12.5px;color:var(--ink3);line-height:1.6;margin-bottom:14px}
.sig-legal a{color:var(--brand)}
/* ---- nav buttons ---- */
.nav{display:flex;gap:12px;margin-top:32px;align-items:center}
.btn{display:inline-flex;align-items:center;gap:8px;padding:12px 24px;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;border:none;font-family:var(--font-sans);transition:background .15s,opacity .15s}
.btn.primary{background:var(--brand);color:#fff}
.btn.primary:hover{background:var(--brand-dark)}
.btn.ghost{background:transparent;border:1.5px solid var(--c3);color:var(--ink2)}
.btn.ghost:hover{border-color:var(--ink3)}
.btn.sm{padding:8px 16px;font-size:13px}
.btn:disabled{opacity:.45;cursor:not-allowed}
/* ---- right rail ---- */
.rail{background:var(--c1);border-left:1px solid var(--c3);padding:40px 32px;position:sticky;top:0;height:100vh;overflow-y:auto}
.rail .blk{margin-bottom:32px}
.rail .cls{font-size:14px;color:var(--ink2);line-height:1.6}
.rail .lnk{display:block;font-size:13px;color:var(--brand);text-decoration:none;margin-top:8px;font-weight:600}
.rail .lnk:hover{text-decoration:underline}
.rail .help-box{background:var(--white);border:1px solid var(--c3);border-radius:10px;padding:16px;margin-top:24px}
.rail .help-title{font-size:13px;font-weight:700;color:var(--ink);margin-bottom:8px}
.rail .help-text{font-size:13px;color:var(--ink2);line-height:1.5}
@media(max-width:1024px){.rail{display:none}}
</style>

<!-- wizard context strip (global BaseLayout chrome sits above on the live build) -->
<header class="wz-head">
  <img src="/brand/alg-logo-color.svg" alt="Archipelago Lighting Group">
  <div class="div">
    <div class="eyebrow">Returns &amp; Exchanges</div>
    <div class="ttl">New RMA Request</div>
  </div>
  <div class="right">
    <div class="eyebrow" id="stepCounter">Step 01 of 06</div>
    <a class="exit" href="/support/returns/">&#10005; Save &amp; exit</a>
  </div>
</header>

<!-- progress bar -->
<nav class="prog" aria-label="Wizard progress">
  <div class="row" id="prog">
    <button class="st active" data-i="1"><span class="num">01</span><span class="sl">Buyer info</span></button>
    <button class="st" data-i="2"><span class="num">02</span><span class="sl">Products</span></button>
    <button class="st" data-i="3"><span class="num">03</span><span class="sl">Failure</span></button>
    <button class="st" data-i="4"><span class="num">04</span><span class="sl">Evidence</span></button>
    <button class="st" data-i="5"><span class="num">05</span><span class="sl">Resolution</span></button>
    <button class="st" data-i="6"><span class="num">06</span><span class="sl">Review</span></button>
  </div>
</nav>

<main class="form">
  <div class="steps">
    <!-- STEP 1 — BUYER INFO -->
    <section class="step active" data-step="1">
      <div class="eyebrow se">Step 01</div>
      <h2>Who's filing this claim?</h2>
      <p class="sub">Use the company that purchased the product, not the installer. We'll match this to your ALG account.</p>
      <div class="card" style="padding:28px">
        <div class="fgrid">
          <label class="field" data-k="company"><span class="lab">Company name <span class="req">*</span></span><input class="in" name="company" placeholder="Pacific Electric Supply Co."></label>
          <label class="field" data-k="contact"><span class="lab">Contact name <span class="req">*</span></span><input class="in" name="contact" placeholder="Maria Delgado"></label>
          <label class="field" data-k="email"><span class="lab">Email <span class="req">*</span></span><input class="in" name="email" type="email" placeholder="m.delgado@pacificelectric.com"><span class="emsg">Enter a valid email</span></label>
          <label class="field" data-k="phone"><span class="lab">Phone <span class="req">*</span></span><input class="in" name="phone" type="tel" placeholder="(909) 555-0182"><span class="emsg">Enter a phone number</span></label>
          <label class="field span2" data-k="address"><span class="lab">Address</span><input class="in" name="address" placeholder="1840 W Mission Blvd"></label>
          <label class="field" data-k="cityStateZip"><span class="lab">City, State, ZIP</span><input class="in" name="cityStateZip" placeholder="Pomona, CA 91766"></label>
          <label class="field" data-k="accountNumber"><span class="lab mono">ALG account #<span class="hint">optional</span></span><input class="in mono" name="accountNumber" placeholder="ALG-04412"></label>
          <label class="field span2" data-k="salesRep"><span class="lab">Sales rep / distributor<span class="hint">if known</span></span><input class="in" name="salesRep" placeholder="J. Park — Pacific Region"></label>
        </div>
      </div>
      <div class="card ink" style="padding:28px;margin-top:18px">
        <div class="kmono">Proof of purchase</div>
        <div style="font-size:14px;font-weight:600;color:var(--white);margin-bottom:16px">Enter the ALG PO# or Invoice# from your order <span style="color:var(--brand)">*</span></div>
        <div class="fgrid">
          <label class="field" data-k="poRef"><span class="lab mono" style="color:rgba(255,255,255,.6)">ALG PO#<span class="hint">PO-&hellip;</span></span><input class="in mono" name="poRef" placeholder="PO-48201"></label>
          <label class="field" data-k="invoiceRef"><span class="lab mono" style="color:rgba(255,255,255,.6)">ALG Invoice#<span class="hint">INV-&hellip;</span></span><input class="in mono" name="invoiceRef" placeholder="INV-2025-11-09214"></label>
        </div>
        <div style="margin-top:12px;font-size:12.5px;color:rgba(255,255,255,.5);line-height:1.5">Either one works — it's how we verify the order and match it to your account. Find it on your ALG order confirmation or invoice.</div>
        <div class="emsg" id="popMsg" style="display:none;font-family:var(--font-mono);font-size:11px;color:var(--brand);margin-top:8px">Enter a PO# or Invoice#</div>
      </div>
      <div class="nav">
        <button class="btn primary" type="button" onclick="W.next()">Continue to products &rarr;</button>
      </div>
    </section>

    <!-- STEP 2 — PRODUCTS -->
    <section class="step" data-step="2">
      <div class="eyebrow se">Step 02</div>
      <h2>Which products are affected?</h2>
      <p class="sub">Add a row per SKU. Date code is printed on the fixture label — we need it to identify the production lot.</p>
      <div class="card lt">
        <div class="h"><div>ALG SKU</div><div>Description</div><div>QTY</div><div>Date code</div><div></div></div>
        <div id="lines"></div>
        <div class="add"><button class="btn ghost sm" type="button" onclick="W.addRow()">+ Add another SKU</button></div>
      </div>
      <div class="callout"><div class="cl">Why we ask for date codes</div><div class="cd">The date code identifies the production lot. When several units share the same SKU and lot, it helps us spot and resolve a lot-level issue quickly.</div></div>
      <div class="nav">
        <button class="btn ghost" type="button" onclick="W.prev()">&larr; Back</button>
        <button class="btn primary" type="button" onclick="W.next()">Continue to failure &rarr;</button>
      </div>
    </section>

    <!-- STEP 3 — FAILURE -->
    <section class="step" data-step="3">
      <div class="eyebrow se">Step 03</div>
      <h2>Describe what went wrong</h2>
      <p class="sub">The more specific, the faster we can route it to the right engineer.</p>
      <div class="card" style="padding:28px">
        <div class="field" data-k="reasons">
          <span class="lab">Primary reason <span class="req">*</span><span class="hint">select all that apply</span></span>
          <div class="optgrid" id="reasons"></div>
          <span class="emsg">Select at least one</span>
        </div>
        <div class="field" data-k="description" style="margin-top:22px">
          <span class="lab">Detailed description <span class="req">*</span><span class="hint">min. 12 characters</span></span>
          <textarea class="in" name="description" rows="5" placeholder="At 11 months post-install, 8 of 32 fixtures in Aisle 4 began flickering at 50% dim. Same lot 2509-B. Replaced driver on one unit — failure recurred within 6 hours. No environmental change."></textarea>
          <span class="emsg">Please describe the failure (min 12 characters)</span>
        </div>
        <div class="fgrid" style="margin-top:22px">
          <label class="field" data-k="installDate"><span class="lab">Install date <span class="req">*</span></span><input class="in" name="installDate" type="date"><span class="emsg">Required</span></label>
          <label class="field" data-k="siteAddress"><span class="lab">Site address<span class="hint">if different from buyer</span></span><input class="in" name="siteAddress" placeholder="Same as buyer address"></label>
        </div>
        <div class="safety" id="safetyBox">
          <label>
            <input type="checkbox" id="safetyFlag" onchange="W.recalc();W.safetyUI()">
            <div>
              <div class="k">Safety hazard flag</div>
              <div class="q">Does this involve fire, smoke, melting, sparks, or anything falling from a fixture?</div>
              <div class="d">Checking this flags your claim for priority handling, and we may contact you quickly.</div>
            </div>
          </label>
        </div>
        <div class="safety-alert" id="safetyAlert">
          <div class="sa-t">&#9888; Safety concern flagged</div>
          <div class="sa-b">If there is an immediate hazard, stop using the fixtures and call us at <strong>(866) 912-3220</strong>. We'll prioritize your claim and may reach out before you finish this form.</div>
        </div>
      </div>
      <div class="nav">
        <button class="btn ghost" type="button" onclick="W.prev()">&larr; Back</button>
        <button class="btn primary" type="button" onclick="W.next()">Continue to evidence &rarr;</button>
      </div>
    </section>

    <!-- STEP 4 — EVIDENCE -->
    <section class="step" data-step="4">
      <div class="eyebrow se">Step 04</div>
      <h2>Upload photos</h2>
      <p class="sub">Clear photos speed up approval. The product label shot (SKU + date code) is the one most people forget.</p>
      <div class="evgrid" id="evidence"></div>
      <div class="callout" style="margin-top:20px"><div class="cl">Mobile tip</div><div class="cd">Take photos with your phone, then upload here. JPG or PNG, max 10 MB each.</div></div>
      <div class="nav">
        <button class="btn ghost" type="button" onclick="W.prev()">&larr; Back</button>
        <button class="btn primary" type="button" onclick="W.next()">Continue to resolution &rarr;</button>
      </div>
    </section>

    <!-- STEP 5 — RESOLUTION -->
    <section class="step" data-step="5">
      <div class="eyebrow se">Step 05</div>
      <h2>What outcome do you need?</h2>
      <p class="sub">Select one. Replacement is the most common outcome for warranty claims.</p>
      <div class="field" data-k="action">
        <div class="optgrid" id="actions"></div>
        <span class="emsg" style="margin-top:8px;display:none">Select a resolution type</span>
      </div>
      <div class="card" style="padding:20px;margin-top:20px">
        <label class="field" data-k="laborShield">
          <span class="lab">LaborShield&#8482; reimbursement<span class="hint">if registered</span></span>
          <input class="in" name="laborShield" placeholder="Include electrician invoice — attach to email after submitting">
        </label>
      </div>
      <div class="nav">
        <button class="btn ghost" type="button" onclick="W.prev()">&larr; Back</button>
        <button class="btn primary" type="button" onclick="W.next()">Review &amp; submit &rarr;</button>
      </div>
    </section>

    <!-- STEP 6 — REVIEW -->
    <section class="step" data-step="6">
      <div class="eyebrow se">Step 06</div>
      <h2>Review &amp; submit</h2>
      <p class="sub">Check everything below. Once you click Submit, your email client will open with a pre-filled message to our warranty team.</p>
      <div id="review"></div>
      <div class="sig-wrap">
        <div class="sig-label">Your signature <span class="req">*</span></div>
        <div class="sig-legal">By typing your name below, you confirm this claim is accurate and falls within the <a href="/documents/ALG-Limited-Product-Warranty.pdf" target="_blank" rel="noopener">ALG Limited Product Warranty</a>. LaborShield&#8482; terms apply where registered. Submitting opens your email client with a pre-filled message to our warranty team.</div>
        <label class="field" data-k="signature">
          <input class="in" name="signature" placeholder="Full name">
          <span class="emsg">Signature required</span>
        </label>
      </div>
      <div class="nav">
        <button class="btn ghost" type="button" onclick="W.prev()">&larr; Back</button>
        <button class="btn primary" type="button" onclick="W.next()">Submit claim &rarr;</button>
      </div>
    </section>
  </div>

  <!-- right rail -->
  <aside class="rail">
    <div class="blk">
      <div class="eyebrow" style="margin-bottom:12px">What to expect</div>
      <div class="cls">We aim to acknowledge every claim within about 2 business days; larger or safety-related issues are prioritized. You'll get a confirmation with your RMA number — save it to check status.</div>
    </div>
    <div class="blk">
      <div class="eyebrow" style="margin-bottom:12px">Need help?</div>
      <div class="cls">Call <strong>(866) 912-3220</strong> or email <strong>warranty@archipelagolighting.com</strong>. Mon–Fri 6 AM–5 PM PT.</div>
      <a class="lnk" href="/documents/ALG-Limited-Product-Warranty.pdf" target="_blank" rel="noopener">Limited Product Warranty &rarr;</a>
      <a class="lnk" href="/documents/ALG-Sales-Terms-and-Conditions.pdf" target="_blank" rel="noopener">Sales Terms &amp; Conditions &rarr;</a>
    </div>
    <div class="help-box">
      <div class="help-title" id="stepHelpTitle">Step tip</div>
      <div class="help-text" id="stepHelp"></div>
    </div>
  </aside>
</main>

<script is:inline>
window.W=(function(){
  const TOTAL=6; let step=1;
  // ---- ships EMPTY — all fields start blank (placeholders only), NO demo prefills ----
  const REASONS=[
    {id:"defective",label:"Defective / not working",desc:"Failure during normal operation (driver, LED, flicker, no-start, buzz)"},
    {id:"wrong",label:"Wrong item received",desc:"SKU shipped does not match the SKU ordered"},
    {id:"damaged",label:"Damaged in transit",desc:"Visible damage on receipt, before installation"},
    {id:"other",label:"Other",desc:"Describe below — we'll route appropriately"}
  ];
  const ACTIONS=[
    {id:"replacement",label:"Replacement",desc:"Same SKU shipped to original or alternate address. Most common."},
    {id:"credit",label:"Account credit",desc:"Credit memo applied to your ALG account. Expires 1 year from issuance."},
    {id:"refund",label:"Refund",desc:"Original payment method. Subject to ALG approval — see Sales T&C."}
  ];
  const SLOTS=[
    {id:"full",label:"Full product view",hint:"Whole fixture showing failure point",req:true},
    {id:"closeup",label:"Close-up of failure",hint:"Burn, crack, melted area, etc.",req:true},
    {id:"label",label:"Product label",hint:"SKU + date code must be legible",req:true},
    {id:"install",label:"Installation context",hint:"Wider shot of mounting/wiring",req:false}
  ];
  const HELP=[
    "Use the company that purchased the product, not the installer. Enter your ALG PO# or Invoice# as proof of purchase — it's how we verify the order.",
    "Date code is printed on the small sticker on the fixture housing. Format: YYMM-letter (e.g. 2509-B).",
    "Describe what the failure looks like and when it started. Specifics like \"flickering at 50% dim\" route to the right engineer faster than \"not working.\"",
    "Mobile users: take photos with your phone, then upload here. The label shot is the one most people forget.",
    "Replacement is the most common outcome. Credit and refund options are subject to your warranty terms.",
    "Once submitted, we send a copy to your email. Save the RMA # — it's how you'll check status."
  ];
  const ROUTE={ISOLATED:"Customer Service",BATCH:"Product Management + Quality",SYSTEMIC:"Operations"};
  let reasons=new Set();
  let action="";
  let evidence={};
  let lines=[{sku:"",description:"",qty:1,dateCode:""}];
  let turnOk=false;
  const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
  const v=n=>{const e=document.querySelector('[name='+n+']');return e?e.value.trim():''};
  // ---- severity classifier (SOP §4) ----
  // INTERNAL routing only — drives the emailed warranty-team payload. NOT shown to the buyer (legal review H1/H2).
  const RANK={ISOLATED:0,BATCH:1,SYSTEMIC:2};
  const up=(cur,to)=>RANK[to]>RANK[cur]?to:cur;
  function claimHistory(){try{return JSON.parse(localStorage.getItem('alg_rma_history')||'[]');}catch(e){return[];}}
  function classify(){
    const reasonsOut=[]; let sev="ISOLATED";
    const totalQty=lines.reduce((a,l)=>a+(parseInt(l.qty,10)||0),0);
    const uniqSkus=new Set(lines.map(l=>l.sku).filter(Boolean).map(s=>s.toUpperCase()));
    const uniqDates=new Set(lines.map(l=>l.dateCode).filter(Boolean).map(s=>s.toUpperCase()));
    const site=v('siteAddress');
    const lifeSafety=lines.some(l=>/CONST|CRC/i.test(l.sku||''));
    if(uniqSkus.size===1&&uniqDates.size===1&&totalQty>=5){sev=up(sev,"BATCH");reasonsOut.push(totalQty+" units · same SKU + date-code lot");}
    if(site&&totalQty>=5){sev=up(sev,"BATCH");reasonsOut.push(totalQty+" units at one site");}
    if(lifeSafety){sev=up(sev,"BATCH");reasonsOut.push("Life-safety SKU (constARCH EM / CRC) — egress-path implications");}
    if(uniqSkus.size>=2&&totalQty>=5){sev=up(sev,"SYSTEMIC");reasonsOut.push("Multiple SKUs affected — possible systemic issue");}
    const safetyKw=['fire','smoke','melt','spark','fall','fell','drop','arc','burn','char'];
    const desc=(v('description')||'').toLowerCase();
    const hit=safetyKw.find(k=>desc.includes(k));
    if($('#safetyFlag').checked||hit){sev=up(sev,"SYSTEMIC");reasonsOut.push($('#safetyFlag').checked?"Safety hazard reported by buyer":'Safety keyword: "'+hit+'"');}
    const H=claimHistory();
    const repeatLot=H.some(h=>h.keys&&lines.some(l=>h.keys.includes(l.sku+'|'+l.dateCode))&&h.buyer===v('company'));
    const repeatOtherParty=H.some(h=>h.keys&&lines.some(l=>h.keys.includes(l.sku+'|'+l.dateCode))&&h.buyer!==v('company'));
    if(repeatLot){sev=up(sev,"BATCH");reasonsOut.push("Repeat claim on same SKU + lot — auto-escalated");}
    if(repeatOtherParty){sev=up(sev,"SYSTEMIC");reasonsOut.push("Same SKU + lot reported by multiple buyers/sites");}
    const keys=lines.map(l=>l.sku+'|'+l.dateCode).filter(k=>k!=='|');
    return{sev,reasons:reasonsOut,keys,buyer:v('company'),site};
  }
  function recalc(){ /* classifier is internal-only now (legal: severity not shown to the buyer). Retained for the emailed routing payload. */ }
  function safetyUI(){
    const on=$('#safetyFlag')&&$('#safetyFlag').checked;
    const el=$('#safetyAlert');
    if(el){on?el.classList.add('show'):el.classList.remove('show');}
  }
  function renderLines(){
    $('#lines').innerHTML=lines.map((l,i)=>'<div class="line-row"><input class="in mono" placeholder="LBLP24-33MXP2" value="'+esc(l.sku)+'" oninput="W.updLine('+i+',\'sku\',this.value)"><input class="in" placeholder="Slim Bay, 33W" value="'+esc(l.description)+'" oninput="W.updLine('+i+',\'description\',this.value)"><input class="in" type="number" min="1" value="'+l.qty+'" oninput="W.updLine('+i+',\'qty\',this.value)"><input class="in mono" placeholder="2509-B" value="'+esc(l.dateCode)+'" oninput="W.updLine('+i+',\'dateCode\',this.value)"><button class="del" type="button" onclick="W.delRow('+i+')" title="Remove">&times;</button></div>').join('');
  }
  function renderReasons(){
    $('#reasons').innerHTML=REASONS.map(r=>'<button type="button" class="opt'+(reasons.has(r.id)?' on':'')+'" data-id="'+r.id+'"><span class="radio"><i></i></span><span><span class="ot">'+r.label+'</span><span class="od">'+r.desc+'</span></span></button>').join('');
    $$('#reasons .opt').forEach(b=>b.addEventListener('click',()=>{const id=b.dataset.id;reasons.has(id)?reasons.delete(id):reasons.add(id);renderReasons();}));
  }
  function renderActions(){
    $('#actions').innerHTML=ACTIONS.map(a=>'<button type="button" class="opt act'+(action===a.id?' on':'')+'" data-id="'+a.id+'"><span class="radio"><i></i></span><span><span class="ot">'+a.label+'</span><span class="od">'+a.desc+'</span></span></button>').join('');
    $$('#actions .act').forEach(b=>b.addEventListener('click',()=>{action=b.dataset.id;$$('#actions .act').forEach(x=>x.classList.remove('on'));b.classList.add('on');}));
  }
  function renderEvidence(){
    $('#evidence').innerHTML=SLOTS.map(s=>'<div class="slot'+(evidence[s.id]?' filled':'')+'" id="slot-'+s.id+'"><div class="icon">'+(evidence[s.id]?'&#10003;':'&#128247;')+'</div><div class="sk">'+s.label+(s.req?' <span style="color:var(--brand)">*</span>':'')+'</div><div class="sh">'+s.hint+'</div>'+(evidence[s.id]?'<div class="fn">'+esc(evidence[s.id].name)+'</div>':'')+'<input type="file" accept="image/*,.pdf" onchange="W.clearSlot(\''+s.id+'\',this)"></div>').join('');
  }
  function renderReview(){
    const totalQty=lines.reduce((a,l)=>a+(parseInt(l.qty,10)||0),0);
    const actLabel=(ACTIONS.find(a=>a.id===action)||{}).label||'—';
    $('#review').innerHTML='<div class="rv-section"><div class="rv-label">Buyer</div><div class="rv-row"><span class="rv-k">Company</span><span class="rv-v">'+esc(v('company'))+'</span></div><div class="rv-row"><span class="rv-k">Contact</span><span class="rv-v">'+esc(v('contact'))+'</span></div><div class="rv-row"><span class="rv-k">Email</span><span class="rv-v">'+esc(v('email'))+'</span></div><div class="rv-row"><span class="rv-k">Phone</span><span class="rv-v">'+esc(v('phone'))+'</span></div><div class="rv-row"><span class="rv-k">PO / Invoice</span><span class="rv-v">'+(esc(v('poRef'))||esc(v('invoiceRef'))||'—')+'</span></div></div><div class="rv-section"><div class="rv-label">Products ('+totalQty+' units)</div><div class="rv-lines">'+lines.map(l=>'<div class="rv-line"><div><div class="rk">SKU</div>'+esc(l.sku||'—')+'</div><div><div class="rk">QTY</div>'+l.qty+'</div><div><div class="rk">Lot</div>'+esc(l.dateCode||'—')+'</div></div>').join('')+'</div></div><div class="rv-section"><div class="rv-label">Failure</div><div class="rv-row"><span class="rv-k">Reasons</span><span class="rv-v">'+([...reasons].join(', ')||'—')+'</span></div><div class="rv-row"><span class="rv-k">Install date</span><span class="rv-v">'+esc(v('installDate'))+'</span></div><div class="rv-row"><span class="rv-k">Description</span><span class="rv-v" style="white-space:pre-wrap">'+esc(v('description'))+'</span></div></div><div class="rv-section"><div class="rv-label">Resolution</div><div class="rv-row"><span class="rv-k">Outcome</span><span class="rv-v">'+actLabel+'</span></div><div class="rv-row"><span class="rv-k">Evidence</span><span class="rv-v">'+Object.keys(evidence).length+' photo(s)</span></div></div>';
  }
  function validate(s){
    let ok=true;
    if(s===1){
      ['company','contact','email','phone'].forEach(k=>{const f=document.querySelector('[data-k='+k+']');if(f){const bad=!v(k);f.classList.toggle('err',bad);if(bad)ok=false;}});
      const hasPop=v('poRef')||v('invoiceRef');
      const pm=$('#popMsg');if(pm){pm.style.display=hasPop?'none':'block';}
      if(!hasPop)ok=false;
    }
    if(s===2){
      const bad=lines.every(l=>!l.sku);
      if(bad){ok=false;alert('Add at least one SKU.');}
    }
    if(s===3){
      const rf=document.querySelector('[data-k=reasons]');
      const bad=reasons.size===0;if(rf){rf.classList.toggle('err',bad);if(bad)ok=false;}
      const df=document.querySelector('[data-k=description]');
      const dbad=(v('description')||'').length<12;if(df){df.classList.toggle('err',dbad);if(dbad)ok=false;}
      const idf=document.querySelector('[data-k=installDate]');
      const ibad=!v('installDate');if(idf){idf.classList.toggle('err',ibad);if(ibad)ok=false;}
    }
    if(s===4){
      const reqSlots=SLOTS.filter(sl=>sl.req);
      const missing=reqSlots.filter(sl=>!evidence[sl.id]);
      if(missing.length){ok=false;alert('Please upload: '+missing.map(sl=>sl.label).join(', '));}
    }
    if(s===5){
      const af=document.querySelector('[data-k=action]');
      const bad=!action;if(af){const em=af.querySelector('.emsg');if(em)em.style.display=bad?'block':'none';if(bad)ok=false;}
    }
    if(s===6){
      const sf=document.querySelector('[data-k=signature]');
      const bad=!v('signature');if(sf){sf.classList.toggle('err',bad);if(bad)ok=false;}
    }
    return ok;
  }
  function show(n){
    step=n;
    $$('.step').forEach(s=>s.classList.toggle('active',+s.dataset.step===n));
    $$('#prog .st').forEach((s,i)=>{s.classList.toggle('active',i+1===n);s.classList.toggle('done',i+1<n);});
    const counter=$('#stepCounter');if(counter)counter.textContent='Step '+String(n).padStart(2,'0')+' of '+String(TOTAL).padStart(2,'0');
    const help=$('#stepHelp');if(help)help.textContent=HELP[n-1]||'';
    if(n===2)renderLines();
    if(n===3)renderReasons();
    if(n===4)renderEvidence();
    if(n===5)renderActions();
    if(n===6)renderReview();
    window.scrollTo({top:0,behavior:'smooth'});
  }
  function jump(n){if(n<step)show(n);}
  function next(){if(!validate(step)){return;}if(step===TOTAL){submit();return;}show(step+1);}
  function prev(){if(step>1)show(step-1);}
  // ---- submit — email warranty desk + route to confirmation ----
  const NOTIFY={ISOLATED:"—",BATCH:"Operations within 24h",SYSTEMIC:"Operations + Legal (immediate)"};
  function submit(){
    const c=classify();
    const rma='RMA-26-0'+(1184+Math.floor(Math.random()*99));
    const totalQty=lines.reduce((a,l)=>a+(parseInt(l.qty,10)||0),0);
    const productLabel=(lines[0].sku||'—')+' · qty '+totalQty+(lines.length>1?' (+'+(lines.length-1)+' more)':'');
    const actLabel=(ACTIONS.find(a=>a.id===action)||{}).label||'Replacement';
    const now=new Date(),pad=n=>String(n).padStart(2,'0');
    const receivedISO=now.getFullYear()+'-'+pad(now.getMonth()+1)+'-'+pad(now.getDate())+'T'+pad(now.getHours())+':'+pad(now.getMinutes())+':00';
    const body=['NEW RMA REQUEST — '+rma,'severity (auto): '+c.sev+'  ·  route: '+ROUTE[c.sev],'',
      'BUYER','company: '+v('company'),'contact: '+v('contact'),'email: '+v('email'),'phone: '+v('phone'),
      'account: '+(v('accountNumber')||'—')+'   rep: '+(v('salesRep')||'—'),'po/inv: '+(v('poRef')||v('invoiceRef')||'—'),'',
      'PRODUCTS',lines.map(l=>'· '+l.sku+' | qty '+l.qty+' | lot '+l.dateCode).join('\n'),'',
      'FAILURE','reasons: '+[...reasons].join(', '),'install: '+v('installDate')+'   site: '+(v('siteAddress')||'—'),
      'description: '+v('description'),'safety_flag: '+($('#safetyFlag').checked?'YES':'no'),'',
      'ACTION REQUESTED: '+actLabel,'laborShield: '+(v('laborShield')||'—'),
      'evidence: '+Object.keys(evidence).length+' files (attach to this email)','signed: '+v('signature')].join('\n');
    const mailto='mailto:warranty@archipelagolighting.com?subject='+encodeURIComponent('['+c.sev+'] RMA '+rma+' — '+(v('company')||''))+'&body='+encodeURIComponent(body);
    // Confirmation payload = customer-facing receipt only.
    // Internal verdict (severity/route/notify) stays in the emailed warranty-team copy — never handed to the client page.
    const payload={rma:rma,
      email:v('email'),contact:v('contact'),phone:v('phone'),company:v('company'),account:v('accountNumber')||'—',
      poRef:v('poRef')||v('invoiceRef')||'—',productLabel:productLabel,action:action,actionLabel:actLabel,
      lines:lines.map(l=>({sku:l.sku||'—',qty:l.qty||0,dateCode:l.dateCode||'—'})),
      evidenceCount:Object.keys(evidence).length,receivedISO:receivedISO};
    try{sessionStorage.setItem('alg_rma',JSON.stringify(payload));}catch(e){}
    try{var H=claimHistory();H.push({keys:c.keys,buyer:c.buyer,site:c.site,rma:rma,ts:Date.now()});localStorage.setItem('alg_rma_history',JSON.stringify(H.slice(-50)));}catch(e){}
    window.location.href=mailto;
    setTimeout(()=>{window.location.href='/support/returns/confirmation/?rma='+rma;},400);
  }
  function esc(s){return String(s==null?'':s).replace(/"/g,'&quot;').replace(/</g,'&lt;');}
  function updLine(i,k,val){lines[i][k]=val;}
  function addRow(){lines.push({sku:'',description:'',qty:1,dateCode:''});renderLines();}
  function delRow(i){if(lines.length>1){lines.splice(i,1);renderLines();}}
  function clearSlot(id,input){if(input.files&&input.files[0]){evidence[id]={name:input.files[0].name};}else{delete evidence[id];}renderEvidence();}
  function verifyTurn(){turnOk=true;}
  function init(){
    renderLines();renderReasons();renderActions();renderEvidence();
    $$('input[name],textarea[name]').forEach(e=>e.addEventListener('input',recalc));
    $$('#prog .st').forEach(s=>s.addEventListener('click',()=>jump(+s.dataset.i)));
    safetyUI();recalc();$('#stepHelp').textContent=HELP[0];
  }
  return {next,prev,jump,addRow,delRow,clearSlot,recalc,safetyUI,verifyTurn,updLine,init};
})();
document.addEventListener('DOMContentLoaded',window.W.init);
</script>
</BaseLayout>

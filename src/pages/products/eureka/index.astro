  var copy = {
    bilevel: "Standalone microwave occupancy sensor with built-in step-dim control — MSM-HTI/001/BLS (Hi-bay Ti-type · 39FT detection at high-bay mount · IP66 to match the Eureka housing). No gateway, no controller, no commissioning app. Wires to the integrated sensor port at install; occupancy + bi-level step-dim out of the box. The ASHRAE 90.1 + Title 24 zero-commissioning compliance path for projects that don't need networked control.",
    sigmesh:  "SIG-qualified Bluetooth Mesh — self-healing topology, no gateway required, full control via the Silvair commissioning app. Networked occupancy + daylight harvesting + scene + energy reporting. Pair with MSM-HTI/001/BLS microwave sensor (Hi-bay Ti-type · 39FT detection at high-bay mount · IP66 to match the Eureka housing). The ASHRAE 90.1 + Title 24 networked-controls compliance path on a wash-down vapor tight — a category where most competitors ship 0-10V dim only or hardwired-only fixtures."
  };
  var linkText = {
    bilevel: 'Discover contrⒶLS Bi-Level →',
    sigmesh: 'Discover blueⒶRCH & Silvair →'
  };
  var linkHref = {
    bilevel: '/collections/controls',
    sigmesh: '/products/silvair/'
  };
  function init() {
    var tabs = document.querySelectorAll('.tac-callout-tab');
    var sensors = document.querySelectorAll('.tac-sensor-svg');
    var copyEl = document.getElementById('tacCalloutCopy');
    var linkEl = document.getElementById('tacCalloutLink');
    var linkTextEl = document.getElementById('tacCalloutLinkText');
    var wave = document.getElementById('tacShockwave');
    if (!tabs.length || !sensors.length || !wave) return;
    function select(platform) {
      tabs.forEach(function(t) {
        var isActive = t.dataset.platform === platform;
        t.classList.toggle('active', isActive);
        t.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
      sensors.forEach(function(s) {
        s.classList.toggle('is-active', s.dataset.platform === platform);
      });
      if (copyEl && copy[platform]) copyEl.textContent = copy[platform];
      if (linkEl && linkHref[platform]) linkEl.setAttribute('href', linkHref[platform]);
      if (linkTextEl && linkText[platform]) {
        // Render the link text with the Ⓐ glyph wrapped in .aa for proper kerning
        linkTextEl.innerHTML = linkText[platform]
          .replace('contrⒶLS', 'contr<span class="aa">Ⓐ</span>LS')
          .replace('blueⒶRCH', 'blue<span class="aa">Ⓐ</span>RCH');
      }
      // Trigger shockwave: remove + re-add class to restart animation
      wave.classList.remove('is-rippling');
      void wave.offsetWidth;
      wave.classList.add('is-rippling');
    }
    tabs.forEach(function(t) {
      t.addEventListener('click', function() { select(t.dataset.platform); });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();

// (Legacy Illuminator photometrics IIFE removed — Eureka's 3-length × 4-optic
//  photometrics driver lives inline with Section 6 above. 12 plot states (LV3P2/4/8 ×
//  RL/FL/WL/FR), per-optic parametric polar plots, IES bundle URL wired live to
//  WorkDrive c4cc7fe6... in the per-config download link.)

// (Legacy Illuminator acc-section modal IIFE removed — Eureka accessories
//  use the lighter inline filter-pill driver above. Modal/click-detail is a v2 follow-up.)


// =============================================================================
// SECTION 9 — Configurator (Build Your Eureka)
// SKU syntax (per James 2026-05-26 · datasheet pg 3 ordering guide):
//   LV3P{LEN}{wattFragment}{/EM}{/SENSOR}{/BRACKET}
//   wattFragment encoded per Performance chip via data-sku attribute, e.g.:
//     E20  → "-3E20-S3{dlc}"     (Eureka-II 2FT · DLC tier suffix)
//     E40  → "-3E40-S3{dlc}"     (Eureka-II 4FT std)
//     E46  → "-3E46-3SP"          (Eureka-II 4FT alt · fixed suffix)
//     E80  → "-3E80-S3{dlc}"     (Eureka-II 8FT)
//     E135 → "-3E135-S3{dlc}"    (Eureka-II HB)
//     E250 → "-3E250-S3{dlc}"    (Eureka-II HB flagship)
//     GTU  → "-3GTU-S3S"          (Eureka-I 4FT std · Standard only)
//     HBP  → "-3HBP-3CS/CL"       (Eureka-I HB Premium + Clear Lens)
//     HBU  → "-3HBU-3CS/CL"       (Eureka-I HB Universal + Clear Lens)
// Required (4): length · watt (Performance) · cct (locked S3) · dlc (S or P)
// Optional (3): em · sensor · bracket — click to toggle on, click again to clear
// =============================================================================
(function() {
  var REQUIRED  = ['length', 'watt', 'cct', 'dlc'];
  var OPTIONAL  = ['em', 'sensor', 'bracket'];

  // Length code mapping · HB chassis maps to "4" since it's the 4FT high-bay variant.
  function lengthCode(val) {
    return (val === 'HB') ? '4' : (val || '');
  }

  // IES-derived spec lookup per length (5000K · max WATTSELECT) — see /eureka/ies_polar_data.json
  var SPEC = {
    length: {
      '2':  { lumens: '2,646 lm (max @ 20W · IES-measured)', lpw: '136.7 lm/W', peak: '839 cd',   beam: '104°' },
      '4':  { lumens: '5,189 lm (max @ 40W · IES-measured)', lpw: '135.4 lm/W', peak: '1,593 cd', beam: '105°' },
      '8':  { lumens: '10,954 lm (max @ 80W · IES-measured)', lpw: '130.0 lm/W', peak: '3,222 cd', beam: '118°' },
      'HB': { lumens: '20,000-39,000 lm (max @ 135/250W per datasheet)', lpw: '156 lm/W max', peak: '12,000+ cd', beam: '~120°' }
    },
    cct: '3-CCTSELECT · 3500/4000/5000K (dip-switch)',
    voltage: '120-277V · Universal (single-voltage on every Eureka)'
  };

  // Default starting state — CCT auto-set (locked single chip · always S3).
  var DEFAULT_STATE = { cct: 'S3' };

  function init() {
    var section   = document.getElementById('configurator');
    if (!section) return;
    var counter   = document.getElementById('cfgCount');
    var counterEl = document.getElementById('cfgCounter');
    var resetBtn  = document.getElementById('cfgReset');
    var skuEl     = document.getElementById('cfgSku');
    var copyBtn   = document.getElementById('cfgSkuCopy');
    var copyLabel = document.getElementById('cfgSkuCopyLabel');
    var warning   = document.getElementById('cfgWarning');
    var ctaPrice  = document.getElementById('cfgCtaPrice');
    var ctaPdf    = document.getElementById('cfgCtaPdf');
    var chips     = section.querySelectorAll('.cfg-chip');
    var state     = Object.assign({}, DEFAULT_STATE);

    // ---- Chip click handler ----
    //   - Required field: clicking sets value (replaces any prior selection in field).
    //     Selecting a Length also re-validates the watt selection (clears if from a different length row).
    //   - Optional field: toggle behavior — click selects, click again on same value clears.
    //   - Locked chip: ignore clicks (CCT S3 chip).
    chips.forEach(function(chip) {
      chip.addEventListener('click', function() {
        if (chip.classList.contains('disabled') || chip.classList.contains('locked')) return;
        var field = chip.dataset.field;
        var val   = chip.dataset.val;
        var isOpt = OPTIONAL.indexOf(field) >= 0;

        if (isOpt && state[field] === val) {
          // Optional toggle — click active chip clears it
          delete state[field];
        } else {
          state[field] = val;
          // If user switched Length, clear any stale Performance watt selection
          // (because the Performance row for the new length is different from the prior length's row).
          if (field === 'length') delete state.watt;
        }
        applyState();
      });
    });

    // ---- Reset all ----
    resetBtn.addEventListener('click', function() {
      state = Object.assign({}, DEFAULT_STATE);
      applyState();
    });

    // ---- Apply state to UI ----
    function applyState() {
      // 1) Toggle .selected class on chips
      chips.forEach(function(chip) {
        var f = chip.dataset.field;
        var v = chip.dataset.val;
        chip.classList.toggle('selected', state[f] === v);
      });

      // 2) Conditional row visibility · [data-form-show="length=X"] only shown when length matches
      section.querySelectorAll('.cfg-row[data-form-show]').forEach(function(row) {
        var rule = row.getAttribute('data-form-show'); // e.g. "length=HB"
        var parts = rule.split('=');
        var visible = state[parts[0]] === parts[1];
        row.style.display = visible ? '' : 'none';
      });

      // 2b) Hide the WB legend row when no VISIBLE chip currently has the .wb stripe
      // (per James 2026-05-26 · "Remove WORKBENCH if no workbench is tagged").
      var wbLegendRow = document.getElementById('cfgLegendWbRow');
      if (wbLegendRow) {
        var hasVisibleWbChip = false;
        section.querySelectorAll('.cfg-chip-stripe.wb').forEach(function(stripe) {
          var row = stripe.closest('.cfg-row');
          if (!row) return;
          var rowVisible = !(row.style.display === 'none');
          if (rowVisible) hasVisibleWbChip = true;
        });
        wbLegendRow.hidden = !hasVisibleWbChip;
      }

      // 3) Update per-row code badge (right-of-label) with selected chip's data-val
      section.querySelectorAll('.cfg-row-code[data-field-code]').forEach(function(badge) {
        var f = badge.getAttribute('data-field-code');
        var v = state[f];
        if (v) {
          badge.textContent = v;
          badge.classList.remove('is-empty');
        } else {
          badge.textContent = '—';
          badge.classList.add('is-empty');
        }
      });

      // 4) Required-completion counter
      var filled = REQUIRED.filter(function(k) { return state[k] != null; }).length;
      counter.textContent = filled;
      counterEl.classList.toggle('complete', filled === REQUIRED.length);

      var complete = (filled === REQUIRED.length);
      renderSKU(complete);
      warning.classList.toggle('show', !complete);
      ctaPdf.classList.toggle('disabled', !complete);
      ctaPrice.classList.toggle('disabled', !complete);
      copyBtn.disabled = !complete;
      copyBtn.classList.remove('copied');
      copyLabel.textContent = 'Copy SKU';

      renderSpecs();
    }

    // ---- SKU encoder ----
    // Concatenates LV3P + length code + watt fragment (from active Performance chip's data-sku)
    // + optional suffixes from EM/Sensor/Bracket chips' data-sku attributes.
    function activeWattSku() {
      if (!state.length || !state.watt) return null;
      var chip = section.querySelector('.cfg-chip[data-field="watt"][data-val="' + state.watt + '"]');
      if (!chip) return null;
      var tpl = chip.getAttribute('data-sku') || '';
      // Substitute {dlc} placeholder with DLC chip selection · default to '?' if DLC not yet set
      return tpl.replace('{dlc}', state.dlc || '?');
    }
    function activeOptSku(field) {
      var v = state[field];
      if (!v) return '';
      var chip = section.querySelector('.cfg-chip[data-field="' + field + '"][data-val="' + v + '"]');
      return chip ? (chip.getAttribute('data-sku') || '') : '';
    }
    function renderSKU(complete) {
      var len = state.length;
      var wattFrag = activeWattSku();

      var lenSpan = len ? lengthCode(len) : '<span class="placeholder">[L]</span>';
      var wattSpan;
      if (wattFrag) {
        // If DLC is missing, the fragment still contains "?" — wrap that part in placeholder.
        if (wattFrag.indexOf('?') >= 0) {
          wattSpan = wattFrag.replace('?', '<span class="placeholder">[DLC]</span>');
        } else {
          wattSpan = wattFrag;
        }
      } else {
        wattSpan = '<span class="placeholder">-[WATT]-[CCT]</span>';
      }

      var suffix = activeOptSku('em') + activeOptSku('sensor') + activeOptSku('bracket');

      skuEl.innerHTML = 'LV3P' + lenSpan + wattSpan + suffix;
    }

    // ---- Live spec readout ----
    function renderSpecs() {
      var lenKey = state.length || null;
      setSpec('lumens',  lenKey && SPEC.length[lenKey] ? SPEC.length[lenKey].lumens : null);
      setSpec('lpw',     lenKey && SPEC.length[lenKey] ? SPEC.length[lenKey].lpw    : null);
      setSpec('peak',    lenKey && SPEC.length[lenKey] ? SPEC.length[lenKey].peak   : null);
      setSpec('voltage', SPEC.voltage);
      setSpec('cct',     state.cct ? '3-CCTSELECT (3500K / 4000K / 5000K · field dip-switch)' : null);
      setSpec('compliance', 'DLC ' + (state.dlc === 'S' ? 'Standard' : state.dlc === 'P' ? 'Premium' : 'tier pending') + ' · IP66 NEMA 4X · UL Wet · NSF · 7-yr/75k-hr');
    }
    function setSpec(name, val) {
      var el = section.querySelector('[data-spec="' + name + '"]');
      if (!el) return;
      // CCT and CRI are static — never overwrite them with placeholder
      if (name === 'cct' || name === 'cri' || (name === 'compliance' && val == null)) return;
      if (val == null || val === '—') {
        el.textContent = '—';
        el.classList.add('placeholder');
      } else {
        el.textContent = val;
        el.classList.remove('placeholder');
      }
    }

    // ---- Copy SKU ----
    copyBtn.addEventListener('click', function() {
      if (copyBtn.disabled) return;
      var txt = skuEl.textContent.trim();
      if (!txt) return;
      var done = function() {
        copyBtn.classList.add('copied');
        copyLabel.textContent = 'Copied ✓';
        setTimeout(function() {
          copyBtn.classList.remove('copied');
          copyLabel.textContent = 'Copy SKU';
        }, 1800);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(txt).then(done, done);
      } else {
        var ta = document.createElement('textarea');
        ta.value = txt;
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch(e){}
        document.body.removeChild(ta);
        done();
      }
    });

    // ---- Submittal PDF — opens submittal/ with full configurator state ----
    // CFG-QA-1 contract (revised 2026-05-26 per James's LV3P SKU spec):
    //   &length= 2 / 4 / 8 / HB
    //   &watt=   E20 / E40 / E46 / E80 / E135 / E250 / GTU / HBP / HBU
    //   &dlc=    S / P (drives -S3{dlc} suffix on E-series; ignored for fixed-suffix variants)
    //   &em=     EM08 / EM20 (optional)
    //   &sensor= BLS (optional)
    //   &bracket= SURF / TPM / JBX / ANG / VHK / VBR (optional)
    //   &sku=    full canonical SKU (passed verbatim · template uses this if present)
    function buildSubmittalUrl() {
      var sku = skuEl.textContent.trim();
      var params = new URLSearchParams({
        sku:     sku,
        family:  'eureka',
        length:  state.length  || '',
        watt:    state.watt    || '',
        dlc:     state.dlc     || '',
        em:      state.em      || '',
        sensor:  state.sensor  || '',
        bracket: state.bracket || ''
      });
      return 'submittal/?' + params.toString();
    }
    ctaPdf.addEventListener('click', function(e) {
      if (ctaPdf.classList.contains('disabled')) { e.preventDefault(); return; }
      ctaPdf.setAttribute('href', buildSubmittalUrl());
    });

    // Initial render
    applyState();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();

// (Legacy Illuminator motion-carousel IIFE removed — Eureka's 4-slide motion
//  player lives inline with Section 3 above, sourcing the production mp4s spliced
//  from "LV3P - EUREKA PromoVideo_NoText.mp4" via splice_eureka_video.sh)

// CFG · Live Preview length-binding (James 2026-05-26)
// Listens for clicks on Length chips in the configurator and swaps the cfgPreviewImg + dim caption.
// Uses the same 4 transparent-bg PNGs as the hero carousel for visual consistency.
(function() {
  var LENGTH_MAP = {
    '2':  { src: 'eureka/photos/LV3P-2FT_nobg.png',
            alt: 'LV3P Eureka-II · 2FT length variant preview',
            cap: 'LV3P2 · 2FT · 25.59" L × 4.17" W × 3.27" H' },
    '4':  { src: 'eureka/photos/LV3P-1_nobg.png',
            alt: 'LV3P Eureka-II · 4FT length variant preview · stainless latches visible',
            cap: 'LV3P4 · 4FT · 46.65" L × 4.17" W × 3.27" H' },
    '8':  { src: 'eureka/photos/LV3P-8FT_nobg.png',
            alt: 'LV3P Eureka-II · 8FT length variant preview',
            cap: 'LV3P8 · 8FT · 92.91" L × 4.17" W × 3.27" H' },
    'HB': { src: 'eureka/photos/LV3P4-3HBP-3CS_clear%20lens%20(2)_nobg.png',
            alt: 'LV3P Eureka-II · 4FT High-Bay wide-chassis preview',
            cap: 'LV3P4-HB · 50.12" L × 10.24" W × 3.27" H · high-output 135W/250W' }
  };
  function init() {
    var img = document.getElementById('cfgPreviewImg');
    var cap = document.getElementById('cfgPreviewDimCaption');
    if (!img || !cap) return;
    function applyLength(val) {
      var m = LENGTH_MAP[val];
      if (!m) return;
      img.src = m.src;
      img.alt = m.alt;
      cap.textContent = m.cap;
    }
    // Click handler · delegate to configurator section
    var section = document.getElementById('configurator');
    if (!section) return;
    section.addEventListener('click', function(e) {
      var chip = e.target.closest('.cfg-chip[data-field="length"]');
      if (!chip) return;
      applyLength(chip.getAttribute('data-val'));
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else { init(); }
})();

// CFG-STATE-1 — derive ship-tier (QS / WB / MTO) from selected chip badges, render
// canonical 3-state status panel. Self-contained module · no dependency on the
// configurator's state object · re-derives by walking selected chips on every click.
// Custom RAL (finish chip) with a valid 4-digit input forces MTO.
(function() {
  function deriveShipTier() {
    var section = document.getElementById('configurator');
    if (!section) return 'QS';
    var chips = section.querySelectorAll('.cfg-chip.selected, .cfg-chip[aria-pressed="true"]');
    var worst = 'QS';
    var sawCustomRal = false;
    chips.forEach(function(chip) {
      if (chip.dataset.field === 'finish' && chip.dataset.val === 'RAL') sawCustomRal = true;
      // CFG-CFG-1: stock state moved from .cfg-chip-stock text → .cfg-chip-stripe.
      // Check both selectors for back-compat during the transition.
      if (chip.querySelector('.cfg-chip-stripe.mto') || chip.querySelector('.cfg-chip-stock.mto')) worst = 'MTO';
      else if ((chip.querySelector('.cfg-chip-stripe.wb') || chip.querySelector('.cfg-chip-stock.wb')) && worst !== 'MTO') worst = 'WB';
    });
    if (sawCustomRal) {
      var input = document.getElementById('cfgRalInput');
      if (input && input.value && /^[0-9]{4}$/.test(input.value)) return 'MTO';
    }
    return worst;
  }
  function refreshShipTier() {
    var tier = deriveShipTier();
    var rowEl = document.getElementById('cfgShipTier');
    var iconEl = document.getElementById('cfgShipTierIcon');
    var textEl = document.getElementById('cfgShipTierText');
    var stockEl = document.getElementById('cfgShipTierStock');
    if (!rowEl || !iconEl || !textEl || !stockEl) return;
    if (tier === 'QS') {
      rowEl.style.background = 'rgba(95,199,122,0.08)';
      rowEl.style.border = '1px solid rgba(95,199,122,0.40)';
      iconEl.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#7fc998" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
      textEl.innerHTML = '<strong style="color:#9bd6b1;">QuickShip · à-la-carte assembly</strong> · <span style="color:var(--text-secondary);">All selected components in stock — ships 3-5 day.</span>';
      stockEl.textContent = 'QuickShip · 3-5 day';
      stockEl.style.color = '#9bd6b1';
    } else if (tier === 'WB') {
      rowEl.style.background = 'rgba(96,168,255,0.08)';
      rowEl.style.border = '1px solid rgba(96,168,255,0.40)';
      iconEl.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#7fb6ff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>';
      textEl.innerHTML = '<strong style="color:#a8c9ff;">Workbench Assembly · ~1-3 wk</strong> · <span style="color:var(--text-secondary);">One or more selected components are workbench-assembled to order.</span>';
      stockEl.textContent = 'WB · ~1-3 wk';
      stockEl.style.color = '#a8c9ff';
    } else {
      rowEl.style.background = 'rgba(255,159,28,0.08)';
      rowEl.style.border = '1px solid rgba(255,159,28,0.40)';
      iconEl.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#ffb14d" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
      textEl.innerHTML = '<strong style="color:#ffb14d;">Custom build · Made-to-Order · ~4-6 wk</strong> · <span style="color:var(--text-secondary);">One or more selected components are MTO (custom finish, MTO option, or non-stocked variant).</span>';
      stockEl.textContent = 'MTO · ~4-6 wk';
      stockEl.style.color = '#ffb14d';
    }
  }
  function init() {
    var section = document.getElementById('configurator');
    if (!section) return;
    section.addEventListener('click', function(e) {
      if (e.target.closest('.cfg-chip')) setTimeout(refreshShipTier, 50);
    });
    var ralInput = document.getElementById('cfgRalInput');
    if (ralInput) ralInput.addEventListener('input', function() { setTimeout(refreshShipTier, 50); });
    refreshShipTier();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
// CFG-CFG-1 · syncRowCodes — update per-row .cfg-row-code based on selected chip.
// Mirrors the canonical Liberty pattern. Self-contained · no dependency on the
// configurator's state object · walks selected chips on every chip click.
(function() {
  function syncRowCodes() {
    document.querySelectorAll('.cfg-row-code[data-field-code]').forEach(function(rc) {
      var field = rc.getAttribute('data-field-code');
      if (field === 'cct') return; // locked-default text stays
      var newText = '—', isEmpty = true;
      var selChip = document.querySelector('.cfg-chip.selected[data-field="' + field + '"]');
      if (selChip) {
        var code = selChip.getAttribute('data-code') || '';
        var slashPrefixed = ['mount','optic','photocell','sensor','shield','surge','taa','em','wg','adapter'];
        var alreadySlash = code.charAt(0) === '/';
        if (code) {
          newText = (slashPrefixed.indexOf(field) >= 0 && !alreadySlash) ? '/' + code : code;
          isEmpty = false;
        } else if (field === 'taa') {
          newText = '(blank)'; isEmpty = false;
        } else if (field === 'mount') {
          newText = '(none)'; isEmpty = false;
        }
      }
      rc.textContent = newText;
      rc.classList.toggle('is-empty', isEmpty);
    });
  }
  function init() {
    var section = document.getElementById('configurator');
    if (!section) return;
    section.addEventListener('click', function(e) {
      if (e.target.closest('.cfg-chip')) setTimeout(syncRowCodes, 60);
    });
    syncRowCodes();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();


</script>


<script>
/* =============================================================================
   CFG-NAV-1 · Sticky-nav scroll-spy
   ----------------------------------------------------------------------------
   IntersectionObserver watches each section the sticky-nav links to. The link
   whose target is "most visible" gets `.is-current` (white bg + red text · the
   visual inverse of `.primary`). One observer, one Map, one CSS class toggle.
   The Pricing & Availability primary button is NOT a section anchor (its href
   is /pricing-availability/), so it's excluded from the spy by the
   `a[href^="#"]` selector below.
   ============================================================================= */
(function() {
  var nav = document.querySelector('.sticky-nav');
  if (!nav) return;
  var links = Array.prototype.slice.call(nav.querySelectorAll('a[href^="#"]'));
  if (!links.length) return;
  var entries = [];
  links.forEach(function(a) {
    var id = a.getAttribute('href').slice(1);
    var sec = id ? document.getElementById(id) : null;
    if (sec) entries.push({ sec: sec, link: a, ratio: 0 });
  });
  if (!entries.length) return;
  function update() {
    var best = null, bestRatio = 0;
    entries.forEach(function(e) { if (e.ratio > bestRatio) { bestRatio = e.ratio; best = e; } });
    entries.forEach(function(e) { e.link.classList.toggle('is-current', e === best && bestRatio > 0); });
  }
  var io = new IntersectionObserver(function(items) {
    items.forEach(function(item) {
      entries.forEach(function(e) { if (e.sec === item.target) e.ratio = item.intersectionRatio; });
    });
    update();
  }, {
    rootMargin: '-20% 0px -55% 0px',
    threshold: [0, 0.1, 0.25, 0.5, 0.75, 1.0]
  });
  entries.forEach(function(e) { io.observe(e.sec); });
})();
</script>

</BaseLayout>

    text-transform: uppercase;
  }
  .zoom-modal-close:hover { background: rgba(255,255,255,0.1); border-color: white; }
  .zoom-modal-hint {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255,255,255,0.5);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;

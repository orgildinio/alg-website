<!-- Section 6 photometrics — real IES-derived data per length · 3-length tab driver
     IES files parsed at /eureka/ies/EUREKA-II/ via /eureka/parse_ies.py (2026-05-26).
     Polar SVGs rendered via /eureka/render_polar_svg.py → /assets/polar/eureka-polar-{"{"}N{"}"}ft.svg.
     Per length: { lumens, peak_cd, beam_angle, lm/W, watts } all parsed directly from the IES file. -->
<script>
(function(){
  // Authoritative values from IES parse 2026-05-26 (EUREKA-II 5000K bundle):
  var ies = {
    '2': { svg: 'assets/polar/eureka-polar-2ft.svg', lumens: '2,646 lm', peak: '839 cd', beam: '104°', watts: '19.4W', lpw: '136.7 lm/W',
           file: 'LV3P2-3E20-S3P-5K_IESNA2002.IES',
           caption: 'LV3P2 · 2FT · LM-79 at 5000K · max WATTSELECT (20W) — beam profile identical at 3500K / 4000K (CCT changes color, not distribution).' },
    '4': { svg: 'assets/polar/eureka-polar-4ft.svg', lumens: '5,189 lm', peak: '1,593 cd', beam: '105°', watts: '38.3W', lpw: '135.4 lm/W',
           file: 'LV3P4-3E40-S3P-5K_IESNA2002.IES',
           caption: 'LV3P4 · 4FT · LM-79 at 5000K · max WATTSELECT (40W) — beam profile identical at 3500K / 4000K. For HB high-bay variants (135W / 250W max), see the full IES bundle below.' },
    '8': { svg: 'assets/polar/eureka-polar-8ft.svg', lumens: '10,954 lm', peak: '3,222 cd', beam: '118°', watts: '84.3W', lpw: '130.0 lm/W',
           file: 'LV3P8-3E80-S3P-5K_IESNA2002.IES',
           caption: 'LV3P8 · 8FT · LM-79 at 5000K · max WATTSELECT (80W) — beam profile identical at 3500K / 4000K. Slightly wider beam (118° vs 104-105°) due to length-of-source effect.' }
  };

  var modelTabs = document.querySelectorAll('.photo-tab[data-model]');
  var polarImg  = document.getElementById('photoPolarImg');
  var statPeak  = document.getElementById('photoStatPeak');
  var statLum   = document.getElementById('photoStatLumens');
  var statFile  = document.getElementById('photoStatFile');
  var statOpticDesc = document.getElementById('photoStatOpticDesc');

  function render(model){
    var d = ies[model]; if (!d) return;
    if (polarImg) {
      polarImg.src = d.svg;
      polarImg.alt = 'LV3P' + model + ' Eureka-II polar candela distribution · 5000K · peak ' + d.peak + ' · beam ' + d.beam;
    }
    if (statPeak) statPeak.textContent = d.peak;
    if (statLum)  statLum.textContent  = d.lumens + '  @  ' + d.watts + '  ·  ' + d.lpw;
    if (statFile) statFile.textContent = d.file;
    if (statOpticDesc) statOpticDesc.textContent = d.caption;
    modelTabs.forEach(function(t){
      var on = t.dataset.model === model;
      t.classList.toggle('active', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
    });
  }

  modelTabs.forEach(function(t){
    t.addEventListener('click', function(){ render(t.dataset.model); });
  });

  render('2');
})();
</script>


    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .cfg-ral-input-wrap.show { display: flex; }
  .cfg-ral-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .cfg-ral-input-group {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid var(--line-medium);

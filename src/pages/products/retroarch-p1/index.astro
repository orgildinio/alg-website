---
/**
 * retroarch-p1 PDP — planoⒶRCH · Astro wrapper
 * Route: /products/retroarch-p1/
 * Bug #1 fix: wraps canonical BaseLayout (Header + MegaMenu + Footer)
 * Uses readFileSync + set:html to inject raw PDP body without Astro template processing.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';

// Read the public HTML at build time using process.cwd() (project root)
const publicHtml = readFileSync(
  path.join(process.cwd(), 'public/products/retroarch-p1/index.html'),
  'utf-8'
);
// Extract body content — everything between <body...> and </body>
const bodyMatch = publicHtml.match(/<body[^>]*>([\s\S]*)<\/body>/i);
const rawBodyContent = bodyMatch ? bodyMatch[1] : publicHtml;
// Defensive sanitizer: strip any .closing-cta-strip div that leaked in from the mockup
const bodyContent = rawBodyContent.replace(
  /(?:[ \t]*<!--[^>]*Final red CTA strip[^>]*-->\s*\n)?[ \t]*<div\s+class="closing-cta-strip"[^>]*>[\s\S]*?<\/div>\s*<\/div>\s*\n/g,
  ''
);
---
<BaseLayout
  title="LBLR · retroⒶRCH-P1 — Retrofit Back-Lit Panel · Archipelago Lighting Group"
  description="LBLR retroⒶRCH-P1 · planoⒶRCH PRO · Retrofit Back-Lit Panel · DLC Premium."
  bodyClass="retroarch-p1-pdp"
>
  <Fragment set:html={bodyContent} />
</BaseLayout>

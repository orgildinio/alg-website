<!-- Section 6 photometrics — Tiny 3-wattage × 1-optic data driver (LM-63 IES-rendered).
     Single 90×90 wide-beam optic across all 3 SKUs. Stats from BACL LM-79 IES bundle
     (TINY.zip · Nov 2024). LLHB085 has no IES file on disk — shares the 1.2FT housing
     and frosted polycarbonate optic with LLHB150 (same beam silhouette by construction),
     so the 085 polar reuses the 150_ut SVG with downscaled lumen/peak stats. -->
<script>
(function(){
  // Per-wattage IES-measured data (from polar_*.svg render output 2026-05-27)
  var data = {
    '085': { peak: '5,229 cd',  lumens: '11,985 lm', watts: '85W',  lpw: '141 lm/W',
             polar: 'polar_085_ut', ies: 'LLHB150-UT50.ies (shared optic · scaled @ 85W)' },
    '150': { peak: '9,494 cd',  lumens: '20,186 lm', watts: '146W', lpw: '138 lm/W',
             polar: 'polar_150_ut', ies: 'LLHB150-UT50.ies' },
    '220': { peak: '14,739 cd', lumens: '31,894 lm', watts: '217W', lpw: '147 lm/W',
             polar: 'polar_220_ut', ies: 'LLHB220-UT50.ies' }
  };

  var modelTabs = document.querySelectorAll('.photo-tab[data-model]');
  var statPeak  = document.getElementById('photoStatPeak');
  var statLum   = document.getElementById('photoStatLumens');
  var statFile  = document.getElementById('photoStatFile');
  var plotImg   = document.getElementById('photoPlotImg');

  var state = { model: '085' };

  function render(){
    var d = data[state.model];
    if (d) {
      if (statPeak) statPeak.textContent = d.peak;
      if (statLum)  statLum.textContent  = d.lumens + ' (@ ' + d.watts + ' · ' + d.lpw + ')';
      if (statFile) statFile.textContent = d.ies;
      if (plotImg)  plotImg.setAttribute('src', 'tiny/photometrics/' + d.polar + '.svg?v=2026-05-27');
    }
    modelTabs.forEach(function(t){
      var on = t.dataset.model === state.model;
      t.classList.toggle('active', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
    });
  }

  modelTabs.forEach(function(t){
    t.addEventListener('click', function(){ state.model = t.dataset.model; render(); });
  });

  render();
})();
</script>


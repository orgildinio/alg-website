<!-- Section 8 accessories — Titan filter pill driver -->
<script>
(function(){
  var pills = document.querySelectorAll('.acc-pill');
  var cards = document.querySelectorAll('#accGrid .acc-card');
  if (!pills.length || !cards.length) return;
  pills.forEach(function(p){
    p.addEventListener('click', function(){
      var f = p.dataset.filter;
      pills.forEach(function(x){
        x.classList.toggle('active', x === p);
        x.setAttribute('aria-selected', x === p ? 'true' : 'false');
      });
      cards.forEach(function(c){
        var show = (f === 'all') || (c.dataset.cat === f);
        c.style.display = show ? '' : 'none';
      });
    });
  });
})();
</script>

<!-- ============================================================================
     SECTION 9 — Configurator + Submittal · "Build Your Tiny"
     ----------------------------------------------------------------------------
     SKU template (per datasheet Page 3 Ordering Guide):
        LLHB{WATTAGE}-{VOLTAGE}T50[/TAA]
     Required (2): Wattage · Voltage   (no optic — Tiny ships fixed 90°×90°. No CCT — fixed 5000K.)
     Optional (1): TAA Compliant
     Live readout: lumens · efficacy · peak intensity · voltage · optic · CCT · CRI
     CTAs (Illuminator-canonical): Pricing & Availability, Submittal PDF (submittal_template.html?wattage=…), Request a Layout
     CFG-* compliance:
       CFG-COPY-3  configurators ship at Illuminator density · chip-codes only · no inline callouts
       CFG-QA-1    URL contract uses canonical &wattage= (never &watt= or &model=)
       CFG-5a      cfg-col-legend-floor on the shorter (Optional) column
     ============================================================================ -->
<section class="cfg-section" id="configurator">
  <div class="cfg-inner">

    <div class="cfg-head">
      <div class="cfg-eyebrow">Configurator</div>
      <h2 class="cfg-title">Build Your Tiny.</h2>
      <p class="cfg-sub">
        Pick wattage class and voltage — your SKU resolves live, your submittal generates instantly.
        <small>6 active SKUs · 3 wattage classes · fixed 90°×90° wide optic · fixed 5000K daylight · TAA-compliant Mexico-built variant on the 220W</small>
      </p>
    </div>

    <div class="cfg-counter-band">
      <div class="cfg-counter" id="cfgCounter"><strong id="cfgCount">0</strong> of 3 required selections complete (Wattage &middot; Voltage &middot; Compliance)</div>
      <button type="button" class="cfg-reset" id="cfgReset" aria-label="Reset configurator">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
        Reset
      </button>
    </div>

    <!-- Build form · 6 confirmed Zoho SKUs (canonical list per James 2026-05-27):
           LLHB085-UT50 (299 QS) · LLHB150-UT50 (232 QS) · LLHB150-HT50 (1406 QS)
           LLHB220-UT50 (1145 QS) · LLHB220-HT50 (QS) · LLHB220-UT50/TAA (4931 QS)
         SKU pattern: LLHB{wattage}-{V}T50[/TAA]   (no CCT chip · 5000K fixed · no WATTSELECT)
         Constraints (enforced via JS chip disabling):
           - 85W only ships as UT (no HT, no TAA)
           - 150W ships UT + HT (no TAA)
           - 220W ships UT + HT · TAA only on UT -->
    <div class="cfg-body split-60-40" style="grid-template-columns: 3fr 2fr !important;">
      <!-- ============== REQUIRED COLUMN ============== -->
      <div class="cfg-col cfg-col-req">
        <div class="cfg-col-head">
          <div class="cfg-col-title cfg-col-title-required">Required</div>
          <div class="cfg-col-meta">3 fields · all must be set</div>
        </div>
        <div class="cfg-rows">

          <!-- Step 1 · Wattage Class · 3 chips -->
          <div class="cfg-row" data-field="wattage">
            <div class="cfg-row-l">
              <span class="cfg-row-label">Wattage Class<span class="cfg-req">*</span></span>
              <span class="cfg-row-code is-empty" data-field-code="wattage">—</span>
            </div>
            <div class="cfg-seg" style="grid-template-columns: repeat(3, 1fr);">
              <button type="button" class="cfg-chip" data-field="wattage" data-val="085" data-code="085"><span class="cfg-chip-stripe qs"></span><span class="cfg-chip-main"><span class="cfg-chip-label">85W</span></span></button>
              <button type="button" class="cfg-chip" data-field="wattage" data-val="150" data-code="150"><span class="cfg-chip-stripe qs"></span><span class="cfg-chip-main"><span class="cfg-chip-label">150W</span></span></button>
              <button type="button" class="cfg-chip" data-field="wattage" data-val="220" data-code="220"><span class="cfg-chip-stripe qs"></span><span class="cfg-chip-main"><span class="cfg-chip-label">220W</span></span></button>
            </div>
          </div>

          <!-- Step 2 · Voltage · 2 chips · HT disabled when wattage=085 (no LLHB085-HT50 SKU) -->
          <div class="cfg-row" data-field="voltage">
            <div class="cfg-row-l">
              <span class="cfg-row-label">Voltage<span class="cfg-req">*</span></span>
              <span class="cfg-row-code is-empty" data-field-code="voltage">—</span>
            </div>
            <div class="cfg-seg" style="grid-template-columns: repeat(2, 1fr);">
              <button type="button" class="cfg-chip" data-field="voltage" data-val="UT" data-code="UT" data-star="1"><span class="cfg-chip-stripe qs"></span><span class="cfg-chip-main"><span class="cfg-chip-label">UT &middot; 120-277V</span><span class="cfg-chip-star">★</span></span></button>
              <button type="button" class="cfg-chip" data-field="voltage" data-val="HT" data-code="HT"><span class="cfg-chip-stripe qs"></span><span class="cfg-chip-main"><span class="cfg-chip-label">HT &middot; 277-480V</span></span></button>
            </div>
          </div>

          <!-- Step 3 · Trade Compliance · 2 chips · TAA only on 220W + UT voltage -->
          <div class="cfg-row" data-field="taa">
            <div class="cfg-row-l">
              <span class="cfg-row-label">Trade Compliance<span class="cfg-req">*</span></span>
              <span class="cfg-row-code is-empty" data-field-code="taa">—</span>
            </div>
            <div class="cfg-seg" style="grid-template-columns: repeat(2, 1fr);">
              <button type="button" class="cfg-chip" data-field="taa" data-val="STD" data-code="" data-star="1"><span class="cfg-chip-stripe qs"></span><span class="cfg-chip-main"><span class="cfg-chip-label">Standard</span><span class="cfg-chip-star">★</span></span></button>
              <button type="button" class="cfg-chip" data-field="taa" data-val="TAA" data-code="TAA"><span class="cfg-chip-stripe qs"></span><span class="cfg-chip-main"><span class="cfg-chip-label">TAA Compliant &middot; Made in Mexico</span></span></button>
            </div>
          </div>

        </div>
      </div>

      <!-- ============== OPTIONAL COLUMN (legend + disclaimer · no accessories for Tiny ECO line) ============== -->
      <div class="cfg-col cfg-col-opt cfg-col-optional-flex">
        <div class="cfg-col-head">
          <div class="cfg-col-title">Optional</div>

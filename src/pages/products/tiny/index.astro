  var SKU_STOCK = {
    'LLHB085-UT50':      { qty: 299,  tier: 'QS' },
    'LLHB150-UT50':      { qty: 232,  tier: 'QS' },
    'LLHB150-HT50':      { qty: 1406, tier: 'QS' },
    'LLHB220-UT50':      { qty: 1145, tier: 'QS' },
    'LLHB220-HT50':      { qty: 50,   tier: 'QS' },   // assumed QS · stock not explicitly queried
    'LLHB220-UT50/TAA':  { qty: 4931, tier: 'QS' }
  };

  // Allowed SKU constraints (per James's 6-SKU canonical list 2026-05-27):
  //   85W   → UT only (no HT, no TAA)
  //   150W  → UT or HT (no TAA on either)
  //   220W  → UT or HT (TAA only on UT)
  var ALLOWED = {
    '085-UT': true,
    '150-UT': true, '150-HT': true,
    '220-UT': true, '220-HT': true
  };
  var TAA_ALLOWED = {
    '220-UT': true   // only LLHB220-UT50/TAA exists in the canonical set
  };

  // Default REQUIRED override (3 fields) and OPTIONAL override (none for Tiny)
  REQUIRED = ['wattage', 'voltage', 'taa'];
  OPTIONAL = [];

  // Default starting state — empty (user picks all 3 required).
  var DEFAULT_STATE = { wattage: '085', voltage: 'UT', taa: 'STD' };

  function init() {
    var section   = document.getElementById('configurator');
    if (!section) return;
    var counter   = document.getElementById('cfgCount');
    var counterEl = document.getElementById('cfgCounter');
    var resetBtn  = document.getElementById('cfgReset');
    var skuEl     = document.getElementById('cfgSku');
    var copyBtn   = document.getElementById('cfgSkuCopy');
    var copyLabel = document.getElementById('cfgSkuCopyLabel');
    var warning   = document.getElementById('cfgWarning');
    var ctaPrice  = document.getElementById('cfgCtaPrice');
    var ctaPdf    = document.getElementById('cfgCtaPdf');
    var chips     = section.querySelectorAll('.cfg-chip');
    var state     = Object.assign({}, DEFAULT_STATE);

    // ---- Chip click handler ----
    chips.forEach(function(chip) {
      chip.addEventListener('click', function() {
        if (chip.classList.contains('disabled')) return;
        var field = chip.dataset.field;
        var val   = chip.dataset.val;
        var isOpt = OPTIONAL.indexOf(field) >= 0;

        if (isOpt && state[field] === val) {
          delete state[field];
        } else {
          state[field] = val;
        }
        // Auto-defaults · class pick auto-fills Voltage + TAA per Icarus canonical
        if (field === 'wattage') {
          if (state.voltage == null || !ALLOWED[val + '-' + state.voltage]) state.voltage = 'UT';
          if (state.taa == null) state.taa = 'STD';
        }
        // Voltage pick · invalidate TAA if not allowed for new combo
        if (field === 'voltage' && state.taa === 'TAA' && state.wattage) {
          if (!TAA_ALLOWED[state.wattage + '-' + val]) state.taa = 'STD';
        }
        applyState();
      });
    });

    // ---- Reset all ----
    resetBtn.addEventListener('click', function() {
      state = Object.assign({}, DEFAULT_STATE);
      applyState();
    });

    // ---- Apply state to UI · disable chips that violate constraints ----
    function applyState() {
      chips.forEach(function(chip) {
        var f = chip.dataset.field;
        var v = chip.dataset.val;
        chip.classList.toggle('selected', state[f] === v);

        // Constraint-driven disabling
        var disabled = false;
        if (f === 'voltage' && state.wattage) {
          disabled = !ALLOWED[state.wattage + '-' + v];
        } else if (f === 'taa' && v === 'TAA' && state.wattage && state.voltage) {
          disabled = !TAA_ALLOWED[state.wattage + '-' + state.voltage];
        }
        chip.classList.toggle('disabled', disabled);
        chip.style.opacity = disabled ? '0.30' : '';
        chip.style.cursor  = disabled ? 'not-allowed' : '';
      });

      var filled = REQUIRED.filter(function(k) { return state[k] != null; }).length;
      counter.textContent = filled;
      counterEl.classList.toggle('complete', filled === REQUIRED.length);

      var complete = (filled === REQUIRED.length);
      renderSKU(complete);
      warning.classList.toggle('show', !complete);
      ctaPdf.classList.toggle('disabled', !complete);
      ctaPrice.classList.toggle('disabled', !complete);
      copyBtn.disabled = !complete;
      copyBtn.classList.remove('copied');
      copyLabel.textContent = 'Copy SKU';

      renderSpecs();
    }

    // ---- SKU encoder ----
    // Canonical SKU pattern: LLHB{wattage}-{voltage}50[/TAA]
    //   wattage = 085 / 150 / 220   (3-WATTSELECT class)
    //   voltage = UT (120-277V) / HT (277-480V)
    //   50      = 5000K CCT (fixed · single-CCT product)
    //   /TAA    = Trade-Compliance adder (only valid on LLHB220-UT50)
    // Examples: LLHB085-UT50 · LLHB150-HT50 · LLHB220-UT50/TAA
    function renderSKU(complete) {
      var wattage = state.wattage;
      var html = 'LLHB' + (wattage || '<span class="placeholder">[W]</span>');

      // Voltage segment — voltage chip data-code is the full voltage prefix (UT/HT),
      // CCT (50 = 5000K) is appended as the fixed CCT suffix.
      if (state.voltage == null) {
        html += '-<span class="placeholder">[V]</span>50';
      } else {
        var vChip = section.querySelector('.cfg-chip[data-field="voltage"][data-val="' + state.voltage + '"]');
        var vCode = vChip ? vChip.dataset.code : state.voltage;
        html += '-' + vCode + '50';
      }

      // TAA optional adder (omitted when standard)
      if (state.taa === 'TAA') html += '/TAA';

      skuEl.innerHTML = html;
    }
    function placeholderFor(k) {
      return ({
        wattage: '[W]',
        voltage: '[V]',
        taa:     '[TAA]'
      })[k] || '[' + k.toUpperCase() + ']';
    }

    // ---- Live spec readout ----
    function renderSpecs() {
      setSpec('lumens',  state.wattage ? SPEC.wattage[state.wattage].lumens : null);
      setSpec('lpw',     state.wattage ? SPEC.wattage[state.wattage].lpw    : null);
      setSpec('voltage', state.voltage ? SPEC.voltage[state.voltage]        : null);
      setSpec('optic',   SPEC.opticReadout);   // always populated — Tiny single optic
      setSpec('peak',    state.wattage ? (SPEC.peak[state.wattage] || '—')   : null);

      // CCT + CRI are fixed for the family — already populated in markup, no override.

      // Compliance auto-updates with TAA selection
      var compliance = 'DLC Listed · IP20 Damp · 6kVA Surge';
      if (state.taa === 'TAA') compliance += ' · TAA Compliant';
      setSpec('compliance', compliance);
    }
    function setSpec(name, val) {
      var el = section.querySelector('[data-spec="' + name + '"]');
      if (!el) return;
      // CCT and CRI are static — never overwrite them with placeholder
      if (name === 'cct' || name === 'cri' || (name === 'compliance' && val == null)) return;
      if (val == null || val === '—') {
        el.textContent = '—';
        el.classList.add('placeholder');
      } else {
        el.textContent = val;
        el.classList.remove('placeholder');
      }
    }

    // ---- Copy SKU ----
    copyBtn.addEventListener('click', function() {
      if (copyBtn.disabled) return;
      var txt = skuEl.textContent.trim();
      if (!txt) return;
      var done = function() {
        copyBtn.classList.add('copied');
        copyLabel.textContent = 'Copied ✓';
        setTimeout(function() {
          copyBtn.classList.remove('copied');
          copyLabel.textContent = 'Copy SKU';
        }, 1800);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(txt).then(done, done);
      } else {
        var ta = document.createElement('textarea');
        ta.value = txt;
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch(e){}
        document.body.removeChild(ta);
        done();
      }
    });

    // ---- Submittal PDF — opens ../submittal_template_tiny.html?wattage=… in new tab ----
    // CFG-QA-1 contract: canonical &wattage= (never &watt= or &model=).
    // CFG-SUB-2: sibling-relative path · submittal lives at /v2_mockups/, PDP at /v2_mockups/lamparARCH/.
    function buildSubmittalUrl() {
      var sku = skuEl.textContent.trim();
      var params = new URLSearchParams({
        sku:     sku,
        family:  'tiny',
        wattage: state.wattage || '085',
        voltage: state.voltage || 'UT',
        taa:     state.taa === 'TAA' ? 'TAA' : '0'
      });
      return 'submittal/?' + params.toString();
    }
    ctaPdf.addEventListener('click', function(e) {
      if (ctaPdf.classList.contains('disabled')) { e.preventDefault(); return; }
      ctaPdf.setAttribute('href', buildSubmittalUrl());
    });

    // Initial render
    applyState();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();

// (Legacy Illuminator motion-carousel IIFE removed — Titan's 2-slide motion
//  player lives inline with Section 5 above, sourcing the production mp4s from
//  the in-work draft preview at cdn.shopify.com/videos/c/o/v/...)
</script>


<script>
/* =============================================================================
   CFG-NAV-1 · Sticky-nav scroll-spy
   ----------------------------------------------------------------------------
   IntersectionObserver watches each section the sticky-nav links to. The link
   whose target is "most visible" gets `.is-current` (white bg + red text · the
   visual inverse of `.primary`). One observer, one Map, one CSS class toggle.
   The Pricing & Availability primary button is NOT a section anchor (its href
   is /pricing-availability/), so it's excluded from the spy by the
   `a[href^="#"]` selector below.
   ============================================================================= */
(function() {
  var nav = document.querySelector('.sticky-nav');
  if (!nav) return;
  var links = Array.prototype.slice.call(nav.querySelectorAll('a[href^="#"]'));
  if (!links.length) return;
  var entries = [];
  links.forEach(function(a) {
    var id = a.getAttribute('href').slice(1);
    var sec = id ? document.getElementById(id) : null;
    if (sec) entries.push({ sec: sec, link: a, ratio: 0 });
  });
  if (!entries.length) return;
  function update() {
    var best = null, bestRatio = 0;
    entries.forEach(function(e) { if (e.ratio > bestRatio) { bestRatio = e.ratio; best = e; } });
    entries.forEach(function(e) { e.link.classList.toggle('is-current', e === best && bestRatio > 0); });
  }
  var io = new IntersectionObserver(function(items) {
    items.forEach(function(item) {
      entries.forEach(function(e) { if (e.sec === item.target) e.ratio = item.intersectionRatio; });
    });
    update();
  }, {
    rootMargin: '-20% 0px -55% 0px',
    threshold: [0, 0.1, 0.25, 0.5, 0.75, 1.0]
  });
  entries.forEach(function(e) { io.observe(e.sec); });
})();
</script>

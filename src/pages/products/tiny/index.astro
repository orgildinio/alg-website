<!-- Section 2 spec-table populator + dimension swap (Tiny · 3 wattages · 2 housings)
     Each tab = single wattage (no 3-WATTSELECT dip-switch). 085+150 share housing #1
     (14.17 × 11.02 × 1.89 / 4.41 lb). 220 ships housing #2 (18.11 × 11.81 × 1.89 / 6.16 lb).
     Lumens / efficacy / DLC IDs all canonical against datasheet pages 2-3 (2026-05-04).
     Voltage column reflects active SKU registry: 085 is UT-only; 150/220 ship UT + HT. -->
<script>
(function() {
  var data = {
    '085': [
      { watt: '85W',  lumens: '11,985 lm', lpw: '141 lm/W', cct: '5000K', volt: '120-277V', dlc: 'DLC S-4CP19M' }
    ],
    '150': [
      { watt: '150W', lumens: '21,150 lm', lpw: '141 lm/W', cct: '5000K', volt: '120-277V · 277-480V', dlc: 'DLC S-M4P5WX · S-F6IUTV' }
    ],
    '220': [
      { watt: '220W', lumens: '30,800 lm', lpw: '140 lm/W', cct: '5000K', volt: '120-277V · 277-480V', dlc: 'DLC S-ZQ8KLN · S-D8VRVZ (TAA)' }
    ]
  };
  // Per-wattage dimensions + housing assignment.
  // Tiny-specific dimension SVGs not yet on the ALG Shopify CDN; using the
  // Titan 14inch SVG as a near-identical placeholder for the 14.17″ housing
  // (085 + 150). Inline SVG placeholder for the 18.11″ housing (220) until
  // production assets ship.
  var H1_SVG = 'data:image/svg+xml;utf8,<svg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%20360%20240%22><rect%20width=%22360%22%20height=%22240%22%20fill=%22none%22/><text%20x=%22180%22%20y=%22120%22%20fill=%22%23889%22%20font-family=%22monospace%22%20font-size=%2213%22%20text-anchor=%22middle%22>DIMENSIONS%20·%20PENDING%20SVG</text></svg>';
  var H2_PLACEHOLDER = 'data:image/svg+xml;utf8,' + encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 360 220" font-family="JetBrains Mono, monospace">' +
      '<rect x="40" y="60" width="280" height="100" fill="none" stroke="%23bbb" stroke-width="1.5"/>' +
      '<circle cx="180" cy="110" r="22" fill="none" stroke="%23F32740" stroke-width="1.5"/>' +
      '<line x1="40" y1="180" x2="320" y2="180" stroke="%23bbb" stroke-width="1"/>' +
      '<text x="180" y="200" text-anchor="middle" font-size="11" fill="%23999">18.11″</text>' +
      '<line x1="20" y1="60" x2="20" y2="160" stroke="%23bbb" stroke-width="1"/>' +
      '<text x="14" y="115" text-anchor="end" font-size="11" fill="%23999" transform="rotate(-90 14 115)">11.81″</text>' +
      '<text x="180" y="40" text-anchor="middle" font-size="10" fill="%23F32740" letter-spacing="2">PLACEHOLDER · PENDING TINY PRODUCTION SVG</text>' +
    '</svg>'
  );
  var dim = {
    '085': {
      svg:  H1_SVG,
      alt:  'Tiny LLHB085-UT50 dimensions — 14.17 × 11.02 × 1.89 in (housing #1, shared with LLHB150 · placeholder pending production SVG)',
      note: 'LLHB085-UT50 · 14.17 × 11.02 × 1.89 in · 4.41 lb · 6FT aircraft cables + V-hooks included'
    },
    '150': {
      svg:  H1_SVG,
      alt:  'Tiny LLHB150 dimensions — 14.17 × 11.02 × 1.89 in (housing #1, shared with LLHB085 · placeholder pending production SVG)',
      note: 'LLHB150-UT50 · 14.17 × 11.02 × 1.89 in · 4.41 lb · shared housing with LLHB085 · 6FT aircraft cables + V-hooks included'
    },
    '220': {
      svg:  H2_PLACEHOLDER,
      alt:  'Tiny LLHB220 dimensions — 18.11 × 11.81 × 1.89 in (housing #2 · placeholder pending production SVG)',
      note: 'LLHB220-UT50 · 18.11 × 11.81 × 1.89 in · 6.16 lb · 6FT aircraft cables + V-hooks included'
    }
  };
  var tbody = document.getElementById('specTableBody');
  var tabs = document.querySelectorAll('.spec-watt-tab');
  function render(model) {
    tbody.innerHTML = data[model].map(function(r) {
      return '<tr class="is-default">' +
             '<td>' + r.watt   + '</td>' +
             '<td>' + r.lumens + '</td>' +
             '<td>' + r.lpw    + '</td>' +
             '<td>' + r.cct    + '</td>' +
             '<td>' + r.volt   + '</td>' +
             '</tr>' +
             '<tr class="spec-table-meta-row"><td colspan="5" style="text-align:left; padding:6px 12px 10px; font-family:\'JetBrains Mono\', monospace; font-size:10px; color:var(--text-muted); letter-spacing:0.10em;">' +
             r.dlc +
             '</td></tr>';
    }).join('');
    var d = dim[model];
    if (d) {
      var img = document.getElementById('dimImg');
      var cap = document.getElementById('dimCaption');
      if (img) {
        img.src = d.svg;
        img.alt = d.alt;
      }
      if (cap) cap.textContent = d.note;
    }
  }
  tabs.forEach(function(t) {
    t.addEventListener('click', function() {
      tabs.forEach(function(x) { x.classList.remove('active'); x.setAttribute('aria-selected', 'false'); });
      t.classList.add('active');
      t.setAttribute('aria-selected', 'true');
      render(t.dataset.w);
    });
  });
  render('085');
})();
</script>


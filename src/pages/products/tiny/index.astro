    flex-direction: column;
    gap: 20px;
  }
  .cfg-sku-block { display: flex; flex-direction: column; gap: 6px; }
  .cfg-sku-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.18em;
    color: var(--brand-red);
    text-transform: uppercase;
    font-weight: 700;
  }
  .cfg-sku {
    font-family: 'JetBrains Mono', monospace;
    font-size: 22px;
    font-weight: 700;

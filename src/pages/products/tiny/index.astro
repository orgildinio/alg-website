<!-- Section 3 motion-player driver — Tiny (7-slide rotation)
     Mirrors the Illuminator canonical pattern: clips[] uses {url, tag, title};
     dot buttons render as labeled chips (NN · TAG); caption is two-line
     (eyebrow numero + tag, then narrative title). Each clip is 9s exact,
     so we sync the progress bar to video.currentTime and auto-advance on
     video.ended (cleaner than a wallclock ticker for video-driven progress).
     Source: LLHB-Tiny-PromoVideo.mp4 master · 1:42 · Feb 2025.  -->
<script>
(function(){
  var clips = [
    {
      url:   'videos/tiny-motion-01-profile.mp4',
      tag:   'SIDE PROFILE ROTATION',
      title: 'Compact die-cast aluminum housing &mdash; rotated through side profile and lit hero pose. The contractor-grade industrial form factor that makes Tiny a drop-in replacement for fluorescent and metal halide.'
    },
    {
      url:   'videos/tiny-motion-02-cable.mp4',
      tag:   'SAFETY CABLE MOUNT',
      title: 'Standard 6FT aircraft cables ship with every fixture &mdash; pre-attached, install-ready. No extra mount kit for the typical I-beam, strut, or joist hang. Out-of-the-carton suspension.'
    },
    {
      url:   'videos/tiny-motion-03-surface.mp4',
      tag:   'SURFACE MOUNT',
      title: 'Surface bracket kit (LLHB-T2/SFM) &mdash; flush-to-deck install for mezzanines, low-bay corridors, and applications where pendant drop isn&rsquo;t an option. Same fixture, factory-matched bracket.'
    },
    {
      url:   'videos/tiny-motion-04-pendant.mp4',
      tag:   'PENDANT MOUNT',
      title: 'Conduit pendant kit (LLHB-T2/PDM) &mdash; rigid drop for high-ceiling industrial spaces and runs where chain or cable doesn&rsquo;t fit the spec. Single-point feed, locking hardware, clean line.'
    },
    {
      url:   'videos/tiny-motion-05-hero.mp4',
      tag:   'HERO &middot; DARK ISOLATED',
      title: 'Tiny lit on a dark backdrop &mdash; the contractor-grade hero pose. Compact, easy-to-manage, dependable. The ECO linear high-bay engineered for retrofit-grade simplicity.'
    },
    {
      url:   'videos/tiny-motion-06-sensor.mp4',
      tag:   'SENSOR-READY PORT',
      title: 'Integrated sensor receptacle pairs out of the box with the contr<span class="aa">Ⓐ</span>LS ecosystem &mdash; Bi-Level for hardwired drop-in occupancy, <span class="aa">Ⓐ</span>CS for Bluetooth Mesh, SILVAIR for DLC NLC enterprise deployments. Three platforms, one port.'
    },
    {
      url:   'videos/tiny-motion-07-warehouse.mp4',
      tag:   'REAL-WORLD WAREHOUSE',
      title: 'Rows of Tiny lining a warehouse corridor &mdash; contractor-grade illumination at 20-25FT mounting. Warehouses &middot; industrial corridors &middot; gyms &middot; retail backrooms. Drop-in MH replacement.'
    }
  ];

  var video    = document.getElementById('motionVideo');
  var caption  = document.getElementById('motionCaption');
  var dotsRow  = document.getElementById('motionDots');
  var progress = document.getElementById('motionProgressBar');
  var errorBox = document.getElementById('motionError');
  var errorPath = document.getElementById('motionErrorPath');
  if (!video || !caption || !dotsRow || !progress) return;

  var idx = 0;

  // Hide / show the missing-clip overlay
  video.addEventListener('loadeddata', function(){ if (errorBox) errorBox.style.display = 'none'; });
  video.addEventListener('error', function(){
    if (errorBox && errorPath) {
      errorPath.textContent = clips[idx].url;
      errorBox.style.display = 'flex';
    }
  });

  function set(i) {
    idx = ((i % clips.length) + clips.length) % clips.length;
    var c = clips[idx];
    var num = (idx + 1).toString().padStart(2, '0');
    var total = clips.length.toString().padStart(2, '0');

    video.src = c.url;
    video.load();
    var p = video.play();
    if (p && typeof p.catch === 'function') p.catch(function(){});

    caption.innerHTML =
      '<div class="motion-caption-eyebrow">' + num + ' / ' + total + ' &middot; ' + c.tag + '</div>' +
      '<div class="motion-caption-title">' + c.title + '</div>';

    dotsRow.querySelectorAll('button').forEach(function(b, n) {
      b.classList.toggle('active', n === idx);
      b.setAttribute('aria-selected', n === idx ? 'true' : 'false');
    });

    progress.style.width = '0%';
  }

  // Build the labeled dot row — NN · TAG (matches Illuminator)
  dotsRow.innerHTML = clips.map(function(c, n) {
    var num = (n + 1).toString().padStart(2, '0');
    return '<button type="button" data-i="' + n + '" role="tab"' +
           (n === 0 ? ' class="active" aria-selected="true"' : ' aria-selected="false"') +
           '>' + num + ' &middot; ' + c.tag + '</button>';
  }).join('');
  dotsRow.querySelectorAll('button').forEach(function(b) {
    b.addEventListener('click', function(){ set(parseInt(b.dataset.i, 10)); });
  });

  // Progress bar tracks the video timeline, not a wallclock — accurate to the frame
  video.addEventListener('timeupdate', function(){
    if (video.duration) {
      progress.style.width = (100 * video.currentTime / video.duration) + '%';
    }
  });

  // Auto-advance when the current clip finishes
  video.addEventListener('ended', function(){ set(idx + 1); });

  set(0);
})();
</script>


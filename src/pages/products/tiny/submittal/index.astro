<script>
(function() {
  // --- CFG-SUB-1: Catalog-number edit sync ---
  document.querySelectorAll('#catNum, #catNum2, #catNum3, #liveSku').forEach(function(el) {
    el.addEventListener('input', function() {
      var val = this.textContent.trim();
      ['catNum','catNum2','catNum3','liveSku','piCatNum'].forEach(function(id) {
        var t = document.getElementById(id);
        if (t && t !== el) t.textContent = val;
      });
    });
  });

  // --- URL PARAM POPULATION ---
  var params  = new URLSearchParams(window.location.search);
  var sku     = params.get('sku')     || 'LLHB150-UT50';
  var model   = params.get('model')   || '150';
  var voltage = params.get('voltage') || 'UT';
  var taa     = params.get('taa')     === '1';

  // Photometric data per model (from Tiny PDP + LM-79 IES bundle 2026-05-27)
  var photoData = {
    '085': { lumens: '11,985 lm', peak: '5,229 cd', eff: '141 lm/W', polar: 'polar_085_ut', ies: 'LLHB150-UT50.ies (shared optic · scaled @ 85W)' },
    '150': { lumens: '20,186 lm', peak: '9,494 cd',  eff: '138 lm/W', polar: 'polar_150_ut', ies: 'LLHB150-UT50.ies' },
    '220': { lumens: '31,894 lm', peak: '14,739 cd', eff: '147 lm/W', polar: 'polar_220_ut', ies: 'LLHB220-UT50.ies' }
  };
  var pd = photoData[model] || photoData['150'];

  var skuLive = sku + (taa ? '/TAA' : '');
  document.querySelectorAll('#catNum, #catNum2, #catNum3, #liveSku').forEach(function(el) { el.textContent = skuLive; });
  document.getElementById('piCatNum').textContent = skuLive;

  var lumensMap = { '085': '11,985', '150': '21,150', '220': '30,800' };
  var wattsMap  = { '085': '85', '150': '150', '220': '220' };
  document.getElementById('qsLumens').innerHTML = (lumensMap[model] || '21,150') + '<span class="qs-unit">lm</span>';
  document.getElementById('qsWatts').innerHTML  = (wattsMap[model] || '150') + '<span class="qs-unit">W</span>';
  document.getElementById('qsVoltage').innerHTML = (voltage === 'HT' ? '277-480' : '120-277') + '<span class="qs-unit">V</span>';

  document.getElementById('ocWatts').textContent = model;
  document.getElementById('ocVolt').textContent  = voltage === 'HT' ? 'HT' : 'UT';
  document.getElementById('ocOpts').textContent  = taa ? 'TAA' : '—';
  if (taa) document.getElementById('taaBadge').style.display = 'inline-block';

  document.getElementById('photoEyebrow').textContent = 'LLHB' + model + ' · 5000K · 90×90° wide-beam';
  document.getElementById('photoPolarImg').src = '/products/tiny/tiny/photometrics/' + pd.polar + '.svg?v=2026-05-27';
  document.getElementById('photoPeak').textContent   = pd.peak;
  document.getElementById('photoLumens').textContent = pd.lumens;
  document.getElementById('photoEff').textContent    = pd.eff;
  document.getElementById('photoIesFile').textContent = pd.ies;

  var d = new Date();
  var dateStr = d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' });
  var revStr  = d.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit' }).replace('/', '-');
  document.getElementById('liveDate').textContent = dateStr;
  ['revDate','revDate2','revDate3'].forEach(function(id) { document.getElementById(id).textContent = revStr; });
})();
</script>
</body>
</html>

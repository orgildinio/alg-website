---
/**
 * LLHB · Tiny — Submittal Sheet
 * Route: /products/tiny/submittal/
 *
 * Standalone print-optimized page. No site header/footer.
 * URL params auto-populate the submittal fields.
 * Foundation: canonical_submittal_template per CFG-SUB-1/4.
 * Data source: LLHBTinyDatasheet.pdf (2026-06-02) + Tiny PDP (2026-05-27)
 */
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>LLHB · Tiny — Submittal Sheet</title>
<style>
  @page { size: letter portrait; margin: 0.5in 0.6in; }
  @media print {
    .no-print { display: none !important; }
    body { background: white !important; }
    .page { box-shadow: none !important; margin: 0 !important; page-break-after: always; }
    .page:last-of-type { page-break-after: auto; }
  }
  :root { --brand-red: #F32740; --ink: #0E0E10; --ink-2: #2A2A2D; --muted: #6B6B70; --rule: #D8D6D2; --rule-strong: #A6A4A0; --tint: #F6F4F0; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; font-family: 'Lato', -apple-system, BlinkMacSystemFont, system-ui, Helvetica, Arial, sans-serif; color: var(--ink); font-size: 9.5pt; line-height: 1.4; background: #E8E6E2; }
  body { padding: 24px 12px; overflow-x: hidden; }
  img { max-width: 100%; height: auto; }
  .page { width: 8.5in; min-height: 11in; margin: 0 auto 24px; padding: 0.55in 0.65in; background: white; box-shadow: 0 6px 28px rgba(0,0,0,0.08); position: relative; }
  h1, h2, h3, h4 { font-family: 'Lato', sans-serif; font-weight: 700; margin: 0; line-height: 1.15; }
  .submittal-head { display: flex; align-items: flex-end; justify-content: space-between; border-bottom: 2px solid var(--ink); padding-bottom: 8px; margin-bottom: 14px; }
  .submittal-head .brand { display: flex; align-items: center; gap: 10px; }
  .submittal-head .brand-mark { width: 28px; height: 28px; background: var(--brand-red); display: inline-block; }
  .submittal-head .brand-name { font-size: 13pt; font-weight: 700; letter-spacing: 0.4pt; line-height: 1; }
  .submittal-head .brand-sub { font-size: 7.5pt; letter-spacing: 1.5pt; color: var(--muted); text-transform: uppercase; }
  .submittal-head .catalog-block { text-align: right; }
  .submittal-head .catalog-eyebrow { font-size: 7pt; letter-spacing: 1.5pt; color: var(--muted); text-transform: uppercase; margin-bottom: 2px; }
  .submittal-head .catalog-number { font-size: 12pt; font-weight: 700; font-family: 'JetBrains Mono', monospace; border: 1.5px solid var(--ink); padding: 4px 10px; display: inline-block; letter-spacing: 0.5pt; }
  .project-info { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border: 1px solid var(--rule-strong); margin-bottom: 14px; }
  .pi-cell { padding: 6px 9px; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); min-height: 38px; }
  .pi-cell:nth-child(3n) { border-right: none; }
  .pi-cell:nth-child(n+4) { border-bottom: none; }
  .pi-label { font-size: 7pt; letter-spacing: 1.2pt; color: var(--muted); text-transform: uppercase; margin-bottom: 4px; }
  .pi-value { border-bottom: 1px dotted var(--rule-strong); min-height: 14px; padding-top: 2px; }
  .product-title { margin: 14px 0 14px; }
  .product-title h1 { font-size: 22pt; line-height: 1; margin: 0; }
  .product-title .tagline { font-size: 10pt; color: var(--ink-2); margin-top: 4px; line-height: 1.3; }
  .at-a-glance { display: grid; grid-template-columns: 1.1fr 1fr; gap: 16px; margin-bottom: 12px; }
  .hero-img { background: var(--tint); border: 1px solid var(--rule); aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .hero-img img { width: 100%; height: 100%; object-fit: contain; }
  .qs-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .qs-cell { border: 1px solid var(--rule-strong); padding: 8px 10px; min-height: 56px; }
  .qs-label { font-size: 7pt; letter-spacing: 1.2pt; color: var(--muted); text-transform: uppercase; margin-bottom: 3px; }
  .qs-value { font-size: 14pt; font-weight: 700; line-height: 1.05; }
  .qs-unit { font-size: 8pt; font-weight: 400; color: var(--muted); margin-left: 2px; }
  .feature-band { background: var(--ink); color: white; padding: 8px 14px; display: flex; gap: 18px; align-items: center; margin-bottom: 12px; }
  .feature-band .fb-pill { background: var(--brand-red); color: white; font-size: 7pt; font-weight: 700; letter-spacing: 1.2pt; padding: 3px 7px; text-transform: uppercase; white-space: nowrap; }
  .feature-band .fb-features { font-size: 9pt; line-height: 1.3; }
  .approval-block { display: grid; grid-template-columns: 2fr 1fr; gap: 16px; margin-top: 12px; }
  .approval-cell { border: 1px solid var(--rule-strong); padding: 8px 12px; min-height: 48px; }
  .approval-label { font-size: 7pt; letter-spacing: 1.2pt; color: var(--muted); text-transform: uppercase; margin-bottom: 4px; }
  .approval-line { border-bottom: 1px solid var(--rule-strong); min-height: 20px; }
  .tier-badge { display: inline-block; background: var(--brand-red); color: white; font-size: 7pt; font-weight: 700; letter-spacing: 1.5pt; padding: 3px 8px; text-transform: uppercase; margin-top: 8px; }
  .page-foot { display: flex; justify-content: space-between; font-size: 7.5pt; color: var(--muted); border-top: 1px solid var(--rule); padding-top: 6px; margin-top: 16px; }
  .section-head { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1.5px solid var(--ink); padding-bottom: 4px; margin: 18px 0 10px; }
  .section-head h2 { font-size: 13pt; }
  .section-eyebrow { font-size: 7pt; letter-spacing: 1.5pt; color: var(--muted); text-transform: uppercase; }
  .spec-table { width: 100%; border-collapse: collapse; font-size: 8.5pt; }
  .spec-table td { padding: 4px 8px; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .spec-table .spec-attr { color: var(--muted); width: 32%; font-weight: 600; }
  .spec-table .spec-section-head td { background: var(--tint); font-weight: 700; font-size: 8pt; letter-spacing: 0.8pt; text-transform: uppercase; color: var(--ink-2); padding: 5px 8px; }
  .photo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 12px; }
  .photo-polar { background: var(--tint); border: 1px solid var(--rule); aspect-ratio: 1; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .photo-polar img { width: 100%; height: 100%; object-fit: contain; }
  .photo-summary table { width: 100%; font-size: 8.5pt; border-collapse: collapse; }
  .photo-summary td { padding: 5px 8px; border-bottom: 1px solid var(--rule); }
  .photo-summary td:first-child { color: var(--muted); font-weight: 600; width: 50%; }
  .order-code { display: flex; gap: 0; margin: 12px 0; border: 1px solid var(--rule-strong); }
  .order-segment { flex: 1; padding: 8px 6px; border-right: 1px solid var(--rule); text-align: center; }
  .order-segment:last-child { border-right: none; }
  .order-seg-label { font-size: 6.5pt; letter-spacing: 1pt; color: var(--muted); text-transform: uppercase; margin-bottom: 4px; }
  .order-seg-value { font-size: 11pt; font-weight: 700; font-family: 'JetBrains Mono', monospace; }
  .order-matrix { width: 100%; border-collapse: collapse; font-size: 8.5pt; margin-top: 10px; }
  .order-matrix th { background: var(--tint); padding: 5px 8px; border-bottom: 2px solid var(--rule-strong); text-align: left; font-size: 8pt; letter-spacing: 0.5pt; }
  .order-matrix td { padding: 4px 8px; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .order-matrix td.code { font-family: 'JetBrains Mono', monospace; font-size: 8pt; font-weight: 700; color: var(--ink-2); width: 22%; }
  .certs { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .cert-badge { border: 1px solid var(--rule-strong); font-size: 7.5pt; font-weight: 700; padding: 4px 8px; letter-spacing: 0.5pt; text-transform: uppercase; }
  .cert-badge.brand { background: var(--ink); color: white; border-color: var(--ink); }
  .controls { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; background: var(--tint); border-bottom: 1px solid var(--rule); padding: 10px 16px; }
  .controls .ctrl-label { font-size: 9pt; font-weight: 600; color: var(--muted); letter-spacing: 0.5pt; text-transform: uppercase; }
  .controls .ctrl-value { font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 11pt; }
  .controls button { background: var(--brand-red); color: white; border: none; padding: 8px 16px; font-family: inherit; font-weight: 700; font-size: 9pt; letter-spacing: 0.5pt; text-transform: uppercase; cursor: pointer; margin-left: auto; }
  .controls button:hover { background: #d61f37; }
</style>
</head>

---
/**
 * luxmark PDP — planoⒶRCH · Astro wrapper
 * Route: /products/luxmark/
 * SEV-0 CSS restoration: extracts <style> blocks + font links from source <head>
 * and re-emits them via BaseLayout head slot. Body content wrapped in
 * <div class="luxmark-pdp"> so CSS selectors like body.luxmark-pdp .hero-h1 resolve.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';

const publicHtml = readFileSync(
  path.join(process.cwd(), 'public/products/luxmark/index.html'),
  'utf-8'
);

// Extract body content
const bodyMatch = publicHtml.match(/<body[^>]*>([\s\S]*)<\/body>/i);
const rawBodyContent = bodyMatch ? bodyMatch[1] : publicHtml;
// Defensive sanitizer: strip any .closing-cta-strip div that leaked in from the mockup
const bodyContent = rawBodyContent.replace(
  /(?:[ \t]*<!--[^>]*Final red CTA strip[^>]*-->\s*\n)?[ \t]*<div\s+class="closing-cta-strip"[^>]*>[\s\S]*?<\/div>\s*<\/div>\s*\n/g,
  ''
);

// Extract all <style> blocks from <head>
const headMatch = publicHtml.match(/<head[^>]*>([\s\S]*?)<\/head>/i);
const headContent = headMatch ? headMatch[1] : '';
const styleBlocks = [...headContent.matchAll(/<style[^>]*>[\s\S]*?<\/style>/gi)]
  .map(m => m[0]).join('\n');

// Extract Google Fonts link tags
const fontLinks = [...headContent.matchAll(/<link[^>]*fonts\.googleapis\.com[^>]*>/gi)]
  .map(m => m[0]).join('\n');
const fontPreconnects = [...headContent.matchAll(/<link[^>]*rel="preconnect"[^>]*>/gi)]
  .map(m => m[0]).join('\n');
---
<BaseLayout
  title="LPVT · Luxmark — Archipelago Lighting Group"
  description="LPVT Luxmark · planoⒶRCH PRO+ · Commercial Track Head · 3 sizes · DLC Premium · CRI 90+."
  bodyClass="planoarch-pdp luxmark-pdp"
>
  <Fragment slot="head">
      <script type="application/ld+json">
    {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.archipelagolighting.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Products",
      "item": "https://www.archipelagolighting.com/products/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "INDOOR",
      "item": "https://www.archipelagolighting.com/collections/indoor/"
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": "PLANO\u24b6RCH",
      "item": "https://www.archipelagolighting.com/collections/planoarch/"
    },
    {
      "@type": "ListItem",
      "position": 5,
      "name": "LPVT \u00b7 Luxmark",
      "item": "https://www.archipelagolighting.com/products/luxmark/"
    }
  ]
}
    </script>

    <Fragment set:html={fontPreconnects} />
    <Fragment set:html={fontLinks} />
    <Fragment set:html={styleBlocks} />
  </Fragment>
  <div class="luxmark-pdp">
    <Fragment set:html={bodyContent} />
  </div>
</BaseLayout>

          state[field] = val;
        }
        // Class pick · auto-default Voltage/Optic/TAA and invalidate accessories that don't match
        if (field === 'wattage') {
          // Reset Voltage if invalid for new class
          if (!ALLOWED_VOLTAGE[val] || !ALLOWED_VOLTAGE[val][state.voltage]) state.voltage = 'UT';
          // Reset Optic if invalid
          var voKey = val + '-' + state.voltage;
          if (!ALLOWED_OPTIC[voKey] || !ALLOWED_OPTIC[voKey][state.optic]) state.optic = 'O9090';
          if (state.taa == null) state.taa = 'STD';
          // Clear class-specific accessories that no longer apply (155-only/320-only/400-only adders)
          ['opticAcc', 'hvd', 'wg'].forEach(function(k) {
            if (val === '500' || val === '600') delete state[k];
          });
        }
        // Voltage pick · invalidate Optic + TAA if not compatible
        if (field === 'voltage') {
          var voKey2 = (state.wattage || '155') + '-' + val;
          if (!ALLOWED_OPTIC[voKey2] || !ALLOWED_OPTIC[voKey2][state.optic]) state.optic = 'O9090';
          if (state.wattage === '600' && val === 'HT') state.voltage = 'UT';  // 600W has no HT
        }
        // Optic pick · invalidate TAA if non-O9090 (no TAA SKUs for O4090/O6565)
        if (field === 'optic' && val !== 'O9090' && state.taa === 'TAA') state.taa = 'STD';
        // TAA pick · invalidate if Optic is non-O9090 (auto-revert silently to STD)
        if (field === 'taa' && val === 'TAA' && state.optic !== 'O9090') state.taa = 'STD';
        applyState();
      });
    });

    // ---- Reset all ----
    resetBtn.addEventListener('click', function() {
      state = Object.assign({}, DEFAULT_STATE);
      applyState();
    });

    // ---- Apply state to UI ----
    function applyState() {
      // CFG-CFG-1 v1.7 · sync body[data-form] for data-form-show CSS to swap accessory rows per class
      document.body.dataset.form = state.wattage || '';

      chips.forEach(function(chip) {
        var f = chip.dataset.field;
        var v = chip.dataset.val;
        chip.classList.toggle('selected', state[f] === v);

        // Constraint-driven disabling per ALLOWED matrix
        var disabled = false;
        if (f === 'voltage' && state.wattage) {
          disabled = !(ALLOWED_VOLTAGE[state.wattage] && ALLOWED_VOLTAGE[state.wattage][v]);
        } else if (f === 'optic' && state.wattage && state.voltage) {
          var voKey = state.wattage + '-' + state.voltage;
          disabled = !(ALLOWED_OPTIC[voKey] && ALLOWED_OPTIC[voKey][v]);
        } else if (f === 'taa' && v === 'TAA' && state.optic && state.optic !== 'O9090') {
          disabled = true;   // TAA only with O9090
        } else if (f === 'taa' && v === 'TAA' && state.wattage === '600' && state.voltage === 'HT') {
          disabled = true;   // 600W HT has no TAA (and no HT either)
        }
        chip.classList.toggle('disabled', disabled);
        chip.style.opacity = disabled ? '0.30' : '';
        chip.style.cursor  = disabled ? 'not-allowed' : '';
      });

      var filled = REQUIRED.filter(function(k) { return state[k] != null; }).length;
      counter.textContent = filled;
      counterEl.classList.toggle('complete', filled === REQUIRED.length);

      var complete = (filled === REQUIRED.length);
      renderSKU(complete);
      warning.classList.toggle('show', !complete);
      ctaPdf.classList.toggle('disabled', !complete);
      ctaPrice.classList.toggle('disabled', !complete);
      copyBtn.disabled = !complete;
      copyBtn.classList.remove('copied');
      copyLabel.textContent = 'Copy SKU';

      renderSpecs();
      renderPreviewImage();
    }

    // ---- Live Preview image swap · per wattage class ----
    // 155W → small-housing photo (TITAN-85-155W-1) · 320/400/500/600W → big-housing photo (TITAN-160-215W-3)
    var PREVIEW_PHOTO_MAP = {
      '155': 'titan/photos/TITAN-85-155W-1_nobg.png',
      '320': 'titan/photos/TITAN-160-215W-3_nobg.png',
      '400': 'titan/photos/TITAN-160-215W-3_nobg.png',
      '500': 'titan/photos/TITAN-160-215W-3_nobg.png',
      '600': 'titan/photos/TITAN-160-215W-3_nobg.png'
    };
    var previewImg = document.getElementById('cfgPreviewImg');
    var lastPreviewSrc = previewImg ? previewImg.getAttribute('src') : null;
    function renderPreviewImage() {
      if (!previewImg) return;
      var newSrc = PREVIEW_PHOTO_MAP[state.wattage] || PREVIEW_PHOTO_MAP['155'];
      if (newSrc !== lastPreviewSrc) {
        previewImg.style.opacity = '0.35';
        previewImg.setAttribute('src', newSrc);
        previewImg.addEventListener('load', function once() {
          previewImg.style.opacity = '1';
          previewImg.removeEventListener('load', once);
        });
        lastPreviewSrc = newSrc;
      }
    }

    // ---- SKU encoder · canonical 2026-05-27 · 20-SKU set + LLHB-T2/* accessory ladder ----
    // Base: LLHB{class}-2CS-{V}T/O{optic}[/TAA]
    // Accessories (sibling LLHB-T2 line · ship as separate line items):
    //   /LLHB-T2/{class}-O{opticAcc}   when opticAcc selected (155/320/400 only)
    //   /LLHB-T2/HVD{class}            when hvd selected (155/320/400 only)
    //   /LLHB-T2/WG{class}             when wg selected (155/320/400 only)
    //   /LLHB-T2/{PDM|SFM|SPM|JBX}     when mount selected (any class)
    //   /LLHB-T2/BSD                    when bsd selected (any class)
    // Canonical Titan SKU syntax (James 2026-05-27):
    //   Required: LLHB{class}-2CS-{voltage}/{optic}[/TAA]
    //     class    = 155/320/400/500/600
    //     voltage  = UT (120-277V) / HT (277-480V)
    //     optic    = O9090 / O4090 / O6565
    //     /TAA     = Trade-Compliance adder (only on /O9090)
    //   Optional accessories (LLHB-T2/*):
    //     LLHB-T2/{class}-{optic}     optic retrofit (155/320/400 only)
    //     LLHB-T2/HVD{class}          high-voltage driver (155/320/400 only)
    //     LLHB-T2/WG{class}           wire guard (155/320/400 only)
    //     LLHB-T2/{PDM|SFM|SPM|JBX}   mount kit (any class)
    //     LLHB-T2/BSD                 bird-spike deterrent (any class)
    function renderSKU(complete) {
      var wattage = state.wattage;
      var voltage = state.voltage;
      var optic   = state.optic || 'O9090';
      var wattHTML = wattage || '<span class="placeholder">[W]</span>';
      var vHTML    = voltage || '<span class="placeholder">[V]</span>';
      var html = 'LLHB' + wattHTML + '-2CS-' + vHTML + '/' + optic;
      if (state.taa === 'TAA') html += '/TAA';
      // Optional LLHB-T2/* accessory line items
      if (wattage && state.opticAcc) html += ' &middot; LLHB-T2/' + wattage + '-' + state.opticAcc;
      if (wattage && state.hvd)      html += ' &middot; LLHB-T2/HVD' + wattage;
      if (wattage && state.wg)       html += ' &middot; LLHB-T2/WG' + wattage;
      if (state.mount)               html += ' &middot; LLHB-T2/' + state.mount;
      if (state.bsd)                 html += ' &middot; LLHB-T2/BSD';
      skuEl.innerHTML = html;
    }
    function placeholderFor(k) {
      return ({
        wattage: '[W]',
        voltage: '[V]',
        em:      '[EM]',
        sensor:  '[SEN]',
        wg:      '[WG]',
        mount:   '[MNT]',
        optic:   '[OPT]',
        taa:     '[TAA]'
      })[k] || '[' + k.toUpperCase() + ']';
    }

    // ---- EM constraint logic — 20W EM only allowed under 200W class, 60W EM only over ----
    function applyConstraints() {
      var w = state.wattage;
      chips.forEach(function(chip) {
        var f = chip.dataset.field;
        var v = chip.dataset.val;
        if (f === 'em') {
          var allowed = true;
          if (v === 'EM20' && w === '320') allowed = false;
          if (v === 'EM20' && w === '400') allowed = false;
          if (v === 'EM60' && w === '155') allowed = false;
          chip.classList.toggle('disabled', !allowed);
          chip.setAttribute('aria-disabled', !allowed ? 'true' : 'false');
          // If currently selected EM is now disallowed, clear it
          if (!allowed && state.em === v) delete state.em;
        }
      });
    }

    // ---- Live spec readout ----
    function renderSpecs() {
      setSpec('lumens',  state.wattage ? SPEC.wattage[state.wattage].lumens : null);
      setSpec('lpw',     state.wattage ? SPEC.wattage[state.wattage].lpw    : null);
      setSpec('voltage', state.voltage ? SPEC.voltage[state.voltage]        : null);
      // Optic readout updates with field-swap chip
      var opticTxt = SPEC.optic;
      if (state.optic === 'O35') opticTxt = '35° Narrow · field-swap accessory';
      if (state.optic === 'O65') opticTxt = '65° Medium · field-swap accessory';
      setSpec('optic',   opticTxt);
      setSpec('peak',    state.wattage ? SPEC.peak[state.wattage] : null);

      // Compliance auto-updates with TAA selection
      var compliance = 'DLC Premium &middot; cULus &middot; 6 kVA Surge';
      if (state.taa === 'TAA') compliance += ' · TAA Compliant';
      setSpec('compliance', compliance);
    }
    function setSpec(name, val) {
      var el = section.querySelector('[data-spec="' + name + '"]');
      if (!el) return;
      // CCT and CRI are static — never overwrite them with placeholder
      if (name === 'cct' || name === 'cri' || (name === 'compliance' && val == null)) return;
      if (val == null || val === '—') {
        el.textContent = '—';
        el.classList.add('placeholder');
      } else {
        // Use innerHTML for compliance (contains entities)
        if (name === 'compliance') el.innerHTML = val;
        else el.textContent = val;
        el.classList.remove('placeholder');
      }
    }

    // ---- Copy SKU ----
    copyBtn.addEventListener('click', function() {
      if (copyBtn.disabled) return;
      var txt = skuEl.textContent.trim();
      if (!txt) return;
      var done = function() {
        copyBtn.classList.add('copied');
        copyLabel.textContent = 'Copied ✓';
        setTimeout(function() {
          copyBtn.classList.remove('copied');
          copyLabel.textContent = 'Copy SKU';
        }, 1800);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(txt).then(done, done);
      } else {
        var ta = document.createElement('textarea');
        ta.value = txt;
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch(e){}
        document.body.removeChild(ta);
        done();
      }
    });

    // ---- Submittal PDF — opens submittal/?... in new tab ----
    // CFG-QA-1 contract: canonical &wattage= (never &watt= or &model=).
    function buildSubmittalUrl() {
      // strip accessory tail (everything after first " · ") from SKU
      var sku = skuEl.textContent.trim().split(/\s+&middot;\s+|\s+·\s+/)[0];
      var params = new URLSearchParams({
        sku:      sku,
        family:   'titan',
        wattage:  state.wattage  || '155',
        voltage:  state.voltage  || 'UT',
        optic:    state.optic    || 'O9090',
        taa:      state.taa === 'TAA' ? 'TAA' : '0',
        opticAcc: state.opticAcc || '',
        hvd:      state.hvd      || '',
        wg:       state.wg       || '',
        mount:    state.mount    || '',
        bsd:      state.bsd      || ''
      });
      return 'submittal/?' + params.toString();
    }
    ctaPdf.addEventListener('click', function(e) {
      if (ctaPdf.classList.contains('disabled')) { e.preventDefault(); return; }
      ctaPdf.setAttribute('href', buildSubmittalUrl());
    });

    // Initial render
    applyState();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();

// (Legacy Illuminator motion-carousel IIFE removed — Titan's 4-slide motion
//  player lives inline with Section 3 above, sourcing the production mp4s spliced
//  from "LLHB - JUPITER PromoVideo_NoText.mp4" via splice_jupiter_video.sh)

// CFG-STATE-1 — derive ship-tier (QS / WB / MTO) from selected chip badges, render
// canonical 3-state status panel. Self-contained module · no dependency on the
// configurator's state object · re-derives by walking selected chips on every click.
// Custom RAL (finish chip) with a valid 4-digit input forces MTO.
(function() {
  function deriveShipTier() {
    var section = document.getElementById('configurator');
    if (!section) return 'QS';
    var chips = section.querySelectorAll('.cfg-chip.selected, .cfg-chip[aria-pressed="true"]');
    var worst = 'QS';
    var sawCustomRal = false;
    var activeForm = document.body.dataset.form || '';
    chips.forEach(function(chip) {
      // CFG-CFG-1 v1.7 · hidden-row filter — skip chips inside data-form-show rows
      // that don't match the current active wattage class (prevents auto-default
      // WATTSELECT chips on hidden rows from over-escalating the tier).
      var row = chip.closest('.cfg-row[data-form-show]');
      if (row && activeForm) {
        var allowed = row.getAttribute('data-form-show').split(/\s+/);
        if (allowed.indexOf(activeForm) === -1) return;
      }
      if (chip.dataset.field === 'finish' && chip.dataset.val === 'RAL') sawCustomRal = true;
      // CFG-CFG-1: stock state moved from .cfg-chip-stock text → .cfg-chip-stripe.
      // Check both selectors for back-compat during the transition.
      if (chip.querySelector('.cfg-chip-stripe.mto') || chip.querySelector('.cfg-chip-stock.mto')) worst = 'MTO';
      else if ((chip.querySelector('.cfg-chip-stripe.wb') || chip.querySelector('.cfg-chip-stock.wb')) && worst !== 'MTO') worst = 'WB';
    });
    if (sawCustomRal) {
      var input = document.getElementById('cfgRalInput');
      if (input && input.value && /^[0-9]{4}$/.test(input.value)) return 'MTO';
    }
    return worst;
  }
  function refreshShipTier() {
    var tier = deriveShipTier();
    var rowEl = document.getElementById('cfgShipTier');
    var iconEl = document.getElementById('cfgShipTierIcon');
    var textEl = document.getElementById('cfgShipTierText');
    var stockEl = document.getElementById('cfgShipTierStock');
    if (!rowEl || !iconEl || !textEl || !stockEl) return;
    if (tier === 'QS') {
      rowEl.style.background = 'rgba(95,199,122,0.08)';
      rowEl.style.border = '1px solid rgba(95,199,122,0.40)';
      iconEl.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#7fc998" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
      textEl.innerHTML = '<strong style="color:#9bd6b1;">QuickShip · à-la-carte assembly</strong> · <span style="color:var(--text-secondary);">All selected components in stock — ships 3-5 day.</span>';
      stockEl.textContent = 'QuickShip · 3-5 day';
      stockEl.style.color = '#9bd6b1';
    } else if (tier === 'WB') {
      rowEl.style.background = 'rgba(96,168,255,0.08)';
      rowEl.style.border = '1px solid rgba(96,168,255,0.40)';
      iconEl.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#7fb6ff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>';
      textEl.innerHTML = '<strong style="color:#a8c9ff;">Workbench Assembly · ~1-3 wk</strong> · <span style="color:var(--text-secondary);">One or more selected components are workbench-assembled to order.</span>';
      stockEl.textContent = 'WB · ~1-3 wk';
      stockEl.style.color = '#a8c9ff';
    } else {
      rowEl.style.background = 'rgba(255,159,28,0.08)';
      rowEl.style.border = '1px solid rgba(255,159,28,0.40)';
      iconEl.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#ffb14d" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
      textEl.innerHTML = '<strong style="color:#ffb14d;">Custom build · Made-to-Order · ~4-6 wk</strong> · <span style="color:var(--text-secondary);">One or more selected components are MTO (custom finish, MTO option, or non-stocked variant).</span>';
      stockEl.textContent = 'MTO · ~4-6 wk';
      stockEl.style.color = '#ffb14d';
    }
  }
  function init() {
    var section = document.getElementById('configurator');
    if (!section) return;
    section.addEventListener('click', function(e) {
      if (e.target.closest('.cfg-chip')) setTimeout(refreshShipTier, 50);
    });
    var ralInput = document.getElementById('cfgRalInput');
    if (ralInput) ralInput.addEventListener('input', function() { setTimeout(refreshShipTier, 50); });
    refreshShipTier();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
// CFG-CFG-1 · syncRowCodes — update per-row .cfg-row-code based on selected chip.
// Mirrors the canonical Liberty pattern. Self-contained · no dependency on the
// configurator's state object · walks selected chips on every chip click.
(function() {
  function syncRowCodes() {
    document.querySelectorAll('.cfg-row-code[data-field-code]').forEach(function(rc) {
      var field = rc.getAttribute('data-field-code');
      if (field === 'cct') return; // locked-default text stays
      var newText = '—', isEmpty = true;
      var selChip = document.querySelector('.cfg-chip.selected[data-field="' + field + '"]');
      if (selChip) {
        var code = selChip.getAttribute('data-code') || '';
        var slashPrefixed = ['mount','optic','photocell','sensor','shield','surge','taa','em','wg','adapter'];
        var alreadySlash = code.charAt(0) === '/';
        if (code) {
          newText = (slashPrefixed.indexOf(field) >= 0 && !alreadySlash) ? '/' + code : code;
          isEmpty = false;
        } else if (field === 'taa') {
          newText = '(blank)'; isEmpty = false;
        } else if (field === 'mount') {
          newText = '(none)'; isEmpty = false;
        }
      }
      rc.textContent = newText;
      rc.classList.toggle('is-empty', isEmpty);
    });
  }
  function init() {
    var section = document.getElementById('configurator');
    if (!section) return;
    section.addEventListener('click', function(e) {
      if (e.target.closest('.cfg-chip')) setTimeout(syncRowCodes, 60);
    });
    syncRowCodes();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();


</script>


<script is:inline>
/* =============================================================================
   CFG-NAV-1 · Sticky-nav scroll-spy
   ----------------------------------------------------------------------------
   IntersectionObserver watches each section the sticky-nav links to. The link
   whose target is "most visible" gets `.is-current` (white bg + red text · the
   visual inverse of `.primary`). One observer, one Map, one CSS class toggle.
   The Pricing & Availability primary button is NOT a section anchor (its href
   is /pricing-availability/), so it's excluded from the spy by the
   `a[href^="#"]` selector below.
   ============================================================================= */
(function() {
  var nav = document.querySelector('.sticky-nav');
  if (!nav) return;
  var links = Array.prototype.slice.call(nav.querySelectorAll('a[href^="#"]'));
  if (!links.length) return;
  var entries = [];
  links.forEach(function(a) {
    var id = a.getAttribute('href').slice(1);
    var sec = id ? document.getElementById(id) : null;
    if (sec) entries.push({ sec: sec, link: a, ratio: 0 });
  });
  if (!entries.length) return;
  function update() {
    var best = null, bestRatio = 0;
    entries.forEach(function(e) { if (e.ratio > bestRatio) { bestRatio = e.ratio; best = e; } });
    entries.forEach(function(e) { e.link.classList.toggle('is-current', e === best && bestRatio > 0); });
  }
  var io = new IntersectionObserver(function(items) {
    items.forEach(function(item) {
      entries.forEach(function(e) { if (e.sec === item.target) e.ratio = item.intersectionRatio; });
    });
    update();
  }, {
    rootMargin: '-20% 0px -55% 0px',
    threshold: [0, 0.1, 0.25, 0.5, 0.75, 1.0]
  });
  entries.forEach(function(e) { io.observe(e.sec); });
})();
</script>


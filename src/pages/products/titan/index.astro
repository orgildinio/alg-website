        </div>
        <!-- CFG-CFG-1 v1.4 · Legend disclaimer -->
        <div class="cfg-disclaimer">
          Estimates &middot; not guarantees &middot; subject to availability &middot; confirm before committing.
        </div>

      </div>
    </div>


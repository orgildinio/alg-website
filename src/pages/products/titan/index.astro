<!-- Section 6 photometrics — Titan 3-class × 2-CCT IES-rendered polar plot driver (LM-63 bundle).
     Source: TITAN.zip · BACL/EVERFINE test reports 2023-2025. Per-(class, CCT) max-wattage cells:
       155W class · 5000K → LLHB155_155W_5000K-120V.IES   (peak 12,278 cd · 23,848 lm · 152 lm/W)
       155W class · 4000K → LLHB155_155W_4000K-120V.ies   (peak 12,035 cd · 23,320 lm · 153 lm/W)
       320W class · 5000K → LLHB320_320W_5000K-120V.IES   (peak 23,248 cd · 48,897 lm · 150 lm/W)
       320W class · 4000K → LLHB320_320W_4000K-120V.ies   (peak 25,524 cd · 48,926 lm · 155 lm/W)
       400W class · 5000K → LLHB400W-120V-5K-90X90.IES    (peak 27,431 cd · 59,764 lm · 150 lm/W)
       400W class · 4000K → LLHB400W-120V-4K-90X90.IES    (peak 26,668 cd · 57,685 lm · 149 lm/W) -->
<script is:inline>
(function(){
  var data = {
    '155_5000': { peak: '12,278 cd', lumens: '23,848 lm', watts: '157W', lpw: '152 lm/W', ies: 'LLHB155_155W_5000K-120V.IES' },
    '155_4000': { peak: '12,035 cd', lumens: '23,320 lm', watts: '153W', lpw: '153 lm/W', ies: 'LLHB155_155W_4000K-120V.ies' },
    '320_5000': { peak: '23,248 cd', lumens: '48,897 lm', watts: '326W', lpw: '150 lm/W', ies: 'LLHB320_320W_5000K-120V.IES' },
    '320_4000': { peak: '25,524 cd', lumens: '48,926 lm', watts: '316W', lpw: '155 lm/W', ies: 'LLHB320_320W_4000K-120V.ies' },
    '400_5000': { peak: '27,431 cd', lumens: '59,764 lm', watts: '399W', lpw: '150 lm/W', ies: 'LLHB400W-120V-5K-90X90.IES' },
    '400_4000': { peak: '26,668 cd', lumens: '57,685 lm', watts: '388W', lpw: '149 lm/W', ies: 'LLHB400W-120V-4K-90X90.IES' }
  };

  var modelTabs = document.querySelectorAll('.photo-tab[data-model]');
  var cctTabs   = document.querySelectorAll('.photo-tab[data-cct]');
  var statPeak  = document.getElementById('photoStatPeak');
  var statLum   = document.getElementById('photoStatLumens');
  var statFile  = document.getElementById('photoStatFile');
  var plotImg   = document.getElementById('photoPlotImg');
  var dl        = document.getElementById('photoIesDownload');

  var state = { model: '155', cct: '5000' };

  function render(){
    var key = state.model + '_' + state.cct;
    var d = data[key];
    if (d) {
      if (statPeak) statPeak.textContent = d.peak;
      if (statLum)  statLum.textContent  = d.lumens + ' (@ ' + d.watts + ' · ' + d.lpw + ')';
      if (statFile) statFile.textContent = d.ies;
      if (plotImg)  plotImg.setAttribute('src', 'titan/photometrics/polar_' + key + '.svg?v=2026-05-27');
      // IES bundle is now LIVE — unlock the download link state
      if (dl) {
        dl.classList.remove('is-pending');
        dl.removeAttribute('aria-disabled');
        dl.setAttribute('href', 'titan/photometrics/' + d.ies);
        if (dl.lastChild) dl.lastChild.textContent = ' Download IES file';
      }
    }
    modelTabs.forEach(function(t){
      var on = t.dataset.model === state.model;
      t.classList.toggle('active', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    cctTabs.forEach(function(t){
      var on = t.dataset.cct === state.cct;
      t.classList.toggle('active', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
    });
  }

  modelTabs.forEach(function(t){
    t.addEventListener('click', function(){ state.model = t.dataset.model; render(); });
  });
  cctTabs.forEach(function(t){
    t.addEventListener('click', function(){ state.cct = t.dataset.cct; render(); });
  });

  render();
})();
</script>


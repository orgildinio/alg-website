    overflow: hidden;
  }
  .cfg-ral-input-prefix {
    display: inline-flex;
    align-items: center;
    padding: 0 10px;
    background: rgba(255,255,255,0.04);
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;

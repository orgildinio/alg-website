<!-- Section 3 motion-player driver — Titan (4-clip rotation · spliced from PromoVideo_NoText.mp4)
     Mirrors the Illuminator canonical pattern: clips[] uses {url, tag, title};
     dot buttons render as labeled chips (NN · TAG); caption is two-line
     (eyebrow numero + tag, then narrative title). Each clip is 9s exact,
     so we sync the progress bar to video.currentTime and auto-advance on
     video.ended (cleaner than a wallclock ticker for video-driven progress). -->
<script is:inline>
(function(){
  // 4 clips spliced 2026-05-09 from "LLHB - Titan PromoVideo_NoText.mp4" via splice_titan_video.sh.
  // James greenlit all 4 in the frame-strip preflight; specifier-grade, number-led, competitively framed copy.
  var clips = [
    {
      url:   'videos/titan-motion-01-form-factor.mp4',
      tag:   'FORM FACTOR',
      title: 'Compact die-cast linear body across <strong>3 housing classes</strong> &mdash; 14.0&quot; / 22.5&quot; / 27.0&quot; lengths covering all <strong>7 base SKUs</strong> from <strong>LLHB085 to LLHB400</strong>. Stamped aluminum heat sink integral to the chassis; thermally-isolated driver compartment up top. Same engineering language from the 85W ECO bay-light to the 400W industrial flagship.'
    },
    {
      url:   'videos/titan-motion-02-mounting.mp4',
      tag:   'MOUNTING HARDWARE',
      title: '<strong>Two V-hooks plus 6 feet of aircraft cable</strong> ship factory-installed &mdash; suspension-ready out of the carton. Optional pendant kit (LLHB-T2/PDM) and surface kit drop the cable rigging when conduit-mounted or ceiling-tight applications call for it. Wire guards (WG155 / WG320 / WG400) in gymnasium and shop installs.'
    },
    {
      url:   'videos/titan-motion-03-modular.mp4',
      tag:   'MODULAR ACCESSORIES',
      title: 'Field-swappable <strong>35° / 65° / 90° optics</strong>, <strong>Bi-Level (BLS) and NLC sensor</strong> drop-ins, <strong>20W and 60W EM drivers</strong>, and <strong>480V step-down transformer</strong> &mdash; all bolt to the housing in field, no factory rework. Re-aim, re-watt, re-control on-site.'
    },
    {
      url:   'videos/titan-motion-04-thermal.mp4',
      tag:   'THERMAL ISOLATION',
      title: '<strong>Driver compartment thermally isolated</strong> from the LED chamber, with stamped-aluminum heat sink fins channeling waste heat upward and cool air through the body. The result: <strong>L70 &gt;100,000 hours</strong> at -40°F to 140°F operating, with a <strong>7-year / 75,000-hour</strong> warranty &mdash; two years past DLC Premium&rsquo;s minimum.'
    }
  ];

  var video    = document.getElementById('motionVideo');
  var caption  = document.getElementById('motionCaption');
  var dotsRow  = document.getElementById('motionDots');
  var progress = document.getElementById('motionProgressBar');
  var errorBox = document.getElementById('motionError');
  var errorPath = document.getElementById('motionErrorPath');
  if (!video || !caption || !dotsRow || !progress) return;

  var idx = 0;

  // Hide / show the missing-clip overlay
  video.addEventListener('loadeddata', function(){ if (errorBox) errorBox.style.display = 'none'; });
  video.addEventListener('error', function(){
    if (errorBox && errorPath) {
      errorPath.textContent = clips[idx].url;
      errorBox.style.display = 'flex';
    }
  });

  function set(i) {
    idx = ((i % clips.length) + clips.length) % clips.length;
    var c = clips[idx];
    var num = (idx + 1).toString().padStart(2, '0');
    var total = clips.length.toString().padStart(2, '0');

    video.src = c.url;
    video.load();
    var p = video.play();
    if (p && typeof p.catch === 'function') p.catch(function(){});

    caption.innerHTML =
      '<div class="motion-caption-eyebrow">' + num + ' / ' + total + ' &middot; ' + c.tag + '</div>' +
      '<div class="motion-caption-title">' + c.title + '</div>';

    dotsRow.querySelectorAll('button').forEach(function(b, n) {
      b.classList.toggle('active', n === idx);
      b.setAttribute('aria-selected', n === idx ? 'true' : 'false');
    });

    progress.style.width = '0%';
  }

  // Build the labeled dot row — NN · TAG (matches Illuminator)
  dotsRow.innerHTML = clips.map(function(c, n) {
    var num = (n + 1).toString().padStart(2, '0');
    return '<button type="button" data-i="' + n + '" role="tab"' +
           (n === 0 ? ' class="active" aria-selected="true"' : ' aria-selected="false"') +
           '>' + num + ' &middot; ' + c.tag + '</button>';
  }).join('');
  dotsRow.querySelectorAll('button').forEach(function(b) {
    b.addEventListener('click', function(){ set(parseInt(b.dataset.i, 10)); });
  });

  // Progress bar tracks the video timeline, not a wallclock — accurate to the frame
  video.addEventListener('timeupdate', function(){
    if (video.duration) {
      progress.style.width = (100 * video.currentTime / video.duration) + '%';
    }
  });

  // Auto-advance when the current clip finishes
  video.addEventListener('ended', function(){ set(idx + 1); });

  set(0);
})();
</script>


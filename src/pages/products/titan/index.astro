     SKU template (datasheet pg 3 ordering guide · Rebate Center confirmed 2026-05-05):
        LLHB{"{"}CLASS{"}"}-{"{"}CCT{"}"}CS-{"{"}VOLT{"}"}-J2[/TAA]
        — 3CS = 3-CCTSELECT (150/240/300) · 40 / 50 = single-CCT options on 400W only
        — U = 120-277V universal · H = 277-480V high-voltage (400W only) · J2 = Titan series
     Required (3): Wattage Class · Voltage · Finish (Black/White)
     Optional (1): TAA Compliant
     Live readout: lumens · efficacy · peak intensity · voltage · optic · CCT · CRI
     CTAs (Illuminator-canonical): Pricing & Availability, Submittal PDF (submittal_template.html?wattage=…), Request a Layout
     CFG-* compliance:
       CFG-COPY-3  configurators ship at Illuminator density · chip-codes only · no inline callouts
       CFG-QA-1    URL contract uses canonical &wattage= (never &watt= or &model=)
       CFG-5a      cfg-col-legend-floor on the shorter (Optional) column
     ============================================================================ -->
<section class="cfg-section" id="configurator">
  <div class="cfg-inner">

    <div class="cfg-head">
      <div class="cfg-eyebrow">Configurator</div>
      <h2 class="cfg-title">Build Your Titan.</h2>
      <p class="cfg-sub">
        Pick housing class + voltage &mdash; SKU resolves live.
        <small>7 DLC-Premium SKUs &middot; 3 housings &middot; 3-WATTSELECT × 2-CCTSELECT field-toggle &middot; 90&deg; default &middot; 6 optional rows</small>
      </p>
    </div>

    <div class="cfg-counter-band">
      <div class="cfg-counter" id="cfgCounter"><strong id="cfgCount">0</strong> of 4 required selections complete (Class &middot; Voltage &middot; Optic &middot; Compliance)</div>
      <button type="button" class="cfg-reset" id="cfgReset" aria-label="Reset configurator">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
        Reset
      </button>
    </div>

    <!-- Build form · 20 canonical Zoho SKUs across 5 wattage classes (155/320/400/500/600).
         Pattern: LLHB{class}-2CS-{"{"}V{"}"}T/O{optic}[/TAA]
         Constraints (enforced via JS chip disabling):
           - 600W is UT-only (no HT, no LLHB600-2CS-HT SKUs)
           - O4090 and O6565 optics only available on 320W-UT (others O9090-only)
           - TAA only available with O9090 optic (no /TAA on 320W-UT-O4090 or O6565)
           - 600W has TAA only on UT (no LLHB600-2CS-HT/O9090/TAA)
         CCT NOT in part number (2-CCTSELECT field-toggled at install).
         3-WATTSELECT dropped (these are fixed-wattage SKUs · not dip-switched). -->
    <div class="cfg-body split-60-40" style="grid-template-columns: 3fr 2fr !important;">
      <!-- ============== REQUIRED COLUMN ============== -->
      <div class="cfg-col cfg-col-req">
        <div class="cfg-col-head">
          <div class="cfg-col-title cfg-col-title-required">Required</div>
          <div class="cfg-col-meta">4 fields · WATTAGE drives ALLOWED matrix</div>
        </div>
        <div class="cfg-rows">

          <!-- Step 1 · Wattage Class · 5 chips · sets body[data-form] for accessory row swap -->
          <div class="cfg-row" data-field="wattage">
            <div class="cfg-row-l">
              <span class="cfg-row-label">Wattage Class<span class="cfg-req">*</span></span>
              <span class="cfg-row-code is-empty" data-field-code="wattage">—</span>
            </div>
            <div class="cfg-seg" style="grid-template-columns: repeat(5, 1fr);">
              <button type="button" class="cfg-chip" data-field="wattage" data-val="155" data-code="155"><span class="cfg-chip-stripe qs"></span><span class="cfg-chip-main"><span class="cfg-chip-label">155W</span></span></button>
              <button type="button" class="cfg-chip" data-field="wattage" data-val="320" data-code="320"><span class="cfg-chip-stripe qs"></span><span class="cfg-chip-main"><span class="cfg-chip-label">320W</span></span></button>
              <button type="button" class="cfg-chip" data-field="wattage" data-val="400" data-code="400"><span class="cfg-chip-stripe qs"></span><span class="cfg-chip-main"><span class="cfg-chip-label">400W</span></span></button>
              <button type="button" class="cfg-chip" data-field="wattage" data-val="500" data-code="500"><span class="cfg-chip-stripe qs"></span><span class="cfg-chip-main"><span class="cfg-chip-label">500W</span></span></button>
              <button type="button" class="cfg-chip" data-field="wattage" data-val="600" data-code="600"><span class="cfg-chip-stripe qs"></span><span class="cfg-chip-main"><span class="cfg-chip-label">600W</span></span></button>
            </div>
          </div>

          <!-- Step 2 · Voltage · 2 chips · constraint: 600W is UT-only (HT chip disabled when wattage=600) -->
          <div class="cfg-row" data-field="voltage">
            <div class="cfg-row-l">
              <span class="cfg-row-label">Voltage<span class="cfg-req">*</span></span>
              <span class="cfg-row-code is-empty" data-field-code="voltage">—</span>
            </div>
            <div class="cfg-seg" style="grid-template-columns: repeat(2, 1fr);">
              <button type="button" class="cfg-chip" data-field="voltage" data-val="UT" data-code="UT" data-star="1"><span class="cfg-chip-stripe qs"></span><span class="cfg-chip-main"><span class="cfg-chip-label">UT &middot; 120-277V</span><span class="cfg-chip-star">★</span></span></button>
              <button type="button" class="cfg-chip" data-field="voltage" data-val="HT" data-code="HT"><span class="cfg-chip-stripe qs"></span><span class="cfg-chip-main"><span class="cfg-chip-label">HT &middot; 277-480V</span></span></button>
            </div>
          </div>

          <!-- Step 3 · Optic · 3 chips · constraint: O4090 + O6565 only on 320W-UT (others O9090 only) -->
          <div class="cfg-row" data-field="optic">
            <div class="cfg-row-l">
              <span class="cfg-row-label">Optic<span class="cfg-req">*</span> <small style="color:var(--text-muted); font-weight:400;">(40x90 + 65x65 only on 320W-UT)</small></span>
              <span class="cfg-row-code is-empty" data-field-code="optic">—</span>
            </div>
            <div class="cfg-seg" style="grid-template-columns: repeat(3, 1fr);">
              <button type="button" class="cfg-chip" data-field="optic" data-val="O9090" data-code="O9090" data-star="1"><span class="cfg-chip-stripe qs"></span><span class="cfg-chip-main"><span class="cfg-chip-label">O9090 &middot; 90&deg;x90&deg;</span><span class="cfg-chip-star">★</span></span></button>
              <button type="button" class="cfg-chip" data-field="optic" data-val="O4090" data-code="O4090"><span class="cfg-chip-stripe wb"></span><span class="cfg-chip-main"><span class="cfg-chip-label">O4090 &middot; 40&deg;x90&deg;</span></span></button>
              <button type="button" class="cfg-chip" data-field="optic" data-val="O6565" data-code="O6565"><span class="cfg-chip-stripe wb"></span><span class="cfg-chip-main"><span class="cfg-chip-label">O6565 &middot; 65&deg;x65&deg;</span></span></button>
            </div>
          </div>

          <!-- Step 4 · Trade Compliance · 2 chips · constraint: TAA only with O9090 optic -->
          <div class="cfg-row" data-field="taa">
            <div class="cfg-row-l">
              <span class="cfg-row-label">Trade Compliance<span class="cfg-req">*</span></span>
              <span class="cfg-row-code is-empty" data-field-code="taa">—</span>
            </div>
            <div class="cfg-seg" style="grid-template-columns: repeat(2, 1fr);">
              <button type="button" class="cfg-chip" data-field="taa" data-val="STD" data-code="" data-star="1"><span class="cfg-chip-stripe qs"></span><span class="cfg-chip-main"><span class="cfg-chip-label">Standard</span><span class="cfg-chip-star">★</span></span></button>
              <button type="button" class="cfg-chip" data-field="taa" data-val="TAA" data-code="TAA"><span class="cfg-chip-stripe wb"></span><span class="cfg-chip-main"><span class="cfg-chip-label">TAA Compliant &middot; Made in Mexico</span></span></button>
            </div>
          </div>

        </div>
      </div>

      <!-- ============== OPTIONAL COLUMN · 20 LLHB-T2/* accessory adders ============== -->
      <div class="cfg-col cfg-col-opt cfg-col-optional-flex">
        <div class="cfg-col-head">
          <div class="cfg-col-title">Optional</div>
          <div class="cfg-col-meta">20 add-ons · class-matched · pick any combination</div>
        </div>
        <div class="cfg-rows">

          <!-- Optic Retrofit Kit · class-matched (LLHB-T2/{class}-O{optic}) · 9 total, 3 visible per class.
               Note: 500W and 600W classes do not have retrofit-optic SKUs (no LLHB-T2/500-* or LLHB-T2/600-*).
               Row hidden unless class is 155, 320, or 400. -->
          <div class="cfg-row cfg-row-stack" data-field="opticAcc" data-form-show="155 320 400">
            <div class="cfg-row-l cfg-row-l-stack">
              <span class="cfg-row-label">Optic Retrofit Kit</span>
              <span class="cfg-row-code is-empty" data-field-code="opticAcc">—</span>
            </div>
            <div class="cfg-seg" style="grid-template-columns: repeat(3, 1fr);">
              <button type="button" class="cfg-chip cfg-chip-toggle" data-field="opticAcc" data-val="O4090" data-code="O4090"><span class="cfg-chip-stripe wb"></span><span class="cfg-chip-main"><span class="cfg-chip-label">O4090 · 40&deg;x90&deg;</span></span></button>
              <button type="button" class="cfg-chip cfg-chip-toggle" data-field="opticAcc" data-val="O6565" data-code="O6565"><span class="cfg-chip-stripe wb"></span><span class="cfg-chip-main"><span class="cfg-chip-label">O6565 · 65&deg;x65&deg;</span></span></button>
              <button type="button" class="cfg-chip cfg-chip-toggle" data-field="opticAcc" data-val="O9090" data-code="O9090"><span class="cfg-chip-stripe wb"></span><span class="cfg-chip-main"><span class="cfg-chip-label">O9090 · 90&deg;x90&deg;</span></span></button>
            </div>
          </div>

          <!-- High-Voltage Driver · class-matched (LLHB-T2/HVD{class}) · 1 chip visible per class.
               Only 155/320/400 have HVD variants in the canonical list. -->
          <div class="cfg-row cfg-row-stack" data-field="hvd" data-form-show="155 320 400">
            <div class="cfg-row-l cfg-row-l-stack">
              <span class="cfg-row-label">High-Voltage Driver</span>
              <span class="cfg-row-code is-empty" data-field-code="hvd">—</span>
            </div>
            <div class="cfg-seg" style="grid-template-columns: repeat(1, 1fr);">
              <button type="button" class="cfg-chip cfg-chip-toggle" data-field="hvd" data-val="HVD" data-code="HVD"><span class="cfg-chip-stripe wb"></span><span class="cfg-chip-main"><span class="cfg-chip-label">HVD &middot; Replacement driver</span></span></button>
            </div>
          </div>

          <!-- Wire Guard · class-matched (LLHB-T2/WG{class}) · 155/320/400 only -->
          <div class="cfg-row cfg-row-stack" data-field="wg" data-form-show="155 320 400">
            <div class="cfg-row-l cfg-row-l-stack">
              <span class="cfg-row-label">Wire Guard</span>
              <span class="cfg-row-code is-empty" data-field-code="wg">—</span>
            </div>
            <div class="cfg-seg" style="grid-template-columns: repeat(1, 1fr);">
              <button type="button" class="cfg-chip cfg-chip-toggle" data-field="wg" data-val="WG" data-code="WG"><span class="cfg-chip-stripe wb"></span><span class="cfg-chip-main"><span class="cfg-chip-label">Wire Guard &middot; impact shield</span></span></button>
            </div>
          </div>

          <!-- Mount Kit · 4 universal chips (LLHB-T2/{PDM|SFM|SPM|JBX}) -->
          <div class="cfg-row cfg-row-stack" data-field="mount">
            <div class="cfg-row-l cfg-row-l-stack">
              <span class="cfg-row-label">Mount + Junction</span>
              <span class="cfg-row-code is-empty" data-field-code="mount">—</span>
            </div>
            <div class="cfg-seg" style="grid-template-columns: repeat(2, 1fr); grid-row-gap: 4px;">
              <button type="button" class="cfg-chip cfg-chip-toggle" data-field="mount" data-val="PDM" data-code="PDM"><span class="cfg-chip-stripe wb"></span><span class="cfg-chip-main"><span class="cfg-chip-label">PDM &middot; Pendant</span></span></button>
              <button type="button" class="cfg-chip cfg-chip-toggle" data-field="mount" data-val="SFM" data-code="SFM"><span class="cfg-chip-stripe wb"></span><span class="cfg-chip-main"><span class="cfg-chip-label">SFM &middot; Surface</span></span></button>
              <button type="button" class="cfg-chip cfg-chip-toggle" data-field="mount" data-val="SPM" data-code="SPM"><span class="cfg-chip-stripe wb"></span><span class="cfg-chip-main"><span class="cfg-chip-label">SPM &middot; Suspended</span></span></button>
              <button type="button" class="cfg-chip cfg-chip-toggle" data-field="mount" data-val="JBX" data-code="JBX"><span class="cfg-chip-stripe wb"></span><span class="cfg-chip-main"><span class="cfg-chip-label">JBX &middot; Junction Box</span></span></button>
            </div>
          </div>

          <!-- Bird Spike Deterrent · universal (LLHB-T2/BSD) -->
          <div class="cfg-row cfg-row-stack" data-field="bsd">
            <div class="cfg-row-l cfg-row-l-stack">
              <span class="cfg-row-label">Bird Spike Deterrent</span>
              <span class="cfg-row-code is-empty" data-field-code="bsd">—</span>
            </div>
            <div class="cfg-seg" style="grid-template-columns: repeat(1, 1fr);">
              <button type="button" class="cfg-chip cfg-chip-toggle" data-field="bsd" data-val="BSD" data-code="BSD"><span class="cfg-chip-stripe wb"></span><span class="cfg-chip-main"><span class="cfg-chip-label">BSD &middot; Bird-spike deterrent</span></span></button>
            </div>
          </div>

          <!-- Tip note for 500W + 600W classes (no retrofit-optic, HVD, WG accessories) -->
          <div data-form-show="500 600" style="padding: 8px 0; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--text-muted); line-height: 1.6;">
            500W + 600W classes ship without LLHB-T2 retrofit-optic, HVD, or WG accessories &middot; spec the 320W or 400W class for those adders.
          </div>

        </div>

        <!-- Legend + disclaimer · moved to right column per James 2026-05-27 ·
             positioned under Optional accessories (visually under the Required section's right edge). -->
        <div class="cfg-legend" aria-label="Configurator marker legend" style="margin-top: 20px;">
          <div class="cfg-legend-row">
            <span class="cfg-legend-key star">★</span>
            <span class="cfg-legend-val">Factory-default ship configuration</span>
          </div>
          <div class="cfg-legend-row">
            <span class="cfg-legend-key qs"><span class="cfg-legend-stripe qs"></span></span>
            <span class="cfg-legend-val">QuickShip &middot; 3-5 day lead</span>
          </div>
          <div class="cfg-legend-row">
            <span class="cfg-legend-key wb"><span class="cfg-legend-stripe wb"></span></span>

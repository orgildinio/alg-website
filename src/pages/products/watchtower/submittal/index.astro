<!-- PAGE 4 — PHOTOMETRICS                                         -->
<!-- ============================================================ -->
<div class="page photo-page" id="page4">
  <div class="submittal-head">
    <div class="brand-block">
      <div class="brand-name">Archipelago</div>
      <div class="brand-sub">Lighting Group</div>
    </div>
    <div class="cat-block">
      <div class="cat-eyebrow">Catalog Number</div>
      <div class="catalog-number" id="catNum4" contenteditable="true" spellcheck="false">LWPC80-3CS-U-WM</div>
    </div>
  </div>

  <div class="section-eyebrow" id="photoEyebrow">Default optic · 120W · 4000K</div>

  <div class="photo-grid">
    <div class="polar-plot">
      <img id="photoPolarImg" src="" alt="Polar plot"
           onerror="this.style.display='none'; this.parentElement.innerHTML+='<div style=\'color:#999;font-size:8pt;text-align:center;padding:20px;\'>Polar plot unavailable</div>';" />
    </div>
    <div class="photo-stats">
      <div class="ps-row"><span class="ps-label">Lumens</span><span class="ps-val" id="photoLumens">16,560 lm</span></div>
      <div class="ps-row"><span class="ps-label">Peak Candela</span><span class="ps-val" id="photoPeak">—</span></div>
      <div class="ps-row"><span class="ps-label">Distribution</span><span class="ps-val" id="photoBeam">—</span></div>
      <div class="ps-row"><span class="ps-label">IES File</span><span class="ps-val" id="photoIesFile">LWPC120-4000K.IES</span></div>

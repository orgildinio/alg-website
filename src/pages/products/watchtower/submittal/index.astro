</div>

<script is:inline>
(function() {
  var params = new URLSearchParams(window.location.search);
  var sku    = params.get('sku')    || 'LWPC80-3CS-U-WM';
  var watts  = params.get('wattage') || '80';
  var cct    = params.get('cct')    || '40';
  var voltage = params.get('voltage') || 'U';
  var finish = params.get('finish') || 'Black';
  var mount  = params.get('mount')  || 'WM';
  var taa    = params.get('taa') === '1';

  // --- AUTOFILL CATALOG NUMBER (all fields) ---
  var skuLive = sku + (taa ? '/TAA' : '');
  document.querySelectorAll('#catNum, #catNum2, #catNum3, #catNum4, #liveSku').forEach(function(el) {
    el.textContent = skuLive;
  });
  document.getElementById('piCatNum').textContent = skuLive;

  // --- CFG-SUB-1: Catalog-number edit sync ---
  var catFields = ['catNum', 'catNum2', 'catNum3', 'catNum4', 'liveSku', 'piCatNum'];
  function syncCatalogNumber(newVal) {
    catFields.forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.textContent = newVal;
    });
  }
  catFields.forEach(function(id) {
    var el = document.getElementById(id);
    if (!el) return;
    el.addEventListener('input', function() {
      syncCatalogNumber(this.textContent.trim());
    });
    if (!el.hasAttribute('contenteditable')) {
      el.setAttribute('contenteditable', 'true');
      el.setAttribute('spellcheck', 'false');
    }
  });

  // --- HOUSING/LUMENS LOOKUP ---
  var housingLumens = {
    '40': { lumens: '5,440', efficacy: '136', watts_max: '40' },
    '60': { lumens: '8,160', efficacy: '136', watts_max: '60' },
    '80': { lumens: '11,120', efficacy: '139', watts_max: '80' },
    '100': { lumens: '13,900', efficacy: '139', watts_max: '100' },
    '120': { lumens: '16,560', efficacy: '138', watts_max: '120' }
  };
  var housing = params.get('housing') || watts;
  var hl = housingLumens[housing] || housingLumens[Object.keys(housingLumens)[0]];
  if (hl) {
    document.getElementById('qsLumens').innerHTML = hl.lumens + '<span class="qs-unit">lm</span>';
    document.getElementById('qsWatts').innerHTML  = hl.watts_max + '<span class="qs-unit">W</span>';
    document.getElementById('photoLumens').textContent = hl.lumens + ' lm';
    document.getElementById('photoEyebrow').textContent = 'Default optic · ' + hl.watts_max + 'W · ' + (cct === '30' ? '3000K' : cct === '40' ? '4000K' : '5000K');
    document.getElementById('photoIesFile').textContent = 'LWPC' + hl.watts_max + '-' + (cct === '30' ? '3000K' : cct === '40' ? '4000K' : '5000K') + '.IES';
  }

  // --- CCT / VOLTAGE ---
  document.getElementById('qsCct').innerHTML = (cct === '30' ? '3000' : cct === '40' ? '4000' : '5000') + '<span class="qs-unit">K</span>';
  document.getElementById('qsVoltage').innerHTML = (voltage === 'H' ? '277-480' : '120-277') + '<span class="qs-unit">V</span>';

  // --- LIVE DATE ---
  var d = new Date();
  var dateStr = d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' });
  document.getElementById('liveDate').textContent = dateStr;
  var revStr = d.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit' }).replace('/', '-');
  document.getElementById('revDate').textContent = revStr;
  document.getElementById('revDate2').textContent = revStr;
})();
</script>
</body>
</html>

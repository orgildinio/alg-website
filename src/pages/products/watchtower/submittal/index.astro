---
/**
 * LWPC · Watchtower — Submittal Sheet
 * Route: /products/watchtower/submittal/
 *
 * Standalone print-optimized page. No site header/footer.
 * URL params auto-populate the submittal fields.
 * CFG-SUB-1: Editable catalog-number syncs all occurrences (session-only).
 * CFG-SUB-4: Real product data from watchtower_LWPC.pdf datasheet.
 */
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>LWPC · Watchtower — Submittal Sheet</title>
<!--
  ALG SUBMITTAL TEMPLATE v2 — CFG-SUB-1/4
  =========================================
  Reads URL query params and auto-fills the catalog number + quick specs.
  Example: /products/watchtower/submittal/?sku=LWPC80-3CS-U-WM&wattage=80&voltage=U&finish=Black&mount=WM
  Print: File → Print → Save as PDF (letter portrait).
-->
<style>
/* ============================================================
   RESET & PAGE SETUP
   ============================================================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { font-size: 10pt; }
body {
  font-family: 'Helvetica Neue', Arial, sans-serif;
  color: #1a1a1a;
  background: #f0f0f0;
  line-height: 1.4;
}
@media print {
  body { background: white; }
  .no-print { display: none !important; }
  .page { box-shadow: none; margin: 0; border-radius: 0; }
  @page { size: letter portrait; margin: 0.5in; }
}
/* ============================================================
   CONTROLS BAR (screen only)
   ============================================================ */
.controls {
  display: flex;
  align-items: center;
  gap: 24px;
  padding: 10px 32px;
  background: #1a1a1a;
  color: #fff;
  font-size: 9pt;
  position: sticky;
  top: 0;
  z-index: 100;
}
.controls .ctrl-label { color: #aaa; font-size: 8pt; text-transform: uppercase; letter-spacing: .05em; }
.controls .ctrl-value { font-weight: 600; font-size: 10pt; }
.controls .btn-print {
  margin-left: auto;
  background: #e32;
  color: #fff;
  border: none;
  padding: 6px 18px;
  font-size: 9pt;
  font-weight: 600;
  cursor: pointer;
  border-radius: 2px;
  letter-spacing: .04em;
}
.controls .btn-print:hover { background: #c21; }
/* ============================================================
   PAGE SHELL
   ============================================================ */
.page {
  width: 8.5in;
  min-height: 11in;
  background: white;
  margin: 24px auto;
  padding: 0.55in 0.6in;
  box-shadow: 0 2px 12px rgba(0,0,0,.15);
  border-radius: 2px;
  position: relative;
  page-break-after: always;
}
/* ============================================================
   SUBMITTAL HEADER
   ============================================================ */
.submittal-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  border-bottom: 2px solid #1a1a1a;
  padding-bottom: 10px;
  margin-bottom: 14px;
}
.brand-block .brand-name {
  font-size: 15pt;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
}
.brand-block .brand-sub {
  font-size: 7pt;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: #555;
}
.submittal-head .cat-block { text-align: right; }
.submittal-head .cat-eyebrow {
  font-size: 7pt;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: #888;
  margin-bottom: 4px;
}
.submittal-head .catalog-number {
  font-size: 13pt;
  font-weight: 700;
  letter-spacing: .04em;
  border: 1.5px solid #1a1a1a;
  padding: 4px 10px;
  cursor: text;
  min-width: 200px;
  text-align: center;
}
.submittal-head .catalog-number:focus { outline: 2px solid #e32; }
/* ============================================================
   PROJECT INFO TABLE
   ============================================================ */
.project-info {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 0;
  border: 1px solid #ccc;
  margin-bottom: 14px;
  font-size: 8.5pt;
}
.pi-cell {
  border-right: 1px solid #ccc;
  padding: 5px 8px;
}
.pi-cell:last-child { border-right: none; }
.pi-label { font-size: 7pt; text-transform: uppercase; letter-spacing: .06em; color: #888; margin-bottom: 2px; }
.pi-value { min-height: 14px; border-bottom: 1px solid #ddd; }
/* ============================================================
   PRODUCT TITLE
   ============================================================ */
.product-title { margin-bottom: 12px; }
.product-title h1 {
  font-size: 18pt;
  font-weight: 800;
  letter-spacing: .02em;
  line-height: 1.1;
}
.product-title .tagline {
  font-size: 9pt;
  color: #555;
  margin-top: 3px;
}
/* ============================================================
   HERO + QUICK SPECS
   ============================================================ */
.at-a-glance {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-bottom: 14px;
}
.hero-img img {
  width: 100%;
  height: 200px;
  object-fit: contain;
  background: #f8f8f8;
  border: 1px solid #eee;
}
.qs-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  align-content: start;
}
.qs-cell {
  border: 1px solid #ddd;
  padding: 8px 10px;
  background: #fafafa;
}
.qs-label { font-size: 7pt; text-transform: uppercase; letter-spacing: .08em; color: #888; margin-bottom: 2px; }
.qs-value { font-size: 16pt; font-weight: 700; line-height: 1; }
.qs-unit { font-size: 9pt; font-weight: 400; color: #555; margin-left: 1px; }
/* ============================================================
   FEATURE BAND
   ============================================================ */
.feature-band {
  display: flex;
  align-items: center;
  gap: 10px;
  background: #1a1a1a;
  color: #fff;
  padding: 7px 12px;
  font-size: 8pt;
  margin-bottom: 14px;
}
.fb-pill {
  background: #e32;
  color: #fff;
  font-size: 7pt;
  font-weight: 700;
  letter-spacing: .06em;
  text-transform: uppercase;
  padding: 3px 7px;
  border-radius: 2px;
  white-space: nowrap;
}
/* ============================================================
   APPROVAL BLOCK
   ============================================================ */
.approval-block {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 10px;
}
.approval-cell {
  border-bottom: 1px solid #1a1a1a;
  padding-bottom: 4px;
  font-size: 8.5pt;
  display: flex;
  justify-content: space-between;
}
/* ============================================================
   PAGE FOOTER
   ============================================================ */
.page-foot {
  display: flex;
  justify-content: space-between;
  font-size: 7pt;
  color: #888;
  border-top: 1px solid #ddd;
  padding-top: 6px;
  margin-top: 12px;
}
/* ============================================================
   SPEC TABLE (PAGE 2)
   ============================================================ */
.spec-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 8.5pt;
  margin-bottom: 12px;
}
.spec-table td {
  padding: 5px 8px;
  border-bottom: 1px solid #eee;
  vertical-align: top;
}
.spec-table .spec-attr {
  font-weight: 600;
  width: 32%;
  color: #333;
  white-space: nowrap;
}
.spec-table .spec-val { color: #1a1a1a; }
.spec-table .spec-section-head td {
  background: #1a1a1a;
  color: #fff;
  font-weight: 700;
  font-size: 8pt;
  letter-spacing: .06em;
  text-transform: uppercase;
  padding: 4px 8px;
}
/* ============================================================
   ORDERING GUIDE (PAGE 3)
   ============================================================ */
.ordering-guide { font-size: 8.5pt; }
.og-title {
  font-size: 11pt;
  font-weight: 700;
  margin-bottom: 8px;
  border-bottom: 1.5px solid #1a1a1a;
  padding-bottom: 4px;
}
.og-section { margin-bottom: 10px; }
.og-section-head {
  font-size: 8pt;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .06em;
  color: #555;
  margin-bottom: 4px;
  border-bottom: 1px solid #ddd;
  padding-bottom: 2px;
}
.og-table { width: 100%; border-collapse: collapse; }
.og-table td {
  padding: 3px 6px;
  border-bottom: 1px solid #f0f0f0;
  vertical-align: top;
}
.og-table .og-code { font-weight: 700; width: 20%; white-space: nowrap; }
.og-table .og-desc { color: #444; }
/* ============================================================
   CATALOG NUMBER BREAKDOWN
   ============================================================ */
.cat-breakdown {
  display: flex;
  gap: 0;
  margin: 12px 0;
  border: 1px solid #ddd;
  font-size: 8pt;
}
.cb-cell {
  flex: 1;
  padding: 6px 8px;
  border-right: 1px solid #ddd;
  text-align: center;
}
.cb-cell:last-child { border-right: none; }
.cb-code { font-size: 11pt; font-weight: 700; display: block; }
.cb-label { font-size: 7pt; color: #888; text-transform: uppercase; letter-spacing: .05em; }
/* ============================================================
   PHOTOMETRICS PAGE (PAGE 4)
   ============================================================ */
.photo-page .section-eyebrow {
  font-size: 8pt;
  color: #888;
  text-transform: uppercase;
  letter-spacing: .08em;
  margin-bottom: 8px;
}
.photo-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.polar-plot {
  background: #f8f8f8;
  border: 1px solid #eee;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 200px;
}
.polar-plot img { max-width: 100%; max-height: 200px; }
.photo-stats { display: flex; flex-direction: column; gap: 8px; }
.ps-row {
  display: flex;
  justify-content: space-between;
  border-bottom: 1px solid #eee;
  padding: 5px 0;
  font-size: 9pt;
}
.ps-label { color: #888; font-size: 8pt; }
.ps-val { font-weight: 600; }
</style>
</head>
<body>

<!-- CONTROLS BAR (screen only) -->
<div class="controls no-print">
  <div>
    <div class="ctrl-label">Configured SKU</div>
    <div class="ctrl-value" id="liveSku">LWPC80-3CS-U-WM</div>
  </div>
  <div>
    <div class="ctrl-label">Generated</div>
    <div class="ctrl-value" id="liveDate" style="font-size:9pt; font-weight:400;">—</div>
  </div>
  <button class="btn-print" onclick="window.print()">SAVE AS PDF →</button>
</div>

<!-- ============================================================ -->
<!-- PAGE 1 — COVER / QUICK SPECS                                  -->
<!-- ============================================================ -->
<div class="page" id="page1">
  <!-- SUBMITTAL HEADER -->
  <div class="submittal-head">
    <div class="brand-block">
      <div class="brand-name">Archipelago</div>
      <div class="brand-sub">Lighting Group</div>
    </div>
    <div class="cat-block">
      <div class="cat-eyebrow">Catalog Number</div>
      <div class="catalog-number" id="catNum" contenteditable="true" spellcheck="false">LWPC80-3CS-U-WM</div>
    </div>
  </div>

  <!-- PROJECT INFO -->
  <div class="project-info">
    <div class="pi-cell"><div class="pi-label">Project</div><div class="pi-value" contenteditable="true"></div></div>
    <div class="pi-cell"><div class="pi-label">Type</div><div class="pi-value" contenteditable="true"></div></div>
    <div class="pi-cell"><div class="pi-label">Catalog #</div><div class="pi-value" id="piCatNum"></div></div>
    <div class="pi-cell"><div class="pi-label">Prepared By</div><div class="pi-value" contenteditable="true"></div></div>
    <div class="pi-cell"><div class="pi-label">Notes</div><div class="pi-value" contenteditable="true"></div></div>
    <div class="pi-cell"><div class="pi-label">Date</div><div class="pi-value" id="revDate"></div></div>
  </div>

  <!-- PRODUCT TITLE -->
  <div class="product-title">
    <h1>LWPC Watchtower</h1>
    <div class="tagline">LED Full-Cutoff Wall Pack · Full-cutoff · 16,560 lm · 3000K / 4000K / 5000K</div>
  </div>

  <!-- HERO + QUICK SPECS -->
  <div class="at-a-glance">
    <div class="hero-img">
      <img src="/products/watchtower/assets/watchtower/hero/watchtower-hero-1.webp"
           alt="LWPC Watchtower luminaire"
           onerror="this.style.background='#f0f0f0'; this.style.display='flex'; this.style.alignItems='center'; this.style.justifyContent='center';" />
    </div>
    <div class="qs-grid">
      <div class="qs-cell">
        <div class="qs-label">Lumens</div>
        <div class="qs-value" id="qsLumens">16,560<span class="qs-unit">lm</span></div>
      </div>
      <div class="qs-cell">
        <div class="qs-label">Wattage</div>
        <div class="qs-value" id="qsWatts">120<span class="qs-unit">W</span></div>
      </div>
      <div class="qs-cell">
        <div class="qs-label">Voltage</div>
        <div class="qs-value" id="qsVoltage">120-277Vac<span class="qs-unit">V</span></div>
      </div>
      <div class="qs-cell">
        <div class="qs-label">CCT</div>
        <div class="qs-value" id="qsCct">4000<span class="qs-unit">K</span></div>
      </div>
      <div class="qs-cell">
        <div class="qs-label">CRI</div>
        <div class="qs-value">>80</div>
      </div>
      <div class="qs-cell">
        <div class="qs-label">IP Rating</div>
        <div class="qs-value">IP65</div>
      </div>
    </div>
  </div>

  <!-- FEATURE BAND -->
  <div class="feature-band">
    <div class="fb-pill">ALG Certified</div>
    <div class="fb-features">Full-Cutoff Design, Advanced Driver Technology, Thermal Excellence</div>
  </div>

  <!-- APPROVAL BLOCK -->
  <div class="approval-block">
    <div class="approval-cell">
      <span><strong>Approved by</strong></span>
      <span style="border-bottom:1px solid #1a1a1a; min-width:200px; display:inline-block;">&nbsp;</span>
    </div>
    <div class="approval-cell">
      <span><strong>Date</strong></span>
      <span style="border-bottom:1px solid #1a1a1a; min-width:200px; display:inline-block;">&nbsp;</span>
    </div>
  </div>

  <div class="page-foot">
    <div>archipelagolighting.com · LWPC Watchtower submittal · Specifications subject to change</div>
    <div>Rev. <span id="revDate2">2026-06</span> · Page 1 of 4</div>
  </div>
</div>

<!-- ============================================================ -->
<!-- PAGE 2 — SPECIFICATIONS                                       -->
<!-- ============================================================ -->
<div class="page" id="page2">
  <div class="submittal-head">
    <div class="brand-block">
      <div class="brand-name">Archipelago</div>
      <div class="brand-sub">Lighting Group</div>
    </div>
    <div class="cat-block">
      <div class="cat-eyebrow">Catalog Number</div>
      <div class="catalog-number" id="catNum2" contenteditable="true" spellcheck="false">LWPC80-3CS-U-WM</div>
    </div>
  </div>

  <table class="spec-table">
    <tbody>
      <tr class="spec-section-head"><td colspan="2">Model Specifications</td></tr>
      <tr><td class="spec-attr">40W</td><td class="spec-val">5,440 lm · 136 lm/W</td></tr>
      <tr><td class="spec-attr">60W</td><td class="spec-val">8,160 lm · 136 lm/W</td></tr>
      <tr><td class="spec-attr">80W</td><td class="spec-val">11,120 lm · 139 lm/W</td></tr>
      <tr><td class="spec-attr">100W</td><td class="spec-val">13,900 lm · 139 lm/W</td></tr>
      <tr><td class="spec-attr">120W</td><td class="spec-val">16,560 lm · 138 lm/W</td></tr>
      <tr class="spec-section-head"><td colspan="2">Optical</td></tr>
      <tr><td class="spec-attr">CCT Options</td><td class="spec-val">3000K / 4000K / 5000K</td></tr>
      <tr><td class="spec-attr">CRI</td><td class="spec-val">>80 typical</td></tr>
      <tr><td class="spec-attr">Optic Distribution</td><td class="spec-val">Full-cutoff</td></tr>
      <tr class="spec-section-head"><td colspan="2">Electrical</td></tr>
      <tr><td class="spec-attr">Input Voltage</td><td class="spec-val">120-277Vac</td></tr>
      <tr><td class="spec-attr">Power Factor</td><td class="spec-val">≥ 0.95 at full load</td></tr>
      <tr><td class="spec-attr">THD</td><td class="spec-val">≤ 20% at full load</td></tr>
      <tr><td class="spec-attr">Surge Protection</td><td class="spec-val">10KVa / 20KVa standard</td></tr>
      <tr><td class="spec-attr">Dimming</td><td class="spec-val">0-10V standard · contrⒶLS-Ready</td></tr>
      <tr class="spec-section-head"><td colspan="2">Construction &amp; Environment</td></tr>
      <tr><td class="spec-attr">Ingress Protection</td><td class="spec-val">IP65 wet-location rated</td></tr>
      <tr><td class="spec-attr">Operating Temp</td><td class="spec-val">-40°F to 113°F</td></tr>
      <tr><td class="spec-attr">LED Source</td><td class="spec-val">Premium SMD LED · L70 lumen maintenance</td></tr>
      <tr class="spec-section-head"><td colspan="2">Mounting</td></tr>
      <tr><td class="spec-attr">Mount Options</td><td class="spec-val">Direct wall surface or standard J-box</td></tr>
      <tr class="spec-section-head"><td colspan="2">Compliance &amp; Warranty</td></tr>
      <tr><td class="spec-attr">Standards</td><td class="spec-val">UL 1598 · cUL · DLC Premium QPL Listed · FCC Title 47 Part 15B · RoHS</td></tr>
      <tr><td class="spec-attr">Warranty</td><td class="spec-val">5-year limited · 50000-hr L70 lumen maintenance</td></tr>
    </tbody>
  </table>

  <div class="page-foot">
    <div>archipelagolighting.com · LWPC Watchtower submittal · Specifications subject to change</div>
    <div>Rev. 2026-06 · Page 2 of 4</div>
  </div>
</div>

<!-- ============================================================ -->
<!-- PAGE 3 — ORDERING GUIDE                                       -->
<!-- ============================================================ -->
<div class="page" id="page3">
  <div class="submittal-head">
    <div class="brand-block">
      <div class="brand-name">Archipelago</div>
      <div class="brand-sub">Lighting Group</div>
    </div>
    <div class="cat-block">
      <div class="cat-eyebrow">Catalog Number</div>

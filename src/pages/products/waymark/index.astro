---
/**
 * waymark PDP — planoⒶRCH · Astro wrapper
 * Route: /products/waymark/
 * Bug #1 fix: wraps canonical BaseLayout (Header + MegaMenu + Footer)
 * Uses readFileSync + set:html to inject raw PDP body without Astro template processing.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';

// Read the public HTML at build time using process.cwd() (project root)
const publicHtml = readFileSync(
  path.join(process.cwd(), 'public/products/waymark/index.html'),
  'utf-8'
);
// Extract body content — everything between <body...> and </body>
const bodyMatch = publicHtml.match(/<body[^>]*>([\s\S]*)<\/body>/i);
const bodyContent = bodyMatch ? bodyMatch[1] : publicHtml;
---
<BaseLayout
  title="LWRL · Waymark — Archipelago Lighting Group"
  description="LWRL Waymark · planoⒶRCH PRO · LED Wraparound · DLC Premium · 2×4 and 2×2."
  bodyClass="waymark-pdp"
>
  <Fragment set:html={bodyContent} />
</BaseLayout>

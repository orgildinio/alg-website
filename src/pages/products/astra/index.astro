---
/**
 * astra PDP — planoⒶRCH · Astro wrapper
 * Route: /products/astra/
 * Bug #1 fix: wraps canonical BaseLayout (Header + MegaMenu + Footer)
 * Uses readFileSync + set:html to inject raw PDP body without Astro template processing.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';

// Read the public HTML at build time using process.cwd() (project root)
const publicHtml = readFileSync(
  path.join(process.cwd(), 'public/products/astra/index.html'),
  'utf-8'
);
// Extract body content — everything between <body...> and </body>
const bodyMatch = publicHtml.match(/<body[^>]*>([\s\S]*)<\/body>/i);
const bodyContent = bodyMatch ? bodyMatch[1] : publicHtml;
---
<BaseLayout
  title="LCDL · Astra-I — Archipelago Lighting Group"
  description="LCDL Astra-I · planoⒶRCH PRO+ Spec-Grade · Can-Less Commercial Downlight · 4 sizes · 3 driver-module SKUs · CRI 90+ · 24°→65° field-adjustable beam angle."
  bodyClass="astra-pdp"
>
  <Fragment set:html={bodyContent} />
</BaseLayout>

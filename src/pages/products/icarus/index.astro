<script is:inline>
// Carousel autoplay + chip selector (CFG-HERO-2 canonical pattern).
// Count is read from actual DOM so adding/removing slides doesn't drift the modulo math.
// Binds BOTH legacy carouselDots (if present) AND canonical carouselChips (CFG-HERO-2).
(function() {
  var track = document.getElementById('carouselTrack');
  var dots  = document.querySelectorAll('#carouselDots > span');
  var chips = document.querySelectorAll('#carouselChips > button');
  var slides = track ? track.querySelectorAll('.carousel-slide').length : 0;
  if (!track || !slides) return;
  var idx = 0;
  function go(i) {
    idx = (i + slides) % slides;
    track.style.transform = 'translateX(-' + (idx * 100) + '%)';
    dots.forEach(function(d, n) { d.classList.toggle('active', n === idx); });
    chips.forEach(function(c, n) { c.classList.toggle('active', n === idx); });
  }
  var timer = setInterval(function() { go(idx + 1); }, 5000);
  function bindClick(el) {
    el.addEventListener('click', function() {
      clearInterval(timer);
      go(parseInt(el.dataset.i, 10));
      timer = setInterval(function() { go(idx + 1); }, 5000);
    });
  }
  dots.forEach(bindClick);
  chips.forEach(bindClick);
})();

// (Legacy Illuminator spec-table populator removed — Icarus's 3-housing-class populator
//  lives inline with Section 2 above and uses LRHB3W150/240/300 housing classes.)

// Dimensions zoom modal — click magnifier to open, click anywhere or ESC to close
(function() {
  function initZoom() {
    var btn      = document.querySelector('.spec-dim-zoom');
    var modal    = document.getElementById('zoomModal');
    var img      = document.getElementById('dimImg');
    var src      = document.getElementById('dimSvg');
    var dst      = document.getElementById('zoomContent');
    var closeBtn = document.getElementById('zoomClose');
    if (!btn || !modal || !dst || !(img || src)) {
      console.warn('zoom-modal: missing DOM nodes', {btn:!!btn, modal:!!modal, img:!!img, src:!!src, dst:!!dst});
      return;
    }
    function openModal(e) {
      if (e) { e.preventDefault(); e.stopPropagation(); }
      // Prefer the production drawing; fall back to inline SVG
      if (img && img.complete && img.naturalWidth > 0) {
        dst.innerHTML = '<img src="' + img.getAttribute('src') + '" alt="' + img.alt + '" />';
      } else if (src) {
        dst.innerHTML = src.outerHTML.replace(/\bdisplay\s*:\s*none[;]?/i, '');
      }
      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeModal(e) {
      if (e) { e.preventDefault(); }
      modal.classList.remove('open');
      document.body.style.overflow = '';
    }
    btn.addEventListener('click', openModal);
    modal.addEventListener('click', closeModal);
    if (closeBtn) closeBtn.addEventListener('click', function(e){ e.stopPropagation(); closeModal(e); });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal.classList.contains('open')) closeModal();
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initZoom);
  } else {
    initZoom();
  }
})();

// Section 5 — Total Adaptive Control: platform tab → swap sensor SVG, swap body copy, trigger ripple shockwave
// Icarus copy grounded in LRHB datasheet (Bi-Level · ⒶCS · SILVAIR sensor ecosystem).
(function() {
  var copy = {
    bilevel: "Drop-in occupancy + bi-level dimming — no commissioning, gateway, or app required. PIR (MSP-BLS) or microwave (MSM-BLS) sensors mount directly to the Icarus integrated sensor receptacle. IR remote (RM-HT/06S) for on-site commissioning. ASHRAE 90.1 and Title 24 occupancy reduction compliance out of the box.",
    acs:     "ALG's in-house Bluetooth Mesh platform — networked occupancy, daylight harvesting, and scene control via the AURA app. Cloud-managed via the ⒶCS portal. Kinetic switches (MSZ-ACS) require no battery or wiring. Ceiling-mount PIR (MSP-8CM-ACS / MSP-40CM-ACS) for high-bay coverage up to 40FT detection.",
    silvair: "SILVAIR Bluetooth Mesh — DLC NLC qualified mesh nodes (MSP-NLC + MSX-LV5-NLC) for enterprise-scale deployments. Self-healing topology, no gateway required, full control via the SILVAIR commissioning app. The path to DLC NLC rebate qualification on every Icarus install."
  };
  function init() {
    var tabs = document.querySelectorAll('.tac-callout-tab');
    var sensors = document.querySelectorAll('.tac-sensor-svg');
    var copyEl = document.getElementById('tacCalloutCopy');
    var wave = document.getElementById('tacShockwave');
    if (!tabs.length || !sensors.length || !wave) return;
    function select(platform) {
      tabs.forEach(function(t) {
        var isActive = t.dataset.platform === platform;
        t.classList.toggle('active', isActive);
        t.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
      sensors.forEach(function(s) {
        s.classList.toggle('is-active', s.dataset.platform === platform);
      });
      if (copyEl && copy[platform]) copyEl.textContent = copy[platform];
      // Trigger shockwave: remove + re-add class to restart animation
      wave.classList.remove('is-rippling');
      void wave.offsetWidth;
      wave.classList.add('is-rippling');
    }
    tabs.forEach(function(t) {
      t.addEventListener('click', function() { select(t.dataset.platform); });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();

// (Legacy Illuminator photometrics IIFE removed — Icarus's 3-housing × 1-optic
//  photometrics driver lives inline with Section 6 above. Rebate-Center QPL-confirmed lumens,
//  peak-cd estimates flagged pending IES processing, parametric polar plot per single 90° optic.)

// (Legacy Illuminator acc-section modal IIFE removed — Icarus accessories
//  use the lighter inline filter-pill driver above. Modal/click-detail is a v2 follow-up.)


// =============================================================================
// SECTION 9 — Configurator (Build Your Icarus) · CFG-CFG-1 v1.7 · LPVR-WB pattern
// SKU template (Zoho Inventory confirmed 2026-05-27 · all 12 base SKUs live):
//   LRHB3W{class}-S4-I3U/{finish}[/TAA]                ← base
//                                /W##  ← when 3-WATTSELECT non-max picked (WB factory lock)
//                                /C##  ← when 4-CCTSELECT  non-max picked (WB factory lock)
//                                /EM##         (constⒶNT emergency)
//                                /MSP/{BLS|ACS|NLC}  (contrⒶLS sensor)
//                                /MSH | /MYK   (mount kit)
//                                /10SP-277 | /20SP-277 (in-line surge)
// Required (2 user picks): wattage class · finish (B/W)
// Auto-seeded: wattselect = class max · cct = 5000K (factory ship default · LPVR-WB pattern)
// Optional (5): taa · emergency · sensor · mount · surge
// CTAs: Pricing & Availability, Submittal PDF (submittal_template.html?…), Request a Layout
// CFG-QA-1: URL contract uses canonical &wattage= (never &watt= or &model=).
// =============================================================================
(function() {
  // ---- Required (user picks) ----
  var REQUIRED = ['wattage', 'finish', 'taa'];
  // ---- Optional (each single-pick) ----
  var OPTIONAL = ['emergency', 'sensor', 'reflector', 'diffuser', 'wireguard', 'mount', 'surge'];
  var MULTI    = [];

  // Per-class max wattage — auto-seeded when wattage class picked (LPVR-WB factory default).
  var WATTAGE_DEFAULT = { '150': '150', '240': '240', '300': '300' };
  // Static auto-seed (CCT = 5000K max · factory ship default).
  var STATIC_DEFAULTS = { cct: '5000' };

  // ---- ZOHO_STOCK · base-SKU on-hand qty (Zoho Inventory snapshot 2026-05-27) ----
  // QS = stock ≥ 50 · WB = 1-49 · MTO = 0
  // Used by deriveShipTier (see CFG-STATE-1 IIFE below) for the BASE fixture row.
  // Non-max WATT / CCT chip selections force WB regardless of base stock
  // (3-WATTSELECT and 4-CCTSELECT are factory-locked at order · ~1-3wk).
  var ZOHO_STOCK = {
    'LRHB3W150-S4-I3U/B':       0,
    'LRHB3W150-S4-I3U/B/TAA':   149,
    'LRHB3W150-S4-I3U/W':       0,
    'LRHB3W150-S4-I3U/W/TAA':   587,
    'LRHB3W240-S4-I3U/B':       3284,
    'LRHB3W240-S4-I3U/B/TAA':   868,
    'LRHB3W240-S4-I3U/W':       1332,
    'LRHB3W240-S4-I3U/W/TAA':   1146,
    'LRHB3W300-S4-I3U/B':       1147,
    'LRHB3W300-S4-I3U/B/TAA':   1008,
    'LRHB3W300-S4-I3U/W':       3957,
    'LRHB3W300-S4-I3U/W/TAA':   0
  };
  window.__ICARUS_ZOHO_STOCK = ZOHO_STOCK; // shared with CFG-STATE-1 IIFE

  // Live spec readout — peak lumens at MAX WATTSELECT position
  // (datasheet page 2 confirms middle WATTSELECT position has best efficacy ~150 lm/W).
  var SPEC = {
    wattage: {
      '150': { lumens: '21,450 lm (max) · 18,000 lm (mid · 150 lm/W)', lpw: '143-150 lm/W' },
      '240': { lumens: '36,170 lm (max) · 30,000 lm (mid · 150 lm/W)', lpw: '145-150 lm/W' },
      '300': { lumens: '46,871 lm (max) · 36,000 lm (mid · 150 lm/W)', lpw: '148-150 lm/W' }
    },
    voltage: { 'U': '120-277V · Universal' },
    finish:  { 'B': 'Black', 'W': 'White' },
    optic:   '90° Wide · Standard',
    cct:     '4-CCTSELECT · 3000/3500/4000/5000K',
    // wattage class → IES-measured peak candela at max WATTSELECT @ 5000K
    peak: {
      '150': '12,281 cd · IES',
      '240': '18,606 cd · IES',
      '300': '23,269 cd · IES'
    }
  };

  var DEFAULT_STATE = { wattage: '150', finish: 'D', taa: 'STD' };

  function init() {
    var section   = document.getElementById('configurator');
    if (!section) return;
    var counter   = document.getElementById('cfgCount');
    var counterEl = document.getElementById('cfgCounter');
    var resetBtn  = document.getElementById('cfgReset');
    var skuEl     = document.getElementById('cfgSku');
    var copyBtn   = document.getElementById('cfgSkuCopy');
    var copyLabel = document.getElementById('cfgSkuCopyLabel');
    var warning   = document.getElementById('cfgWarning');
    var ctaPrice  = document.getElementById('cfgCtaPrice');
    var ctaPdf    = document.getElementById('cfgCtaPdf');
    var chips     = section.querySelectorAll('.cfg-chip');
    var state     = Object.assign({}, DEFAULT_STATE);

    // ---- Chip click handler ----
    chips.forEach(function(chip) {
      chip.addEventListener('click', function() {
        if (chip.classList.contains('disabled')) return;
        var field = chip.dataset.field;
        var val   = chip.dataset.val;
        var isOpt = OPTIONAL.indexOf(field) >= 0;

        if (isOpt && state[field] === val) {
          delete state[field];           // Optional toggle clears
        } else {
          state[field] = val;
          if (field === 'wattage') seedDefaults();   // re-seed WATTSELECT per class
        }
        applyState();
      });
    });

    // ---- Reset all ----
    resetBtn.addEventListener('click', function() {
      state = Object.assign({}, DEFAULT_STATE);
      applyState();
    });

    // ---- Auto-seed factory defaults when class is picked ----
    // LPVR-WB pattern: WATT = class max · CCT = 5000K (max) ship pre-configured (★ QS).
    // Non-max selections require WB factory lock + /W## or /C## SKU append.
    function seedDefaults() {
      if (state.wattage && WATTAGE_DEFAULT[state.wattage]) {
        state.wattselect = WATTAGE_DEFAULT[state.wattage];
      }
      if (state.cct == null) state.cct = STATIC_DEFAULTS.cct;
    }

    // ---- Apply state to UI ----
    function applyState() {
      // Selected-chip toggle (with body[data-form] mirror for per-class WATTSELECT row swap)
      chips.forEach(function(chip) {
        var f = chip.dataset.field;
        var v = chip.dataset.val;
        chip.classList.toggle('selected', state[f] === v);
      });
      if (state.wattage) {
        document.body.setAttribute('data-form', state.wattage);
      } else {
        document.body.removeAttribute('data-form');
      }

      // Counter — only counts USER picks (REQUIRED array)
      var filled = REQUIRED.filter(function(k) { return state[k] != null; }).length;
      counter.textContent = filled;
      counterEl.classList.toggle('complete', filled === REQUIRED.length);

      var complete = (filled === REQUIRED.length);
      renderSKU(complete);
      warning.classList.toggle('show', !complete);
      ctaPdf.classList.toggle('disabled', !complete);
      ctaPrice.classList.toggle('disabled', !complete);
      copyBtn.disabled = !complete;
      copyBtn.classList.remove('copied');
      copyLabel.textContent = 'Copy SKU';

      renderSpecs();
      renderPreviewImage();
      // Notify CFG-STATE-1 ship-tier deriver that base state may have changed.
      section.dispatchEvent(new CustomEvent('cfg:state-changed', { detail: { state: state } }));
    }

    // ---- Live Preview · swap product photo per finish (W/B) ----
    // Photo library: icarus/photos/LRHB3W150-S4-I3UBTAA_{3,4,5,7}_nobg.png
    function renderPreviewImage() {
      var imgEl = document.getElementById('cfgPreviewImg');
      if (!imgEl) return;
      var finish = state.finish || 'W';
      var fileMap = {
        'W': 'LRHB3W150-S4-I3UBTAA_3_nobg.png',
        'B': 'LRHB3W150-S4-I3UBTAA_7_nobg.png'
      };
      var fname = fileMap[finish] || fileMap['W'];
      var newSrc = 'icarus/photos/' + fname + '?v=2026-05-27-T1';
      if (imgEl.getAttribute('src') !== newSrc) {
        imgEl.style.opacity = '0.4';
        imgEl.setAttribute('src', newSrc);
        imgEl.setAttribute('alt', 'Icarus · ' + (finish === 'B' ? 'Black' : 'White') + ' finish · live configurator preview');
        setTimeout(function() { imgEl.style.opacity = '1'; }, 80);
      }
    }

    // ---- SKU encoder (LPVR-WB canonical · datasheet pg 3 ordering example) ----
    //   Base:        LRHB3W{class}-S4-I3U/{finish}
    //   TAA append:  /TAA                                  (optional)
    //   WATT append: /W{##}   when wattselect != class-max (WB factory lock)
    //   CCT  append: /C{##}   when cct        != 5000K     (WB factory lock)
    //   Accessory appends (datasheet pg 3): /EM## · /MSP/{xxx} · /MSH|/MYK · /10SP-277|/20SP-277
    function renderSKU(complete) {
      var html = '';
      var wattage = state.wattage;
      var finish  = state.finish;

      html += 'LRHB3W' + (wattage || '<span class="placeholder">[CLASS]</span>') + '-S4-I3U';

      // Finish — leading slash
      if (finish == null) {
        html += '/<span class="placeholder">[FIN]</span>';
      } else {
        html += '/' + finish;
      }

      // TAA (optional · datasheet ladder slot 1)
      if (state.taa === 'TAA') html += '/TAA';

      // 3-WATTSELECT append — only when non-max (WB lock · /W{##})
      if (wattage && state.wattselect && state.wattselect !== WATTAGE_DEFAULT[wattage]) {
        html += '/W' + state.wattselect;
      }

      // 4-CCTSELECT append — only when non-max (WB lock · /C{##})
      // C30=3000K · C35=3500K · C40=4000K · 5000K = no append (default)
      if (state.cct && state.cct !== '5000') {
        var cctMap = { '3000': 'C30', '3500': 'C35', '4000': 'C40' };
        if (cctMap[state.cct]) html += '/' + cctMap[state.cct];
      }

      // Accessories (datasheet pg 3 ladder · order: EM → MSP → MOUNT → SURGE)
      // Accessory appends · all Icarus physical accessories ship as standalone LRHB-I3/{code} SKUs.
      // Append order matches datasheet pg 3 ladder: EM → sensor → reflector → diffuser → wire guard → mount → surge.
      if (state.emergency) html += '/' + state.emergency;                                // EM30 / EM40-CL / EM60 (platform-wide · no LRHB-I3 prefix)
      if (state.sensor)    html += '/MSP/' + state.sensor.replace(/^MSP-/, '');          // MSP/BLS · MSP/ACS · MSP/NLC (platform-wide)
      if (state.reflector) html += '/' + state.reflector;                                // PR150/240/300 · AR150/240/300
      if (state.diffuser)  html += '/' + state.diffuser;                                 // PD150/240/300
      if (state.wireguard) html += '/' + state.wireguard;                                // WG150/240/300
      if (state.mount)     html += '/' + state.mount;                                    // MSH · MYK · MH12 (MR ships standard · no SKU append)
      if (state.surge)     html += '/' + state.surge;                                    // 10SP-277 · 20SP-277 (platform-wide)

      skuEl.innerHTML = html;
    }

    // ---- Live spec readout ----
    function renderSpecs() {
      setSpec('lumens',  state.wattage ? SPEC.wattage[state.wattage].lumens : null);
      setSpec('lpw',     state.wattage ? SPEC.wattage[state.wattage].lpw    : null);
      setSpec('voltage', SPEC.voltage['U']);   // always Universal · datasheet ships UNV only
      setSpec('optic',   SPEC.optic);
      setSpec('peak',    state.wattage ? SPEC.peak[state.wattage] : null);

      var compliance = 'DLC Premium &middot; IP65 Wet &middot; 6 kVA Surge';
      if (state.taa === 'TAA') compliance += ' · TAA Compliant';
      setSpec('compliance', compliance);
    }
    function setSpec(name, val) {
      var el = section.querySelector('[data-spec="' + name + '"]');
      if (!el) return;
      if (name === 'cct' || name === 'cri' || (name === 'compliance' && val == null)) return;
      if (val == null || val === '—') {
        el.textContent = '—';
        el.classList.add('placeholder');
      } else {
        el.innerHTML = val;
        el.classList.remove('placeholder');
      }
    }

    // ---- Copy SKU ----
    copyBtn.addEventListener('click', function() {
      if (copyBtn.disabled) return;
      var txt = skuEl.textContent.trim();
      if (!txt) return;
      var done = function() {
        copyBtn.classList.add('copied');
        copyLabel.textContent = 'Copied ✓';
        setTimeout(function() {
          copyBtn.classList.remove('copied');
          copyLabel.textContent = 'Copy SKU';
        }, 1800);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(txt).then(done, done);
      } else {
        var ta = document.createElement('textarea');
        ta.value = txt;
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch(e){}
        document.body.removeChild(ta);
        done();
      }
    });

    // ---- Submittal PDF — canonical &wattage= URL contract (CFG-QA-1) ----
    function buildSubmittalUrl() {
      var sku = skuEl.textContent.trim();
      var params = new URLSearchParams({
        sku:        sku,
        family:     'icarus',
        wattage:    state.wattage    || '150',
        wattselect: state.wattselect || state.wattage || '150',
        voltage:    'U',
        finish:     state.finish     || 'W',
        optic:      '90',
        cct:        state.cct        || '5000',
        taa:        state.taa === 'TAA' ? '1' : '0',
        emergency:  state.emergency  || '',
        sensor:     state.sensor     || '',
        reflector:  state.reflector  || '',
        diffuser:   state.diffuser   || '',
        wireguard:  state.wireguard  || '',
        mount:      state.mount      || '',
        surge:      state.surge      || ''
      });
      return 'submittal/?' + params.toString();
    }
    ctaPdf.addEventListener('click', function(e) {
      if (ctaPdf.classList.contains('disabled')) { e.preventDefault(); return; }
      ctaPdf.setAttribute('href', buildSubmittalUrl());
    });

    // Initial render — empty state · all chips unselected · data-form unset.
    applyState();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();

// (Legacy Illuminator motion-carousel IIFE removed — Icarus's 4-slide motion
//  player lives inline with Section 3 above, sourcing the production mp4s spliced

<!-- Section 6 photometrics — Icarus 3-class IES-rendered polar driver (2026-05-27).
     Backing data: parsed from icarus/ies/LRHB3W{class}-S4-I3U-5000K.ies via parse_ies.py.
     Values below are IES-measured (peak cd / lumens / W / lm/W / beam-angle deg) — NOT estimates. -->
<script is:inline>
(function(){
  // 3 wattage classes × max WATTSELECT @ 5000K · all measured @ LM-79 2024.
  var ies = {
    '150': { svg: 'icarus-polar-150-class.svg', lumens: 22461, watts: 155.4, lpw: 145, peak: 12281, beam: 84, file: 'LRHB3W150-S4-I3U-5000K.ies' },
    '240': { svg: 'icarus-polar-240-class.svg', lumens: 36170, watts: 249.6, lpw: 145, peak: 18606, beam: 89, file: 'LRHB3W240-S4-I3U-5000K.ies' },
    '300': { svg: 'icarus-polar-300-class.svg', lumens: 46871, watts: 316.1, lpw: 148, peak: 23269, beam: 90, file: 'LRHB3W300-S4-I3U-5000K.ies' }
  };

  var modelTabs = document.querySelectorAll('.photo-tab[data-model]');
  var statPeak  = document.getElementById('photoStatPeak');
  var statLum   = document.getElementById('photoStatLumens');
  var statFile  = document.getElementById('photoStatFile');
  var polarImg  = document.getElementById('photoPolarImg');
  var dl        = document.getElementById('photoIesDownload');

  var state = { model: '150' };

  function fmt(n){ return n.toLocaleString('en-US'); }

  function render(){
    var d = ies[state.model];
    if (!d) return;
    if (polarImg) {
      polarImg.setAttribute('src', 'assets/polar/' + d.svg + '?v=2026-05-27-T1');
      polarImg.setAttribute('alt', 'LRHB3W' + state.model + ' Icarus · polar candela distribution · 5000K · peak ' + fmt(d.peak) + ' cd · beam ' + d.beam + '°');
    }
    if (statPeak) statPeak.textContent = fmt(d.peak) + ' cd';
    if (statLum)  statLum.textContent  = fmt(d.lumens) + ' lm @ ' + d.watts.toFixed(1) + 'W · ' + d.lpw + ' lm/W';
    if (statFile) statFile.textContent = d.file;
    // IES bundle is live · drop the pending state
    if (dl) {
      dl.classList.remove('is-pending');
      dl.removeAttribute('aria-disabled');
      dl.lastChild && (dl.lastChild.textContent = ' Download IES bundle (LM-79)');
    }

    modelTabs.forEach(function(t){
      var on = t.dataset.model === state.model;
      t.classList.toggle('active', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
    });
  }

  modelTabs.forEach(function(t){
    t.addEventListener('click', function(){ state.model = t.dataset.model; render(); });
  });

  render();
})();
</script>


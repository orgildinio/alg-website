  .cfg-cta {
    flex: 1;
    min-width: 180px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 20px;
    border-radius: 2px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.18s;
    border: 1px solid transparent;
    white-space: nowrap;
  }
  .cfg-cta.primary {
    background: var(--brand-red);
    color: white;
  }
  .cfg-cta.primary:hover { background: var(--brand-red-deep); }
  .cfg-cta.outline {
    background: transparent;
    color: var(--text-secondary);
    border-color: var(--line-medium);
  }
  .cfg-cta.outline:hover { color: var(--text-primary); border-color: var(--text-primary); }
  .cfg-cta.disabled {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }
  .cfg-cta svg { width: 14px; height: 14px; }

  .cfg-incomplete-warning {
    display: none;
    padding: 12px 14px;
    background: rgba(255,159,28,0.08);
    border: 1px solid rgba(255,159,28,0.35);
    border-radius: 2px;
    color: #ffb14d;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    line-height: 1.5;
  }
  .cfg-incomplete-warning.show { display: block; }
  .cfg-incomplete-warning strong { color: #ffd591; }

  /* Legend block · CFG-CFG-1 v1.7 · housed in Required column (see earlier .cfg-legend-wrap block).
     This older "in Optional column" version is intentionally NOT redefined here — the canonical
     .cfg-legend rules above own the styling. */
  .cfg-legend-val {
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.10em;
    font-size: 10.5px;
  }
  .cfg-col-optional-flex {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .cfg-col-optional-flex .cfg-fields { flex: 1; }

  @media (max-width: 1100px) {
    .cfg-body { grid-template-columns: 1fr; }
    .cfg-col + .cfg-col { border-left: none; border-top: 1px solid var(--line); padding-top: 36px; margin-top: 36px; }
    .cfg-preview-grid { grid-template-columns: 1fr; }
    .cfg-preview-img { border-right: none; border-bottom: 1px solid var(--line); }
    .cfg-spec-grid { grid-template-columns: repeat(2, 1fr); }
    .cfg-spec-cell:nth-child(2n) { border-right: none; }
    .cfg-spec-cell:nth-child(n+3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 720px) {
    .cfg-fields { grid-template-columns: 1fr; }
    .cfg-spec-grid { grid-template-columns: 1fr; }
    .cfg-spec-cell { border-right: none; }
    .cfg-spec-cell:nth-child(n+2) { border-top: 1px solid var(--line); }
    .cfg-title { font-size: 28px; }
    .cfg-sku { font-size: 16px; }
  }

  /* SECTION 9 — Documentation & Resources
     Spec-mode pattern: 6-card primary grid (PDFs, IES bundle, CAD/Revit,
     compliance bundle) + secondary quick-link row (DLC QPL, TAA cert,
     warranty, spec catalog text). Each card is a download trigger; all
     cards have file-format / file-size pill labels. */
  .docs-section {
    background: var(--bg-page);
    padding: 88px 0 96px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .docs-inner { max-width: 1400px; margin: 0 auto; padding: 0 32px; }
  .docs-head  { text-align: center; margin-bottom: 48px; }
  .docs-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--brand-red);
    text-transform: uppercase;
    margin-bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .docs-eyebrow::before, .docs-eyebrow::after {
    content: ""; display: block; width: 28px; height: 1px; background: var(--brand-red);
  }
  .docs-title {
    font-size: 38px;
    font-weight: 700;
    letter-spacing: -0.005em;
    margin-bottom: 12px;
    line-height: 1.05;
  }
  .docs-sub {
    font-size: 15px;
    color: var(--text-secondary);
    max-width: 720px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Primary card grid — 4 cards across (Data Sheet, Install, IES, Submittal) */
  .docs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 32px;
  }
  .docs-card {
    background: var(--bg-spec);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 28px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s, background 0.2s;
    position: relative;
    overflow: hidden;
  }
  .docs-card::before {
    content: "";
    position: absolute;
    top: 0; left: 0;
    height: 3px; width: 0;
    background: var(--brand-red);
    transition: width 0.25s ease;
  }
  .docs-card:hover {
    border-color: rgba(243,39,64,0.45);
    transform: translateY(-2px);
    background: #2e3239;
  }
  .docs-card:hover::before { width: 100%; }

  .docs-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
  }
  .docs-card-icon {
    width: 56px;
    height: 56px;
    border-radius: 4px;
    background: rgba(243,39,64,0.10);
    border: 1px solid rgba(243,39,64,0.30);
    color: var(--brand-red);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .docs-card-icon svg { width: 28px; height: 28px; }
  .docs-card-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }
  .docs-card-format {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--line-medium);
    padding: 3px 8px;
    border-radius: 1px;
  }
  .docs-card-size {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  .docs-card-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.25;
    letter-spacing: -0.005em;
  }
  .docs-card-desc {
    font-size: 13.5px;
    color: var(--text-secondary);
    line-height: 1.55;
    flex: 1;
  }
  .docs-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 6px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .docs-card-cta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--brand-red);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: gap 0.18s;
  }
  .docs-card:hover .docs-card-cta { gap: 12px; }
  .docs-card-cta svg { width: 14px; height: 14px; }
  .docs-card-updated {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  /* Secondary quick-links row */
  .docs-secondary {
    background: var(--bg-spec);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 20px 24px;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px 28px;
    align-items: center;
  }
  .docs-secondary-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brand-red);
    font-weight: 700;
    white-space: nowrap;
  }
  .docs-secondary-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
  }
  .docs-secondary-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 600;
    transition: color 0.18s;
    white-space: nowrap;
    cursor: pointer;
  }
  .docs-secondary-link:hover { color: var(--brand-red); }
  .docs-secondary-link svg {
    width: 14px;
    height: 14px;
    color: var(--text-muted);
    transition: color 0.18s;
  }
  .docs-secondary-link:hover svg { color: var(--brand-red); }
  .docs-secondary-link.copied { color: #5fc77a; }
  .docs-secondary-link.copied svg { color: #5fc77a; }

  @media (max-width: 1280px) {
    .docs-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 1100px) {
    .docs-secondary { grid-template-columns: 1fr; gap: 10px; }
  }
  @media (max-width: 720px) {
    .docs-grid { grid-template-columns: 1fr; }
    .docs-title { font-size: 28px; }
  }

  /* SECTION 10 — LSPL Family (direct siblings within the LSPL Sports Lighting line).
     Sits between Documentation (Sec 9) and the page closer (Sec 11).
     Reuses .family-card styles from below; adds a "you-are-here" current-product
     tile so the user can place the Illuminator within the LSPL line. */
  .lspl-family-section {
    background: var(--bg-page);
    padding: 88px 0 96px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .lspl-family-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .lspl-family-head { text-align: center; margin-bottom: 40px; }
  /* §11 high-bay family grid · responsive · 4-col desktop → 2-col tablet → 1-col phone.
     The current product card (.is-current) takes the full row at 2-col so it stays prominent. */
  .lspl-family-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
    max-width: 1400px;
    margin: 40px auto 0;
  }
  /* "You are here" current-product card — visually distinct, not clickable */
  .family-card.is-current {
    background: linear-gradient(135deg, rgba(243,39,64,0.08) 0%, var(--bg-spec) 60%);
    border-color: rgba(243,39,64,0.45);
    cursor: default;
    pointer-events: none;
  }
  .family-card.is-current .family-card-img {
    background: rgba(243,39,64,0.06);
  }
  .family-card-here-badge {
    position: absolute;
    top: 12px; right: 12px;
    z-index: 2;          /* stack above the family-card product image */
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: white;
    background: var(--brand-red);
    padding: 4px 9px;
    border-radius: 1px;
  }
  .family-card.is-current .family-card-cta {
    color: var(--brand-red);
    pointer-events: none;
  }
  /* Honest-placeholder treatment for sibling cards whose positioning is awaiting James's review.
     Subtle dashed border + slight desaturation flag the TBD state without weakening the card. */
  .family-card.family-card-pending {
    border-style: dashed;
    border-color: rgba(255,255,255,0.18);
  }
  .family-card.family-card-pending .family-card-img { opacity: 0.78; }
  .family-card.family-card-pending:hover {
    border-color: rgba(243,39,64,0.55);
    border-style: solid;
  }
  .family-card.family-card-pending:hover .family-card-img { opacity: 1; }

  /* Mobile breakpoints — tablet collapses 4→2, phone collapses 2→1 */
  @media (max-width: 1180px) {
    .lspl-family-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
    .lspl-family-grid .family-card.is-current { grid-column: 1 / -1; }
    .lspl-family-grid .family-card.is-current .family-card-img { height: 200px; }
  }
  @media (max-width: 720px) {
    .lspl-family-grid { grid-template-columns: 1fr; gap: 16px; }
    .lspl-family-grid .family-card.is-current { grid-column: 1; }
    .lspl-family-grid .family-card.is-current .family-card-img { height: 160px; }
    .family-card-img { height: 140px; }
    .lspl-family-section { padding-left: 16px; padding-right: 16px; }
    .lspl-family-inner { padding: 0; }
    .closing-title { font-size: 28px; }
    .closing-sub { font-size: 14px; }
  }

  /* SECTION 12 — Page closer (Round Out the Project · Support · Great Rebates).
     Three layered components:
       (a) closing-family — 4 cross-line sister-product cards (Symmetry, proⒶRCH-III,
           Heritage, Pathfinder). Cross-shop within the v2 PDP buildout.
       (b) closing-pillars — 2-up Support + Rebates cards.
       (c) closing-cta-strip — site-wide red CTA bar ("same business day"). */
  .closing-section {
    background: var(--bg-page);
    padding: 88px 0 0;
    border-top: 1px solid var(--line);
  }
  .closing-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* 10A — Meet the Family */
  .closing-family { padding-bottom: 72px; }
  .closing-family-head { text-align: center; margin-bottom: 40px; }
  .closing-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--brand-red);
    text-transform: uppercase;
    margin-bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .closing-eyebrow::before, .closing-eyebrow::after {
    content: ""; display: block; width: 28px; height: 1px; background: var(--brand-red);
  }
  .closing-title {
    font-size: 38px;
    font-weight: 700;
    letter-spacing: -0.005em;
    margin-bottom: 12px;
    line-height: 1.05;
  }
  .closing-sub {
    font-size: 15px;
    color: var(--text-secondary);
    max-width: 720px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .closing-family-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-top: 40px;
  }
  .family-card {
    background: var(--bg-spec);
    border: 1px solid var(--line);
    border-radius: 4px;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s, transform 0.2s;
  }
  .family-card:hover {
    border-color: rgba(243,39,64,0.45);
    transform: translateY(-3px);
  }
  .family-card-img {
    background: var(--bg-darker);
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--line);
    color: rgba(255,255,255,0.65);
    position: relative;
  }
  .family-card-img svg { width: 60%; height: 60%; max-width: 130px; }
  /* Real product photo for LSPL Family cards. Same fit-in-box rule as the
     accessory cards: image fills available space without resizing the box. */
  .family-card-img .family-card-photo {
    max-width: 88%;
    max-height: 88%;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 8px 14px rgba(0,0,0,0.5));
  }
  .family-card-tag {
    position: absolute;
    top: 12px; left: 12px;
    z-index: 2;          /* stack above the family-card product image */
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.85);
    background: rgba(0,0,0,0.55);
    border: 1px solid rgba(255,255,255,0.10);
    padding: 4px 8px;
    border-radius: 1px;
  }
  .family-card-body {
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .family-card-cat {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-red);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .family-card-title {
    font-size: 19px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: -0.005em;
  }
  .family-card-desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.55;
    flex: 1;
  }
  .family-card-stats {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    line-height: 1.5;
    border-top: 1px solid var(--line);
    padding-top: 12px;
    margin-top: 4px;
  }
  .family-card-cta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    transition: color 0.18s, gap 0.18s;
  }
  .family-card:hover .family-card-cta { color: var(--brand-red); gap: 10px; }

  /* 10B — Support + Rebates 2-up pillars */
  .closing-pillars {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    padding-bottom: 72px;
    border-top: 1px solid var(--line);
    padding-top: 64px;
  }
  .pillar {
    background: var(--bg-spec);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 36px 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    position: relative;
    overflow: hidden;
  }
  .pillar-rebates {
    background: linear-gradient(135deg, #2c2118 0%, var(--bg-spec) 60%);
    border-color: rgba(243,39,64,0.20);
  }
  .pillar-icon {
    width: 52px;
    height: 52px;
    border-radius: 4px;
    background: rgba(243,39,64,0.10);
    border: 1px solid rgba(243,39,64,0.30);
    color: var(--brand-red);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pillar-icon svg { width: 26px; height: 26px; }
  .pillar-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.18em;
    color: var(--brand-red);
    text-transform: uppercase;
    font-weight: 700;
  }
  .pillar-title {
    font-size: 26px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.15;
    letter-spacing: -0.005em;
  }
  .pillar-body {
    font-size: 14.5px;
    color: var(--text-secondary);
    line-height: 1.65;
  }
  .pillar-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 16px 0;
    margin: 4px 0;
  }
  .pillar-stat {
    flex: 1;
    min-width: 120px;
    padding: 0 16px;
    border-right: 1px solid var(--line);
  }
  .pillar-stat:first-child { padding-left: 0; }
  .pillar-stat:last-child { border-right: none; padding-right: 0; }
  .pillar-stat-num {
    font-size: 22px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.1;
    white-space: nowrap;     /* keep multi-word values on a single row */
  }
  /* "DLC Premium" is wider than "2,400+" or "15-40%" — bring its size down
     so it still fits inside the equal-width stat cell without wrapping. */
  .pillar-stat:last-child .pillar-stat-num { font-size: 18px; }
  .pillar-stat-key {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-top: 4px;
  }
  .pillar-ctas {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 4px;
  }
  .pillar-cta {
    flex: 1;
    min-width: 150px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 20px;
    border-radius: 2px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.18s;
    border: 1px solid transparent;
    text-decoration: none;
    white-space: nowrap;
  }
  .pillar-cta.primary {
    background: var(--brand-red);
    color: white;
  }
  .pillar-cta.primary:hover { background: var(--brand-red-deep); }
  .pillar-cta.outline {
    background: transparent;
    color: var(--text-secondary);
    border-color: var(--line-medium);
  }
  .pillar-cta.outline:hover { color: var(--text-primary); border-color: var(--text-primary); }
  .pillar-cta svg { width: 14px; height: 14px; }

  /* 10C — Final red CTA strip (site-wide same-business-day promise) */
  .closing-cta-strip {
    background: var(--brand-red);
    color: white;
    padding: 22px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .closing-cta-strip-inner {
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .closing-cta-msg {
    font-size: 16px;
    line-height: 1.4;
  }

// =============================================================================
// SECTION 8 — Configurator (Build Your Model)
// State engine + chip click handler + dependency rules + live SKU encoder.
// All chips have data-field + data-val + data-code; required fields are
// single-select, optional fields are toggle (click again to deselect).
// =============================================================================
(function() {
  // Required and optional field IDs — mirror the data-field attrs in the markup.
  // Required: housing (4″/10W or 6″/15W), trim (Baffled/Smooth), finish (BK/BZ/W),
  //           pack (Single or 12-Pack carton — distributors won't accept ambiguity).
  // Companion pairings (separate SKU, not part of fixture order code):
  //   emergency (CRCU-EM24/JBM constⒶNT BBU) · sensor (MSP-SRI/20CM or /40CM contrⒶLS PIR) · housing_can (4 Gehry CRC variants).
  var REQUIRED  = ['housing', 'trim', 'finish', 'pack'];
  var OPTIONAL  = ['emergency', 'sensor', 'housing_can'];
  // No multi-select fields — every chip group on Nebula-II is single-pick.
  var MULTI     = [];
  // Companion fields don't append to the SKU — they render in the Pair With panel.
  var COMPANION = ['emergency', 'sensor', 'housing_can'];

  // SKU encoding rules — anchored to the canonical pattern
  // LDRR{410|615}-S5-N2/{B|S}/{BK|BZ|W}[/12PK]
  //   prefix      LDRR                   — no separator
  //   housing     {410|615}              — direct attach to LDRR
  //   (fixed)     -S5-N2                 — emitted automatically after housing
  //                                        when housing is set; encodes the
  //                                        5-CCTselect (S5) + Nebula-II (N2)
  //                                        family designators.
  //   trim        /{B|S}                 — leading slash
  //   finish      /{BK|BZ|W}             — leading slash
  //   pack        (blank)|/12PK          — leading slash, omitted when single
  // SKU_ORDER drives the segment order after the prefix+housing+S5-N2 block.
  var SKU_ORDER = ['trim', 'finish', 'pack'];
  // SEPARATOR map — how each segment attaches to the previous one.
  //   '/'  : leading slash (every Nebula-II segment after S5-N2)
  var SEP = {
    trim: '/', finish: '/', pack: '/'
  };

  // Lookup tables for live spec computation.
  // Wattage / lumens / efficacy reference the datasheet — 4000K row used as
  // representative since it's the factory-default ship CCT and the value
  // most often quoted on rebate paperwork.
  var SPEC_TABLE = {
    housing: {
      '410': { name: '4″ · 10W', wattage: '10W', lumens: '856 lm @ 4000K', lpw: '85.6 lm/W' },
      '615': { name: '6″ · 15W', wattage: '15W', lumens: '1,150 lm @ 4000K', lpw: '76.7 lm/W' }
    },
    trim: {
      'B': 'Baffled'   // Smooth (S) removed 2026-05-09 · Nebula-II ships baffled-only
    },
    finish: {
      'W':  'White',
      'BK': 'Black',
      'BZ': 'Bronze'
    },
    pack: {
      'SINGLE': 'Single unit',
      '12PK':   '12-pack carton'
    },
    // Live-preview image src per (housing × finish) — real Nebula-II product
    // photography. 6 distinct PNGs keyed by '{housing}_{finish}' (e.g. '410_W',
    // '615_BK'). Native RGBA cutouts from the PHOTOS folder · 4-inch BLACK
    // synthesized 2026-05-09 from the bronze 4-inch via hue-gated recolor
    // (preserves lens, bracket, wire, connector). JS reads finishImg[housing+'_'+finish]
    // and falls back to '410_W' (factory ship default) when either is unset.
    finishImg: {
      '410_W':  'assets/photos/nebula-ii/4in/Nebula-II-4in-W.png',
      '410_BK': 'assets/photos/nebula-ii/4in/Nebula-II-4in-BK.png',
      '410_BZ': 'assets/photos/nebula-ii/4in/Nebula-II-4in-BZ.png',
      '615_W':  'assets/photos/nebula-ii/6in/Nebula-II-6in-W.png',
      '615_BK': 'assets/photos/nebula-ii/6in/Nebula-II-6in-BK.png',
      '615_BZ': 'assets/photos/nebula-ii/6in/Nebula-II-6in-BZ.png'
    }
  };

  // Default starting state — empty (no chip preselected). User picks
  // housing/trim/finish in any order; counter band tracks 0/3 → 3/3.
  var DEFAULT_STATE = {};

  // (RAL Classic validation table removed — Nebula-II is a high-volume
  //  retrofit product with a fixed 3-finish ladder. No custom paint.)

  function init() {
    var section   = document.getElementById('configurator');
    if (!section) return;
    var counter   = document.getElementById('cfgCount');
    var counterEl = document.getElementById('cfgCounter');
    var resetBtn  = document.getElementById('cfgReset');
    var skuEl     = document.getElementById('cfgSku');
    var copyBtn   = document.getElementById('cfgSkuCopy');
    var copyLabel = document.getElementById('cfgSkuCopyLabel');
    var warning   = document.getElementById('cfgWarning');
    var ctaPrice  = document.getElementById('cfgCtaPrice');
    var ctaPdf    = document.getElementById('cfgCtaPdf');
    var chips     = section.querySelectorAll('.cfg-chip');
    var state     = Object.assign({}, DEFAULT_STATE);

    // ---- Chip click handler ----
    chips.forEach(function(chip) {
      chip.addEventListener('click', function() {
        if (chip.classList.contains('disabled')) return;
        var field    = chip.dataset.field;
        var val      = chip.dataset.val;
        var isOpt    = OPTIONAL.indexOf(field) >= 0;
        var isMulti  = MULTI.indexOf(field) >= 0;

        if (isMulti) {
          // Multi-select: store as array. Click toggles on/off independently.
          var arr = Array.isArray(state[field]) ? state[field].slice() : [];
          var i = arr.indexOf(val);
          if (i >= 0) arr.splice(i, 1); else arr.push(val);
          if (arr.length === 0) delete state[field]; else state[field] = arr;
        } else if (isOpt && state[field] === val) {
          // Single-select optional: clicking the active chip clears it
          delete state[field];
        } else {
          // Single-select required (or first pick on optional)
          state[field] = val;
        }
        applyState();
      });
    });

    // ---- Reset all ----
    resetBtn.addEventListener('click', function() {
      state = Object.assign({}, DEFAULT_STATE);
      applyState();
    });

    // ---- Apply state to UI ----
    function applyState() {
      // Update chip selected states (single-pick across the board on Nebula-II)
      chips.forEach(function(chip) {
        var f = chip.dataset.field;
        var v = chip.dataset.val;
        chip.classList.toggle('selected', state[f] === v);

        // Dependency: data-pair-housing restricts which can-pairing chips are
        // valid for the selected fixture aperture. CRC4-* requires 4″ housing,
        // CRC6-* requires 6″ housing. Disabled chip auto-clears if active.
        var pairHousing = chip.dataset.pairHousing;
        if (pairHousing) {
          var disabled = state.housing && state.housing !== pairHousing;
          chip.classList.toggle('disabled', !!disabled);
          if (disabled && state[f] === v) delete state[f];
        }
      });

      // Required-counter — straight count of REQUIRED keys present in state
      var filled = REQUIRED.filter(function(k) {
        return state[k] != null;
      }).length;
      counter.textContent = filled;
      counterEl.classList.toggle('complete', filled === REQUIRED.length);

      // SKU
      var complete = (filled === REQUIRED.length);
      renderSKU(complete);
      // Warning + CTAs
      warning.classList.toggle('show', !complete);
      ctaPrice.classList.toggle('disabled', !complete);
      ctaPdf.classList.toggle('disabled', !complete);
      copyBtn.disabled = !complete;
      // Reset copy-button state when SKU changes
      copyBtn.classList.remove('copied');
      copyLabel.textContent = 'Copy SKU';

      // Live specs + Pair With panel
      renderSpecs();
      renderPairings();
    }

    // ---- SKU encoder ----
    // Builds the canonical Nebula-II pattern:
    //   LDRR{410|615}-S5-N2/{B|S}/{BK|BZ|W}[/12PK]
    // Walks SKU_ORDER for fields after the LDRR + housing + S5-N2 block.
    // Companion fields (emergency, sensor, housing_can) never append.
    function renderSKU(complete) {
      var html = 'LDRR';

      // Housing — direct attach (no separator). Placeholder if not chosen.
      if (state.housing) {
        html += state.housing;
        // Fixed family designators: -S5-N2 (5-CCTselect, Nebula-II generation).
        // Only emitted once housing is chosen — hides the boilerplate while
        // the user is still in placeholder territory.
        html += '-S5-N2';
      } else {
        html += '<span class="placeholder">[410|615]</span>-S5-N2';
      }

      // Walk SKU_ORDER for the post-S5-N2 segments.
      SKU_ORDER.forEach(function(k) {
        var sep = Object.prototype.hasOwnProperty.call(SEP, k) ? SEP[k] : '/';
        var val = state[k];
        var isReq = REQUIRED.indexOf(k) >= 0;

        if (val == null) {
          if (isReq) html += sep + '<span class="placeholder">' + placeholderFor(k) + '</span>';
          return;
        }

        var chip = section.querySelector('.cfg-chip[data-field="' + k + '"][data-val="' + val + '"]');
        var code = chip ? chip.dataset.code : '';
        if (code === '') return;   // pack=SINGLE → blank, no segment emitted
        html += sep + code;
      });

      skuEl.innerHTML = html;
    }
    function placeholderFor(k) {
      return ({
        trim:   '[B]',
        finish: '[BK|BZ|W]',
        pack:   '[PACK]'
      })[k] || '[' + k.toUpperCase() + ']';
    }

    // ---- Live spec readout ----
    function renderSpecs() {
      var housingData = state.housing ? SPEC_TABLE.housing[state.housing] : null;
      setSpec('wattage', housingData ? housingData.wattage : null);
      setSpec('lumens',  housingData ? housingData.lumens  : null);
      setSpec('lpw',     housingData ? housingData.lpw     : null);

      // Finish — combine trim style + finish into one cell so the relationship
      // is visible (e.g. "Baffled · White"). Both required to populate.
      var finishCell = null;
      if (state.trim && state.finish) {
        finishCell = SPEC_TABLE.trim[state.trim] + ' · ' + SPEC_TABLE.finish[state.finish];
      } else if (state.finish) {
        finishCell = SPEC_TABLE.finish[state.finish] + ' (trim TBD)';
      } else if (state.trim) {
        finishCell = SPEC_TABLE.trim[state.trim] + ' (finish TBD)';
      }
      setSpec('finish', finishCell);

      // Swap the live-preview image src per (housing × finish) — 6 distinct
      // PNGs (4in/6in × W/BK/BZ). Soft cross-fade: opacity 0 → swap src →
      // opacity 1 (200ms). Default is 4-inch White (factory ship) until the
      // user picks both chips. Falls back gracefully if only one is set.
      var previewImg = document.getElementById('cfgPreviewImg');
      var housingKey = state.housing || '410';
      var finishKey  = state.finish  || 'W';
      var imgKey     = housingKey + '_' + finishKey;
      var newSrc = SPEC_TABLE.finishImg[imgKey] || SPEC_TABLE.finishImg['410_W'];
      if (previewImg && newSrc && !previewImg.src.endsWith(newSrc)) {
        previewImg.style.opacity = '0';
        setTimeout(function() {
          previewImg.src = newSrc;
          previewImg.style.opacity = '1';
        }, 180);
      }
    }

    // ---- Companion pairings panel ----
    // Walks the COMPANION fields and renders one "+ SKU · Name" line per
    // selected pairing. Hides the panel entirely when no pairings are picked.
    function renderPairings() {
      var panel = document.getElementById('cfgPairPanel');
      var list  = document.getElementById('cfgPairList');
      if (!panel || !list) return;
      var rows = [];
      COMPANION.forEach(function(field) {
        var val = state[field];
        if (!val) return;
        var chip = section.querySelector('.cfg-chip[data-field="' + field + '"][data-val="' + val + '"]');
        if (!chip) return;
        var sku  = chip.dataset.pairSku  || chip.dataset.code || val;
        var name = chip.dataset.pairName || sku;
        // Render Ⓐ glyph in pair-name if present (sensor entries carry it).
        var nameHtml = name.replace(/Ⓐ/g, '<span class="aa" aria-hidden="true">Ⓐ</span>');
        rows.push('<li style="display:flex; gap:8px; padding: 3px 0;">' +
                    '<span style="color:var(--brand-red); font-weight:700;">+</span>' +
                    '<span><strong>' + sku + '</strong><br/>' +
                      '<span style="color: var(--text-muted); font-size: 10px; letter-spacing: 0.04em;">' + nameHtml + '</span>' +
                    '</span>' +
                  '</li>');
      });
      list.innerHTML = rows.join('');
      panel.style.display = rows.length ? 'block' : 'none';
    }
    function setSpec(name, val) {
      var el = section.querySelector('[data-spec="' + name + '"]');
      if (!el) return;
      if (val == null || val === '—') {
        el.textContent = '—';
        el.classList.add('placeholder');
      } else {
        el.textContent = val;
        el.classList.remove('placeholder');
      }
    }

    // ---- Copy SKU ----
    copyBtn.addEventListener('click', function() {
      if (copyBtn.disabled) return;
      var txt = skuEl.textContent.trim();
      if (!txt) return;
      // Use Clipboard API where available, fallback to execCommand
      var done = function() {
        copyBtn.classList.add('copied');
        copyLabel.textContent = 'Copied ✓';
        setTimeout(function() {
          copyBtn.classList.remove('copied');
          copyLabel.textContent = 'Copy SKU';
        }, 1800);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(txt).then(done, done);
      } else {
        var ta = document.createElement('textarea');
        ta.value = txt;
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch(e){}
        document.body.removeChild(ta);
        done();
      }
    });

    // ---- Submittal PDF — opens submittal_template.html in new tab with full config in query string ----
    // The template auto-fills page-1 catalog number, quick specs, ordering-code matrix, and photometric data.
    // Manus replaces this with a real backend at /submittal-generator/?sku=… on production.
    // Canonical params per CFG-QA-1: sku · wattage · housing · trim · finish · pack
    //   plus optional companion line items (emergency / sensor / housing_can).
    function buildSubmittalUrl() {
      var sku = skuEl.textContent.trim();
      var housingData = state.housing ? SPEC_TABLE.housing[state.housing] : null;
      var paramsObj = {
        sku:     sku,
        housing: state.housing || '410',
        wattage: housingData ? housingData.wattage.replace('W', '') : '10',
        trim:    state.trim    || 'B',
        finish:  state.finish  || 'W',
        pack:    state.pack    || 'SINGLE'
      };
      // Append companion line-items so the submittal can include them as a
      // bill-of-materials block. Only emit keys the user actually selected.
      if (state.emergency)   paramsObj.emergency   = state.emergency;
      if (state.sensor)      paramsObj.sensor      = state.sensor;
      if (state.housing_can) paramsObj.housing_can = state.housing_can;
      var params = new URLSearchParams(paramsObj);
      return '/products/multi-family/nebula-ii/submittal/?' + params.toString();
    }
    ctaPdf.addEventListener('click', function(e) {
      if (ctaPdf.classList.contains('disabled')) { e.preventDefault(); return; }
      // Update href to current configurator state immediately before navigation
      ctaPdf.setAttribute('href', buildSubmittalUrl());
    });

    // Initial render
    applyState();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();

// CFG-STATE-1 — derive ship-tier (QS / WB / MTO) from selected chip badges, render
// canonical 3-state status panel. Self-contained module · no dependency on the
// configurator's state object · re-derives by walking selected chips on every click.
// Custom RAL forces MTO (custom paint = factory work).
// Cross-field rule (CFG-MF-10 · 2026-05-09 per James): Black or Bronze finish
// PAIRED with 12-Pack carton → MTO (only White ships QS in 12-Pack cartons).
(function() {
  function deriveShipTier() {
    var section = document.getElementById('configurator');
    if (!section) return 'QS';
    var chips = section.querySelectorAll('.cfg-chip.selected, .cfg-chip[aria-pressed="true"]');
    var worst = 'QS';
    var sawCustomRal = false;
    var selectedFinish = null;
    var selectedPack = null;
    chips.forEach(function(chip) {
      if (chip.dataset.field === 'finish') {
        if (chip.dataset.val === 'RAL') sawCustomRal = true;
        selectedFinish = chip.dataset.val;
      }
      if (chip.dataset.field === 'pack') selectedPack = chip.dataset.val;
      if (chip.querySelector('.cfg-chip-stock.mto')) worst = 'MTO';
      else if (chip.querySelector('.cfg-chip-stock.wb') && worst !== 'MTO') worst = 'WB';
    });
    // CFG-MF-10 · cross-field rule: Black/Bronze + 12-Pack carton → MTO.
    if ((selectedFinish === 'BK' || selectedFinish === 'BZ') && selectedPack === '12PK') {
      worst = 'MTO';
    }
    if (sawCustomRal) {
      var input = document.getElementById('cfgRalInput');
      if (input && input.value && /^[0-9]{4}$/.test(input.value)) return 'MTO';
    }
    return worst;
  }
  function refreshShipTier() {
    var tier = deriveShipTier();
    var rowEl = document.getElementById('cfgShipTier');
    var iconEl = document.getElementById('cfgShipTierIcon');
    var textEl = document.getElementById('cfgShipTierText');
    var stockEl = document.getElementById('cfgShipTierStock');
    if (!rowEl || !iconEl || !textEl || !stockEl) return;
    if (tier === 'QS') {
      rowEl.style.background = 'rgba(95,199,122,0.08)';
      rowEl.style.border = '1px solid rgba(95,199,122,0.40)';
      iconEl.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#7fc998" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
      textEl.innerHTML = '<strong style="color:#9bd6b1;">QuickShip · à-la-carte assembly</strong> · <span style="color:var(--text-secondary);">All selected components in stock — ships 2-3 day.</span>';
      stockEl.textContent = 'QuickShip · 2-3 day';
      stockEl.style.color = '#9bd6b1';
    } else if (tier === 'WB') {
      rowEl.style.background = 'rgba(96,168,255,0.08)';
      rowEl.style.border = '1px solid rgba(96,168,255,0.40)';
      iconEl.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#7fb6ff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>';
      textEl.innerHTML = '<strong style="color:#a8c9ff;">Workbench Assembly · ~1-3 wk</strong> · <span style="color:var(--text-secondary);">One or more selected components are workbench-assembled to order.</span>';
      stockEl.textContent = 'WB · ~1-3 wk';
      stockEl.style.color = '#a8c9ff';
    } else {
      rowEl.style.background = 'rgba(255,159,28,0.08)';
      rowEl.style.border = '1px solid rgba(255,159,28,0.40)';
      iconEl.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#ffb14d" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
      textEl.innerHTML = '<strong style="color:#ffb14d;">Custom build · Made-to-Order · ~4-6 wk</strong> · <span style="color:var(--text-secondary);">One or more selected components are MTO (custom finish, MTO option, or non-stocked variant).</span>';
      stockEl.textContent = 'MTO · ~4-6 wk';
      stockEl.style.color = '#ffb14d';
    }
  }
  function init() {
    var section = document.getElementById('configurator');
    if (!section) return;
    section.addEventListener('click', function(e) {
      if (e.target.closest('.cfg-chip')) setTimeout(refreshShipTier, 50);
    });
    var ralInput = document.getElementById('cfgRalInput');
    if (ralInput) ralInput.addEventListener('input', function() { setTimeout(refreshShipTier, 50); });
    refreshShipTier();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();

// Section 3 — Motion video carousel
(function() {
  // 3 production video clips pulled from the live Nebula Series PDP CDN.
  // Source: archipelagolighting.com/products/nebula-series-row-16
  var clips = [
    { url: '/products/multi-family/nebula-ii/assets/videos/nebula-ii-overview.mp4', tag: 'PRODUCT OVERVIEW',  title: 'LDRR Nebula-II — 4″ and 6″ retrofit downlights at a glance.' },
    { url: '/products/multi-family/nebula-ii/assets/videos/nebula-ii-install.mp4', tag: 'E26 RETROFIT INSTALL', title: 'Twist-and-lock into existing housings — sub-90-second install per fixture.' },
    { url: '/products/multi-family/nebula-ii/assets/videos/nebula-ii-cctselect.mp4', tag: '5-CCTSELECT DIAL',  title: 'Field-set 2700K – 5000K from the dial inside the housing.' }
  ];
  function init() {
    var video    = document.getElementById('motionVideo');
    var caption  = document.getElementById('motionCaption');
    var dotsRow  = document.getElementById('motionDots');
    var progress = document.getElementById('motionProgressBar');
    if (!video || !caption || !dotsRow || !progress) return;
    var idx = 0;
    var ticker;

    function set(i) {
      idx = (i + clips.length) % clips.length;
      var c = clips[idx];
      video.src = c.url;
      video.load();
      var play = video.play();
      if (play && typeof play.catch === 'function') play.catch(function(){});
      caption.innerHTML =
        '<div class="motion-caption-eyebrow sec-eyebrow">' + (idx + 1).toString().padStart(2, '0') + ' / ' + clips.length.toString().padStart(2, '0') + ' · ' + c.tag + '</div>' +
        '<div class="motion-caption-title">' + c.title + '</div>';
      dotsRow.querySelectorAll('button').forEach(function(b, n) {
        b.classList.toggle('active', n === idx);
        b.setAttribute('aria-selected', n === idx ? 'true' : 'false');
      });
      progress.style.width = '0%';
    }

    // Build dots
    dotsRow.innerHTML = clips.map(function(c, n) {
      var num = (n + 1).toString().padStart(2, '0');
      return '<button type="button" data-i="' + n + '" role="tab"' +
             (n === 0 ? ' class="active" aria-selected="true"' : ' aria-selected="false"') +
             '>' + num + ' · ' + c.tag + '</button>';
    }).join('');
    dotsRow.querySelectorAll('button').forEach(function(b) {
      b.addEventListener('click', function() {
        clearInterval(ticker);
        set(parseInt(b.dataset.i, 10));
        startTicker();
      });
    });

    // Progress bar — animates to 100% over the auto-advance window
    function startTicker() {
      var DURATION = 6000; // 6s per clip auto-advance
      var start = Date.now();
      progress.style.width = '0%';
      ticker = setInterval(function() {
        var pct = Math.min(100, ((Date.now() - start) / DURATION) * 100);
        progress.style.width = pct + '%';
        if (pct >= 100) {
          clearInterval(ticker);
          set(idx + 1);
          startTicker();
        }
      }, 60);
    }

    // If a clip fails to load, skip to next after a brief moment
    video.addEventListener('error', function() {
      clearInterval(ticker);
      setTimeout(function() { set(idx + 1); startTicker(); }, 500);
    });

    set(0);
    startTicker();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>


<script>
/* =============================================================================
   CFG-NAV-1 · Sticky-nav scroll-spy
   ----------------------------------------------------------------------------
   IntersectionObserver watches each section the sticky-nav links to. The link
   whose target is "most visible" gets `.is-current` (white bg + red text · the
   visual inverse of `.primary`). One observer, one Map, one CSS class toggle.
   The Pricing & Availability primary button is NOT a section anchor (its href
   is /pricing-availability/), so it's excluded from the spy by the
   `a[href^="#"]` selector below.
   ============================================================================= */
(function() {
  var nav = document.querySelector('.sticky-nav');
  if (!nav) return;
  var links = Array.prototype.slice.call(nav.querySelectorAll('a[href^="#"]'));
  if (!links.length) return;
  var entries = [];
  links.forEach(function(a) {
    var id = a.getAttribute('href').slice(1);
    var sec = id ? document.getElementById(id) : null;
    if (sec) entries.push({ sec: sec, link: a, ratio: 0 });
  });
  if (!entries.length) return;
  function update() {
    var best = null, bestRatio = 0;
    entries.forEach(function(e) { if (e.ratio > bestRatio) { bestRatio = e.ratio; best = e; } });
    entries.forEach(function(e) { e.link.classList.toggle('is-current', e === best && bestRatio > 0); });
  }
  var io = new IntersectionObserver(function(items) {
    items.forEach(function(item) {
      entries.forEach(function(e) { if (e.sec === item.target) e.ratio = item.intersectionRatio; });
    });
    update();
  }, {
    rootMargin: '-20% 0px -55% 0px',
    threshold: [0, 0.1, 0.25, 0.5, 0.75, 1.0]
  });
  entries.forEach(function(e) { io.observe(e.sec); });
})();
</script>


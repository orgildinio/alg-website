            <div class="cfg-chips">
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="housing_can" data-val="CRC4_E26" data-code="CRC4-SB/E26" data-pair-sku="CRC4-SB/E26" data-pair-name="CRC4-SB/E26 · 4″ Pre-Wired Can" data-pair-housing="410">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">CRC4-SB/E26</span>
                <span class="cfg-chip-code">+ 4″ E26</span>
              </button>
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="housing_can" data-val="CRC4_T24" data-code="CRC4-SB/T24" data-pair-sku="CRC4-SB/T24" data-pair-name="CRC4-SB/T24 · 4″ IC-Rated Can" data-pair-housing="410">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">CRC4-SB/T24</span>
                <span class="cfg-chip-code">+ 4″ IC/AT</span>
              </button>
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="housing_can" data-val="CRC6_E26" data-code="CRC6-SB/E26" data-pair-sku="CRC6-SB/E26" data-pair-name="CRC6-SB/E26 · 6″ Pre-Wired Can" data-pair-housing="615">
                <span class="cfg-chip-stock qs">QS</span>

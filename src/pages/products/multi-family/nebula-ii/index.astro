                <span class="cfg-chip-val">White ★</span>
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-code">/W</span>
              </button>
              <button type="button" class="cfg-chip cfg-chip-finish" data-field="finish" data-val="BK" data-code="BK">
                <span class="cfg-finish-swatch" style="background:#1a1a1a;"></span>
                <span class="cfg-chip-val">Black</span>
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-code">/BK</span>
              </button>
              <button type="button" class="cfg-chip cfg-chip-finish" data-field="finish" data-val="BZ" data-code="BZ">
                <span class="cfg-finish-swatch" style="background:#5a4530;"></span>
                <span class="cfg-chip-val">Bronze</span>
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-code">/BZ</span>
              </button>
            </div>
          </div>

        </div>
      </div>

      <!-- ============== OPTIONAL COLUMN ============== -->

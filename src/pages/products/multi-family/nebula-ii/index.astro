<script>
// Carousel autoplay — count is read from actual DOM so adding/removing slides
// doesn't drift the modulo math.
(function() {
  var track = document.getElementById('carouselTrack');
  var dots  = document.querySelectorAll('#carouselDots > span');
  var slides = track ? track.querySelectorAll('.carousel-slide').length : 0;
  if (!track || !slides) return;
  var idx = 0;
  function go(i) {
    idx = (i + slides) % slides;
    track.style.transform = 'translateX(-' + (idx * 100) + '%)';
    dots.forEach(function(d, n) { d.classList.toggle('active', n === idx); });
  }
  var timer = setInterval(function() { go(idx + 1); }, 5000);
  dots.forEach(function(d) {
    d.addEventListener('click', function() {
      clearInterval(timer);
      go(parseInt(d.dataset.i, 10));
      timer = setInterval(function() { go(idx + 1); }, 5000);
    });
  });
})();

// =============================================================================
// Section 5 — constⒶNT & contrⒶLS · Ceiling-Mount ⒶCS Solutions
// Platform tab → swap sensor image + body copy + per-tab CTA, trigger ripple shockwave
// =============================================================================
(function() {
  // Per-platform body copy. Specs verified against the 3 source datasheets 2026-05-09.
  var copy = {
    em24:  "24W constant-power emergency LED driver with integrated J-Box mount — UL 924 listed, 90-min runtime, LiFePO4 self-protecting battery, 120 VAC universal input, test switch with red LED indicator. Quick-install (no fixture removal) into 4″/5″/6″/7″ round or octagonal J-Boxes. planoⒶRCH series compatible · 5-year warranty.",
    msp20: "Ceiling-mount BLE SigMesh occupancy sensor — 20FT max mounting height, 360° PIR detection, 40FT diameter coverage at 20FT mount. Dual-function PIR + light sensor with daylight harvesting, time-of-day dimming, and 10A relay (resistive). Interchangeable lens system (low-bay default + high-bay included) for aisle, corridor, or semi-sphere patterns. UL Listed · IP20 · ⒶCS platform · 100-277VAC.",
    msp40: "High-bay ceiling-mount BLE SigMesh PIR sensor — 40FT max height, wide-area detection for warehouse, distribution, and industrial corridors. DLC NLC qualified · 500-node mesh capacity · ⒶCS by ALG app commissioning. 120-277V line voltage · cloud energy analytics · zone scheduling · utility rebate eligible. UL Listed · IP20."
  };
  // Per-platform CTA target. EM24 → its own product application page (yet to be built);
  // both MSP-SRI sensors → contrⒶLS family page.
  var cta = {
    em24:  { href: '/products/crcu-em24-jbm/', label: 'Discover CRCU-EM24/JBM &rarr;' },
    msp20: { href: '/products/contrals/',       label: 'Discover contrⒶLS &rarr;' },
    msp40: { href: '/products/contrals/',       label: 'Discover contrⒶLS &rarr;' }
  };
  function init() {
    var tabs = document.querySelectorAll('.tac-callout-tab');
    var sensors = document.querySelectorAll('.tac-sensor-svg');
    var copyEl = document.getElementById('tacCalloutCopy');
    var ctaEl = document.getElementById('tacCalloutCta');
    var ctaLabelEl = document.getElementById('tacCalloutCtaLabel');
    var wave = document.getElementById('tacShockwave');
    if (!tabs.length || !sensors.length || !wave) return;
    function select(platform) {
      tabs.forEach(function(t) {
        var isActive = t.dataset.platform === platform;
        t.classList.toggle('active', isActive);
        t.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
      sensors.forEach(function(s) {
        s.classList.toggle('is-active', s.dataset.platform === platform);
      });
      if (copyEl && copy[platform]) copyEl.textContent = copy[platform];
      if (ctaEl && ctaLabelEl && cta[platform]) {
        ctaEl.setAttribute('href', cta[platform].href);
        ctaLabelEl.innerHTML = cta[platform].label;
      }
      // Trigger shockwave: remove + re-add class to restart animation
      wave.classList.remove('is-rippling');
      void wave.offsetWidth;
      wave.classList.add('is-rippling');
    }
    tabs.forEach(function(t) {
      t.addEventListener('click', function() { select(t.dataset.platform); });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();


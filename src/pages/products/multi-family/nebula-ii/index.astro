                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">MSP-SRI/20CM</span>
                <span class="cfg-chip-code">+ 20FT · HD/ACS</span>
              </button>
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="sensor" data-val="MSP_SRI_40" data-code="MSP-SRI/40CM/HD/ACS" data-pair-sku="MSP-SRI/40CM/HD/ACS" data-pair-name="MSP-SRI/40CM/HD/ⒶCS — 40FT High-Bay BLE SigMesh PIR Sensor">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">MSP-SRI/40CM</span>
                <span class="cfg-chip-code">+ 40FT · HD/ACS</span>

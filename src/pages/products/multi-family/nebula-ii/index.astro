<!-- ============================================================================
     SECTION 8 — Configurator (Build Your Model)
     7 required fields + 5 optional fields. SKU is built live by the JS engine
     below. The chip pattern + SKU encoder is the canonical template — for the
     other 4 v2 PDPs (pro<span class="aa">Ⓐ</span>RCH-III, Nebula-II, Symmetry, Titan), only the
     CFG_FIELDS + CFG_SPECS_FN need to change.
     Anchor: #configurator (already wired into sticky-nav).
     ============================================================================ -->
<section class="cfg-section" id="configurator">
  <div class="section-inner cfg-inner">

    <div class="cfg-head">
      <div class="cfg-eyebrow sec-eyebrow">Build Your Model</div>
      <h2 class="cfg-title sec-title">>Configure Your Nebula-II</h2>
      <p class="cfg-sub">
        Every option below maps to the LDRR Nebula-II order code. Selections build the SKU live.
        <small>5-CCTselect lives on the fixture (not the SKU).</small>
      </p>
    </div>

    <div class="cfg-counter-band">
      <div class="cfg-counter" id="cfgCounter">
        <strong id="cfgCount">0</strong> of <strong>4</strong> required selected
      </div>
      <button type="button" class="cfg-reset" id="cfgReset">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="1 4 1 10 7 10"/>
          <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
        </svg>
        Reset all options
      </button>
    </div>

    <div class="cfg-body">
      <!-- ============== REQUIRED COLUMN ============== -->
      <div class="cfg-col">
        <div class="cfg-col-head">
          <div class="cfg-col-title cfg-col-title-required">Required</div>
          <div class="cfg-col-meta">4 fields · all must be set</div>
        </div>
        <div class="cfg-fields">

          <!-- Housing — combined diameter + wattage selector. Maps to the
               '410' (4″ · 10W) or '615' (6″ · 15W) segment of the order code.
               Both are QuickShip — multi-family is a high-volume QS-only line. -->
          <div class="cfg-field" data-field="housing" style="grid-column: 1 / -1;">
            <div class="cfg-field-label">Aperture &amp; Wattage <span class="req">*</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip" data-field="housing" data-val="410" data-code="410">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">4″ · 10W</span>
                <span class="cfg-chip-code">LDRR410</span>
              </button>
              <button type="button" class="cfg-chip" data-field="housing" data-val="615" data-code="615">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">6″ · 15W</span>
                <span class="cfg-chip-code">LDRR615</span>
              </button>
            </div>
          </div>

          <!-- Trim Style — Baffled (B) for glare-controlled in-unit living
               and bedrooms. Smooth removed 2026-05-09 per James — Nebula-II
               ships baffled-only across all housings/finishes.
               CFG-MF-8 · paired with Pack Config on the same row to balance
               the column visually (no orphan empty grid cell). -->
          <div class="cfg-field" data-field="trim">
            <div class="cfg-field-label">Trim Style <span class="req">*</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip" data-field="trim" data-val="B" data-code="B">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">Baffled ★</span>
                <span class="cfg-chip-code">/B</span>
              </button>
            </div>
          </div>

          <!-- Pack Configuration — required SKU segment. Single = no suffix,
               12-Pack appends /12PK. Distributors order in 12-pack cartons
               for full-floor refurbs; single units for spot replacement.
               CFG-MF-8 · pairs with Trim Style on the same row. -->
          <div class="cfg-field" data-field="pack">
            <div class="cfg-field-label">Pack Configuration <span class="req">*</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip" data-field="pack" data-val="SINGLE" data-code="">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">Single Unit ★</span>
                <span class="cfg-chip-code">(blank)</span>
              </button>
              <button type="button" class="cfg-chip" data-field="pack" data-val="12PK" data-code="12PK">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">12-Pack Carton</span>
                <span class="cfg-chip-code">/12PK</span>
              </button>
            </div>
          </div>

          <!-- Finish — three QS finishes that match the trim-ring SKU ladder
               (LDRR&#123;4|6&#125;-SE/&#123;BK|BZ|W&#125;). Black, Bronze, White all QS at the
               single-unit level. Black + Bronze flip to MTO when paired with
               12-Pack carton (only White ships QS in 12-Pack). The chip
               badges show the *baseline* (single-unit) tier; the cross-field
               rule lives in CFG-STATE-1 below. 2026-05-09 · per James.
               CFG-MF-8 · full-width row 3 (3 chips fit naturally side-by-side). -->
          <div class="cfg-field" data-field="finish" style="grid-column: 1 / -1;">
            <div class="cfg-field-label">Finish <span class="req">*</span></div>
            <div class="cfg-chips">

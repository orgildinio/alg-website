<!-- ============= URL PARAM POPULATION + AUTO-PRINT ============= -->
<script>
(function() {
  // --- PARSE URL PARAMS · Lunar Eclipse configurator → submittal pipeline ---
  // Canonical params: sku · housing · wattage · finish (always B)
  //                 + companion: emergency · sensor (no bilevel · no jbx)
  var params = new URLSearchParams(window.location.search);
  var sku       = params.get('sku')       || 'LDLL09-LE1S5/B';
  var housing   = params.get('housing')   || '09';
  var pack      = params.get('pack')      || 'SINGLE';
  var finish    = params.get('finish')    || 'B';
  var emergency = params.get('emergency') || '';
  var sensor    = params.get('sensor')    || '';
  var autoprint = params.get('autoprint') !== '0';   // default ON

  // --- 3-SIZE LOOKUP TABLE (Lunar Eclipse Datasheet § Model Specifications p.2) ---
  // Lumens are 4000K (the configurator's representative CCT); peak cd from a
  // calibrated 120° wide-flood cosine model (lumens / π).
  // Carton: 12-pack for 5″ · 6-pack for 7/9″ (Datasheet p.4).
  var sizeData = {
    '05': { in: 5, watt: 10, lumens: '790',   lpw: '79', peak: '252', diameter: '5.71″ (145mm)', depth: '0.98″', carton: '12-pack' },
    '07': { in: 7, watt: 15, lumens: '1,185', lpw: '79', peak: '377', diameter: '7.48″ (190mm)', depth: '1.10″', carton: '6-pack'  },
    '09': { in: 9, watt: 18, lumens: '1,510', lpw: '84', peak: '481', diameter: '8.86″ (225mm)', depth: '1.10″', carton: '6-pack'  }
  };
  var sd = sizeData[housing] || sizeData['09'];

  // --- AUTOFILL CATALOG NUMBER (4 page headers + project info form + control bar) ---
  document.querySelectorAll('#catNum, #catNum2, #catNum3, #catNum4, #liveSku').forEach(function(el) {
    el.textContent = sku;
  });
  var pi = document.getElementById('piCatNum');
  if (pi) pi.textContent = sku;

  // ===== EDITABLE CATALOG NUMBER (§C 2026-05-18) =====
  (function setupEditableCatalogNumber(){
    var originalSku = sku;
    var editor = document.getElementById('catNum');
    if (!editor) return;
    function sweepTextNodes(root, fromStr, toStr){
      if (!fromStr || fromStr === toStr) return;
      var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
        acceptNode: function(n){
          var p = n.parentNode;
          while (p) {
            if (p === editor) return NodeFilter.FILTER_REJECT;
            if (p.tagName === 'SCRIPT' || p.tagName === 'STYLE') return NodeFilter.FILTER_REJECT;
            p = p.parentNode;
          }
          return n.nodeValue.indexOf(fromStr) !== -1 ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
        }
      });
      var nodes = [];
      while (walker.nextNode()) nodes.push(walker.currentNode);
      nodes.forEach(function(n){ n.nodeValue = n.nodeValue.split(fromStr).join(toStr); });
    }
    function applyOverride(newVal){
      var override = (newVal || '').replace(/[\r\n]+/g, ' ').trim().slice(0, 40);
      if (!override) override = originalSku;
      ['catNum2', 'catNum3', 'catNum4', 'piCatNum', 'liveSku'].forEach(function(id){
        var el = document.getElementById(id);
        if (el) el.textContent = override;
      });
      var spec = document.getElementById('specsEyebrow');
      if (spec) {
        var parts = spec.textContent.split(' · ');
        if (parts.length === 2) spec.textContent = parts[0] + ' · ' + override;
      }
      sweepTextNodes(document.body, originalSku, override);
      document.title = document.title.replace(originalSku, override);
    }
    var currentDisplay = originalSku;
    editor.addEventListener('input', function(){
      var newVal = (editor.textContent || '').replace(/[\r\n]+/g, ' ').slice(0, 40);
      sweepTextNodes(document.body, currentDisplay, newVal || originalSku);
      ['catNum2', 'catNum3', 'catNum4', 'piCatNum', 'liveSku'].forEach(function(id){
        var el = document.getElementById(id);
        if (el) el.textContent = newVal || originalSku;
      });
      var spec = document.getElementById('specsEyebrow');
      if (spec) {
        var parts = spec.textContent.split(' · ');
        if (parts.length === 2) spec.textContent = parts[0] + ' · ' + (newVal || originalSku);
      }
      document.title = document.title.replace(currentDisplay, newVal || originalSku);
      currentDisplay = newVal || originalSku;
    });
    editor.addEventListener('blur', function(){
      var v = editor.textContent.trim();
      if (!v) { editor.textContent = originalSku; applyOverride(originalSku); currentDisplay = originalSku; }
    });
    editor.addEventListener('keydown', function(e){
      if (e.key === 'Enter') { e.preventDefault(); editor.blur(); }
    });
  })();


  // --- AUTOFILL PRODUCT TITLE ---
  document.getElementById('productTitle').textContent =
    'Lunar Eclipse Series · ' + sd.in + '″ · ' + sd.watt + 'W · Trimless Surface-Mount Puck (Black)';

  // --- AUTOFILL QUICK SPECS (4000K representative row) ---
  document.getElementById('qsLumens').innerHTML = sd.lumens + '<span class="qs-unit">lm</span>';
  document.getElementById('qsWatts').innerHTML  = sd.watt   + '<span class="qs-unit">W</span>';
  document.getElementById('qsLpw').innerHTML    = sd.lpw    + '<span class="qs-unit">lm/W</span>';

  // --- AUTOFILL HERO IMAGE — Lunar Eclipse is Black-only ---
  var heroImg = document.getElementById('heroImg');
  if (heroImg) heroImg.src = '/products/multi-family/lunar-eclipse/assets/finishes/lunar-eclipse-finish-black.png';

  // Issue 6 — photometric polar plot: swap per size+CCT
  var polarImg = document.getElementById('polarImg');
  if (polarImg) {
    polarImg.src = '/products/multi-family/lunar-eclipse/assets/photometrics/lunar-eclipse_' + housing + '_' + cct + '.svg';
  }

  // --- AUTOFILL ORDERING CODE BREAKDOWN ---
  // Lunar Eclipse SKU pattern: LDLL{nn}{ww}-LE1S5/B
  //   ocHousing = 4-digit aperture+wattage segment (e.g. 0918)
  //   ocFinish  = always B
  //   (no shape segment — Round-only · no Square variant)
  document.getElementById('ocHousing').textContent = housing;
  var ocTrim = document.getElementById('ocTrim');
  if (ocTrim) ocTrim.textContent = '— (Round only · trimless)';
  document.getElementById('ocFinish').textContent  = 'B (Black only)';

  // --- AUTOFILL DIMENSIONS (page 3) per size ---
  var specOd     = document.getElementById('specOd');     if (specOd)     specOd.textContent     = sd.diameter + ' (LDLL' + housing + '-LE1)';
  var specAp     = document.getElementById('specAp');     if (specAp)     specAp.textContent     = '— (surface-mount · no aperture cut)';
  var specCutout = document.getElementById('specCutout'); if (specCutout) specCutout.textContent = '— (no cut-out · mounts on standard 2.75″ or 3.50″ J-box)';
  var specRecess = document.getElementById('specRecess'); if (specRecess) specRecess.textContent = '0″ (surface-mount · flush)';
  var specDepth  = document.getElementById('specDepth');  if (specDepth)  specDepth.textContent  = sd.depth + ' (overall puck depth)';
  var specWeight = document.getElementById('specWeight');
  if (specWeight) {
    var packLabel = pack === '24PK' ? '24-pack contractor carton' : (sd.carton + ' (single-unit standard)');
    specWeight.textContent = packLabel + ' (per Datasheet p.4)';
  }
  var mountStd   = document.getElementById('mountStd');   if (mountStd)   mountStd.textContent   = '2.75″ standard J-box';
  var mountT24   = document.getElementById('mountT24');   if (mountT24)   mountT24.textContent   = '3.50″ standard J-box';
  var dimTopW    = document.getElementById('dimTopWidth');if (dimTopW)    dimTopW.textContent    = 'Ø ' + sd.diameter;
  var dimAp      = document.getElementById('dimAperture');if (dimAp)      dimAp.textContent      = 'edge-lit PMMA face · trimless';
  var dimDp      = document.getElementById('dimDepth');   if (dimDp)      dimDp.textContent      = 'depth ' + sd.depth;
  var dimRc      = document.getElementById('dimRecess');  if (dimRc)      dimRc.textContent      = 'surface-mount · 0″ recess';

  // --- AUTOFILL PHOTOMETRIC PAGE 4 ---
  document.getElementById('photoEyebrow').textContent =
    '120° wide-flood (edge-lit PMMA) · LDLL' + housing + ' · ' + sd.watt + 'W · 4000K · Lunar Eclipse trimless black';
  document.getElementById('photoPeak').textContent    = sd.peak + ' cd';
  document.getElementById('photoLumens').textContent  = sd.lumens + ' lm';
  document.getElementById('photoIesFile').textContent = 'LDLL' + housing + '-LE1-4000K.IES';

  // --- COMPANION BOM (Page 1) — Lunar Eclipse ladder ---
  // Same constⒶNT EMB + contrⒶLS by ⒶCS ladder as Eclipse-II. NO Eclipse-II
  // Exclusive accessories (LDLL-E2/MSP/W and LDLL-E2/JBX are Eclipse-II only).
  var pairMap = {
    // const⒝NT EMB ladder
    'EM08':           { sku: 'EM08',            name: 'EM08 — 8W Field-Install BBU' },
    'EM08-XD':        { sku: 'EM08-XD',         name: 'EM08-XD — 8W Extended-Discharge 180 min' },
    'EM15':           { sku: 'EM15',            name: 'EM15 — 15W Field-Install BBU' },
    'EM15-CL':        { sku: 'EM15-CL',         name: 'EM15-CL — 15W + const<span class="aa">Ⓐ</span>NTLink (NLC self-test)' },
    'EM25':           { sku: 'EM25',            name: 'EM25 — 25W High-Output BBU' },
    'EM24-JBM':       { sku: 'CRCU-EM24/JBM',   name: 'EM24 — 24W J-Box Quick-Install (remote mount)' },
    // contr⒝LS by ⒝CS
    'MSP-20CM':       { sku: 'MSP-20CM-ACS',    name: 'MSP-20CM/<span class="aa">Ⓐ</span>CS — 20 FT Wide-Angle PIR' },
    'MSP-40CM':       { sku: 'MSP-40CM-ACS',    name: 'MSP-40CM/<span class="aa">Ⓐ</span>CS — 40 FT High-Bay PIR' },
    'MSX-LV20':       { sku: 'MSX-LV20-ACS',    name: 'MSX-LV20/<span class="aa">Ⓐ</span>CS — Low-Voltage Controller / Power Pack' },
    '50WM':           { sku: '50WM-ACS',        name: '50WM/<span class="aa">Ⓐ</span>CS — Battery-Free Kinetic Switch' }
  };
  var bomEntries = [];
  if (emergency) bomEntries.push(pairMap[emergency]);
  if (sensor)    bomEntries.push(pairMap[sensor]);
  bomEntries = bomEntries.filter(Boolean);

  if (bomEntries.length) {
    var bomList = document.getElementById('bomList');
    if (bomList) {
      bomList.innerHTML = bomEntries.map(function(e) {
        return '<li><span class="plus">+</span><span><strong>' + e.sku + '</strong>' +
               '<span class="pair-name">' + e.name + '</span></span></li>';
      }).join('');
      var bomPanel = document.getElementById('bomPanel');
      if (bomPanel) bomPanel.style.display = 'block';
    }
  }

  // --- LIVE DATE ---
  var d = new Date();
  var liveDate = document.getElementById('liveDate');
  if (liveDate) liveDate.textContent = d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' });
  var revStr = d.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit' }).replace('/', '-');
  var revDate = document.getElementById('revDate');
  if (revDate) revDate.textContent = revStr;
  document.querySelectorAll('.rev-date').forEach(function(el) { el.textContent = revStr; });

  // --- AUTO-PRINT ---
  // Fires window.print() 600 ms after load — long enough for the browser to
  // paint the 4 pages and load the hero image. Skippable with ?autoprint=0.
  if (autoprint) {
    window.addEventListener('load', function() {
      setTimeout(function() { window.print(); }, 600);
    });
  }
})();
</script>

</body>
</html>


<!-- ============= URL PARAM POPULATION + AUTO-PRINT ============= -->
<script>
(function() {
  // --- PARSE URL PARAMS · Gehry configurator → submittal pipeline ---
  // Canonical params: sku · size · base
  //                 + companions: module + module_sku + module_name · lamp + lamp_sku
  // Finish (/WH) field was retired 2026-05-09 — Gehry ships factory-default aluminum.
  // CFG-COMPANION-SIZE-MATCH: companion module SKU is pre-resolved upstream in
  // the configurator (CRC4 → 4″ module SKU; CRC6 → 6″) so the BOM ships a real,
  // orderable line item rather than a family placeholder.
  var params = new URLSearchParams(window.location.search);
  var sku        = params.get('sku')        || 'CRC6-SB-E26';
  var size       = params.get('size')       || '6';      // 4 | 6
  var base       = params.get('base')       || 'E26';    // E26 | T24
  var module     = params.get('module')     || '';       // family chip val (e.g. NEBULA-II)
  var moduleSku  = params.get('module_sku') || '';       // resolved size-matched SKU
  var moduleName = params.get('module_name')|| '';       // resolved descriptor (incl. size note)
  var lamp       = params.get('lamp')       || '';       // chip val (e.g. A19-30)
  var lampSku    = params.get('lamp_sku')   || '';       // resolved (LTA19F800xxMB)
  var dimmer     = params.get('dimmer')     || '';       // legacy (no longer emitted)
  var autoprint  = params.get('autoprint')  !== '0';     // default ON

  // --- 2-SIZE LOOKUP TABLE (CRC6-Gehry-Datasheet.pdf § Sizing & Measurements) ---
  // Both sizes share the same lamp envelope baseline; CRC6 adds PAR38 + BR40 (the
  // two large-aperture floods). Both sizes share gehry-hero-1.png (only 1 main
  // hero photo per size on disk — flagged Phase 2.99 carry-forward).
  // Photometric reference baseline is the 75W PAR30 incandescent lamp per Datasheet
  // page 2 (3 ft = 222 fc · 6 ft = 56 fc · 9 ft = 25 fc).
  var sizeData = {
    '4': { in: 4, canW: '4 1/4″',  canH: '5 5/8″',  bracketW: '8 1/8″',  bracketL: '11 7/8″', heroImg: '/products/multi-family/gehry/assets/gehry/gehry-hero-1.png' },
    '6': { in: 6, canW: '6 1/2″',  canH: '7 3/8″',  bracketW: '11 7/8″', bracketL: '14 7/8″', heroImg: '/products/multi-family/gehry/assets/gehry/gehry-hero-1.png' }
  };
  var sd = sizeData[size] || sizeData['6'];

  // --- BASE TYPE LOOKUP ---
  var baseLabel = { 'E26': 'E26 Legacy Lamp Socket', 'T24': 'T24 / JA8 LED-Only (CA)' }[base] || 'E26 Legacy Lamp Socket';
  var baseDesc  = { 'E26': 'universal medium-base socket · accepts incandescent / halogen / LED PAR/R/BR/A19 lamps + the multi-f<span class="aa">Ⓐ</span>MILY RL Series LED Retrofit Module',
                    'T24': 'California Title 24 / JA8-2022-E LED-only socket · locks out incandescent + non-JA8 CFL replacement lamps · for new-construction CA installs' }[base] || '';

  // --- AUTOFILL CATALOG NUMBER (4 page headers + project info form + control bar) ---
  document.querySelectorAll('#catNum, #catNum2, #catNum3, #catNum4, #liveSku').forEach(function(el) {
    el.textContent = sku;
  });
  var pi = document.getElementById('piCatNum');
  if (pi) pi.textContent = sku;

  // ===== EDITABLE CATALOG NUMBER (§C 2026-05-18) =====
  (function setupEditableCatalogNumber(){
    var originalSku = sku;
    var editor = document.getElementById('catNum');
    if (!editor) return;
    function sweepTextNodes(root, fromStr, toStr){
      if (!fromStr || fromStr === toStr) return;
      var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
        acceptNode: function(n){
          var p = n.parentNode;
          while (p) {
            if (p === editor) return NodeFilter.FILTER_REJECT;
            if (p.tagName === 'SCRIPT' || p.tagName === 'STYLE') return NodeFilter.FILTER_REJECT;
            p = p.parentNode;
          }
          return n.nodeValue.indexOf(fromStr) !== -1 ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
        }
      });
      var nodes = [];
      while (walker.nextNode()) nodes.push(walker.currentNode);
      nodes.forEach(function(n){ n.nodeValue = n.nodeValue.split(fromStr).join(toStr); });
    }
    function applyOverride(newVal){
      var override = (newVal || '').replace(/[\r\n]+/g, ' ').trim().slice(0, 40);
      if (!override) override = originalSku;
      ['catNum2', 'catNum3', 'catNum4', 'piCatNum', 'liveSku'].forEach(function(id){
        var el = document.getElementById(id);
        if (el) el.textContent = override;
      });
      var spec = document.getElementById('specsEyebrow');
      if (spec) {
        var parts = spec.textContent.split(' · ');
        if (parts.length === 2) spec.textContent = parts[0] + ' · ' + override;
      }
      sweepTextNodes(document.body, originalSku, override);
      document.title = document.title.replace(originalSku, override);
    }
    var currentDisplay = originalSku;
    editor.addEventListener('input', function(){
      var newVal = (editor.textContent || '').replace(/[\r\n]+/g, ' ').slice(0, 40);
      sweepTextNodes(document.body, currentDisplay, newVal || originalSku);
      ['catNum2', 'catNum3', 'catNum4', 'piCatNum', 'liveSku'].forEach(function(id){
        var el = document.getElementById(id);
        if (el) el.textContent = newVal || originalSku;
      });
      var spec = document.getElementById('specsEyebrow');
      if (spec) {
        var parts = spec.textContent.split(' · ');
        if (parts.length === 2) spec.textContent = parts[0] + ' · ' + (newVal || originalSku);
      }
      document.title = document.title.replace(currentDisplay, newVal || originalSku);
      currentDisplay = newVal || originalSku;
    });
    editor.addEventListener('blur', function(){
      var v = editor.textContent.trim();
      if (!v) { editor.textContent = originalSku; applyOverride(originalSku); currentDisplay = originalSku; }
    });
    editor.addEventListener('keydown', function(e){
      if (e.key === 'Enter') { e.preventDefault(); editor.blur(); }
    });
  })();


  // --- AUTOFILL PRODUCT TITLE ---
  document.getElementById('productTitle').textContent =
    'CRC Gehry Series · ' + sd.in + '″ Universal Recessed Housing (' + baseLabel + ')';

  // --- AUTOFILL QUICK SPECS (housing dimensions instead of lumens/wattage) ---
  // Slot mapping: qsLumens → Can Aperture, qsWatts → Bracket Footprint, qsLpw → Base Type
  var qsL = document.getElementById('qsLumens'); if (qsL) qsL.innerHTML = sd.canW + ' W &times; ' + sd.canH + ' H';
  var qsW = document.getElementById('qsWatts');  if (qsW) qsW.innerHTML = sd.bracketW + ' W &times; ' + sd.bracketL + ' L';
  var qsP = document.getElementById('qsLpw');    if (qsP) qsP.innerHTML = baseLabel;

  // --- AUTOFILL HERO IMAGE — Gehry housing ---
  var heroImg = document.getElementById('heroImg');
  if (heroImg) {
    heroImg.src = sd.heroImg;
    heroImg.alt = 'CRC' + sd.in + '-SB-' + base + ' Gehry — ' + sd.in + '″ universal recessed housing, die-formed aluminum can with pre-installed swivel bracket and adjustable bar hangers, remote J-Box with TP24 Quick Connect, ' + baseLabel + (finish === 'WH' ? '' : '');
  }

  // --- AUTOFILL ORDERING CODE BREAKDOWN (Page 4) ---
  // Gehry SKU pattern: CRC{N}-SB-{E26|T24}[/WH]
  //   ocHousing = 1-digit size (4 or 6)
  //   ocSensor  = base type segment (/E26 or /T24 · re-using the ID for parity)
  document.getElementById('ocHousing').textContent = size;
  var ocSensor = document.getElementById('ocSensor');
  if (ocSensor) ocSensor.textContent = '/' + base;

  // --- AUTOFILL DIMENSIONS (Page 3) per size ---
  // Page 3 surfaces the Gehry can + bracket dimensions through the existing
  // DOM IDs (specOd → Can W × H, specAp → Bracket W × L, specDepth → Ceiling
  // Thickness, specRecess → Joist Span, specCutout → Recess, specWeight →
  // Master Carton, mountStd → E26 Standard Install, mountT24 → T24 / JA8
  // Install). All IDs are present and Gehry-native after the v1 completion
  // sweep 2026-05-08.
  var specOd     = document.getElementById('specOd');     if (specOd)     specOd.textContent     = 'Can Ø ' + sd.canW + ' (CRC' + sd.in + ')';
  var specAp     = document.getElementById('specAp');     if (specAp)     specAp.textContent     = 'Bracket: ' + sd.bracketW + ' W × ' + sd.bracketL + ' L';
  var specCutout = document.getElementById('specCutout'); if (specCutout) specCutout.textContent = 'Recessed can install · joist-mounted swivel bracket with pre-installed adjustable bar hangers (24″ OC · field-shortenable to 12″ OC) · 90° pivoting plate for skinny-cavity installs · TP24 Quick Connect to remote J-Box';
  var specRecess = document.getElementById('specRecess'); if (specRecess) specRecess.textContent = 'Can Ø ' + sd.canW + ' · ceiling cutout matched to can aperture · 0″ projection below ceiling line';
  var specDepth  = document.getElementById('specDepth');  if (specDepth)  specDepth.textContent  = 'Ceiling thickness adjustment: 1/2″ – 1-3/8″ · adjustable per ceiling drywall thickness';
  var specWeight = document.getElementById('specWeight'); if (specWeight) specWeight.textContent = 'Master carton artwork pending production (per disk: CRC' + sd.in + '-SB-' + base + ')';
  var mountStd   = document.getElementById('mountStd');   if (mountStd)   mountStd.textContent   = 'Joist-mounted swivel bracket · pre-installed bar hangers (24″ OC) · field-shortenable to 12″ OC · 4× double-headed nails · TP24 Quick Connect cable to remote J-Box';
  var mountT24   = document.getElementById('mountT24');   if (mountT24)   mountT24.textContent   = (base === 'T24')
    ? 'Title 24 / JA8-2022-E LED-only base socket — locks out incandescent and unqualified CFL replacement lamps. Use for California new-construction recessed-can installs.'
    : 'E26 medium-base universal lamp socket — accepts every standard medium-base lamp (incandescent, halogen, LED) + the multi-f<span class="aa">Ⓐ</span>MILY RL Series LED Retrofit Module via TP24 J-Box.';
  var dimTopW    = document.getElementById('dimTopWidth');if (dimTopW)    dimTopW.textContent    = 'Can Ø ' + sd.canW;
  var dimAp      = document.getElementById('dimAperture');if (dimAp)      dimAp.textContent      = 'Bracket ' + sd.bracketW + ' W × ' + sd.bracketL + ' L';
  var dimDp      = document.getElementById('dimDepth');   if (dimDp)      dimDp.textContent      = 'depth ' + sd.canH + ' (above-ceiling can height)';
  var dimRc      = document.getElementById('dimRecess');  if (dimRc)      dimRc.textContent      = 'recessed housing · 0″ projection · 1/2″–1-3/8″ ceiling thickness';

  // --- AUTOFILL PHOTOMETRIC PAGE 4 ---
  // Gehry is a HOUSING; no native IES file. The photometric reference baseline is
  // the 75W PAR30 incandescent lamp per Datasheet page 2.
  var photoEyebrow = document.getElementById('photoEyebrow');
  if (photoEyebrow) photoEyebrow.textContent =
    '75W PAR30 incandescent reference · CRC' + sd.in + '-SB-' + base + ' · die-formed aluminum housing · IC + Air-Tight' +
    (base === 'T24' ? ' · Title 24/JA8-2022-E' : '');
  // Peak / Lumens slots repurposed: peak → reference lamp, lumens → 3 ft throw
  var photoPeak = document.getElementById('photoPeak');
  if (photoPeak) photoPeak.textContent = '75W PAR30 (Datasheet baseline)';
  var photoLumens = document.getElementById('photoLumens');
  if (photoLumens) photoLumens.textContent = '222 fc · 26 ft beam spread';
  var photoIesFile = document.getElementById('photoIesFile');
  if (photoIesFile) photoIesFile.textContent = 'N/A — housing has no built-in light source';

  // ============================================================================
  // CFG-COMPANION-SIZE-MATCH — Submittal Companion Pipeline
  // ============================================================================
  // When the user picks a Companion Module, the housing size (CRC4 or CRC6)
  // dictates which size-matched module SKU ships in the BOM. NEBULA-II ★ is
  // the canonical companion designed alongside Gehry — LDRR410 for CRC4,
  // LDRR615 for CRC6, both via the TP24 J-Box. Other module families snap to
  // the nearest size where a 4″ / 6″ split isn't available (Eclipse-II + Lunar
  // Eclipse → 5″/7″ closest fit). Lamps stay versatile — A19 fits any E26.
  //
  // The pipeline:
  //   1. Read state (module + module_sku + module_name · lamp + lamp_sku) from URL
  //   2. Resolve real per-size specs from MODULE_SPEC_TABLE
  //   3. Render the Pair-With BOM panel (1 line per companion)
  //   4. Render the rich Selected-Companion detail card (size-matched specs)
  //   5. Flag the picked row in the Page 2 Companion table with ★ SELECTED
  // ============================================================================

  // MODULE_SPEC_TABLE — full per-size specs for each multi-fⒶMILY LED module.
  // Numbers verified against each module's PDP / Datasheet 2026-05-09.
  // Keyed: [moduleVal][housingSize] → resolved companion record.
  // For modules with no native 4″ option (Eclipse-II 5/7/9/11/13″, Lunar 5/7/9″)
  // we snap to the closest fit and tag it in the spec card.
  var MODULE_SPEC_TABLE = {
    'NEBULA-II': {
      family: 'Nebula-II',
      familyCode: 'LDRR',
      tier: 'ECO',
      hero: true,             // ★ recommended pair for Gehry — built alongside the housing
      cctOptions: '2700 / 3000 / 3500 / 4000 / 5000K',
      cri: '90+',
      dlc: 'DLC Premium',
      warranty: '5-yr ECO',
      datasheet: 'https://workdrive.archipelagolighting.com/external/f85531794c0da1dc848e3037781aa1c19322c21c93a074d4d85c74792b5f83ba',
      rationale: 'Nebula-II is the <strong>canonical multi-f<span class="aa">Ⓐ</span>MILY companion designed alongside Gehry</strong> — the recessed retrofit pair specified to drop directly into the TP24-equipped J-Box for tool-free service swaps. 100° flood pattern matches the standard CRC throw geometry. Recommended over Orbit-I when the application is general ambient (vs directional accent).',
      sizes: {
        '4': { sku: 'LDRR410',  size: '4″',  matches: 'CRC4', wattage: '10W',  lumens: '880 lm',   lpw: '88 lm/W',  closestFit: false },
        '6': { sku: 'LDRR615',  size: '6″',  matches: 'CRC6', wattage: '15W',  lumens: '1,320 lm', lpw: '88 lm/W',  closestFit: false }
      }
    },
    'ECRESCENT': {
      family: 'eCrescent',
      familyCode: 'LSMT',
      tier: 'ECO',
      cctOptions: '2700 / 3000 / 3500 / 4000 / 5000K',
      cri: '80+',
      dlc: 'DLC Premium',
      warranty: '5-yr ECO',
      datasheet: '',
      rationale: '<strong>Edge-lit LED retrofit with built-in PIR sensor</strong> + 3-position dip switch (motion / vacancy / on-demand). Use when the spec calls for occupancy sensing without a separate sensor SKU.',
      sizes: {
        '4': { sku: 'LSMT410',  size: '4″',  matches: 'CRC4', wattage: '10W',  lumens: '750 lm',   lpw: '75 lm/W',  closestFit: false },
        '6': { sku: 'LSMT615',  size: '6″',  matches: 'CRC6', wattage: '15W',  lumens: '1,100 lm', lpw: '73 lm/W',  closestFit: false }
      }
    },
    'RADIUS-II': {
      family: 'Radius-II',
      familyCode: 'LDRS',
      tier: 'PRO',
      cctOptions: '2700 / 3000 / 3500 / 4000 / 5000K',
      cri: '90+',
      dlc: 'DLC Premium',
      warranty: '7-yr PRO',
      datasheet: 'https://workdrive.archipelagolighting.com/external/a9989323c34a1c55b7de7873571feafb3794a38a881af67b98c367dde0631a3b',
      rationale: '<strong>Slim wafer retrofit · PRO tier · 7-yr warranty</strong>. Use when the spec calls for a thinner above-ceiling profile or longer warranty than the ECO Nebula-II ladder. Wet Location · ETL listed.',
      sizes: {
        '4': { sku: 'LDRS4',    size: '4″',  matches: 'CRC4', wattage: '9W',   lumens: '644 lm',   lpw: '72 lm/W',  closestFit: false },
        '6': { sku: 'LDRS6',    size: '6″',  matches: 'CRC6', wattage: '12W',  lumens: '1,041 lm', lpw: '87 lm/W',  closestFit: false }
      }
    },
    'ECLIPSE-II': {
      family: 'Eclipse-II',
      familyCode: 'LDLL',
      tier: 'PRO',
      cctOptions: '2700 / 3000 / 3500 / 4000 / 5000K',
      cri: '90+',
      dlc: 'DLC Premium',
      warranty: '5-yr PRO',
      datasheet: 'https://workdrive.archipelagolighting.com/external/bb82fac38ac148a688c82ebe8de1ffd7627bca8cbd0e577eb3d2403070be0d65',
      rationale: '<strong>Surface puck — driverless 103 lm/W peak · sensor-ready</strong> (1-Pin Plug-n-Play Bi-Level port). Use when the spec calls for a surface-mounted alternative to the recessed Nebula-II / Radius-II path. <em>Note: Eclipse-II ships in 5/7/9/11/13″ — there is no 4″ or 6″ option, so CRC4 snaps to LDLL0510 (5″) and CRC6 snaps to LDLL0715 (7″).</em>',
      sizes: {
        '4': { sku: 'LDLL0510', size: '5″',  matches: 'CRC4 (closest fit · 4″ N/A)', wattage: '10W', lumens: '790 lm',   lpw: '79 lm/W', closestFit: true },
        '6': { sku: 'LDLL0715', size: '7″',  matches: 'CRC6 (closest fit · 6″ N/A)', wattage: '15W', lumens: '1,185 lm', lpw: '79 lm/W', closestFit: true }
      }
    },
    'LUNAR-ECLIPSE': {
      family: 'Lunar Eclipse',
      familyCode: 'LDLL',
      tier: 'PRO',
      cctOptions: '2700 / 3000 / 3500 / 4000 / 5000K',
      cri: '90+',
      dlc: 'DLC Premium',
      warranty: '5-yr PRO',
      datasheet: 'https://workdrive.archipelagolighting.com/external/bb82fac38ac148a688c82ebe8de1ffd7627bca8cbd0e577eb3d2403070be0d65',
      rationale: '<strong>Black-only trimless surface puck · IP65 wet-rated</strong> upgrade over Eclipse-II IP44. Use when the spec calls for an exterior-grade or wash-down location. <em>Same closest-fit mapping: CRC4 → LDLL0510 (5″), CRC6 → LDLL0715 (7″).</em>',
      sizes: {
        '4': { sku: 'LDLL0510', size: '5″',  matches: 'CRC4 (closest fit · 4″ N/A)', wattage: '10W', lumens: '790 lm',   lpw: '79 lm/W', closestFit: true },
        '6': { sku: 'LDLL0715', size: '7″',  matches: 'CRC6 (closest fit · 6″ N/A)', wattage: '15W', lumens: '1,185 lm', lpw: '79 lm/W', closestFit: true }
      }
    },
    'ORBIT-I': {
      family: 'Orbit-I',
      familyCode: 'LDGR',
      tier: 'PRO',
      cctOptions: '2700 / 3000 / 3500 / 4000 / 5000K',
      cri: '90+',
      dlc: 'DLC Premium',
      warranty: '7-yr PRO',
      datasheet: 'https://workdrive.archipelagolighting.com/external/668f4316a802c0182814c58dbef7f987ba01d2d73117eaba0fa8dda5a0b90d1f',
      rationale: '<strong>Retrofit gimbal trim · 60° tilt + 360° rotation</strong>. Use when the spec calls for accent / wall-wash / directional aiming applications (vs the general ambient throw of Nebula-II).',
      sizes: {
        '4': { sku: 'LDGR410',  size: '4″',  matches: 'CRC4', wattage: '10W',  lumens: '800 lm',   lpw: '80 lm/W',  closestFit: false },
        '6': { sku: 'LDGR615',  size: '6″',  matches: 'CRC6', wattage: '15W',  lumens: '1,200 lm', lpw: '80 lm/W',  closestFit: false }
      }
    }
  };

  // LAMP_SPEC_TABLE — A19 ladder. Lamp specs are size-agnostic (medium-base
  // E26 fits CRC4 + CRC6) but CCT-specific. Each chip val maps to the real SKU.
  var LAMP_SPEC_TABLE = {
    'A19-27': { sku: 'LTA19F80027MB', cct: '2700K', wattage: '8.5W', lumens: '800 lm', lpw: '94 lm/W', label: 'Warm white · 2700K' },
    'A19-30': { sku: 'LTA19F80030MB', cct: '3000K', wattage: '8.5W', lumens: '800 lm', lpw: '94 lm/W', label: 'Warm white · 3000K' },
    'A19-35': { sku: 'LTA19F80035MB', cct: '3500K', wattage: '8.5W', lumens: '800 lm', lpw: '94 lm/W', label: 'Neutral · 3500K' },
    'A19-40': { sku: 'LTA19F80040MB', cct: '4000K', wattage: '8.5W', lumens: '800 lm', lpw: '94 lm/W', label: 'Cool white · 4000K ★' },
    'A19-50': { sku: 'LTA19F80050MB', cct: '5000K', wattage: '8.5W', lumens: '800 lm', lpw: '94 lm/W', label: 'Daylight · 5000K' }
  };

  // --- Resolve the picked module against the housing size ----------------------
  function resolveModule(moduleVal, housingSize) {
    var fam = MODULE_SPEC_TABLE[moduleVal];
    if (!fam) return null;
    var s = fam.sizes[housingSize] || fam.sizes['6'];
    return {
      family: fam.family,
      familyCode: fam.familyCode,
      tier: fam.tier,
      hero: !!fam.hero,
      sku: s.sku,
      size: s.size,
      matches: s.matches,
      wattage: s.wattage,
      lumens: s.lumens,
      lpw: s.lpw,
      closestFit: s.closestFit,
      cctOptions: fam.cctOptions,
      cri: fam.cri,
      dlc: fam.dlc,
      warranty: fam.warranty,
      datasheet: fam.datasheet,
      rationale: fam.rationale
    };
  }

  // --- Build the BOM list (Page 1, top of card) -------------------------------
  // Always 1 line per picked companion. Uses the resolved (size-matched) SKU.
  var bomEntries = [];
  var resolvedMod = null;
  var resolvedLamp = null;

  if (module) {
    resolvedMod = resolveModule(module, size);
    if (resolvedMod) {
      bomEntries.push({
        sku: resolvedMod.sku,
        name: resolvedMod.family + ' — ' + resolvedMod.size + ' module · ' +
              resolvedMod.tier + ' tier · matches ' + resolvedMod.matches +
              (resolvedMod.hero ? ' · ★ recommended pair' : '')
      });
    } else if (moduleSku || moduleName) {
      bomEntries.push({ sku: moduleSku || module, name: moduleName || module });
    }
  }

  if (lamp) {
    resolvedLamp = LAMP_SPEC_TABLE[lamp];
    if (resolvedLamp) {
      bomEntries.push({
        sku: resolvedLamp.sku,
        name: 'A19 LED · ' + resolvedLamp.lumens + ' · ' + resolvedLamp.label + ' · medium-base (E26 socket path)'
      });
    } else if (lampSku) {
      bomEntries.push({ sku: lampSku, name: 'A19 LED lamp (' + lamp + ')' });
    }
  }

  // Legacy dimmer field (no longer emitted by configurator)
  if (dimmer) {
    bomEntries.push({ sku: dimmer, name: 'Approved dimmer (legacy companion)' });
  }

  if (bomEntries.length) {
    var bomList = document.getElementById('bomList');
    if (bomList) {
      bomList.innerHTML = bomEntries.map(function(e) {
        return '<li><span class="plus">+</span><span><strong>' + e.sku + '</strong>' +
               '<span class="pair-name">' + e.name + '</span></span></li>';
      }).join('');
      var bomPanel = document.getElementById('bomPanel');
      if (bomPanel) bomPanel.style.display = 'block';
    }
  }

  // --- Render the rich SELECTED COMPANION · MODULE card (Page 1) --------------
  if (resolvedMod) {
    var modPanel = document.getElementById('modDetail');
    if (modPanel) {
      document.getElementById('modDetailEyebrow').innerHTML =
        'Selected Companion · LED Retrofit Module' + (resolvedMod.hero ? ' · ★ Recommended Pair' : '');
      document.getElementById('modDetailTitle').textContent =
        resolvedMod.family + ' — ' + resolvedMod.size + ' module · ' + resolvedMod.tier + ' tier · matches ' + resolvedMod.matches;
      document.getElementById('modDetailSku').textContent = resolvedMod.sku;
      document.getElementById('modDetailGrid').innerHTML = [
        cell('Module Size',     resolvedMod.size + (resolvedMod.closestFit ? ' (closest fit)' : '')),
        cell('Wattage',         resolvedMod.wattage),
        cell('Lumens',          resolvedMod.lumens),
        cell('Efficacy',        resolvedMod.lpw),
        cell('CCT Options',     resolvedMod.cctOptions),
        cell('CRI',             resolvedMod.cri),
        cell('DLC Tier',        resolvedMod.dlc),
        cell('Warranty',        resolvedMod.warranty)
      ].join('');
      document.getElementById('modDetailRationale').innerHTML =
        '<strong>Why this pair:</strong> ' + resolvedMod.rationale +
        (resolvedMod.datasheet
          ? ' <a href="' + resolvedMod.datasheet + '" target="_blank" style="color:var(--brand-red); font-weight:700;">↓ ' + resolvedMod.family + ' Datasheet</a>'
          : '');
      modPanel.classList.add('show');
    }
  }

  // --- Render the SELECTED COMPANION · A19 LAMP card (Page 1) -----------------
  if (resolvedLamp) {
    var lampPanel = document.getElementById('lampDetail');
    if (lampPanel) {
      document.getElementById('lampDetailTitle').textContent =
        'A19 LED · ' + resolvedLamp.label + ' · medium-base';
      document.getElementById('lampDetailSku').textContent = resolvedLamp.sku;
      document.getElementById('lampDetailGrid').innerHTML = [
        cell('Wattage',     resolvedLamp.wattage),
        cell('Lumens',      resolvedLamp.lumens),
        cell('Efficacy',    resolvedLamp.lpw),
        cell('CCT',         resolvedLamp.cct),
        cell('Base',        'E26 medium-base'),
        cell('Compatible',  'CRC4 + CRC6 (E26 path)'),
        cell('Application', 'Omnidirectional ambient'),
        cell('Note',        base === 'T24' ? '⚠ Not JA8 — pair with /E26 SKU' : 'Works with /E26 SKU')
      ].join('');
      lampPanel.innerHTML = lampPanel.innerHTML; // no-op, ensures DOM stays consistent
      document.getElementById('lampDetailRationale').innerHTML =
        '<strong>Why this lamp:</strong> A19 LED at <strong>' + resolvedLamp.lumens + '</strong> for general ambient applications (closet · pantry · service-room · corridor). Single SKU pattern <code>LTA19F800xxMB</code> covers 5 CCT variants (xx = first 2 chars of CCT). E26 base only — for the T24 install path, swap in a JA8-qualified PAR30 or one of the multi-f<span class="aa">Ⓐ</span>MILY LED retrofit modules above.';
      lampPanel.classList.add('show');
    }
  }

  // Helper for the spec-grid cell template
  function cell(key, val) {
    return '<div class="companion-spec-cell">' +
             '<div class="companion-spec-key">' + key + '</div>' +
             '<div class="companion-spec-val">' + val + '</div>' +
           '</div>';
  }

  // --- Flag the picked row in the Page 2 Companion table with ★ SELECTED -----
  if (module) {
    var row = document.querySelector('tr[data-mod-row="' + module + '"]');
    if (row) row.classList.add('is-selected');
  }
  if (lamp) {
    var lampRow = document.querySelector('tr[data-lamp-row="A19"]');
    if (lampRow) lampRow.classList.add('is-selected');
  }

  // --- LIVE DATE ---
  var d = new Date();
  var liveDate = document.getElementById('liveDate');
  if (liveDate) liveDate.textContent = d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' });
  var revStr = d.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit' }).replace('/', '-');
  var revDate = document.getElementById('revDate');
  if (revDate) revDate.textContent = revStr;
  document.querySelectorAll('.rev-date').forEach(function(el) { el.textContent = revStr; });

  // --- AUTO-PRINT ---
  // Fires window.print() 600 ms after load — long enough for the browser to
  // paint the 4 pages and load the hero image. Skippable with ?autoprint=0.
  if (autoprint) {
    window.addEventListener('load', function() {
      setTimeout(function() { window.print(); }, 600);
    });
  }
})();
</script>

</body>
</html>


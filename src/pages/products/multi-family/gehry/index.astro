<script>
// Carousel autoplay — count is read from actual DOM so adding/removing slides
// doesn't drift the modulo math.
(function() {
  var track = document.getElementById('carouselTrack');
  var dots  = document.querySelectorAll('#carouselDots > span');
  var slides = track ? track.querySelectorAll('.carousel-slide').length : 0;
  if (!track || !slides) return;
  var idx = 0;
  function go(i) {
    idx = (i + slides) % slides;
    track.style.transform = 'translateX(-' + (idx * 100) + '%)';
    dots.forEach(function(d, n) { d.classList.toggle('active', n === idx); });
  }
  var timer = setInterval(function() { go(idx + 1); }, 5000);
  dots.forEach(function(d) {
    d.addEventListener('click', function() {
      clearInterval(timer);
      go(parseInt(d.dataset.i, 10));
      timer = setInterval(function() { go(idx + 1); }, 5000);
    });
  });
})();

// Spec size toggle — Gehry ships 2 housing sizes (CRC4 / CRC6 ★ default) per
// CRC6-Gehry-Datasheet.pdf page 2 § Sizing & Measurements. Both sizes share an
// identical lamp envelope baseline, but CRC6's larger aperture adds PAR38 + BR40
// (the two large-diameter floods). The table rows reflect lamp compatibility per
// size — Gehry is a HOUSING (no built-in light source); the photometric output
// depends on the lamp/module the installer drops in.
//
// Default ★ row per size: RL Series LED Module — the multi-fⒶMILY native pair
// that drops INTO the housing via the TP24 J-Box. Per James 2026-05-08: the
// canonical Gehry pairing IS the multi-fⒶMILY LED retrofit module (eCrescent /
// Radius-II / Eclipse-II / Lunar Eclipse / Orbit-I), so it leads the spec table.
(function() {
  var data = {
    '4': [
      { lamp: 'LDRR4',  watt: '10W',  base: 'T.24 QuickConnect', note: 'multi-fⒶMILY Native Pair ★', def: true  },
      { lamp: 'LDGR4',  watt: '10W',  base: 'T.24 QuickConnect', note: 'multi-fⒶMILY',                  def: false },
      { lamp: 'LSMT4',  watt: '10W',  base: 'T.24 QuickConnect', note: 'multi-fⒶMILY',                  def: false },
      { lamp: 'LDRS4',  watt: '9W',   base: 'T.24 QuickConnect', note: 'multi-fⒶMILY',                  def: false },
      { lamp: 'LDLL¹',  watt: '&mdash;', base: '&mdash;',           note: 'closest fit: LDLL05 5″ via reducer ring ¹', def: false }
    ],
    '6': [
      { lamp: 'LDRR6',  watt: '15W',  base: 'T.24 QuickConnect', note: 'multi-fⒶMILY Native Pair ★', def: true  },
      { lamp: 'LDGR6',  watt: '15W',  base: 'T.24 QuickConnect', note: 'multi-fⒶMILY',                  def: false },
      { lamp: 'LSMT6',  watt: '15W',  base: 'T.24 QuickConnect', note: 'multi-fⒶMILY',                  def: false },
      { lamp: 'LDRS6',  watt: '12W',  base: 'T.24 QuickConnect', note: 'multi-fⒶMILY',                  def: false },
      { lamp: 'LDLL¹',  watt: '&mdash;', base: '&mdash;',           note: 'closest fit: LDLL07 7″ via 6″→7″ reducer ¹', def: false }
    ]
  };
  // Dimensions per CRC6-Gehry-Datasheet.pdf page 2 § Sizing & Measurements.
  // Can = the recessed cylinder body (W = aperture diameter, H = above-ceiling depth).
  // Bracket = the swivel-bracket sled the can rides in (W × L footprint above the joist).
  // Ceiling thickness adjustment range (1/2″ – 1-3/8″) is identical across both sizes.
  var dims = {
    '4': { canW: '4 1/4″', canH: '5 5/8″', bracketW: '8 1/8″',  bracketL: '11 7/8″', depth: '1/2″ – 1-3/8″', sku: 'CRC4-SB' },
    '6': { canW: '6 1/2″', canH: '7 3/8″', bracketW: '11 7/8″', bracketL: '14 7/8″', depth: '1/2″ – 1-3/8″', sku: 'CRC6-SB' }
  };
  var tbody = document.getElementById('specTableBody');
  var tabs = document.querySelectorAll('.spec-watt-tab');
  function render(model) {
    tbody.innerHTML = data[model].map(function(r) {
      return '<tr class="' + (r.def ? 'is-default' : '') + '">' +
             '<td>' + r.lamp + '</td>' +
             '<td>' + r.watt + '</td>' +
             '<td>' + r.base + '</td>' +
             '<td>' + r.note + '</td>' +
             '</tr>';
    }).join('');
  }
  // Swap the Dimensions inline-SVG labels to match the active size tab.
  // Top-view: can aperture diameter (canW) + bracket footprint (bracketW × bracketL).
  // Side-view: above-ceiling can height (canH).
  // Ceiling-thickness adjustment range stays constant (1/2″ – 1-3/8″ both sizes).
  function swapDim(w) {
    var d = dims[w];
    if (!d) return;
    var topDiam  = document.getElementById('dimDiamLabel');     // top-view can aperture
    var sideDiam = document.getElementById('dimSideDiamLabel'); // side-view can height
    var depth    = document.getElementById('dimDepthLabel');    // ceiling thickness range
    var emit     = document.getElementById('dimEmitLabel');     // bracket footprint
    if (topDiam)  topDiam.textContent  = 'Can Ø ' + d.canW;
    if (sideDiam) sideDiam.textContent = d.canH;
    if (depth)    depth.textContent    = d.depth;
    if (emit)     emit.textContent     = 'Bracket: ' + d.bracketW + ' W × ' + d.bracketL + ' L';
  }
  tabs.forEach(function(t) {
    t.addEventListener('click', function() {
      tabs.forEach(function(x) { x.classList.remove('active'); x.setAttribute('aria-selected', 'false'); });
      t.classList.add('active');
      t.setAttribute('aria-selected', 'true');
      render(t.dataset.w);
      swapDim(t.dataset.w);
    });
  });
  render('6');
  swapDim('6');
})();

// Dimensions zoom modal — click magnifier to open, click anywhere or ESC to close
(function() {
  function initZoom() {
    var btn      = document.querySelector('.spec-dim-zoom');
    var modal    = document.getElementById('zoomModal');
    var img      = document.getElementById('dimImg');
    var src      = document.getElementById('dimSvg');
    var dst      = document.getElementById('zoomContent');
    var closeBtn = document.getElementById('zoomClose');
    if (!btn || !modal || !dst || !(img || src)) {
      console.warn('zoom-modal: missing DOM nodes', {btn:!!btn, modal:!!modal, img:!!img, src:!!src, dst:!!dst});
      return;
    }
    function openModal(e) {
      if (e) { e.preventDefault(); e.stopPropagation(); }
      // Prefer the production drawing; fall back to inline SVG
      if (img && img.complete && img.naturalWidth > 0) {
        dst.innerHTML = '<img src="' + img.getAttribute('src') + '" alt="' + img.alt + '" />';
      } else if (src) {
        dst.innerHTML = src.outerHTML.replace(/\bdisplay\s*:\s*none[;]?/i, '');
      }
      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeModal(e) {
      if (e) { e.preventDefault(); }
      modal.classList.remove('open');
      document.body.style.overflow = '';
    }
    btn.addEventListener('click', openModal);
    modal.addEventListener('click', closeModal);
    if (closeBtn) closeBtn.addEventListener('click', function(e){ e.stopPropagation(); closeModal(e); });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal.classList.contains('open')) closeModal();
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initZoom);
  } else {
    initZoom();
  }
})();

// Section 5 — 2-Path Install Selector: tab → swap install-path SVG, swap body copy, trigger ripple shockwave.
// Gehry install paths: E26 Legacy Lamp Socket (universal) · T24 / JA8 LED-Only (California Title 24).
// Default tab = e26 (the most common install path nationwide outside California).
// Same can, same swivel bracket, same TP24 J-Box — the fork is at the lamp socket.
(function() {
  var copy = {
    e26: "/E26 medium-base socket — the universal path everywhere outside California. Takes PAR30/38, R30, BR30/40, A19 (up to 75W) plus the multi-fⒶMILY RL Series LED Retrofit Module. T.24 Quick Connect lets you swap lamp or module without wire-nuts. Click T24 / JA8 next for the CA-spec path.",
    t24: "/T24 JA8-2022-E socket — California Title 20 + Title 24 compliant. Locks out incandescent + non-JA8 CFL replacement lamps per the high-efficacy luminaire (HEL) requirement. Takes JA8-qualified LED PAR30/38 + the multi-fⒶMILY RL Series LED Module. One housing covers both energy-code paths."
  };
  function init() {
    var tabs = document.querySelectorAll('.tac-callout-tab');
    var sensors = document.querySelectorAll('.tac-sensor-svg');
    var copyEl = document.getElementById('tacCalloutCopy');
    var wave = document.getElementById('tacShockwave');
    if (!tabs.length || !sensors.length || !wave) return;
    function select(platform) {
      tabs.forEach(function(t) {
        var isActive = t.dataset.platform === platform;
        t.classList.toggle('active', isActive);
        t.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
      sensors.forEach(function(s) {
        s.classList.toggle('is-active', s.dataset.platform === platform);
      });
      if (copyEl && copy[platform]) copyEl.textContent = copy[platform];
      // Trigger shockwave: remove + re-add class to restart animation
      wave.classList.remove('is-rippling');
      void wave.offsetWidth;
      wave.classList.add('is-rippling');
    }
    tabs.forEach(function(t) {
      t.addEventListener('click', function() { select(t.dataset.platform); });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();


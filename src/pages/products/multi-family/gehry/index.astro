                      'par30inc': 'No IES — 75W PAR30 is a Datasheet reference baseline' };

  function init() {
    var statPeak = document.getElementById('photoStatPeak');
    var statSpread = document.getElementById('photoStatLumens');     // re-purposed: now shows beam spread
    var statFile = document.getElementById('photoStatFile');

    'orbit_9':    { fc: '23',  beam: '10.5 ft',label:'ORBIT-I 15W LED · 9 FT THROW',    ies: 'LDGR615-O1-4000K.IES (URL pending)', cone: 'M 160 40 L 100 280 L 220 280 Z' },

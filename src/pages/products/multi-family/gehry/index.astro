          '<circle cx="160" cy="' + y + '" r="6" fill="#F32740"/>' +
          '<text x="172" y="' + (y - 14) + '" fill="#F32740" font-family="JetBrains Mono, monospace" font-size="14" font-weight="700">' + d.fc + ' fc</text>' +
          '<text x="172" y="' + y + '" fill="currentColor" opacity="0.55" font-family="JetBrains Mono, monospace" font-size="9">' + d.beam + ' beam</text>';
      }
      // Update the in-SVG bottom label
      if (photoImg) {
        var bottomLabel = photoImg.querySelector('text[font-size="11"]');
        if (bottomLabel) bottomLabel.textContent = d.label;
        photoImg.setAttribute('aria-label',
          'CRC Gehry housing throw-cone — ' + lampPill[state.lamp] +
          ' at ' + state.dist + ' ft throw, ' + d.fc + ' footcandles peak, ' + d.beam + ' beam spread'
        );
      }
    }

    lampTabs.forEach(function(t) {
      t.addEventListener('click', function() {
        lampTabs.forEach(function(x) { x.classList.remove('active'); x.setAttribute('aria-selected', 'false'); });
        t.classList.add('active');
        t.setAttribute('aria-selected', 'true');
        state.lamp = t.dataset.lamp;
        render();
      });
    });
    distTabs.forEach(function(t) {
      t.addEventListener('click', function() {
        distTabs.forEach(function(x) { x.classList.remove('active'); x.setAttribute('aria-selected', 'false'); });
        t.classList.add('active');
        t.setAttribute('aria-selected', 'true');
        state.dist = t.dataset.dist;
        render();
      });
    });

    render();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();


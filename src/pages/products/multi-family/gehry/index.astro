     CFG_FIELDS + CFG_SPECS_FN need to change.
     Anchor: #configurator (already wired into sticky-nav).
     ============================================================================ -->
<section class="cfg-section" id="configurator">
  <div class="section-inner cfg-inner">

    <div class="cfg-head">
      <div class="cfg-eyebrow sec-eyebrow">Build Your Model</div>
      <h2 class="cfg-title sec-title">>Configure Your CRC Gehry</h2>
      <p class="cfg-sub">
        Size + Base Type &rarr; one of 4 SKUs. Companions: LED Module · A19 Lamp.
        <small>★ default · QS QuickShip · + companion (separate line item)</small>
      </p>
    </div>

    <div class="cfg-counter-band">
      <div class="cfg-counter" id="cfgCounter">
        <strong id="cfgCount">0</strong> of <strong>2</strong> required selected
      </div>
      <button type="button" class="cfg-reset" id="cfgReset">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="1 4 1 10 7 10"/>
          <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
        </svg>
        Reset all options
      </button>
    </div>

    <div class="cfg-body">
      <!-- ============== REQUIRED COLUMN ============== -->
      <div class="cfg-col">
        <div class="cfg-col-head">
          <div class="cfg-col-title cfg-col-title-required">Required</div>
          <div class="cfg-col-meta">2 fields · both must be set</div>
        </div>
        <div class="cfg-fields">

          <!-- Size — 2 chips per CRC6-Gehry-Datasheet.pdf § Sizing & Measurements.
               Maps the &#123;N&#125; segment of CRC&#123;N&#125;-SB-&#123;E26|T24&#125;. -->
          <div class="cfg-field" data-field="size" style="grid-column: 1 / -1;">
            <div class="cfg-field-label">Size <span class="req">*</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip" data-field="size" data-val="4" data-code="4">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">CRC4 · 4&Prime; Housing</span>
                <span class="cfg-chip-code">CRC4</span>
              </button>
              <button type="button" class="cfg-chip" data-field="size" data-val="6" data-code="6">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">CRC6 · 6&Prime; Housing ★</span>
                <span class="cfg-chip-code">CRC6</span>
              </button>
            </div>
            <div class="cfg-field-notes-compact">★ CRC6 takes PAR38 + BR40 (CRC4 doesn&rsquo;t).</div>
          </div>

          <!-- Base Type — 2 chips: E26 (legacy/universal) or T24 (CA Title 24 / JA8 LED-only). -->
          <div class="cfg-field" data-field="base" style="grid-column: 1 / -1;">
            <div class="cfg-field-label">Base Type <span class="req">*</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip" data-field="base" data-val="E26" data-code="E26">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">E26 · Legacy Lamp Socket ★</span>
                <span class="cfg-chip-code">/E26</span>
              </button>
              <button type="button" class="cfg-chip" data-field="base" data-val="T24" data-code="T24">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">T24 / JA8 LED-Only · CA</span>
                <span class="cfg-chip-code">/T24</span>
              </button>
            </div>
            <div class="cfg-field-notes-compact">★ E26 = universal medium-base &middot; T24 = CA Title 24 / JA8-2022-E LED-only.</div>
          </div>

        </div>
      </div>

      <!-- ============== OPTIONAL COLUMN ============== -->
      <div class="cfg-col cfg-col-optional-flex">
        <div class="cfg-col-head">
          <div class="cfg-col-title">Optional · Companion Pairings</div>
          <div class="cfg-col-meta">Separate line item · pick ONE: LED module OR lamp (mutually exclusive)</div>
        </div>
        <div class="cfg-fields">

          <!-- LED Retrofit Modules — 5-pick ladder per gehry_knowledge_pack.md §5.
               Each module is its own product (independent PDP + Datasheet) and ships
               as a separate line item. Pairing surfaces the multi-fⒶMILY native
               relationship via the TP24 J-Box. -->
          <div class="cfg-field" data-field="module" style="grid-column: 1 / -1;">
            <div class="cfg-field-label">Companion · multi-f<span class="aa" aria-hidden="true">Ⓐ</span>MILY LED Retrofit Module <span class="cfg-label-hint">(pick one · separate SKU)</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="module" data-val="NEBULA-II" data-code="NEBULA-II" data-pair-sku="LDRR (Nebula-II)" data-pair-name="Nebula-II — Recessed Retrofit · 4″/6″ · 100° flood · ECO tier · ★ recommended">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">Nebula-II ★</span>
                <span class="cfg-chip-code">+ LDRR</span>
              </button>
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="module" data-val="ECRESCENT" data-code="ECRESCENT" data-pair-sku="LSMT (eCrescent)" data-pair-name="eCrescent — Edge-Lit LED Retrofit Module · ECO tier">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">eCrescent</span>
                <span class="cfg-chip-code">+ LSMT</span>
              </button>
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="module" data-val="RADIUS-II" data-code="RADIUS-II" data-pair-sku="LDRS (Radius-II)" data-pair-name="Radius-II — Slim Wafer Retrofit · 3 sizes · PRO tier · 7-yr warranty">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">Radius-II</span>
                <span class="cfg-chip-code">+ LDRS</span>
              </button>
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="module" data-val="ECLIPSE-II" data-code="ECLIPSE-II" data-pair-sku="LDLL (Eclipse-II)" data-pair-name="Eclipse-II — Surface Puck · 5 sizes (LDLL0510→LDLL1324) · PRO tier · sensor-ready">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">Eclipse-II</span>
                <span class="cfg-chip-code">+ LDLL</span>
              </button>
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="module" data-val="LUNAR-ECLIPSE" data-code="LUNAR-ECLIPSE" data-pair-sku="LDLL (Lunar Eclipse)" data-pair-name="Lunar Eclipse — Black Surface Puck · 3 sizes (LDLL0510/0715/0918) · PRO tier · IP65">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">Lunar Eclipse</span>
                <span class="cfg-chip-code">+ LDLL (LE)</span>
              </button>
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="module" data-val="ORBIT-I" data-code="ORBIT-I" data-pair-sku="LDGR (Orbit-I)" data-pair-name="Orbit-I — Retrofit Gimbal Trim Module · 60° tilt · PRO tier">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">Orbit-I</span>
                <span class="cfg-chip-code">+ LDGR</span>
              </button>
            </div>
            <div class="cfg-field-notes-compact">All five drop into the T.24 J-Box &middot; see <a href="#family">§10 Family</a>.</div>
          </div>

          <!-- Compatible Lamp — single A19 SKU pattern (LTA19F800xxMB · 5 CCT variants). -->
          <div class="cfg-field" data-field="lamp" style="grid-column: 1 / -1;">
            <div class="cfg-field-label">Companion · Compatible Lamp <span class="cfg-label-hint">(pick one CCT · separate SKU)</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="lamp" data-val="A19-27" data-code="A19-27" data-pair-sku="LTA19F80027MB" data-pair-name="A19 LED · 800 lm · 2700K · medium-base">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">A19 · 2700K</span>
                <span class="cfg-chip-code">+ LTA19F80027MB</span>
              </button>
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="lamp" data-val="A19-30" data-code="A19-30" data-pair-sku="LTA19F80030MB" data-pair-name="A19 LED · 800 lm · 3000K · medium-base">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">A19 · 3000K</span>
                <span class="cfg-chip-code">+ LTA19F80030MB</span>
              </button>
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="lamp" data-val="A19-35" data-code="A19-35" data-pair-sku="LTA19F80035MB" data-pair-name="A19 LED · 800 lm · 3500K · medium-base">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">A19 · 3500K</span>
                <span class="cfg-chip-code">+ LTA19F80035MB</span>
              </button>
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="lamp" data-val="A19-40" data-code="A19-40" data-pair-sku="LTA19F80040MB" data-pair-name="A19 LED · 800 lm · 4000K · medium-base ★">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">A19 · 4000K ★</span>
                <span class="cfg-chip-code">+ LTA19F80040MB</span>
              </button>
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="lamp" data-val="A19-50" data-code="A19-50" data-pair-sku="LTA19F80050MB" data-pair-name="A19 LED · 800 lm · 5000K · medium-base">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">A19 · 5000K</span>
                <span class="cfg-chip-code">+ LTA19F80050MB</span>
              </button>
            </div>
            <div class="cfg-field-notes-compact">SKU pattern: LTA19F800xxMB · xx = first 2 chars of CCT (27/30/35/40/50)</div>
          </div>

        </div>
      </div>
    </div>

    <!-- Horizontal legend strip — moved out of the Optional column so the
         two columns end at the same vertical line (visual balance). Spans
         the full width below cfg-body. -->
    <div class="cfg-legend-strip" aria-label="Configurator marker legend">
      <div class="cfg-legend-strip-item"><span class="cfg-legend-strip-key star">★</span><span class="cfg-legend-strip-val">Factory default</span></div>
      <div class="cfg-legend-strip-item"><span class="cfg-legend-strip-key qs">QS</span><span class="cfg-legend-strip-val">QuickShip · in-stock 1-3 days</span></div>
      <div class="cfg-legend-strip-item"><span class="cfg-legend-strip-key mto">MTO</span><span class="cfg-legend-strip-val">Made-to-Order (unused on Gehry)</span></div>
      <div class="cfg-legend-strip-item"><span class="cfg-legend-strip-key plus">+</span><span class="cfg-legend-strip-val">Companion · separate line item</span></div>
    </div>
  </div>

  <!-- ============== LIVE PREVIEW CARD ============== -->
  <div class="cfg-preview-wrap">
    <div class="cfg-preview">
      <div class="cfg-preview-grid">
        <div class="cfg-preview-img">
          <span class="cfg-preview-img-tag">Live Preview</span>
          <!-- Gehry preview photography. JS swaps img.src as the user picks
               Size chips. CRC6 default since it's the high-volume SKU. Both
               sizes share gehry-hero-1.png (only 1 main hero photo on disk per
               size — flagged for engineering follow-up to differentiate). -->
          <img id="cfgPreviewImg"
               src="/products/multi-family/gehry/assets/gehry/gehry-hero-1.png"
               alt="CRC Gehry preview — universal recessed housing, die-formed aluminum can with pre-installed swivel bracket and adjustable bar hangers, remote J-Box with TP24 Quick Connect, front 3/4 angle"
               style="width:100%; max-width:380px; height:auto; object-fit:contain;
                      filter: drop-shadow(0 18px 30px rgba(0,0,0,0.18));
                      transition: opacity 0.25s ease;" />
        </div>
        <div class="cfg-preview-body">
          <div class="cfg-sku-block">
            <div class="cfg-sku-eyebrow sec-eyebrow">Resolved SKU</div>
            <div class="cfg-sku" id="cfgSku">
              <span class="placeholder">CRC[4|6]-SB-[E26|T24]</span>
            </div>
            <button type="button" class="cfg-sku-copy" id="cfgSkuCopy" disabled>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span id="cfgSkuCopyLabel">Copy SKU</span>
            </button>
          </div>

          <!-- CFG-STATE-1: ship-tier indicator. Eclipse-II fixtures are QS-only
               across all 5 sizes / 2 finishes / 2 shapes. Companion contrⒶLS
               sensors are MTO; companion EMBs + Eclipse-II Exclusive accessories
               are QuickShip. Indicator stays live for module signature parity. -->
          <div id="cfgShipTier" style="margin: 4px 0 0; padding: 7px 10px; border-radius: 3px; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; line-height: 1.4; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
            <span id="cfgShipTierIcon" style="display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; flex-shrink: 0;"></span>
            <span id="cfgShipTierText" style="flex: 1; min-width: 180px;">— deriving ship tier —</span>
            <span id="cfgShipTierStock" style="font-size: 9px; letter-spacing: 0.10em; text-transform: uppercase; color: var(--text-muted);"></span>
          </div>

          <div class="cfg-spec-grid" id="cfgSpecGrid">
            <div class="cfg-spec-cell">
              <div class="cfg-spec-cell-key">Can Aperture</div>
              <div class="cfg-spec-cell-val placeholder" data-spec="wattage">—</div>
            </div>
            <div class="cfg-spec-cell">
              <div class="cfg-spec-cell-key">Bracket Footprint</div>
              <div class="cfg-spec-cell-val placeholder" data-spec="lumens">—</div>
            </div>
            <div class="cfg-spec-cell">
              <div class="cfg-spec-cell-key">Base Type</div>
              <div class="cfg-spec-cell-val placeholder" data-spec="lpw">—</div>
            </div>
            <div class="cfg-spec-cell">
              <div class="cfg-spec-cell-key">Lamp Envelope</div>
              <div class="cfg-spec-cell-val" data-spec="cct">PAR30 / PAR38 / R30 / BR30 / BR40 / A19 / RL Module</div>
            </div>
            <div class="cfg-spec-cell">
              <div class="cfg-spec-cell-key">Joist Span</div>
              <div class="cfg-spec-cell-val" data-spec="cri">24&Prime; OC (12&Prime; field-shortenable)</div>
            </div>
            <div class="cfg-spec-cell">
              <div class="cfg-spec-cell-key">Ceiling Thickness</div>
              <div class="cfg-spec-cell-val" data-spec="beam">1/2&Prime; – 1-3/8&Prime; (adjustable)</div>
            </div>
            <div class="cfg-spec-cell">
              <div class="cfg-spec-cell-key">Compliance</div>
              <div class="cfg-spec-cell-val" data-spec="compliance">UL · cULus · ETL · IC Rated · Air-Tight · Title 20 + Title 24/JA8 (T24 SKU)</div>
            </div>
          </div>

          <!-- CFG-PAIR-1 — companion pairings panel. Populated by the
               cfg-chip-pair toggle handler with separate-SKU line items
               that ship alongside the fixture. Hidden when no pairings
               are selected; shows a 2-column grid otherwise. -->
          <div class="cfg-pair-panel" id="cfgPairPanel" style="display:none; margin: 4px 0 0; padding: 8px 10px; border: 1px dashed var(--line); border-radius: 3px; background: rgba(227, 53, 60, 0.04);">
            <div style="font-family: 'JetBrains Mono', monospace; font-size: 9.5px; letter-spacing: 0.10em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 4px;">Pair With · Separate Line Items</div>
            <ul id="cfgPairList" style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 3px 14px; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--text-primary);"></ul>
          </div>

          <div class="cfg-incomplete-warning" id="cfgWarning">
            <strong>Configuration incomplete.</strong> Resolve both required fields (Size &middot; Base Type) to unlock pricing &amp; submittal generation.
          </div>

          <div class="cfg-cta-row">
            <a href="/pricing-availability/" class="cfg-cta primary disabled" id="cfgCtaPrice">
              Pricing &amp; Availability
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <a href="/products/multi-family/gehry/submittal/" target="_blank" rel="noopener" class="cfg-cta outline disabled" id="cfgCtaPdf">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><polyline points="9 15 12 12 15 15"/></svg>
              Generate Submittal PDF
            </a>
            <a href="/contact/?type=layout" class="cfg-cta outline" id="cfgCtaLayout">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="3" y1="9" x2="21" y2="9"/></svg>
              Request a Layout
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

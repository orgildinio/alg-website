    'par30inc_9': { fc: '25',  beam: '79 ft', label: '75W PAR30 INC · 9 FT THROW (legacy ref)', ies: 'N/A — Datasheet pg 2 reference baseline only', cone: 'M 160 40 L 100 280 L 220 280 Z' }
  };

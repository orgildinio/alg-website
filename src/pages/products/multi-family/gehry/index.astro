    'nebula_3':   { fc: '125', beam: '7 ft',  label: 'NEBULA-II 15W LED · 3 FT THROW',  ies: 'LDRR615-N2-4000K.IES', cone: 'M 160 40 L 40 280 L 280 280 Z' },

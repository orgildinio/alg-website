// =============================================================================
// SECTION 8 — Configurator (Build Your Model)
// State engine + chip click handler + dependency rules + live SKU encoder.
// All chips have data-field + data-val + data-code; required fields are
// single-select, optional fields are toggle (click again to deselect).
// =============================================================================
(function() {
  // Required and optional field IDs — mirror the data-field attrs in the markup.
  // Gehry: 2 required (size + base) + 2 optional companions (module + lamp).
  // Display-only Finish field was retired 2026-05-09 (per James) — Gehry ships
  // factory-default aluminum across the board.
  // Gating (CFG-DEPENDENCY-1):
  //   - lamp=PAR38LED chip gated to size=6 (CRC6 only — PAR38 doesn't fit CRC4)
  var REQUIRED  = ['size', 'base'];
  var OPTIONAL  = ['module', 'lamp'];
  // No multi-select fields — every chip group on Gehry is single-pick.
  var MULTI     = [];
  // Companion fields don't append to the SKU — they render in the Pair With panel.
  var COMPANION = ['module', 'lamp'];

  // SKU encoding rules — anchored to the CRC6-Gehry-Datasheet.pdf ordering matrix
  //   CRC{N}-SB-{E26|T24}
  //   prefix       CRC                       — no separator (Commercial Recessed Can family)
  //   size         {N} (4 or 6)              — direct attach to CRC · 1 digit
  //   bracket      -SB                       — emitted automatically after size when set
  //                                          encodes Swivel Bracket (only bracket type
  //                                          currently shipping; future-proofed for
  //                                          additional bracket designs)
  //   base         /E26 or /T24              — slash-separated · base socket type
  // SKU_ORDER walks the base segment after the prefix+size+SB block.
  var SKU_ORDER = ['base'];
  var SEP = {
    base: '/'
  };

  // Lookup tables for live spec computation. Per CRC6-Gehry-Datasheet.pdf
  // page 2 § Sizing & Measurements. The housing has no built-in light source,
  // so wattage / lumens / lpw fields here repurpose to physical can dimensions.
  var SPEC_TABLE = {
    size: {
      '4': { name: 'CRC4 · 4″ Housing', wattage: '4 1/4″ W × 5 5/8″ H', lumens: '8 1/8″ W × 11 7/8″ L', lpw: '4″ aperture · CRC4' },
      '6': { name: 'CRC6 · 6″ Housing', wattage: '6 1/2″ W × 7 3/8″ H', lumens: '11 7/8″ W × 14 7/8″ L', lpw: '6″ aperture · CRC6 ★' }
    },
    base: {
      'E26': 'E26 Medium-Base · universal lamp socket (legacy + LED retrofit)',
      'T24': 'T24 / JA8 LED-Only · California Title 24 · JA8-2022-E qualified'
    },
    // Live-preview image src — both sizes share gehry-hero-1.png (only 1 main hero
    // photo per size on disk — flagged Phase 2.99 carry-forward for differentiation).
    sizeImg: {
      '4': 'assets/gehry/gehry-hero-1.png',
      '6': 'assets/gehry/gehry-hero-1.png'
    }
  };

  // CFG-COMPANION-SIZE-MAP — when the user picks a companion LED module, the
  // module's size is INFERRED from the housing size (not a separate chip), so
  // the submittal can ship a real, size-matched module SKU.
  // Gehry housing size → multi-fⒶMILY module SKU per family.
  //   CRC4 (4″) → 4″ module SKU where available, otherwise nearest-smaller (5″)
  //   CRC6 (6″) → 6″ module SKU where available, otherwise nearest (7″)
  // Module families that don't ship a 4/6 split (Eclipse-II 5/7/9/11/13″,
  // Lunar Eclipse 5/7/9″) snap to the closest-fit size.
  // Catalog data verified against each module's PDP / Datasheet 2026-05-09.
  var MODULE_SIZE_MAP = {
    'NEBULA-II':     { '4': { sku: 'LDRR410',  size: '4″'  }, '6': { sku: 'LDRR615',  size: '6″'  } },
    'ECRESCENT':     { '4': { sku: 'LSMT410',  size: '4″'  }, '6': { sku: 'LSMT615',  size: '6″'  } },
    'RADIUS-II':     { '4': { sku: 'LDRS4',    size: '4″'  }, '6': { sku: 'LDRS6',    size: '6″'  } },
    'ECLIPSE-II':    { '4': { sku: 'LDLL0510', size: '5″ (closest fit · 4″ N/A)' }, '6': { sku: 'LDLL0715', size: '7″ (closest fit · 6″ N/A)' } },
    'LUNAR-ECLIPSE': { '4': { sku: 'LDLL0510', size: '5″ (closest fit · 4″ N/A)' }, '6': { sku: 'LDLL0715', size: '7″ (closest fit · 6″ N/A)' } },
    'ORBIT-I':       { '4': { sku: 'LDGR410',  size: '4″'  }, '6': { sku: 'LDGR615',  size: '6″'  } }
  };
  // Lamp companion is size-agnostic — CRC4 + CRC6 both take the same A19
  // (LTA19F800xxMB is medium-base, fits any E26 socket).
  var LAMP_SKU_MAP = {
    'A19-27': 'LTA19F80027MB',
    'A19-30': 'LTA19F80030MB',
    'A19-35': 'LTA19F80035MB',
    'A19-40': 'LTA19F80040MB',
    'A19-50': 'LTA19F80050MB'
  };

  // Default starting state — empty (no chip preselected). User picks
  // housing/finish/shape in any order; counter band tracks 0/3 → 3/3.
  var DEFAULT_STATE = {};

  function init() {
    var section   = document.getElementById('configurator');
    if (!section) return;
    var counter   = document.getElementById('cfgCount');
    var counterEl = document.getElementById('cfgCounter');
    var resetBtn  = document.getElementById('cfgReset');
    var skuEl     = document.getElementById('cfgSku');
    var copyBtn   = document.getElementById('cfgSkuCopy');
    var copyLabel = document.getElementById('cfgSkuCopyLabel');
    var warning   = document.getElementById('cfgWarning');
    var ctaPrice  = document.getElementById('cfgCtaPrice');
    var ctaPdf    = document.getElementById('cfgCtaPdf');
    var chips     = section.querySelectorAll('.cfg-chip');
    var state     = Object.assign({}, DEFAULT_STATE);

    // ---- Chip click handler ----
    // CFG-COMPANION-MUTEX: module + lamp are mutually exclusive companions —
    // a CRC housing legally takes ONE light source per fixture (the LED
    // retrofit module socket-replaces the lamp). Picking a module clears any
    // active lamp pick, and vice versa. The disabled-state visual is applied
    // in applyState() below.
    chips.forEach(function(chip) {
      chip.addEventListener('click', function() {
        if (chip.classList.contains('disabled')) return;
        var field    = chip.dataset.field;
        var val      = chip.dataset.val;
        var isOpt    = OPTIONAL.indexOf(field) >= 0;
        var isMulti  = MULTI.indexOf(field) >= 0;

        if (isMulti) {
          // Multi-select: store as array. Click toggles on/off independently.
          var arr = Array.isArray(state[field]) ? state[field].slice() : [];
          var i = arr.indexOf(val);
          if (i >= 0) arr.splice(i, 1); else arr.push(val);
          if (arr.length === 0) delete state[field]; else state[field] = arr;
        } else if (isOpt && state[field] === val) {
          // Single-select optional: clicking the active chip clears it
          delete state[field];
        } else {
          // Single-select required (or first pick on optional)
          state[field] = val;
          // CFG-COMPANION-MUTEX: enforce module/lamp exclusivity
          if (field === 'module' && state.lamp) delete state.lamp;
          if (field === 'lamp'   && state.module) delete state.module;
        }
        applyState();
      });
    });

    // ---- Reset all ----
    resetBtn.addEventListener('click', function() {
      state = Object.assign({}, DEFAULT_STATE);
      applyState();
    });

    // ---- Apply state to UI ----
    function applyState() {
      // Update chip selected states (single-pick across the board on Gehry)
      chips.forEach(function(chip) {
        var f = chip.dataset.field;
        var v = chip.dataset.val;
        chip.classList.toggle('selected', state[f] === v);

        // Dependency gating for Gehry:
        //   data-gated-size — chip is only enabled when state.size is in the list.
        //                     Examples:
        //                       lamp=PAR38LED gated to size=6 (CRC6 only — PAR38
        //                       doesn't fit the CRC4 4″ aperture)
        // CFG-COMPANION-MUTEX: when a module is picked, all lamp chips are disabled,
        //                      and vice versa. Picking the OTHER companion clears
        //                      this one's state (handled in the click handler).
        // A disabled chip auto-clears its state value if active.
        var gatedSize = chip.dataset.gatedSize;
        var disabled = false;
        if (gatedSize) {
          var allowedSizes = gatedSize.split(',');
          if (state.size && allowedSizes.indexOf(state.size) < 0) disabled = true;
        }
        // Mutex: lamp picked → disable all module chips; module picked → disable all lamp chips
        if (f === 'module' && state.lamp)   disabled = true;
        if (f === 'lamp'   && state.module) disabled = true;

        chip.classList.toggle('disabled', disabled);
        if (disabled && state[f] === v) delete state[f];
      });

      // Required-counter — straight count of REQUIRED keys present in state
      var filled = REQUIRED.filter(function(k) {
        return state[k] != null;
      }).length;
      counter.textContent = filled;
      counterEl.classList.toggle('complete', filled === REQUIRED.length);

      // SKU
      var complete = (filled === REQUIRED.length);
      renderSKU(complete);
      // Warning + CTAs
      warning.classList.toggle('show', !complete);
      ctaPrice.classList.toggle('disabled', !complete);
      ctaPdf.classList.toggle('disabled', !complete);
      copyBtn.disabled = !complete;
      // Reset copy-button state when SKU changes
      copyBtn.classList.remove('copied');
      copyLabel.textContent = 'Copy SKU';

      // Live specs + Pair With panel
      renderSpecs();
      renderPairings();
    }

    // ---- SKU encoder ----
    // Builds the Gehry pattern from CRC6-Gehry-Datasheet.pdf ordering matrix:
    //   CRC{N}-SB-{E26|T24}[/WH]
    // 4 base SKUs (8 with finish variants):
    //   CRC4-SB-E26       (4″ · Swivel Bracket · E26 legacy lamp socket)
    //   CRC4-SB-T24       (4″ · Swivel Bracket · T24 / JA8 LED-only)
    //   CRC4-SB-E26/WH    (4″ · E26 · /WH white accessory variant)
    //   CRC4-SB-T24/WH    (4″ · T24 · /WH white accessory variant)
    //   CRC6-SB-E26 ★     (6″ · Swivel Bracket · E26 legacy lamp socket)
    //   CRC6-SB-T24       (6″ · Swivel Bracket · T24 / JA8 LED-only)
    //   CRC6-SB-E26/WH    (6″ · E26 · /WH white accessory variant)
    //   CRC6-SB-T24/WH    (6″ · T24 · /WH white accessory variant)
    // Base type appends with slash separator. Finish (/WH) is display-only;
    // appended only if the user selects the WH chip (toggle).
    function renderSKU(complete) {
      var html = 'CRC';

      // Size — direct attach (no separator). Placeholder if not chosen.
      if (state.size) {
        html += state.size;
        // Fixed bracket designator: -SB (Swivel Bracket — only bracket
        // type currently shipping, future-proofed for additional designs).
        html += '-SB';
      } else {
        html += '<span class="placeholder">[4|6]</span>-SB';
      }

      // Walk SKU_ORDER — base only (finish dropped 2026-05-09).
      SKU_ORDER.forEach(function(k) {
        var val = state[k];
        var isReq = REQUIRED.indexOf(k) >= 0;

        if (val == null) {
          if (isReq) html += '<span class="placeholder">/' + placeholderFor(k) + '</span>';
          return;
        }

        var chip = section.querySelector('.cfg-chip[data-field="' + k + '"][data-val="' + val + '"]');
        var code = chip ? chip.dataset.code : '';
        if (code === '') return;
        var sep = (SEP[k] != null) ? SEP[k] : '';
        html += sep + code;
      });

      // CFG-COMPANION-SKU-RESOLVE: append the size-matched companion SKU when
      // the user has picked one. Format: HOUSING-SKU + COMPANION-SKU (with a
      // styled "+" separator + lighter weight on the companion to keep the
      // housing SKU visually primary).
      if (state.module) {
        var resolved = resolveModuleSku(state.module, state.size);
        if (resolved && resolved.sku) {
          html += '<span class="cfg-sku-plus"> + </span><span class="cfg-sku-companion">' + resolved.sku + '</span>';
        }
      } else if (state.lamp) {
        var lampSku = LAMP_SKU_MAP[state.lamp];
        if (lampSku) {
          html += '<span class="cfg-sku-plus"> + </span><span class="cfg-sku-companion">' + lampSku + '</span>';
        }
      }

      skuEl.innerHTML = html;
    }
    function placeholderFor(k) {
      return ({
        base: '[E26|T24]'
      })[k] || '[' + k.toUpperCase() + ']';
    }

    // ---- Live spec readout ----
    // For Gehry the spec tile slots are repurposed: wattage→Can Aperture,
    // lumens→Bracket Footprint, lpw→Base Type. (Finish slot dropped 2026-05-09 —
    // Gehry ships factory-default aluminum across the board.)
    function renderSpecs() {
      var sizeData = state.size ? SPEC_TABLE.size[state.size] : null;
      setSpec('wattage', sizeData ? sizeData.wattage : null);   // Can Aperture
      setSpec('lumens',  sizeData ? sizeData.lumens  : null);   // Bracket Footprint
      // Base Type spec slot — driven by the Base Type chip, not the Size chip
      var baseLabel = state.base ? SPEC_TABLE.base[state.base] : null;
      setSpec('lpw', baseLabel);

      // Swap the live-preview image src per selected size.
      // Both sizes share the same hero photo (only 1 photo per size on disk —
      // flagged Phase 2.99 carry-forward for differentiation).
      var previewImg = document.getElementById('cfgPreviewImg');
      var newSrc;
      if (state.size) {
        newSrc = SPEC_TABLE.sizeImg[state.size];
      } else {
        newSrc = SPEC_TABLE.sizeImg['6'];  // default to CRC6 hero
      }
      if (previewImg && newSrc && !previewImg.src.endsWith(newSrc)) {
        previewImg.style.opacity = '0';
        setTimeout(function() {
          previewImg.src = newSrc;
          previewImg.style.opacity = '1';
        }, 180);
      }
    }

    // ---- Companion pairings panel ----
    // Walks the COMPANION fields and renders one "+ SKU · Name" line per
    // selected pairing. Hides the panel entirely when no pairings are picked.
    // CFG-COMPANION-SIZE-MATCH: when a module is picked, the housing size
    // automatically maps to the matching module SKU (CRC4 → 4″ module SKU).
    function renderPairings() {
      var panel = document.getElementById('cfgPairPanel');
      var list  = document.getElementById('cfgPairList');
      if (!panel || !list) return;
      var rows = [];
      COMPANION.forEach(function(field) {
        var val = state[field];
        if (!val) return;
        var chip = section.querySelector('.cfg-chip[data-field="' + field + '"][data-val="' + val + '"]');
        if (!chip) return;
        var sku, name;
        if (field === 'module') {
          var resolved = resolveModuleSku(val, state.size);
          sku  = resolved.sku;
          name = resolved.name;
        } else if (field === 'lamp') {
          sku  = LAMP_SKU_MAP[val] || (chip.dataset.pairSku || val);
          name = chip.dataset.pairName || sku;
        } else {
          sku  = chip.dataset.pairSku  || chip.dataset.code || val;
          name = chip.dataset.pairName || sku;
        }
        // Render Ⓐ glyph in pair-name if present (sensor entries carry it).
        var nameHtml = name.replace(/Ⓐ/g, '<span class="aa" aria-hidden="true">Ⓐ</span>');
        rows.push('<li style="display:flex; gap:8px; padding: 3px 0;">' +
                    '<span style="color:var(--brand-red); font-weight:700;">+</span>' +
                    '<span><strong>' + sku + '</strong><br/>' +
                      '<span style="color: var(--text-muted); font-size: 10px; letter-spacing: 0.04em;">' + nameHtml + '</span>' +
                    '</span>' +
                  '</li>');
      });
      list.innerHTML = rows.join('');
      panel.style.display = rows.length ? 'block' : 'none';
    }

    // Resolve the size-matched module SKU from the active housing size.
    // When state.size is unset, defaults to '6' (the high-volume CRC6 path)
    // and tags the resolution so the user sees it's a default fallback.
    function resolveModuleSku(moduleVal, housingSize) {
      var family = MODULE_SIZE_MAP[moduleVal];
      var size   = housingSize || '6';
      var entry  = family && family[size] ? family[size] : null;
      var chip   = section.querySelector('.cfg-chip[data-field="module"][data-val="' + moduleVal + '"]');
      var familyName = chip ? (chip.dataset.pairName || chip.dataset.pairSku || moduleVal) : moduleVal;
      // Strip the family-name's leading product label (e.g., "Nebula-II — ...")
      // so the line reads cleanly as just the descriptor under the SKU.
      if (!entry) {
        return { sku: chip ? (chip.dataset.pairSku || moduleVal) : moduleVal, name: familyName };
      }
      var sizeNote = entry.size ? (' · ' + entry.size + ' module · matches CRC' + size + ' housing') : '';
      return { sku: entry.sku, name: familyName + sizeNote };
    }
    function setSpec(name, val) {
      var el = section.querySelector('[data-spec="' + name + '"]');
      if (!el) return;
      if (val == null || val === '—') {
        el.textContent = '—';
        el.classList.add('placeholder');
      } else {
        el.textContent = val;
        el.classList.remove('placeholder');
      }
    }

    // ---- Copy SKU ----
    copyBtn.addEventListener('click', function() {
      if (copyBtn.disabled) return;
      var txt = skuEl.textContent.trim();
      if (!txt) return;
      // Use Clipboard API where available, fallback to execCommand
      var done = function() {
        copyBtn.classList.add('copied');
        copyLabel.textContent = 'Copied ✓';
        setTimeout(function() {
          copyBtn.classList.remove('copied');
          copyLabel.textContent = 'Copy SKU';
        }, 1800);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(txt).then(done, done);
      } else {
        var ta = document.createElement('textarea');
        ta.value = txt;
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch(e){}
        document.body.removeChild(ta);
        done();
      }
    });

    // ---- Submittal PDF — opens submittal/ in new tab with full config in query string ----
    // The template auto-fills page-1 catalog number, quick specs, ordering-code matrix, and photometric data.
    // Canonical params per CFG-QA-1: sku · size · base
    //   plus optional companion line items (module + lamp), with module SKU
    //   pre-resolved against the housing size (CRC4 → 4″ module, CRC6 → 6″).
    function buildSubmittalUrl() {
      var sku = skuEl.textContent.trim();
      var paramsObj = {
        sku:    sku,
        size:   state.size   || '6',
        base:   state.base   || 'E26'
      };
      // CFG-COMPANION-SIZE-MATCH — ship the resolved companion SKUs (not the
      // family chip val) so the submittal renders a real, orderable BOM line.
      if (state.module) {
        paramsObj.module = state.module;                       // family chip val (e.g. NEBULA-II)
        var resolvedMod = resolveModuleSku(state.module, state.size);
        paramsObj.module_sku  = resolvedMod.sku;               // size-matched SKU (LDRR410 / LDRR615 / ...)
        paramsObj.module_name = resolvedMod.name;              // descriptor incl. size note
      }
      if (state.lamp) {
        paramsObj.lamp     = state.lamp;                       // chip val (A19-27 / A19-30 / ...)
        paramsObj.lamp_sku = LAMP_SKU_MAP[state.lamp] || '';   // resolved (LTA19F800xxMB)
      }
      var params = new URLSearchParams(paramsObj);
      return '/products/multi-family/gehry/submittal/?' + params.toString();
    }
    ctaPdf.addEventListener('click', function(e) {
      if (ctaPdf.classList.contains('disabled')) { e.preventDefault(); return; }
      // Update href to current configurator state immediately before navigation
      ctaPdf.setAttribute('href', buildSubmittalUrl());
    });

    // Initial render
    applyState();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();

// CFG-STATE-1 — derive ship-tier (QS / WB / MTO) from selected chip badges, render
// canonical 3-state status panel. Self-contained module · no dependency on the
// configurator's state object · re-derives by walking selected chips on every click.
// Custom RAL forces MTO (custom paint = factory work).
(function() {
  function deriveShipTier() {
    var section = document.getElementById('configurator');
    if (!section) return 'QS';
    var chips = section.querySelectorAll('.cfg-chip.selected, .cfg-chip[aria-pressed="true"]');
    var worst = 'QS';
    var sawCustomRal = false;
    chips.forEach(function(chip) {
      if (chip.dataset.field === 'finish' && chip.dataset.val === 'RAL') sawCustomRal = true;
      if (chip.querySelector('.cfg-chip-stock.mto')) worst = 'MTO';
      else if (chip.querySelector('.cfg-chip-stock.wb') && worst !== 'MTO') worst = 'WB';
    });
    if (sawCustomRal) {
      var input = document.getElementById('cfgRalInput');
      if (input && input.value && /^[0-9]{4}$/.test(input.value)) return 'MTO';
    }
    return worst;
  }
  function refreshShipTier() {
    var tier = deriveShipTier();
    var rowEl = document.getElementById('cfgShipTier');
    var iconEl = document.getElementById('cfgShipTierIcon');
    var textEl = document.getElementById('cfgShipTierText');
    var stockEl = document.getElementById('cfgShipTierStock');
    if (!rowEl || !iconEl || !textEl || !stockEl) return;
    if (tier === 'QS') {
      rowEl.style.background = 'rgba(95,199,122,0.08)';
      rowEl.style.border = '1px solid rgba(95,199,122,0.40)';
      iconEl.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#7fc998" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
      textEl.innerHTML = '<strong style="color:#9bd6b1;">QuickShip · à-la-carte assembly</strong> · <span style="color:var(--text-secondary);">All selected components in stock — ships 2-3 day.</span>';
      stockEl.textContent = 'QuickShip · 2-3 day';
      stockEl.style.color = '#9bd6b1';
    } else if (tier === 'WB') {
      rowEl.style.background = 'rgba(96,168,255,0.08)';
      rowEl.style.border = '1px solid rgba(96,168,255,0.40)';
      iconEl.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#7fb6ff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>';
      textEl.innerHTML = '<strong style="color:#a8c9ff;">Workbench Assembly · ~1-3 wk</strong> · <span style="color:var(--text-secondary);">One or more selected components are workbench-assembled to order.</span>';
      stockEl.textContent = 'WB · ~1-3 wk';
      stockEl.style.color = '#a8c9ff';
    } else {
      rowEl.style.background = 'rgba(255,159,28,0.08)';
      rowEl.style.border = '1px solid rgba(255,159,28,0.40)';
      iconEl.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#ffb14d" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
      textEl.innerHTML = '<strong style="color:#ffb14d;">Custom build · Made-to-Order · ~4-6 wk</strong> · <span style="color:var(--text-secondary);">One or more selected components are MTO (custom finish, MTO option, or non-stocked variant).</span>';
      stockEl.textContent = 'MTO · ~4-6 wk';
      stockEl.style.color = '#ffb14d';
    }
  }
  function init() {
    var section = document.getElementById('configurator');
    if (!section) return;
    section.addEventListener('click', function(e) {
      if (e.target.closest('.cfg-chip')) setTimeout(refreshShipTier, 50);
    });
    var ralInput = document.getElementById('cfgRalInput');
    if (ralInput) ralInput.addEventListener('input', function() { setTimeout(refreshShipTier, 50); });
    refreshShipTier();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();


// Section 3 (Motion / video carousel) is intentionally OMITTED from the Gehry
// build — no video assets exist for the CRC housing line, per
// feedback_motion_video_preflight.md. The DOM elements (#motionVideo,
// #motionCaption, #motionDots, #motionProgressBar) do not exist in this file,
// so the previous Radius-II/Orbit-I motion-carousel IIFE has been stripped.
// If video assets are ever produced for Gehry, the §3 markup + this IIFE can
// be re-cloned from the Radius-II foundation.
</script>


<script>
/* =============================================================================
   CFG-NAV-1 · Sticky-nav scroll-spy
   ----------------------------------------------------------------------------
   IntersectionObserver watches each section the sticky-nav links to. The link
   whose target is "most visible" gets `.is-current` (white bg + red text · the
   visual inverse of `.primary`). One observer, one Map, one CSS class toggle.
   The Pricing & Availability primary button is NOT a section anchor (its href
   is /pricing-availability/), so it's excluded from the spy by the
   `a[href^="#"]` selector below.
   ============================================================================= */
(function() {
  var nav = document.querySelector('.sticky-nav');
  if (!nav) return;
  var links = Array.prototype.slice.call(nav.querySelectorAll('a[href^="#"]'));
  if (!links.length) return;
  var entries = [];
  links.forEach(function(a) {
    var id = a.getAttribute('href').slice(1);
    var sec = id ? document.getElementById(id) : null;
    if (sec) entries.push({ sec: sec, link: a, ratio: 0 });
  });
  if (!entries.length) return;
  function update() {
    var best = null, bestRatio = 0;
    entries.forEach(function(e) { if (e.ratio > bestRatio) { bestRatio = e.ratio; best = e; } });
    entries.forEach(function(e) { e.link.classList.toggle('is-current', e === best && bestRatio > 0); });
  }
  var io = new IntersectionObserver(function(items) {
    items.forEach(function(item) {
      entries.forEach(function(e) { if (e.sec === item.target) e.ratio = item.intersectionRatio; });
    });
    update();
  }, {
    rootMargin: '-20% 0px -55% 0px',
    threshold: [0, 0.1, 0.25, 0.5, 0.75, 1.0]
  });
  entries.forEach(function(e) { io.observe(e.sec); });
})();
</script>


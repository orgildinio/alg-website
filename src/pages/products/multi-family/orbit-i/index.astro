<!-- ============================================================================
     SECTION 8 — Configurator (Build Your Model)
     7 required fields + 5 optional fields. SKU is built live by the JS engine
     below. The chip pattern + SKU encoder is the canonical template — for the
     other 4 v2 PDPs (proⒶRCH-III, Orbit-I, Symmetry, Titan-II), only the
     CFG_FIELDS + CFG_SPECS_FN need to change.
     Anchor: #configurator (already wired into sticky-nav).
     ============================================================================ -->
<section class="cfg-section" id="configurator">
  <div class="cfg-inner">

    <div class="cfg-head">
      <div class="cfg-eyebrow">Build Your Model</div>
      <h2 class="cfg-title">Configure Your Orbit-I</h2>
      <p class="cfg-sub">
        Every option below maps to the LDGR Orbit-I order code. Selections build the SKU live.
        <small>5-CCTselect lives on the fixture (not the SKU).</small>
      </p>
    </div>

    <div class="cfg-counter-band">
      <div class="cfg-counter" id="cfgCounter">
        <strong id="cfgCount">0</strong> of <strong>3</strong> required selected
      </div>
      <button type="button" class="cfg-reset" id="cfgReset">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="1 4 1 10 7 10"/>
          <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
        </svg>
        Reset all options
      </button>
    </div>

    <div class="cfg-body">
      <!-- ============== REQUIRED COLUMN ============== -->
      <div class="cfg-col">
        <div class="cfg-col-head">
          <div class="cfg-col-title cfg-col-title-required">Required</div>
          <div class="cfg-col-meta">3 fields · all must be set</div>
        </div>
        <div class="cfg-fields">

          <!-- Housing — combined diameter + wattage selector. Maps to the
               '410' (4″ · 10W) or '615' (6″ · 15W) segment of the order code.
               Both are QuickShip — multi-family is a high-volume QS-only line. -->
          <div class="cfg-field" data-field="housing" style="grid-column: 1 / -1;">
            <div class="cfg-field-label">Aperture &amp; Wattage <span class="req">*</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip" data-field="housing" data-val="410" data-code="410">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">4″ · 10W</span>
                <span class="cfg-chip-code">LDGR410</span>
              </button>
              <button type="button" class="cfg-chip" data-field="housing" data-val="615" data-code="615">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">6″ · 15W</span>
                <span class="cfg-chip-code">LDGR615</span>
              </button>
            </div>
          </div>

          <!-- (Orbit has no trim option per Datasheet — kept for documentation only)
          <!-- Trim Style — Baffled (B) for glare-controlled in-unit living
               and bedrooms; Smooth (S) for corridor / amenity / wet zones. -->
          <!-- Finish — two QS finishes only (W + B per Datasheet § Ordering Guide).
               Orbit ships single-trim (frosted PC lens, integrated gimbal), so no
               trim chip group. Pack is implicit via the 24-pack contractor carton,
               not a SKU suffix — so no pack chip group. Total required: 2 fields. -->
          <div class="cfg-field" data-field="finish" style="grid-column: 1 / -1;">
            <div class="cfg-field-label">Finish <span class="req">*</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip cfg-chip-finish" data-field="finish" data-val="W" data-code="W">
                <span class="cfg-finish-swatch" style="background:#f5f4f1; border:1px solid #dcdee2;"></span>
                <span class="cfg-chip-val">White ★</span>
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-code">/W</span>
              </button>
              <button type="button" class="cfg-chip cfg-chip-finish" data-field="finish" data-val="B" data-code="B">
                <span class="cfg-finish-swatch" style="background:#1a1a1a;"></span>
                <span class="cfg-chip-val">Black</span>
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-code">/B</span>
              </button>
            </div>
          </div>

          <!-- Pack Configuration — per James 2026-05-10. Single Unit ships as standard
               (drop-in retail box format); 30-Pack Carton is the contractor pallet pack
               (separate SKU suffix or PO line item — TBD per supply chain). -->
          <div class="cfg-field" data-field="pack" style="grid-column: 1 / -1;">
            <div class="cfg-field-label">Pack Configuration <span class="req">*</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip" data-field="pack" data-val="SINGLE" data-code="">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">Single Unit ★</span>
                <span class="cfg-chip-code">Standard</span>
              </button>
              <button type="button" class="cfg-chip" data-field="pack" data-val="30PK" data-code="30PK">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">30-Pack Carton</span>
                <span class="cfg-chip-code">+ /30PK</span>
              </button>
            </div>
          </div>

        </div>
      </div>

      <!-- ============== OPTIONAL COLUMN ============== -->
      <div class="cfg-col cfg-col-optional-flex">
        <div class="cfg-col-head">
          <div class="cfg-col-title">Optional · Companion Pairings</div>
          <div class="cfg-col-meta">Separate line items · pick any combination</div>
        </div>
        <div class="cfg-fields">

          <!-- Recommended Pairings — companion accessories that ship as
               separate line items, not SKU suffixes. Click adds them to the
               BOM panel in the live preview but doesn't modify the resolved
               fixture SKU. Sourced from Section 7 (full Datasheet ladder).
               Each field is single-select per Datasheet § Accessory Guide
               note 1: "Only one selection may be applicable within the
               same category." -->

          <!-- constⒶNT Emergency — full 6-SKU ladder per Datasheet § Accessory Guide.
               5 Field-Install bricks (in-line between branch + E26) + 1 Quick-Install
               (pre-wired J-Box for remote mount). All QuickShip. -->
          <div class="cfg-field" data-field="emergency" style="grid-column: 1 / -1;">
            <div class="cfg-field-label">Companion · const<span class="aa" aria-hidden="true">Ⓐ</span>NT Emergency Backup <span style="color:var(--text-muted); font-weight:400; letter-spacing:0.06em;">(pick one — separate SKU)</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="emergency" data-val="CRCU-EM24-JBM" data-code="CRCU-EM24/JBM" data-pair-sku="CRCU-EM24/JBM" data-pair-name="CRCU-EM24/JBM — 24W Universal-Mount EMB (4/5/6/7&Prime; J-Box · UL 924 · 90 min)">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">CRCU · Universal</span>
                <span class="cfg-chip-code">+ CRCU-EM24/JBM</span>
              </button>
            </div>
          </div>

          <!-- contrⒶLS by ⒶCS — full 4-SKU ladder per Datasheet. 2 occupancy
               sensors (20-ft and 40-ft mount), 1 controller / power-pack, 1
               kinetic wall switch. All Made-to-Order per Datasheet. -->
          <div class="cfg-field" data-field="sensor" style="grid-column: 1 / -1;">
            <div class="cfg-field-label">Companion · contr<span class="aa" aria-hidden="true">Ⓐ</span>LS by <span class="aa" aria-hidden="true">Ⓐ</span>CS <span style="color:var(--text-muted); font-weight:400; letter-spacing:0.06em;">(pick one — separate SKU)</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="sensor" data-val="MSP-20CM" data-code="MSP-20CM-ACS" data-pair-sku="MSP-20CM-ACS" data-pair-name="MSP-20CM/ⒶCS — 20 FT Wide-Angle PIR">
                <span class="cfg-chip-stock mto">MTO</span>
                <span class="cfg-chip-val">MSP-20CM · 20 FT</span>
                <span class="cfg-chip-code">+ MSP-20CM</span>
              </button>
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="sensor" data-val="MSP-40CM" data-code="MSP-40CM-ACS" data-pair-sku="MSP-40CM-ACS" data-pair-name="MSP-40CM/ⒶCS — 40 FT High-Bay PIR">
                <span class="cfg-chip-stock mto">MTO</span>
                <span class="cfg-chip-val">MSP-40CM · 40 FT</span>
                <span class="cfg-chip-code">+ MSP-40CM</span>
              </button>
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="sensor" data-val="MSX-LV20" data-code="MSX-LV20-ACS" data-pair-sku="MSX-LV20-ACS" data-pair-name="MSX-LV20/ⒶCS — Low-Voltage Controller / Power Pack">
                <span class="cfg-chip-stock mto">MTO</span>
                <span class="cfg-chip-val">MSX-LV20 · Power Pack</span>
                <span class="cfg-chip-code">+ MSX-LV20</span>
              </button>
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="sensor" data-val="50WM" data-code="50WM-ACS" data-pair-sku="50WM-ACS" data-pair-name="50WM/ⒶCS — Kinetic Wall Switch (battery-free)">
                <span class="cfg-chip-stock mto">MTO</span>
                <span class="cfg-chip-val">50WM · Kinetic Switch</span>
                <span class="cfg-chip-code">+ 50WM</span>
              </button>
            </div>
          </div>

          <!-- New-Construction Plates — Datasheet § Plates. Joist-mount NCP
               or T-grid drop NCP/JCB with integrated J-Box. Both QuickShip,
               sized 4/6/8/10″ apertures (Orbit ships 4″ + 6″). -->
          <div class="cfg-field" data-field="plate" style="grid-column: 1 / -1;">
            <div class="cfg-field-label">Companion · New-Construction Plate <span style="color:var(--text-muted); font-weight:400; letter-spacing:0.06em;">(pick one — separate SKU)</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="plate" data-val="NCP" data-code="LCDL-SE/NCP" data-pair-sku="LCDL-SE/NCP" data-pair-name="NCP — New-Construction Plate (joist mount)">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">NCP · Joist</span>
                <span class="cfg-chip-code">+ NCP</span>
              </button>
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="plate" data-val="NCP-JCB" data-code="LCDL-SE/NCP/JCB" data-pair-sku="LCDL-SE/NCP/JCB" data-pair-name="NCP/JCB — Plate w/ Integrated J-Box (T-grid)">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">NCP/JCB · T-Grid</span>
                <span class="cfg-chip-code">+ NCP/JCB</span>
              </button>
            </div>
          </div>

          <!-- Recessed Housing Cans — Gehry CRC family, 4 SKUs already match
               the Section 7 ladder. Branch-circuit-ready (E26 socket) or
               Title-24 IC/AT for new construction in California. -->
          <div class="cfg-field" data-field="housing_can" style="grid-column: 1 / -1;">
            <div class="cfg-field-label">Companion · Recessed Housing Can <span style="color:var(--text-muted); font-weight:400; letter-spacing:0.06em;">(pick one — separate SKU)</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip cfg-chip-toggle cfg-chip-pair" data-field="housing_can" data-val="CRC4_E26" data-code="CRC4-SB/E26" data-pair-sku="CRC4-SB/E26" data-pair-name="CRC4-SB/E26 · 4″ Pre-Wired Can (E26 socket)" data-pair-housing="410">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">CRC4-SB/E26</span>

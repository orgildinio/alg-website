<!-- ============= URL PARAM POPULATION + AUTO-PRINT ============= -->
<script>
(function() {
  // --- PARSE URL PARAMS ---
  var params = new URLSearchParams(window.location.search);
  var sku       = params.get('sku')       || 'LDGR410-S5/O1/B/W';
  var housing   = params.get('housing')   || '410';
  var wattage   = params.get('wattage')   || '10';
  var trim      = params.get('trim')      || 'B';
  var finish    = params.get('finish')    || 'W';
  var pack      = params.get('pack')      || 'SINGLE';
  var emergency = params.get('emergency') || '';
  var sensor    = params.get('sensor')    || '';
  var housingCan = params.get('housing_can') || '';
  var autoprint = params.get('autoprint') !== '0';   // default ON

  // --- AUTOFILL CATALOG NUMBER (4 page headers + project info form + control bar) ---
  var skuLive = sku;
  document.querySelectorAll('#catNum, #catNum2, #catNum3, #catNum4, #liveSku').forEach(function(el) {
    el.textContent = skuLive;
  });
  document.getElementById('piCatNum').textContent = skuLive;

  // ===== EDITABLE CATALOG NUMBER (§C 2026-05-18) =====
  (function setupEditableCatalogNumber(){
    var originalSku = sku;
    var editor = document.getElementById('catNum');
    if (!editor) return;
    function sweepTextNodes(root, fromStr, toStr){
      if (!fromStr || fromStr === toStr) return;
      var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
        acceptNode: function(n){
          var p = n.parentNode;
          while (p) {
            if (p === editor) return NodeFilter.FILTER_REJECT;
            if (p.tagName === 'SCRIPT' || p.tagName === 'STYLE') return NodeFilter.FILTER_REJECT;
            p = p.parentNode;
          }
          return n.nodeValue.indexOf(fromStr) !== -1 ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
        }
      });
      var nodes = [];
      while (walker.nextNode()) nodes.push(walker.currentNode);
      nodes.forEach(function(n){ n.nodeValue = n.nodeValue.split(fromStr).join(toStr); });
    }
    function applyOverride(newVal){
      var override = (newVal || '').replace(/[\r\n]+/g, ' ').trim().slice(0, 40);
      if (!override) override = originalSku;
      ['catNum2', 'catNum3', 'catNum4', 'piCatNum', 'liveSku'].forEach(function(id){
        var el = document.getElementById(id);
        if (el) el.textContent = override;
      });
      var spec = document.getElementById('specsEyebrow');
      if (spec) {
        var parts = spec.textContent.split(' · ');
        if (parts.length === 2) spec.textContent = parts[0] + ' · ' + override;
      }
      sweepTextNodes(document.body, originalSku, override);
      document.title = document.title.replace(originalSku, override);
    }
    var currentDisplay = originalSku;
    editor.addEventListener('input', function(){
      var newVal = (editor.textContent || '').replace(/[\r\n]+/g, ' ').slice(0, 40);
      sweepTextNodes(document.body, currentDisplay, newVal || originalSku);
      ['catNum2', 'catNum3', 'catNum4', 'piCatNum', 'liveSku'].forEach(function(id){
        var el = document.getElementById(id);
        if (el) el.textContent = newVal || originalSku;
      });
      var spec = document.getElementById('specsEyebrow');
      if (spec) {
        var parts = spec.textContent.split(' · ');
        if (parts.length === 2) spec.textContent = parts[0] + ' · ' + (newVal || originalSku);
      }
      document.title = document.title.replace(currentDisplay, newVal || originalSku);
      currentDisplay = newVal || originalSku;
    });
    editor.addEventListener('blur', function(){
      var v = editor.textContent.trim();
      if (!v) { editor.textContent = originalSku; applyOverride(originalSku); currentDisplay = originalSku; }
    });
    editor.addEventListener('keydown', function(e){
      if (e.key === 'Enter') { e.preventDefault(); editor.blur(); }
    });
  })();

  // --- AUTOFILL PRODUCT TITLE + TAGLINE ---
  var aperture = (housing === '615') ? '6″' : '4″';
  var watts    = (housing === '615') ? '15' : '10';
  document.getElementById('productTitle').textContent =
    'Orbit-I Series · ' + aperture + ' Retrofit Downlight';

  // --- AUTOFILL QUICK SPECS (lumens by housing+CCT, 4000K default) ---
  // Source: Section 6 Photometrics data table.
  var photoData = {
    '410_2700': { peak: '283', lumens: '634' },
    '410_3000': { peak: '301', lumens: '676' },
    '410_3500': { peak: '316', lumens: '708' },
    '410_4000': { peak: '321', lumens: '720' },
    '410_5000': { peak: '302', lumens: '677' },
    '615_2700': { peak: '454', lumens: '1,018' },
    '615_3000': { peak: '477', lumens: '1,070' },
    '615_3500': { peak: '521', lumens: '1,168' },
    '615_4000': { peak: '532', lumens: '1,193' },
    '615_5000': { peak: '480', lumens: '1,077' }
  };
  var pd = photoData[housing + '_4000'] || photoData['410_4000'];
  var lpw = (parseInt(pd.lumens.replace(/,/g, ''), 10) / parseInt(watts, 10)).toFixed(1);

  document.getElementById('qsLumens').innerHTML = pd.lumens + '<span class="qs-unit">lm</span>';
  document.getElementById('qsWatts').innerHTML  = watts + '<span class="qs-unit">W</span>';
  document.getElementById('qsLpw').innerHTML    = lpw + '<span class="qs-unit">lm/W</span>';

  // --- AUTOFILL HERO IMAGE per finish ---
  var heroSrc = {
    'W':  'assets/finishes/nebula-ii-finish-white.webp',
    'BK': 'assets/finishes/nebula-ii-finish-black.webp',
    'BZ': 'assets/finishes/nebula-ii-finish-bronze.webp'
  }[finish] || 'assets/finishes/nebula-ii-finish-white.webp';
  document.getElementById('heroImg').src = heroSrc;
  // Issue 6 — photometric polar plot: swap per size (no CCT split for ECO tier)
  var polarImg = document.getElementById('polarImg');
  if (polarImg) {
    polarImg.src = '/products/multi-family/orbit-i/assets/photometrics/orbit_' + housing + '.svg';
  }

  // --- AUTOFILL ORDERING CODE BREAKDOWN ---
  document.getElementById('ocHousing').textContent = housing;
  document.getElementById('ocTrim').textContent    = trim;
  document.getElementById('ocFinish').textContent  = finish + (pack === '12PK' ? '/12PK' : '');

  // --- AUTOFILL DIMENSIONS (page 3) per housing ---
  var dimData = {
    '410': {
      outer:   '4.50″',
      aperture:'4.13″',
      cutout:  '4-1/8″ Ø',
      depth:   '2.40″',
      recess:  '2.20″',
      weight:  '0.6 lbs (LDGR410) · 0.9 lbs (LDGR615)',
      mountStd:'CRC4-SB/E26 (4″ standard build)',
      mountT24:'CRC4-SB/T24 (4″ IC/AT for CA Title-24)'
    },
    '615': {
      outer:   '6.50″',
      aperture:'6.18″',
      cutout:  '6-1/4″ Ø',
      depth:   '2.40″',
      recess:  '2.20″',
      weight:  '0.6 lbs (LDGR410) · 0.9 lbs (LDGR615)',
      mountStd:'CRC6-SB/E26 (6″ standard build)',
      mountT24:'CRC6-SB/T24 (6″ IC/AT for CA Title-24)'
    }
  };
  var dd = dimData[housing] || dimData['410'];
  document.getElementById('specOd').textContent      = dd.outer + ' (LDGR' + housing + ')';
  document.getElementById('specAp').textContent      = dd.aperture + ' (LDGR' + housing + ')';
  document.getElementById('specCutout').textContent  = dd.cutout + ' (LDGR' + housing + ')';
  document.getElementById('specRecess').textContent  = dd.recess;
  document.getElementById('specDepth').textContent   = dd.depth + ' (with trim)';
  document.getElementById('specWeight').textContent  = dd.weight;
  document.getElementById('mountStd').textContent    = dd.mountStd;
  document.getElementById('mountT24').textContent    = dd.mountT24;
  document.getElementById('dimTopWidth').textContent = 'Ø ' + dd.outer;
  document.getElementById('dimAperture').textContent = 'aperture ' + dd.aperture;
  document.getElementById('dimDepth').textContent    = 'depth ' + dd.depth;
  document.getElementById('dimRecess').textContent   = 'recess ' + dd.recess;

  // --- AUTOFILL PHOTOMETRIC PAGE 4 ---
  document.getElementById('photoEyebrow').textContent =
    '100° wide-flood (60° tilt + 360° rotation gimbal) · LDGR' + housing + ' · 4000K';
  document.getElementById('photoPeak').textContent    = pd.peak + ' cd';
  document.getElementById('photoLumens').textContent  = pd.lumens + ' lm';
  document.getElementById('photoIesFile').textContent = 'LDGR' + housing + '-N2-4000K.IES';

  // --- COMPANION BOM (Page 1) ---
  // Maps companion code → friendly name pulled from Section 7 ACC data.
  var pairMap = {
    'EM23':       { sku: 'EM23',        name: 'EM23 — 90-Min Emergency Battery' },
    'SD':         { sku: 'SD/ACS',      name: 'SD/<span class="aa">Ⓐ</span>CS — Snap-On PIR Sensor' },
    'HD':         { sku: 'HD/ACS',      name: 'HD/<span class="aa">Ⓐ</span>CS — Dual-Tech + Daylight' },
    'CRC4_E26':   { sku: 'CRC4-SB/E26', name: '4″ Pre-Wired Construction Can' },
    'CRC4_T24':   { sku: 'CRC4-SB/T24', name: '4″ IC-Rated Title-24 Can' },
    'CRC6_E26':   { sku: 'CRC6-SB/E26', name: '6″ Pre-Wired Construction Can' },
    'CRC6_T24':   { sku: 'CRC6-SB/T24', name: '6″ IC-Rated Title-24 Can' }
  };
  var bomEntries = [];
  if (emergency)  bomEntries.push(pairMap[emergency]);
  if (sensor)     bomEntries.push(pairMap[sensor]);
  if (housingCan) bomEntries.push(pairMap[housingCan]);
  bomEntries = bomEntries.filter(Boolean);   // drop unrecognized values

  if (bomEntries.length) {
    var bomList = document.getElementById('bomList');
    bomList.innerHTML = bomEntries.map(function(e) {
      return '<li><span class="plus">+</span><span><strong>' + e.sku + '</strong>' +
             '<span class="pair-name">' + e.name + '</span></span></li>';
    }).join('');
    document.getElementById('bomPanel').style.display = 'block';
  }

  // --- LIVE DATE ---
  var d = new Date();
  document.getElementById('liveDate').textContent =
    d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' });
  var revStr = d.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit' }).replace('/', '-');
  document.getElementById('revDate').textContent = revStr;
  document.querySelectorAll('.rev-date').forEach(function(el) { el.textContent = revStr; });

  // --- AUTO-PRINT ---
  // Fires window.print() 600 ms after load — long enough for the browser to
  // paint the 4 pages and load the hero image. Skippable with ?autoprint=0.
  if (autoprint) {
    window.addEventListener('load', function() {
      setTimeout(function() { window.print(); }, 600);
    });
  }
})();
</script>

</body>
</html>


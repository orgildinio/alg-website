<!-- ============================================================================
     SECTION 8 — Configurator (Build Your Model)
     7 required fields + 5 optional fields. SKU is built live by the JS engine
     below. The chip pattern + SKU encoder is the canonical template — for the
     other 4 v2 PDPs (proⒶRCH-III, Orbit-I, Symmetry, Titan), only the
     CFG_FIELDS + CFG_SPECS_FN need to change.
     Anchor: #configurator (already wired into sticky-nav).
     ============================================================================ -->
<section class="cfg-section" id="configurator">
  <div class="cfg-inner">

    <div class="cfg-head">
      <div class="cfg-eyebrow">Build Your Model</div>
      <h2 class="cfg-title">Configure Your eCrescent</h2>
      <p class="cfg-sub">
        Size + Sensor + Pack &rarr; one of 5 SKUs.
        <small>★ default · QS QuickShip · <code>/P</code>=6&Prime; only · <code>/24PK</code> excludes PIR · PIR hold on back-of-disk dip (<a href="#controls" style="color:var(--brand-red); text-decoration:underline;">§5</a>)</small>
      </p>
    </div>

    <div class="cfg-counter-band">
      <div class="cfg-counter" id="cfgCounter">
        <strong id="cfgCount">0</strong> of <strong>3</strong> required selected
      </div>
      <button type="button" class="cfg-reset" id="cfgReset">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="1 4 1 10 7 10"/>
          <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
        </svg>
        Reset all options
      </button>
    </div>

    <div class="cfg-body">
      <!-- ============== REQUIRED COLUMN ============== -->
      <div class="cfg-col">
        <div class="cfg-col-head">
          <div class="cfg-col-title cfg-col-title-required">Required</div>
          <div class="cfg-col-meta">3 fields · all must be set</div>
        </div>
        <div class="cfg-fields">

          <!-- Size — 2 chips per Datasheet § Model Specifications. Maps the
               &#123;ss&#125;&#123;ww&#125; segment of LSMT&#123;ss&#125;&#123;ww&#125;-S5E[{/P}|{/24PK}]. -->
          <div class="cfg-field" data-field="size" style="grid-column: 1 / -1;">
            <div class="cfg-field-label">Size <span class="req">*</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip" data-field="size" data-val="410" data-code="410">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">4&Prime; · 10W</span>
                <span class="cfg-chip-code">LSMT410</span>
              </button>
              <button type="button" class="cfg-chip" data-field="size" data-val="615" data-code="615">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">6&Prime; · 15W ★</span>
                <span class="cfg-chip-code">LSMT615</span>
              </button>
            </div>
            <div class="cfg-field-notes" style="margin-top:6px; font-size:10px; color:var(--text-muted); letter-spacing:0.04em;">★ 6&Prime; is the high-volume multifamily SKU and the only size with the PIR option.</div>
          </div>

          <!-- Sensor — 2 chips: None (no suffix) OR /P built-in PIR (size=615 only).
               Mutually exclusive with the /24PK Pack option (no PIR+24PK combo
               in Active_SKUs). When /P is selected, the /24PK chip auto-disables. -->
          <div class="cfg-field" data-field="sensor" style="grid-column: 1 / -1;">
            <div class="cfg-field-label">Sensor <span class="req">*</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip" data-field="sensor" data-val="NONE" data-code="">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">None ★</span>
                <span class="cfg-chip-code">(no suffix)</span>
              </button>
              <button type="button" class="cfg-chip" data-field="sensor" data-val="P" data-code="/P" data-gated-size="615">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">/P · Built-in PIR</span>
                <span class="cfg-chip-code">/P (6&Prime; only)</span>
              </button>
            </div>
            <div class="cfg-field-notes" style="margin-top:6px; font-size:10px; color:var(--text-muted); letter-spacing:0.04em;">★ None ships the disk without a built-in motion sensor &mdash; pair with a wall-switch occupancy sensor or wire to an EM driver. /P (6&Prime; only) adds the factory-integrated PIR with selectable 10s / 1min / 10min hold time (back-of-disk dip switch).</div>
          </div>

          <!-- Pack — 2 chips: Single (no suffix) OR /24PK contractor master carton.
               Gated to sensor=NONE only — no PIR+24PK combo exists in Active_SKUs. -->
          <div class="cfg-field" data-field="pack" style="grid-column: 1 / -1;">
            <div class="cfg-field-label">Pack <span class="req">*</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip" data-field="pack" data-val="SINGLE" data-code="">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">Single ★</span>
                <span class="cfg-chip-code">(no suffix)</span>
              </button>
              <button type="button" class="cfg-chip" data-field="pack" data-val="24PK" data-code="/24PK" data-gated-sensor="NONE">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">/24PK · Contractor</span>
                <span class="cfg-chip-code">/24PK (no PIR)</span>
              </button>
            </div>
            <div class="cfg-field-notes" style="margin-top:6px; font-size:10px; color:var(--text-muted); letter-spacing:0.04em;">★ Single ships one fixture in a retail box. /24PK ships 24 fixtures in a contractor master carton — only available when Sensor = None (no PIR+24PK combo in Active_SKUs).</div>
          </div>

        </div>
      </div>

      <!-- ============== OPTIONAL COLUMN ============== -->
      <div class="cfg-col cfg-col-optional-flex">
        <div class="cfg-col-head">
          <div class="cfg-col-title">Optional · Companion Pairings</div>
          <div class="cfg-col-meta">Separate line items · pick any combination</div>
        </div>
        <div class="cfg-fields">

          <!-- Recommended Pairings — companion accessories that ship as
               separate line items, not SKU suffixes. Click adds them to the
               BOM panel in the live preview but doesn't modify the resolved
               fixture SKU. Sourced from Section 7 (full Datasheet ladder).
               Each field is single-select per Datasheet § Accessory Guide
               note 1: "Only one selection may be applicable within the
               same category." -->

          <!-- EM Drivers — 5-SKU ladder per LSMT-eCrescent-Datasheet.pdf §
               Emergency Driver Compatibility. All const⒝NT family bricks.
               Pick one — adds to BOM panel as separate line item. -->
          <div class="cfg-field" data-field="emergency" style="grid-column: 1 / -1;">

    <div class="cfg-body">
      <!-- ============== REQUIRED COLUMN ============== -->
      <div class="cfg-col">
        <div class="cfg-col-head">
          <div class="cfg-col-title cfg-col-title-required">Required</div>
          <div class="cfg-col-meta">2 fields · both must be set</div>
        </div>
        <div class="cfg-fields">

          <!-- Size — 4 chips per Datasheet § Ordering Guide. Maps the &#123;size&#125;
               segment of LDRS&#123;306|411|615|819&#125;-RSZ5/F. Wattage auto-locks to size:
               3″=6.5W · 4″=11W · 6″=15W · 8″=19W. Every config is 2-hour fire-rated. -->
          <div class="cfg-field" data-field="size" style="grid-column: 1 / -1;">
            <div class="cfg-field-label">Size &middot; Wattage <span class="req">*</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip" data-field="size" data-val="3" data-code="3">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">3&Prime; · 6.5W</span>
                <span class="cfg-chip-code">LDRS3</span>
              </button>

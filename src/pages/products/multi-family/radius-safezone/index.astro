                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">4&Prime; · 11W ★</span>
                <span class="cfg-chip-code">LDRS4</span>
              </button>
              <button type="button" class="cfg-chip" data-field="size" data-val="6" data-code="6">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">6&Prime; · 15W</span>
                <span class="cfg-chip-code">LDRS6</span>
              </button>
              <button type="button" class="cfg-chip" data-field="size" data-val="8" data-code="8">

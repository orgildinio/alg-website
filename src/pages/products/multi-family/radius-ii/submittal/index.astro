  // --- AUTOFILL CATALOG NUMBER (4 page headers + project info form + control bar) ---
  document.querySelectorAll('#catNum, #catNum2, #catNum3, #catNum4, #liveSku').forEach(function(el) {
    el.textContent = sku;
  });
  var pi = document.getElementById('piCatNum');
  if (pi) pi.textContent = sku;

  // --- AUTOFILL PRODUCT TITLE ---
  // Trim suffix added based on B/F selection.
  var trimLabel = (trim === 'B') ? 'Baffle Trim' : 'Flat Trim';
  document.getElementById('productTitle').textContent =
    'Radius-II Series · ' + sd.in + '″ · ' + sd.watt + 'W · Slim Wafer Recessed Downlight (White · ' + trimLabel + ')';

  // --- AUTOFILL QUICK SPECS (4000K representative row · 3500K for LDRS818) ---
  document.getElementById('qsLumens').innerHTML = sd.lumens + '<span class="qs-unit">lm</span>';
  document.getElementById('qsWatts').innerHTML  = sd.watt   + '<span class="qs-unit">W</span>';
  document.getElementById('qsLpw').innerHTML    = sd.lpw    + '<span class="qs-unit">lm/W</span>';

  // --- AUTOFILL HERO IMAGE — Radius-II White-only ---
  var heroImg = document.getElementById('heroImg');
  if (heroImg) {

  // Issue 6 — photometric polar plot: swap per size+CCT
  var polarImg = document.getElementById('polarImg');
  if (polarImg) {
    polarImg.src = '/products/multi-family/radius-ii/assets/photometrics/radius-ii_' + housing + '_' + cct + '.svg';
  }
    heroImg.src = sd.heroImg;
    heroImg.alt = 'LDRS' + size + '-R2S5' + trim + ' Radius-II — ' + sd.in + '″ slim wafer recessed downlight, white finish, ' + trimLabel + ', edge-lit PMMA';
  }

  // --- AUTOFILL ORDERING CODE BREAKDOWN (Page 4) ---
  // Radius-II SKU pattern: LDRS{ss}{ww}-R2S5{B|F}
  //   ocHousing = 3-digit size+wattage (409, 612, or 818)
  //   ocSensor  = trim segment (B or F · re-using the eCrescent ocSensor element ID)
  document.getElementById('ocHousing').textContent = size;
  var ocSensor = document.getElementById('ocSensor');
  if (ocSensor) ocSensor.textContent = trim;

  // --- AUTOFILL DIMENSIONS (Page 3) per size ---
  var specOd     = document.getElementById('specOd');     if (specOd)     specOd.textContent     = sd.diameter + ' (LDRS' + size + ')';
  var specAp     = document.getElementById('specAp');     if (specAp)     specAp.textContent     = sd.emit;
  var specCutout = document.getElementById('specCutout'); if (specCutout) specCutout.textContent = 'Plug-n-Play J-Box mounts remote (above ceiling) · plenum-rated quick-connect cable to wafer · NO housing or can required at the wafer cutout';
  var specRecess = document.getElementById('specRecess'); if (specRecess) specRecess.textContent = 'Wafer recesses into ceiling cutout · 0″ projection below ceiling line';
  var specDepth  = document.getElementById('specDepth');  if (specDepth)  specDepth.textContent  = sd.depth + ' (ultra-slim wafer · per Datasheet — typo correction: "ft" → in)';
  var specWeight = document.getElementById('specWeight');
  if (specWeight) {
    var packMatrix = { '409': 'Single/12-pack(MTO)/20-pack', '612': 'Single/12-pack(MTO)/24-pack', '818': 'Single/12-pack(QS)/20-pack' };
    var packLabels = { 'SINGLE': 'Single unit (standard)', '12PK': '12-pack contractor carton', '20PK': '20-pack contractor carton', '24PK': '24-pack contractor carton' };
    var packNote = packLabels[pack] || 'Single unit';
    specWeight.textContent = packNote + ' · ' + sd.in + '″ pack options: ' + (packMatrix[size] || 'Single/12-pack');
  }
  var mountStd   = document.getElementById('mountStd');   if (mountStd)   mountStd.textContent   = 'Direct cutout · spring clips lock from above · pop-in install · no can or housing';
  var mountT24   = document.getElementById('mountT24');   if (mountT24)   mountT24.textContent   = 'Universal NCP plate (LDRS-4R1/TGK plate-only · LDRS-6R1/TGK plate + integrated LCDL-SE/JCB J-Box) fits 4″/6″/8″/10″ apertures · joist + T-grid mounting · constⒶNT CRCU-EM24/JBM (24W · UL 924 · 90 min) pairs with all 3 Radius-II sizes';
  var dimTopW    = document.getElementById('dimTopWidth');if (dimTopW)    dimTopW.textContent    = 'Ø ' + sd.diameter;
  var dimAp      = document.getElementById('dimAperture');if (dimAp)      dimAp.textContent      = sd.emit;
  var dimDp      = document.getElementById('dimDepth');   if (dimDp)      dimDp.textContent      = 'depth ' + sd.depth;
  var dimRc      = document.getElementById('dimRecess');  if (dimRc)      dimRc.textContent      = 'slim wafer · 0″ projection';

  // --- AUTOFILL PHOTOMETRIC PAGE 4 ---
  document.getElementById('photoEyebrow').textContent =
    '115° edge-lit PMMA · LDRS' + size + ' · ' + sd.watt + 'W · ' + sd.defCct + 'K · Radius-II · white · wet location · ' + trimLabel +
    (size === '818' ? ' · 8″ photometrics not yet published — see footnote' : '');
  document.getElementById('photoPeak').textContent    = sd.peak + ' cd';
  document.getElementById('photoLumens').textContent  = sd.lumens + ' lm';
  document.getElementById('photoIesFile').textContent = 'LDRS' + size + '-R2S5_' + sd.defCct + 'K.IES' + (size === '818' ? ' (8″ pending)' : '');

  // --- COMPANION BOM (Page 1) + DYNAMIC ACCESSORY SPECS (Page 2) ---
  // 9 accessory SKUs (matching §7 + §8 of the PDP):
  //   1 constⒶNT EMB (CRCU-EM24/JBM)
  // + 2 contrⒶLS by ⒶCS sensors (MSP-SRI/8CM · MSP-SRI/40CM)
  // + 2 NCP rough-in plates (LDRS-4R1/TGK plate-only · LDRS-6R1/TGK plate + J-Box)
  // + 4 Approved Dimmers (Leviton + Lutron · Datasheet-listed)
  // All 4 companion fields independent — pick zero or any combination.
  var pairMap = {
    // constⒶNT EMB
    'CRCU-EM24-JBM': { sku: 'CRCU-EM24/JBM',       name: 'CRCU-EM24/JBM — 24W Universal-Mount EMB (4/5/6/7″ J-Box · UL 924 · ≥90 min egress)' },
    // contrⒶLS by ⒶCS
    'MSP-SRI-8CM':   { sku: 'MSP-SRI/8CM/HD/ACS',  name: 'MSP-SRI/8CM/ⒶCS — 8 FT Wide-Area PIR (BLE SigMesh · 500-node mesh · DLC NLC Qualified · in-unit)' },
    'MSP-SRI-40CM':  { sku: 'MSP-SRI/40CM/HD/ACS', name: 'MSP-SRI/40CM/ⒶCS — 40 FT High-Bay PIR (BLE SigMesh · 500-node mesh · DLC NLC Qualified · high-bay)' },
    // New Construction Plates (LCDL-SE/NCP universal — fits 4″/6″/8″/10″)
    'TGK-NOJB':      { sku: 'LDRS-4R1/TGK',        name: 'LDRS-4R1/TGK — Universal NCP plate · no integrated J-Box (lower line cost · BYO J-Box)' },
    'TGK-JB':        { sku: 'LDRS-6R1/TGK',        name: 'LDRS-6R1/TGK — Universal NCP plate + integrated LCDL-SE/JCB Soft Conduit J-Box (higher line cost · saves field-mount step)' },
    // Approved dimmer ladder (separate-line SKUs · 4 of 12 Datasheet-listed)
    'LEV-6674':      { sku: 'Leviton 6674',     name: 'Leviton 6674 — Decora Dimmer (3% to 93% dim · Datasheet-listed · sister SKUs: ELECT/V/ART 40201, 6633-P, 6613, 66EV, DDE06)' },
    'LEV-DDE06':     { sku: 'Leviton DDE06',    name: 'Leviton DDE06 — Digital Decora (3% to 93% dim · programmable · Datasheet-listed)' },
    'LUT-MACL153M':  { sku: 'Lutron MACL-153M', name: 'Lutron MACL-153M — Maestro CL Multi-Location (6% to 91% dim · 3-way/4-way · Datasheet-listed)' },
    'LUT-DVCL153P':  { sku: 'Lutron DVCL-153P', name: 'Lutron DVCL-153P — Diva CL paddle+slide (8% to 93% dim · Datasheet-listed · sister SKUs: CTCL-153P, SCL-153P, SELV-303P, DVSCELM-300P)' }
  };

  // --- ACC_SPEC_TABLE · full spec rows for the dynamic Page-2 accessory section.
  // Each entry: section-head + spec rows (key + value). JS injects a section-head
  // <tr.spec-section-head> followed by spec rows <tr><td.spec-attr><td.spec-val>
  // before the #accSpecAnchor element. Mirrors the configurator's ACC modal data
  // map for visual + content parity. Eclipse-II canonical pattern.
  var ACC_SPEC_TABLE = {
    'CRCU-EM24-JBM': {
      sectionHead: 'Selected Companion · constⒶNT CRCU-EM24/JBM (separate SKU)',
      specs: [
        ['Output Power',      '24 W · constant-power'],
        ['Runtime',           '≥ 90 min at reduced lumens (UL 924)'],
        ['Input Voltage',     '120 V AC · 50/60 Hz'],
        ['Battery',           'LiFePO4 · 24-hr recharge · 5-yr design life'],
        ['Mount',             'Universal cover · fits 4″ / 5″ / 6″ / 7″ round + octagonal J-Box openings'],
        ['Compatible With',   'all 3 LDRS Radius-II sizes (4″ / 6″ / 8″)'],
        ['Egress Performance','≥ 90 min · NFPA 101 § 7.9 · IBC § 1008.3 means-of-egress compliant'],
        ['Certification',     'UL 924 · CSA C22.2 No.141 · CEC Title 20']
      ]
    },
    'MSP-SRI-8CM': {
      sectionHead: 'Selected Companion · contrⒶLS by ⒶCS · MSP-SRI/8CM/HD/ACS (separate SKU)',
      specs: [
        ['Detection Tech',    'PIR Wide-Area · ceiling-mount'],
        ['Max Mount Height',  '8 ft (2.4 m)'],
        ['Network',           'BLE SigMesh · up to 500-node mesh'],
        ['Input Voltage',     '120-277 V AC'],
        ['Commissioning',     'ⒶCS by ALG App (iOS) · zone scheduling · OTA firmware'],
        ['Application',       'In-unit ceilings (closets, baths, laundry, leasing offices, amenity rooms)'],
        ['IP Rating',         'IP20 (interior) · −20°C to +50°C operating range'],
        ['Certification',     'UL Listed · DLC NLC Qualified for utility rebates']
      ]
    },
    'MSP-SRI-40CM': {
      sectionHead: 'Selected Companion · contrⒶLS by ⒶCS · MSP-SRI/40CM/HD/ACS (separate SKU)',
      specs: [
        ['Detection Tech',    'PIR Wide-Area · High-Detection'],
        ['Max Mount Height',  '40 ft (12 m)'],
        ['Network',           'BLE SigMesh · up to 500-node mesh (shared with 8CM session)'],
        ['Input Voltage',     '120-277 V AC'],
        ['Commissioning',     'ⒶCS by ALG App (iOS)'],
        ['Application',       'Parking decks · stairwells · mechanical rooms · tall amenity ceilings'],
        ['IP Rating',         'IP20 (interior) · −20°C to +50°C operating range'],
        ['Certification',     'UL Listed · DLC NLC Qualified for utility rebates']
      ]
    },
    'TGK-NOJB': {
      sectionHead: 'Selected Companion · LDRS-4R1/TGK Universal NCP — plate only (separate SKU)',
      specs: [
        ['Aperture Compatibility', '4″ (Ø4 21/64″) · 6″ (Ø6 1/2″) · 8″ (Ø8 7/64″) · 10″ (Ø10 1/16″) — concentric scribe rings'],
        ['Material',               'Galvanized iron stamped plate'],
        ['Plate Size',             '23.74″ × 11.02″ (603 × 280 mm)'],
        ['Mount Options',          'New-construction joist · T-grid drop ceiling'],
        ['Joist Compatibility',    'Standard 16″ and 24″ joist spacing · pre-slotted'],
        ['J-Box Bundle',           'NOT included — bring your own (existing in-ceiling wiring or contractor preference)'],
        ['Compatible',             'LDRS Radius-II 4″/6″/8″ + LCDL commercial downlight family'],
        ['Lead Time',              'QuickShip']
      ]
    },
    'TGK-JB': {
      sectionHead: 'Selected Companion · LDRS-6R1/TGK Universal NCP — plate + integrated J-Box (separate SKU)',
      specs: [
        ['Aperture Compatibility', '4″ · 6″ · 8″ · 10″ (same universal plate as LDRS-4R1/TGK)'],
        ['Material',               'Galvanized iron plate + factory-mounted J-Box'],
        ['Plate Size',             '23.74″ × 11.02″ (603 × 280 mm)'],
        ['Integrated J-Box',       'LCDL-SE/JCB Soft Conduit J-Box · pre-attached at correct offset for commercial downlight extraction'],
        ['Mount Options',          'New-construction joist · T-grid drop ceiling'],
        ['Cost vs. Plate-Only',    'Higher PO line cost · saves field-mount J-Box step on multi-unit rough-ins'],
        ['Compatible',             'LDRS Radius-II 4″/6″/8″ + LCDL commercial downlight family'],
        ['Lead Time',              'QuickShip']
      ]
    },
    'LEV-6674': {
      sectionHead: 'Selected Companion · Leviton 6674 Decora Dimmer (separate SKU)',
      specs: [
        ['Type',          'Decora paddle dimmer (TRIAC + ELV)'],
        ['Min Output',    '10 mA'],
        ['Max Output',    '268 mA'],
        ['Dim Range',     '3% to 93%'],
        ['Compatible',    'All 3 Radius-II sizes (4″ · 6″ · 8″)'],
        ['Sister SKUs',   'ELECT/V/ART 40201 · 6633-P · 6613 · 66EV · DDE06']
      ]
    },
    'LEV-DDE06': {
      sectionHead: 'Selected Companion · Leviton DDE06 Digital Decora (separate SKU)',
      specs: [
        ['Type',          'Digital Decora · programmable scenes'],
        ['Min Output',    '9 mA'],
        ['Max Output',    '266 mA'],
        ['Dim Range',     '3% to 93%'],
        ['Compatible',    'All 3 Radius-II sizes (4″ · 6″ · 8″)'],
        ['Wall-Plate',    'Decora-style']
      ]
    },
    'LUT-MACL153M': {
      sectionHead: 'Selected Companion · Lutron MACL-153M Maestro CL (separate SKU)',
      specs: [
        ['Type',          'Maestro CL · multi-location (3-way/4-way with companion remote)'],
        ['Min Output',    '18 mA'],
        ['Max Output',    '260 mA'],
        ['Dim Range',     '6% to 91%'],
        ['Multi-Location','3-way / 4-way with companion remote'],
        ['Compatible',    'All 3 Radius-II sizes (4″ · 6″ · 8″)']
      ]
    },
    'LUT-DVCL153P': {
      sectionHead: 'Selected Companion · Lutron DVCL-153P Diva CL (separate SKU)',
      specs: [
        ['Type',          'Diva CL · paddle + slide'],
        ['Min Output',    '23 mA'],
        ['Max Output',    '267 mA'],
        ['Dim Range',     '8% to 93%'],
        ['Compatible',    'All 3 Radius-II sizes (4″ · 6″ · 8″)'],
        ['Sister SKUs',   'CTCL-153P · SCL-153P · SELV-303P · DVSCELM-300P']
      ]
    }
  };

  var bomEntries = [];
  if (emergency) bomEntries.push(pairMap[emergency]);
  if (sensor)    bomEntries.push(pairMap[sensor]);
  if (tgrid)     bomEntries.push(pairMap[tgrid]);
  if (dimmer)    bomEntries.push(pairMap[dimmer]);
  bomEntries = bomEntries.filter(Boolean);

  if (bomEntries.length) {
    var bomList = document.getElementById('bomList');
    if (bomList) {
      bomList.innerHTML = bomEntries.map(function(e) {
        return '<li><span class="plus">+</span><span><strong>' + e.sku + '</strong>' +
               '<span class="pair-name">' + e.name + '</span></span></li>';
      }).join('');
      var bomPanel = document.getElementById('bomPanel');
      if (bomPanel) bomPanel.style.display = 'block';
    }
  }

  // --- Page 2 · Dynamic Selected-Companion Accessory Specs section ---
  // For each selected companion, insert a section-head row + spec rows before
  // the #accSpecAnchor placeholder. Eclipse-II canonical pattern: BOM panel on
  // Page 1 lists the SKUs; this Page-2 block surfaces the full spec sheet for
  // each — so submitting the PDF to a spec writer includes the EM driver's
  // wattage, runtime, certs, mount options, etc. inline.
  var anchor = document.getElementById('accSpecAnchor');
  if (anchor) {
    var selectedAcc = [emergency, sensor, tgrid, dimmer].filter(Boolean);
    selectedAcc.forEach(function(key) {
      var entry = ACC_SPEC_TABLE[key];
      if (!entry) return;
      var html = '<tr class="spec-section-head"><td colspan="2">' + entry.sectionHead + '</td></tr>';
      entry.specs.forEach(function(s) {
        html += '<tr><td class="spec-attr">' + s[0] + '</td><td class="spec-val">' + s[1] + '</td></tr>';
      });
      anchor.insertAdjacentHTML('beforebegin', html);
    });
  }

  // --- LIVE DATE ---
  var d = new Date();
  var liveDate = document.getElementById('liveDate');
  if (liveDate) liveDate.textContent = d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' });
  var revStr = d.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit' }).replace('/', '-');
  var revDate = document.getElementById('revDate');
  if (revDate) revDate.textContent = revStr;
  document.querySelectorAll('.rev-date').forEach(function(el) { el.textContent = revStr; });

  // --- AUTO-PRINT ---
  // Fires window.print() 600 ms after load — long enough for the browser to
  // paint the 4 pages and load the hero image. Skippable with ?autoprint=0.
  if (autoprint) {
    window.addEventListener('load', function() {
      setTimeout(function() { window.print(); }, 600);
    });
  }
})();
</script>

</body>
</html>


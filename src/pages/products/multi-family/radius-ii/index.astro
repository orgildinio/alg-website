                <span class="cfg-chip-val">Single Unit &#9733;</span>
                <span class="cfg-chip-code">Standard</span>
              </button>
              <button type="button" class="cfg-chip" data-field="pack" data-val="12PK" data-code="12PK" data-gated-size="409,612,818" data-stock-tier-409="mto" data-stock-tier-612="mto" data-stock-tier-818="qs">
                <span class="cfg-chip-stock mto">MTO</span>
                <span class="cfg-chip-val">12-Pack Carton</span>
                <span class="cfg-chip-code">+ /12PK</span>
              </button>
              <button type="button" class="cfg-chip" data-field="pack" data-val="20PK" data-code="20PK" data-gated-size="409,818" data-stock-tier-409="qs" data-stock-tier-818="qs">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">20-Pack Carton</span>
                <span class="cfg-chip-code">+ /20PK</span>
              </button>
              <button type="button" class="cfg-chip" data-field="pack" data-val="24PK" data-code="24PK" data-gated-size="612" data-stock-tier-612="qs">

          <polyline points="1 4 1 10 7 10"/>
          <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
        </svg>
        Reset all options
      </button>
    </div>

    <div class="cfg-body">
      <!-- ============== REQUIRED COLUMN ============== -->
      <div class="cfg-col">
        <div class="cfg-col-head">
          <div class="cfg-col-title cfg-col-title-required">Required</div>
          <div class="cfg-col-meta">2 fields · both must be set</div>
        </div>
        <div class="cfg-fields">

          <!-- Size — 3 chips per Datasheet § Model Specifications. Maps the
               &#123;ss&#125;&#123;ww&#125; segment of LDRS&#123;ss&#125;&#123;ww&#125;-R2S5&#123;B|F&#125;. Wattage auto-locks
               to size: 4″=09W · 6″=12W · 8″=18W. -->
          <div class="cfg-field" data-field="size" style="grid-column: 1 / -1;">
            <div class="cfg-field-label">Size &middot; Wattage <span class="req">*</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip" data-field="size" data-val="409" data-code="409">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">4&Prime; · 9W</span>
                <span class="cfg-chip-code">LDRS409</span>
              </button>
              <button type="button" class="cfg-chip" data-field="size" data-val="612" data-code="612">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">6&Prime; · 12W</span>
                <span class="cfg-chip-code">LDRS612</span>
              </button>
              <button type="button" class="cfg-chip" data-field="size" data-val="818" data-code="818">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">8&Prime; · 18W ★</span>
                <span class="cfg-chip-code">LDRS818</span>
              </button>
            </div>
            <div class="cfg-field-notes" style="margin-top:6px; font-size:10px; color:var(--text-muted); letter-spacing:0.04em;">★ 8&Prime; opens the spec for stairwells, elevator lobbies, and larger corridors. T-Grid Installation Kit is available in 4&Prime; + 6&Prime; only (no 8&Prime; T-Grid kit currently published).</div>
          </div>

          <!-- Trim — 2 chips: Baffle (B) or Flat (F) per Datasheet Ordering Guide. -->
          <div class="cfg-field" data-field="trim" style="grid-column: 1 / -1;">
            <div class="cfg-field-label">Trim Style <span class="req">*</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip" data-field="trim" data-val="B" data-code="B">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">Baffle (B)</span>
                <span class="cfg-chip-code">/B</span>
              </button>
              <button type="button" class="cfg-chip" data-field="trim" data-val="F" data-code="F">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">Flat (F) ★</span>
                <span class="cfg-chip-code">/F</span>
              </button>
            </div>
            <div class="cfg-field-notes" style="margin-top:6px; font-size:10px; color:var(--text-muted); letter-spacing:0.04em;">★ Flat (F) is the standard low-profile aesthetic. Baffle (B) adds glare-control ribbing for direct-view applications (corridors, bathrooms, conference rooms). Both ship in the same retail box format and pair with the same Matte Black + Copper detachable trim plate accessories.</div>
          </div>

          <!-- Pack Configuration — Required · per-size matrix -->

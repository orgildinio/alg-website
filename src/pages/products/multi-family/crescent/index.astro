             '</tr>';
    }).join('');
  }
  // Swap the Dimensions inline-SVG labels to match the active size tab.
  // Top-view diameter, side-view diameter, and depth all update simultaneously.
  function swapDim(w) {
    var d = dims[w];
    if (!d) return;
    var topDiam  = document.getElementById('dimDiamLabel');
    var sideDiam = document.getElementById('dimSideDiamLabel');
    var depth    = document.getElementById('dimDepthLabel');
    if (topDiam)  topDiam.textContent  = 'Ø ' + d.diam;
    if (sideDiam) sideDiam.textContent = 'Ø ' + d.diam;
    if (depth)    depth.textContent    = d.depth;
  }

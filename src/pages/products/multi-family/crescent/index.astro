      { watt: '10W', lumens: '630 lm',   lpw: '63 lm/W', cct: '5000K', volt: '120Vac', def: false }
    ],
    '615': [
      { watt: '15W', lumens: '900 lm',     lpw: '60 lm/W', cct: '2700K', volt: '120Vac', def: false },

<!-- ============================================================================
     SECTION 8 — Configurator (Build Your Model)
     7 required fields + 5 optional fields. SKU is built live by the JS engine
     below. The chip pattern + SKU encoder is the canonical template — for the
     other 4 v2 PDPs (proⒶRCH-III, Orbit-I, Symmetry, Titan-II), only the
     CFG_FIELDS + CFG_SPECS_FN need to change.
     Anchor: #configurator (already wired into sticky-nav).
     ============================================================================ -->
<section class="cfg-section" id="configurator">
  <div class="cfg-inner">

    <div class="cfg-head">
      <div class="cfg-eyebrow">Build Your Model</div>
      <h2 class="cfg-title">Configure Your Crescent</h2>
      <p class="cfg-sub">
        Selections build the LSMT Crescent SKU live.
        <small>★ default · QS QuickShip · 5-CCT on dip (not SKU)</small>
      </p>
    </div>

    <div class="cfg-counter-band">
      <div class="cfg-counter" id="cfgCounter">
        <strong id="cfgCount">0</strong> of <strong>3</strong> required selected
      </div>
      <button type="button" class="cfg-reset" id="cfgReset">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="1 4 1 10 7 10"/>
          <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
        </svg>
        Reset all options
      </button>
    </div>

    <div class="cfg-body">
      <!-- ============== REQUIRED COLUMN ============== -->
      <div class="cfg-col">
        <div class="cfg-col-head">
          <div class="cfg-col-title cfg-col-title-required">Required</div>
          <div class="cfg-col-meta">3 fields · all must be set</div>
        </div>
        <div class="cfg-fields">

          <!-- Aperture & Wattage — 5 chips per Datasheet § Model Specifications.
               Maps the &#123;nn&#125;&#123;ww&#125; segment of LDLL&#123;nn&#125;&#123;ww&#125;-S5/&#123;F&#125;[/&#123;S&#125;].
               All 5 sizes ship in W and B finish; only 7/9/11 ship in Square. -->
          <div class="cfg-field" data-field="housing" style="grid-column: 1 / -1;">
            <div class="cfg-field-label">Aperture &amp; Wattage <span class="req">*</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip" data-field="housing" data-val="0510" data-code="0510">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">5&Prime; · 10W</span>
                <span class="cfg-chip-code">LDLL0510</span>
              </button>
              <button type="button" class="cfg-chip" data-field="housing" data-val="0715" data-code="0715">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">7&Prime; · 15W</span>
                <span class="cfg-chip-code">LDLL0715</span>
              </button>
              <button type="button" class="cfg-chip" data-field="housing" data-val="0918" data-code="0918">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">9&Prime; · 18W</span>
                <span class="cfg-chip-code">LDLL0918</span>
              </button>
              <button type="button" class="cfg-chip" data-field="housing" data-val="1121" data-code="1121">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">11&Prime; · 21W ★</span>
                <span class="cfg-chip-code">LDLL1121</span>
              </button>
              <button type="button" class="cfg-chip" data-field="housing" data-val="1324" data-code="1324">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">13&Prime; · 24W</span>
                <span class="cfg-chip-code">LDLL1324</span>
              </button>
            </div>
          </div>

          <!-- Finish — two QS finishes per Datasheet § Ordering Guide. White
               is default (matches default ship config). Maps to /W or /B SKU
               suffix. NOTE: Square shape ships White only (per Active_SKUs). -->
          <div class="cfg-field" data-field="finish" style="grid-column: 1 / -1;">
            <div class="cfg-field-label">Finish <span class="req">*</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip cfg-chip-finish" data-field="finish" data-val="W" data-code="W">
                <span class="cfg-finish-swatch" style="background:#f5f4f1; border:1px solid #dcdee2;"></span>
                <span class="cfg-chip-val">White ★</span>
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-code">/W</span>
              </button>
              <button type="button" class="cfg-chip cfg-chip-finish" data-field="finish" data-val="B" data-code="B">
                <span class="cfg-finish-swatch" style="background:#1a1a1a;"></span>
                <span class="cfg-chip-val">Black</span>
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-code">/B</span>
              </button>
            </div>
          </div>

          <!-- Shape — Round (default) or Square. Square is gated to 7/9/11 only
               per Active_SKUs roster. Square + Black is NOT a valid combo
               (Square ships White only). The chip-state JS disables Square
               when housing is 5/13″ OR finish is Black, and the SKU encoder
               appends /S only when Square is selected. -->
          <div class="cfg-field" data-field="shape" style="grid-column: 1 / -1;">
            <div class="cfg-field-label">Shape <span class="req">*</span></div>
            <div class="cfg-chips">
              <button type="button" class="cfg-chip" data-field="shape" data-val="R" data-code="">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">Round ★</span>
                <span class="cfg-chip-code">(no suffix)</span>
              </button>
              <button type="button" class="cfg-chip" data-field="shape" data-val="S" data-code="/S" data-gated-housing="0715,0918,1121" data-gated-finish="W">
                <span class="cfg-chip-stock qs">QS</span>
                <span class="cfg-chip-val">Square</span>
                <span class="cfg-chip-code">/S</span>

    }
    function applyOverride(newVal){
      var override = (newVal || '').replace(/[\r\n]+/g, ' ').trim().slice(0, 40);
      if (!override) override = originalSku;
      ['catNum2', 'catNum3', 'catNum4', 'piCatNum', 'liveSku'].forEach(function(id){
        var el = document.getElementById(id);
        if (el) el.textContent = override;
      });
      var spec = document.getElementById('specsEyebrow');
      if (spec) {
        var parts = spec.textContent.split(' · ');
        if (parts.length === 2) spec.textContent = parts[0] + ' · ' + override;
      }
      sweepTextNodes(document.body, originalSku, override);
      document.title = document.title.replace(originalSku, override);
    }
    var currentDisplay = originalSku;
    editor.addEventListener('input', function(){
      var newVal = (editor.textContent || '').replace(/[\r\n]+/g, ' ').slice(0, 40);
      sweepTextNodes(document.body, currentDisplay, newVal || originalSku);
      ['catNum2', 'catNum3', 'catNum4', 'piCatNum', 'liveSku'].forEach(function(id){
        var el = document.getElementById(id);
        if (el) el.textContent = newVal || originalSku;
      });
      var spec = document.getElementById('specsEyebrow');
      if (spec) {
        var parts = spec.textContent.split(' · ');
        if (parts.length === 2) spec.textContent = parts[0] + ' · ' + (newVal || originalSku);
      }
      document.title = document.title.replace(currentDisplay, newVal || originalSku);
      currentDisplay = newVal || originalSku;
    });
    editor.addEventListener('blur', function(){
      var v = editor.textContent.trim();
      if (!v) { editor.textContent = originalSku; applyOverride(originalSku); currentDisplay = originalSku; }
    });
    editor.addEventListener('keydown', function(e){
      if (e.key === 'Enter') { e.preventDefault(); editor.blur(); }
    });
  })();


  // --- AUTOFILL PRODUCT TITLE ---
  // PIR variant gets "with Built-in PIR" suffix; pack variant adds "24-Pack Carton" tag.
  var titleSuffix = '';
  if (sensor === 'P')   titleSuffix += ' · Built-in PIR (/P)';
  if (pack === '24PK')  titleSuffix += ' · 24-Pack Contractor Carton';
  document.getElementById('productTitle').textContent =
    'eCrescent Series · ' + sd.in + '″ · ' + sd.watt + 'W · Surface-Mount Disk Downlight (White · IP65 Wet)' + titleSuffix;

  // --- AUTOFILL QUICK SPECS (4000K representative row) ---
  document.getElementById('qsLumens').innerHTML = sd.lumens + '<span class="qs-unit">lm</span>';
  document.getElementById('qsWatts').innerHTML  = sd.watt   + '<span class="qs-unit">W</span>';
  document.getElementById('qsLpw').innerHTML    = sd.lpw    + '<span class="qs-unit">lm/W</span>';

  // --- AUTOFILL HERO IMAGE — eCrescent White-only · sensor=P swaps to PIR photo ---
  var heroImg = document.getElementById('heroImg');
  if (heroImg) {
    if (sensor === 'P' && size === '615') {
      heroImg.src = '/products/multi-family/crescent/assets/ecrescent/ecrescent-pir-2.png';
      heroImg.alt = 'LSMT615-S5E/P eCrescent — 6″ disk with built-in PIR sensor at the rim';
    } else {
      heroImg.src = sd.heroImg;
      heroImg.alt = 'LSMT' + size + '-S5E eCrescent — ' + sd.in + '″ surface-mount disk downlight, white finish, IP65 wet';
    }
  }

  // --- AUTOFILL ORDERING CODE BREAKDOWN (Page 4) ---
  // eCrescent SKU pattern: LSMT{ss}{ww}-S5E[/P|][/24PK|]
  //   ocHousing = 3-digit size+wattage (410 or 615)
  //   ocSensor  = "/P" or "—"
  //   ocPack    = "/24PK" or "—"
  document.getElementById('ocHousing').textContent = size;
  var ocSensor = document.getElementById('ocSensor');
  if (ocSensor) ocSensor.textContent = (sensor === 'P') ? '/P' : '—';
  var ocPack = document.getElementById('ocPack');
  if (ocPack) ocPack.textContent = (pack === '24PK') ? '/24PK' : '—';

  // --- AUTOFILL DIMENSIONS (Page 3) per size ---
  var specOd     = document.getElementById('specOd');     if (specOd)     specOd.textContent     = sd.diameter + ' (LSMT' + size + ')';
  var specAp     = document.getElementById('specAp');     if (specAp)     specAp.textContent     = sd.emit + ' (back-lit polycarbonate diffuser face)';
  var specCutout = document.getElementById('specCutout'); if (specCutout) specCutout.textContent = sd.jbox;
  var specRecess = document.getElementById('specRecess'); if (specRecess) specRecess.textContent = '0″ — surface-mount disk · no ceiling cut-out';
  var specDepth  = document.getElementById('specDepth');  if (specDepth)  specDepth.textContent  = sd.depth + ' (low-profile back-lit form factor)';
  var specWeight = document.getElementById('specWeight');
  if (specWeight) {
    if (pack === '24PK') {
      specWeight.textContent = '24-pack master carton — currently configured (LSMT' + size + '-S5E/24PK)';
    } else {
      specWeight.textContent = '24-pack master carton available (append /24PK to SKU)';
    }
  }
  var mountStd   = document.getElementById('mountStd');   if (mountStd)   mountStd.textContent   = sd.jbox + ' · 2 screws · 0″ recess';
  var mountT24   = document.getElementById('mountT24');   if (mountT24)   mountT24.textContent   = '5″ or 6″ existing recessed can · spring iron + E26 whip from included conversion kit';
  var dimTopW    = document.getElementById('dimTopWidth');if (dimTopW)    dimTopW.textContent    = 'Ø ' + sd.diameter;
  var dimAp      = document.getElementById('dimAperture');if (dimAp)      dimAp.textContent      = 'Ø ' + sd.emit + ' emit';
  var dimDp      = document.getElementById('dimDepth');   if (dimDp)      dimDp.textContent      = 'depth ' + sd.depth;
  var dimRc      = document.getElementById('dimRecess');  if (dimRc)      dimRc.textContent      = 'surface mount · 0″ recess';

  // --- AUTOFILL PHOTOMETRIC PAGE 4 ---
  document.getElementById('photoEyebrow').textContent =
    '120° wide-flood (back-lit polycarbonate) · LSMT' + size + ' · ' + sd.watt + 'W · 4000K · eCrescent · white · IP65 wet' +
    (sensor === 'P' ? ' · /P built-in PIR variant' : '');
  document.getElementById('photoPeak').textContent    = sd.peak + ' cd';
  document.getElementById('photoLumens').textContent  = sd.lumens + ' lm';
  // IES filename uses the legacy LSMT-S5 (not S5E) bundle suffix · same photometric output
  document.getElementById('photoIesFile').textContent = 'LSMT' + size + '-S5 (4000K)_IESNA2002.IES';

  // --- COMPANION BOM (Page 1) — eCrescent ladder ---
  // 5 const⒝NT EM driver SKUs + 4 approved-dimmer SKUs (matching §7 + §8 of the PDP).
  // Both companion fields are independent — user can pick zero, one, or both.
  var pairMap = {
    // const⒝NT EM driver ladder (separate-line SKUs)
    'CRC6-EM/JBS':   { sku: 'CRC6-EM/JBS',  name: 'CRC6-EM/JBS — Small J-Box Surface EM (UL 924 · ≥90 min egress)' },
    'CRC6-EM/JBW':   { sku: 'CRC6-EM/JBW',  name: 'CRC6-EM/JBW — Wall-Mount J-Box EM (4″ wall box)' },
    'CRCU-EM/JBM':   { sku: 'CRCU-EM/JBM',  name: 'CRCU-EM/JBM — Universal J-Box EM (4″ or 6″ J-box)' },
    'EM15-HMB':      { sku: 'EM15-HMB',     name: 'EM15-HMB — High-Mount 15W EM (matches LSMT615 at near-rated output)' },
    'EM15-170DC':    { sku: 'EM15-170DC',   name: 'EM15-170DC — 170VDC Remote-Mount EM (separated emergency circuit)' },
    // Approved dimmer ladder (separate-line SKUs · representative pick from 18-SKU list)
    'LEV-6672':      { sku: 'Leviton 6672',     name: 'Leviton 6672 — Decora Rotary 600W LED (also: RNL06, IPL06, 6674)' },
    'LEV-DSL06':     { sku: 'Leviton DSL06',    name: 'Leviton DSL06 — Decora Slide+Toggle 600W LED' },
    'LUT-MACL153M':  { sku: 'Lutron MACL-153M', name: 'Lutron MACL-153M — Maestro CL Multi-Location 150W LED (also: TGCL-153PH-LA, MA-R)' },
    'LUT-PD6WCL':    { sku: 'Lutron PD-6WCL',   name: 'Lutron PD-6WCL — Caseta Wireless Smart Dimmer 150W LED (Smart Bridge required)' }
  };
  var bomEntries = [];
  if (emergency) bomEntries.push(pairMap[emergency]);
  if (dimmer)    bomEntries.push(pairMap[dimmer]);
  bomEntries = bomEntries.filter(Boolean);

  if (bomEntries.length) {
    var bomList = document.getElementById('bomList');
    if (bomList) {
      bomList.innerHTML = bomEntries.map(function(e) {
        return '<li><span class="plus">+</span><span><strong>' + e.sku + '</strong>' +
               '<span class="pair-name">' + e.name + '</span></span></li>';
      }).join('');
      var bomPanel = document.getElementById('bomPanel');
      if (bomPanel) bomPanel.style.display = 'block';
    }
  }

  // --- LIVE DATE ---
  var d = new Date();
  var liveDate = document.getElementById('liveDate');
  if (liveDate) liveDate.textContent = d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' });
  var revStr = d.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit' }).replace('/', '-');
  var revDate = document.getElementById('revDate');
  if (revDate) revDate.textContent = revStr;
  document.querySelectorAll('.rev-date').forEach(function(el) { el.textContent = revStr; });

  // --- AUTO-PRINT ---
  // Fires window.print() 600 ms after load — long enough for the browser to
  // paint the 4 pages and load the hero image. Skippable with ?autoprint=0.
  if (autoprint) {
    window.addEventListener('load', function() {
      setTimeout(function() { window.print(); }, 600);
    });
  }
})();
</script>

</body>
</html>


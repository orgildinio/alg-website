---
/**
 * LSMT Crescent / eCrescent — Submittal Sheet — Submittal Generator
 * Route: /products/multi-family/crescent/submittal/
 * 
 * Standalone print-optimized page. No site header/footer.
 * URL params auto-populate the submittal fields.
 * Fires window.print() 600ms after load (suppress with ?autoprint=0).
 * 
 * Source: submittal_ecrescent.html
 */
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>LSMT eCrescent — Submittal Sheet</title>

<!--
  ALG eCRESCENT SUBMITTAL TEMPLATE v1
  ===================================
  Reads URL query params from the §8 configurator and auto-fills:
    - Catalog number (4 page headers + project info form)
    - Quick spec grid (Lumens / Wattage / CCT / CRI / Beam / Voltage)
    - Ordering code visual breakdown (LSMT · &#123;ss&#125;&#123;ww&#125; · -S5E · [/P|/24PK|])
    - Companion BOM list (const<span class="aa">Ⓐ</span>NT EM driver + approved dimmer)
    - Photometric polar plot + IES file name + peak intensity per size+CCT

  Param schema (matches buildSubmittalUrl() in mockup_ecrescent_pdp_v1.html):
    ?sku=LSMT615-S5E[/P|/24PK|]
    &size=410|615   &wattage=10|15
    &sensor=NONE|P  &pack=SINGLE|24PK
    [&emergency=CRC6-EM/JBS|CRC6-EM/JBW|CRCU-EM/JBM|EM15-HMB|EM15-170DC]
    [&dimmer=LEV-6672|LEV-DSL06|LUT-MACL153M|LUT-PD6WCL]
    [&autoprint=1]     ← auto-trigger window.print() on load (default behavior)

  Print: page auto-fires window.print() 600 ms after load. The user gets the
  browser's Save-as-PDF dialog without an extra click. To suppress, append
  &autoprint=0 to the URL.
-->

<style>
  /* ============= PRINT-OPTIMIZED CSS ============= */
  @page {
    size: letter portrait;
    margin: 0.5in 0.6in;
  }
  @media print {
    .no-print { display: none !important; }
    body { background: white !important; }
    .page { box-shadow: none !important; margin: 0 !important; page-break-after: always; }
    .page:last-of-type { page-break-after: auto; }
  }

  /* ============= TYPE + COLOR TOKENS — match eCrescent PDP palette ============= */
  :root {
    --brand-red: #E3353C;
    --ink: #0E0E10;
    --ink-2: #2A2A2D;
    --muted: #6B6B70;
    --rule: #DCDEE2;
    --rule-strong: #A6A4A0;
    --tint: #F1ECE3;        /* warm-paper background — matches PDP --bg-darker */
    --hi: #FFF6E5;
    --grn: #0FAE7C;
    --yel: #FDD85E;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0;
    font-family: 'Sora', -apple-system, BlinkMacSystemFont, system-ui, Helvetica, Arial, sans-serif;
    color: var(--ink);
    font-size: 9.5pt;
    line-height: 1.4;
    background: #E8E6E2;
  }
  body { padding: 24px 12px; }
  .page {
    width: 8.5in;
    min-height: 11in;
    margin: 0 auto 24px;
    padding: 0.55in 0.65in;
    background: white;
    box-shadow: 0 6px 28px rgba(0,0,0,0.08);
    position: relative;
  }
  h1, h2, h3, h4 { font-family: 'Sora', sans-serif; font-weight: 700; margin: 0; line-height: 1.15; }
  .mono { font-family: 'JetBrains Mono', 'Menlo', monospace; }
  .aa { font-family: 'Sora', sans-serif; }   /* <span class="aa">Ⓐ</span> glyph wrapper — same font as body, no special handling */

  /* ============= PAGE HEADER (every page) ============= */
  .submittal-head {
    display: flex; align-items: flex-end; justify-content: space-between;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 8px; margin-bottom: 14px;
  }
  .submittal-head .brand { display: flex; align-items: center; gap: 10px; }
  .submittal-head .brand-mark {
    width: 28px; height: 28px; background: var(--brand-red);
    display: inline-block;
  }
  .submittal-head .brand-name {
    font-size: 13pt; font-weight: 700; letter-spacing: 0.4pt; line-height: 1;
  }
  .submittal-head .brand-sub {
    font-size: 7.5pt; letter-spacing: 1.5pt; color: var(--muted);
    text-transform: uppercase;
  }
  .submittal-head .catalog-block { text-align: right; }
  .submittal-head .catalog-eyebrow {
    font-size: 7pt; letter-spacing: 1.5pt; color: var(--muted);
    text-transform: uppercase; margin-bottom: 2px;
  }
  .submittal-head .catalog-number {
    font-size: 12pt; font-weight: 700; font-family: 'JetBrains Mono', monospace;
    border: 1.5px solid var(--ink);
    padding: 4px 10px; display: inline-block;
    letter-spacing: 0.5pt;
  }
  /* ===== EDITABLE CATALOG NUMBER ===== */
  .editable-catalog {
    cursor: text;
    border-bottom: 1px dashed transparent;
    transition: border-bottom-color .15s ease;
  }
  .editable-catalog:hover { border-bottom-color: var(--brand-red, #F32740); }
  .editable-catalog:focus {
    outline: 2px solid var(--brand-red, #F32740);
    outline-offset: 2px;
    border-bottom-color: transparent;
  }
  @media print {
    .editable-catalog,
    .editable-catalog:hover,
    .editable-catalog:focus {
      cursor: auto;
      border-bottom: 0 !important;
      outline: 0 !important;
    }
  }


  /* ============= PROJECT INFO FORM ============= */
  .project-info {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 0;
    border: 1px solid var(--rule-strong); margin-bottom: 14px;
  }
  .pi-cell {
    padding: 6px 9px;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    min-height: 38px;
  }
  .pi-cell:nth-child(3n) { border-right: none; }
  .pi-cell:nth-child(n+4) { border-bottom: none; }
  .pi-label {
    font-size: 7pt; letter-spacing: 1.2pt; color: var(--muted);
    text-transform: uppercase; margin-bottom: 4px;
  }
  .pi-value {
    border-bottom: 1px dotted var(--rule-strong); min-height: 14px; padding-top: 2px;
  }

  /* ============= PRODUCT TITLE BAND ============= */
  .product-title { margin: 14px 0 14px; }
  .product-title h1 { font-size: 22pt; line-height: 1; margin: 0; }
  .product-title .tagline {
    font-size: 10pt; color: var(--ink-2); margin-top: 4px; line-height: 1.3;
  }

  /* ============= HERO + QUICK SPECS GRID ============= */
  .at-a-glance {
    display: grid; grid-template-columns: 1.1fr 1fr; gap: 16px; margin-bottom: 12px;
  }
  .hero-img {
    background: var(--tint); border: 1px solid var(--rule);
    aspect-ratio: 4/3;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .hero-img img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; }
  .qs-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 6px;
  }
  .qs-cell {
    border: 1px solid var(--rule-strong); padding: 8px 10px; min-height: 56px;
  }
  .qs-label {
    font-size: 7pt; letter-spacing: 1.2pt; color: var(--muted);
    text-transform: uppercase; margin-bottom: 3px;
  }
  .qs-value { font-size: 14pt; font-weight: 700; line-height: 1.05; }
  .qs-unit { font-size: 8pt; font-weight: 400; color: var(--muted); margin-left: 2px; }

  /* ============= FEATURE BAND ============= */
  .feature-band {
    background: var(--ink); color: white;
    padding: 8px 14px;
    display: flex; gap: 18px; align-items: center;
    margin-bottom: 12px;
  }
  .feature-band .fb-pill {
    background: var(--brand-red); color: white;
    font-size: 7pt; font-weight: 700; letter-spacing: 1.2pt;
    padding: 3px 7px; text-transform: uppercase;
  }
  .feature-band .fb-features { font-size: 9pt; line-height: 1.3; }
  .feature-band .fb-features strong { font-weight: 700; }

  /* ============= COMPANION BOM PANEL (page 1) ============= */
  .bom-panel {
    border: 1px dashed var(--brand-red);
    background: rgba(227, 53, 60, 0.04);
    padding: 10px 14px; margin: 10px 0 12px;
  }
  .bom-eyebrow {
    font-size: 7pt; letter-spacing: 1.2pt; color: var(--muted);
    text-transform: uppercase; margin-bottom: 6px;
  }
  .bom-list {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: 1fr 1fr; gap: 4px 14px;
    font-family: 'JetBrains Mono', monospace; font-size: 9pt;
  }
  .bom-list li { display: flex; gap: 6px; }
  .bom-list li .plus { color: var(--brand-red); font-weight: 700; }
  .bom-list li .pair-name {
    font-family: 'Sora', sans-serif; font-size: 8pt; color: var(--muted); display: block;
  }

  /* ============= APPROVAL SIGNATURE BLOCK ============= */
  .approval-block {
    display: grid; grid-template-columns: 2fr 1fr; gap: 18px;
    margin-top: 14px; padding-top: 8px;
    border-top: 1px dashed var(--rule-strong);
  }
  .approval-cell {
    display: grid; grid-template-columns: max-content 1fr;
    gap: 8px; align-items: end; font-size: 8pt;
  }
  .approval-line { border-bottom: 1px solid var(--ink); height: 16px; }

  /* ============= SECTION HEAD (page 2+) ============= */
  .section-head {
    display: flex; align-items: baseline; justify-content: space-between;
    border-bottom: 1.5px solid var(--ink);
    padding-bottom: 4px; margin-bottom: 10px; margin-top: 4px;
  }
  .section-head h2 { font-size: 14pt; line-height: 1; }
  .section-head .section-eyebrow {
    font-size: 7pt; letter-spacing: 1.5pt; color: var(--muted);
    text-transform: uppercase;
  }

  /* ============= SPEC TABLE ============= */
  .spec-table { width: 100%; border-collapse: collapse; font-size: 8.5pt; }
  .spec-table th, .spec-table td {
    text-align: left; padding: 5px 8px;
    border-bottom: 1px solid var(--rule); vertical-align: top;
  }
  .spec-table .spec-section-head td {
    background: var(--tint);
    font-weight: 700; font-size: 9pt; letter-spacing: 0.3pt;
    border-bottom: 1px solid var(--rule-strong);
    padding: 6px 8px;
  }
  .spec-table .spec-attr { width: 30%; font-weight: 600; color: var(--ink-2); }
  .spec-table .spec-val  { width: 70%; }

  /* ============= ORDERING CODE MATRIX ============= */
  .order-code {
    display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px;
    margin-bottom: 10px;
  }
  .order-segment {
    background: var(--tint); border: 1px solid var(--rule-strong);
    padding: 8px 6px; text-align: center;
  }
  .order-segment.active {
    background: var(--brand-red); color: white; border-color: var(--brand-red);
  }
  .order-segment.fixed {
    background: var(--ink); color: white; border-color: var(--ink);
  }
  .order-seg-label {
    font-size: 7pt; letter-spacing: 1pt; text-transform: uppercase;
    margin-bottom: 4px; opacity: 0.85;
  }
  .order-seg-value {
    font-family: 'JetBrains Mono', monospace; font-size: 11pt; font-weight: 700;
  }
  .order-matrix { width: 100%; border-collapse: collapse; font-size: 7.5pt; }
  .order-matrix th, .order-matrix td {
    border: 1px solid var(--rule); padding: 4px 6px; text-align: left;
    vertical-align: top;
  }
  .order-matrix th {
    background: var(--ink); color: white;
    font-size: 7pt; letter-spacing: 1pt; text-transform: uppercase;
  }
  .order-matrix .code {
    font-family: 'JetBrains Mono', monospace; font-weight: 700; width: 80px;
  }

  /* ============= DIMENSIONS LAYOUT ============= */
  .dim-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 14px; }
  .dim-view {
    border: 1px solid var(--rule-strong);
    aspect-ratio: 4/3;
    display: flex; align-items: center; justify-content: center;
    background: white; position: relative; overflow: hidden;
  }
  .dim-view img, .dim-view svg { width: 100%; height: 100%; object-fit: contain; }
  .dim-view-label {
    position: absolute; top: 4px; left: 6px;
    font-size: 7pt; letter-spacing: 1pt; color: var(--muted);
    text-transform: uppercase;
  }

  /* ============= PHOTOMETRIC DATA ============= */
  .photo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .photo-polar {
    border: 1px solid var(--rule-strong); padding: 10px;
    aspect-ratio: 1;
    display: flex; align-items: center; justify-content: center;
    background: white; overflow: hidden;
  }
  .photo-polar svg { width: 100%; height: 100%; }
  .photo-summary { border: 1px solid var(--rule); }
  .photo-summary table { width: 100%; border-collapse: collapse; font-size: 8pt; }
  .photo-summary table td {
    padding: 4px 8px; border-bottom: 1px solid var(--rule);
  }
  .photo-summary table tr:last-child td { border-bottom: none; }
  .photo-summary td:first-child { color: var(--muted); }
  .photo-summary td:last-child {
    font-family: 'JetBrains Mono', monospace; font-weight: 700; text-align: right;
  }

  /* ============= CERTIFICATIONS ============= */
  .certs {
    display: flex; flex-wrap: wrap; gap: 6px;
    padding: 8px 10px; border: 1px solid var(--rule); margin-top: 10px;
  }
  .cert-badge {
    font-size: 7.5pt; font-weight: 700;
    border: 1.5px solid var(--ink); padding: 3px 8px;
    letter-spacing: 0.6pt; text-transform: uppercase;
  }
  .cert-badge.brand { border-color: var(--brand-red); color: var(--brand-red); }

  /* ============= PAGE FOOTER ============= */
  .page-foot {
    position: absolute;
    bottom: 0.4in; left: 0.65in; right: 0.65in;
    display: flex; justify-content: space-between;
    font-size: 7pt; color: var(--muted);
    padding-top: 6px; border-top: 1px solid var(--rule);
  }

  /* ============= NO-PRINT CONTROLS BAR ============= */
  .controls {
    max-width: 8.5in; margin: 0 auto 18px;
    background: white; padding: 14px 18px;
    border: 1px solid var(--rule);
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    display: flex; gap: 12px; align-items: center; flex-wrap: wrap;
  }
  .controls .ctrl-label {
    font-size: 9pt; font-weight: 600; color: var(--muted);
    letter-spacing: 0.5pt; text-transform: uppercase;
  }
  .controls .ctrl-value {
    font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 11pt;
  }
  .controls button {
    background: var(--brand-red); color: white;
    border: none; padding: 8px 16px;
    font-family: inherit; font-weight: 700; font-size: 9pt;
    letter-spacing: 0.5pt; text-transform: uppercase;
    cursor: pointer; margin-left: auto;
  }
  .controls button:hover { background: #B0252B; }
  .controls .ctrl-back {
    background: transparent; color: var(--ink); border: 1px solid var(--ink);
    margin-left: 8px;
  }
  .controls .ctrl-back:hover { background: var(--ink); color: white; }
</style>
</head>
<body>

<!-- ============= NO-PRINT CONTROLS BAR =============
     The Save-as-PDF button stays accessible after the auto-print fires —
     in case the user dismissed the print dialog and wants a second shot.
     The Back-to-Configurator link rewinds to the PDP using document.referrer. -->
<div class="controls no-print">
  <div>
    <div class="ctrl-label">Configured SKU</div>
    <div class="ctrl-value" id="liveSku">LSMT615-S5E</div>
  </div>
  <div>
    <div class="ctrl-label">Generated</div>
    <div class="ctrl-value" id="liveDate" style="font-size:9pt; font-weight:400;">—</div>
  </div>
  <button onclick="window.print()">Save as PDF →</button>
  <button class="ctrl-back" onclick="history.length > 1 ? history.back() : window.close()">← Back to Configurator</button>
</div>


<!-- ============================================================ -->
<!-- PAGE 1 — AT A GLANCE                                          -->
<!-- ============================================================ -->
<div class="page" id="page-1">

  <div class="submittal-head">
    <div class="brand">
      <span class="brand-mark"></span>
      <div>
        <div class="brand-name">ARCHIPELAGO</div>
        <div class="brand-sub">Lighting Group</div>
      </div>
    </div>
    <div class="catalog-block">
      <div class="catalog-eyebrow">Catalog Number</div>
      <div class="catalog-number editable-catalog" id="catNum" contenteditable="true" spellcheck="false">LSMT615-S5E</div>
    </div>
  </div>

  <div class="project-info">
    <div class="pi-cell"><div class="pi-label">Project</div><div class="pi-value"></div></div>
    <div class="pi-cell"><div class="pi-label">Type</div><div class="pi-value"></div></div>
    <div class="pi-cell"><div class="pi-label">Catalog #</div><div class="pi-value" id="piCatNum"></div></div>
    <div class="pi-cell"><div class="pi-label">Prepared By</div><div class="pi-value"></div></div>
    <div class="pi-cell"><div class="pi-label">Notes</div><div class="pi-value"></div></div>
    <div class="pi-cell"><div class="pi-label">Date</div><div class="pi-value"></div></div>
  </div>

  <div class="product-title">
    <h1 id="productTitle">eCrescent Series · 6″ Surface-Mount Disk Downlight</h1>
    <div class="tagline" id="productTagline">
      Multi-f<span class="aa">Ⓐ</span>MILY ECO-tier IP65 wet-rated surface-mount disk &middot; 5-CCTselect 2700/3000/3500/4000/5000K &middot; 120° wide-flood (back-lit polycarbonate) &middot; ETL / ENERGY&nbsp;STAR / JA8-2022 / FCC / RoHS / IP65 Wet &middot; Built-in PIR option (/P) &middot; Emergency-driver compatible &middot; Dual install (J-box surface OR 5″/6″ recessed-can retrofit) &middot; 24-pack contractor carton
    </div>
  </div>

  <div class="at-a-glance">
    <div class="hero-img">
      <!-- Real eCrescent hero image. JS swaps to ecrescent-4in or ecrescent-6in
           based on the size param (and to ecrescent-pir if sensor=P).
           mix-blend-mode: multiply preserves the white finish against the warm
           hero panel. -->
      <img id="heroImg" src="/products/multi-family/crescent/assets/ecrescent/ecrescent-6in-hero-1.png"
           alt="LSMT eCrescent — 6″ surface-mount disk downlight, white finish, IP65 wet, front 3/4 angle" />
    </div>
    <div class="qs-grid">
      <div class="qs-cell">
        <div class="qs-label">Lumens (4000K)</div>
        <div class="qs-value" id="qsLumens">910<span class="qs-unit">lm</span></div>
      </div>
      <div class="qs-cell">
        <div class="qs-label">Wattage</div>
        <div class="qs-value" id="qsWatts">15<span class="qs-unit">W</span></div>
      </div>
      <div class="qs-cell">
        <div class="qs-label">Efficacy</div>
        <div class="qs-value" id="qsLpw">61<span class="qs-unit">lm/W</span></div>
      </div>
      <div class="qs-cell">
        <div class="qs-label">CCT (selectable)</div>
        <div class="qs-value">2700-5000<span class="qs-unit">K</span></div>
      </div>
      <div class="qs-cell">
        <div class="qs-label">CRI · Lifetime</div>
        <div class="qs-value">≥ 90 · 50,000 <span class="qs-unit">hr</span></div>
      </div>
      <div class="qs-cell">
        <div class="qs-label">Beam · Voltage</div>
        <div class="qs-value">120° · 120<span class="qs-unit">V</span></div>
      </div>
    </div>
  </div>

  <div class="feature-band">
    <div class="fb-pill">5-IN-1 STACK</div>
    <div class="fb-features">
      <strong>IP65 wet</strong> &middot; <strong>5-CCTselect</strong> dip-switch (2700/3000/3500/4000/5000K) &middot;
      <strong>built-in PIR option</strong> (/P · 10s/1m/10m hold) &middot;
      <strong>EM-driver compatible</strong> (5 const<span class="aa">Ⓐ</span>NT bricks) &middot;
      <strong>dual install</strong> (J-box surface OR 5″/6″ can retrofit · conversion kit included)
    </div>
  </div>

  <!-- Companion BOM — only shows when at least one companion is selected.
       Populated by JS from the URL params (emergency / sensor / housing_can). -->
  <div class="bom-panel" id="bomPanel" style="display:none;">
    <div class="bom-eyebrow">Pair-With · Separate Line Items</div>
    <ul class="bom-list" id="bomList"></ul>
  </div>

  <div class="approval-block">
    <div class="approval-cell">
      <span><strong>Approved by</strong></span>
      <div class="approval-line"></div>
    </div>
    <div class="approval-cell">
      <span><strong>Date</strong></span>
      <div class="approval-line"></div>
    </div>
  </div>

  <div class="page-foot">
    <div>archipelagolighting.com · LSMT eCrescent submittal · ENERGY STAR + JA8 + IP65 Wet · Specifications subject to change</div>
    <div>Rev. <span id="revDate">2026-05</span> · Page 1 of 4</div>
  </div>
</div>


<!-- ============================================================ -->
<!-- PAGE 2 — SPECIFICATIONS                                       -->
<!-- ============================================================ -->
<div class="page" id="page-2">
  <div class="submittal-head">
    <div class="brand"><span class="brand-mark"></span><div><div class="brand-name">ARCHIPELAGO</div><div class="brand-sub">Lighting Group</div></div></div>
    <div class="catalog-block">
      <div class="catalog-eyebrow">Catalog Number</div>
      <div class="catalog-number" id="catNum2">LSMT615-S5E</div>
    </div>
  </div>

  <div class="section-head">
    <h2>Specifications</h2>
    <div class="section-eyebrow" id="specEyebrow">LSMT eCrescent · 4″ + 6″ Surface-Mount Disk Downlight (White · IP65 Wet · Optional Built-In PIR)</div>
  </div>

  <table class="spec-table">
    <tbody>
      <tr class="spec-section-head"><td colspan="2">Construction</td></tr>
      <tr><td class="spec-attr">Housing</td><td class="spec-val">Lightweight 6063 aluminum frame · low-profile back-lit form factor · 0.95″ depth · twist-lock removable polycarbonate diffuser · onboard high-efficacy driver</td></tr>
      <tr><td class="spec-attr">Lens / Diffuser</td><td class="spec-val">Frosted polycarbonate diffuser with even back-lit distribution · 120° wide-flood from centered Samsung 2835 LM80 LED array</td></tr>
      <tr><td class="spec-attr">Finish</td><td class="spec-val">White only · powder-coat over 6063 aluminum frame</td></tr>
      <tr><td class="spec-attr">Ingress / Location</td><td class="spec-val">IP65 Wet-location listed · suitable for indoor + outdoor / coastal / corridor / patio / balcony soffit / parking-deck stair installs · waterproof sealant required at lens edge for IP65 finish</td></tr>

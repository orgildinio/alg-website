    <!-- Build form · 4 confirmed Zoho SKUs · LLSR444-PS3 (4FT 44W QS · stock 566) · LLSR888-PS3
         (8FT 88W QS · stock 925) · LLSRxx-4-ES3 (4FT 18/25/30W bundle WB · stock 18) · LLSRxx-8-PS3
         (8FT 65/75/90W bundle WB · stock 9). Power Mode chips hidden until Length is picked; 3-WATTSELECT
         row hidden until Power Mode = Bundle. LPVR-WB factory-dip-switch-lock pattern on 3-WATTSELECT
         non-max + 3-CCTSELECT non-default (5000K = QS default · 4000K = /C40 · 3500K = /C35). -->
    <div class="cfg-body split-60-40">
      <!-- ============== REQUIRED COLUMN ============== -->
      <div class="cfg-col cfg-col-req">
        <div class="cfg-col-head">
          <div class="cfg-col-title cfg-col-title-required">Required</div>
          <div class="cfg-col-meta">3 fields · 4 if Bundle</div>
        </div>
        <div class="cfg-rows">

          <!-- Length · 2 chips · QS on both (each length has at least one QS fixed SKU) -->
          <div class="cfg-row" data-field="length">
            <div class="cfg-row-l">
              <span class="cfg-row-label">Length<span class="cfg-req">*</span></span>
              <span class="cfg-row-code is-empty" data-field-code="length">—</span>

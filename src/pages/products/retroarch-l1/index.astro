      note: 'LLSRxx-8 / LLSR888 · 8FT (96.30" L) · 5.76" W × 2.40" D · 9.26 lb · Quick-Connector + Sensor-Ready Port included'
    }
  };
  var tbody = document.getElementById('specTableBody');
  var tabs = document.querySelectorAll('.spec-watt-tab');
  function render(model) {
    tbody.innerHTML = data[model].map(function(r) {
      return '<tr class="' + (r.def ? 'is-default' : '') + '">' +
             '<td>' + r.watt   + '</td>' +
             '<td>' + r.lumens + '</td>' +
             '<td>' + r.lpw    + '</td>' +
             '<td>' + r.cct    + '</td>' +
             '<td>' + r.volt   + '</td>' +
             '</tr>';
    }).join('');
    // Swap production dimension SVG (Shopify CDN) + dim caption per housing class
    var d = dim[model];
    if (d) {
      var img = document.getElementById('dimImg');
      var cap = document.getElementById('dimCaption');
      if (img) {
        img.src = d.svg;
        img.alt = d.alt;
      }
      if (cap) cap.textContent = d.note;
    }
  }
  tabs.forEach(function(t) {
    t.addEventListener('click', function() {
      tabs.forEach(function(x) { x.classList.remove('active'); x.setAttribute('aria-selected', 'false'); });
      t.classList.add('active');
      t.setAttribute('aria-selected', 'true');
      render(t.dataset.w);
    });
  });
  // Initial render → 4FT default · activate the matching tab
  var defaultTab = document.querySelector('.spec-watt-tab[data-w="4"]');
  if (defaultTab) { defaultTab.classList.add('active'); defaultTab.setAttribute('aria-selected', 'true'); }
  render('4');
})();
</script>


<!-- Section 8 accessories — retroⒶRCH-L1 filter pill driver -->
<script is:inline>
(function(){
  var pills = document.querySelectorAll('.acc-pill');
  var cards = document.querySelectorAll('#accGrid .acc-card');
  if (!pills.length || !cards.length) return;
  pills.forEach(function(p){
    p.addEventListener('click', function(){
      var f = p.dataset.filter;
      pills.forEach(function(x){
        x.classList.toggle('active', x === p);
        x.setAttribute('aria-selected', x === p ? 'true' : 'false');
      });
      cards.forEach(function(c){
        var show = (f === 'all') || (c.dataset.cat === f);
        c.style.display = show ? '' : 'none';
      });
    });
  });
})();
</script>

<!-- ============================================================================
     SECTION 9 — Configurator + Submittal · "Build Your retroⒶRCH-L1"
     ----------------------------------------------------------------------------
     SKU template (datasheet pg 3 ordering guide · retroⒶRCH-L1 LLSR encoder):
        LLSR{"{"}LEN{"}"}-{"{"}WBUNDLE{"}"}{"{"}CCT{"}"}/{"{"}OPTIC{"}"}/{"{"}FIN{"}"}
        — LEN     = 2 / 4 / 8 (length in feet)
        — WBUNDLE = WATTSELECT bundle code per length:
                    LLSR2: 2035 (~20-35W range · 14W min · 35W max)
                    LLSR4: 3550 (~35-50W range · datasheet wattage bundle code)
                    LLSR8: 4080 (~40-80W range · datasheet wattage bundle code)
                    LLSR8-100 = 100W max flagship (12,500 lm)
                    NOTE: LLSR4 + LLSR8 bundle codes pending datasheet pg 3 verification.
        — CCT     = CS (3-CCTSELECT bundle · 3500/4000/5000K dip-switch · QS)
        — OPTIC   = RL (Round) · FL (Flat) · WL (Wide) · FR (Flat+Reflector)
        — FIN     = B (Black) · W (White)
     Required (4): Length · Optic · Finish · CCT (CS bundle is 1-chip QS standard)
     Optional (0): no TAA on retroⒶRCH-L1 · no surge integrated (10/20SP-277 is accessory in §8)
     Live readout: lumens · efficacy · peak intensity · voltage · optic · CCT · CRI
     CTAs (Illuminator-canonical): Pricing & Availability, Submittal PDF, Request a Layout
     CFG-* compliance:
       CFG-COPY-3  configurators ship at Illuminator density · chip-codes only · no inline callouts
       CFG-QA-1    URL contract uses canonical &length=, &optic=, &cct=, &finish=
       CFG-5a      cfg-col-legend-floor on the shorter (right) column
     ============================================================================ -->
<section class="cfg-section" id="configurator">
  <div class="cfg-inner">

    <div class="cfg-head">
      <div class="cfg-eyebrow">Configurator</div>
      <h2 class="cfg-title">Build Your retroⒶRCH-L1.</h2>
      <p class="cfg-sub">
        Pick length, bundle, finish &mdash; LLSR SKU resolves live.
        <small>2 lengths (LLSR4 / LLSR8) &middot; ES3 / PS3 &middot; 3-CCTSELECT &middot; B/W &middot; DLC Premium</small>
      </p>
    </div>

    <div class="cfg-counter-band">
      <div class="cfg-counter" id="cfgCounter"><strong id="cfgCount">0</strong> of 3 selections complete (Length &middot; Power Mode &middot; CCT)</div>
      <button type="button" class="cfg-reset" id="cfgReset" aria-label="Reset configurator">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>

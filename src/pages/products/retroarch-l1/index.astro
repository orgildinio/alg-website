            <div class="cfg-row-l">
              <span class="cfg-row-label">Power Mode<span class="cfg-req">*</span></span>
              <span class="cfg-row-code is-empty" data-field-code="mode">—</span>
            </div>
            <div class="cfg-seg" style="grid-template-columns: repeat(2, 1fr);">
              <!-- 4FT chips -->
              <button type="button" class="cfg-chip" data-field="mode" data-val="fixed" data-code="444-PS3" data-show-length="4">
                <span class="cfg-chip-stripe qs"></span>
                <span class="cfg-chip-main"><span class="cfg-chip-label">44W · Fixed</span></span>

<!-- Section 6 photometrics — retroⒶRCH-L1 polar plot driver
     4 cells: bundle (ES3 / PS3) × CCT (3500K / 4000K · falls back to nearest) × 5000K.
     SVGs are pre-rendered from BACL test-lab IES files via parse_ies.py · stored in
     retroarch-l1/photometrics/polar_{bundle}_{cct}.svg. ES3 max = 30W · PS3 max = 45W
     (4FT bundle steps). The 8FT bundle uses the same lens optic — beam silhouette is
     invariant by construction. The chip-click handler swaps the <img src> with a
     ?v= cache-buster, and updates the stat readout to match the picked cell. -->
<script is:inline>
(function(){
  // Per-cell data anchored to the 4 IES files we have on disk for retroⒶRCH-L1.
  // (8FT IES files are pending from BACL · interim story is "same lens → same shape".)
  var cells = {
    'es3_3500': { peak: '1,249 cd', lumens: '4,108 lm', watts: '31W', lpw: '134 lm/W',
                  file: 'LLSRxx-4-ES3 (3500K).ies', label: 'ES3 · 3500K · 30W max' },
    'es3_5000': { peak: '1,262 cd', lumens: '4,182 lm', watts: '31W', lpw: '136 lm/W',
                  file: 'LLSRxx-4-ES3 (5000K).ies', label: 'ES3 · 5000K · 30W max' },
    'ps3_3500': { peak: '1,763 cd', lumens: '5,945 lm', watts: '45W', lpw: '131 lm/W',
                  file: 'LLSRxx-4-PS3 (3500K).ies', label: 'PS3 · 3500K · 45W max' },
    'ps3_5000': { peak: '1,780 cd', lumens: '6,043 lm', watts: '46W', lpw: '132 lm/W',
                  file: 'LLSRxx-4-PS3 (5000K).ies', label: 'PS3 · 5000K · 45W max' }
  };
  // 4000K isn't in the IES bundle (BACL only tested 3500K + 5000K) — fall back to 5000K when picked.
  function resolveCct(cct){ return (cct === '3500') ? '3500' : '5000'; }

  var bundleTabs = document.querySelectorAll('.photo-tab[data-bundle]');
  var cctTabs    = document.querySelectorAll('.photo-tab[data-cct]');
  var statPeak   = document.getElementById('photoStatPeak');
  var statLum    = document.getElementById('photoStatLumens');
  var statFile   = document.getElementById('photoStatFile');
  var statOpticDesc = document.getElementById('photoStatOpticDesc');
  var plotImg    = document.getElementById('photoPlotImg');

  var state = { bundle: 'es3', cct: '5000' };

  var lensCopy = 'Frosted shatter-resistant polycarbonate lens · single fixed batwing distribution · ~130° wide horizontal. Same lens optic across LLSRxx-4 (4FT) and LLSRxx-8 (8FT) — beam silhouette is invariant by construction; lumen total scales with bundle wattage. Aluminum 6063 frame + aluminum PCB + LM80-tested Seoul 3528 LED.';

  function render(){
    var cct = resolveCct(state.cct);
    var key = state.bundle + '_' + cct;
    var d = cells[key];
    if (!d) return;
    if (statPeak) statPeak.textContent = d.peak;
    if (statLum)  statLum.textContent  = d.lumens + ' · ' + d.watts + ' · ' + d.lpw;
    if (statFile) statFile.textContent = d.file;
    if (statOpticDesc) statOpticDesc.textContent = lensCopy;
    if (plotImg) plotImg.setAttribute('src', 'retroarch-l1/photometrics/polar_' + key + '.svg?v=2026-05-27');

    bundleTabs.forEach(function(t){
      var on = t.dataset.bundle === state.bundle;
      t.classList.toggle('active', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    cctTabs.forEach(function(t){
      var on = t.dataset.cct === state.cct;
      t.classList.toggle('active', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
    });
  }

  bundleTabs.forEach(function(t){
    t.addEventListener('click', function(){ state.bundle = t.dataset.bundle; render(); });
  });
  cctTabs.forEach(function(t){
    t.addEventListener('click', function(){ state.cct = t.dataset.cct; render(); });
  });

  render();
})();
</script>


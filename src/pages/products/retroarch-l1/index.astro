              <button type="button" class="cfg-chip default-mark" data-field="watt" data-val="90" data-code="" data-show-length="8">
                <span class="cfg-chip-stripe wb"></span>
                <span class="cfg-chip-main"><span class="cfg-chip-label">90W ★</span></span>

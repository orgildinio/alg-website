  // Production linear-strip dimension SVGs not yet on the ALG Shopify CDN — using inline SVG
  // placeholders showing the strip form factor + length call-out per length tab.
  function placeholderSvg(diameter, height, weight, model) {
    return 'data:image/svg+xml;utf8,' + encodeURIComponent(
      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 360 240" font-family="JetBrains Mono, monospace">' +
      '<circle cx="180" cy="120" r="80" fill="none" stroke="%23bbb" stroke-width="1.6"/>' +

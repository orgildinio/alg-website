  var copy = {
    bilevel: "Drop-in occupancy + bi-level dimming — no commissioning, gateway, or app required. PIR (MSP-BLS) or microwave (MSM-BLS) sensors mount directly to the retroⒶRCH-L1 integrated sensor receptacle. IR remote (RM-HT/06S) for on-site commissioning. ASHRAE 90.1 and Title 24 occupancy reduction compliance out of the box.",
    acs:     "ALG's in-house Bluetooth Mesh platform — networked occupancy, daylight harvesting, and scene control via the AURA app. Cloud-managed via the ⒶCS portal. Kinetic switches (MSZ-ACS) require no battery or wiring. Ceiling-mount PIR (MSP-8CM-ACS / MSP-40CM-ACS) covers warehouse aisles, parking decks, and multi-bay floors with linear-strip layouts up to 13FT mount.",
    silvair: "SILVAIR Bluetooth Mesh — DLC NLC qualified mesh nodes (MSP-NLC + MSX-LV5-NLC) for enterprise-scale deployments. Self-healing topology, no gateway required, full control via the SILVAIR commissioning app. The path to DLC NLC rebate qualification on every retroⒶRCH-L1 install."
  };
  function init() {
    var tabs = document.querySelectorAll('.tac-callout-tab');
    var sensors = document.querySelectorAll('.tac-sensor-svg');
    var copyEl = document.getElementById('tacCalloutCopy');
    var wave = document.getElementById('tacShockwave');
    if (!tabs.length || !sensors.length || !wave) return;
    function select(platform) {
      tabs.forEach(function(t) {
        var isActive = t.dataset.platform === platform;
        t.classList.toggle('active', isActive);
        t.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
      sensors.forEach(function(s) {
        s.classList.toggle('is-active', s.dataset.platform === platform);
      });
      if (copyEl && copy[platform]) copyEl.textContent = copy[platform];
      // Trigger shockwave: remove + re-add class to restart animation
      wave.classList.remove('is-rippling');
      void wave.offsetWidth;
      wave.classList.add('is-rippling');
    }
    tabs.forEach(function(t) {
      t.addEventListener('click', function() { select(t.dataset.platform); });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();

// (Legacy Illuminator photometrics IIFE removed — retroⒶRCH-L1's 3-length × 4-optic
//  photometrics driver lives inline with Section 6 above. 12 plot states (LLSR2/4/8 ×
//  RL/FL/WL/FR), per-optic parametric polar plots, IES bundle URL wired live to
//  local zip /retroⒶRCH-L1 IES.zip in the per-config download link.)

// (Legacy Illuminator acc-section modal IIFE removed — retroⒶRCH-L1 accessories
//  use the lighter inline filter-pill driver above. Modal/click-detail is a v2 follow-up.)


// =============================================================================
// SECTION 9 — Configurator (Build Your retroⒶRCH-L1)
// 4 confirmed Zoho SKUs (anchored 2026-05-27 · CFG-CFG-1 v1.7 LPVR-WB pattern):
//   LLSR444-PS3       → 4FT 44W fixed     · QS · stock 566
//   LLSR888-PS3       → 8FT 88W fixed     · QS · stock 925
//   LLSRxx-4-ES3      → 4FT 18/25/30W bundle · WB · stock 18
//   LLSRxx-8-PS3      → 8FT 65/75/90W bundle · WB · stock 9
//
// Required fields (3 base, 4 if Bundle):
//   length · 4 / 8
//   mode   · fixed / bundle             (chips filtered by length via data-show-length)
//   watt   · 18/25/30 (4-bundle) | 65/75/90 (8-bundle)   (row hidden unless mode=bundle)
//   cct    · 3500 / 4000 / 5000          (5000K = QS default · others = WB + /C## append)
//
// Optional accessories (datasheet pg 4 + Zoho):
//   sensor · MSM-SDI/3/BLS  (Bi-Level Microwave)
//   remote · RM-SD/100S     (IR programmer · sensor companion)
//   em     · EM08-CMB/48EDC (8W EM driver)
//
// SKU encoder rules:
//   Base SKU per (length, mode):
//     4 + fixed  → LLSR444-PS3
//     8 + fixed  → LLSR888-PS3
//     4 + bundle → LLSRxx-4-ES3
//     8 + bundle → LLSRxx-8-PS3
//   Append /W## when watt chip is non-default (bundle only · default = max wattage step)
//   Append /C35 or /C40 when CCT is non-default (default = 5000K)
//   Append /MSM-SDI/3/BLS · /RM-SD/100S · /EM08-CMB/48EDC for each selected accessory
//
// Ship tier (CFG-STATE-1):
//   Walks all SELECTED chips that are currently VISIBLE (data-show-length + data-show-mode
//   filter applied via body.dataset.formLength / formMode). Worst-of QS < WB < MTO wins.
//   Hidden chips are skipped (otherwise applyState would over-select chips with matching
//   data-val from inactive length/mode rows — see CFG-CFG-1 v1.7 hidden-row bug fix).
// =============================================================================
(function() {
  var REQUIRED_BASE = ['length', 'mode', 'cct'];
  var REQUIRED_BUN  = ['length', 'mode', 'watt', 'cct'];
  var OPTIONAL      = ['sensor', 'remote', 'em'];

  // Base SKU lookup — keyed by length + mode
  var BASE_SKU = {
    '4-fixed':  'LLSR444-PS3',
    '8-fixed':  'LLSR888-PS3',
    '4-bundle': 'LLSRxx-4-ES3',
    '8-bundle': 'LLSRxx-8-PS3'
  };

  // Zoho stock map → ship tier per base SKU (queried 2026-05-27)
  var BASE_STOCK = {
    'LLSR444-PS3':  { qty: 566, tier: 'QS' },
    'LLSR888-PS3':  { qty: 925, tier: 'QS' },
    'LLSRxx-4-ES3': { qty: 18,  tier: 'WB' },
    'LLSRxx-8-PS3': { qty: 9,   tier: 'WB' }
  };

  // Lookup tables — retroⒶRCH-L1 spec matrix indexed by length + mode + watt.
  // 130 LM/W on Seoul 3528 LEDs · datasheet pg 1-2 verified 2026-05-27.
  var SPEC = {
    // Fixed-wattage SKUs (single value per length)
    fixed: {
      '4': { watt: '44W', lumens: '5,720 lm', lpw: '130 lm/W' },
      '8': { watt: '88W', lumens: '11,440 lm', lpw: '130 lm/W' }
    },
    // Bundle SKUs — 3-WATTSELECT field-toggle · lumens per step
    bundle: {
      '4': {
        '18': { lumens: '2,500 lm',  lpw: '139 lm/W' },
        '25': { lumens: '3,375 lm',  lpw: '135 lm/W' },
        '30': { lumens: '3,960 lm',  lpw: '132 lm/W' }
      },
      '8': {
        '65': { lumens: '9,000 lm',  lpw: '138 lm/W' },
        '75': { lumens: '10,125 lm', lpw: '135 lm/W' },
        '90': { lumens: '12,000 lm', lpw: '133 lm/W' }
      }
    },
    voltage: '120-277V · Universal (single-voltage on every retroⒶRCH-L1)',
    cri:     '&gt;80 CRI · R9 ≥ 50',
    // Fixed-mode peak cd estimates · simple downlight pattern at peak watt
    peak: {
      '4-fixed':  '~2,600 cd peak',
      '8-fixed':  '~5,200 cd peak',
      '4-bundle': '~1,800 cd peak (30W max)',
      '8-bundle': '~5,500 cd peak (90W max)'
    }
  };

  // Default factory wattage per bundle (max-step convention · the dip-switch ships at max)
  var BUNDLE_DEFAULT_WATT = { '4': '30', '8': '90' };

  // Default CCT (factory ships dip-switch at 5000K · LPVR-WB factory-lock pattern)
  var DEFAULT_CCT = '5000';

  // Default starting state — empty (user picks all required fields)
  var DEFAULT_STATE = { length: '4', mode: 'bundle', cct: '5000' };

  function init() {
    var section   = document.getElementById('configurator');
    if (!section) return;
    var counter   = document.getElementById('cfgCount');
    var counterEl = document.getElementById('cfgCounter');
    var resetBtn  = document.getElementById('cfgReset');
    var skuEl     = document.getElementById('cfgSku');
    var copyBtn   = document.getElementById('cfgSkuCopy');
    var copyLabel = document.getElementById('cfgSkuCopyLabel');
    var warning   = document.getElementById('cfgWarning');
    var ctaPrice  = document.getElementById('cfgCtaPrice');
    var ctaPdf    = document.getElementById('cfgCtaPdf');
    var chips     = section.querySelectorAll('.cfg-chip');
    var state     = Object.assign({}, DEFAULT_STATE);

    // ---- Chip click handler ----
    chips.forEach(function(chip) {
      chip.addEventListener('click', function() {
        if (chip.classList.contains('disabled')) return;
        var field = chip.dataset.field;
        var val   = chip.dataset.val;
        var isOpt = OPTIONAL.indexOf(field) >= 0;

        if (isOpt && state[field] === val) {
          // Optional toggle — click active chip clears it
          delete state[field];
        } else {
          state[field] = val;
          // When length changes, clear mode + watt (chips for other length no longer visible)
          if (field === 'length') {
            delete state.mode;
            delete state.watt;
          }
          // When mode changes, clear watt (only bundle has watt picker)
          if (field === 'mode') {
            delete state.watt;
          }
        }
        applyState();
      });
    });

    // ---- Reset all ----
    resetBtn.addEventListener('click', function() {
      state = Object.assign({}, DEFAULT_STATE);
      applyState();
    });

    // ---- Apply state to UI ----
    function applyState() {
      // Update body attributes that drive data-show-length / data-show-mode CSS filter
      document.body.dataset.formLength = state.length || '';
      document.body.dataset.formMode   = state.mode   || '';

      // Selected state on chips
      chips.forEach(function(chip) {
        var f = chip.dataset.field;
        var v = chip.dataset.val;
        chip.classList.toggle('selected', state[f] === v);
      });

      // Counter — uses base required count (3) or bundle required count (4)
      var required = (state.mode === 'bundle') ? REQUIRED_BUN : REQUIRED_BASE;
      var filled = required.filter(function(k) { return state[k] != null; }).length;
      counter.textContent = filled;
      counterEl.classList.toggle('complete', filled === required.length);

      // Update counter label dynamically (3 or 4)
      // Just update the surrounding text via outerHTML rebuild
      counterEl.innerHTML = '<strong id="cfgCount">' + filled + '</strong> of ' + required.length +
        ' selections complete (' +
        (state.mode === 'bundle' ? 'Length &middot; Power Mode &middot; 3-WATTSELECT &middot; CCT' : 'Length &middot; Power Mode &middot; CCT') +
        ')';

      var complete = (filled === required.length);
      renderSKU(complete);
      warning.classList.toggle('show', !complete);
      ctaPdf.classList.toggle('disabled', !complete);
      ctaPrice.classList.toggle('disabled', !complete);
      copyBtn.disabled = !complete;
      copyBtn.classList.remove('copied');
      copyLabel.textContent = 'Copy SKU';

      renderSpecs();
      renderPreviewPhoto();
    }

    // ---- Live Preview photo swap · maps (length, mode) → product photo ----
    // All 4 photos are 4FT angled product shots (no 8FT photography on disk yet).
    // We use _0001 + _0003 to differentiate 4FT-fixed vs 4FT-bundle, and re-use
    // _0019 + _0018 (lit-mode / different angle) to hint at 8FT-fixed vs 8FT-bundle.
    // When James drops 8FT photography, swap the 8-fixed/8-bundle paths.
    var PHOTO_MAP = {
      '4-fixed':  'retroarch-l1/photos/LLSRXX-4-PS3-002_No_BG_1_0001.png',
      '4-bundle': 'retroarch-l1/photos/LLSRXX-4-PS3-002_No_BG_1_0003.png',
      '8-fixed':  'retroarch-l1/photos/LLSRXX-4-PS3-002_No_BG_1_0019.png',
      '8-bundle': 'retroarch-l1/photos/LLSRXX-4-PS3-002_No_BG_1_0018.png',
      '_default': 'retroarch-l1/photos/LLSRXX-4-PS3-002_No_BG_1_0001.png'
    };
    function renderPreviewPhoto(){
      var img = document.getElementById('cfgPreviewImg');
      if (!img) return;
      var key = (state.length && state.mode) ? state.length + '-' + state.mode : '_default';
      var src = PHOTO_MAP[key] || PHOTO_MAP['_default'];
      // Append cache-buster so swap is honored even if browser has the previous src cached.
      var cur = img.getAttribute('src') || '';
      if (!cur.split('?')[0].endsWith(src.split('/').pop())) {
        img.setAttribute('src', src + '?v=2026-05-27');
      }
    }

    // ---- SKU encoder ----
    function buildSku() {
      if (!state.length || !state.mode) return null;
      var key = state.length + '-' + state.mode;
      var base = BASE_SKU[key];
      if (!base) return null;

      var sku = base;

      // Bundle wattage append — only if non-default (default = max step per bundle)
      if (state.mode === 'bundle' && state.watt) {
        var defWatt = BUNDLE_DEFAULT_WATT[state.length];
        if (state.watt !== defWatt) sku += '/W' + state.watt;
      }

      // CCT append — only if non-default (default = 5000K)
      if (state.cct && state.cct !== DEFAULT_CCT) {
        var cctCode = (state.cct === '4000') ? 'C40' : (state.cct === '3500' ? 'C35' : '');
        if (cctCode) sku += '/' + cctCode;
      }

      // Optional accessory appends (in datasheet order: sensor → remote → em)
      if (state.sensor) sku += '/MSM-SDI/3/BLS';
      if (state.remote) sku += '/RM-SD/100S';
      if (state.em)     sku += '/EM08-CMB/48EDC';

      return sku;
    }

    function renderSKU(complete) {
      if (!complete) {
        var len  = state.length ? state.length : '<span class="placeholder">[len]</span>';
        var mode = state.mode   ? (state.mode === 'fixed' ? 'fixed' : 'bundle') : '<span class="placeholder">[mode]</span>';
        skuEl.innerHTML = 'LLSR · ' + len + 'FT · ' + mode;
        return;
      }
      var sku = buildSku();
      skuEl.innerHTML = sku || 'LLSR<span class="placeholder">[base]</span>';
    }

    // ---- Live spec readout ----
    function renderSpecs() {
      var lumens = null, lpw = null, peak = null;
      if (state.mode === 'fixed' && state.length) {
        lumens = SPEC.fixed[state.length].lumens;
        lpw    = SPEC.fixed[state.length].lpw;
        peak   = SPEC.peak[state.length + '-fixed'];
      } else if (state.mode === 'bundle' && state.length && state.watt) {
        var b = SPEC.bundle[state.length][state.watt];
        if (b) {
          lumens = b.lumens + ' (at ' + state.watt + 'W dip-step)';
          lpw    = b.lpw;
        }
        peak = SPEC.peak[state.length + '-bundle'];
      } else if (state.mode === 'bundle' && state.length) {
        // Mode picked but not yet wattage — show the bundle range
        var steps = Object.keys(SPEC.bundle[state.length]).sort(function(a,b){ return +a - +b; });
        var min = SPEC.bundle[state.length][steps[0]];
        var max = SPEC.bundle[state.length][steps[steps.length - 1]];
        lumens = min.lumens + ' (' + steps[0] + 'W) – ' + max.lumens + ' (' + steps[steps.length-1] + 'W)';
        lpw    = '~' + min.lpw + ' – ' + max.lpw;
        peak   = SPEC.peak[state.length + '-bundle'];
      }

      setSpec('lumens',  lumens);
      setSpec('lpw',     lpw);
      setSpec('voltage', SPEC.voltage);
      setSpec('peak',    peak);
      // Optic field doesn't apply to retroⒶRCH-L1 (single fixed frosted polycarbonate lens)
      setSpec('optic',   'Single fixed frosted polycarbonate lens');
      setSpec('compliance', 'DLC Standard &middot; IP40 Damp &middot; 7-yr/75k-hr');
    }
    function setSpec(name, val) {
      var el = section.querySelector('[data-spec="' + name + '"]');
      if (!el) return;
      if (name === 'cct' || name === 'cri') return; // static — never override
      if (val == null || val === '—') {
        el.textContent = '—';
        el.classList.add('placeholder');
      } else {
        el.innerHTML = val;
        el.classList.remove('placeholder');
      }
    }

    // ---- Copy SKU ----
    copyBtn.addEventListener('click', function() {
      if (copyBtn.disabled) return;
      var txt = skuEl.textContent.trim();
      if (!txt) return;
      var done = function() {
        copyBtn.classList.add('copied');
        copyLabel.textContent = 'Copied ✓';
        setTimeout(function() {
          copyBtn.classList.remove('copied');
          copyLabel.textContent = 'Copy SKU';
        }, 1800);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(txt).then(done, done);
      } else {
        var ta = document.createElement('textarea');
        ta.value = txt;
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch(e){}
        document.body.removeChild(ta);
        done();
      }
    });

    // ---- Submittal PDF — opens submittal/?sku=… in new tab ----
    function buildSubmittalUrl() {
      var sku = buildSku() || '';
      var params = new URLSearchParams({
        sku:    sku,
        family: 'retroarch-l1',
        length: state.length || '4',
        mode:   state.mode   || 'fixed',
        watt:   state.watt   || '',
        cct:    state.cct    || DEFAULT_CCT,
        sensor: state.sensor || '',
        remote: state.remote || '',
        em:     state.em     || ''
      });
      return 'submittal/?' + params.toString();
    }
    ctaPdf.addEventListener('click', function(e) {
      if (ctaPdf.classList.contains('disabled')) { e.preventDefault(); return; }
      ctaPdf.setAttribute('href', buildSubmittalUrl());
    });

    // Initial render — sets body[data-form-length=""] / [data-form-mode=""] so the
    // CSS visibility filter hides Power Mode + 3-WATTSELECT chips/rows until Length picked.
    applyState();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();

// (Legacy Illuminator motion-carousel IIFE removed — retroⒶRCH-L1's 4-slide motion
//  player lives inline with Section 3 above, sourcing the production mp4s spliced
//  from "LLSR - RETROARCH-L1 PromoVideo_NoText.mp4" via splice_retroarch-l1_video.sh)

// CFG-STATE-1 — derive ship-tier (QS / WB / MTO) from selected chip badges, render
// canonical 3-state status panel. Self-contained module · no dependency on the
// configurator's state object · re-derives by walking selected chips on every click.
// Custom RAL (finish chip) with a valid 4-digit input forces MTO.
(function() {
  function deriveShipTier() {
    var section = document.getElementById('configurator');
    if (!section) return 'QS';
    var chips = section.querySelectorAll('.cfg-chip.selected, .cfg-chip[aria-pressed="true"]');
    var worst = 'QS';
    var sawCustomRal = false;
    var activeLength = document.body.dataset.formLength || '';
    var activeMode   = document.body.dataset.formMode   || '';
    chips.forEach(function(chip) {
      // CFG-CFG-1 v1.7 · hidden-row filter — skip chips that are not currently visible
      // (data-show-length mismatch OR data-show-mode mismatch). Otherwise applyState
      // over-selects chips with matching data-val from inactive length/mode rows and
      // deriveShipTier mis-flags QS configurations as WB.
      var showLen = chip.getAttribute('data-show-length');
      if (showLen && activeLength && showLen.split(/\s+/).indexOf(activeLength) === -1) return;
      var row = chip.closest('.cfg-row');
      if (row) {
        var showMode = row.getAttribute('data-show-mode');
        if (showMode && activeMode && showMode.split(/\s+/).indexOf(activeMode) === -1) return;
      }
      if (chip.dataset.field === 'finish' && chip.dataset.val === 'RAL') sawCustomRal = true;
      // CFG-CFG-1: stock state moved from .cfg-chip-stock text → .cfg-chip-stripe.
      // Check both selectors for back-compat during the transition.
      if (chip.querySelector('.cfg-chip-stripe.mto') || chip.querySelector('.cfg-chip-stock.mto')) worst = 'MTO';
      else if ((chip.querySelector('.cfg-chip-stripe.wb') || chip.querySelector('.cfg-chip-stock.wb')) && worst !== 'MTO') worst = 'WB';
    });
    if (sawCustomRal) {
      var input = document.getElementById('cfgRalInput');
      if (input && input.value && /^[0-9]{4}$/.test(input.value)) return 'MTO';
    }
    return worst;
  }
  function refreshShipTier() {
    var tier = deriveShipTier();
    var rowEl = document.getElementById('cfgShipTier');
    var iconEl = document.getElementById('cfgShipTierIcon');
    var textEl = document.getElementById('cfgShipTierText');
    var stockEl = document.getElementById('cfgShipTierStock');
    if (!rowEl || !iconEl || !textEl || !stockEl) return;
    if (tier === 'QS') {
      rowEl.style.background = 'rgba(95,199,122,0.08)';
      rowEl.style.border = '1px solid rgba(95,199,122,0.40)';
      iconEl.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#7fc998" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
      textEl.innerHTML = '<strong style="color:#9bd6b1;">QuickShip · à-la-carte assembly</strong> · <span style="color:var(--text-secondary);">All selected components in stock — ships 3-5 day.</span>';
      stockEl.textContent = 'QuickShip · 3-5 day';
      stockEl.style.color = '#9bd6b1';
    } else if (tier === 'WB') {
      rowEl.style.background = 'rgba(96,168,255,0.08)';
      rowEl.style.border = '1px solid rgba(96,168,255,0.40)';
      iconEl.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#7fb6ff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>';
      textEl.innerHTML = '<strong style="color:#a8c9ff;">Workbench Assembly · ~1-3 wk</strong> · <span style="color:var(--text-secondary);">One or more selected components are workbench-assembled to order.</span>';
      stockEl.textContent = 'WB · ~1-3 wk';
      stockEl.style.color = '#a8c9ff';
    } else {
      rowEl.style.background = 'rgba(255,159,28,0.08)';
      rowEl.style.border = '1px solid rgba(255,159,28,0.40)';
      iconEl.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#ffb14d" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
      textEl.innerHTML = '<strong style="color:#ffb14d;">Custom build · Made-to-Order · ~4-6 wk</strong> · <span style="color:var(--text-secondary);">One or more selected components are MTO (custom finish, MTO option, or non-stocked variant).</span>';
      stockEl.textContent = 'MTO · ~4-6 wk';
      stockEl.style.color = '#ffb14d';
    }
  }
  function init() {
    var section = document.getElementById('configurator');
    if (!section) return;
    section.addEventListener('click', function(e) {
      if (e.target.closest('.cfg-chip')) setTimeout(refreshShipTier, 50);
    });
    var ralInput = document.getElementById('cfgRalInput');
    if (ralInput) ralInput.addEventListener('input', function() { setTimeout(refreshShipTier, 50); });
    refreshShipTier();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
// CFG-CFG-1 · syncRowCodes — update per-row .cfg-row-code based on selected chip.
// Mirrors the canonical Liberty pattern. Self-contained · no dependency on the
// configurator's state object · walks selected chips on every chip click.
(function() {
  function syncRowCodes() {
    document.querySelectorAll('.cfg-row-code[data-field-code]').forEach(function(rc) {
      var field = rc.getAttribute('data-field-code');
      if (field === 'cct') return; // locked-default text stays
      var newText = '—', isEmpty = true;
      var selChip = document.querySelector('.cfg-chip.selected[data-field="' + field + '"]');
      if (selChip) {
        var code = selChip.getAttribute('data-code') || '';
        var slashPrefixed = ['mount','optic','photocell','sensor','shield','surge','taa','em','wg','adapter'];
        var alreadySlash = code.charAt(0) === '/';
        if (code) {
          newText = (slashPrefixed.indexOf(field) >= 0 && !alreadySlash) ? '/' + code : code;
          isEmpty = false;
        } else if (field === 'taa') {
          newText = '(blank)'; isEmpty = false;
        } else if (field === 'mount') {
          newText = '(none)'; isEmpty = false;
        }
      }
      rc.textContent = newText;
      rc.classList.toggle('is-empty', isEmpty);
    });
  }
  function init() {
    var section = document.getElementById('configurator');
    if (!section) return;
    section.addEventListener('click', function(e) {
      if (e.target.closest('.cfg-chip')) setTimeout(syncRowCodes, 60);
    });
    syncRowCodes();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();


</script>


<script is:inline>
/* =============================================================================
   CFG-NAV-1 · Sticky-nav scroll-spy
   ----------------------------------------------------------------------------
   IntersectionObserver watches each section the sticky-nav links to. The link
   whose target is "most visible" gets `.is-current` (white bg + red text · the
   visual inverse of `.primary`). One observer, one Map, one CSS class toggle.
   The Pricing & Availability primary button is NOT a section anchor (its href
   is /pricing-availability/), so it's excluded from the spy by the
   `a[href^="#"]` selector below.
   ============================================================================= */
(function() {
  var nav = document.querySelector('.sticky-nav');
  if (!nav) return;
  var links = Array.prototype.slice.call(nav.querySelectorAll('a[href^="#"]'));
  if (!links.length) return;
  var entries = [];
  links.forEach(function(a) {
    var id = a.getAttribute('href').slice(1);
    var sec = id ? document.getElementById(id) : null;
    if (sec) entries.push({ sec: sec, link: a, ratio: 0 });
  });
  if (!entries.length) return;
  function update() {
    var best = null, bestRatio = 0;
    entries.forEach(function(e) { if (e.ratio > bestRatio) { bestRatio = e.ratio; best = e; } });
    entries.forEach(function(e) { e.link.classList.toggle('is-current', e === best && bestRatio > 0); });
  }
  var io = new IntersectionObserver(function(items) {
    items.forEach(function(item) {
      entries.forEach(function(e) { if (e.sec === item.target) e.ratio = item.intersectionRatio; });
    });
    update();
  }, {
    rootMargin: '-20% 0px -55% 0px',
    threshold: [0, 0.1, 0.25, 0.5, 0.75, 1.0]
  });
  entries.forEach(function(e) { io.observe(e.sec); });
})();
</script>


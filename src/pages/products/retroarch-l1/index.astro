          </div>

          <!-- 3-CCTSELECT · 3 chips · 5000K = ★ QS default · 4000K/3500K = WB + /C40 or /C35 factory dip-lock -->
          <div class="cfg-row" data-field="cct">
            <div class="cfg-row-l">
              <span class="cfg-row-label">3-CCTSELECT<span class="cfg-req">*</span></span>

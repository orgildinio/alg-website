      '<circle cx="180" cy="120" r="20" fill="none" stroke="%23F32740" stroke-width="1.5"/>' +
      '<circle cx="180" cy="120" r="3" fill="%23F32740"/>' +
      '<line x1="100" y1="220" x2="260" y2="220" stroke="%23bbb" stroke-width="1"/>' +
      '<text x="180" y="236" text-anchor="middle" font-size="11" fill="%23999">' + diameter + ' diameter</text>' +
      '<text x="180" y="32" text-anchor="middle" font-size="11" fill="%23F32740" letter-spacing="2">' + model + '</text>' +
      '<text x="14" y="125" text-anchor="start" font-size="10" fill="%23999">↕ ' + height + '</text>' +
      '<text x="346" y="125" text-anchor="end" font-size="10" fill="%23999">' + weight + '</text>' +
      '<text x="180" y="58" text-anchor="middle" font-size="9" fill="%23bbb" letter-spacing="2">PLACEHOLDER · PENDING RETROARCH-L1 SVG</text>' +
      '</svg>'
    );
  }
  var dim = {
    '4': {
      svg:  placeholderSvg('4FT (48.00")', '5.76" W', '5.40 lb', 'LLSRxx-4'),
      alt:  'retroⒶRCH-L1 LLSRxx-4 dimensions — 48.00" L × 5.76" W × 2.40" D · 5.40 lb · Quick-Connector + Sensor-Ready Port (placeholder · pending production SVG)',
      note: 'LLSRxx-4 / LLSR444 · 4FT (48.00" L) · 5.76" W × 2.40" D · 5.40 lb · Quick-Connector + Sensor-Ready Port included'
    },

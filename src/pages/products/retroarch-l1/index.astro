    border-radius: 2px;
  }
  .photo-download {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 700;
    margin-top: 6px;
    transition: color 0.18s;

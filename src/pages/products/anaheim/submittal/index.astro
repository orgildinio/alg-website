  .pi-cell:nth-child(n+4) { border-bottom: none; }
  .pi-label { font-size: 7pt; letter-spacing: 1.2pt; color: var(--muted); text-transform: uppercase; margin-bottom: 4px; }
  .pi-value { border-bottom: 1px dotted var(--rule-strong); min-height: 14px; padding-top: 2px; }
  .product-title { margin: 14px 0 14px; }
  .product-title h1 { font-size: 22pt; line-height: 1; margin: 0; }

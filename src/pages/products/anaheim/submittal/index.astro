  .spec-table .spec-attr { color: var(--muted); width: 32%; font-weight: 600; }
  .spec-table .spec-section-head td { background: var(--tint); font-weight: 700; font-size: 8pt; letter-spacing: 0.8pt; text-transform: uppercase; color: var(--ink-2); padding: 5px 8px; }
  .dim-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 16px; margin-top: 12px; }
  .dim-view { background: var(--tint); border: 1px solid var(--rule); display: flex; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; }
  .dim-view-label { font-size: 7pt; letter-spacing: 1.2pt; color: var(--muted); text-transform: uppercase; padding: 6px 0 4px; }
  .photo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 12px; }
  .photo-polar { background: var(--tint); border: 1px solid var(--rule); aspect-ratio: 1; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .photo-polar img { width: 100%; height: 100%; object-fit: contain; }
  .photo-summary table { width: 100%; font-size: 8.5pt; border-collapse: collapse; }
  .photo-summary td { padding: 5px 8px; border-bottom: 1px solid var(--rule); }
  .photo-summary td:first-child { color: var(--muted); font-weight: 600; width: 50%; }
  .order-code { display: flex; gap: 0; margin: 12px 0; border: 1px solid var(--rule-strong); }
  .order-segment { flex: 1; padding: 8px 6px; border-right: 1px solid var(--rule); text-align: center; }
  .order-segment:last-child { border-right: none; }
  .order-seg-label { font-size: 6.5pt; letter-spacing: 1pt; color: var(--muted); text-transform: uppercase; margin-bottom: 4px; }
  .order-seg-value { font-size: 11pt; font-weight: 700; font-family: 'JetBrains Mono', monospace; }
  .order-matrix { width: 100%; border-collapse: collapse; font-size: 8.5pt; margin-top: 10px; }
  .order-matrix th { background: var(--tint); padding: 5px 8px; border-bottom: 2px solid var(--rule-strong); text-align: left; font-size: 8pt; letter-spacing: 0.5pt; }
  .order-matrix td { padding: 4px 8px; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .order-matrix td.code { font-family: 'JetBrains Mono', monospace; font-size: 8pt; font-weight: 700; color: var(--ink-2); width: 22%; }
  .certs { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .cert-badge { border: 1px solid var(--rule-strong); font-size: 7.5pt; font-weight: 700; padding: 4px 8px; letter-spacing: 0.5pt; text-transform: uppercase; }
  .cert-badge.brand { background: var(--ink); color: white; border-color: var(--ink); }
  .controls { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; background: var(--tint); border-bottom: 1px solid var(--rule); padding: 10px 16px; }
  .controls .ctrl-label { font-size: 9pt; font-weight: 600; color: var(--muted); letter-spacing: 0.5pt; text-transform: uppercase; }
  .controls .ctrl-value { font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 11pt; }
  .controls button { background: var(--brand-red); color: white; border: none; padding: 8px 16px; font-family: inherit; font-weight: 700; font-size: 9pt; letter-spacing: 0.5pt; text-transform: uppercase; cursor: pointer; margin-left: auto; }
  .controls button:hover { background: #d61f37; }
</style>
</head>

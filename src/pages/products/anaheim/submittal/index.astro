  <div class="section-head" style="margin-top:16px;"><h2>Photometric Data</h2><div class="section-eyebrow" id="photoEyebrow">LWPA40 · 4000K</div></div>
  <div class="photo-grid">
    <div class="photo-polar">
      <img id="photoPolarImg" src="/products/anaheim/assets/photometrics/LWPA40_3000K.svg"
           alt="LWPA Anaheim polar plot"
           onerror="this.style.display='none';this.parentElement.innerHTML+='<div style=\'color:#999;font-size:8pt;text-align:center;\'>Polar plot — contact ALG for IES bundle</div>';" />
    </div>
    <div class="photo-summary">
      <table><tbody>
        <tr><td>Peak Intensity</td><td id="photoPeak">2,180 cd</td></tr>
        <tr><td>Total Lumens</td><td id="photoLumens">5,200 lm</td></tr>
        <tr><td>Efficacy</td><td id="photoEff">130 lm/W</td></tr>
        <tr><td>Beam Geometry</td><td>Adjustable 0°–90°</td></tr>
        <tr><td>Test Standard</td><td>IESNA LM-79</td></tr>
        <tr><td>IES File</td><td id="photoIesFile">LWPA40_3000K.ies</td></tr>
      </tbody></table>
    </div>
  </div>
  <div class="certs">
    <span class="cert-badge">cULus</span>
    <span class="cert-badge brand">DLC Premium</span>
    <span class="cert-badge">IP65</span>
    <span class="cert-badge">Wet Location</span>
    <span class="cert-badge">FCC 47 / 15B</span>
    <span class="cert-badge">RoHS</span>
    <span class="cert-badge" id="taaBadge" style="display:none">TAA</span>
  </div>
  <div class="page-foot">
    <div>archipelagolighting.com · LWPA Anaheim submittal · Specifications subject to change</div>
    <div>Rev. <span id="revDate4">2026-06</span> · Page 4 of 4</div>
  </div>
</div>

<script>
(function() {
  // --- CFG-SUB-1: Catalog-number edit sync ---
  document.querySelectorAll('#catNum, #catNum2, #catNum3, #catNum4, #liveSku').forEach(function(el) {
    el.addEventListener('input', function() {
      var val = this.textContent.trim();
      ['catNum','catNum2','catNum3','catNum4','liveSku','piCatNum'].forEach(function(id) {
        var t = document.getElementById(id);
        if (t && t !== el) t.textContent = val;
      });
    });
  });

  // --- URL PARAM POPULATION ---
  var params  = new URLSearchParams(window.location.search);
  var sku     = params.get('sku')     || 'LWPA40-40-UT-B/TR';
  var watts   = params.get('wattage') || '40';
  var cct     = params.get('cct')     || '40';
  var voltage = params.get('voltage') || 'UT';
  var finish  = params.get('finish')  || 'Black';
  var mount   = params.get('mount')   || 'TR';
  var taa     = params.get('taa')     === '1';

  // Photometric data per wattage (from LWPA datasheet + PDP)
  var photoData = {
    '12':  { lumens: '1,560 lm', peak: '—',       eff: '130 lm/W', file: 'LWPA12_3000K.ies (scaled)' },
    '27':  { lumens: '3,600 lm', peak: '1,497 cd', eff: '133 lm/W', file: 'LWPA27_3000K.ies' },
    '40':  { lumens: '5,200 lm', peak: '2,180 cd', eff: '130 lm/W', file: 'LWPA40_3000K.ies' },
    '67':  { lumens: '8,800 lm', peak: '3,773 cd', eff: '131 lm/W', file: 'LWPA67_3000K.ies' },
    '80':  { lumens: '10,500 lm', peak: '4,833 cd', eff: '131 lm/W', file: 'LWPA80_3000K.ies' }
  };
  var pd = photoData[watts] || photoData['40'];

  var skuLive = sku + (taa ? '/TAA' : '');
  document.querySelectorAll('#catNum, #catNum2, #catNum3, #catNum4, #liveSku').forEach(function(el) { el.textContent = skuLive; });
  document.getElementById('piCatNum').textContent = skuLive;

  document.getElementById('qsLumens').innerHTML = pd.lumens.replace(' lm','') + '<span class="qs-unit">lm</span>';
  document.getElementById('qsWatts').innerHTML  = watts + '<span class="qs-unit">W</span>';
  document.getElementById('qsCct').innerHTML    = (cct === '50' ? '5000' : '4000') + '<span class="qs-unit">K</span>';
  document.getElementById('qsVoltage').innerHTML = (voltage === 'HT' ? '347-480' : '120-277') + '<span class="qs-unit">V</span>';

  document.getElementById('ocWatts').textContent  = watts;
  document.getElementById('ocCct').textContent    = cct;
  document.getElementById('ocVolt').textContent   = voltage === 'HT' ? 'HT' : 'UT';
  var finishCode = { 'Black': 'B', 'Bronze': 'Z', 'Silver': 'S', 'White': 'W' };
  document.getElementById('ocFinish').textContent = finishCode[finish] || finish.charAt(0).toUpperCase();
  document.getElementById('ocMount').textContent  = (mount === 'SF' || mount === 'Slip-Fitter') ? 'SF' : 'TR';
  document.getElementById('ocOpts').textContent   = taa ? 'TAA' : '—';
  if (taa) document.getElementById('taaBadge').style.display = 'inline-block';

  document.getElementById('photoEyebrow').textContent = 'LWPA' + watts + ' · ' + (cct === '50' ? '5000K' : '4000K');
  document.getElementById('photoPolarImg').src = '/products/anaheim/assets/photometrics/LWPA' + watts + '_3000K.svg';
  document.getElementById('photoPeak').textContent    = pd.peak;
  document.getElementById('photoLumens').textContent  = pd.lumens;
  document.getElementById('photoEff').textContent     = pd.eff;
  document.getElementById('photoIesFile').textContent = pd.file;

  var d = new Date();
  var dateStr = d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' });
  var revStr  = d.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit' }).replace('/', '-');
  document.getElementById('liveDate').textContent = dateStr;
  ['revDate','revDate2','revDate3','revDate4'].forEach(function(id) { document.getElementById(id).textContent = revStr; });
})();
</script>
</body>
</html>

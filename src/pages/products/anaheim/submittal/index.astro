  .section-head h2 { font-size: 13pt; }
  .section-eyebrow { font-size: 7pt; letter-spacing: 1.5pt; color: var(--muted); text-transform: uppercase; }
  .spec-table { width: 100%; border-collapse: collapse; font-size: 8.5pt; }

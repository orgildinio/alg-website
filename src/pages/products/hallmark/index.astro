  /* Zoom modal — full-screen dimensions image */
  .zoom-modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.94);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 48px;
    cursor: zoom-out;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .zoom-modal.open { display: flex; }
  .zoom-modal-content { width: 100%; max-width: 1280px; max-height: 88vh; display: flex; align-items: center; justify-content: center; }
  .zoom-modal-content img { max-width: 100%; max-height: 88vh; height: auto; width: auto; }
  .zoom-modal-content svg { width: 100%; height: 100%; }
  .zoom-modal-close {
    position: absolute;
    top: 24px;
    right: 32px;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.3);
    color: white;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .zoom-modal-close:hover { background: rgba(255,255,255,0.1); border-color: white; }
  .zoom-modal-hint {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255,255,255,0.5);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

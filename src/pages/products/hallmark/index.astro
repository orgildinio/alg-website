<!-- Section 8 accessories — Hallmark filter pill driver -->
<script is:inline>
(function(){
  var pills = document.querySelectorAll('.acc-pill');
  var cards = document.querySelectorAll('#accGrid .acc-card');
  if (!pills.length || !cards.length) return;
  pills.forEach(function(p){
    p.addEventListener('click', function(){
      var f = p.dataset.filter;
      pills.forEach(function(x){
        x.classList.toggle('active', x === p);
        x.setAttribute('aria-selected', x === p ? 'true' : 'false');
      });
      cards.forEach(function(c){
        var show = (f === 'all') || (c.dataset.cat === f);
        c.style.display = show ? '' : 'none';
      });
    });
  });
})();
</script>

<!-- ============================================================================
     SECTION 9 — Configurator + Submittal · "Build Your Hallmark"
     ----------------------------------------------------------------------------
     SKU template (datasheet pg 3 ordering guide · Hallmark LLSN encoder · per James 2026-05-26):
        LLSN{"{"}LEN{"}"}-{"{"}WBUNDLE{"}"}CS[/B][/{"{"}OPTIC{"}"}]
        — LEN     = 2 / 4 / 8 (length in feet)
        — WBUNDLE = WATTSELECT bundle code per length (NO slash before CS · CS is implicit suffix):
                    LLSN2: 2035CS  (20/25/30/35W · 4,233 lm max IES-measured @ 35W)
                    LLSN4: 3550CS  (35/40/45/50W · 7,190 lm max IES-measured @ 50W)
                    LLSN8: 40100CS (40/60/80/100W · 14,379 lm max IES-measured @ 100W)
        — /B      = Black finish (optional · omit for White default)
        — /OPTIC  = FL (Flat) · FR (Reflector) · RL (Round) · WL (Wide) — optional (omit for factory default)
     30 enumerated SKUs across 3 lengths × 2 finish-options × 5 optic-options-incl-default:
       LLSN2-2035CS · LLSN2-2035CS/B · LLSN2-2035CS/B/FL · LLSN2-2035CS/B/FR · LLSN2-2035CS/B/RL · LLSN2-2035CS/B/WL
       LLSN2-2035CS/FL · LLSN2-2035CS/FR · LLSN2-2035CS/RL · LLSN2-2035CS/WL
       (× LLSN4-3550CS · LLSN8-40100CS = 30 total)
     Required (1): Length
     Optional (2): Finish (omit = W default · /B for Black) · Optic (omit = factory default · 4 explicit codes)
     Live readout: lumens · efficacy · peak intensity · voltage · optic · CCT · CRI
     CTAs (Illuminator-canonical): Pricing & Availability, Submittal PDF, Request a Layout
     CFG-* compliance:
       CFG-COPY-3  configurators ship at Illuminator density · chip-codes only · no inline callouts
       CFG-QA-1    URL contract uses canonical &length=, &optic=, &finish=
       CFG-5a      cfg-col-legend-floor on the shorter (right) column
     ============================================================================ -->
<section class="cfg-section" id="configurator">
  <div class="cfg-inner">

    <div class="cfg-head">
      <div class="cfg-eyebrow">Configurator</div>
      <h2 class="cfg-title">Build Your Hallmark.</h2>
      <p class="cfg-sub">
        Pick length — finish and optic are optional. SKU resolves live per datasheet pg 3: <code>LLSN{"{"}LEN{"}"}-{"{"}WBUNDLE{"}"}CS</code> with optional <code>/B</code> for Black and <code>/{"{"}OPTIC{"}"}</code> for a non-default lens. 3 lengths · <strong>4-WATTSELECT × 4-CCTSELECT</strong> (dip-switch · field-toggle) · 4 field-swap optics · DLC Standard.
      </p>
    </div>

    <div class="cfg-counter-band">
      <div class="cfg-counter" id="cfgCounter"><strong id="cfgCount">0</strong> of 3 required (Length &middot; Finish &middot; Optic) &middot; WATTSELECT/CCT default to max &middot; accessories optional</div>
      <button type="button" class="cfg-reset" id="cfgReset" aria-label="Reset configurator">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
        Reset
      </button>
    </div>

    <!-- Build form · 60/40 split (Required left at 60% · Optional right at 40% with legend at floor)
         Inline grid-template-columns is intentional: forces 60/40 even if browser is serving stale
         cached CSS from a previous build. The .split-60-40 class still drives padding/borders/typography. -->
    <div class="cfg-body split-60-40" style="grid-template-columns: 3fr 2fr !important;">
      <!-- ============== REQUIRED COLUMN (40%) ==============
           6 fields: Length · WATTSELECT · CCTSELECT · Sensor-Ready · Finish · Beam Optic
           Length sets body[data-form] · WATTSELECT chip rows swap per length via data-form-show.
           Non-max WATTSELECT/CCTSELECT chips ship as WB (Workbench · 1-3wk factory dip-lock · /W## /C## append).
           Max chips (★) are QS default · no SKU append (dip-switch pre-set to max at factory).
           Sensor-Ready is locked-★ · standard inclusion · no SKU append (every Hallmark ships ready). -->
      <div class="cfg-col cfg-col-req">
        <div class="cfg-col-head">
          <div class="cfg-col-title cfg-col-title-required">Required</div>
          <div class="cfg-col-meta">3 user picks (Length · Finish · Optic) · WATT/CCT/Sensor-Ready auto-default</div>
        </div>
        <div class="cfg-rows">

          <!-- Step 1 · Length · 3 chips · sets body[data-form] for WATTSELECT chip-row swap -->
          <div class="cfg-row" data-field="length">
            <div class="cfg-row-l">
              <span class="cfg-row-label">Length<span class="cfg-req">*</span></span>
              <span class="cfg-row-code is-empty" data-field-code="length">—</span>
            </div>
            <div class="cfg-seg" style="grid-template-columns: repeat(3, 1fr);">
              <button type="button" class="cfg-chip" data-field="length" data-val="2" data-code="2"><span class="cfg-chip-stripe qs"></span><span class="cfg-chip-main"><span class="cfg-chip-label">2 FT</span></span></button>
              <button type="button" class="cfg-chip" data-field="length" data-val="4" data-code="4"><span class="cfg-chip-stripe qs"></span><span class="cfg-chip-main"><span class="cfg-chip-label">4 FT</span></span></button>
              <button type="button" class="cfg-chip" data-field="length" data-val="8" data-code="8"><span class="cfg-chip-stripe qs"></span><span class="cfg-chip-main"><span class="cfg-chip-label">8 FT</span></span></button>
            </div>
          </div>

          <!-- Step 2 · 4-WATTSELECT · ship-default per length (chip row swaps via data-form-show)
               Max wattage chip is ★ QS default (no SKU append · dip-switch field-toggle).
               Non-max chips are WB · /W## append · factory locks dip-switch at order. -->

          <!-- LLSN2 · 2035 bundle · 20/25/30/35W (35W default ★ QS · others WB) -->
          <div class="cfg-row" data-field="wattage" data-form-show="2">
            <div class="cfg-row-l">
              <span class="cfg-row-label">4-WATTSELECT <small style="color:var(--text-muted); font-weight:400;">(non-max = WB · /W## factory lock)</small><span class="cfg-req">*</span></span>
              <span class="cfg-row-code" data-field-code="wattage">35W &middot; default</span>
            </div>
            <div class="cfg-seg" style="grid-template-columns: repeat(4, 1fr);">

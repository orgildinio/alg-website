<script is:inline>
// Hero carousel — CFG-HERO-2 · optic-chip selector (planoⒶRCH canonical · Spectra-I 2026-05-22).
// Dot-nav replaced with optic chips (ROUND / FLAT / WIDE / REFLECTOR). Selector swapped
// from #carouselDots > span to #carouselChips > button. Default opens on slide 1 (= FLAT,
// most-spec'd general-purpose optic for linear strip).
(function() {
  var track = document.getElementById('carouselTrack');
  var chips = document.querySelectorAll('#carouselChips > button');
  var slides = track ? track.querySelectorAll('.carousel-slide').length : 0;
  if (!track || !slides) return;
  var idx = 1;  // start on FLAT (index 1) — most-spec'd general-purpose optic
  function go(i) {
    idx = (i + slides) % slides;
    track.style.transform = 'translateX(-' + (idx * 100) + '%)';
    chips.forEach(function(c, n) { c.classList.toggle('active', n === idx); });
  }
  go(idx);  // sync DOM to default index on load
  var timer = setInterval(function() { go(idx + 1); }, 5000);
  chips.forEach(function(c) {
    c.addEventListener('click', function() {
      clearInterval(timer);
      go(parseInt(c.dataset.i, 10));
      timer = setInterval(function() { go(idx + 1); }, 5000);
    });
  });
})();

// (Legacy Illuminator spec-table populator removed — Hallmark's 3-housing-class populator
//  lives inline with Section 2 above and uses LLSN2/LLSN4/LLSN8 length classes.)

// Dimensions zoom modal — click magnifier to open, click anywhere or ESC to close
(function() {
  function initZoom() {
    var btn      = document.querySelector('.spec-dim-zoom');
    var modal    = document.getElementById('zoomModal');
    var img      = document.getElementById('dimImg');
    var src      = document.getElementById('dimSvg');
    var dst      = document.getElementById('zoomContent');
    var closeBtn = document.getElementById('zoomClose');
    if (!btn || !modal || !dst || !(img || src)) {
      console.warn('zoom-modal: missing DOM nodes', {btn:!!btn, modal:!!modal, img:!!img, src:!!src, dst:!!dst});
      return;
    }
    function openModal(e) {
      if (e) { e.preventDefault(); e.stopPropagation(); }
      // Prefer the production drawing; fall back to inline SVG
      if (img && img.complete && img.naturalWidth > 0) {
        dst.innerHTML = '<img src="' + img.getAttribute('src') + '" alt="' + img.alt + '" />';
      } else if (src) {
        dst.innerHTML = src.outerHTML.replace(/\bdisplay\s*:\s*none[;]?/i, '');
      }
      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeModal(e) {
      if (e) { e.preventDefault(); }
      modal.classList.remove('open');
      document.body.style.overflow = '';
    }
    btn.addEventListener('click', openModal);
    modal.addEventListener('click', closeModal);
    if (closeBtn) closeBtn.addEventListener('click', function(e){ e.stopPropagation(); closeModal(e); });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal.classList.contains('open')) closeModal();
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initZoom);
  } else {
    initZoom();
  }
})();

// Section 5 — Total Adaptive Control: platform tab → swap sensor SVG, swap body copy, trigger ripple shockwave
// Hallmark copy grounded in LLSN datasheet (Bi-Level · ⒶCS · SILVAIR sensor ecosystem).
(function() {
  var copy = {
    bilevel: "Drop-in occupancy + bi-level dimming — no commissioning, gateway, or app required. MSP/BLS PIR occupancy sensor mounts directly to the Hallmark integrated sensor receptacle. IR remote (RM-HT/06S) for on-site commissioning. ASHRAE 90.1 and Title 24 occupancy reduction compliance out of the box.",
    acs:     "ALG's in-house Bluetooth Mesh platform — networked occupancy, daylight harvesting, and scene control via the AURA app. Cloud-managed via the ⒶCS portal. Kinetic switches (MSZ-ACS) require no battery or wiring. Ceiling-mount PIR (MSP-8CM-ACS / MSP-40CM-ACS) covers warehouse aisles, parking decks, and multi-bay floors with linear-strip layouts up to 13FT mount.",
    silvair: "SILVAIR Bluetooth Mesh — DLC NLC qualified mesh nodes (MSP-NLC + MSX-LV5-NLC) for enterprise-scale deployments. Self-healing topology, no gateway required, full control via the SILVAIR commissioning app. The path to DLC NLC rebate qualification on every Hallmark install."
  };
  function init() {
    var tabs = document.querySelectorAll('.tac-callout-tab');
    var sensors = document.querySelectorAll('.tac-sensor-svg');
    var copyEl = document.getElementById('tacCalloutCopy');
    var wave = document.getElementById('tacShockwave');
    if (!tabs.length || !sensors.length || !wave) return;
    function select(platform) {
      tabs.forEach(function(t) {
        var isActive = t.dataset.platform === platform;
        t.classList.toggle('active', isActive);
        t.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
      sensors.forEach(function(s) {
        s.classList.toggle('is-active', s.dataset.platform === platform);
      });
      if (copyEl && copy[platform]) copyEl.textContent = copy[platform];
      // Trigger shockwave: remove + re-add class to restart animation
      wave.classList.remove('is-rippling');
      void wave.offsetWidth;
      wave.classList.add('is-rippling');
    }
    tabs.forEach(function(t) {
      t.addEventListener('click', function() { select(t.dataset.platform); });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();

// (Legacy Illuminator photometrics IIFE removed — Hallmark's 3-length × 4-optic
//  photometrics driver lives inline with Section 6 above. 12 plot states (LLSN2/4/8 ×
//  RL/FL/WL/FR), per-optic parametric polar plots, IES bundle URL wired live to
//  WorkDrive c4cc7fe6... in the per-config download link.)

// (Legacy Illuminator acc-section modal IIFE removed — Hallmark accessories
//  use the lighter inline filter-pill driver above. Modal/click-detail is a v2 follow-up.)


// =============================================================================
// SECTION 9 — Configurator (Build Your Hallmark)
// SKU template (Hallmark LLSN linear-strip encoder · datasheet pg 3 · verified 2026-05-26):
//   LLSN{LEN}-{WBUNDLE}CS[/B][/{OPTIC}]
//   Required (1): length
//   Optional (2): finish (omit = W default · /B for Black) · optic (omit = factory default · FL/FR/RL/WL)
//   Fixed: CS bundle (4-CCTSELECT · always implicit in WBUNDLE suffix · no separate chip)
//   Fixed: 120-277V universal voltage (no chip)
// 30 enumerated SKUs across 3 lengths × 2 finish-options × 5 optic-options (incl. omit).
// CTAs (Illuminator-canonical): Pricing & Availability, Submittal PDF, Request a Layout
// CFG-QA-1: URL contract uses canonical &length=, &optic=, &finish=
// =============================================================================
(function() {
  // 3 required user-pick fields (Length · Finish · Optic). Wattage/CCT/Sensor-Ready also live
  // in the Required column but auto-default via seedDefaults() — they don't need active picks,
  // so they're excluded from the REQUIRED tally (otherwise the counter reads "6 of 3" once defaults
  // seed, which is illogical · per James 2026-05-26 PM).
  var REQUIRED  = ['length', 'finish', 'optic'];
  // 4 optional accessory fields · all toggleable · multi-select within 'constant' bucket.
  var OPTIONAL  = ['constant', 'sensor', 'mount'];
  // 'constant' supports multi-select (EM08 + 10SP-277 + 20SP-277 can all coexist on one order).
  var MULTI     = ['constant'];

  // Auto-default chips · applied on init + on length change (for wattage which is length-dependent).
  // Only WATTSELECT/CCTSELECT/Sensor-Ready auto-default — user must actively pick Length/Finish/Optic.
  // The star (★) on the W (White) finish chip and Factory Default optic chip is the visual hint that
  // those would be the canonical defaults if no preference, but the user still has to click them.
  var WATTAGE_DEFAULT = { '2': '35', '4': '50', '8': '100' };
  var STATIC_DEFAULTS = { cct: '5000', sensor_ready: 'SR' };

  // SKU encoding rules · datasheet pg 3 ordering guide (verified 2026-05-26 against James-provided 30-SKU list):
  //   prefix      LLSN{length}            — length = 2 / 4 / 8
  //   wbundle     -{CODE}CS               — leading dash · WATTSELECT bundle + CS suffix (NO slash between)
  //                 LLSN2 = 2035CS  (20/25/30/35W · 4-CCTSELECT)
  //                 LLSN4 = 3550CS  (35/40/45/50W · 4-CCTSELECT)
  //                 LLSN8 = 40100CS (40/60/80/100W · 4-CCTSELECT)
  //   finish      /B (Black only)         — leading slash · omit for White default
  //   optic       /FL /FR /RL /WL         — leading slash · omit for factory default
  //
  // Enumerated 30-SKU set per James 2026-05-26 (verified examples):
  //   LLSN2-2035CS · LLSN2-2035CS/B · LLSN2-2035CS/FL · LLSN2-2035CS/B/RL · ...
  //   (30 = 3 lengths × 2 finish-options × 5 optic-options-incl-default)
  //
  // The wattage bundle code is derived from length, not user-selected (4-WATTSELECT
  // is field-toggle via dip-switch, not a SKU-fork). CCT is 4-CCTSELECT via dip-switch.

  // WATTSELECT bundle code per length (datasheet pg 3 ordering guide).
  // These are the wattage-bundle codes that appear directly after the length number.
  var WBUNDLE = {
    '2': '2035',   // LLSN2 · 20/25/30/35W bundle · 4,233 lm @ 35W (IES-measured 2026-05-26)
    '4': '3550',   // LLSN4 · 35/40/45/50W bundle · 7,190 lm @ 50W (IES-measured 2026-05-26)
    '8': '40100'   // LLSN8 · 40/60/80/100W bundle · 14,379 lm @ 100W (IES-measured 2026-05-26)
  };

  // Lookup tables — Hallmark spec matrix indexed by length.
  // 130-145 LM/W on Seoul 3528 LEDs · 4-WATTSELECT field-toggle (lumens shown at max position · 5000K).
  // Peak cd + lumens are IES-measured (LM-79) at max WATTSELECT position · 2026-05-26.
  var SPEC = {
    length: {
      '2': { lumens: '4,233 lm (max @ 35W) · 130 lm/W peak', lpw: '125-137 lm/W' },
      '4': { lumens: '7,190 lm (max @ 50W) · 142 lm/W peak', lpw: '140-145 lm/W' },
      '8': { lumens: '14,379 lm (max @ 100W) · 142 lm/W peak', lpw: '140-145 lm/W' }
    },
    finish: {
      'W': 'White · DampⒶRMOR steel (default · no /W in SKU)',
      'B': 'Black · DampⒶRMOR steel (/B appended to SKU)'
    },
    optic: {
      'RL': 'RL · Round lens · ~145° wide cone @ 2FT, ~138° @ 4/8FT',
      'FL': 'FL · Flat lens · ~109-122° batwing (field-swap)',
      'WL': 'WL · Wide lens · ~113-116° concentrated downlight (field-swap)',
      'FR': 'FR · Flat+Reflector · +30% on-axis cd (field-swap)'
    },
    cct: '4-CCTSELECT · 3000/3500/4000/5000K (dip-switch)',
    voltage: '120-277V · Universal (single-voltage on every Hallmark)',
    // Peak candela at max WATTSELECT position · 5000K · IES-measured (LM-79) 2026-05-26
    peak: {
      '2': { 'RL': '1,068 cd', 'FL': '1,269 cd', 'WL': '1,283 cd', 'FR': '~1,650 cd' },
      '4': { 'RL': '1,866 cd', 'FL': '2,054 cd', 'WL': '2,109 cd', 'FR': '~2,670 cd' },
      '8': { 'RL': '3,732 cd', 'FL': '4,109 cd', 'WL': '4,218 cd', 'FR': '~5,340 cd' }
    }
  };

  // Default starting state — empty (no preselects). User picks all 4 required.
  var DEFAULT_STATE = {};

  function init() {
    var section   = document.getElementById('configurator');
    if (!section) return;
    var counter   = document.getElementById('cfgCount');
    var counterEl = document.getElementById('cfgCounter');
    var resetBtn  = document.getElementById('cfgReset');
    var skuEl     = document.getElementById('cfgSku');
    var copyBtn   = document.getElementById('cfgSkuCopy');
    var copyLabel = document.getElementById('cfgSkuCopyLabel');
    var warning   = document.getElementById('cfgWarning');
    var ctaPrice  = document.getElementById('cfgCtaPrice');
    var ctaPdf    = document.getElementById('cfgCtaPdf');
    var chips     = section.querySelectorAll('.cfg-chip');
    var state     = Object.assign({}, DEFAULT_STATE);

    // ---- Apply auto-defaults · seeded at init and re-seeded when length changes ----
    function seedDefaults() {
      // Static defaults (CCT/sensor_ready/finish/optic) always seeded once.
      Object.keys(STATIC_DEFAULTS).forEach(function(k) {
        if (state[k] == null) state[k] = STATIC_DEFAULTS[k];
      });
      // Wattage default is length-dependent · re-seeds whenever length changes.
      if (state.length && WATTAGE_DEFAULT[state.length]) {
        state.wattage = WATTAGE_DEFAULT[state.length];
      } else if (!state.length) {
        delete state.wattage;
      }
    }

    // ---- Chip click handler ----
    chips.forEach(function(chip) {
      chip.addEventListener('click', function() {
        if (chip.classList.contains('disabled')) return;
        if (chip.classList.contains('locked')) return; // Sensor-Ready chip is locked-★ standard
        var field = chip.dataset.field;
        var val   = chip.dataset.val;
        var isOpt = OPTIONAL.indexOf(field) >= 0;
        var isMul = MULTI.indexOf(field) >= 0;

        if (isMul) {
          // Multi-select bucket (constⒶNT) — toggle in/out of an array
          if (!Array.isArray(state[field])) state[field] = [];
          var idx = state[field].indexOf(val);
          if (idx >= 0) state[field].splice(idx, 1);
          else state[field].push(val);
          if (state[field].length === 0) delete state[field];
        } else if (isOpt && state[field] === val) {
          // Optional single-select toggle — click active chip clears it
          delete state[field];
        } else {
          state[field] = val;
          // Length change re-seeds the wattage default
          if (field === 'length') seedDefaults();
        }
        applyState();
      });
    });

    // ---- Reset all ----
    resetBtn.addEventListener('click', function() {
      state = {};
      seedDefaults();
      applyState();
    });

    // ---- Apply state to UI ----
    function applyState() {
      // Mirror state.length onto body[data-form] so [data-form-show] CSS rules swap wattage rows.
      if (state.length) document.body.setAttribute('data-form', state.length);
      else document.body.removeAttribute('data-form');

      chips.forEach(function(chip) {
        var f = chip.dataset.field;
        var v = chip.dataset.val;
        var selected;
        if (MULTI.indexOf(f) >= 0) {
          selected = Array.isArray(state[f]) && state[f].indexOf(v) >= 0;
        } else {
          selected = state[f] === v;
        }
        chip.classList.toggle('selected', selected);
      });

      var filled = REQUIRED.filter(function(k) { return state[k] != null; }).length;
      counter.textContent = filled;
      counterEl.classList.toggle('complete', filled === REQUIRED.length);

      var complete = (filled === REQUIRED.length);
      renderSKU(complete);
      warning.classList.toggle('show', !complete);
      ctaPdf.classList.toggle('disabled', !complete);
      ctaPrice.classList.toggle('disabled', !complete);
      copyBtn.disabled = !complete;
      copyBtn.classList.remove('copied');
      copyLabel.textContent = 'Copy SKU';

      renderSpecs();
      renderPreviewImage();
    }

    // ---- Live Preview · swap product photo per finish + optic ----
    // Image library: Hallmark-{White|Black}-{Round|Flat|Wide|Reflector}_nobg.png
    // Currently on disk: White-Round, White-Flat, White-Wide, Black-Reflector.
    // Fallback rules: Black + non-FR optic → use White variant (Black photography pending);
    //                 FR optic (any finish) → use Black-Reflector (the only reflector photo);
    //                 default (no optic picked) → use Round per CFG-FAM Hallmark canonical.
    function renderPreviewImage() {
      var imgEl = document.getElementById('cfgPreviewImg');
      if (!imgEl) return;
      var optic  = state.optic || 'RL';   // sane fallback when no optic yet — Round is the most common Hallmark ship config
      var finish = state.finish || 'W';
      // Optic → image-name map (lens shape drives the file pick · 4 explicit codes per datasheet)
      var lensMap = {
        'RL': 'Round',
        'FL': 'Flat',
        'WL': 'Wide',
        'FR': 'Reflector'  // only Black-Reflector exists in lib
      };
      var lens = lensMap[optic] || 'Round';
      // FR is only available in Black; for other lenses prefer the picked finish but fall back to White
      // if a Black-{lens} file doesn't yet exist on disk (Black-Flat, Black-Round, Black-Wide pending).
      var color;
      if (lens === 'Reflector') color = 'Black';
      else color = (finish === 'B') ? 'White' : 'White';  // White fallback for non-FR Black until Black-{lens} ships
      var fname = 'Hallmark-' + color + '-' + lens + '_nobg.png?v=2026-05-26-T6';
      var newSrc = 'hallmark/photos/' + fname;
      if (imgEl.getAttribute('src') !== newSrc) {
        imgEl.style.opacity = '0.4';
        imgEl.setAttribute('src', newSrc);
        imgEl.setAttribute('alt', 'LLSN Hallmark · ' + color + ' finish · ' + lens + ' lens · live configurator preview');
        setTimeout(function() { imgEl.style.opacity = '1'; }, 80);
      }
    }

    // ---- SKU encoder ----
    // SKU pattern (Hallmark LLSN linear-strip · datasheet pg 3 ordering guide · per James 2026-05-26):
    //   LLSN{LEN}-{WBUNDLE}CS[/B][/W##][/C##][/{OPTIC}][/EM08][/10SP-277|/20SP-277][/MSP/BLS|MSP/ACS|MSP/NLC][/MAC|/MJP]
    //   - {LEN}     = 2 / 4 / 8 (feet)                            · required
    //   - {WBUNDLE} = 2035 / 3550 / 40100 + "CS" suffix           · derived from length, no slash
    //   - /B        = Black finish (omit for White default)        · required pick
    //   - /W##      = factory wattage lock (omit if max ★ default) · LPVR WB pattern · ships in 1-3 wk
    //   - /C##      = factory CCT lock     (omit if 5000K ★ default) · LPVR WB pattern · ships in 1-3 wk
    //   - /{OPTIC}  = FL / FR / RL / WL or factory-default (omit) · required pick
    //   - accessory codes append in datasheet pg 3 order: EM → SP → MSP → MNT
    function renderSKU(complete) {
      var len = state.length;
      var wb  = len ? WBUNDLE[len] : null;

      var lenSpan = len || '<span class="placeholder">[L]</span>';
      var wbSpan  = wb  || '<span class="placeholder">[WBUNDLE]</span>';

      // Base SKU · always LLSN{LEN}-{WBUNDLE}CS (CS is implicit in every Hallmark, no separator)
      var html = 'LLSN' + lenSpan + '-' + wbSpan + 'CS';

      // /B · Black finish append (W default omits)
      if (state.finish === 'B') html += '/B';

      // /W## · non-max wattage factory lock (WB · 1-3 wk · max wattage omits per data-code="")
      var wattChip = section.querySelector('.cfg-chip.selected[data-field="wattage"]');
      if (wattChip && wattChip.dataset.code) html += '/' + wattChip.dataset.code;

      // /C## · non-max CCT factory lock (WB · 1-3 wk · 5000K omits per data-code="")
      var cctChip = section.querySelector('.cfg-chip.selected[data-field="cct"]');
      if (cctChip && cctChip.dataset.code) html += '/' + cctChip.dataset.code;

      // /OPTIC · required pick · always appends (RL/FL/WL/FR — 4 explicit codes)
      if (state.optic) html += '/' + state.optic;

      // /EM08 + /10SP-277 + /20SP-277 (multi-select within constⒶNT)
      if (Array.isArray(state.constant)) {
        // Preserve datasheet pg 3 order: EM first, then surge
        var constOrder = ['EM08', '10SP-277', '20SP-277'];
        constOrder.forEach(function(c) {
          if (state.constant.indexOf(c) >= 0) html += '/' + c;
        });
      }

      // /MSP/BLS · /MSP/ACS · /MSP/NLC (single-select within contrⒶLS)
      if (state.sensor) html += '/' + state.sensor;

      // /MAC · /MJP (single-select within Mounts)
      if (state.mount) html += '/' + state.mount;

      skuEl.innerHTML = html;
    }
    function placeholderFor(k) {
      return ({
        length: '[L]', wattage: '[W]', cct: '[CCT]',
        finish: '[FIN]', optic: '[OPTIC]'
      })[k] || '[' + k.toUpperCase() + ']';
    }

    // ---- Live spec readout ----
    function renderSpecs() {
      setSpec('lumens',  state.length ? SPEC.length[state.length].lumens : null);
      setSpec('lpw',     state.length ? SPEC.length[state.length].lpw    : null);
      setSpec('voltage', SPEC.voltage);  // always populated — Hallmark is universal-voltage only
      setSpec('optic',   state.optic ? SPEC.optic[state.optic] : null);
      // Peak cd indexed by [length][optic] · only resolves if BOTH selected
      setSpec('peak',    (state.length && state.optic && SPEC.peak[state.length])
                          ? SPEC.peak[state.length][state.optic] : null);

      // CCT + CRI are fixed for the family — already populated in markup, no override.

      // Compliance is constant — DLC Standard, IP40, 7-yr warranty
      setSpec('compliance', 'DLC Standard &middot; IP40 Damp &middot; 7-yr/75k-hr');
    }
    function setSpec(name, val) {
      var el = section.querySelector('[data-spec="' + name + '"]');
      if (!el) return;
      // CCT and CRI are static — never overwrite them with placeholder
      if (name === 'cct' || name === 'cri' || (name === 'compliance' && val == null)) return;
      if (val == null || val === '—') {
        el.textContent = '—';
        el.classList.add('placeholder');
      } else {
        el.textContent = val;
        el.classList.remove('placeholder');
      }
    }

    // ---- Copy SKU ----
    copyBtn.addEventListener('click', function() {
      if (copyBtn.disabled) return;
      var txt = skuEl.textContent.trim();
      if (!txt) return;
      var done = function() {
        copyBtn.classList.add('copied');
        copyLabel.textContent = 'Copied ✓';
        setTimeout(function() {
          copyBtn.classList.remove('copied');
          copyLabel.textContent = 'Copy SKU';
        }, 1800);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(txt).then(done, done);
      } else {
        var ta = document.createElement('textarea');
        ta.value = txt;
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch(e){}
        document.body.removeChild(ta);
        done();
      }
    });

    // ---- Submittal PDF — opens submittal/?length=… in new tab ----
    // CFG-QA-1 contract: canonical &length=, &optic=, &cct=, &finish= for LLSN encoder.
    // Mockup lives at /v2_mockups/lamparARCH/ · submittal lives at /v2_mockups/ · path is one up.
    function buildSubmittalUrl() {
      var sku = skuEl.textContent.trim();
      var params = {
        sku:     sku,
        family:  'hallmark',
        length:  state.length || '4',
        wbundle: WBUNDLE[state.length] || '3550',   // WATTSELECT bundle code · derived from length
        wattage: state.wattage || '',                // selected watt step (e.g. 35 for max-default LLSN2)
        finish:  state.finish  || 'W',
        optic:   (state.optic && state.optic !== 'default') ? state.optic : '',
        cct:     state.cct     || '5000',
        sensor_ready: 'SR'                            // always standard on Hallmark
      };
      // Accessories — comma-join multi-select, single-value for sensor/mount
      if (Array.isArray(state.constant)) params.constant = state.constant.join(',');
      if (state.sensor) params.sensor = state.sensor;
      if (state.mount)  params.mount  = state.mount;
      return 'submittal/?' + new URLSearchParams(params).toString();
    }
    ctaPdf.addEventListener('click', function(e) {
      if (ctaPdf.classList.contains('disabled')) { e.preventDefault(); return; }
      ctaPdf.setAttribute('href', buildSubmittalUrl());
    });

    // Initial render · seed defaults for static fields (CCT/sensor/finish/optic) on load
    seedDefaults();
    applyState();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();

// (Legacy Illuminator motion-carousel IIFE removed — Hallmark's 4-slide motion
//  player lives inline with Section 3 above, sourcing the production mp4s spliced
//  from "LLSN - HALLMARK PromoVideo_NoText.mp4" via splice_hallmark_video.sh)

// CFG-STATE-1 — derive ship-tier (QS / WB / MTO) from selected chip badges, render
// canonical 3-state status panel. Self-contained module · no dependency on the
// configurator's state object · re-derives by walking selected chips on every click.
// Custom RAL (finish chip) with a valid 4-digit input forces MTO.
(function() {
  function deriveShipTier() {
    var section = document.getElementById('configurator');
    if (!section) return 'QS';
    var chips = section.querySelectorAll('.cfg-chip.selected, .cfg-chip[aria-pressed="true"]');
    var worst = 'QS';
    var sawCustomRal = false;
    chips.forEach(function(chip) {
      if (chip.dataset.field === 'finish' && chip.dataset.val === 'RAL') sawCustomRal = true;
      // CFG-CFG-1: stock state moved from .cfg-chip-stock text → .cfg-chip-stripe.
      // Check both selectors for back-compat during the transition.
      if (chip.querySelector('.cfg-chip-stripe.mto') || chip.querySelector('.cfg-chip-stock.mto')) worst = 'MTO';
      else if ((chip.querySelector('.cfg-chip-stripe.wb') || chip.querySelector('.cfg-chip-stock.wb')) && worst !== 'MTO') worst = 'WB';
    });
    if (sawCustomRal) {
      var input = document.getElementById('cfgRalInput');
      if (input && input.value && /^[0-9]{4}$/.test(input.value)) return 'MTO';
    }
    return worst;
  }
  function refreshShipTier() {
    var tier = deriveShipTier();
    var rowEl = document.getElementById('cfgShipTier');
    var iconEl = document.getElementById('cfgShipTierIcon');
    var textEl = document.getElementById('cfgShipTierText');
    var stockEl = document.getElementById('cfgShipTierStock');
    if (!rowEl || !iconEl || !textEl || !stockEl) return;
    if (tier === 'QS') {
      rowEl.style.background = 'rgba(95,199,122,0.08)';
      rowEl.style.border = '1px solid rgba(95,199,122,0.40)';
      iconEl.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#7fc998" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
      textEl.innerHTML = '<strong style="color:#9bd6b1;">QuickShip · à-la-carte assembly</strong> · <span style="color:var(--text-secondary);">All selected components in stock — ships 3-5 day.</span>';
      stockEl.textContent = 'QuickShip · 3-5 day';
      stockEl.style.color = '#9bd6b1';
    } else if (tier === 'WB') {
      rowEl.style.background = 'rgba(96,168,255,0.08)';
      rowEl.style.border = '1px solid rgba(96,168,255,0.40)';
      iconEl.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#7fb6ff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>';
      textEl.innerHTML = '<strong style="color:#a8c9ff;">Workbench Assembly · ~1-3 wk</strong> · <span style="color:var(--text-secondary);">One or more selected components are workbench-assembled to order.</span>';
      stockEl.textContent = 'WB · ~1-3 wk';
      stockEl.style.color = '#a8c9ff';
    } else {
      rowEl.style.background = 'rgba(255,159,28,0.08)';
      rowEl.style.border = '1px solid rgba(255,159,28,0.40)';
      iconEl.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#ffb14d" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
      textEl.innerHTML = '<strong style="color:#ffb14d;">Custom build · Made-to-Order · ~4-6 wk</strong> · <span style="color:var(--text-secondary);">One or more selected components are MTO (custom finish, MTO option, or non-stocked variant).</span>';
      stockEl.textContent = 'MTO · ~4-6 wk';
      stockEl.style.color = '#ffb14d';
    }
  }
  function init() {
    var section = document.getElementById('configurator');
    if (!section) return;
    section.addEventListener('click', function(e) {
      if (e.target.closest('.cfg-chip')) setTimeout(refreshShipTier, 50);
    });
    var ralInput = document.getElementById('cfgRalInput');
    if (ralInput) ralInput.addEventListener('input', function() { setTimeout(refreshShipTier, 50); });
    refreshShipTier();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
// CFG-CFG-1 · syncRowCodes — update per-row .cfg-row-code based on selected chip.
// Mirrors the canonical Liberty pattern. Self-contained · no dependency on the
// configurator's state object · walks selected chips on every chip click.
(function() {
  function syncRowCodes() {
    document.querySelectorAll('.cfg-row-code[data-field-code]').forEach(function(rc) {
      var field = rc.getAttribute('data-field-code');
      if (field === 'cct') return; // locked-default text stays
      var newText = '—', isEmpty = true;
      var selChip = document.querySelector('.cfg-chip.selected[data-field="' + field + '"]');
      if (selChip) {
        var code = selChip.getAttribute('data-code') || '';
        var slashPrefixed = ['mount','optic','photocell','sensor','shield','surge','taa','em','wg','adapter'];
        var alreadySlash = code.charAt(0) === '/';
        if (code) {
          newText = (slashPrefixed.indexOf(field) >= 0 && !alreadySlash) ? '/' + code : code;
          isEmpty = false;
        } else if (field === 'taa') {
          newText = '(blank)'; isEmpty = false;
        } else if (field === 'mount') {
          newText = '(none)'; isEmpty = false;
        }
      }
      rc.textContent = newText;
      rc.classList.toggle('is-empty', isEmpty);
    });
  }
  function init() {
    var section = document.getElementById('configurator');
    if (!section) return;
    section.addEventListener('click', function(e) {
      if (e.target.closest('.cfg-chip')) setTimeout(syncRowCodes, 60);
    });
    syncRowCodes();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();


</script>


<script is:inline>
/* =============================================================================
   CFG-NAV-1 · Sticky-nav scroll-spy
   ----------------------------------------------------------------------------
   IntersectionObserver watches each section the sticky-nav links to. The link
   whose target is "most visible" gets `.is-current` (white bg + red text · the
   visual inverse of `.primary`). One observer, one Map, one CSS class toggle.
   The Pricing & Availability primary button is NOT a section anchor (its href
   is /pricing-availability/), so it's excluded from the spy by the
   `a[href^="#"]` selector below.
   ============================================================================= */
(function() {
  var nav = document.querySelector('.sticky-nav');
  if (!nav) return;
  var links = Array.prototype.slice.call(nav.querySelectorAll('a[href^="#"]'));
  if (!links.length) return;
  var entries = [];
  links.forEach(function(a) {
    var id = a.getAttribute('href').slice(1);
    var sec = id ? document.getElementById(id) : null;
    if (sec) entries.push({ sec: sec, link: a, ratio: 0 });
  });
  if (!entries.length) return;
  function update() {
    var best = null, bestRatio = 0;
    entries.forEach(function(e) { if (e.ratio > bestRatio) { bestRatio = e.ratio; best = e; } });
    entries.forEach(function(e) { e.link.classList.toggle('is-current', e === best && bestRatio > 0); });
  }
  var io = new IntersectionObserver(function(items) {
    items.forEach(function(item) {
      entries.forEach(function(e) { if (e.sec === item.target) e.ratio = item.intersectionRatio; });
    });
    update();
  }, {
    rootMargin: '-20% 0px -55% 0px',
    threshold: [0, 0.1, 0.25, 0.5, 0.75, 1.0]
  });
  entries.forEach(function(e) { io.observe(e.sec); });
})();
</script>


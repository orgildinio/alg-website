<!-- Section 3 motion-player driver — Hallmark (5-slide rotation · clips spliced from PromoVideo_NoText.mp4)
     Mirrors the Illuminator canonical pattern: clips[] uses {url, tag, title};
     dot buttons render as labeled chips (NN · TAG); caption is two-line
     (eyebrow numero + tag, then narrative title). Each clip is 9s exact,
     so we sync the progress bar to video.currentTime and auto-advance on
     video.ended (cleaner than a wallclock ticker for video-driven progress). -->
<script is:inline>
(function(){
  // 5 slides spliced 2026-05-05 from "LLSN - Hallmark PromoVideo_NoText.mp4" via splice_hallmark_video.sh.
  // Best-of-class marketing copy per slide — specifier-grade, number-led, competitively framed.
  // 5 clips sourced from Hallmark WorkDrive production footage 2026-05-26 per
  // hallmark_motion_storyboard.md. Per CFG-MOTION-2 the MP4s contain NO baked-in text —
  // all overlays (tag + title + counter) are HTML/CSS layers over the <video> element.
  var clips = [
    {
      url:   'videos/hallmark-motion-01-round-lens.mp4',
      tag:   'FIELD-SWAPPABLE OPTICS',
      title: 'Round lens. Snap on. Field-set at install. <strong>Concentrates the linear distribution</strong> where you need it &mdash; same Hallmark housing, swap the optic to match the spec.'
    },
    {
      url:   'videos/hallmark-motion-02-wide-lens.mp4',
      tag:   'WIDE-OPTIC ALTERNATE',
      title: 'Wide lens. Snap on. Same SKU. <strong>Spreads the linear distribution</strong> out &mdash; one fixture, two beam profiles. Pick the optic at the loading dock, not the spec sheet.'
    },
    {
      url:   'videos/hallmark-motion-03-cct-select.mp4',
      tag:   '3-CCTSELECT',
      title: '<strong>3500K &middot; 4000K &middot; 5000K</strong> field-set at install. Three-position dip switch on the driver &mdash; pick the color temperature with the same SKU on the truck. No re-spec, no second order.'
    },
    {
      url:   'videos/hallmark-motion-04-sensor-port.mp4',
      tag:   'CONTR<span class="aa">Ⓐ</span>LS-READY',
      title: 'Integrated sensor port. <strong>Bi-Level + Mesh, snap-in.</strong> One receptacle, three control paths: Bi-Level BLS, <span class="aa">Ⓐ</span>CS Bluetooth Mesh, or SILVAIR enterprise mesh. Add the sensor at install &mdash; no external enclosure, no field-drilled bezels.'
    },
    {
      url:   'videos/hallmark-motion-05-em-driver.mp4',
      tag:   'EM BACKUP &middot; FIELD-INSTALL',
      title: '<strong>Field-installable EM driver.</strong> Code-compliant egress. EM08 8W battery backup drops into the housing cavity at install &mdash; pre-terminated leads, factory-tested wiring sequence. Egress lighting compliance without a separate fixture order.'
    }
  ];

  var video    = document.getElementById('motionVideo');
  var caption  = document.getElementById('motionCaption');
  var dotsRow  = document.getElementById('motionDots');
  var progress = document.getElementById('motionProgressBar');
  var errorBox = document.getElementById('motionError');
  var errorPath = document.getElementById('motionErrorPath');
  if (!video || !caption || !dotsRow || !progress) return;

  var idx = 0;

  // Hide / show the missing-clip overlay
  video.addEventListener('loadeddata', function(){ if (errorBox) errorBox.style.display = 'none'; });
  video.addEventListener('error', function(){
    if (errorBox && errorPath) {
      errorPath.textContent = clips[idx].url;
      errorBox.style.display = 'flex';
    }
  });

  function set(i) {
    idx = ((i % clips.length) + clips.length) % clips.length;
    var c = clips[idx];
    var num = (idx + 1).toString().padStart(2, '0');
    var total = clips.length.toString().padStart(2, '0');

    video.src = c.url;
    video.load();
    var p = video.play();
    if (p && typeof p.catch === 'function') p.catch(function(){});

    caption.innerHTML =
      '<div class="motion-caption-eyebrow">' + num + ' / ' + total + ' &middot; ' + c.tag + '</div>' +
      '<div class="motion-caption-title">' + c.title + '</div>';

    dotsRow.querySelectorAll('button').forEach(function(b, n) {
      b.classList.toggle('active', n === idx);
      b.setAttribute('aria-selected', n === idx ? 'true' : 'false');
    });

    progress.style.width = '0%';
  }

  // Build the labeled dot row — NN · TAG (matches Illuminator)
  dotsRow.innerHTML = clips.map(function(c, n) {
    var num = (n + 1).toString().padStart(2, '0');
    return '<button type="button" data-i="' + n + '" role="tab"' +
           (n === 0 ? ' class="active" aria-selected="true"' : ' aria-selected="false"') +
           '>' + num + ' &middot; ' + c.tag + '</button>';
  }).join('');
  dotsRow.querySelectorAll('button').forEach(function(b) {
    b.addEventListener('click', function(){ set(parseInt(b.dataset.i, 10)); });
  });

  // Progress bar tracks the video timeline, not a wallclock — accurate to the frame
  video.addEventListener('timeupdate', function(){
    if (video.duration) {
      progress.style.width = (100 * video.currentTime / video.duration) + '%';
    }
  });

  // Auto-advance when the current clip finishes
  video.addEventListener('ended', function(){ set(idx + 1); });

  set(0);
})();
</script>


<!-- Section 6 photometrics — Hallmark 3-length × 3-optic IES-derived polar driver.
     Backing data parsed from hallmark/ies/ (LM-63-2002, 5000K, max WATTSELECT per length)
     via hallmark/parse_ies.py · rendered as assets/polar/hallmark-polar-{"{"}N{"}"}ft-{optic}.svg.
     Values below are measured (cd, lm, W, lm/W, beam-angle deg) — not estimated. -->
<script is:inline>
(function(){
  // 3 lengths × 3 optics = 9 IES samples. Each tab click swaps photoPolarImg.src
  // and updates the metrics text. No FR data exists in the supplied IES library, so
  // FR is not surfaced as a tab here (Hallmark currently ships RL/FL/WL only).
  var ies = {
    '2_RL': { svg: 'hallmark-polar-2ft-rl.svg', lumens: 4233, watts: 32.7, lpw: 129, peak: 1068, beam: 145, file: 'LLSN2-2035CS-RL-35W-5000K_IESNA2002.IES' },
    '2_FL': { svg: 'hallmark-polar-2ft-fl.svg', lumens: 4449, watts: 32.8, lpw: 136, peak: 1269, beam: 109, file: 'LLSN2-2035CS-FL-35W-5000K_IESNA2002.IES' },
    '2_WL': { svg: 'hallmark-polar-2ft-wl.svg', lumens: 4481, watts: 32.7, lpw: 137, peak: 1283, beam: 116, file: 'LLSN2-2035CS-WL-35W-5000K_IESNA2002.IES' },
    '4_RL': { svg: 'hallmark-polar-4ft-rl.svg', lumens: 7190, watts: 50.6, lpw: 142, peak: 1866, beam: 138, file: 'LLSN4-3550CS-RL-50W-5000K_IESNA2002.IES' },
    '4_FL': { svg: 'hallmark-polar-4ft-fl.svg', lumens: 7095, watts: 49.7, lpw: 143, peak: 2054, beam: 122, file: 'LLSN4-3550CS-FL-50W-5000K_IESNA2002.IES' },
    '4_WL': { svg: 'hallmark-polar-4ft-wl.svg', lumens: 7226, watts: 49.7, lpw: 145, peak: 2109, beam: 114, file: 'LLSN4-3550CS-WL-50W-5000K_IESNA2002.IES' },
    '8_RL': { svg: 'hallmark-polar-8ft-rl.svg', lumens: 14379, watts: 101.2, lpw: 142, peak: 3732, beam: 138, file: 'LLSN8-40100CS-RL-100W-5000K_IESNA2002.IES' },
    '8_FL': { svg: 'hallmark-polar-8ft-fl.svg', lumens: 14190, watts: 99.4,  lpw: 143, peak: 4109, beam: 122, file: 'LLSN8-40100CS-FL-100W-5000K_IESNA2002.IES' },
    '8_WL': { svg: 'hallmark-polar-8ft-wl.svg', lumens: 14452, watts: 99.4,  lpw: 145, peak: 4218, beam: 114, file: 'LLSN8-40100CS-WL-100W-5000K_IESNA2002.IES' }
  };

  var opticDescs = {
    'RL': 'Round lens · widest cone (~145° at 2FT, ~138° at 4/8FT) measured @ 50% peak. Best for low-mount aisles + tight-pitched mezzanines where you want even floor coverage from below 15FT.',
    'FL': 'Flat lens · standard batwing (~109-122°) measured @ 50% peak. Pick this for general warehouse / industrial-bay applications mounted 10-20FT.',
    'WL': 'Wide lens · asymmetric spread (~113-116°) measured @ 50% peak. Pick this when you want concentrated downlight for assembly lines, conveyor stations, and inspection benches with brighter directly-below output.'
  };

  var modelTabs = document.querySelectorAll('.photo-tab[data-model]');
  var opticTabs = document.querySelectorAll('.photo-tab[data-optic]');
  var statPeak  = document.getElementById('photoStatPeak');
  var statLum   = document.getElementById('photoStatLumens');
  var statFile  = document.getElementById('photoStatFile');
  var statOpticDesc = document.getElementById('photoStatOpticDesc');
  var polarImg  = document.getElementById('photoPolarImg');

  var state = { model: '2', optic: 'RL' };

  function fmt(n){ return n.toLocaleString('en-US'); }

  function render(){
    var key = state.model + '_' + state.optic;
    var d = ies[key];
    if (!d) return;

    if (polarImg) {
      // Cache-buster query param · bump v=YYYY-MM-DD-Tn whenever the SVG files are re-rendered.
      // Without this, the browser will serve stale cached SVG even after parse_ies.py rewrites the file.
      polarImg.setAttribute('src', 'assets/polar/' + d.svg + '?v=2026-05-26-T5');
      polarImg.setAttribute('alt', 'LLSN' + state.model + ' Hallmark · ' + state.optic + ' optic · polar candela distribution · 5000K · peak ' + fmt(d.peak) + ' cd · beam ' + d.beam + '°');
    }
    if (statPeak) statPeak.textContent = fmt(d.peak) + ' cd';
    if (statLum)  statLum.textContent  = fmt(d.lumens) + ' lm @ ' + d.watts.toFixed(1) + 'W · ' + d.lpw + ' lm/W';
    if (statFile) statFile.textContent = d.file;
    if (statOpticDesc) statOpticDesc.textContent = opticDescs[state.optic] || '';

    modelTabs.forEach(function(t){
      var on = t.dataset.model === state.model;
      t.classList.toggle('active', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    opticTabs.forEach(function(t){
      var on = t.dataset.optic === state.optic;
      t.classList.toggle('active', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
    });
  }

  modelTabs.forEach(function(t){
    t.addEventListener('click', function(){ state.model = t.dataset.model; render(); });
  });
  opticTabs.forEach(function(t){
    t.addEventListener('click', function(){ state.optic = t.dataset.optic; render(); });
  });

  render();
})();
</script>


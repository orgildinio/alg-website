<script is:inline>
/* Liberty spec table model switcher . 5 housing classes x 3 wattages each.
 Source: LSBX | Liberty | Datasheet.pdf . pp.2 specs + pp.6 dimensions.
 Per-housing dimGroup keeps the dim panel in sync with the housing tab. */
(function() {
 'use strict';

 var SPEC_DATA = {
 'L100': {
 rows: [
 { w: '50W', lm: '7,700 lm', lpw: '154', cct: '3000K . 4000K . 5000K', volt: '120-277V . 277-480V' },
 { w: '75W', lm: '11,550 lm', lpw: '154', cct: '3000K . 4000K . 5000K', volt: '120-277V . 277-480V' },
 { w: '100W *', lm: '15,400 lm', lpw: '154', cct: '3000K . 4000K . 5000K', volt: '120-277V . 277-480V' }
 ],
 dimGroup: 'under200'
 },
 'L150': {
 rows: [
 { w: '80W', lm: '12,080 lm', lpw: '151', cct: '3000K . 4000K . 5000K', volt: '120-277V . 277-480V' },
 { w: '100W', lm: '15,100 lm', lpw: '151', cct: '3000K . 4000K . 5000K', volt: '120-277V . 277-480V' },
 { w: '150W *', lm: '22,650 lm', lpw: '151', cct: '3000K . 4000K . 5000K', volt: '120-277V . 277-480V' }
 ],
 dimGroup: 'under200'
 },
 'L200': {
 rows: [
 { w: '120W', lm: '17,880 lm', lpw: '149', cct: '3000K . 4000K . 5000K', volt: '120-277V . 277-480V' },
 { w: '150W', lm: '22,350 lm', lpw: '149', cct: '3000K . 4000K . 5000K', volt: '120-277V . 277-480V' },
 { w: '200W *', lm: '29,800 lm', lpw: '149', cct: '3000K . 4000K . 5000K', volt: '120-277V . 277-480V' }
 ],
 dimGroup: 'under200'
 },
 'L300': {
 rows: [
 { w: '220W', lm: '32,120 lm', lpw: '146', cct: '3000K . 4000K . 5000K', volt: '120-277V . 277-480V' },
 { w: '250W', lm: '36,500 lm', lpw: '146', cct: '3000K . 4000K . 5000K', volt: '120-277V . 277-480V' },
 { w: '300W *', lm: '43,800 lm', lpw: '146', cct: '3000K . 4000K . 5000K', volt: '120-277V . 277-480V' }
 ],
 dimGroup: '300W'
 },
 'L450': {
 rows: [
 { w: '330W', lm: '48,840 lm', lpw: '148', cct: '3000K . 4000K . 5000K', volt: '120-277V . 277-480V' },
 { w: '390W', lm: '57,720 lm', lpw: '148', cct: '3000K . 4000K . 5000K', volt: '120-277V . 277-480V' },
 { w: '450W *', lm: '66,600 lm', lpw: '148', cct: '3000K . 4000K . 5000K', volt: '120-277V . 277-480V' }
 ],
 dimGroup: '450W'
 }
 };

 // dimGroup -> spec-dim panel title (the SVG itself is swapped by `.is-active` toggle
 // on the 3 `<img class="spec-dim-svg" data-dim-group="...">` elements in markup).
 // Per Liberty datasheet: <200W chassis (LSBX100/150/200) shares one drawing;
 // 300W and 450W each have their own.
 var DIM_TITLES = {
 'under200': 'Dimensions . LSBX100 / 150 / 200',
 '300W': 'Dimensions . LSBX300',
 '450W': 'Dimensions . LSBX450'
 };

 function renderHousing(housing) {
 var d = SPEC_DATA[housing];
 if (!d) return;
 document.getElementById('specTableBody').innerHTML = d.rows.map(function(r) {
 var isDef = r.w.indexOf('*') > -1;
 return '<tr' + (isDef ? ' class="is-default"' : '') + '>' +
 '<td>' + r.w + '</td>' +
 '<td>' + r.lm + '</td>' +
 '<td>' + r.lpw + '</td>' +
 '<td>' + r.cct + '</td>' +
 '<td>' + r.volt + '</td>' +
 '</tr>';
 }).join('');

 var dimGroup = d.dimGroup;
 var title = DIM_TITLES[dimGroup];
 if (title) document.getElementById('specDimTitle').textContent = title;
 // Toggle the right dim SVG visible
 var activeSrc = null;
 document.querySelectorAll('.spec-dim-svg[data-dim-group]').forEach(function(img) {
 var on = img.dataset.dimGroup === dimGroup;
 img.classList.toggle('is-active', on);
 if (on) activeSrc = img.src;
 });
 // Keep the zoom-modal's img src in sync with the active dim SVG so when
 // the user expands, they see the housing they're currently viewing.
 var zoomImg = document.getElementById('dimZoomImg');
 if (zoomImg && activeSrc) zoomImg.src = activeSrc;
 }

 // Zoom modal . Illuminator-canonical . open/close handlers
 function initDimZoom() {
 var btn = document.getElementById('dimZoomBtn');
 var modal = document.getElementById('dimZoomModal');
 var close = document.getElementById('dimZoomClose');
 if (!btn || !modal) return;
 btn.addEventListener('click', function() { modal.classList.add('open'); });
 modal.addEventListener('click', function(e) {
 if (e.target === modal) modal.classList.remove('open'); // click overlay = close
 });
 if (close) close.addEventListener('click', function() { modal.classList.remove('open'); });
 document.addEventListener('keydown', function(e) {
 if (e.key === 'Escape') modal.classList.remove('open');
 });
 }

 function init() {
 var tabs = document.querySelectorAll('.spec-watt-tab[data-housing]');
 tabs.forEach(function(t) {
 t.addEventListener('click', function() {
 tabs.forEach(function(x) { x.classList.remove('active'); x.setAttribute('aria-selected', 'false'); });
 t.classList.add('active');
 t.setAttribute('aria-selected', 'true');
 renderHousing(t.getAttribute('data-housing'));
 });
 });
 renderHousing('L150'); // default - volume retrofit lane (400W MH replacement)
 initDimZoom(); // wire the dimension drawing expand/zoom modal
 }

 if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
 else init();
})();
</script>



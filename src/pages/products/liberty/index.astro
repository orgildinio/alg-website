 var m = sku.match(/^LSBX(\d+)-3CS-([UH])L([DBSW]|RAL.*)/);
 if (!m) return;
 var w = m[1], v = m[2], f = m[3].replace(/^RAL.*/, 'RAL');
 var l = LUMEN_MAP[w];
 if (l) {
 var elW = document.getElementById('closingPreviewW');
 var elLm = document.getElementById('closingPreviewLm');
 var elLpw = document.getElementById('closingPreviewLpw');
 if (elW) elW.textContent = l.w;
 if (elLm) elLm.textContent = l.lm;
 if (elLpw) elLpw.textContent = l.lpw;
 }
 var elV = document.getElementById('closingPreviewV');
 if (elV) elV.textContent = V_MAP[v] || v;
 var elFin = document.getElementById('closingPreviewFin');
 if (elFin) elFin.textContent = FIN_MAP[f] || f;
 }

 // MutationObserver watches the S9 SKU element and re-syncs on every chip click
 var observer = new MutationObserver(syncFromConfigurator);
 observer.observe(skuEl, { childList: true, characterData: true, subtree: true });

 syncFromConfigurator();
})();
</script>



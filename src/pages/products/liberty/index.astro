 }
 .cfg-legend-key.star { color: var(--text-primary); background: transparent; font-size: 14px; padding: 0 4px; min-width: 24px; }
 .cfg-legend-key.qs { background: rgba(95,199,122,0.18); color: #6fd789; border: 1px solid rgba(95,199,122,0.35); }
 .cfg-legend-key.wb { background: rgba(96,168,255,0.16); color: #7fb6ff; border: 1px solid rgba(96,168,255,0.40); }
 .cfg-legend-key.mto { background: rgba(255,159,28,0.16); color: #ffb14d; border: 1px solid rgba(255,159,28,0.40); }
 .cfg-legend-val { color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.10em; font-size: 10px; }
 .cfg-col-optional-flex { display: flex; flex-direction: column; height: 100%; }
 .cfg-col-optional-flex .cfg-fields { flex: 1; }
 /* CFG-5 · Legend floor: makes left column a flex-column so the legend's
 margin-top:auto pushes its bottom edge flush with the bottom of the
 opposite column. Override align-self so legend stays left-aligned
 instead of jumping to the right cross-axis edge. */
 .cfg-col-legend-floor { display: flex; flex-direction: column; height: 100%; }
 .cfg-col-legend-floor > .cfg-legend { align-self: flex-start; }
 @media (max-width: 1100px) {
 .cfg-body { grid-template-columns: 1fr; }

 .cfg-spec-grid { grid-template-columns: repeat(2, 1fr); }
 .cfg-spec-cell:nth-child(2n) { border-right: none; }
 .cfg-spec-cell:nth-child(n+3) { border-top: 1px solid var(--line); }
 }
 @media (max-width: 720px) {
 .cfg-fields { grid-template-columns: 1fr; }
 .cfg-spec-grid { grid-template-columns: 1fr; }
 .cfg-spec-cell { border-right: none; }
 .cfg-spec-cell:nth-child(n+2) { border-top: 1px solid var(--line); }
 .cfg-title { font-size: 28px; }
 }

 /* ============================================================================
 SECTION 8 — Engineered Accessories (filterable card grid → modal)
 Guardian datasheet accessories: DSS, WG, EM07, EM20, 10SP-277, 20SP-277.
 ============================================================================ */
 .acc-section {
 background: var(--bg-page);
 padding: 88px 0 96px;
 border-top: 1px solid var(--line);
 border-bottom: 1px solid var(--line);
 }
 .acc-inner { max-width: 1400px; margin: 0 auto; padding: 0 32px; }
 .acc-head { text-align: center; margin-bottom: 36px; }
 .acc-eyebrow {
 font-family: 'JetBrains Mono', monospace;
 font-size: 11px;
 letter-spacing: 0.18em;
 color: var(--brand-red);
 text-transform: uppercase;
 margin-bottom: 14px;
 display: inline-flex;
 align-items: center;
 gap: 12px;
 }
 .acc-eyebrow::before, .acc-eyebrow::after {
 content: ""; display: block; width: 28px; height: 1px; background: var(--brand-red);
 }
 .acc-title {
 font-size: 38px;
 font-weight: 700;
 letter-spacing: -0.005em;
 margin-bottom: 12px;
 line-height: 1.05;
 }
 .acc-sub {
 font-size: 15px;
 color: var(--text-secondary);
 max-width: 720px;
 margin: 0 auto;
 line-height: 1.6;
 }
 .acc-pills {
 display: flex;
 justify-content: center;
 flex-wrap: wrap;
 gap: 8px;
 margin: 32px auto 40px;
 max-width: 1100px;
 }
 .acc-pill {
 display: inline-flex;
 align-items: center;
 gap: 8px;
 background: transparent;
 border: 1px solid var(--line-medium);
 color: var(--text-secondary);
 padding: 9px 16px;
 font-family: 'JetBrains Mono', monospace;
 font-size: 11px;
 font-weight: 700;
 letter-spacing: 0.06em;
 text-transform: uppercase;
 cursor: pointer;
 border-radius: 2px;
 transition: all 0.18s;
 }
 .acc-pill:hover { color: var(--text-primary); border-color: var(--text-primary); }
 .acc-pill.active { background: var(--brand-red); border-color: var(--brand-red); color: white; }
 .acc-pill .acc-pill-count {
 font-size: 10px;
 font-weight: 600;
 opacity: 0.75;
 padding: 1px 6px;
 border-radius: 8px;
 background: rgba(255,255,255,0.10);
 letter-spacing: 0.04em;
 }
 .acc-pill.active .acc-pill-count { background: rgba(0,0,0,0.22); opacity: 1; }
 /* CFG-LAYOUT-2: Section 8b Accessories renders 5-up at desktop matching
 Illuminator-canonical (mockup_illuminator_pdp_v2.html lines 1586-1590).
 Heritage's Section 8b carries 28 acc-cards in a 6-category pill ladder —
 wraps to ~6 rows of 5 at desktop. Section 8 #inboxGrid (3 cards: optic +
 driver + receptacle) overrides to 3-up per CFG-LAYOUT-1, see #inboxGrid
 rule below. */
 .acc-grid {
 display: grid;
 grid-template-columns: repeat(5, 1fr);
 gap: 18px;
 }
 /* CFG-LAYOUT-1: Section 8 In-the-Box renders 3-up — keeps the canonical
 in-the-box density (Optic + Driver + Receptacle). Without this, the
 3 cards would left-justify in the 5-col base grid. */
 #inboxGrid { grid-template-columns: repeat(3, 1fr); }
 .acc-card {
 background: var(--bg-spec);
 border: 1px solid var(--line);
 border-radius: 4px;
 cursor: pointer;
 display: flex;
 flex-direction: column;
 overflow: hidden;
 transition: border-color 0.2s, transform 0.2s;
 text-align: left;
 width: 100%;
 color: inherit;
 font-family: inherit;
 padding: 0;
 }
 .acc-card:hover { border-color: var(--brand-red); transform: translateY(-2px); }
 .acc-card.is-hidden { display: none; }
 .acc-card-img {
 background: var(--bg-darker);
 height: 168px;
 display: flex;
 align-items: center;
 justify-content: center;
 border-bottom: 1px solid var(--line);
 position: relative;
 overflow: hidden;
 }
 .acc-card-img svg { width: 64%; height: 64%; color: rgba(255,255,255,0.55); }
 .acc-card-img .acc-card-photo {
 max-width: 86%;
 max-height: 86%;
 width: auto;
 height: auto;
 object-fit: contain;
 filter: drop-shadow(0 8px 14px rgba(0,0,0,0.5));
 }
 .acc-card-img-tag {
 position: absolute;
 top: 10px;
 left: 10px;
 z-index: 2;
 background: rgba(0,0,0,0.55);
 color: rgba(255,255,255,0.85);
 font-family: 'JetBrains Mono', monospace;
 font-size: 9px;
 letter-spacing: 0.12em;
 text-transform: uppercase;
 padding: 4px 8px;
 border-radius: 2px;
 border: 1px solid rgba(255,255,255,0.10);
 }
 .acc-card-body {
 padding: 16px 16px 18px;
 display: flex;
 flex-direction: column;
 flex: 1;
 gap: 10px;
 }
 .acc-card-cat {
 font-family: 'JetBrains Mono', monospace;
 font-size: 9.5px;
 font-weight: 700;

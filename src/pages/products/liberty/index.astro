 max-width: 720px; margin: 0 auto; line-height: 1.6;
 }

 .docs-grid {
 display: grid; grid-template-columns: repeat(4, 1fr);
 gap: 18px; margin-bottom: 32px;
 }
 .docs-card {
 background: var(--bg-spec); border: 1px solid var(--line);
 border-radius: 4px; padding: 28px 24px 24px;
 display: flex; flex-direction: column; gap: 14px;
 cursor: pointer; text-decoration: none; color: inherit;
 transition: border-color 0.2s, transform 0.2s, background 0.2s;
 position: relative; overflow: hidden;
 }
 .docs-card::before {
 content: ""; position: absolute; top: 0; left: 0;
 height: 3px; width: 0; background: var(--brand-red);
 transition: width 0.25s ease;
 }
 .docs-card:hover {
 border-color: rgba(243,39,64,0.45);
 transform: translateY(-2px); background: #2e3239;
 }
 .docs-card:hover::before { width: 100%; }

 .docs-card-head {
 display: flex; align-items: flex-start;
 justify-content: space-between; gap: 14px;
 }
 .docs-card-icon {
 width: 56px; height: 56px;
 border-radius: 4px;
 background: rgba(243,39,64,0.10);
 border: 1px solid rgba(243,39,64,0.30);
 color: var(--brand-red);
 display: flex; align-items: center; justify-content: center;
 flex-shrink: 0;
 }
 .docs-card-icon svg { width: 28px; height: 28px; }
 .docs-card-meta { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
 .docs-card-format {
 font-family: 'JetBrains Mono', monospace;
 font-size: 9.5px; font-weight: 700;
 letter-spacing: 0.14em; text-transform: uppercase;
 color: var(--text-muted);
 background: rgba(255,255,255,0.04);
 border: 1px solid var(--line-medium);
 padding: 3px 8px; border-radius: 1px;
 }
 .docs-card-size {
 font-family: 'JetBrains Mono', monospace;
 font-size: 10px; color: var(--text-muted); letter-spacing: 0.06em;
 }

 .docs-card-title {
 font-size: 18px; font-weight: 700;
 color: var(--text-primary); line-height: 1.25;
 letter-spacing: -0.005em;
 }
 .docs-card-desc {
 font-size: 13.5px; color: var(--text-secondary);
 line-height: 1.55; flex: 1;
 }
 .docs-card-foot {
 display: flex; align-items: center; justify-content: space-between;
 margin-top: 6px; padding-top: 14px;
 border-top: 1px solid var(--line);
 }
 .docs-card-cta {
 font-family: 'JetBrains Mono', monospace;
 font-size: 11px; font-weight: 700;
 letter-spacing: 0.10em; text-transform: uppercase;
 color: var(--brand-red);
 display: inline-flex; align-items: center; gap: 8px;
 transition: gap 0.18s;
 }
 .docs-card:hover .docs-card-cta { gap: 12px; }
 .docs-card-cta svg { width: 14px; height: 14px; }
 .docs-card-updated {
 font-family: 'JetBrains Mono', monospace;
 font-size: 9.5px; color: var(--text-muted); letter-spacing: 0.06em;
 }

 .docs-secondary {
 background: var(--bg-spec); border: 1px solid var(--line);
 border-radius: 4px; padding: 20px 24px;
 display: grid; grid-template-columns: auto 1fr;
 gap: 10px 28px; align-items: center;
 }
 .docs-secondary-label {
 font-family: 'JetBrains Mono', monospace;
 font-size: 10.5px; letter-spacing: 0.16em;
 text-transform: uppercase; color: var(--brand-red);
 font-weight: 700; white-space: nowrap;
 }
 .docs-secondary-links { display: flex; flex-wrap: wrap; gap: 6px 22px; }
 .docs-secondary-link {
 display: inline-flex; align-items: center; gap: 8px;
 color: var(--text-secondary); font-size: 13px; font-weight: 600;
 transition: color 0.18s; white-space: nowrap; cursor: pointer;
 text-decoration: none;
 }
 .docs-secondary-link:hover { color: var(--brand-red); }
 .docs-secondary-link svg {
 width: 14px; height: 14px;
 color: var(--text-muted); transition: color 0.18s;
 }
 .docs-secondary-link:hover svg { color: var(--brand-red); }

 @media (max-width: 1280px) { .docs-grid { grid-template-columns: repeat(2, 1fr); } }
 @media (max-width: 1100px) { .docs-secondary { grid-template-columns: 1fr; gap: 10px; } }
 @media (max-width: 720px) { .docs-grid { grid-template-columns: 1fr; } }
 /* 4-card grid resolves to 4 → 2 → 1 across breakpoints — matches the 3-card
 pattern from Atlanta but adds the IES Bundle as a peer of Datasheet
 after James 2026-05-02 elevated it from quick-link to primary card. */

 /* ============================================================================
 SECTION 11 — Wall Pack Family (direct siblings within the LWPF Wall Pack line).
 CSS lifted from Sentinel Section 10 — kept identical for visual consistency.
 Guardian uses a 4-card grid (Anaheim · Sentinel · Guardian · Nightwatch) so
 the SLIM positioning sits directly next to its CLASSIC counterpart.
 ============================================================================ */
 .wp-family-section {
 background: var(--bg-page);
 padding: 88px 0 96px;
 border-top: 1px solid var(--line);
 border-bottom: 1px solid var(--line);
 }
 .wp-family-inner { max-width: 1400px; margin: 0 auto; padding: 0 32px; }
 .wp-family-head { text-align: center; margin-bottom: 40px; }
 .wp-family-grid {
 display: grid;
 grid-template-columns: repeat(4, 1fr);
 gap: 18px;
 margin-top: 40px;
 }
 /* lspl-family-* — canonical Illuminator inner/head/grid for §11 Family.
 Markup uses .wp-family-section as the outer + .lspl-family-* for inners. */
 .lspl-family-inner {
 max-width: 1400px;
 margin: 0 auto;
 padding: 0 32px;
 }
 .lspl-family-head { text-align: center; margin-bottom: 40px; }
 .lspl-family-grid {
 display: grid;
 grid-template-columns: repeat(3, 1fr);
 gap: 18px;
 margin-top: 40px;
 }
 .wp-family-eyebrow {
 font-family: 'JetBrains Mono', monospace;
 font-size: 11px; letter-spacing: 0.18em;
 color: var(--brand-red); text-transform: uppercase;
 margin-bottom: 14px;
 display: inline-flex; align-items: center; gap: 12px;
 }
 .wp-family-eyebrow::before, .wp-family-eyebrow::after {
 content: ""; display: block; width: 28px; height: 1px; background: var(--brand-red);
 }
 .wp-family-title {
 font-size: 38px; font-weight: 700;
 letter-spacing: -0.005em; margin-bottom: 12px; line-height: 1.05;
 }
 .wp-family-sub {
 font-size: 15px; color: var(--text-secondary);
 max-width: 720px; margin: 0 auto; line-height: 1.6;
 }

 .family-card {
 background: var(--bg-spec);
 border: 1px solid var(--line);
 border-radius: 4px;
 text-decoration: none; color: inherit;
 overflow: hidden;
 display: flex; flex-direction: column;
 transition: border-color 0.2s, transform 0.2s;
 }
 .family-card:hover {
 border-color: rgba(243,39,64,0.45);
 transform: translateY(-3px);
 }
 .family-card-img {
 background: var(--bg-darker);
 height: 160px;
 display: flex; align-items: center; justify-content: center;
 border-bottom: 1px solid var(--line);
 color: rgba(255,255,255,0.65);
 position: relative;
 }
 .family-card-img svg { width: 60%; height: 60%; max-width: 130px; }
 /* Real product photo inside .family-card-img — fits without resizing the box. */
 .family-card-img .family-card-photo {
 max-width: 88%;
 max-height: 88%;
 width: auto;
 height: auto;
 object-fit: contain;
 filter: drop-shadow(0 8px 14px rgba(0,0,0,0.5));
 }
 .family-card-img .family-card-photo {
 max-width: 88%; max-height: 88%;
 width: auto; height: auto;
 object-fit: contain;
 filter: drop-shadow(0 8px 14px rgba(0,0,0,0.5));
 }
 .family-card-tag {
 position: absolute; top: 12px; left: 12px;
 z-index: 2;
 font-family: 'JetBrains Mono', monospace;
 font-size: 9px; font-weight: 700;
 letter-spacing: 0.14em; text-transform: uppercase;
 color: rgba(255,255,255,0.85);
 background: rgba(0,0,0,0.55);
 border: 1px solid rgba(255,255,255,0.10);
 padding: 4px 8px; border-radius: 1px;
 }
 .family-card-body {
 padding: 20px 22px 22px;
 display: flex; flex-direction: column;
 gap: 10px; flex: 1;
 }
 .family-card-cat {
 font-family: 'JetBrains Mono', monospace;
 font-size: 9.5px; font-weight: 700;
 letter-spacing: 0.14em; text-transform: uppercase;
 color: var(--brand-red);
 display: flex; align-items: center; gap: 8px;
 }
 .family-card-title {
 font-size: 19px; font-weight: 700;
 color: var(--text-primary);
 line-height: 1.2; letter-spacing: -0.005em;
 }
 .family-card-desc {
 font-size: 13px; color: var(--text-secondary);
 line-height: 1.55; flex: 1;
 }
 .family-card-stats {
 font-family: 'JetBrains Mono', monospace;
 font-size: 10px; letter-spacing: 0.06em;
 color: var(--text-muted); line-height: 1.5;
 border-top: 1px solid var(--line);
 padding-top: 12px; margin-top: 4px;
 }
 .family-card-cta {
 font-family: 'JetBrains Mono', monospace;
 font-size: 10.5px; font-weight: 700;
 letter-spacing: 0.10em; text-transform: uppercase;
 color: var(--text-secondary);
 display: inline-flex; align-items: center; gap: 6px;
 margin-top: 4px;
 transition: color 0.18s, gap 0.18s;
 }
 .family-card:hover .family-card-cta { color: var(--brand-red); gap: 10px; }

 /* "You are here" current-product card — visually distinct, not clickable */
 .family-card.is-current {
 background: linear-gradient(135deg, rgba(243,39,64,0.08) 0%, var(--bg-spec) 60%);
 border-color: rgba(243,39,64,0.45);
 cursor: default;
 pointer-events: none;
 }
 .family-card.is-current .family-card-img { background: rgba(243,39,64,0.06); }
 .family-card-here-badge {
 position: absolute;
 top: 12px; right: 12px;
 z-index: 2;
 font-family: 'JetBrains Mono', monospace;
 font-size: 9px; font-weight: 700;
 letter-spacing: 0.16em; text-transform: uppercase;
 color: white; background: var(--brand-red);
 padding: 4px 9px; border-radius: 1px;
 }
 .family-card.is-current .family-card-cta {
 color: var(--brand-red);
 pointer-events: none;
 }

 @media (max-width: 1280px) {
 .wp-family-grid { grid-template-columns: repeat(2, 1fr); }
 .wp-family-grid .family-card.is-current { grid-column: 1 / -1; }
 }
 @media (max-width: 720px) {
 .wp-family-grid { grid-template-columns: 1fr; }
 }

 /* ============================================================================
 SECTION 12 — Page closer (Round Out the Project · Support · Great Rebates ·
 final red CTA strip). Three layered components in one section, lifted from
 Sentinel Section 11 — visual + interaction parity across PDPs.
 ============================================================================ */
 .closing-section {
 background: var(--bg-page);
 padding: 88px 0 0;
 border-top: 1px solid var(--line);
 }
 .closing-inner { max-width: 1400px; margin: 0 auto; padding: 0 32px; }

 /* 12A — Round Out the Project */
 .closing-family { padding-bottom: 72px; }
 .closing-family-head { text-align: center; margin-bottom: 40px; }
 .closing-eyebrow {
 font-family: 'JetBrains Mono', monospace;
 font-size: 11px; letter-spacing: 0.18em;
 color: var(--brand-red); text-transform: uppercase;
 margin-bottom: 14px;
 display: inline-flex; align-items: center; gap: 12px;
 }
 .closing-eyebrow::before, .closing-eyebrow::after {
 content: ""; display: block; width: 28px; height: 1px; background: var(--brand-red);
 }
 .closing-title {
 font-size: 38px; font-weight: 700;
 letter-spacing: -0.005em; margin-bottom: 12px; line-height: 1.05;
 }
 .closing-sub {
 font-size: 15px; color: var(--text-secondary);
 max-width: 720px; margin: 0 auto; line-height: 1.6;
 }
 .closing-family-grid {
 display: grid;
 grid-template-columns: repeat(4, 1fr);
 gap: 18px;
 margin-top: 40px;
 }

 /* 12B — Support + Rebates 2-up pillars */
 .closing-pillars {
 display: grid;
 grid-template-columns: 1fr 1fr;
 gap: 18px;
 padding-bottom: 72px;
 border-top: 1px solid var(--line);
 padding-top: 64px;
 }
 .pillar {
 background: var(--bg-spec); border: 1px solid var(--line);
 border-radius: 4px; padding: 36px 36px 32px;
 display: flex; flex-direction: column; gap: 18px;
 position: relative; overflow: hidden;
 }
 .pillar-rebates {
 background: linear-gradient(135deg, #2c2118 0%, var(--bg-spec) 60%);
 border-color: rgba(243,39,64,0.20);
 }
 .pillar-icon {
 width: 52px; height: 52px;
 border-radius: 4px;
 background: rgba(243,39,64,0.10);
 border: 1px solid rgba(243,39,64,0.30);
 color: var(--brand-red);
 display: flex; align-items: center; justify-content: center;
 }
 .pillar-icon svg { width: 26px; height: 26px; }
 .pillar-eyebrow {
 font-family: 'JetBrains Mono', monospace;
 font-size: 10.5px; letter-spacing: 0.18em;
 color: var(--brand-red); text-transform: uppercase;
 font-weight: 700;
 }
 .pillar-title {
 font-size: 26px; font-weight: 700;
 color: var(--text-primary); line-height: 1.15;
 letter-spacing: -0.005em;
 }
 .pillar-body {
 font-size: 14.5px; color: var(--text-secondary);
 line-height: 1.65;
 }
 .pillar-stats {
 display: flex; flex-wrap: wrap; gap: 0;
 border-top: 1px solid var(--line);
 border-bottom: 1px solid var(--line);
 padding: 16px 0; margin: 4px 0;
 }
 .pillar-stat {
 flex: 1; min-width: 120px;
 padding: 0 16px; border-right: 1px solid var(--line);
 }
 .pillar-stat:first-child { padding-left: 0; }
 .pillar-stat:last-child { border-right: none; padding-right: 0; }
 .pillar-stat-num {
 font-size: 22px; font-weight: 700;
 color: var(--text-primary);
 letter-spacing: -0.01em; line-height: 1.1;
 white-space: nowrap;
 }
 .pillar-stat:last-child .pillar-stat-num { font-size: 18px; }
 .pillar-stat-key {
 font-family: 'JetBrains Mono', monospace;
 font-size: 9.5px; letter-spacing: 0.14em;
 color: var(--text-muted);
 text-transform: uppercase;
 margin-top: 4px;
 }
 .pillar-ctas {
 display: flex; gap: 10px; flex-wrap: wrap;
 margin-top: 4px;
 }
 .pillar-cta {
 flex: 1; min-width: 150px;
 display: inline-flex; align-items: center; justify-content: center;
 gap: 8px;
 padding: 13px 20px;
 border-radius: 2px;
 font-family: 'JetBrains Mono', monospace;
 font-size: 11px; font-weight: 700;
 letter-spacing: 0.10em; text-transform: uppercase;
 cursor: pointer;
 transition: all 0.18s;
 border: 1px solid transparent;
 text-decoration: none;
 white-space: nowrap;
 }
 .pillar-cta.primary { background: var(--brand-red); color: white; }
 .pillar-cta.primary:hover { background: var(--brand-red-deep); }
 .pillar-cta.outline {
 background: transparent;
 color: var(--text-secondary);
 border-color: var(--line-medium);
 }
 .pillar-cta.outline:hover { color: var(--text-primary); border-color: var(--text-primary); }
 .pillar-cta svg { width: 14px; height: 14px; }

 /* 12C — Final red CTA strip */
 .closing-cta-strip {
 background: var(--brand-red); color: white;
 padding: 22px 32px;
 display: flex; align-items: center; justify-content: space-between;
 gap: 24px; flex-wrap: wrap;
 }
 .closing-cta-strip-inner {
 max-width: 1400px; margin: 0 auto; width: 100%;
 display: flex; align-items: center; justify-content: space-between;
 gap: 24px; flex-wrap: wrap;
 }
 .closing-cta-msg { font-size: 16px; line-height: 1.4; }
 .closing-cta-msg strong { font-weight: 700; }
 .closing-cta-buttons { display: flex; gap: 10px; flex-wrap: wrap; }
 .closing-cta-btn {
 display: inline-flex; align-items: center; justify-content: center;
 gap: 8px; padding: 13px 22px;
 border: 1.5px solid white; color: white;
 background: transparent; border-radius: 2px;
 font-family: 'JetBrains Mono', monospace;
 font-size: 11px; font-weight: 700;
 letter-spacing: 0.12em; text-transform: uppercase;
 cursor: pointer; transition: all 0.18s;
 text-decoration: none; white-space: nowrap;
 }
 .closing-cta-btn:hover { background: white; color: var(--brand-red); }
 .closing-cta-btn.solid { background: white; color: var(--brand-red); }
 .closing-cta-btn.solid:hover { background: rgba(255,255,255,0.92); }

 @media (max-width: 1100px) {
 .closing-family-grid { grid-template-columns: repeat(2, 1fr); }
 .closing-pillars { grid-template-columns: 1fr; }
 }
 @media (max-width: 720px) {
 .closing-family-grid { grid-template-columns: 1fr; }
 .closing-title { font-size: 28px; }
 .pillar-title { font-size: 22px; }
 .closing-cta-strip-inner { flex-direction: column; align-items: flex-start; }
 }

 /* === PLAYBOOK LESSON #4 · force Lato on h1/h2 to override theme global serif === */
 .liberty-pdp h1, .liberty-pdp h2,
 body.liberty-pdp h1, body.liberty-pdp h2 {
 font-family: 'Lato', system-ui, -apple-system, BlinkMacSystemFont, sans-serif !important;
 font-weight: 700;
 }


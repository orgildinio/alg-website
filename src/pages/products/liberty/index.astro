<script is:inline>
/* =============================================================================
 SECTION 9 . Liberty Configurator
 Builds: LSBX{wattage}-3CS-{voltage}L{finish}[/TAA][/{mount}][/{optic}]
 [/{photocell}][/{sensor}][/{shield}]
 Per playbook: CFG-1 (submittal CTA), CFG-3 (chip badges), CFG-5/5a (share link),
 CFG-COPY-3 density, CFG-STATE-1 ship-tier derivation.
 ============================================================================= */
(function() {
 'use strict';

 // RAL Classic legal validator (CFG-3 . subset of common 4-digit RAL codes)
 var RAL_VALID = new Set([
 1000, 1001, 1002, 1003, 1004, 1005, 1006, 1007, 1011, 1012, 1013, 1014, 1015, 1016, 1017, 1018, 1019, 1020, 1021, 1023, 1024, 1027, 1028, 1032, 1033, 1034,
 2000, 2001, 2002, 2003, 2004, 2008, 2009, 2010, 2011, 2012,
 3000, 3001, 3002, 3003, 3004, 3005, 3007, 3009, 3011, 3012, 3013, 3014, 3015, 3016, 3017, 3018, 3020, 3022, 3027, 3031,
 4001, 4002, 4003, 4004, 4005, 4006, 4007, 4008, 4009,
 5000, 5001, 5002, 5003, 5004, 5005, 5007, 5008, 5009, 5010, 5011, 5012, 5013, 5014, 5015, 5017, 5018, 5019, 5020, 5021, 5022, 5023, 5024,
 6000, 6001, 6002, 6003, 6004, 6005, 6006, 6007, 6008, 6009, 6010, 6011, 6012, 6013, 6014, 6015, 6016, 6017, 6018, 6019, 6020, 6021, 6022, 6024, 6025, 6026, 6027, 6028, 6029, 6032, 6033, 6034,
 7000, 7001, 7002, 7003, 7004, 7005, 7006, 7008, 7009, 7010, 7011, 7012, 7013, 7015, 7016, 7021, 7022, 7023, 7024, 7026, 7030, 7031, 7032, 7033, 7034, 7035, 7036, 7037, 7038, 7039, 7040, 7042, 7043, 7044, 7045, 7046, 7047,
 8000, 8001, 8002, 8003, 8004, 8007, 8008, 8011, 8012, 8014, 8015, 8016, 8017, 8019, 8022, 8023, 8024, 8025, 8028,
 9001, 9002, 9003, 9004, 9005, 9006, 9007, 9010, 9011, 9016, 9017, 9018
 ]);

 // ===============================================================
 // CFG-STATE-2 . Live Zoho stock map (2026-05-18 snapshot)
 // ---------------------------------------------------------------
 // stock_on_hand for the 43 LSBX-L1/* accessory SKUs that drive the
 // QS/MTO chip badges. Pulled live from Zoho Books org 729902814.
 // > 0 -> QS (in-stock). === 0 -> MTO (made-to-order).
 // ===============================================================
 var ACC_STOCK = {
 'LSBX-L1/HVD/100': 0, 'LSBX-L1/HVD/150': 0, 'LSBX-L1/HVD/200': 96,
 'LSBX-L1/HVD/300': 94, 'LSBX-L1/HVD/450': 99,
 'LSBX-L1/OT2/100': 0, 'LSBX-L1/OT2/200': 0, 'LSBX-L1/OT2/300': 0, 'LSBX-L1/OT2/450': 0,
 'LSBX-L1/OT3/200': 0, 'LSBX-L1/OT3/300': 0, 'LSBX-L1/OT3/450': 0,
 'LSBX-L1/OT4/100': 29, 'LSBX-L1/OT4/200': 28, 'LSBX-L1/OT4/300': 31, 'LSBX-L1/OT4/450': 0,
 'LSBX-L1/OT5/100': 102, 'LSBX-L1/OT5/200': 114, 'LSBX-L1/OT5/300': 109, 'LSBX-L1/OT5/450': 6,
 'LSBX-L1/PCS/HM3': 0, 'LSBX-L1/PCS/UM3': 725, 'LSBX-L1/PCS/UM7': 0,
 'LSBX-L1/RS': 0, 'LSBX-L1/RS/450': 0,
 'LSBX-L1/S100/BK': 125, 'LSBX-L1/S100/DB': 84,
 'LSBX-L1/S200/BK': 0, 'LSBX-L1/S200/DB': 93,
 'LSBX-L1/S300/BK': 0, 'LSBX-L1/S300/DB': 187,
 'LSBX-L1/S450/BK': 0, 'LSBX-L1/S450/DB': 104,
 'LSBX-L1/SF': 9, 'LSBX-L1/TN': 91,
 'LSBX-L1/UA/BK': 0, 'LSBX-L1/UA/DB': 0,
 'LSBX-L1/UA/BK/450': 0, 'LSBX-L1/UA/DB/450': 100,
 'LSBX-L1/UVD/100': 0, 'LSBX-L1/UVD/150': 0, 'LSBX-L1/UVD/200': 0,
 'LSBX-L1/UVD/300': 0, 'LSBX-L1/UVD/450': 0
 };

 // Wattage-to-SKU-suffix lookup. Most accessory families (OT*, S*) have NO
 // /150 variant - 150W rolls under <200W chassis and uses the /200 SKU.
 // Drivers (HVD, UVD) DO have explicit /150 SKUs so use a separate map.
 function wattForAccessory(h) {
 return ({'100':'100','150':'200','200':'200','300':'300','450':'450'})[String(h)] || '200';
 }
 function wattForDriver(h) {
 return ({'100':'100','150':'150','200':'200','300':'300','450':'450'})[String(h)] || '150';
 }

 /**
 * Map a chip (field+val) -> live Zoho SKU based on current housing + finish.
 * Returns null when the chip is a built-in default (no SKU lookup needed)
 * or when the chip doesn't appear in the 43-SKU accessory list.
 */
 function chipToSku(field, val, housing, finish) {
 var w = wattForAccessory(housing);
 var wd = wattForDriver(housing);
 var finCode = (finish === 'B') ? 'BK' : 'DB'; // any non-Black finish maps to DB tooling
 switch (field) {
 case 'voltage':
 // U = built-in Universal driver (no separate SKU tracked). H = HVD/wattage.
 return (val === 'U') ? null : 'LSBX-L1/HVD/' + wd;
 case 'optic':
 if (val === 'T3' || !val) return null; // factory-installed default
 return 'LSBX-L1/' + val + '/' + w;
 case 'mount':
 if (!val) return null; // None mount
 if (val === 'SF' || val === 'TN') return 'LSBX-L1/' + val;
 if (val === 'RS') return (String(housing) === '450') ? 'LSBX-L1/RS/450' : 'LSBX-L1/RS';
 // /UA Universal mount - hard override per James 2026-05-18: always QS regardless
 // of Zoho stock_on_hand. Handled by FORCE_QS_CHIPS below; return null here so
 // the dynamic lookup skips this chip and the FORCE block sets the badge.
 if (val === 'UA') return null;
 return null;
 case 'photocell':
 return val ? 'LSBX-L1/PCS/' + val : null;
 case 'shield':
 // data-val is "S100-DB" / "S200-DB" / etc. Parse size + finish.
 var m = val && val.match(/^S(\d+)-(\w+)$/);
 return m ? 'LSBX-L1/S' + m[1] + '/' + m[2] : null;
 // Fields NOT in the 43-SKU accessory list - keep static badge.
 // (housing, cct, finish, taa, sensor, surge - controlled separately)
 }
 return null;
 }

 /**
 * Hard QS overrides - chips that should ALWAYS render QS regardless of the
 * live Zoho stock_on_hand value. Per James 2026-05-18:
 * mount/UA - Universal mount is always QS (per James, regardless of Zoho
 * showing 0 stock on /UA/BK + /UA/DB for 100-300W housings).
 * Keyed by "field:val".
 */
 var FORCE_QS_CHIPS = { 'mount:UA': true };

 function setBadge(chip, cls) {
 // CFG-CFG-1 (2026-05-18 PM): stock state now lives on the 3px-wide
 // `.cfg-chip-stripe` left-edge element, not a `.cfg-chip-stock` text
 // badge. Update the stripe class; the old badge (if any) gets the
 // same class for backward-compat with any QC scripts that grep for it.
 var stripe = chip.querySelector('.cfg-chip-stripe');
 if (stripe) {
 stripe.classList.remove('qs', 'mto', 'wb');
 stripe.classList.add(cls);
 }
 var badge = chip.querySelector('.cfg-chip-stock');
 if (badge) {
 badge.classList.remove('qs', 'mto', 'wb');
 badge.classList.add(cls);
 badge.textContent = (cls === 'qs') ? 'QS' : (cls === 'mto') ? 'MTO' : 'WB';
 }
 }

 /**
 * Recompute QS/MTO badge on every chip that has a dynamic SKU mapping
 * or a hard override. Called from refresh() so any housing/finish change
 * cascades.
 */
 function refreshChipBadges() {
 var housing = state.housing;
 var finish = state.finish;
 document.querySelectorAll('#configurator .cfg-chip[data-field]').forEach(function(chip) {
 var field = chip.dataset.field;
 var val = chip.dataset.val;

 // 1. Hard override - always QS, no Zoho lookup
 if (FORCE_QS_CHIPS[field + ':' + val]) {
 setBadge(chip, 'qs');
 chip.setAttribute('data-resolved-sku', '(force-QS . per James 2026-05-18)');
 return;
 }

 // 2. Dynamic SKU lookup against live Zoho ACC_STOCK
 var sku = chipToSku(field, val, housing, finish);
 if (!sku) return; // static badge stays
 var stock = ACC_STOCK[sku];
 if (typeof stock !== 'number') return; // SKU missing - leave alone
 setBadge(chip, (stock > 0) ? 'qs' : 'mto');
 chip.setAttribute('data-resolved-sku', sku); // attribute aids DOM debugging
 });
 }

 // State - field names match the canonical HTML data-field attributes
 // (housing/cct/voltage/optic/finish/mount/taa + 4 optional add-ons).
 // Default 150W per LSBX datasheet - the volume housing class.
 var state = {
 housing: '150', cct: '3CS', voltage: 'U', optic: 'T3', finish: 'D', mount: '', taa: 'STD',
 photocell: '', sensor: '', shield: '', surge: '', ral: '', adapter: ''
 };

 // Hydrate from URL on load (CFG-5/5a)
 function hydrateFromUrl() {
 var params = new URLSearchParams(window.location.search);
 Object.keys(state).forEach(function(k) {
 if (params.has(k)) state[k] = params.get(k);
 });
 }

 // Build SKU from state . LSBX{N}-3CS-{V}L{FIN}[/TAA][/MOUNT][/OPT][/PC][/SENS][/SH][/SURGE]
 function buildSku() {
 var sku = 'LSBX' + state.housing + '-3CS-' + state.voltage + 'L' + state.finish;
 if (state.finish === 'RAL' && state.ral && RAL_VALID.has(parseInt(state.ral.replace(/\D/g, ''), 10))) {
 sku = 'LSBX' + state.housing + '-3CS-' + state.voltage + 'L-RAL' + state.ral.replace(/\D/g, '');
 }
 if (state.taa && state.taa !== 'STD') sku += '/' + state.taa;
 if (state.mount) sku += '/' + state.mount;
 if (state.optic && state.optic !== 'T3') sku += '/' + state.optic;
 if (state.photocell) sku += '/' + state.photocell;
 if (state.sensor) sku += '/' + state.sensor;
 if (state.shield) sku += '/' + state.shield;
 if (state.surge) sku += '/' + state.surge;
 if (state.adapter) sku += ' + ' + state.adapter; // tenon/bullhorn ships as a separate companion SKU
 return sku;
 }

 // CFG-STATE-1 . Derive ship tier from chip selections
 function deriveShipTier() {
 if (state.finish === 'RAL' && state.ral) {
 return { code: 'WB', label: 'Workbench Assembly (Custom RAL)', cls: 'wb' };
 }
 var fields = ['housing', 'voltage', 'finish', 'taa', 'mount', 'optic', 'photocell', 'sensor', 'shield', 'surge'];
 var anyMto = false;
 fields.forEach(function(f) {
 var btn = document.querySelector('.cfg-chip.selected[data-field="' + f + '"]');
 if (btn) {
 // CFG-CFG-1 (2026-05-18 PM): stock state moved from .cfg-chip-stock
 // text badge -> .cfg-chip-stripe left-edge stripe. Check both for
 // backward-compat during the transition.
 if (btn.querySelector('.cfg-chip-stripe.mto')) anyMto = true;
 if (btn.querySelector('.cfg-chip-stripe.wb')) anyMto = true;
 if (btn.querySelector('.cfg-chip-stock.mto')) anyMto = true;
 if (btn.querySelector('.cfg-chip-stock.wb')) anyMto = true;
 }
 });
 if (anyMto) {
 return { code: 'MTO', label: 'Made-to-Order . 4-6 wk lead', cls: 'mto' };
 }
 var anyAdder = (state.taa && state.taa !== 'STD') || state.mount || (state.optic && state.optic !== 'T3') || state.photocell || state.sensor || state.shield || state.surge;
 if (anyAdder) {
 return { code: 'QS-AC', label: 'QuickShip . a-la-carte assembly', cls: 'qs' };
 }
 return { code: 'QS', label: 'QuickShip . catalog SKU . 3-5 day', cls: 'qs' };
 }

 // Render the live SKU + ship-tier + submittal href + spec cells + counter
 function refresh() {
 // CFG-STATE-2: recompute QS/MTO chip badges from the live Zoho stock map
 // BEFORE deriveShipTier() reads them - order matters, because the ship-tier
 // derivation walks selected chips and inspects their .cfg-chip-stock class.
 refreshChipBadges();

 var sku = buildSku();
 var skuEl = document.getElementById('cfgSku');
 if (skuEl) skuEl.textContent = sku;

 var tier = deriveShipTier();
 var tierTextEl = document.getElementById('cfgShipTierText');
 var tierIconEl = document.getElementById('cfgShipTierIcon');
 var tierStockEl = document.getElementById('cfgShipTierStock');
 if (tierTextEl) tierTextEl.textContent = tier.label;
 if (tierStockEl) tierStockEl.textContent = tier.code;
 var tierBand = document.getElementById('cfgShipTier');
 if (tierBand) {
 tierBand.style.background = tier.cls === 'mto' ? 'rgba(255,159,28,0.10)' :
 tier.cls === 'wb' ? 'rgba(176,64,230,0.10)' :
 'rgba(95,199,122,0.10)';
 tierBand.style.borderLeft = '3px solid ' +
 (tier.cls === 'mto' ? '#ffb14d' : tier.cls === 'wb' ? '#c879ff' : '#5fc77a');
 }

 // Update counter - a Required field is "set" when a chip with the matching
 // data-field has a .selected class. The None-default chips (data-val="")
 // still have a chip rendered & selectable, so they count.
 var required = ['housing','cct','voltage','optic','finish','mount','taa'];
 var setCount = required.reduce(function(n, f) {
 return n + (document.querySelector('.cfg-chip.selected[data-field="' + f + '"]') ? 1 : 0);
 }, 0);
 var countEl = document.getElementById('cfgCount');
 if (countEl) countEl.textContent = setCount;

 // Unlock CTAs when all required are set
 var allSet = setCount >= required.length;
 ['cfgCtaPrice','cfgCtaPdf'].forEach(function(id) {
 var el = document.getElementById(id);
 if (el) el.classList.toggle('disabled', !allSet);
 });
 var warnEl = document.getElementById('cfgWarning');
 if (warnEl) warnEl.style.display = allSet ? 'none' : 'block';

 // Update spec cells per current state
 var lumensMap = { '100':'15,400','150':'22,650','200':'29,800','300':'43,800','450':'66,600' };
 var efficacyMap= { '100':'154','150':'151','200':'149','300':'146','450':'148' };
 var peakMap = { '100':'5,048 cd','150':'5,074 cd','200':'7,676 cd','300':'9,768 cd','450':'16,418 cd' };
 var finishMap = { 'D':'Dark Bronze','B':'Black','S':'Silver','W':'White','RAL':'Custom RAL' };
 var opticMap = { '':'Type-III (factory)','T3':'Type-III (factory)','OT2':'Type-II','OT4':'Type-IV','OT5':'Type-V' };
 var voltMap = { 'U':'120-277V','H':'277-480V' };
 var setCell = function(spec, val) {
 var el = document.querySelector('.cfg-spec-cell-val[data-spec="' + spec + '"]');
 if (el) { el.textContent = val; el.classList.toggle('placeholder', !val || val === '-'); }
 };
 setCell('lumens', lumensMap[state.housing] ? lumensMap[state.housing] + ' lm' : '-');
 setCell('lpw', efficacyMap[state.housing]? efficacyMap[state.housing] + ' lm/W' : '-');
 setCell('voltage', voltMap[state.voltage] || '-');
 setCell('optic', opticMap[state.optic] || 'Type-III (factory)');
 setCell('peak', peakMap[state.housing] || '-');
 setCell('finish', finishMap[state.finish] || '-');
 setCell('cct', '3000 . 4000 . 5000K');

 // Submittal link
 var params = new URLSearchParams();
 params.set('product', 'liberty');
 params.set('sku', sku);
 Object.keys(state).forEach(function(k) { if (state[k]) params.set(k, state[k]); });
 var pdfBtn = document.getElementById('cfgCtaPdf');
 if (pdfBtn) pdfBtn.href = 'submittal/?' + params.toString();

 // CFG-CFG-1 (2026-05-18 PM) - sync each row's `.cfg-row-code` label to
 // the selected chip's data-code (or to the adapter select's value).
 syncRowCodes();

 // CFG-CFG-1 (2026-05-18 PM) - RAL input visibility + validity class.
 // Wrap is hidden unless Finish=RAL. When visible, .valid / .invalid is
 // applied based on RAL_VALID set membership.
 syncRalInput();
 }

 /**
 * Show/hide the RAL Classic input based on Finish selection, and apply the
 * .valid / .invalid status class for inline visual feedback.
 * RAL_VALID is the canonical Set of 200+ legal RAL Classic codes (declared
 * near the top of this IIFE). Lookup: parseInt(input, 10) ∈ RAL_VALID.
 */
 function syncRalInput() {
 var wrap = document.getElementById('cfgRalInputWrap');
 var nameEl = document.getElementById('cfgRalName');
 if (!wrap) return;
 if (state.finish !== 'RAL') {
 wrap.style.display = 'none';
 wrap.classList.remove('valid', 'invalid');
 return;
 }
 wrap.style.display = '';
 var raw = (state.ral || '').replace(/\D/g, '');
 if (!raw) {
 wrap.classList.remove('valid', 'invalid');
 return;
 }
 if (raw.length === 4 && RAL_VALID.has(parseInt(raw, 10))) {
 wrap.classList.add('valid');
 wrap.classList.remove('invalid');
 if (nameEl) nameEl.textContent = 'RAL ' + raw;
 } else {
 wrap.classList.add('invalid');
 wrap.classList.remove('valid');
 }
 }

 /**
 * Update the per-row `<span class="cfg-row-code">` next to each label so
 * the user sees the SKU fragment for whichever chip is currently selected.
 * Empty selection -> "-" with is-empty class. CCT row is always populated
 * (locked default).
 */
 function syncRowCodes() {
 document.querySelectorAll('.cfg-row-code[data-field-code]').forEach(function(rc) {
 var field = rc.getAttribute('data-field-code');
 if (field === 'cct') return; // locked-default text stays
 var newText = '-', isEmpty = true;
 if (field === 'adapter') {
 var sel = document.getElementById('cfgAdapterSelect');
 if (sel && sel.value) { newText = '/' + sel.value; isEmpty = false; }
 } else {
 var selChip = document.querySelector('.cfg-chip.selected[data-field="' + field + '"]');
 if (selChip) {
 var code = selChip.getAttribute('data-code') || '';
 if (field === 'finish' && code === 'RAL#') {
 var ralVal = state.ral || '';
 newText = ralVal && /^\d{4}$/.test(ralVal) && RAL_VALID.has(parseInt(ralVal, 10))
 ? '/RAL' + ralVal
 : 'RAL# (enter code below)';
 isEmpty = false;
 } else if (code) {
 // Prefix with "/" for slash-pattern codes (mount, optic, photocell, etc.),
 // leave bare for the upstream-of-slash codes (housing, voltage, finish, etc.)
 var slashPrefixed = ['mount','optic','photocell','sensor','shield','surge','taa'];
 var alreadySlash = code.charAt(0) === '/';
 newText = (slashPrefixed.indexOf(field) >= 0 && !alreadySlash) ? '/' + code : code;
 isEmpty = false;
 } else if (field === 'taa') {
 newText = '(blank)'; isEmpty = false;
 } else if (field === 'mount') {
 newText = '(none)'; isEmpty = false;
 } else if (field === 'optic') {
 newText = '(factory . Type-III)'; isEmpty = false;
 }
 }
 }
 rc.textContent = newText;
 rc.classList.toggle('is-empty', isEmpty);
 });
 }

 // Field selection handler - toggles canonical `.selected` class
 function selectChip(field, val, btn) {
 var siblings = document.querySelectorAll('.cfg-chip[data-field="' + field + '"]');
 siblings.forEach(function(s) { s.classList.remove('selected'); });
 btn.classList.add('selected');
 state[field] = val;
 refresh();
 }

 // Hydrate UI from state - mark the chip whose data-val matches state[field]
 function hydrateUi() {
 Object.keys(state).forEach(function(field) {
 if (field === 'ral') return;
 var val = state[field];
 var siblings = document.querySelectorAll('.cfg-chip[data-field="' + field + '"]');
 siblings.forEach(function(s) { s.classList.remove('selected'); });
 var match = document.querySelector('.cfg-chip[data-field="' + field + '"][data-val="' + val + '"]');
 if (match) match.classList.add('selected');
 });
 var ralInput = document.getElementById('cfgRalInput');
 if (ralInput) ralInput.value = state.ral || '';
 }

 function init() {
 hydrateFromUrl();
 hydrateUi();

 // Wire every chip - single delegated click handler.
 // Locked chips (CCT 3CS) don't fire selectChip . just absorb the click.
 document.querySelectorAll('.cfg-chip[data-field]').forEach(function(btn) {
 btn.addEventListener('click', function(e) {
 e.preventDefault();
 if (btn.classList.contains('locked')) return;
 if (btn.getAttribute('data-disabled') === 'true') return;
 var field = btn.getAttribute('data-field');
 var val = btn.getAttribute('data-val');
 selectChip(field, val, btn);
 });
 });

 var ralInput = document.getElementById('cfgRalInput');
 if (ralInput) {
 ralInput.addEventListener('input', function() {
 state.ral = ralInput.value.trim();
 refresh();
 });
 }

 // Pole Adapter <select> . 13 tenons + 3 bullhorns (LSBX-RB family)
 var adapterSel = document.getElementById('cfgAdapterSelect');
 if (adapterSel) {
 adapterSel.value = state.adapter || '';
 adapterSel.addEventListener('change', function() {
 state.adapter = adapterSel.value || '';
 refresh();
 });
 }

 // Reset button - restore canonical defaults
 var resetBtn = document.getElementById('cfgReset');
 if (resetBtn) {
 resetBtn.addEventListener('click', function() {
 state = {
 housing: '150', cct: '3CS', voltage: 'U', optic: '', finish: 'D', mount: '', taa: 'STD',
 photocell: '', sensor: '', shield: '', surge: '', ral: '', adapter: ''
 };
 var adapterSel = document.getElementById('cfgAdapterSelect');
 if (adapterSel) adapterSel.value = '';
 hydrateUi();
 refresh();
 });
 }

 // Copy SKU button
 var copyBtn = document.getElementById('cfgSkuCopy');
 if (copyBtn) {
 copyBtn.addEventListener('click', function() {
 var sku = document.getElementById('cfgSku').textContent;
 if (navigator.clipboard && navigator.clipboard.writeText) {
 navigator.clipboard.writeText(sku);
 var lbl = document.getElementById('cfgSkuCopyLabel');
 if (lbl) {
 var orig = lbl.textContent;
 lbl.textContent = 'Copied ✓';
 setTimeout(function() { lbl.textContent = orig; }, 1500);
 }
 }
 });
 }

 // Share Configuration handler
 var shareBtn = document.getElementById('cfgShareBtn');
 var shareLabel = document.getElementById('cfgShareLabel');
 if (shareBtn) {
 shareBtn.addEventListener('click', function() {
 var params = new URLSearchParams();
 Object.keys(state).forEach(function(k) {
 if (state[k]) params.set(k, state[k]);
 });
 var url = window.location.origin + window.location.pathname + '?' + params.toString() + '#configurator';
 if (navigator.clipboard && navigator.clipboard.writeText) {
 navigator.clipboard.writeText(url).then(function() {
 shareLabel.textContent = 'Link Copied ✓';
 setTimeout(function() { shareLabel.textContent = 'Share Configuration'; }, 1800);
 });
 } else {
 window.prompt('Copy share link:', url);
 }
 });
 }

 refresh();
 }

 if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
 else init();
})();
</script>

 var state = { housing: '150', optic: 'T3', cct: '5K' };

 function keyFor(housing, optic, cct) { return housing + '-' + optic + '-' + cct; }

 function refresh() {
 // Disable optic + CCT tabs that have no data for the current housing
 opticTabs.forEach(function(t) {
 var optic = t.getAttribute('data-optic');
 // any CCT availability counts as "this optic exists"
 var has = ['3K','4K','5K'].some(function(c) { return !!DATA[keyFor(state.housing, optic, c)]; });
 t.setAttribute('data-disabled', has ? 'false' : 'true');
 });
 cctTabs.forEach(function(t) {
 var cct = t.getAttribute('data-cct');
 var has = !!DATA[keyFor(state.housing, state.optic, cct)];
 t.setAttribute('data-disabled', has ? 'false' : 'true');
 });

 var d = DATA[keyFor(state.housing, state.optic, state.cct)];

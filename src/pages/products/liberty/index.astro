<script is:inline>
/* =============================================================================
 SECTION 5 . Motion video carousel - single-source seek model (v1.8)
 ----------------------------------------------------------------------------
 SOURCE: ALG/SNC OEM master `LSBX - PromoVideo_NoText.mp4` - 162.84s . 1920x1080
 25fps . H.264 + AAC . 209 MB raw (Manus transcodes to ~720p web-grade
 ~25-30 MB and stages at the URL below). All 5 carousel clips are
 SEGMENTS of this single source video - the JS seeks `currentTime`
 per clip and uses an ended-window listener to auto-advance.

 WHY single-source-seek (not per-clip MP4 files):
 • Avoids redundant Archipelago brand intro replay (0-9s of source) every
 time a new clip starts. The src loads ONCE, never reassigns.
 • One download . five "clips" . zero re-buffer between segments.
 • Per-clip MP4 splices are no longer a blocker.

 STORYBOARD (carved from the 162.84s SNC master . brand intro 0-9s + outro
 156-163s deliberately excluded):
 [10s -> 22s] WETAGUARD . IP65 - die-cast cooling fins + respirator vent
 [24s -> 44s] PROAPTICS . OPTIC SWAP - driver compartment + magnetic LED-panel install
 [52s -> 84s] 4 MOUNTS . 1 CHASSIS - slip-fitter -> wall bracket -> square pole
 [124s -> 138s] CONTRALS-READY - twist-lock photocell/sensor accessory ports
 [140s -> 156s] IP65 TEST + REAL-WORLD - red-dye spray test -> commercial install + parking-lot night

 v1.8 ASSET CARRY-FORWARD: Manus uploads the transcoded master MP4 to
 `assets/liberty/motion/lsbx-promovideo-master.mp4` (web-grade ~25-30 MB).
 If start/end timecodes need fine-tuning after asset lands, edit the `s`/`e`
 fields in the `clips` array - no other code changes required.
 ============================================================================= */
(function() {
 // PRIMARY source: the 162.84s SNC master (Manus uploads the transcoded
 // web-grade ~720p ~25-30 MB version to this path before deploy).
 // FALLBACK source: the existing 36s spliced liberty-motion-hero.mp4 already
 // on disk - if the master 404s in dev preview the JS swaps once to the
 // fallback and collapses to a single hero clip so the error handler can't
 // tight-loop. Caption falls back to a static "Liberty in motion" line.
 var SRC = 'assets/liberty/motion/lsbx-promovideo-master.mp4';
 var SRC_FALLBACK = 'assets/liberty/motion/liberty-motion-hero.mp4';

 // s = segment start (sec) . e = segment end (sec) . tag/title = caption copy.
 // Tags are kept Illuminator-compact (single concept . no `. suffix` dual phrasing)
 // so dot buttons stay on one line. Long storyline goes into clip.title which renders
 // in the rolling .motion-caption inside the player.
 var clips = [
 { s: 10, e: 22, tag: 'WET<span class="aa" aria-hidden="true">A</span>GUARD',
 title: 'Die-cast housing with respirator vent - pressure-equalized and IP65-sealed for wet-location service.' },
 { s: 24, e: 44, tag: 'PRO<span class="aa" aria-hidden="true">A</span>PTICS',
 title: 'Magnetic-retained optic lifts out by hand - Type II / III / IV / V interchangeable in under 60 seconds.' },
 { s: 52, e: 84, tag: '4 MOUNTS',
 title: 'Slip-Fitter, Wall, Square Pole, Round Pole - one housing, four field-ready brackets.' },
 { s: 124, e: 138, tag: 'CONTR<span class="aa" aria-hidden="true">A</span>LS-READY',
 title: 'Photocell receptacle + sensor port - twist-lock to commission Bi-Level PIR or BLE Mesh.' },
 { s: 140, e: 156, tag: 'IP65 TESTED',
 title: 'Red-dye spray test -> commercial install -> parking-lot at night. Same chassis, end to end.' }
 ];

 // Single-clip fallback (covers the existing 36s spliced hero MP4).
 var FALLBACK_CLIPS = [
 { s: 0, e: 36, tag: 'LIBERTY . HERO LOOP',
 title: '36-second hero loop. Per-clip master will replace this once Manus uploads the transcoded LSBX SNC master MP4.' }
 ];

 function init() {
 var video = document.getElementById('motionVideo');
 var caption = document.getElementById('motionCaption');
 var dotsRow = document.getElementById('motionDots');
 var progress = document.getElementById('motionProgressBar');
 if (!video || !caption || !dotsRow || !progress) return;

 var idx = 0;
 var ticker;
 var srcLoaded = false;
 var triedFallback = false;
 var usingFallback = false; // once true, set() stops trying to seek (fallback hero is 36s . clip timecodes don't apply)

 // Load source once and pin metadata so we can seek reliably.
 function ensureSrc() {
 if (srcLoaded || usingFallback) return;
 video.src = SRC;
 video.load();
 srcLoaded = true;
 }

 function rebuildDots() {
 // v1.18: Illuminator-canonical pixel-pattern - compact `NN . TAG` text
 // buttons. The longer storyline appears as the rolling caption inside
 // the video player (.motion-caption-title), not on the dot button.
 dotsRow.innerHTML = clips.map(function(c, n) {
 var num = (n + 1).toString().padStart(2, '0');
 return '<button type="button" data-i="' + n + '" role="tab"' +
 (n === 0 ? ' class="active" aria-selected="true"' : ' aria-selected="false"') +
 '>' + num + ' . ' + c.tag + '</button>';
 }).join('');
 dotsRow.querySelectorAll('button').forEach(function(b) {
 b.addEventListener('click', function() {
 clearInterval(ticker);
 set(parseInt(b.dataset.i, 10));
 startTicker();
 });
 });
 // If only one clip remains (fallback collapsed), hide the dots row.
 dotsRow.style.display = (clips.length > 1) ? '' : 'none';
 }

 // Master MP4 404 - swap the SOURCE to the existing 36s spliced hero MP4
 // but KEEP the 5-clip carousel UI active. The video plays the hero on
 // loop in the background; the storyboard cards + rolling caption auto-
 // advance through all five Liberty clips on the ticker (no seeking
 // since hero MP4 doesn't carry the segment timecodes). When Manus
 // uploads the proper master, the seek model takes over.
 function activateFallback() {
 if (triedFallback) return;
 triedFallback = true;
 usingFallback = true; // freezes ensureSrc() . prevents ticker from reverting to the 404'ing master
 clearInterval(ticker);
 srcLoaded = true; // we have an active src . don't let set()->ensureSrc() reassign back to master
 video.src = SRC_FALLBACK;
 video.loop = true; // hero MP4 loops continuously behind the rotating cards
 video.load();
 var play = video.play();
 if (play && typeof play.catch === 'function') play.catch(function(){});
 // Keep clips array intact; restart from clip 1 with rotating ticker.
 idx = 0;
 paintCaption(clips[0]);
 paintDots();
 progress.style.width = '0%';
 startTicker();
 }

 function paintCaption(c) {
 caption.innerHTML =
 '<div class="motion-caption-eyebrow">' + (idx + 1).toString().padStart(2, '0') + ' / ' + clips.length.toString().padStart(2, '0') + ' . ' + c.tag + '</div>' +
 '<div class="motion-caption-title">' + c.title + '</div>';
 }

 function paintDots() {
 dotsRow.querySelectorAll('button').forEach(function(b, n) {
 b.classList.toggle('active', n === idx);
 b.setAttribute('aria-selected', n === idx ? 'true' : 'false');
 });
 }

 function set(i) {
 idx = (i + clips.length) % clips.length;
 var c = clips[idx];
 ensureSrc();
 // Seek model only applies to the master MP4. When the fallback hero is
 // active, the 36s clip doesn't carry the segment timecodes (s/e values
 // up to 156s would all land past EOF), so DON'T seek - let the hero
 // loop linearly behind the rotating cards.
 if (!usingFallback) {
 var seek = function() {
 try { video.currentTime = c.s; } catch (e) {}
 var play = video.play();
 if (play && typeof play.catch === 'function') play.catch(function(){});
 };
 if (video.readyState >= 1 /* HAVE_METADATA */) {
 seek();
 } else {
 video.addEventListener('loadedmetadata', seek, { once: true });
 }
 }
 paintCaption(c);
 paintDots();
 progress.style.width = '0%';
 }

 // Build dots
 rebuildDots();

 // Progress bar - animates 0->100% across the CURRENT clip's duration.
 // Also enforces the segment endTime: when video.currentTime >= clip.e,
 // advance to the next clip (no need for separate setTimeout).
 function startTicker() {
 var c = clips[idx];
 // In master-seek mode use the segment duration; in fallback-hero mode
 // each storyboard card gets a flat 7s window (hero is 36s, 5 clips ≈ 7s/card).
 var dur = usingFallback ? 7000 : Math.max(0.5, c.e - c.s) * 1000;
 var start = Date.now();
 progress.style.width = '0%';
 ticker = setInterval(function() {
 var pct = Math.min(100, ((Date.now() - start) / dur) * 100);
 progress.style.width = pct + '%';
 var timeUp = pct >= 100;
 // Position-based end check ONLY in master-seek mode - the hero MP4
 // is shorter than most clip.e values so position checks would always
 // fire pastSeg in fallback.
 var pastSeg = !usingFallback && video.currentTime &&
 (video.currentTime >= c.e || video.currentTime < c.s - 0.3);
 if (timeUp || pastSeg) {
 clearInterval(ticker);
 set(idx + 1);
 startTicker();
 }
 }, 60);
 }

 // If the primary master 404s (dev preview, pending Manus upload),
 // swap to the existing 36s spliced hero MP4 ONCE. After that, ignore
 // further errors so we don't tight-loop.
 video.addEventListener('error', function() {
 clearInterval(ticker);
 if (!triedFallback) activateFallback();
 });

 // Belt-and-suspenders: file:// URLs sometimes don't fire 'error' on 404
 // (browser-dependent). If readyState hasn't progressed past 0 (HAVE_NOTHING)
 // within 2 seconds, treat the master as missing and trigger the fallback
 // path explicitly. Once readyState >= HAVE_METADATA the master loaded fine.
 setTimeout(function() {
 if (!triedFallback && video.readyState < 1 /* HAVE_METADATA */) {
 activateFallback();
 }
 }, 2000);

 // Defensive: video element default `loop` would replay 0->end. Disable
 // it so the seek-window stays inside the active clip segment.
 video.loop = false;

 set(0);
 startTicker();
 }
 if (document.readyState === 'loading') {
 document.addEventListener('DOMContentLoaded', init);
 } else {
 init();
 }
})();
</script>


<!-- ============= URL PARAM POPULATION ============= -->
<script>
(function() {
  // --- PARSE URL PARAMS ---
  var params = new URLSearchParams(window.location.search);
  var sku     = params.get('sku')     || 'LSBX450-3CS-ULB/UA/OT5';
  var watts   = params.get('wattage') || '450';
  var optic   = params.get('optic')   || 'T3';
  var voltage = params.get('voltage') || 'U';
  var cct     = params.get('cct')     || '40';
  var finish  = params.get('finish')  || 'Black';
  var mount   = params.get('mount')   || 'UA';
  var taa     = params.get('taa')     === '1';

  // --- AUTOFILL CATALOG NUMBER (all 4 page headers) ---
  var skuLive = sku + (taa ? '/TAA' : '');
  document.querySelectorAll('#catNum, #catNum2, #catNum3, #catNum4, #liveSku').forEach(function(el) {
    el.textContent = skuLive;
  });
  document.getElementById('piCatNum').textContent = skuLive;
  // --- CFG-SUB-1: Catalog-number edit sync ---
  (function() {
    var catFields = ['catNum', 'catNum2', 'catNum3', 'catNum4', 'liveSku', 'piCatNum'];
    function syncCatalogNumber(newVal) {
      catFields.forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.textContent = newVal;
      });
    }
    catFields.forEach(function(id) {
      var el = document.getElementById(id);
      if (!el) return;
      el.addEventListener('input', function() {
        syncCatalogNumber(this.textContent.trim());
      });
    });
  })();

  // --- AUTOFILL QUICK SPECS ---
  // lumens lookup table from Section 6 photometric data
  // LSBX Liberty housing → lumens lookup (max wattage setting, per datasheet)
  var housingLumens = {
    '100': { lumens: '15,400', efficacy: '154', watts_max: '100', watts_mid: '75',  watts_min: '50'  },
    '150': { lumens: '22,650', efficacy: '151', watts_max: '150', watts_mid: '100', watts_min: '80'  },
    '200': { lumens: '29,800', efficacy: '149', watts_max: '200', watts_mid: '150', watts_min: '120' },
    '300': { lumens: '43,800', efficacy: '146', watts_max: '300', watts_mid: '250', watts_min: '220' },
    '450': { lumens: '66,600', efficacy: '148', watts_max: '450', watts_mid: '390', watts_min: '330' }
  };
  // Parse housing from URL param or infer from wattage
  var housing = params.get('housing') || watts;
  var hl = housingLumens[housing] || housingLumens['450'];
  var pd = { lumens: hl.lumens, peak: '—', file: 'LSBX' + housing + '-3CS-U-T3.IES' };

  document.getElementById('qsLumens').innerHTML = hl.lumens + '<span class="qs-unit">lm</span>';
  document.getElementById('qsWatts').innerHTML  = hl.watts_max + '<span class="qs-unit">W</span>';
  document.getElementById('qsCct').innerHTML    = (cct === '30' ? '3000' : cct === '40' ? '4000' : '5000') + '<span class="qs-unit">K</span>';
  document.getElementById('qsVoltage').innerHTML = (voltage === 'H' ? '277-480' : '120-277') + '<span class="qs-unit">V</span>';

  // --- AUTOFILL ORDERING CODE BREAKDOWN ---
  document.getElementById('ocWatts').textContent  = housing;
  document.getElementById('ocCct').textContent    = '3CS';
  document.getElementById('ocVolt').textContent   = (voltage === 'H' ? 'H' : 'U');
  var finishCode = { 'Dark Bronze': 'D', 'Black': 'B', 'Silver': 'S', 'White': 'W', 'D': 'D', 'B': 'B', 'S': 'S', 'W': 'W' };
  document.getElementById('ocFinish').textContent = finishCode[finish] || finish.charAt(0).toUpperCase();
  var mountCode = { 'UA': 'UA', 'Universal': 'UA', 'SF': 'SF', 'Slip-Fitter': 'SF', 'TN': 'TN', 'Trunnion': 'TN', 'RS': 'RS', 'Round/Square': 'RS' };
  document.getElementById('ocMount').textContent  = mountCode[mount] || mount;
  document.getElementById('ocTaa').textContent    = taa ? 'TAA' : '—';
  if (taa) {
    document.getElementById('taaBadge').style.display = 'inline-block';
  }

  // --- AUTOFILL PHOTOMETRIC PAGE 4 ---
  document.getElementById('photoEyebrow').textContent = optic + ' optic · ' + hl.watts_max + 'W · ' + (cct === '30' ? '3000K' : cct === '40' ? '4000K' : '5000K');
  document.getElementById('photoPolarImg').src = '/products/liberty/assets/photometrics/lsbx' + housing + '-' + optic.toLowerCase() + '.svg';
  document.getElementById('photoPolarImg').onerror = function() {
    this.style.display = 'none';
    this.parentElement.innerHTML += '<div style="color:#999;font-size:8pt;text-align:center;">Polar plot unavailable<br/>for ' + watts + 'W / ' + optic + '°</div>';
  };
  document.getElementById('photoPeak').textContent    = '—';
  document.getElementById('photoLumens').textContent  = hl.lumens + ' lm';
  document.getElementById('photoBeam').textContent    = optic;
  document.getElementById('photoIesFile').textContent = 'LSBX' + housing + '-3CS-U-' + optic + '.IES';

  // --- LIVE DATE ---
  var d = new Date();
  document.getElementById('liveDate').textContent =
    d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' });
  document.getElementById('revDate').textContent =
    d.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit' }).replace('/', '-');
})();
</script>


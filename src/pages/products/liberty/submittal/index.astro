---
/**
 * LSBX · Liberty Area — Submittal Sheet
 * Route: /products/liberty/submittal/
 * 
 * Standalone print-optimized page. No site header/footer.
 * URL params auto-populate the submittal fields.
 * Foundation: _canonical_submittal_template.html per CFG-SUB-1/2/3/4.
 */
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>LSBX · Liberty Area — Submittal Sheet</title>

<!--
  ALG SUBMITTAL TEMPLATE v1
  ==========================
  Reads URL query params and auto-fills the catalog number + quick specs.
  Example: submittal_template.html?sku=LSBX450-3CS-ULB/UA/OT5&housing=450&cct=40&voltage=U&finish=B&mount=UA&taa=0

  Print: File → Print → Save as PDF (letter portrait) gives the spec-grade PDF.
  Manus replaces this stub with a real backend at /submittal-generator/?sku=… on production.

  Research synthesis: see submittal_research_findings.md alongside this file.
-->

<style>
  /* ============= PRINT-OPTIMIZED CSS ============= */
  @page {
    size: letter portrait;
    margin: 0.5in 0.6in;
  }
  @media print {
    .no-print { display: none !important; }
    body { background: white !important; }
    .page { box-shadow: none !important; margin: 0 !important; page-break-after: always; }
    .page:last-of-type { page-break-after: auto; }
  }

  /* ============= TYPE + COLOR TOKENS ============= */
  :root {
    --brand-red: #F32740;
    --ink: #0E0E10;
    --ink-2: #2A2A2D;
    --muted: #6B6B70;
    --rule: #D8D6D2;
    --rule-strong: #A6A4A0;
    --tint: #F6F4F0;
    --hi: #FFF6E5;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0;
    font-family: 'Lato', -apple-system, BlinkMacSystemFont, system-ui, Helvetica, Arial, sans-serif;
    color: var(--ink);
    font-size: 9.5pt;
    line-height: 1.4;
    background: #E8E6E2;
  }
  body { padding: 24px 12px; }
  .page {
    width: 8.5in;
    min-height: 11in;
    margin: 0 auto 24px;
    padding: 0.55in 0.65in;
    background: white;
    box-shadow: 0 6px 28px rgba(0,0,0,0.08);
    position: relative;
  }
  h1, h2, h3, h4 { font-family: 'Lato', sans-serif; font-weight: 700; margin: 0; line-height: 1.15; }
  .mono { font-family: 'JetBrains Mono', 'Menlo', monospace; }

  /* ============= PAGE HEADER (every page) ============= */
  .submittal-head {
    display: flex; align-items: flex-end; justify-content: space-between;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 8px; margin-bottom: 14px;
  }
  .submittal-head .brand { display: flex; align-items: center; gap: 10px; }
  .submittal-head .brand-mark {
    width: 28px; height: 28px; background: var(--brand-red);
    display: inline-block;
  }
  .submittal-head .brand-name {
    font-size: 13pt; font-weight: 700; letter-spacing: 0.4pt; line-height: 1;
  }
  .submittal-head .brand-sub {
    font-size: 7.5pt; letter-spacing: 1.5pt; color: var(--muted);
    text-transform: uppercase;
  }
  .submittal-head .catalog-block {
    text-align: right;
  }
  .submittal-head .catalog-eyebrow {
    font-size: 7pt; letter-spacing: 1.5pt; color: var(--muted);
    text-transform: uppercase; margin-bottom: 2px;
  }
  .submittal-head .catalog-number {
    font-size: 12pt; font-weight: 700; font-family: 'JetBrains Mono', monospace;
    border: 1.5px solid var(--ink);
    padding: 4px 10px; display: inline-block;
    letter-spacing: 0.5pt;
  }

  /* ============= PROJECT INFO FORM ============= */
  .project-info {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border: 1px solid var(--rule-strong);
    margin-bottom: 14px;
  }
  .pi-cell {
    padding: 6px 9px;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    min-height: 38px;
  }
  .pi-cell:nth-child(3n) { border-right: none; }
  .pi-cell:nth-child(n+4) { border-bottom: none; }
  .pi-label {
    font-size: 7pt; letter-spacing: 1.2pt; color: var(--muted);
    text-transform: uppercase; margin-bottom: 4px;
  }
  .pi-value {
    border-bottom: 1px dotted var(--rule-strong); min-height: 14px; padding-top: 2px;
  }

  /* ============= PRODUCT TITLE BAND ============= */
  .product-title {
    margin: 14px 0 14px;
  }
  .product-title h1 {
    font-size: 22pt; line-height: 1; margin: 0;
  }
  .product-title .tagline {
    font-size: 10pt; color: var(--ink-2); margin-top: 4px; line-height: 1.3;
  }

  /* ============= HERO + QUICK SPECS GRID ============= */
  .at-a-glance {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 16px;
    margin-bottom: 12px;
  }
  .hero-img {
    background: var(--tint);
    border: 1px solid var(--rule);
    aspect-ratio: 4/3;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .hero-img img { width: 100%; height: 100%; object-fit: contain; }

  .qs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }
  .qs-cell {
    border: 1px solid var(--rule-strong);
    padding: 8px 10px;
    min-height: 56px;
  }
  .qs-label {
    font-size: 7pt; letter-spacing: 1.2pt; color: var(--muted);
    text-transform: uppercase; margin-bottom: 3px;
  }
  .qs-value {
    font-size: 14pt; font-weight: 700; line-height: 1.05;
  }
  .qs-unit {
    font-size: 8pt; font-weight: 400; color: var(--muted); margin-left: 2px;
  }

  /* ============= FEATURE BAND (RAB X34 trick) ============= */
  .feature-band {
    background: var(--ink); color: white;
    padding: 8px 14px;
    display: flex; gap: 18px; align-items: center;
    margin-bottom: 12px;
  }
  .feature-band .fb-pill {
    background: var(--brand-red); color: white;
    font-size: 7pt; font-weight: 700; letter-spacing: 1.2pt;
    padding: 3px 7px; text-transform: uppercase;
  }
  .feature-band .fb-features {
    font-size: 9pt; line-height: 1.3;
  }
  .feature-band .fb-features strong { font-weight: 700; }

  /* ============= APPROVAL SIGNATURE BLOCK (Cooper trick) ============= */
  .approval-block {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 18px;
    margin-top: 14px;
    padding-top: 8px;
    border-top: 1px dashed var(--rule-strong);
  }
  .approval-cell {
    display: grid; grid-template-columns: max-content 1fr;
    gap: 8px; align-items: end;
    font-size: 8pt;
  }
  .approval-line {
    border-bottom: 1px solid var(--ink); height: 16px;
  }

  /* ============= SECTION HEAD (page 2+) ============= */
  .section-head {
    display: flex; align-items: baseline; justify-content: space-between;
    border-bottom: 1.5px solid var(--ink);
    padding-bottom: 4px; margin-bottom: 10px; margin-top: 4px;
  }
  .section-head h2 {
    font-size: 14pt; line-height: 1;
  }
  .section-head .section-eyebrow {
    font-size: 7pt; letter-spacing: 1.5pt; color: var(--muted);
    text-transform: uppercase;
  }

  /* ============= SPEC TABLE ============= */
  .spec-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 8.5pt;
  }
  .spec-table th, .spec-table td {
    text-align: left;
    padding: 5px 8px;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  .spec-table .spec-section-head td {
    background: var(--tint);
    font-weight: 700;
    font-size: 9pt;
    letter-spacing: 0.3pt;
    border-bottom: 1px solid var(--rule-strong);
    padding: 6px 8px;
  }
  .spec-table .spec-attr {
    width: 30%;
    font-weight: 600;
    color: var(--ink-2);
  }
  .spec-table .spec-val {
    width: 70%;
  }

  /* ============= ORDERING CODE MATRIX ============= */
  .order-code {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
    margin-bottom: 10px;
  }
  .order-segment {
    background: var(--tint);
    border: 1px solid var(--rule-strong);
    padding: 8px 6px;
    text-align: center;
  }
  .order-segment.active {
    background: var(--brand-red); color: white;
    border-color: var(--brand-red);
  }
  .order-seg-label {
    font-size: 7pt; letter-spacing: 1pt;
    text-transform: uppercase; margin-bottom: 4px;
    opacity: 0.8;
  }
  .order-seg-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11pt; font-weight: 700;
  }
  .order-matrix {
    width: 100%;
    border-collapse: collapse;
    font-size: 7.5pt;
  }
  .order-matrix th, .order-matrix td {
    border: 1px solid var(--rule);
    padding: 4px 6px; text-align: left;
    vertical-align: top;
  }
  .order-matrix th {
    background: var(--ink); color: white;
    font-size: 7pt; letter-spacing: 1pt;
    text-transform: uppercase;
  }
  .order-matrix .code {
    font-family: 'JetBrains Mono', monospace; font-weight: 700;
    width: 60px;
  }

  /* ============= DIMENSIONS LAYOUT ============= */
  .dim-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 14px;
  }
  .dim-views {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 8px;
  }
  .dim-view {
    border: 1px solid var(--rule-strong);
    aspect-ratio: 4/3;
    display: flex; align-items: center; justify-content: center;
    background: white;
    position: relative;
    overflow: hidden;
  }
  .dim-view img { width: 100%; height: 100%; object-fit: contain; }
  .dim-view-label {
    position: absolute; top: 4px; left: 6px;
    font-size: 7pt; letter-spacing: 1pt; color: var(--muted);
    text-transform: uppercase;
  }

  /* ============= PHOTOMETRIC DATA ============= */
  .photo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .photo-polar {
    border: 1px solid var(--rule-strong);
    padding: 10px;
    aspect-ratio: 1;
    display: flex; align-items: center; justify-content: center;
    background: white;
    overflow: hidden;
  }
  .photo-polar img, .photo-polar svg { width: 100%; height: 100%; }
  .photo-summary {
    border: 1px solid var(--rule);
  }
  .photo-summary table { width: 100%; border-collapse: collapse; font-size: 8pt; }
  .photo-summary table td {
    padding: 4px 8px; border-bottom: 1px solid var(--rule);
  }
  .photo-summary table tr:last-child td { border-bottom: none; }
  .photo-summary td:first-child { color: var(--muted); }
  .photo-summary td:last-child {
    font-family: 'JetBrains Mono', monospace; font-weight: 700; text-align: right;
  }

  /* ============= CERTIFICATIONS ============= */
  .certs {
    display: flex; flex-wrap: wrap; gap: 6px;
    padding: 8px 10px;
    border: 1px solid var(--rule);
    margin-top: 10px;
  }
  .cert-badge {
    font-size: 7.5pt; font-weight: 700;
    border: 1.5px solid var(--ink); padding: 3px 8px;
    letter-spacing: 0.6pt;
    text-transform: uppercase;
  }
  .cert-badge.brand { border-color: var(--brand-red); color: var(--brand-red); }

  /* ============= PAGE FOOTER ============= */
  .page-foot {
    position: absolute;
    bottom: 0.4in; left: 0.65in; right: 0.65in;
    display: flex; justify-content: space-between;
    font-size: 7pt; color: var(--muted);
    padding-top: 6px;
    border-top: 1px solid var(--rule);
  }

  /* ============= NO-PRINT CONTROLS ============= */
  .controls {
    max-width: 8.5in; margin: 0 auto 18px;
    background: white; padding: 14px 18px;
    border: 1px solid var(--rule);
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    display: flex; gap: 12px; align-items: center; flex-wrap: wrap;
  }
  .controls .ctrl-label {
    font-size: 9pt; font-weight: 600; color: var(--muted);
    letter-spacing: 0.5pt; text-transform: uppercase;
  }
  .controls .ctrl-value {
    font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 11pt;
  }
  .controls button {
    background: var(--brand-red); color: white;
    border: none; padding: 8px 16px;
    font-family: inherit; font-weight: 700; font-size: 9pt;
    letter-spacing: 0.5pt; text-transform: uppercase;
    cursor: pointer;
    margin-left: auto;
  }
  .controls button:hover { background: #d61f37; }

/* CFG-MOBILE-1 · image responsive reset (injected by cfg_mobile_1_readiness_sweep.py) */
img { max-width: 100%; height: auto; }

/* CFG-MOBILE-1 · prevent horizontal scroll on mobile */
body { overflow-x: hidden; }
</style>
</head>
<body>

<!-- ============= NO-PRINT CONTROLS BAR ============= -->
<div class="controls no-print">
  <div>
    <div class="ctrl-label">Configured SKU</div>
    <div class="ctrl-value" id="liveSku">LSBX450-3CS-ULB/UA/OT5</div>
  </div>
  <div>
    <div class="ctrl-label">Generated</div>
    <div class="ctrl-value" id="liveDate" style="font-size:9pt; font-weight:400;">—</div>
  </div>
  <button onclick="window.print()">Save as PDF →</button>
</div>


<!-- ============================================================ -->
<!-- PAGE 1 — AT A GLANCE                                          -->
<!-- ============================================================ -->
<div class="page" id="page-1">

  <!-- HEADER -->
  <div class="submittal-head">
    <div class="brand">
      <span class="brand-mark"></span>
      <div>
        <div class="brand-name">ARCHIPELAGO</div>
        <div class="brand-sub">Lighting Group</div>
      </div>
    </div>
    <div class="catalog-block">
      <div class="catalog-eyebrow">Catalog Number</div>
      <div class="catalog-number" id="catNum" contenteditable="true" spellcheck="false">LSBX450-3CS-ULB/UA/OT5</div>
    </div>
  </div>

  <!-- PROJECT INFO FORM -->
  <div class="project-info">
    <div class="pi-cell"><div class="pi-label">Project</div><div class="pi-value"></div></div>
    <div class="pi-cell"><div class="pi-label">Type</div><div class="pi-value"></div></div>
    <div class="pi-cell"><div class="pi-label">Catalog #</div><div class="pi-value" id="piCatNum"></div></div>
    <div class="pi-cell"><div class="pi-label">Prepared By</div><div class="pi-value"></div></div>
    <div class="pi-cell"><div class="pi-label">Notes</div><div class="pi-value"></div></div>
    <div class="pi-cell"><div class="pi-label">Date</div><div class="pi-value"></div></div>
  </div>

  <!-- PRODUCT TITLE -->
  <div class="product-title">
    <h1>LSBX Liberty</h1>
    <div class="tagline">Commercial-grade LED area light (shoebox) · luxoⒶRCH PRO · True U0 dark-sky · 3WATTselect + 3CCTselect + magnetic proⒶPTICS optic swap · parking · roadways · façades</div>
  </div>

  <!-- HERO + QUICK SPECS -->
  <div class="at-a-glance">
    <div class="hero-img">
      <img src="/products/liberty/assets/liberty/hero/liberty-hero-1.webp"
           alt="LSBX Liberty luminaire" />
    </div>
    <div class="qs-grid">
      <div class="qs-cell">
        <div class="qs-label">Lumens</div>
        <div class="qs-value" id="qsLumens">66,600<span class="qs-unit">lm</span></div>
      </div>
      <div class="qs-cell">
        <div class="qs-label">Wattage</div>
        <div class="qs-value" id="qsWatts">600<span class="qs-unit">W</span></div>
      </div>
      <div class="qs-cell">
        <div class="qs-label">Voltage</div>
        <div class="qs-value" id="qsVoltage">120-277<span class="qs-unit">V</span></div>
      </div>
      <div class="qs-cell">
        <div class="qs-label">CCT</div>
        <div class="qs-value" id="qsCct">5000<span class="qs-unit">K</span></div>
      </div>
      <div class="qs-cell">
        <div class="qs-label">CRI</div>
        <div class="qs-value">&gt;80</div>
      </div>
      <div class="qs-cell">
        <div class="qs-label">BUG</div>
        <div class="qs-value">B2-U0-G2</div>
      </div>
    </div>
  </div>

  <!-- FEATURE BAND -->
  <div class="feature-band">
    <div class="fb-pill">Field-Adjustable</div>
    <div class="fb-features">
      <strong>3WATTselect™</strong> field-selectable wattage (3 settings per housing) ·
      <strong>3CCTselect™</strong> 3000K / 4000K / 5000K ·
      <strong>proⒶPTICS™</strong> magnetic tool-less optic swap (Type-II / III / IV / V) ·
      <strong>contrⒶLS-Ready</strong> NLC-compliant · 0-10V / occupancy / networked
    </div>
  </div>

  <!-- APPROVAL BLOCK -->
  <div class="approval-block">
    <div class="approval-cell">
      <span><strong>Approved by</strong></span>
      <div class="approval-line"></div>
    </div>
    <div class="approval-cell">
      <span><strong>Date</strong></span>
      <div class="approval-line"></div>
    </div>
  </div>

  <!-- FOOTER -->
  <div class="page-foot">
    <div>archipelagolighting.com · LSBX Liberty submittal · Specifications subject to change</div>
    <div>Rev. <span id="revDate">2026-04</span> · Page 1 of 4</div>
  </div>
</div>


<!-- ============================================================ -->
<!-- PAGE 2 — SPECIFICATIONS                                       -->
<!-- ============================================================ -->
<div class="page" id="page-2">
  <div class="submittal-head">
    <div class="brand"><span class="brand-mark"></span><div><div class="brand-name">ARCHIPELAGO</div><div class="brand-sub">Lighting Group</div></div></div>
    <div class="catalog-block">
      <div class="catalog-eyebrow">Catalog Number</div>
      <div class="catalog-number" id="catNum2" contenteditable="true" spellcheck="false">LSBX450-3CS-ULB/UA/OT5</div>
    </div>
  </div>

  <div class="section-head">
    <h2>Specifications</h2>
    <div class="section-eyebrow">LSBX Liberty — Specifications</div>
  </div>

  <table class="spec-table">
    <tbody>
      <tr class="spec-section-head"><td colspan="2">Construction</td></tr>
      <tr><td class="spec-attr">Housing</td><td class="spec-val">Die-cast aluminum, marine-grade powder coat finish · 3G vibration-rated</td></tr>
      <tr><td class="spec-attr">Lens</td><td class="spec-val">UV-stabilized tempered borosilicate glass · IK08 impact-rated</td></tr>
      <tr><td class="spec-attr">Finish</td><td class="spec-val">Black (standard) · Bronze · Silver · White · Custom RAL Classic (specify code)</td></tr>
      <tr><td class="spec-attr">Ingress / Impact</td><td class="spec-val">IP65 wet-location rated · IK08</td></tr>
      <tr><td class="spec-attr">Operating Temp</td><td class="spec-val">−40°F to +122°F (−40°C to +50°C) · with motion sensor: −22°F to +122°F · 95% RH non-condensing</td></tr>

      <tr class="spec-section-head"><td colspan="2">LED &amp; Optics</td></tr>
      <tr><td class="spec-attr">LED Source</td><td class="spec-val">LUMILEDS LED · 75,000-hr L70 lumen maintenance</td></tr>
      <tr><td class="spec-attr">CCT Options</td><td class="spec-val">3000K · 4000K · 5000K (3CCTselect — field-selectable)</td></tr>
      <tr><td class="spec-attr">CRI</td><td class="spec-val">&gt;80 (CRI-80)</td></tr>
      <tr><td class="spec-attr">SDCM</td><td class="spec-val">&lt;3 step MacAdam (CCT shift ≤180K over warranty)</td></tr>
      <tr><td class="spec-attr">Optic Distribution</td><td class="spec-val">proⒶPTICS™ magnetic tool-less swap · Type-III standard (Type-II / IV / V available) · True U0 uplight</td></tr>
      <tr><td class="spec-attr">Lumen Output</td><td class="spec-val">LSBX100: 15,400 lm @ 154 lm/W · LSBX150: 22,650 lm @ 151 lm/W · LSBX200: 29,800 lm @ 149 lm/W · LSBX300: 43,800 lm @ 146 lm/W · LSBX450: 66,600 lm @ 148 lm/W (max wattage setting)</td></tr>

      <tr class="spec-section-head"><td colspan="2">Driver &amp; Electrical</td></tr>
      <tr><td class="spec-attr">Voltage</td><td class="spec-val">U: 120-277V universal · H: 277-480V high voltage</td></tr>
      <tr><td class="spec-attr">3WATTselect™</td><td class="spec-val">Field-selectable wattage — 3 settings per housing (50/75/100W · 80/100/150W · 120/150/200W · 220/250/300W · 330/390/450W)</td></tr>
      <tr><td class="spec-attr">Power Factor</td><td class="spec-val">≥ 0.95 at full load</td></tr>
      <tr><td class="spec-attr">THD</td><td class="spec-val">≤ 20% at full load</td></tr>
      <tr><td class="spec-attr">Surge Protection</td><td class="spec-val">6kV built-in standard · 10kV / 20kV in-line optional (surgeⒶRMOR)</td></tr>
      <tr><td class="spec-attr">Dimming</td><td class="spec-val">Standard 0-10V · DALI-2 on request · contrⒶLS-Ready (NLC-compliant, occupancy, networked)</td></tr>

      <tr class="spec-section-head"><td colspan="2">Controls &amp; Connectivity</td></tr>
      <tr><td class="spec-attr">Wireless Mesh</td><td class="spec-val">contrⒶLS NLC-compliant · ⒶCS by ALG app · occupancy + photocell sensors available</td></tr>
      <tr><td class="spec-attr">Sensor Options</td><td class="spec-val">Occupancy (MSP-OLS / MSP-OLS-SD) · contrⒶLS (MSP-ACS) · SILVAR (MSP-NLC) · all via MSP accessory port</td></tr>
      <tr><td class="spec-attr">Sensors</td><td class="spec-val">Optional photocell, occupancy, daylight harvesting via separate accessory</td></tr>

      <tr class="spec-section-head"><td colspan="2">Mounting</td></tr>
      <tr><td class="spec-attr">Mounts</td><td class="spec-val">Universal (UA) · Slip-Fitter (SF) · Trunnion (TN) · Round/Square Pole (RS)</td></tr>
      <tr><td class="spec-attr">Pole Arm</td><td class="spec-val">Slip-fitter for 2″ / 2-3/8″ tenon · stackable to 4 luminaires per pole-arm</td></tr>

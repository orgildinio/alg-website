<!-- Section 3 motion-player driver — Jupiter (5-slide rotation · clips spliced from PromoVideo_NoText.mp4)
     Mirrors the Illuminator canonical pattern: clips[] uses {url, tag, title};
     dot buttons render as labeled chips (NN · TAG); caption is two-line
     (eyebrow numero + tag, then narrative title). Each clip is 9s exact,
     so we sync the progress bar to video.currentTime and auto-advance on
     video.ended (cleaner than a wallclock ticker for video-driven progress). -->
<script is:inline>
(function(){
  // 5 slides spliced 2026-05-05 from "LRHB - Jupiter PromoVideo_NoText.mp4" via splice_jupiter_video.sh.
  // Best-of-class marketing copy per slide — specifier-grade, number-led, competitively framed.
  var clips = [
    {
      url:   'videos/jupiter-motion-01-family-reveal.mp4',
      tag:   'FAMILY REVEAL',
      title: 'The four-housing PRO family. <strong>10.9&quot; / 12.2&quot; / 15&quot;</strong> diameters across <strong>LRHB150 / 240 / 300 / 400</strong> &mdash; one thermal<span class="aa">Ⓐ</span>RMOR aluminum-alloy chassis, one SOSEN constant-current driver, one 6 kVA dual-mode surge spec. Same engineering language from the 100W ECO entry to the 400W industrial flagship.'
    },
    {
      url:   'videos/jupiter-motion-02-mount-config.mp4',
      tag:   'MOUNT CONFIGURATIONS',
      title: 'One housing. Five mount paths. Pick one at install. <strong>Mount Ring (MR &middot; standard)</strong>, <strong>Stainless Hook (MSH)</strong>, <strong>Yoke (MYK)</strong>, and <strong>1/2&quot; Hook (MH12 &middot; 400W only)</strong> &mdash; plus pendant suspension via the SOOW cord. The yard, the ceiling, the bridge crane, the mezzanine: same fixture, different rigging.'
    },
    {
      url:   'videos/jupiter-motion-03-soow-cord.mp4',
      tag:   'PRE-WIRED SOOW CORD',
      title: '<strong>6 feet of pre-attached SOOW cord</strong> &mdash; factory-terminated with strain relief, IP65 sealed at the housing entry. Direct-to-junction-box install, no field-wiring inside the luminaire. The contractor&rsquo;s box, the wire nut, and you&rsquo;re live.'
    },
    {
      url:   'videos/jupiter-motion-04-sensor-port.mp4',
      tag:   'SENSOR PORT &middot; contr<span class="aa">Ⓐ</span>LS-READY',
      title: 'Integrated sensor receptacle accepts <strong>contr<span class="aa">Ⓐ</span>LS Bi-Level</strong> (PIR / microwave drop-in), <strong><span class="aa">Ⓐ</span>CS Bluetooth Mesh</strong> (AURA-app commissioning &middot; DLC NLC qualified path), or <strong>SILVAIR enterprise mesh</strong> (DLC NLC rebate stacking). Most category competitors need 3rd-party sensor + external enclosure. Jupiter ships ready.'
    },
    {
      url:   'videos/jupiter-motion-05-reflector.mp4',
      tag:   'OPTICAL ACCESSORY LADDER',
      title: '<strong>PR</strong> acrylic + <strong>AR</strong> aluminum reflectors and <strong>PD</strong> diffusers &mdash; sized 240 / 300 / 400 to every wattage class above 150W. Bolt to the housing in field, no factory rework, no spec change. Tighten the 90&deg; beam where the application calls for narrower distribution.'
    }
  ];

  var video    = document.getElementById('motionVideo');
  var caption  = document.getElementById('motionCaption');
  var dotsRow  = document.getElementById('motionDots');
  var progress = document.getElementById('motionProgressBar');
  var errorBox = document.getElementById('motionError');
  var errorPath = document.getElementById('motionErrorPath');
  if (!video || !caption || !dotsRow || !progress) return;

  var idx = 0;

  // Hide / show the missing-clip overlay
  video.addEventListener('loadeddata', function(){ if (errorBox) errorBox.style.display = 'none'; });
  video.addEventListener('error', function(){
    if (errorBox && errorPath) {
      errorPath.textContent = clips[idx].url;
      errorBox.style.display = 'flex';
    }
  });

  function set(i) {
    idx = ((i % clips.length) + clips.length) % clips.length;
    var c = clips[idx];
    var num = (idx + 1).toString().padStart(2, '0');
    var total = clips.length.toString().padStart(2, '0');

    video.src = c.url;
    video.load();
    var p = video.play();
    if (p && typeof p.catch === 'function') p.catch(function(){});

    caption.innerHTML =
      '<div class="motion-caption-eyebrow">' + num + ' / ' + total + ' &middot; ' + c.tag + '</div>' +
      '<div class="motion-caption-title">' + c.title + '</div>';

    dotsRow.querySelectorAll('button').forEach(function(b, n) {
      b.classList.toggle('active', n === idx);
      b.setAttribute('aria-selected', n === idx ? 'true' : 'false');
    });

    progress.style.width = '0%';
  }

  // Build the labeled dot row — NN · TAG (matches Illuminator)
  dotsRow.innerHTML = clips.map(function(c, n) {
    var num = (n + 1).toString().padStart(2, '0');
    return '<button type="button" data-i="' + n + '" role="tab"' +
           (n === 0 ? ' class="active" aria-selected="true"' : ' aria-selected="false"') +
           '>' + num + ' &middot; ' + c.tag + '</button>';
  }).join('');
  dotsRow.querySelectorAll('button').forEach(function(b) {
    b.addEventListener('click', function(){ set(parseInt(b.dataset.i, 10)); });
  });

  // Progress bar tracks the video timeline, not a wallclock — accurate to the frame
  video.addEventListener('timeupdate', function(){
    if (video.duration) {
      progress.style.width = (100 * video.currentTime / video.duration) + '%';
    }
  });

  // Auto-advance when the current clip finishes
  video.addEventListener('ended', function(){ set(idx + 1); });

  set(0);
})();
</script>


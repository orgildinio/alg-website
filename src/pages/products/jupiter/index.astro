  var MULTI    = [];

  // ---- ZOHO_STOCK · base-SKU on-hand qty (Zoho Inventory snapshot 2026-05-27) ----
  // QS = stock ≥ 50 · WB = 1-49 · MTO = 0. Used by deriveShipTier for the BASE fixture row.
  var ZOHO_STOCK = {
    'LRHB150-3CS-UJ2':       92,    'LRHB150-3CS-UJ2/TAA':   478,
    'LRHB240-3CS-UJ2':       832,   'LRHB240-3CS-UJ2/TAA':   0,
    'LRHB300-3CS-UJ2':       376,   'LRHB300-3CS-UJ2/TAA':   789,
    'LRHB400-40C-UJ2':       0,     'LRHB400-40C-UJ2/TAA':   83,
    'LRHB400-50C-UJ2':       5,     'LRHB400-50C-UJ2/TAA':   16,
    'LRHB400-50C-HJ2':       0,     'LRHB400-50C-HJ2/TAA':   0
  };
  window.__JUPITER_ZOHO_STOCK = ZOHO_STOCK; // shared with CFG-STATE-1 IIFE

  // Live spec readout — IES-measured @ 5000K (parse_ies.py 2026-05-27).
  // 400W values from datasheet pg 2 (IES pending).
  var SPEC = {
    wattage: {
      '150': { lumens: '22,704 lm (IES) · 20,700 lm (datasheet)', lpw: '149 lm/W (IES) · 138-150 lm/W (datasheet)', peakCd: '13,057 cd · IES' },
      '240': { lumens: '36,508 lm (IES) · 33,120 lm (datasheet)', lpw: '154 lm/W (IES) · 138-150 lm/W (datasheet)', peakCd: '20,579 cd · IES' },
      '300': { lumens: '46,361 lm (IES) · 41,400 lm (datasheet)', lpw: '153 lm/W (IES) · 138-150 lm/W (datasheet)', peakCd: '24,881 cd · IES' },
      '400': { lumens: '67,200 lm (4000K) · 64,000 lm (5000K)',    lpw: '168 lm/W (4000K) · 160 lm/W (5000K)',     peakCd: '~33,000 cd · est (IES pending)' }
    },
    voltage: { 'U': '120-277V · Universal', 'H': '277-480V · High-voltage (MTO)' },
    finish:  { 'B': 'Black · custom MTO', 'W': 'White (standard)' },
    optic:   '90° Wide · single PC lens',
    cct:     '3-CCTSELECT bundle (3500/4000/5000K) · 4000K or 5000K single on 400W'
  };

  var DEFAULT_STATE = {};

  function init() {
    var section   = document.getElementById('configurator');
    if (!section) return;
    var counter   = document.getElementById('cfgCount');
    var counterEl = document.getElementById('cfgCounter');
    var reqTotal  = document.getElementById('cfgReqTotal');
    var resetBtn  = document.getElementById('cfgReset');
    var skuEl     = document.getElementById('cfgSku');
    var copyBtn   = document.getElementById('cfgSkuCopy');
    var copyLabel = document.getElementById('cfgSkuCopyLabel');
    var warning   = document.getElementById('cfgWarning');
    var ctaPrice  = document.getElementById('cfgCtaPrice');
    var ctaPdf    = document.getElementById('cfgCtaPdf');
    var chips     = section.querySelectorAll('.cfg-chip');
    var state     = Object.assign({}, DEFAULT_STATE);

    // ---- Chip click handler ----
    chips.forEach(function(chip) {
      chip.addEventListener('click', function() {
        if (chip.classList.contains('disabled')) return;
        var field = chip.dataset.field;
        var val   = chip.dataset.val;
        var isOpt = OPTIONAL.indexOf(field) >= 0;
        // wattselect + cct_bundle are informational (field dip-switch · no SKU effect · same toggle UX)
        var isInfo = (field === 'wattselect' || field === 'cct_bundle');

        if ((isOpt || isInfo) && state[field] === val) {
          delete state[field];
        } else {
          state[field] = val;
          if (field === 'wattage') seedClassDefaults();
        }
        applyState();
      });
    });

    resetBtn.addEventListener('click', function() {
      state = Object.assign({}, DEFAULT_STATE);
      applyState();
    });

    // ---- Auto-seed class-driven defaults when Wattage Class changes ----
    function seedClassDefaults() {
      var w = state.wattage;
      // Clear class-specific fields that don't apply to the newly-picked class
      if (w !== '400') {
        delete state.cct_400;
        delete state.stepdown;
        if (state.voltage === 'H') delete state.voltage;  // H is 400W-only
      }
      // Seed informational defaults (wattselect = class max · cct_bundle = 5000K)
      var classMax = { '150': '150', '240': '240', '300': '300' };
      if (classMax[w]) state.wattselect = classMax[w];
      if (w === '150' || w === '240' || w === '300') state.cct_bundle = '5000';
      // 400W voltage default = U (overridable)
      if (w === '400' && state.voltage == null) state.voltage = 'U';
      // 150/240/300 voltage is always U (single SKU)
      if (w === '150' || w === '240' || w === '300') state.voltage = 'U';
    }

    // ---- Required-set is dynamic per class ----
    function getRequired() {
      var req = BASE_REQUIRED.slice();
      if (state.wattage === '400') req = req.concat(REQ_400_EXTRA);
      return req;
    }

    // ---- Apply state to UI ----
    function applyState() {
      chips.forEach(function(chip) {
        var f = chip.dataset.field;
        var v = chip.dataset.val;
        chip.classList.toggle('selected', state[f] === v);
      });
      // Mirror body[data-form] for per-class row swap (LPVR canonical)
      if (state.wattage) {
        document.body.setAttribute('data-form', state.wattage);
      } else {
        document.body.removeAttribute('data-form');
      }

      // Update REQUIRED total (varies by class · 2 for 150/240/300 · 4 for 400)
      var req = getRequired();
      if (reqTotal) reqTotal.textContent = req.length;
      var filled = req.filter(function(k) { return state[k] != null; }).length;
      counter.textContent = filled;
      counterEl.classList.toggle('complete', filled === req.length);

      var complete = (filled === req.length);
      renderSKU(complete);
      warning.classList.toggle('show', !complete);
      ctaPdf.classList.toggle('disabled', !complete);
      ctaPrice.classList.toggle('disabled', !complete);
      copyBtn.disabled = !complete;
      copyBtn.classList.remove('copied');
      copyLabel.textContent = 'Copy SKU';

      renderSpecs();
      renderPreviewImage();
      // Notify CFG-STATE-1 ship-tier deriver
      section.dispatchEvent(new CustomEvent('cfg:state-changed', { detail: { state: state } }));
    }

    // ---- Live Preview · variant-aware product photo per wattage class + finish ----
    // Library map: lamparARCH/jupiter/photos/JUPITER_{class}W_{angle}.{ext}
    // Photo source confirmed by James 2026-05-27: 200W angle 1+9, 400W angle 1+3.
    // Falls back to assets/hero/fam-jupiter-060.webp when the per-class file isn't on disk yet.
    function renderPreviewImage() {
      var imgEl = document.getElementById('cfgPreviewImg');
      if (!imgEl) return;
      var w = state.wattage || '240';
      var fin = state.finish || 'W';
      // Per-class hero photo · maps wattage class to confirmed WorkDrive filename
      var photoMap = {
        '150': 'jupiter/photos/JUPITER_200W_1_nobg.png',   // 150-class uses 200W lib (closest available)
        '240': 'jupiter/photos/JUPITER_200W_9_nobg.png',   // 240-class · angle 9
        '300': 'jupiter/photos/JUPITER_200W_1_nobg.png',   // 300-class uses 200W lib (closest available)
        '400': 'jupiter/photos/JUPITER_400W_1.png'    // 400-class · 400W lib · angle 1
      };
      var primary = photoMap[w] || photoMap['240'];
      var fallback = 'assets/hero/fam-jupiter-060.webp';
      var current = imgEl.getAttribute('src') || '';
      var target = primary + '?v=2026-05-27-T1';
      if (current.indexOf(primary) === -1) {
        imgEl.style.opacity = '0.4';
        // Try primary · onerror swaps to fallback (handles photo-not-yet-on-disk gracefully)
        imgEl.onerror = function() { if (this.src.indexOf(fallback) === -1) this.src = fallback; };
        imgEl.setAttribute('src', target);
        imgEl.setAttribute('alt',
          'LRHB' + w + ' Jupiter · ' + (fin === 'B' ? 'Black' : 'White') + ' finish · live configurator preview');
        setTimeout(function() { imgEl.style.opacity = '1'; }, 80);
      }
    }

    // ---- SKU encoder ----
    //   150/240/300: LRHB{class}-3CS-UJ2[/TAA][/accessories]    (Finish NOT in SKU · custom-finish = MTO)
    //   400:         LRHB400-{cct_400}-{volt}J2[/TAA][/accessories]
    function renderSKU(complete) {
      var w = state.wattage, fin = state.finish;
      var html = 'LRHB' + (w || '<span class="placeholder">[CLASS]</span>') + '-';
      // CCT segment
      if (!w) {
        html += '<span class="placeholder">[CCT]</span>';
      } else if (w === '400') {
        html += (state.cct_400 || '<span class="placeholder">[CCT]</span>');
      } else {
        html += '3CS';
      }
      html += '-';
      // Voltage segment
      if (!w) {
        html += '<span class="placeholder">[V]</span>';
      } else if (w === '400') {
        html += (state.voltage || '<span class="placeholder">[V]</span>');
      } else {
        html += 'U';
      }
      html += 'J2';
      // TAA append
      if (state.taa === 'TAA') html += '/TAA';
      // LPVR-WB pattern (LRHB150/240/300 only · 400 is a single-watt class):
      //   3-WATTSELECT non-max → /W## append (factory dip-switch lock · ~1-3 wk WB lead)
      //   3-CCTSELECT  non-max → /C## append (factory dip-switch lock · ~1-3 wk WB lead)
      if (w === '150' || w === '240' || w === '300') {
        var classMax = { '150': '150', '240': '240', '300': '300' };
        if (state.wattselect && state.wattselect !== classMax[w]) {
          html += '/W' + state.wattselect;
        }
        if (state.cct_bundle && state.cct_bundle !== '5000') {
          var cctMap = { '3500': 'C35', '4000': 'C40' };
          if (cctMap[state.cct_bundle]) html += '/' + cctMap[state.cct_bundle];
        }
      }
      // Accessory appends (datasheet pg 3 ladder · ordered: EM → contrⒶLS → reflector/diffuser/wire guard → mount → surge → stepdown)
      ['emergency', 'sensor_bls', 'sensor_acs', 'sensor_nlc',
       'reflector', 'diffuser', 'wireguard', 'mount', 'surge', 'stepdown'].forEach(function(f) {
        if (state[f]) html += '/' + state[f];
      });
      skuEl.innerHTML = html;
    }

    // ---- Live spec readout ----
    function renderSpecs() {
      var w = state.wattage;
      var sw = w ? SPEC.wattage[w] : null;
      setSpec('lumens',  sw ? sw.lumens  : null);
      setSpec('lpw',     sw ? sw.lpw     : null);
      setSpec('peak',    sw ? sw.peakCd  : null);
      setSpec('voltage', state.voltage ? SPEC.voltage[state.voltage] : null);
      setSpec('optic',   SPEC.optic);

      var compliance = 'DLC Premium &middot; IP65 Wet &middot; 6 kVA Surge';
      if (state.taa === 'TAA') compliance += ' · TAA Compliant';
      if (state.voltage === 'H') compliance += ' · 277-480V';
      if (state.finish === 'B')  compliance += ' · Black finish = custom MTO';
      setSpec('compliance', compliance);
    }
    function setSpec(name, val) {
      var el = section.querySelector('[data-spec="' + name + '"]');
      if (!el) return;
      if (name === 'cct' || name === 'cri' || (name === 'compliance' && val == null)) return;
      if (val == null || val === '—') {
        el.textContent = '—';
        el.classList.add('placeholder');
      } else {
        el.innerHTML = val;
        el.classList.remove('placeholder');
      }
    }

    copyBtn.addEventListener('click', function() {
      if (copyBtn.disabled) return;
      var txt = skuEl.textContent.trim();
      if (!txt) return;
      var done = function() {
        copyBtn.classList.add('copied');
        copyLabel.textContent = 'Copied ✓';
        setTimeout(function() { copyBtn.classList.remove('copied'); copyLabel.textContent = 'Copy SKU'; }, 1800);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(txt).then(done, done);
      } else {
        var ta = document.createElement('textarea');
        ta.value = txt; document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); } catch(e){}
        document.body.removeChild(ta); done();
      }
    });

    // ---- Submittal PDF · canonical &wattage= URL contract (CFG-QA-1) ----
    function buildSubmittalUrl() {
      var sku = skuEl.textContent.trim();
      var w   = state.wattage || '240';
      var params = new URLSearchParams({
        sku:        sku,
        family:     'jupiter',
        wattage:    w,
        wattselect: state.wattselect || w,
        cct:        w === '400' ? (state.cct_400 || '50C') : '3CS',
        voltage:    state.voltage || 'U',
        finish:     state.finish || 'W',
        optic:      '90',
        taa:        state.taa === 'TAA' ? '1' : '0',
        emergency:  state.emergency  || '',
        sensor_bls: state.sensor_bls || '',
        sensor_acs: state.sensor_acs || '',
        sensor_nlc: state.sensor_nlc || '',
        reflector:  state.reflector  || '',
        diffuser:   state.diffuser   || '',
        wireguard:  state.wireguard  || '',
        mount:      state.mount      || '',
        surge:      state.surge      || '',
        stepdown:   state.stepdown   || ''
      });
      return 'submittal/?' + params.toString();
    }
    ctaPdf.addEventListener('click', function(e) {
      if (ctaPdf.classList.contains('disabled')) { e.preventDefault(); return; }
      ctaPdf.setAttribute('href', buildSubmittalUrl());
    });

    applyState();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();

// (Legacy Illuminator motion-carousel IIFE removed — Jupiter's 4-slide motion
//  player lives inline with Section 3 above, sourcing the production mp4s spliced
//  from "LRHB - JUPITER PromoVideo_NoText.mp4" via splice_jupiter_video.sh)

// CFG-STATE-1 — derive ship-tier (QS / WB / MTO) from selected chip badges, render
// canonical 3-state status panel. Self-contained module · no dependency on the
// configurator's state object · re-derives by walking selected chips on every click.
// Custom RAL (finish chip) with a valid 4-digit input forces MTO.
(function() {
  function deriveShipTier() {
    var section = document.getElementById('configurator');
    if (!section) return 'QS';
    var selected = {};
    var worst = 'QS';
    // Active wattage class · used to filter out chips inside hidden data-form-show rows.
    var activeForm = document.body.getAttribute('data-form');
    section.querySelectorAll('.cfg-chip.selected').forEach(function(chip) {
      // CRITICAL · skip chips inside data-form-show rows that don't match the current class.
      // applyState selects every chip whose data-field+data-val matches state; for 3-WATTSELECT, the same
      // wattage step (e.g. 240W) appears in MULTIPLE per-class rows. The duplicate inside the hidden row
      // for the other class carries a WB stripe (it's the mid-step of that other class) and would falsely
      // escalate the ship-tier. This filter ignores chips whose ancestor data-form-show doesn't match
      // the current body[data-form] value.
      var fs = chip.closest('[data-form-show]');
      if (fs && activeForm) {
        var allowed = (fs.getAttribute('data-form-show') || '').split(/\s+/);
        if (allowed.indexOf(activeForm) === -1) return;
      }
      var f = chip.dataset.field, v = chip.dataset.val;
      if (f && v) selected[f] = v;
      // Chip-level stripe (MTO on H-voltage, EM40-CL, MSH/MYK MTO variants, etc.)
      if (chip.querySelector('.cfg-chip-stripe.mto') || chip.querySelector('.cfg-chip-stock.mto')) worst = 'MTO';
      else if ((chip.querySelector('.cfg-chip-stripe.wb') || chip.querySelector('.cfg-chip-stock.wb')) && worst !== 'MTO') worst = 'WB';
    });

    // Base-SKU stock lookup (Zoho Inventory · 10 Jupiter base SKUs · 2026-05-27 snapshot)
    var stockMap = window.__JUPITER_ZOHO_STOCK || {};
    if (selected.wattage && selected.finish) {
      var w = selected.wattage;
      var cct = (w === '400') ? (selected.cct_400 || '50C') : '3CS';
      var volt = (w === '400') ? (selected.voltage || 'U') : 'U';
      var baseSku = 'LRHB' + w + '-' + cct + '-' + volt + 'J2' + (selected.taa === 'TAA' ? '/TAA' : '');
      var qty = stockMap[baseSku];
      if (qty != null) {
        var baseTier = qty === 0 ? 'MTO' : (qty < 50 ? 'WB' : 'QS');
        if (baseTier === 'MTO') worst = 'MTO';
        else if (baseTier === 'WB' && worst === 'QS') worst = 'WB';
      }
      // Custom Black finish forces MTO (no Zoho SKU for /B variant)
      if (selected.finish === 'B') worst = 'MTO';
    }
    return worst;
  }
  function refreshShipTier() {
    var tier = deriveShipTier();
    var rowEl = document.getElementById('cfgShipTier');
    var iconEl = document.getElementById('cfgShipTierIcon');
    var textEl = document.getElementById('cfgShipTierText');
    var stockEl = document.getElementById('cfgShipTierStock');
    if (!rowEl || !iconEl || !textEl || !stockEl) return;
    if (tier === 'QS') {
      rowEl.style.background = 'rgba(95,199,122,0.08)';
      rowEl.style.border = '1px solid rgba(95,199,122,0.40)';
      iconEl.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#7fc998" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
      textEl.innerHTML = '<strong style="color:#9bd6b1;">QuickShip · à-la-carte assembly</strong> · <span style="color:var(--text-secondary);">All selected components in stock — ships 3-5 day.</span>';
      stockEl.textContent = 'QuickShip · 3-5 day';
      stockEl.style.color = '#9bd6b1';
    } else if (tier === 'WB') {
      rowEl.style.background = 'rgba(96,168,255,0.08)';
      rowEl.style.border = '1px solid rgba(96,168,255,0.40)';
      iconEl.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#7fb6ff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>';
      textEl.innerHTML = '<strong style="color:#a8c9ff;">Workbench Assembly · ~1-3 wk</strong> · <span style="color:var(--text-secondary);">One or more selected components are workbench-assembled to order.</span>';
      stockEl.textContent = 'WB · ~1-3 wk';
      stockEl.style.color = '#a8c9ff';
    } else {
      rowEl.style.background = 'rgba(255,159,28,0.08)';
      rowEl.style.border = '1px solid rgba(255,159,28,0.40)';
      iconEl.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#ffb14d" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
      textEl.innerHTML = '<strong style="color:#ffb14d;">Custom build · Made-to-Order · ~4-6 wk</strong> · <span style="color:var(--text-secondary);">One or more selected components are MTO (custom finish, MTO option, or non-stocked variant).</span>';
      stockEl.textContent = 'MTO · ~4-6 wk';
      stockEl.style.color = '#ffb14d';
    }
  }
  function init() {
    var section = document.getElementById('configurator');
    if (!section) return;
    section.addEventListener('click', function(e) {
      if (e.target.closest('.cfg-chip')) setTimeout(refreshShipTier, 50);
    });
    // CFG-CFG-1 v1.7 · re-derive on state-changed (covers seedClassDefaults updates from class swap)
    section.addEventListener('cfg:state-changed', function() { setTimeout(refreshShipTier, 10); });
    var ralInput = document.getElementById('cfgRalInput');
    if (ralInput) ralInput.addEventListener('input', function() { setTimeout(refreshShipTier, 50); });
    refreshShipTier();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
// CFG-CFG-1 · syncRowCodes — update per-row .cfg-row-code based on selected chip.
// Mirrors the canonical Liberty pattern. Self-contained · no dependency on the
// configurator's state object · walks selected chips on every chip click.
(function() {
  function syncRowCodes() {
    document.querySelectorAll('.cfg-row-code[data-field-code]').forEach(function(rc) {
      var field = rc.getAttribute('data-field-code');
      if (field === 'cct') return; // locked-default text stays
      var newText = '—', isEmpty = true;
      var selChip = document.querySelector('.cfg-chip.selected[data-field="' + field + '"]');
      if (selChip) {
        var code = selChip.getAttribute('data-code') || '';
        var slashPrefixed = ['mount','optic','photocell','sensor','shield','surge','taa','em','wg','adapter'];
        var alreadySlash = code.charAt(0) === '/';
        if (code) {
          newText = (slashPrefixed.indexOf(field) >= 0 && !alreadySlash) ? '/' + code : code;
          isEmpty = false;
        } else if (field === 'taa') {
          newText = '(blank)'; isEmpty = false;
        } else if (field === 'mount') {
          newText = '(none)'; isEmpty = false;
        }
      }
      rc.textContent = newText;
      rc.classList.toggle('is-empty', isEmpty);
    });
  }
  function init() {
    var section = document.getElementById('configurator');
    if (!section) return;
    section.addEventListener('click', function(e) {
      if (e.target.closest('.cfg-chip')) setTimeout(syncRowCodes, 60);
    });
    syncRowCodes();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();


</script>


<script is:inline>
/* =============================================================================
   CFG-NAV-1 · Sticky-nav scroll-spy
   ----------------------------------------------------------------------------
   IntersectionObserver watches each section the sticky-nav links to. The link
   whose target is "most visible" gets `.is-current` (white bg + red text · the
   visual inverse of `.primary`). One observer, one Map, one CSS class toggle.
   The Pricing & Availability primary button is NOT a section anchor (its href
   is /pricing-availability/), so it's excluded from the spy by the
   `a[href^="#"]` selector below.
   ============================================================================= */
(function() {
  var nav = document.querySelector('.sticky-nav');
  if (!nav) return;
  var links = Array.prototype.slice.call(nav.querySelectorAll('a[href^="#"]'));
  if (!links.length) return;
  var entries = [];
  links.forEach(function(a) {
    var id = a.getAttribute('href').slice(1);
    var sec = id ? document.getElementById(id) : null;
    if (sec) entries.push({ sec: sec, link: a, ratio: 0 });
  });
  if (!entries.length) return;
  function update() {
    var best = null, bestRatio = 0;
    entries.forEach(function(e) { if (e.ratio > bestRatio) { bestRatio = e.ratio; best = e; } });
    entries.forEach(function(e) { e.link.classList.toggle('is-current', e === best && bestRatio > 0); });
  }
  var io = new IntersectionObserver(function(items) {
    items.forEach(function(item) {
      entries.forEach(function(e) { if (e.sec === item.target) e.ratio = item.intersectionRatio; });
    });
    update();
  }, {
    rootMargin: '-20% 0px -55% 0px',
    threshold: [0, 0.1, 0.25, 0.5, 0.75, 1.0]
  });
  entries.forEach(function(e) { io.observe(e.sec); });
})();
</script>


<!-- Section 6 photometrics · Jupiter 4-housing × 1-optic data · IES-rendered polar img swap.
     Values for 150/240/300 classes are LM-79 measured (parse_ies.py 2026-05-27).
     LRHB400 polar deferred — no 400W IES in the 2026-05-27 drop · falls back to a placeholder polar. -->
<script is:inline>
(function(){
  // IES-measured values per max-WATTSELECT step @ 5000K (jupiter/parse_ies.py 2026-05-27).
  // The polarFile maps to assets/polar/jupiter-polar-{class}-class.svg generated from the IES bundle.
  var data = {
    '150': {
      peak: '13,057 cd',  lumens: '22,704 lm',
      ies:  'LRHB150W-120V-5000K.ies',
      polarFile: 'jupiter-polar-150-class.svg',
      pending: false
    },
    '240': {
      peak: '20,579 cd',  lumens: '36,508 lm',
      ies:  'LRHB240W-120V-5000K.IES',
      polarFile: 'jupiter-polar-240-class.svg',
      pending: false
    },
    '300': {
      peak: '24,881 cd',  lumens: '46,361 lm',
      ies:  'LRHB300W-120V-5000K.ies',
      polarFile: 'jupiter-polar-300-class.svg',
      pending: false
    },
    '400': {
      peak: '~33,000 cd', lumens: '67,200 lm (datasheet)',
      ies:  'LRHB400W-120V-4000K.ies · IES pending',
      polarFile: 'jupiter-polar-300-class.svg',  // shows 300-class shape as visual proxy until 400W IES drops
      pending: true
    }
  };

  var modelTabs = document.querySelectorAll('.photo-tab[data-model]');
  var statPeak  = document.getElementById('photoStatPeak');
  var statLum   = document.getElementById('photoStatLumens');
  var statFile  = document.getElementById('photoStatFile');
  var polarImg  = document.getElementById('photoPolarImg');
  var dl        = document.getElementById('photoIesDownload');

  var CACHE_BUST = '?v=2026-05-27-T1';
  var state = { model: '150' };

  function render(){
    var d = data[state.model];
    if (d) {
      if (statPeak) statPeak.textContent = d.peak;
      if (statLum)  statLum.textContent  = d.lumens;
      if (statFile) statFile.textContent = d.ies;
      if (polarImg) {
        polarImg.setAttribute('src', 'assets/polar/' + d.polarFile + CACHE_BUST);
        polarImg.setAttribute('alt',
          'LRHB Jupiter · ' + state.model + '-class · 90° reflector · polar candela distribution · 5000K · ' +
          (d.pending ? '300-class proxy shape (400W IES pending)' : 'peak ' + d.peak));
      }
      if (dl) {
        if (d.pending) {
          dl.classList.add('is-pending');
          dl.setAttribute('aria-disabled', 'true');
          dl.lastChild && (dl.lastChild.textContent = ' IES file · awaiting 400W bundle drop');
        } else {
          dl.classList.remove('is-pending');
          dl.removeAttribute('aria-disabled');
          dl.lastChild && (dl.lastChild.textContent = ' Download IES file');
        }
      }
    }
    modelTabs.forEach(function(t){
      var on = t.dataset.model === state.model;
      t.classList.toggle('active', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
    });
  }

  modelTabs.forEach(function(t){
    t.addEventListener('click', function(){ state.model = t.dataset.model; render(); });
  });

  render();
})();
</script>


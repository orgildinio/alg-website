/* ============================================================================
   CFG-CFG-1 · Asymmetric Row-Rails (added 2026-05-18 PM)
   COPY THIS BLOCK VERBATIM into each target luxoⒶRCH PDP's <style> block,
   immediately BEFORE the existing `.cfg-preview-wrap` rule.

   Layered on top of the old chip-cluster CSS — does NOT delete the old rules.
   The old `.cfg-fields` grid is replaced by `.cfg-rows` (a vertical stack),
   and each chip group is now a `.cfg-seg` (CSS grid with explicit
   `repeat(N, 1fr)` columns set inline on the element).

   Source: mockup_liberty_pdp_v1.html · lines 1991-2162
   ============================================================================ */

/* The cfg-body grid: 60/40 default; 40/60 alt. Override the old 1fr 1fr rule. */
.cfg-body.split-60-40 { grid-template-columns: 1.6fr 1fr !important; padding: 0; }
.cfg-body.split-40-60 { grid-template-columns: 1fr 1.6fr !important; padding: 0; }

.cfg-body.split-60-40 > .cfg-col,
.cfg-body.split-40-60 > .cfg-col { min-width: 0 !important; }
/* Column tinting · Required slightly tinted, Optional separated by left border */
.cfg-body.split-60-40 .cfg-col-req,
.cfg-body.split-40-60 .cfg-col-req { background: rgba(255,255,255,0.012); padding: 28px 32px 32px; border-left: none; }
.cfg-body.split-60-40 .cfg-col-opt,
.cfg-body.split-40-60 .cfg-col-opt { padding: 28px 32px 32px; border-left: 1px solid var(--line); }
.cfg-body.split-60-40 .cfg-col + .cfg-col,
.cfg-body.split-40-60 .cfg-col + .cfg-col { border-left: 1px solid var(--line); }

/* Override old .cfg-col-head — keep top border + bottom border style */
.cfg-body.split-60-40 .cfg-col-head,
.cfg-body.split-40-60 .cfg-col-head { padding-bottom: 14px; margin-bottom: 12px; }

/* Section bar before col-title */
.cfg-body.split-60-40 .cfg-col-title,
.cfg-body.split-40-60 .cfg-col-title {
  font: 700 12px 'JetBrains Mono', monospace; letter-spacing: 0.18em;
  text-transform: uppercase; color: var(--text-primary);
  position: relative; padding-left: 14px;
}
.cfg-body.split-60-40 .cfg-col-title::before,
.cfg-body.split-40-60 .cfg-col-title::before {
  content: ""; position: absolute; left: 0; top: 2px; bottom: 2px;
  width: 3px; background: var(--brand-red);
}
.cfg-body.split-60-40 .cfg-col-opt .cfg-col-title::before,
.cfg-body.split-40-60 .cfg-col-opt .cfg-col-title::before { background: rgba(255,255,255,0.4); }
.cfg-body.split-60-40 .cfg-col-title-required::after,
.cfg-body.split-40-60 .cfg-col-title-required::after { display: none; } /* drop old asterisk; bar handles it */

/* The rows-stack inside each column (replaces old .cfg-fields grid) */
.cfg-rows { display: flex; flex-direction: column; gap: 0; }

/* cfg-row · default = label-inline (170px label + 1fr seg-control) */
.cfg-row {
  display: grid; grid-template-columns: 170px 1fr;
  gap: 14px; align-items: center;
  padding: 11px 0; border-bottom: 1px solid rgba(255,255,255,0.04);
}
.cfg-row:last-child { border-bottom: none; }
/* cfg-row-stack · label above seg-control (used in narrow column) */
.cfg-row-stack { grid-template-columns: 1fr; gap: 8px; padding: 12px 0; }

.cfg-row-l { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.cfg-row-l-stack { flex-direction: row; align-items: baseline; gap: 8px; justify-content: space-between; }

.cfg-row-label {
  font: 600 13.5px/1.2 'Lato', sans-serif; letter-spacing: -0.005em;
  color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  text-transform: none; /* override old uppercase .cfg-field-label */
}
.cfg-req { color: var(--brand-red); margin-left: 3px; font-weight: 700; }
.cfg-row-code {
  font: 600 10px/1.1 'JetBrains Mono', monospace; letter-spacing: 0.04em;
  color: var(--brand-red); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.cfg-row-code.is-empty { color: var(--text-muted); }

/* cfg-seg · the segmented control (equal-width chips) */
.cfg-seg {
  display: grid; border: 1px solid var(--line-medium);
  background: rgba(255,255,255,0.018); min-width: 0;
}

/* Override the OLD .cfg-chip rules INSIDE a .cfg-seg.
   Old chip = 2-col grid with text badge top-right. New chip = button with stripe + main span. */
.cfg-seg .cfg-chip {
  position: relative; display: block;
  background: transparent; border: none;
  border-right: 1px solid var(--line);
  border-radius: 0; padding: 9px 10px 9px 13px;
  text-align: center; cursor: pointer;
  color: var(--text-primary); font-family: inherit; min-width: 0; min-height: 0;
  transition: background 0.12s, color 0.12s;
  grid-template-columns: none; /* clear old 1fr auto grid */
  grid-template-rows: none;
}
.cfg-seg .cfg-chip:last-child { border-right: none; }
.cfg-seg .cfg-chip:hover:not(.selected):not(.locked):not(.disabled) {
  background: rgba(255,255,255,0.05); border-color: transparent; color: var(--text-primary);
}
.cfg-seg .cfg-chip.selected,
.cfg-seg .cfg-chip.locked.selected {
  background: var(--brand-red); border-color: transparent; color: #fff;
}
.cfg-seg .cfg-chip.locked { cursor: default; opacity: 1; background: var(--brand-red); color: #fff; }
.cfg-seg .cfg-chip.disabled { opacity: 0.32; cursor: not-allowed; }

/* Stripe stock indicator on chip left edge */
.cfg-chip-stripe {
  position: absolute; left: 0; top: 0; bottom: 0; width: 3px; pointer-events: none;
}
.cfg-chip-stripe.qs  { background: #58C998; }
.cfg-chip-stripe.mto { background: #FFB562; }
.cfg-chip-stripe.wb  { background: #7fb6ff; }
.cfg-seg .cfg-chip.selected .cfg-chip-stripe { opacity: 0.85; }

/* Chip inner content layout */
.cfg-chip-main {
  display: inline-flex; align-items: center; justify-content: center; gap: 5px;
  font-size: 12.5px; font-weight: 600; line-height: 1.15;
  white-space: nowrap; max-width: 100%; overflow: hidden; text-overflow: ellipsis;
}
.cfg-chip-label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cfg-chip-sw {
  width: 12px; height: 12px; border: 1px solid rgba(255,255,255,0.3); flex-shrink: 0;
}
.cfg-chip-star { color: var(--text-primary); font-size: 11px; flex-shrink: 0; }
.cfg-seg .cfg-chip.selected .cfg-chip-star { color: var(--text-primary); }

/* Hide any lingering old chip text spans so the JS-driven SKU code update
   can still read .cfg-chip-stock if it queries it (we replaced markup but
   keep the JS contract). Old setBadge() text content is invisible now. */
.cfg-seg .cfg-chip > .cfg-chip-stock,
.cfg-seg .cfg-chip > .cfg-chip-val,
.cfg-seg .cfg-chip > .cfg-chip-code,
.cfg-seg .cfg-chip > .cfg-finish-swatch { display: none; }

/* cfg-select (Pole Adapter dropdown) — match new visual style.
   IMPORTANT: padding-right reserves room for the chevron at ~12px from right
   edge, otherwise the long option text overlaps the arrow (CFG-CFG-1 v1 bug
   fixed 2026-05-18 PM after James caught the misaligned chevron). */
.cfg-adapter-select-wrap select.cfg-adapter-select,
select.cfg-select {
  width: 100%; background: var(--bg-card); color: var(--text-primary);
  border: 1px solid var(--line-medium);
  padding: 9px 32px 9px 12px;          /* ← 32px right reserves chevron space */
  font: 500 12px 'JetBrains Mono', monospace; cursor: pointer; appearance: none;
  text-overflow: ellipsis;             /* graceful truncation if a long
                                          option is still too wide */
  background-image: linear-gradient(45deg, transparent 50%, var(--text-secondary) 50%),
                    linear-gradient(135deg, var(--text-secondary) 50%, transparent 50%);
  background-position: calc(100% - 16px) center, calc(100% - 11px) center;
  background-size: 5px 5px; background-repeat: no-repeat;
}

/* CFG-CFG-1 v1.7 · data-form-show · per-class row swap (LPVR-WB canonical · ported from Icarus 2026-05-27).
   body[data-form="{150|240|300|400}"] mirrors the active Wattage Class chip selection;
   rows with data-form-show that DON'T include the active class are hidden.
   Multi-class rows use space-separated values, e.g. data-form-show="150 240 300". */
body[data-form="150"] [data-form-show]:not([data-form-show*="150"]) { display: none !important; }
body[data-form="240"] [data-form-show]:not([data-form-show*="240"]) { display: none !important; }
body[data-form="300"] [data-form-show]:not([data-form-show*="300"]) { display: none !important; }
body[data-form="400"] [data-form-show]:not([data-form-show*="400"]) { display: none !important; }
body:not([data-form]) [data-form-show] { display: none !important; }

/* WB chip stripe color (matches Hallmark/Icarus LPVR-WB canonical · 7fb6ff = blue) */
.cfg-chip-stripe.wb { background: #7fb6ff; }

/* Required column · flex-column so legend pushes to bottom and column auto-stretches to Optional height */
.cfg-col-req { display: flex; flex-direction: column; }
.cfg-col-req .cfg-rows { flex: 0 0 auto; }
.cfg-legend-wrap {
  margin-top: auto;
  padding-top: 22px;
  display: flex; flex-direction: column; gap: 10px;
}
.cfg-legend {
  padding: 16px 18px;
  background: rgba(255,255,255,0.025); border: 1px solid var(--line);
  display: flex; flex-direction: column; gap: 10px;
  font: 500 12px/1.3 'Lato', sans-serif; color: var(--text-secondary);
}
.cfg-legend-title {
  font-family: 'JetBrains Mono', monospace;
  font-size: 9.5px; font-weight: 700;
  letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--brand-red);
  padding-bottom: 8px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.cfg-legend-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 8px 18px;
}
  /* CFG-CFG-1 v1.4 · Legend disclaimer · James 2026-05-22 · quiet legal cover · STACKED under legend */
  .cfg-disclaimer {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    font-style: italic;
    color: var(--text-muted);
    opacity: 0.72;
    letter-spacing: 0.02em;
    line-height: 1.5;
    padding: 10px 14px;
    background: rgba(255,255,255,0.015);
    border-left: 2px solid rgba(255,255,255,0.10);
  }
.cfg-legend-row { display: flex; align-items: center; gap: 10px; }
.cfg-legend-key.star { color: var(--text-primary); font-weight: 700; width: 14px; text-align: center; }
.cfg-legend-stripe {
  display: inline-block; width: 4px; height: 14px; vertical-align: middle;
}
.cfg-legend-stripe.qs  { background: #58C998; }
.cfg-legend-stripe.wb  { background: #7fb6ff; }
.cfg-legend-stripe.mto { background: #FFB562; }
/* Hide the old text-pill badge inside legend-key — stripe is the visual */
.cfg-legend-key.qs:not(:has(.cfg-legend-stripe)),
.cfg-legend-key.wb:not(:has(.cfg-legend-stripe)),
.cfg-legend-key.mto:not(:has(.cfg-legend-stripe)) { font-size: 9px; }

/* Responsive · stack at narrow viewport */
@media (max-width: 880px) {
  .cfg-body.split-60-40, .cfg-body.split-40-60 { grid-template-columns: 1fr !important; }
  .cfg-body.split-60-40 .cfg-col-opt,
  .cfg-body.split-40-60 .cfg-col-opt { border-left: none; border-top: 1px solid var(--line); }
  .cfg-row { grid-template-columns: 1fr; gap: 8px; padding: 12px 0; }
  .cfg-row-l { flex-direction: row; align-items: baseline; gap: 8px; justify-content: space-between; }
}

---
/**
 * terms.astro — Terms & Conditions
 * Route: /terms/
 * Cat-6 Phase-3 Batch 1 · Design ref: Legal_v3.1.html (Terms variant)
 * §7.4 Header exclusion: BaseLayout mounts live production Header + Footer untouched.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Terms & Conditions — Archipelago Lighting Group"
  description="ALG's terms and conditions for commercial and industrial product sales — ordering, pricing, shipping, returns, warranty, and governing law."
  bodyClass="page-legal page-terms"
>

<div class="glow-orb" aria-hidden="true"></div>

<!-- ── HERO ─────────────────────────────────────────────────────────────── -->
<section class="legal-hero" id="terms">
  <div class="legal-container">
    <p class="legal-eyebrow">Legal · Archipelago Lighting Group</p>
    <div class="legal-seg-wrap">
      <div class="legal-seg">
        <a href="/privacy-policy/" class="seg-btn">Privacy Policy</a>
        <a href="/terms/" class="seg-btn seg-btn--active">Terms &amp; Conditions</a>
        <a href="/patents/" class="seg-btn">Patents</a>
      </div>
    </div>
    <h1 class="legal-h1">Terms &amp; Conditions</h1>
    <p class="legal-updated">Last updated: <span class="legal-date-chip">July 2026</span></p>
  </div>
</section>

<!-- ── BODY ─────────────────────────────────────────────────────────────── -->
<section class="legal-body">
  <div class="legal-container">
    <div class="legal-grid">

      <nav class="legal-toc" aria-label="On this page">
        <p class="toc-label">On this page</p>
        <a href="#overview" class="toc-link">Overview</a>
        <a href="#ordering" class="toc-link">Ordering &amp; acceptance</a>
        <a href="#pricing" class="toc-link">Pricing &amp; payment</a>
        <a href="#shipping" class="toc-link">Shipping &amp; risk of loss</a>
        <a href="#returns" class="toc-link">Returns &amp; restocking</a>
        <a href="#warranty" class="toc-link">Warranty</a>
        <a href="#liability" class="toc-link">Limitation of liability</a>
        <a href="#indemnification" class="toc-link">Indemnification</a>
        <a href="#law" class="toc-link">Governing law</a>
        <a href="#contact-legal" class="toc-link">Contact</a>
      </nav>

      <article class="legal-article">

        <div id="overview" class="legal-section">
          <h2 class="legal-h2">Overview</h2>
          <p>These Terms &amp; Conditions govern all commercial and industrial product sales by Archipelago Lighting Group ("ALG") to authorized distributors, contractors, ESCOs, specifiers, and direct customers. They apply to all orders placed through ALG Shop, the AURA portal, direct purchase orders submitted to our sales desk, and any other ALG sales channel. By placing an order, you agree to these terms.</p>
        </div>

        <div id="ordering" class="legal-section">
          <h2 class="legal-h2">Ordering &amp; acceptance</h2>
          <p>An order is accepted when ALG issues a written order confirmation. ALG reserves the right to decline any order at its discretion. Purchase orders must include the product SKU, quantity, ship-to address, and billing information. Order cancellations must be submitted in writing before the order enters production or ships; cancellations of make-to-order or non-stock items may not be accepted once production has begun.</p>
        </div>

        <div id="pricing" class="legal-section">
          <h2 class="legal-h2">Pricing &amp; payment</h2>
          <p>Prices are as quoted in writing by ALG's sales desk or as published in the current authorized price book. Quoted prices are valid for 30 days unless otherwise stated. ALG reserves the right to adjust pricing on unconfirmed orders due to material cost changes. Payment terms are net-30 days from invoice date for approved accounts; prepayment is required for new accounts until credit is established. Past-due balances accrue interest at 1.5% per month.</p>
        </div>

        <div id="shipping" class="legal-section">
          <h2 class="legal-h2">Shipping &amp; risk of loss</h2>
          <p>All shipments are FOB ALG's shipping point (Riverside, CA or the nearest stocking warehouse). Risk of loss passes to the buyer upon tender to the carrier. ALG selects the carrier unless the buyer specifies otherwise in writing. Freight charges are prepaid and added to the invoice unless the buyer provides a freight account number. Freight damage must be noted on the carrier's delivery receipt at the time of delivery and reported to ALG within <strong>3 business days</strong> of receipt; claims submitted after this window may not be honored.</p>
        </div>

        <div id="returns" class="legal-section">
          <h2 class="legal-h2">Returns &amp; restocking</h2>
          <p>Non-defective product may be returned within <strong>90 days</strong> of invoice date with prior written authorization (RMA number required). Returned product must be in original, unopened packaging and in resalable condition. A <strong>25% restocking fee</strong> applies to all non-defective returns. Custom, make-to-order, and non-stock items are not returnable. Defective product is handled under the written Limited Warranty — see the Warranty section below and <a href="/support/returns/" class="legal-link">support/returns</a> for the RMA process.</p>
        </div>

        <div id="warranty" class="legal-section">
          <h2 class="legal-h2">Warranty</h2>
          <p>ALG products are covered by the written ALG Limited Product Warranty, which is incorporated by reference into these terms. Warranty periods by tier: <strong>PRO+ 10 years · PRO 7 years · ECO 5 years</strong> from date of installation or 90 days after purchase, whichever comes first. Emergency/life-safety products: 5 years electronics / 1 year battery. Decorative: 3 years. Sensors: 3–5 years by model. The warranty covers defects in materials and workmanship under normal use; it does not cover damage from misuse, improper installation, or unauthorized modification. LaborShield extended labor coverage is available as an add-on. The full warranty document is available at <a href="/support/returns/" class="legal-link">support/returns</a>.</p>
        </div>

        <div id="liability" class="legal-section">
          <h2 class="legal-h2">Limitation of liability</h2>
          <p>To the maximum extent permitted by law, ALG's total liability for any claim arising from a product sale shall not exceed the purchase price paid for the specific product giving rise to the claim. ALG shall not be liable for any indirect, incidental, special, consequential, or punitive damages, including lost profits or business interruption, even if advised of the possibility of such damages. Some jurisdictions do not allow limitation of consequential damages; in those jurisdictions, ALG's liability is limited to the fullest extent permitted.</p>
        </div>

        <div id="indemnification" class="legal-section">
          <h2 class="legal-h2">Indemnification</h2>
          <p>Each party agrees to indemnify, defend, and hold harmless the other party and its officers, directors, employees, and agents from and against any claims, damages, losses, and expenses (including reasonable attorneys' fees) arising from the indemnifying party's breach of these terms, negligence, or willful misconduct.</p>
        </div>

        <div id="law" class="legal-section">
          <h2 class="legal-h2">Governing law</h2>
          <p>These terms are governed by the laws of the State of California, without regard to its conflict-of-law provisions. Any dispute arising under these terms shall be resolved in the state or federal courts located in San Bernardino County, California, and both parties consent to the personal jurisdiction of those courts.</p>
        </div>

        <div id="contact-legal" class="legal-section legal-section--contact">
          <h2 class="legal-h2">Contact</h2>
          <p>Questions about these terms: <a href="mailto:sales@archipelagolighting.com" class="legal-link">sales@archipelagolighting.com</a> · Archipelago Lighting Group, 4615 State Street, Montclair, CA 91763 · +1 (866) 912-3220.</p>
        </div>

      </article>
    </div>
  </div>
</section>

</BaseLayout>

<style is:global>
/* Shared legal template — single source of truth for all three legal pages */
@import '../styles/legal.css';
</style>

<script is:inline>
(function(){
  var orb=null, raf=null, EASE=0.03;
  var tx=innerWidth*0.72, ty=innerHeight*0.26, x=tx, y=ty;
  var fine=matchMedia('(pointer:fine)').matches,
      still=matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(!fine||still){
    addEventListener('scroll',function(){ ty=innerHeight*0.26+scrollY*0.06; },{passive:true});
  } else {
    addEventListener('pointermove',function(e){ tx=e.clientX; ty=e.clientY; },{passive:true});
  }
  function tick(){
    if(!orb) orb=document.querySelector('.glow-orb');
    if(orb){ x+=(tx-x)*EASE; y+=(ty-y)*EASE;
      orb.style.transform='translate('+x+'px,'+y+'px) translate(-50%,-50%)'; }
    raf=requestAnimationFrame(tick);
  }
  document.addEventListener('visibilitychange',function(){
    if(document.hidden){ if(raf){ cancelAnimationFrame(raf); raf=null; } }
    else if(!raf){ raf=requestAnimationFrame(tick); }
  });
  raf=requestAnimationFrame(tick);
})();
(function(){
  var links = document.querySelectorAll('.toc-link');
  if(!links.length) return;
  var ids = Array.from(links).map(function(l){ return l.getAttribute('href').replace('#',''); });
  function onScroll(){
    var scrollY = window.scrollY + 120;
    var active = ids[0];
    ids.forEach(function(id){
      var el = document.getElementById(id);
      if(el && el.offsetTop <= scrollY) active = id;
    });
    links.forEach(function(l){
      var isActive = l.getAttribute('href') === '#'+active;
      l.style.color = isActive ? 'var(--red)' : '';
      l.style.fontWeight = isActive ? '600' : '';
      l.style.background = isActive ? 'rgba(243,39,64,.05)' : '';
    });
  }
  window.addEventListener('scroll', onScroll, {passive:true});
  onScroll();
})();
</script>

---
/**
 * BaseLayout.astro
 *
 * Every page on the ALG website wraps in this layout. By doing so, every page
 * gets a byte-identical Header, MegaMenu, and Footer. This is how Playbook v2.0
 * §4 (canonical components) is enforced mechanically — not by md5 verification
 * but by Astro's component model.
 *
 * Page authors set:
 *   - title (browser tab + OG)
 *   - description (meta + OG)
 *   - bodyClass (for page-specific CSS hooks)
 *   - ogImage (optional, defaults to ALG color logo)
 *   - isHomepage (optional, enables Organization+WebSite JSON-LD)
 */

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/brand.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  hideFooterCta?: boolean;
  ogImage?: string;
  isHomepage?: boolean;
}

const {
  title,
  description = 'Archipelago Lighting Group — commercial and industrial LED lighting. Specified. Stocked. Shipped.',
  bodyClass = '',
  hideFooterCta = false,
  ogImage = 'https://www.archipelagolighting.com/brand/alg-logo-color.png',
  isHomepage = false,
} = Astro.props;

// SEO1: self-referencing canonical — strip query strings, always www
// SEO3: ensure trailing slash matches served URL convention (every route serves with trailing slash)
const _rawPath = Astro.url.pathname;
const _canonPath = _rawPath === '/' ? '/' : (_rawPath.endsWith('/') ? _rawPath : _rawPath + '/');
const canonicalUrl = new URL(_canonPath, 'https://www.archipelagolighting.com').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <!-- SEO1: canonical — self-referencing, query-string stripped, always www -->
    <link rel="canonical" href={canonicalUrl} />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Archipelago Lighting Group" />
    <!-- SEO1: Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <!-- G1 v2.7.13.1: Webfonts self-hosted under /fonts/ — @font-face rules in global.css -->
    <!-- Cormorant Garamond 400/600/700 + italic 400, Playfair Display 600/700, JetBrains Mono 400/500 -->
    <title>{title}</title>
    <slot name="head" />
    <!-- SEO1: Organization + WebSite JSON-LD (homepage only) -->
    {isHomepage && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": "https://www.archipelagolighting.com/#organization",
            "name": "Archipelago Lighting Group",
            "url": "https://www.archipelagolighting.com",
            "logo": {
              "@type": "ImageObject",
              "url": "https://www.archipelagolighting.com/brand/alg-logo-color.png"
            },
            "sameAs": []
          },
          {
            "@type": "WebSite",
            "@id": "https://www.archipelagolighting.com/#website",
            "url": "https://www.archipelagolighting.com",
            "name": "Archipelago Lighting Group",
            "publisher": {
              "@id": "https://www.archipelagolighting.com/#organization"
            }
          }
        ]
      })} />
    )}
    <!-- §9 Microsoft Clarity analytics (v27x)
         To activate: set PUBLIC_CLARITY_ID env var in CF Pages dashboard (Settings > Environment variables)
         to your Clarity project ID from clarity.microsoft.com.
         Takes effect on next build. No-ops gracefully if ID is unset or still the placeholder value.
    -->
    {(() => {
      const clarityId = import.meta.env.PUBLIC_CLARITY_ID;
      const isPlaceholder = !clarityId || clarityId === 'REPLACE_WITH_CLARITY_ID' || clarityId === '';
      if (isPlaceholder) return null;
      return (
        <script is:inline set:html={`(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y)})(window,document,"clarity","script","${clarityId}");`} />
      );
    })()}
  </head>
  <body class={bodyClass}>
    <header id="site-header" data-pagefind-ignore>
      <Header />
    </header>
    <main id="main" data-pagefind-body>
      <slot />
    </main>
    <Footer hideFooterCta={hideFooterCta} data-pagefind-ignore />
  
<script>
  // CFG-CHROME-4 · mega-menu hides on scroll-down, shows on scroll-up
  (function () {
    const header = document.getElementById('site-header');
    if (!header) return;
    header.style.transition = 'transform 0.25s ease-out';
    let lastY = window.scrollY;
    let hidden = false;
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      const delta = y - lastY;
      if (y <= 0) {
        header.style.transform = 'translateY(0)';
        hidden = false;
      } else if (delta > 5 && !hidden) {
        header.style.transform = 'translateY(-100%)';
        hidden = true;
      } else if (delta < -5 && hidden) {
        header.style.transform = 'translateY(0)';
        hidden = false;
      }
      lastY = y;
    }, { passive: true });
  })();
</script>
<slot name="body-end" />
</body>
</html>

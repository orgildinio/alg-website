e {\n  font-family: 'Lato';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"94bb154c-53f1-4692-bed4-4ab510eb96e6\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Lato';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"a6d41c0d-34e7-46d6-8e07-2483fa911cb0\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Lato';\n  font-style: normal;\n  font-weight: 800;\n  font-display: swap;\n  src: url(\"94bb154c-53f1-4692-bed4-4ab510eb96e6\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Lato';\n  font-style: normal;\n  font-weight: 800;\n  font-display: swap;\n  src: url(\"a6d41c0d-34e7-46d6-8e07-2483fa911cb0\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n\n\n:root {\n  /* ---------- Brand ---------- */\n  --brand:       #F32740;   /* ALG red — the ONLY accent hue */\n  --brand-dark:  #B0252B;   /* hover / pressed accent */\n\n  /* ---------- Ink (text) ---------- */\n  --ink:   #1A1D23;         /* primary text, wordmarks, numerics */\n  --ink2:  #3A3E47;         /* secondary text, body copy, spec strings */\n  --ink3:  #6B7280;         /* tertiary labels, eyebrows, monospace meta */\n\n  /* ---------- Neutrals (surfaces) ---------- */\n  --c1:    #F5F4F1;         /* warm off-white panel fill */\n  --c2:    #EEEDF0;         /* mid neutral divider / accent block */\n  --c3:    #DCDEE2;         /* 1px borders */\n  --white: #FFFFFF;         /* background is always white */\n\n  /* ---------- Lifecycle (THE three, no others) ---------- */\n  --grn:    #0FAE7C;        /* ACTIVE  — current production */\n  --yellow: #FDD85E;        /* GEN-2   — second-gen current production */\n  --grey:   #8A8F97;        /* LEGACY  — prior-gen, still sold */\n\n  /* ---------- Semantic aliases ---------- */\n  --fg1: var(--ink);\n  --fg2: var(--ink2);\n  --fg3: var(--ink3);\n  --bg:  var(--white);\n  --surface-1: var(--c1);\n  --surface-2: var(--c2);\n  --border:    var(--c3);\n  --accent:       var(--brand);\n  --accent-dark:  var(--brand-dark);\n\n  /* ---------- Type families (NEVER SUBSTITUTE) ---------- */\n  --font-sans: 'Lato', system-ui, -apple-system, Segoe UI, Roboto, sans-serif;\n  --font-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Consolas, monospace;\n\n  /* ---------- Type weights ---------- */\n  --fw-light:    300;\n  --fw-regular:  400;\n  --fw-medium:   500;\n  --fw-semibold: 600;\n  --fw-bold:     700;\n  --fw-black:    800;\n\n  /* ---------- Type scale (print-tuned · never below 10px) ---------- */\n  --fs-wordmark:    64px;   /* cover hero wordmark */\n  --fs-sec-title:   36px;   /* section title */\n  --fs-vert:        38px;   /* vertical name */\n  --fs-stat-v:      26px;   /* stat value */\n  --fs-h4:          18px;   /* contact heading, tier label */\n  --fs-body:        14px;   /* body copy, sec-desc */\n  --fs-sku-model:   13.5px; /* SKU part number — the hero */\n  --fs-callout:     13px;\n  --fs-tree-body:   12.5px;\n  --fs-spec-body:   12.5px;\n  --fs-sku-specs:   12px;\n  --fs-meta:        12px;   /* section label, category bar */\n  --fs-sku-form:    10.5px;\n  --fs-stat-k:      10.5px;\n  --fs-badge:       10px;   /* absolute minimum */\n\n  /* ---------- Letter-spacing (typographic discipline) ---------- */\n  --tracking-tight: -.02em; /* wordmark */\n  --tracking-head:  -.01em; /* sec-title */\n  --tracking-meta:  .08em;  /* mono eyebrows */\n  --tracking-label: .14em;  /* category bar, cat-label */\n  --tracking-wide:  .18em;  /* mono section labels */\n\n  /* ---------- Layout / elevation ---------- */\n  --radius-chip:   2px;     /* badges & sku-form tags */\n  --radius-card:   0;       /* cards are hard-edged; border + 3px top accent */\n  --border-accent: 3px;     /* the signature left-bar / top-bar */\n  --shadow-slide:  0 8px 32px rgba(0, 0, 0, 0.12);  /* slide card on #DDD backdrop */\n\n  /* ---------- Print ---------- */\n  --page-w: 14.4in;\n  --page-h: 9.5in;\n}\n\n/* ============================================================\n   SEMANTIC ELEMENT STYLES\n   Apply directly via class names — mirrors the Product Guide.\n   ============================================================ */\n\nbody, .alg-body {\n  font-family: var(--font-sans);\n  color: var(--ink);\n  background: var(--white);\n}\n\n/* ---- Wordmark (cover hero) ---- */\n.alg-wordmark {\n  font-family: var(--font-sans);\n  font-size: var(--fs-wordmark);\n  font-weight: var(--fw-black);\n  letter-spacing: var(--tracking-tight);\n  line-height: 1;\n  color: var(--ink);\n  white-space: nowrap;\n}\n.alg-wordmark .accent,\n.alg-wordmark .a-enclosed { color: var(--brand); }\n\n/* ---- Section title ---- */\n.alg-sec-title {\n  font-family: var(--font-sans);\n  font-size: var(--fs-sec-title);\n  font-weight: var(--fw-black);\n  letter-spacing: var(--tracking-head);\n  line-height: 1.08;\n  color: var(--ink);\n}\n\n/* ---- Section description / body ---- */\n.alg-body-copy {\n  font-family: var(--font-sans);\n  font-size: var(--fs-body);\n  line-height: 1.55;\n  color: var(--ink2);\n}\n\n/* ---- Monospace meta (eyebrows, section labels) ---- */\n.alg-meta {\n  font-family: var(--font-mono);\n  font-size: var(--fs-meta);\n  letter-spacing: var(--tracking-wide);\n  text-transform: uppercase;\n  color: var(--ink3);\n}\n\n/* ---- SKU part number — the hero ---- */\n.alg-sku-model {\n  font-family: var(--font-mono);\n  font-size: var(--fs-sku-model);\n  font-weight: var(--fw-semibold);\n  color: var(--ink);\n  white-space: nowrap;\n}\n\n/* ---- SKU spec prose ---- */\n.alg-sku-specs {\n  font-family: var(--font-mono);\n  font-size: var(--fs-sku-specs);\n  color: var(--ink2);\n  white-space: nowrap;\n}\n\n/* ---- Form tag chip ---- */\n.alg-sku-form {\n  display: inline-block;\n  min-width: 44px;\n  text-align: center;\n  font-family: var(--font-mono);\n  font-size: var(--fs-sku-form);\n  font-weight: var(--fw-bold);\n  letter-spacing: .06em;\n  color: var(--ink);\n  padding: 2px 6px;\n  background: var(--c1);\n  border-radius: var(--radius-chip);\n}\n\n/* ---- Lifecycle badges ---- */\n.alg-badge {\n  display: inline-block;\n  font-family: var(--font-mono);\n  font-size: var(--fs-badge);\n  font-weight: var(--fw-bold);\n  letter-spacing: var(--tracking-meta);\n  padding: 2px 8px;\n  border-radius: var(--radius-chip);\n  text-transform: uppercase;\n  white-space: nowrap;\n}\n.alg-badge.active { background: var(--grn);    color: #fff; }\n.alg-badge.gen2   { background: var(--yellow); color: var(--ink); }\n.alg-badge.legacy { background: var(--grey);   color: #fff; }\n\n/* ---- Left-bar callout (signature pattern) ---- */\n.alg-callout {\n  padding: 12px 16px;\n  background: var(--c1);\n  border-left: var(--border-accent) solid var(--brand);\n}\n.alg-callout-label {\n  font-family: var(--font-mono);\n  font-size: var(--fs-badge);\n  font-weight: var(--fw-bold);\n  letter-spacing: .16em;\n  text-transform: uppercase;\n  color: var(--brand);\n}\n\n/* ---- Category bar — thick ink underline ---- */\n.alg-cat-bar {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  padding-bottom: 6px;\n  border-bottom: 2px solid var(--ink);\n}\n\n/* ---- Stat block ---- */\n.alg-stat {\n  padding: 14px 16px;\n  background: var(--c1);\n  border-left: var(--border-accent) solid var(--brand);\n}\n.alg-stat .v {\n  font-size: var(--fs-stat-v);\n  font-weight: var(--fw-bold);\n  line-height: 1.05;\n  white-space: nowrap;\n}\n.alg-stat .k {\n  font-family: var(--font-mono);\n  font-size: var(--fs-stat-k);\n  letter-spacing: .12em;\n  text-transform: uppercase;\n  color: var(--ink3);\n  margin-top: 6px;\n}\n</style>\n\n<!-- Code-referenced product images: registered for the bundler -->\n\n\n\n\n\n\n\n<style>\n  html, body { margin: 0; padding: 0; background: #F5F4F1; font-family: var(--font-sans); color: var(--ink); }\n  * { box-sizing: border-box; }\n  #root { height: 100vh; width: 100vw; }\n  .contrals-page p { margin: 0; }\n  .contrals-page h1, .contrals-page h2, .contrals-page h3, .contrals-page h4 { margin: 0; }\n  .contrals-page button, .contrals-page input { font: inherit; }\n  .contrals-page *::-webkit-scrollbar { width: 8px; height: 8px; }\n  .contrals-page *::-webkit-scrollbar-thumb { background: var(--c3); border-radius: 4px; }\n  .contrals-page *::-webkit-scrollbar-track { background: transparent; }\n</style>\n\n<!-- Splash thumbnail (shown while assets unpack, also no-JS fallback) -->\n\n\n<!-- Wire bundled blob URLs into window.__sku_images for sections.jsx -->\n<script>\n  window.__sku_images = {};\n  (function () {\n    if (!window.__resources) return;\n    var keys = Object.keys(window.__resources);\n    for (var i = 0; i < keys.length; i++) {\n      var k = keys[i];\n      if (k.indexOf('img_') === 0) {\n        window.__sku_images[k.slice(4)] = window.__resources[k];\n      }\n    }\n  })();\n
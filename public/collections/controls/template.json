, U+2215, U+FEFF, U+FFFD;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Lato';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"94bb154c-53f1-4692-bed4-4ab510eb96e6\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Lato';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"a6d41c0d-34e7-46d6-8e07-2483fa911cb0\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Lato';\n  font-style: normal;\n  font-weight: 800;\n  font-display: swap;\n  src: url(\"94bb154c-53f1-4692-bed4-4ab510eb96e6\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Lato';\n  font-style: normal;\n  font-weight: 800;\n  font-display: swap;\n  src: url(\"a6d41c0d-34e7-46d6-8e07-2483fa911cb0\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n\n\n:root {\n  /* ---------- Brand ---------- */\n  --brand:       #F32740;   /* ALG red \u2014 the ONLY accent hue */\n  --brand-dark:  #B0252B;   /* hover / pressed accent */\n\n  /* ---------- Ink (text) ---------- */\n  --ink:   #1A1D23;         /* primary text, wordmarks, numerics */\n  --ink2:  #3A3E47;         /* secondary text, body copy, spec strings */\n  --ink3:  #6B7280;         /* tertiary labels, eyebrows, monospace meta */\n\n  /* ---------- Neutrals (surfaces) ---------- */\n  --c1:    #F5F4F1;         /* warm off-white panel fill */\n  --c2:    #EEEDF0;         /* mid neutral divider / accent block */\n  --c3:    #DCDEE2;         /* 1px borders */\n  --white: #FFFFFF;         /* background is always white */\n\n  /* ---------- Lifecycle (THE three, no others) ---------- */\n  --grn:    #0FAE7C;        /* ACTIVE  \u2014 current production */\n  --yellow: #FDD85E;        /* GEN-2   \u2014 second-gen current production */\n  --grey:   #8A8F97;        /* LEGACY  \u2014 prior-gen, still sold */\n\n  /* ---------- Semantic aliases ---------- */\n  --fg1: var(--ink);\n  --fg2: var(--ink2);\n  --fg3: var(--ink3);\n  --bg:  var(--white);\n  --surface-1: var(--c1);\n  --surface-2: var(--c2);\n  --border:    var(--c3);\n  --accent:       var(--brand);\n  --accent-dark:  var(--brand-dark);\n\n  /* ---------- Type families (NEVER SUBSTITUTE) ---------- */\n  --font-sans: 'Lato', system-ui, -apple-system, Segoe UI, Roboto, sans-serif;\n  --font-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Consolas, monospace;\n\n  /* ---------- Type weights ---------- */\n  --fw-light:    300;\n  --fw-regular:  400;\n  --fw-medium:   500;\n  --fw-semibold: 600;\n  --fw-bold:     700;\n  --fw-black:    800;\n\n  /* ---------- Type scale (print-tuned \u00b7 never below 10px) ---------- */\n  --fs-wordmark:    64px;   /* cover hero wordmark */\n  --fs-sec-title:   36px;   /* section title */\n  --fs-vert:        38px;   /* vertical name */\n  --fs-stat-v:      26px;   /* stat value */\n  --fs-h4:          18px;   /* contact heading, tier label */\n  --fs-body:        14px;   /* body copy, sec-desc */\n  --fs-sku-model:   13.5px; /* SKU part number \u2014 the hero */\n  --fs-callout:     13px;\n  --fs-tree-body:   12.5px;\n  --fs-spec-body:   12.5px;\n  --fs-sku-specs:   12px;\n  --fs-meta:        12px;   /* section label, category bar */\n  --fs-sku-form:    10.5px;\n  --fs-stat-k:      10.5px;\n  --fs-badge:       10px;   /* absolute minimum */\n\n  /* ---------- Letter-spacing (typographic discipline) ---------- */\n  --tracking-tight: -.02em; /* wordmark */\n  --tracking-head:  -.01em; /* sec-title */\n  --tracking-meta:  .08em;  /* mono eyebrows */\n  --tracking-label: .14em;  /* category bar, cat-label */\n  --tracking-wide:  .18em;  /* mono section labels */\n\n  /* ---------- Layout / elevation ---------- */\n  --radius-chip:   2px;     /* badges & sku-form tags */\n  --radius-card:   0;       /* cards are hard-edged; border + 3px top accent */\n  --border-accent: 3px;     /* the signature left-bar / top-bar */\n  --shadow-slide:  0 8px 32px rgba(0, 0, 0, 0.12);  /* slide card on #DDD backdrop */\n\n  /* ---------- Print ---------- */\n  --page-w: 14.4in;\n  --page-h: 9.5in;\n}\n\n/* ============================================================\n   SEMANTIC ELEMENT STYLES\n   Apply directly via class names \u2014 mirrors the Product Guide.\n   ============================================================ */\n\nbody, .alg-body {\n  font-family: var(--font-sans);\n  color: var(--ink);\n  background: var(--white);\n}\n\n/* ---- Wordmark (cover hero) ---- */\n.alg-wordmark {\n  font-family: var(--font-sans);\n  font-size: var(--fs-wordmark);\n  font-weight: var(--fw-black);\n  letter-spacing: var(--tracking-tight);\n  line-height: 1;\n  color: var(--ink);\n  white-space: nowrap;\n}\n.alg-wordmark .accent,\n.alg-wordmark .a-enclosed { color: var(--brand); }\n\n/* ---- Section title ---- */\n.alg-sec-title {\n  font-family: var(--font-sans);\n  font-size: var(--fs-sec-title);\n  font-weight: var(--fw-black);\n  letter-spacing: var(--tracking-head);\n  line-height: 1.08;\n  color: var(--ink);\n}\n\n/* ---- Section description / body ---- */\n.alg-body-copy {\n  font-family: var(--font-sans);\n  font-size: var(--fs-body);\n  line-height: 1.55;\n  color: var(--ink2);\n}\n\n/* ---- Monospace meta (eyebrows, section labels) ---- */\n.alg-meta {\n  font-family: var(--font-mono);\n  font-size: var(--fs-meta);\n  letter-spacing: var(--tracking-wide);\n  text-transform: uppercase;\n  color: var(--ink3);\n}\n\n/* ---- SKU part number \u2014 the hero ---- */\n.alg-sku-model {\n  font-family: var(--font-mono);\n  font-size: var(--fs-sku-model);\n  font-weight: var(--fw-semibold);\n  color: var(--ink);\n  white-space: nowrap;\n}\n\n/* ---- SKU spec prose ---- */\n.alg-sku-specs {\n  font-family: var(--font-mono);\n  font-size: var(--fs-sku-specs);\n  color: var(--ink2);\n  white-space: nowrap;\n}\n\n/* ---- Form tag chip ---- */\n.alg-sku-form {\n  display: inline-block;\n  min-width: 44px;\n  text-align: center;\n  font-family: var(--font-mono);\n  font-size: var(--fs-sku-form);\n  font-weight: var(--fw-bold);\n  letter-spacing: .06em;\n  color: var(--ink);\n  padding: 2px 6px;\n  background: var(--c1);\n  border-radius: var(--radius-chip);\n}\n\n/* ---- Lifecycle badges ---- */\n.alg-badge {\n  display: inline-block;\n  font-family: var(--font-mono);\n  font-size: var(--fs-badge);\n  font-weight: var(--fw-bold);\n  letter-spacing: var(--tracking-meta);\n  padding: 2px 8px;\n  border-radius: var(--radius-chip);\n  text-transform: uppercase;\n  white-space: nowrap;\n}\n.alg-badge.active { background: var(--grn);    color: #fff; }\n.alg-badge.gen2   { background: var(--yellow); color: var(--ink); }\n.alg-badge.legacy { background: var(--grey);   color: #fff; }\n\n/* ---- Left-bar callout (signature pattern) ---- */\n.alg-callout {\n  padding: 12px 16px;\n  background: var(--c1);\n  border-left: var(--border-accent) solid var(--brand);\n}\n.alg-callout-label {\n  font-family: var(--font-mono);\n  font-size: var(--fs-badge);\n  font-weight: var(--fw-bold);\n  letter-spacing: .16em;\n  text-transform: uppercase;\n  color: var(--brand);\n}\n\n/* ---- Category bar \u2014 thick ink underline ---- */\n.alg-cat-bar {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  padding-bottom: 6px;\n  border-bottom: 2px solid var(--ink);\n}\n\n/* ---- Stat block ---- */\n.alg-stat {\n  padding: 14px 16px;\n  background: var(--c1);\n  border-left: var(--border-accent) solid var(--brand);\n}\n.alg-stat .v {\n  font-size: var(--fs-stat-v);\n  font-weight: var(--fw-bold);\n  line-height: 1.05;\n  white-space: nowrap;\n}\n.alg-stat .k {\n  font-family: var(--font-mono);\n  font-size: var(--fs-stat-k);\n  letter-spacing: .12em;\n  text-transform: uppercase;\n  color: var(--ink3);\n  margin-top: 6px;\n}\n</style>\n\n<!-- Code-referenced product images: registered for the bundler -->\n\n\n\n\n\n\n\n<style>\n  html, body { margin: 0; padding: 0; background: #F5F4F1; font-family: var(--font-sans); color: var(--ink); }\n  * { box-sizing: border-box; }\n  #root { height: 100vh; width: 100vw; }\n  .contrals-page p { margin: 0; }\n  .contrals-page h1, .contrals-page h2, .contrals-page h3, .contrals-page h4 { margin: 0; }\n  .contrals-page button, .contrals-page input { font: inherit; }\n  .contrals-page *::-webkit-scrollbar { width: 8px; height: 8px; }\n  .contrals-page *::-webkit-scrollbar-thumb { background: var(--c3); border-radius: 4px; }\n  .contrals-page *::-webkit-scrollbar-track { background: transparent; }\n</style>\n\n<!-- Splash thumbnail (shown while assets unpack, also no-JS fallback) -->\n\n\n<!-- Wire bundled blob URLs into window.__sku_images for sections.jsx -->\n<script>\n  window.__sku_images = window.__sku_images || {};\n  (function () {\n    if (!window.__resources) return;\n    var keys = Object.keys(window.__resources);\n    for (var i = 0; i < keys.length; i++) {\n      var k = keys[i];\n      if (k.indexOf('img_') === 0) {\n        window.__sku_images[k.slice(4)] = window.__resources[k];\n      }\n    }\n  })();\n</script>\n\n<script>\n// ALG override \u00b7 fill missing \u24b6CS hero photos from canonical assets\n(function() {\n  window.__sku_images = window.__sku_images || {};\n  window.__sku_images['MSP-SRI/903P1/ACS'] = 'data:image/webp;base64,';\n  window.__sku_images['MSX-CTI/903P1/ACS'] = 'data:image/webp;base64,';\n  window.__sku_images['MSZ-KPI/50WM/ACS']  = 'data:image/webp;base64,';\n})();\n</script>\n\n\n<!-- React + Babel pinned -->\n<script src=\"eb7d5ae4-b012-43cd-b911-f0e0d2c11b1a\" integrity=\"sha384-hD6/rw4ppMLGNu3tX5cjIb+uRZ7UkRJ6BPkLpg4hAu/6onKUg4lLsHAs9EBPT82L\" crossorigin=\"anonymous\"></script>\n<script src=\"0ad569e0-885d-42fa-aef5-2efc22fd3e3a\" integrity=\"sha384-u6aeetuaXnQ38mYT8rp6sbXaQe3NL9t+IBXmnYxwkUI2Hw4bsp2Wvmx4yRQF1uAm\" crossorigin=\"anonymous\"></script>\n<script src=\"cba00363-7acb-4cf3-95ca-00fd42ef63ab\" integrity=\"sha384-m08KidiNqLdpJqLq95G/LEi8Qvjl/xUYll3QILypMoQ65QorJ9Lvtp2RXYGBFj1y\" crossorigin=\"anonymous\"></script>\n\n<!-- Shared building blocks -->\n<script src=\"8b841aa8-ad74-4ce8-9d1d-98644b968742\"></script>\n<script src=\"737c1769-bd6f-40cf-b6b7-b0ba1c2a886b\"></script>\n<script type=\"text/babel\" src=\"8d17f635-c8ce-4f23-85ad-2df5a1bc858c\"></script>\n<script type=\"text/babel\" src=\"fc1b33b9-7e94-49b5-8290-0ed6a0f3eb5a\"></script>\n<script type=\"text/babel\" src=\"372846e9-ba26-43d4-88bf-8351121b4663\"></script>\n<script type=\"text/babel\" src=\"8ddccf3a-c5ba-478c-b98c-69d5b4fc7606\"></script>\n<script type=\"text/babel\" src=\"fff83884-3aab-4bc2-80c3-8226863b0f2a\"></script>\n\n\n<style id=\"alg-responsive-overrides\">\n/* contr\u24b6LS PDP responsive \u00b7 asymmetric 2-col hero\n   Text column compact (5fr) \u00b7 photo grid prominent (7fr) at desktop\n   Stack at tablet/mobile only */\n\n.contrals-pdp-host { width: 100% !important; }\n.contrals-page { width: 100% !important; max-width: 1600px !important; margin: 0 auto !important; }\n.contrals-page > div:first-child { width: 100% !important; overflow-x: hidden !important; }\nhtml, body { overflow-x: hidden !important; }\n\n/* ===== Desktop (\u22651024px) \u00b7 2-col hero, asymmetric (compact text \u00b7 prominent photos) ===== */\n@media (min-width: 1024px) {\n  /* Hero \u00b7 2/3 text \u00b7 1/3 photo grid */\n  .contrals-page > div > section:first-of-type {\n    grid-template-columns: 2fr 1fr !important;\n    gap: 40px !important;\n    align-items: center !important;\n  }\n  /* Wordmark \u00b7 big again (matches Design intent) */\n  .contrals-page span[style*=\"letter-spacing: -0.03em\"] {\n    font-size: clamp(72px, 10vw, 168px) !important;\n    line-height: 0.92 !important;\n  }\n  /* Stats grid: stays 4-col (full width of the wider text column) */\n  .contrals-page > div > section:first-of-type > div:first-child > div:last-child {\n    grid-template-columns: repeat(4, 1fr) !important;\n  }\n  /* Force fr ratio to be respected (override min-content) */\n  .contrals-page > div > section:first-of-type > div {\n    min-width: 0 !important;\n  }\n  .contrals-page > div > section:first-of-type > div:first-child p {\n    max-width: none !important;\n    font-size: 15px !important;\n  }\n}\n\n/* ===== Tablet-large (\u22641279px) \u00b7 compress padding ===== */\n@media (max-width: 1279px) {\n  .contrals-page nav { padding: 12px 32px !important; }\n  .contrals-page section { padding-left: 32px !important; padding-right: 32px !important; }\n}\n\n/* ===== Tablet (\u22641023px) \u00b7 stack hero, photo grid below at full width ===== */\n@media (max-width: 1023px) {\n  .contrals-page > div > section:first-of-type {\n    grid-template-columns: 1fr !important;\n    gap: 40px !important;\n    padding: 40px 24px !important;\n  }\n  .contrals-page > div > section:first-of-type > div:last-child {\n    min-height: 0 !important;\n    height: auto !important;\n  }\n  .contrals-page > div > section:first-of-type > div:last-child > div {\n    height: auto !important;\n    aspect-ratio: auto !important;\n  }\n  .contrals-page > div > section:first-of-type > div:last-child > div > div {\n    aspect-ratio: 1 / 1 !important;\n  }\n  \n  /* Nav: hide center link list */\n  .contrals-page nav > div:nth-child(2) { display: none !important; }\n  .contrals-page nav { padding: 10px 24px !important; }\n  \n  .contrals-page section { padding: 40px 24px !important; }\n  \n  /* Hero stats: 2-col */\n  .contrals-page > div > section:first-of-type > div:first-child > div:last-child {\n    grid-template-columns: repeat(2, 1fr) !important;\n  }\n  \n  /* PlatformMatrix 3-card row \u2192 stack */\n  .contrals-page > div > section:nth-of-type(2) > div:last-child { \n    grid-template-columns: 1fr !important; \n  }\n  \n  /* Wordmark scaling */\n  .contrals-page span[style*=\"letter-spacing: -0.03em\"] {\n    font-size: clamp(56px, 12vw, 128px) !important;\n  }\n  \n  /* Section titles */\n  .contrals-page section h2 { font-size: clamp(24px, 4vw, 36px) !important; line-height: 1.15 !important; }\n}\n\n/* ===== Mobile (\u2264767px) ===== */\n@media (max-width: 767px) {\n  .contrals-page nav > div:last-child > button:not(:first-child) { display: none !important; }\n  .contrals-page nav { padding: 8px 16px !important; }\n  .contrals-page nav img { width: 80px !important; }\n  \n  .contrals-page section { padding: 32px 16px !important; }\n  .contrals-page > div > section:first-of-type { padding: 24px 16px 32px !important; }\n  \n  .contrals-page span[style*=\"letter-spacing: -0.03em\"] {\n    font-size: clamp(40px, 16vw, 80px) !important;\n  }\n  \n  .contrals-page > div > section:first-of-type span[style*=\"letter-spacing\"] {\n    white-space: normal !important;\n  }\n  \n  /* Hero stats: 1-col on phones */\n  .contrals-page > div > section:first-of-type > div:first-child > div:last-child {\n    grid-template-columns: 1fr !important;\n  }\n  \n  /* Hero photo grid: 3\u00d73 \u2192 2\u00d7n */\n  .contrals-page > div > section:first-of-type > div:last-child > div { \n    grid-template-columns: repeat(2, 1fr) !important;\n    grid-template-rows: auto !important;\n    height: auto !important;\n  }\n  \n  /* SKU browser table horizontal scroll */\n  .contrals-page section [style*=\"grid-template-columns: 28px\"] {\n    min-width: 720px !important;\n  }\n  \n  .contrals-page section p { font-size: 14px !important; }\n  \n  /* BOM drawer */\n  .contrals-page > div > div[style*=\"position: fixed\"] {\n    left: 0 !important; right: 0 !important; width: 100% !important; border-radius: 0 !important;\n  }\n}\n</style>\n\n<script>window.__CONTRALS_DATASHEETS = {\"MSP-SRI/8CM/HD/ACS\":\"https://workdrive.archipelagolighting.com/external/874439965b9f6d9503a48a3f2c7f5c2ba7ce5d7b0c9d6a6523f897b8671fdf2f\",\"MSP-SRI/20CM/HD/ACS\":\"https://workdrive.archipelagolighting.com/external/533787ea61f9861c2d8d68782a4afe547f8f76c3e72117468285c5616170ab9a\",\"MSP-SRI/40CM/HD/ACS\":\"https://workdrive.archipelagolighting.com/external/14d5354156cc8c8e57ce3f6f6bd4bac0d2c039253887b3f548566b0df9e752fb\",\"MSP-SRI/903P1/ACS\":\"https://workdrive.archipelagolighting.com/external/25eebb2526ce91814445097c311b0e595ef74a2b8bc58612b635e16d26206819\",\"MSP-SRO/903PX/ACS\":\"https://workdrive.archipelagolighting.com/external/e9b715eec711fd027f495f084062550f5c52f9a749bb5b2f569fa8a88f89217e\",\"MSX-CTI/903P1/ACS\":\"https://workdrive.archipelagolighting.com/external/ecef24eb02e41f3c26f1b21422775322254955706dbea08ff539e5ebc600e9ae\",\"MSX-CTO/903PX/ACS\":\"https://workdrive.archipelagolighting.com/external/ffb844bcefe8fa3484799589c363a209b1c7d41cb2336adbd991b3a44be6289b\",\"MSX-CTI/LV20/ACS\":\"https://workdrive.archipelagolighting.com/external/816c5a4b637be162fe5e19cd81b0a17b98486098171698723fd14f52f32ee046\",\"MSZ-KPI/50WM/ACS\":\"https://workdrive.archipelagolighting.com/external/138efa3689ca2c99a9a95d1ac84a549a2f4485c9369cc75f275def0a034339b2\",\"MSM-HTI/08P1/NLC\":\"https://workdrive.archipelagolighting.com/external/67fcd392d0f338a8259b6b80e36ba714731afe115d314041fd534b23fd4994e9\",\"MSM-HTI/126P1/NLC\":\"https://workdrive.archipelagolighting.com/external/154b24c86a3f69ab0b9254470ea66bc24ee21bc2ec2ff1b38a4fcf1116b7e475\",\"MSM-SRI/903P1/NLC\":\"https://workdrive.archipelagolighting.com/external/e39296c8f43ae9a7e6ab1ab8ea75f3cfc2703737fe82a